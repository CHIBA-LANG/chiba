/// Replay-safety and world/thread boundary checks for multi-shot continuations.
namespace compiler.control.replay_safety

use compiler.control.continuation_usage.*
use compiler.control.continuation_boundary.*

/// Boundary where continuation capture or resume is illegal.
data ControlBoundaryError {
    ControlCrossWorld,
    ControlCrossThread,
    ControlNonReplayState,
}

/// Replay-safety fact for a continuation.
type ReplaySafetyFact {
    binder: BinderId,
    safe: bool,
}

/// Captured value category relevant to repeatable ContN replay.
data ReplayCaptureKind {
    ReplayCapturePureValue,
    ReplayCaptureSharedRefCell,
    ReplayCaptureNonReplayState,
}

/// Replay capture classification for one continuation capture.
type ReplayCaptureClassification {
    binder: BinderId,
    kind: ReplayCaptureKind,
}

/// Return true when a capture kind is legal for repeatable ContN replay.
def ReplayCaptureKind.safe_for_contn_replay(self): bool =
    match self {
        ReplayCapturePureValue => true
        ReplayCaptureSharedRefCell => true
        ReplayCaptureNonReplayState => false
    }

/// Return true when capture semantics require shared-reference handling.
def ReplayCaptureKind.uses_shared_reference_semantics(self): bool =
    match self {
        ReplayCaptureSharedRefCell => true
        _ => false
    }

/// Check multi-shot replay-safety after world/thread boundaries are rejected.
def check_replay_safety(module: UsageModule): Result[ReplaySafeModule, SemanticDiagnostics] =
    if module.facts.len() == 0 {
        Ok(ReplaySafeModule(module, replay_safety_facts_none()))
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<control>", 0, 0, "missing-lowering: replay-safety capture classification absent"))
            .freeze()))
    }

/// Module whose continuations are legal for lowering.
type ReplaySafeModule {
    usage: UsageModule,
    replay: Array[ReplaySafetyFact],
}

/// Empty replay-safety fact stream for modules without captured continuations.
def replay_safety_facts_none(): Array[ReplaySafetyFact] =
    Vec[ReplaySafetyFact].new().freeze()
