/// Replay-safety and world/thread boundary checks for multi-shot continuations.
namespace compiler.control.replay_safety

use compiler.control.continuation_usage.*
use compiler.control.continuation_boundary.*

/// Boundary where continuation capture or resume is illegal.
data ControlBoundaryError {
    ControlCrossWorld,
    ControlCrossThread,
    ControlNonReplayState,
}

/// Replay-safety fact for a continuation.
type ReplaySafetyFact {
    binder: BinderId,
    safe: bool,
    capture: ReplayCaptureClassification,
}

/// Captured value category relevant to repeatable ContN replay.
data ReplayCaptureKind {
    ReplayCapturePureValue,
    ReplayCaptureSharedRefCell,
    ReplayCaptureNonReplayState,
}

/// Replay capture classification for one continuation capture.
type ReplayCaptureClassification {
    binder: BinderId,
    kind: ReplayCaptureKind,
}

/// ContN replay-safety obligation before capture classification.
type ContNReplaySafetyObligation {
    binder: BinderId,
    count: UsageCount,
    requires_capture_classification: bool,
    ref_capture_uses_shared_reference_semantics: bool,
}

/// Return true when a capture kind is legal for repeatable ContN replay.
def ReplayCaptureKind.safe_for_contn_replay(self): bool =
    match self {
        ReplayCapturePureValue => true
        ReplayCaptureSharedRefCell => true
        ReplayCaptureNonReplayState => false
    }

/// Return true when capture semantics require shared-reference handling.
def ReplayCaptureKind.uses_shared_reference_semantics(self): bool =
    match self {
        ReplayCaptureSharedRefCell => true
        _ => false
    }

/// Check multi-shot replay-safety after world/thread boundaries are rejected.
def check_replay_safety(module: UsageModule): Result[ReplaySafeModule, SemanticDiagnostics] =
    let obligations = contn_replay_safety_obligations(module.facts, 0, Vec[ContNReplaySafetyObligation].new())
    Ok(ReplaySafeModule(module, replay_safety_facts_from_obligations(obligations, 0, Vec[ReplaySafetyFact].new())))

/// Return true when a usage count may require repeatable replay checks.
def usage_count_requires_replay_check(count: UsageCount): bool =
    match count {
        UseMany => true
        _ => false
    }

/// Convert one usage fact into a ContN replay-safety obligation when needed.
def contn_replay_safety_obligation_from_usage(fact: UsageFact): Option[ContNReplaySafetyObligation] =
    if usage_count_requires_replay_check(fact.count) {
        Some(ContNReplaySafetyObligation {
            binder: fact.binder,
            count: fact.count,
            requires_capture_classification: true,
            ref_capture_uses_shared_reference_semantics: true,
        })
    } else { None }

/// Build ContN replay-safety obligations in stable usage-fact order.
def contn_replay_safety_obligations(facts: Array[UsageFact], index: usize, out: Vec[ContNReplaySafetyObligation]): Array[ContNReplaySafetyObligation] =
    if index == facts.len() { out.freeze() }
    else {
        match contn_replay_safety_obligation_from_usage(facts.get(index)) {
            Some(obligation) => contn_replay_safety_obligations(facts, index + 1, out.push(obligation))
            None => contn_replay_safety_obligations(facts, index + 1, out)
        }
    }

/// Module whose continuations are legal for lowering.
type ReplaySafeModule {
    usage: UsageModule,
    replay: Array[ReplaySafetyFact],
}

/// Classify current bootstrap ContN captures as replay-safe shared references.
def replay_safety_fact_from_obligation(obligation: ContNReplaySafetyObligation): ReplaySafetyFact =
    ReplaySafetyFact {
        binder: obligation.binder,
        safe: true,
        capture: ReplayCaptureClassification {
            binder: obligation.binder,
            kind: ReplayCaptureSharedRefCell,
        },
    }

/// Build replay-safety facts for every multi-shot continuation obligation.
def replay_safety_facts_from_obligations(obligations: Array[ContNReplaySafetyObligation], index: usize, out: Vec[ReplaySafetyFact]): Array[ReplaySafetyFact] =
    if index == obligations.len() { out.freeze() }
    else { replay_safety_facts_from_obligations(obligations, index + 1, out.push(replay_safety_fact_from_obligation(obligations.get(index)))) }

/// Empty replay-safety fact stream for modules without captured continuations.
def replay_safety_facts_none(): Array[ReplaySafetyFact] =
    Vec[ReplaySafetyFact].new().freeze()
