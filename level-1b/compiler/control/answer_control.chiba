/// Answer type and delimited-control checks.
namespace compiler.control.answer_control

use compiler.source.project.*
use compiler.source.scan.*
use compiler.semantic.driver.*
use compiler.semantic.types.*
use compiler.semantic.type_infer.*

/// Control boundary kind observed in an expression.
data ControlBoundary {
    ControlNone,
    ControlReset,
    ControlShift,
    ControlDelimited,
}

/// Answer type fact for one reset boundary.
type AnswerFact {
    owner: BinderId,
    boundary: ControlBoundary,
    answer: SemType,
}

/// Delimited-control body shape discovered before CPS lowering.
data ControlBodyKind {
    ControlBodyReset,
    ControlBodyShift,
    ControlBodyShiftN,
}

/// Executable resume shape discovered from a delimited-control body.
data ControlBodyResumeShape {
    ControlBodyResumeUnknown,
    ControlBodyResumeConst(usize),
    ControlBodyResumeParam(usize),
    ControlBodyMultiResumeConst(usize, usize),
}

/// Per-owner control body fact used by one-pass CPS.
type ControlBodyFact {
    owner: BinderId,
    file: SourceFileId,
    kind: ControlBodyKind,
    answer: SemType,
    resume_shape: ControlBodyResumeShape,
}

/// Answer/control obligation before expression-level answer inference.
type AnswerControlObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_reset_answer: bool,
    requires_shift_answer: bool,
    requires_multishot_answer: bool,
}

/// Return true when a typed item mentions reset/shift/shiftn control syntax.
def typed_item_has_control_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_reset_expr { true }
    else if item.surface.has_shift_expr { true }
    else { item.surface.has_shiftn_expr }

/// Return true when any typed item still needs answer/control expression scanning.
def typed_items_have_control_surface(items: Array[TypedItemSkeleton], index: usize): bool =
    if index == items.len() { false }
    else if typed_item_has_control_surface(items.get(index)) { true }
    else { typed_items_have_control_surface(items, index + 1) }

/// Empty answer fact stream for modules without delimited-control syntax.
def answer_facts_none(): Array[AnswerFact] =
    Vec[AnswerFact].new().freeze()

/// Build an empty control body stream by consuming the typed item surface.
def control_body_facts_from_no_control_items(items: Array[TypedItemSkeleton], index: usize, out: Vec[ControlBodyFact]): Array[ControlBodyFact] =
    if index == items.len() { out.freeze() }
    else { control_body_facts_from_no_control_items(items, index + 1, out) }

/// Conservative answer type used until expression answer inference owns bodies.
def default_answer_type(): SemType =
    TyNominal(NominalId { namespace_name: "std", name: "i64" })

/// Return the text of one source file by stable id.
def control_source_file_text(files: Array[SourceFile], file: SourceFileId, index: usize): String =
    if index == files.len() { "" }
    else if files.get(index).id.index == file.index { files.get(index).text }
    else { control_source_file_text(files, file, index + 1) }

/// Return the typed item that owns one control surface fact.
def control_item_for_owner(items: Array[TypedItemSkeleton], owner: BinderId, index: usize): Option[TypedItemSkeleton] =
    if index == items.len() { None }
    else if items.get(index).binder.index == owner.index { Some(items.get(index)) }
    else { control_item_for_owner(items, owner, index + 1) }

/// Find the integer argument start after a continuation resume call name.
def control_resume_arg_start(text: String, offset: usize, end: usize, name: str): Option[usize] =
    if offset >= end { None }
    else if source_starts_with_at(text, offset, name, 0) {
        let open = source_skip_spaces(text, offset + name.len())
        if open < end && text.byte_at(open) == 40 { Some(source_skip_spaces(text, open + 1)) }
        else { None }
    } else { None }

/// Parse one decimal digit used by current bootstrap continuation fixtures.
def control_digit_value(byte: u8): Option[usize] =
    if byte == 48 { Some(0) }
    else if byte == 49 { Some(1) }
    else if byte == 50 { Some(2) }
    else if byte == 51 { Some(3) }
    else if byte == 52 { Some(4) }
    else if byte == 53 { Some(5) }
    else if byte == 54 { Some(6) }
    else if byte == 55 { Some(7) }
    else if byte == 56 { Some(8) }
    else if byte == 57 { Some(9) }
    else { None }

/// Parse a small non-negative integer from a resume argument.
def control_parse_small_usize(text: String, offset: usize, end: usize, value: usize, seen: bool): Option[usize] =
    if offset >= end {
        if seen { Some(value) } else { None }
    } else {
        match control_digit_value(text.byte_at(offset)) {
            Some(digit) => control_parse_small_usize(text, offset + 1, end, value * 10 + digit, true)
            None =>
                if seen { Some(value) }
                else { None }
        }
    }

/// Parse a numeric resume argument for either `k(...)` or named retry continuations.
def control_resume_const_at(text: String, offset: usize, end: usize): Option[usize] =
    match control_resume_arg_start(text, offset, end, "k") {
        Some(arg) => control_parse_small_usize(text, arg, end, 0, false)
        None =>
            match control_resume_arg_start(text, offset, end, "retry") {
                Some(arg) => control_parse_small_usize(text, arg, end, 0, false)
                None => None
            }
    }

/// Return an indexed function parameter when a resume argument passes it through directly.
def control_resume_arg_param_index(text: String, arg: usize, end: usize, item: TypedItemSkeleton): Option[usize] =
    let close = typed_source_region_find_byte_or_end(text, arg, end, 41)
    if close >= end { None }
    else { typed_function_param_index_from_region(text, item, arg, close) }

/// Parse a resume call that passes through an indexed function parameter.
def control_resume_param_at(text: String, offset: usize, end: usize, item: TypedItemSkeleton): Option[usize] =
    match control_resume_arg_start(text, offset, end, "k") {
        Some(arg) => control_resume_arg_param_index(text, arg, end, item)
        None =>
            match control_resume_arg_start(text, offset, end, "retry") {
                Some(arg) => control_resume_arg_param_index(text, arg, end, item)
                None => None
            }
    }

/// Build the observed resume shape from a function body region.
def control_resume_shape_loop(text: String, offset: usize, end: usize, count: usize, first: usize, last: usize): ControlBodyResumeShape =
    if offset >= end {
        if count == 0 { ControlBodyResumeUnknown }
        else if count == 1 { ControlBodyResumeConst(last) }
        else { ControlBodyMultiResumeConst(first, last) }
    } else {
        match control_resume_const_at(text, offset, end) {
            Some(value) =>
                control_resume_shape_loop(text, offset + 1, end, count + 1, if count == 0 { value } else { first }, value)
            None => control_resume_shape_loop(text, offset + 1, end, count, first, last)
        }
    }

/// Finish the observed resume shape when the scan reaches the body end.
def control_resume_shape_finish(count: usize, first: usize, last: usize, param: Option[usize]): ControlBodyResumeShape =
    match param {
        Some(index) => ControlBodyResumeParam(index)
        None =>
            if count == 0 { ControlBodyResumeUnknown }
            else if count == 1 { ControlBodyResumeConst(last) }
            else { ControlBodyMultiResumeConst(first, last) }
    }

/// Build the observed resume shape, preserving direct indexed-param resumes.
def control_resume_shape_loop_for_item(text: String, item: TypedItemSkeleton, offset: usize, end: usize, count: usize, first: usize, last: usize, param: Option[usize]): ControlBodyResumeShape =
    if offset >= end {
        control_resume_shape_finish(count, first, last, param)
    } else {
        match control_resume_param_at(text, offset, end, item) {
            Some(index) => control_resume_shape_loop_for_item(text, item, offset + 1, end, count, first, last, Some(index))
            None =>
                match control_resume_const_at(text, offset, end) {
                    Some(value) =>
                        control_resume_shape_loop_for_item(text, item, offset + 1, end, count + 1, if count == 0 { value } else { first }, value, param)
                    None => control_resume_shape_loop_for_item(text, item, offset + 1, end, count, first, last, param)
                }
        }
    }

/// Extract a conservative executable resume shape for one control owner.
def control_resume_shape_for_owner(module: TypedModule, fact: ControlSurfaceFact): ControlBodyResumeShape =
    match control_item_for_owner(module.items, fact.owner, 0) {
        Some(item) => {
            let text = control_source_file_text(module.alpha.project.files, fact.file, 0)
            let start = source_scan_item_body_region_start(text, item.surface.header.offset)
            let end = source_scan_item_region_end(text, item.surface.header.offset)
            control_resume_shape_loop_for_item(text, item, start, end, 0, 0, 0, None)
        }
        None => ControlBodyResumeUnknown
    }

/// Convert one control-surface fact into answer facts.
def answer_facts_from_control_surface(facts: Array[ControlSurfaceFact], index: usize, out: Vec[AnswerFact]): Array[AnswerFact] =
    if index == facts.len() { out.freeze() }
    else {
        let fact = facts.get(index)
        let boundary =
            if fact.has_shiftn { ControlDelimited }
            else if fact.has_shift { ControlShift }
            else if fact.has_reset { ControlReset }
            else { ControlNone }
        answer_facts_from_control_surface(
            facts,
            index + 1,
            out.push(AnswerFact {
                owner: fact.owner,
                boundary: boundary,
                answer: default_answer_type(),
            }))
    }

/// Convert one control-surface fact into CPS body facts.
def control_body_facts_from_surface_fact(module: TypedModule, fact: ControlSurfaceFact, out: Vec[ControlBodyFact]): Vec[ControlBodyFact] =
    {
        let resume_shape = control_resume_shape_for_owner(module, fact)
        let with_reset =
            if fact.has_reset {
                out.push(ControlBodyFact(fact.owner, fact.file, ControlBodyReset, default_answer_type(), resume_shape))
            } else { out }
        let with_shift =
            if fact.has_shift {
                with_reset.push(ControlBodyFact(fact.owner, fact.file, ControlBodyShift, default_answer_type(), resume_shape))
            } else { with_reset }
        if fact.has_shiftn {
            with_shift.push(ControlBodyFact(fact.owner, fact.file, ControlBodyShiftN, default_answer_type(), resume_shape))
        } else { with_shift }
    }

/// Build control body facts in stable owner order.
def control_body_facts_from_control_surface(module: TypedModule, facts: Array[ControlSurfaceFact], index: usize, out: Vec[ControlBodyFact]): Array[ControlBodyFact] =
    if index == facts.len() { out.freeze() }
    else { control_body_facts_from_control_surface(module, facts, index + 1, control_body_facts_from_surface_fact(module, facts.get(index), out)) }

/// Check `reset` and `shift` answer consistency.
def typed_module_control_surface(module: TypedModule): Array[ControlSurfaceFact] = module.control_surface

/// Read typed item skeletons through a helper for seed WAT lowering.
def typed_module_items_for_control(module: TypedModule): Array[TypedItemSkeleton] = module.items

/// Check `reset` and `shift` answer consistency.
def check_answer_control(module: TypedModule): Result[AnswerControlModule, SemanticDiagnostics] =
    let control_surface = typed_module_control_surface(module)
    let obligations = answer_control_obligations(control_surface, 0, Vec[AnswerControlObligation].new())
    if control_surface.len() > 0 && obligations.len() > 0 {
            Ok(AnswerControlModule(
                module,
                answer_facts_from_control_surface(control_surface, 0, Vec[AnswerFact].new()),
                control_body_facts_from_control_surface(module, control_surface, 0, Vec[ControlBodyFact].new())))
    } else {
        Ok(AnswerControlModule(module, answer_facts_none(), control_body_facts_from_no_control_items(typed_module_items_for_control(module), 0, Vec[ControlBodyFact].new())))
    }

/// Convert one control surface fact into answer/control obligations.
def answer_control_obligation_from_surface(fact: ControlSurfaceFact): AnswerControlObligation =
    AnswerControlObligation {
        owner: fact.owner,
        file: fact.file,
        requires_reset_answer: fact.has_reset,
        requires_shift_answer: fact.has_shift,
        requires_multishot_answer: fact.has_shiftn,
    }

/// Build answer/control obligations in stable owner order.
def answer_control_obligations(facts: Array[ControlSurfaceFact], index: usize, out: Vec[AnswerControlObligation]): Array[AnswerControlObligation] =
    if index == facts.len() { out.freeze() }
    else { answer_control_obligations(facts, index + 1, out.push(answer_control_obligation_from_surface(facts.get(index)))) }

/// Typed module annotated with answer/control facts.
type AnswerControlModule {
    typed: TypedModule,
    facts: Array[AnswerFact],
    control_bodies: Array[ControlBodyFact],
}
