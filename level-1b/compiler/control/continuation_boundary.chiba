/// World and thread boundary checks for captured continuations.
namespace compiler.control.continuation_boundary

use compiler.control.continuation_usage.*
use compiler.ir.control.*
use compiler.semantic.driver.*

/// Boundary target where a continuation cannot cross.
data ContinuationBoundary {
    BoundaryWorld,
    BoundaryThread,
}

/// Active captured continuation id set.
type ActiveContinuationSet {
    binders: Array[BinderId],
}

/// Boundary scan obligation derived before expression traversal.
type ContinuationBoundaryObligation {
    binder: BinderId,
    count: UsageCount,
    requires_world_boundary_check: bool,
    requires_thread_boundary_check: bool,
    requires_send_boundary_check: bool,
}

/// Boundary check result.
data ContinuationBoundaryCheck {
    BoundaryOk,
    BoundaryCrossed(ContinuationBoundary, BinderId),
}

/// Check whether active continuations cross a world/thread boundary.
def usage_module_facts(module: UsageModule): Array[UsageFact] = module.facts

/// Read callable storage facts through a helper for seed WAT lowering.
def usage_module_callable_storage(module: UsageModule): Array[CallableStorageFact] =
    Vec[CallableStorageFact].new().freeze()

/// Check whether active continuations cross a world/thread boundary.
def check_continuation_boundary(module: UsageModule): Result[UsageModule, SemanticDiagnostics] =
    let obligations = continuation_boundary_obligations(usage_module_facts(module), 0, Vec[ContinuationBoundaryObligation].new())
    if callable_storages_cross_send_boundary(usage_module_callable_storage(module), 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<control>", 0, 0, "continuation crosses world/thread/send boundary"))
            .freeze()))
    } else if continuation_boundary_obligations_same_thread_world(obligations, 0) { Ok(module) }
    else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<control>", 0, 0, "continuation crosses world/thread/send boundary"))
            .freeze()))
    }

/// Return true when sendable callable storage still admits continuation variants.
def callable_storage_crosses_send_boundary(fact: CallableStorageFact): bool =
    if fact.sendable { callable_storage_variants_have_continuation(fact.variants, 0) }
    else { false }

/// Check all callable storage facts for continuation variants crossing send boundaries.
def callable_storages_cross_send_boundary(facts: Array[CallableStorageFact], index: usize): bool =
    if index == facts.len() { false }
    else if callable_storage_crosses_send_boundary(facts.get(index)) { true }
    else { callable_storages_cross_send_boundary(facts, index + 1) }

/// Current bootstrap lowering keeps continuations in the same thread/world unless sendable storage says otherwise.
def continuation_boundary_obligations_same_thread_world(obligations: Array[ContinuationBoundaryObligation], index: usize): bool =
    if index == obligations.len() { true }
    else if obligations.get(index).requires_send_boundary_check { continuation_boundary_obligations_same_thread_world(obligations, index + 1) }
    else { true }

/// Convert one usage fact into a continuation boundary scan obligation.
def continuation_boundary_obligation_from_usage(fact: UsageFact): ContinuationBoundaryObligation =
    ContinuationBoundaryObligation {
        binder: fact.binder,
        count: fact.count,
        requires_world_boundary_check: true,
        requires_thread_boundary_check: true,
        requires_send_boundary_check: true,
    }

/// Build boundary scan obligations in stable usage-fact order.
def continuation_boundary_obligations(facts: Array[UsageFact], index: usize, out: Vec[ContinuationBoundaryObligation]): Array[ContinuationBoundaryObligation] =
    if index == facts.len() { out.freeze() }
    else { continuation_boundary_obligations(facts, index + 1, out.push(continuation_boundary_obligation_from_usage(facts.get(index)))) }

/// Return true when the boundary is illegal for continuation capture/resume.
def ContinuationBoundary.illegal_for_continuation(self): bool = true
