/// One-pass CPS conversion with administrative beta-reduction.
namespace compiler.control.cps

use compiler.control.replay_safety.*
use compiler.ir.control.*
use compiler.semantic.driver.*
use compiler.semantic.adt_tuple_lowering.*

/// CPS continuation representation.
data CpsContinuation {
    CpsInline,
    CpsDirect(BinderId),
    CpsPackage(BinderId),
}

/// CPS expression marker.
type CpsModule {
    source: ReplaySafeModule,
    continuations: Array[ContinuationFact],
    tail_forms: Array[CpsTailFormFact],
    branch_joins: Array[CpsBranchJoinFact],
    pattern_decisions: Array[CpsPatternDecisionFact],
    adt_ctors: Array[CpsAdtCtorLoweringFact],
}

/// Tail shape after one-pass CPS and administrative beta reduction.
data CpsTailFormKind {
    CpsTailReturn,
    CpsTailCall(str),
    CpsTailBranchCall(str, str),
    CpsMaterializedMultiShotFrame,
}

/// Per-owner CPS tail-form invariant consumed by lowering.
type CpsTailFormFact {
    owner: BinderId,
    kind: CpsTailFormKind,
    all_non_multishot_calls_are_tail: bool,
}

/// Branching shape that needs a CPS join continuation.
data BranchJoinKind {
    BranchJoinIfElse,
    BranchJoinElseIf,
    BranchJoinIfLet,
    BranchJoinMatch,
    BranchJoinShortCircuit,
}

/// Branching surface lowered into CPS join-planning input.
type BranchJoinPlan {
    owner: BinderId,
    file: SourceFileId,
    has_if: bool,
    has_else: bool,
    has_else_if: bool,
    has_if_let: bool,
    has_match: bool,
    has_short_circuit: bool,
}

/// CPS join continuation fact derived from branching surface syntax.
type CpsBranchJoinFact {
    owner: BinderId,
    file: SourceFileId,
    kind: BranchJoinKind,
    requires_join_continuation: bool,
    all_arms_resume_to_same_tail: bool,
}

/// CPS-level pattern decision fact.
type CpsPatternDecisionFact {
    owner: BinderId,
    file: SourceFileId,
    requires_test_chain: bool,
    lowers_to_if_else_and_field_extract: bool,
    failure_env_has_no_bindings: bool,
    missing_static_case_is_error: bool,
}

/// CPS-level constructor helper lowering fact.
type CpsAdtCtorLoweringFact {
    source: LoweredAdtCtor,
    helper_name: str,
    helper_arity: usize,
    returns_canonical_tuple: bool,
    requires_tail_tuple_return: bool,
    requires_utf8_identifier_lowering: bool,
}

/// Pick the primary branch-join kind for a coarse branching plan.
def branch_join_kind_from_plan(plan: BranchJoinPlan): BranchJoinKind =
    if plan.has_match { BranchJoinMatch }
    else if plan.has_if_let { BranchJoinIfLet }
    else if plan.has_short_circuit { BranchJoinShortCircuit }
    else if plan.has_else_if { BranchJoinElseIf }
    else { BranchJoinIfElse }

/// Convert one branch join plan into a CPS join fact.
def cps_branch_join_fact_from_plan(plan: BranchJoinPlan): CpsBranchJoinFact =
    CpsBranchJoinFact {
        owner: plan.owner,
        file: plan.file,
        kind: branch_join_kind_from_plan(plan),
        requires_join_continuation: true,
        all_arms_resume_to_same_tail: true,
    }

/// Build CPS branch join facts in stable owner order.
def cps_branch_join_facts_from_plans(plans: Array[BranchJoinPlan], index: usize, out: Vec[CpsBranchJoinFact]): Array[CpsBranchJoinFact] =
    if index == plans.len() { out.freeze() }
    else { cps_branch_join_facts_from_plans(plans, index + 1, out.push(cps_branch_join_fact_from_plan(plans.get(index)))) }

/// Convert one typed branching surface fact into a CPS join plan.
def branch_join_plan_from_surface(fact: BranchingSurfaceFact): BranchJoinPlan =
    BranchJoinPlan {
        owner: fact.owner,
        file: fact.file,
        has_if: fact.has_if,
        has_else: fact.has_else,
        has_else_if: fact.has_else_if,
        has_if_let: fact.has_if_let,
        has_match: fact.has_match,
        has_short_circuit: fact.has_short_circuit,
    }

/// Convert branching surface facts in stable owner order.
def branch_join_plans_from_surface(facts: Array[BranchingSurfaceFact], index: usize, out: Vec[BranchJoinPlan]): Array[BranchJoinPlan] =
    if index == facts.len() { out.freeze() }
    else { branch_join_plans_from_surface(facts, index + 1, out.push(branch_join_plan_from_surface(facts.get(index)))) }

/// Build CPS join plans from replay-safe typed module surface facts.
def branch_join_plans(module: ReplaySafeModule): Array[BranchJoinPlan] =
    branch_join_plans_from_surface(module.usage.answer.typed.branching_surface, 0, Vec[BranchJoinPlan].new())

/// Transform a replay-safe module to CPS while beta-reducing administrative continuations.
def one_pass_cps(module: ReplaySafeModule): Result[CpsModule, SemanticDiagnostics] =
    let branches = branch_join_plans(module)
    if module.usage.facts.len() == 0 && module.replay.len() == 0 {
        let continuations = cps_continuation_facts_none()
        let function_tail_forms = cps_tail_form_facts_from_functions(module.usage.answer.typed.functions, 0, Vec[CpsTailFormFact].new())
        let tail_builder = cps_tail_form_facts_copy(function_tail_forms, 0, Vec[CpsTailFormFact].new())
        Ok(CpsModule(
            module,
            continuations,
            cps_tail_form_facts_from_continuations(continuations, 0, tail_builder),
            cps_branch_join_facts_from_plans(branches, 0, Vec[CpsBranchJoinFact].new()),
            cps_pattern_decision_facts(module.usage.answer.typed),
            cps_adt_ctor_lowering_facts(module.usage.answer.typed.adt_ctors, 0, Vec[CpsAdtCtorLoweringFact].new())))
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<control>", 0, 0, "missing-lowering: one-pass CPS with administrative beta-reduction absent"))
            .freeze()))
    }

/// Empty CPS continuation fact stream for modules without control obligations.
def cps_continuation_facts_none(): Array[ContinuationFact] =
    Vec[ContinuationFact].new().freeze()

/// Build a tail-return fact for one ordinary typed function.
def cps_tail_form_fact_from_function(function: TypedFunctionBodyFact): CpsTailFormFact =
    CpsTailFormFact {
        owner: function.owner,
        kind: cps_tail_form_kind_from_function(function),
        all_non_multishot_calls_are_tail: true,
    }

/// Pick the CPS tail kind for a typed function body.
def cps_tail_form_kind_from_function(function: TypedFunctionBodyFact): CpsTailFormKind =
    match function.body {
        TypedFunctionTailCall(target) => CpsTailCall(target)
        TypedFunctionTailCallI32Const(target, _) => CpsTailCall(target)
        TypedFunctionReturnParam0 => CpsTailReturn
        TypedFunctionIfElseI32Const(_, _, _) => CpsTailReturn
        TypedFunctionIfElseTailCallI32Const(_, then_target, _, else_target, _) => CpsTailBranchCall(then_target, else_target)
        TypedFunctionBranchJoinPending => CpsTailReturn
        _ => CpsTailReturn
    }

/// Build CPS tail-form facts for ordinary functions in stable owner order.
def cps_tail_form_facts_from_functions(functions: Array[TypedFunctionBodyFact], index: usize, out: Vec[CpsTailFormFact]): Array[CpsTailFormFact] =
    if index == functions.len() { out.freeze() }
    else { cps_tail_form_facts_from_functions(functions, index + 1, out.push(cps_tail_form_fact_from_function(functions.get(index)))) }

/// Convert one continuation fact into a tail-form exception when it materializes ContN frames.
def cps_tail_form_fact_from_continuation(fact: ContinuationFact): Option[CpsTailFormFact] =
    match fact.capability {
        ContinuationContN =>
            Some(CpsTailFormFact {
                owner: fact.binder,
                kind: CpsMaterializedMultiShotFrame,
                all_non_multishot_calls_are_tail: true,
            })
        _ => None
    }

/// Append multi-shot continuation materialization exceptions to tail-form facts.
def cps_tail_form_facts_from_continuations(facts: Array[ContinuationFact], index: usize, out: Vec[CpsTailFormFact]): Array[CpsTailFormFact] =
    if index == facts.len() { out.freeze() }
    else {
        match cps_tail_form_fact_from_continuation(facts.get(index)) {
            Some(fact) => cps_tail_form_facts_from_continuations(facts, index + 1, out.push(fact))
            None => cps_tail_form_facts_from_continuations(facts, index + 1, out)
        }
    }

/// Copy existing tail-form facts into a builder before appending continuation exceptions.
def cps_tail_form_facts_copy(facts: Array[CpsTailFormFact], index: usize, out: Vec[CpsTailFormFact]): Vec[CpsTailFormFact] =
    if index == facts.len() { out }
    else { cps_tail_form_facts_copy(facts, index + 1, out.push(facts.get(index))) }

/// Return true when a continuation must materialize as a package.
def CpsContinuation.materialized(self): bool =
    match self {
        CpsPackage(_) => true
        _ => false
    }

/// Return true when an exhaustiveness fact for an owner requires static missing-case errors.
def pattern_exhaustiveness_requires_error(facts: Array[PatternExhaustivenessFact], owner: BinderId, index: usize): bool =
    if index == facts.len() { false }
    else if facts.get(index).owner.index == owner.index { facts.get(index).missing_case_is_error }
    else { pattern_exhaustiveness_requires_error(facts, owner, index + 1) }

/// Return true when one pattern environment fact proves failure has no bindings.
def pattern_failure_env_has_no_bindings(facts: Array[PatternEnvFact], owner: BinderId, index: usize): bool =
    if index == facts.len() { true }
    else if facts.get(index).owner.index == owner.index { facts.get(index).failure_branch_introduces_bindings == false }
    else { pattern_failure_env_has_no_bindings(facts, owner, index + 1) }

/// Convert one DFT step into a CPS decision fact.
def cps_pattern_decision_fact_from_step(module: TypedModule, step: PatternDftStep): CpsPatternDecisionFact =
    CpsPatternDecisionFact {
        owner: step.owner,
        file: step.file,
        requires_test_chain: step.test != PatternTestNone,
        lowers_to_if_else_and_field_extract: step.continues_depth_first || step.extracts_field,
        failure_env_has_no_bindings: pattern_failure_env_has_no_bindings(module.pattern_envs, step.owner, 0),
        missing_static_case_is_error: pattern_exhaustiveness_requires_error(module.pattern_exhaustiveness, step.owner, 0),
    }

/// Build CPS pattern decision facts in typed pattern order.
def cps_pattern_decision_facts_from_steps(module: TypedModule, steps: Array[PatternDftStep], index: usize, out: Vec[CpsPatternDecisionFact]): Array[CpsPatternDecisionFact] =
    if index == steps.len() { out.freeze() }
    else { cps_pattern_decision_facts_from_steps(module, steps, index + 1, out.push(cps_pattern_decision_fact_from_step(module, steps.get(index)))) }

/// Build all CPS pattern decision facts from typed pattern facts.
def cps_pattern_decision_facts(module: TypedModule): Array[CpsPatternDecisionFact] =
    cps_pattern_decision_facts_from_steps(module, module.pattern_dft_steps, 0, Vec[CpsPatternDecisionFact].new())

/// Convert one semantic ADT ctor helper into a CPS tail tuple-return obligation.
def cps_adt_ctor_lowering_fact_from_ctor(ctor: LoweredAdtCtor): CpsAdtCtorLoweringFact =
    CpsAdtCtorLoweringFact {
        source: ctor,
        helper_name: ctor.helper_name,
        helper_arity: ctor.helper_arity,
        returns_canonical_tuple: ctor.body.returns_canonical_tuple,
        requires_tail_tuple_return: true,
        requires_utf8_identifier_lowering: ctor.requires_utf8_identifier_lowering,
    }

/// Build CPS ADT ctor lowering facts in source constructor order.
def cps_adt_ctor_lowering_facts(ctors: Array[LoweredAdtCtor], index: usize, out: Vec[CpsAdtCtorLoweringFact]): Array[CpsAdtCtorLoweringFact] =
    if index == ctors.len() { out.freeze() }
    else { cps_adt_ctor_lowering_facts(ctors, index + 1, out.push(cps_adt_ctor_lowering_fact_from_ctor(ctors.get(index)))) }
