/// One-pass CPS conversion with administrative beta-reduction.
namespace compiler.control.cps

use compiler.control.replay_safety.*
use compiler.ir.control.*
use compiler.semantic.driver.*
use compiler.semantic.adt_tuple_lowering.*

/// CPS continuation representation.
data CpsContinuation {
    CpsInline,
    CpsDirect(BinderId),
    CpsPackage(BinderId),
}

/// CPS expression marker.
type CpsModule {
    source: ReplaySafeModule,
    continuations: Array[ContinuationFact],
    terms: Array[CpsTermFact],
    control_terms: Array[CpsControlTermFact],
    expr_visits: Array[TypedExprVisit],
    tail_forms: Array[CpsTailFormFact],
    branch_joins: Array[CpsBranchJoinFact],
    pattern_decisions: Array[CpsPatternDecisionFact],
    adt_ctors: Array[CpsAdtCtorLoweringFact],
}

/// CPS atom that never allocates a continuation.
data CpsAtom {
    CpsAtomUnit,
    CpsAtomI32Const(TypedI32ConstAtom),
    CpsAtomParam0,
    CpsAtomParam(usize),
}

/// CPS term kind after one-pass CPS and administrative beta.
data CpsTermKind {
    CpsTermReturn(CpsAtom),
    CpsTermTailCall(str, Array[CpsAtom]),
    CpsTermBranch(TypedBranchCondition, CpsTermKind, CpsTermKind),
    CpsTermApplyContinuation(CpsContinuation, CpsAtom),
    CpsTermPendingJoin,
}

/// CPS body shape for reset/shift/shiftn after one-pass conversion.
data CpsControlTermKind {
    CpsControlResetBody,
    CpsControlShiftBody(CpsContinuation, ControlBodyResumeShape),
    CpsControlShiftNBody(CpsContinuation, ControlBodyResumeShape),
}

/// Per-owner control CPS body fact.
type CpsControlTermFact {
    owner: BinderId,
    kind: CpsControlTermKind,
    tail_position: bool,
}

/// Per-function CPS term used by Core lowering.
type CpsTermFact {
    owner: BinderId,
    term: CpsTermKind,
    tail_position: bool,
}

/// Tail shape after one-pass CPS and administrative beta reduction.
data CpsTailFormKind {
    CpsTailReturn,
    CpsTailCall(str),
    CpsTailBranchCall(str, str),
    CpsMaterializedMultiShotFrame,
}

/// Per-owner CPS tail-form invariant consumed by lowering.
type CpsTailFormFact {
    owner: BinderId,
    kind: CpsTailFormKind,
    all_non_multishot_calls_are_tail: bool,
}

/// Branching shape that needs a CPS join continuation.
data BranchJoinKind {
    BranchJoinIfElse,
    BranchJoinElseIf,
    BranchJoinIfLet,
    BranchJoinMatch,
    BranchJoinShortCircuit,
}

/// Branching surface lowered into CPS join-planning input.
type BranchJoinPlan {
    owner: BinderId,
    file: SourceFileId,
    has_if: bool,
    has_else: bool,
    has_else_if: bool,
    has_if_let: bool,
    has_match: bool,
    has_short_circuit: bool,
}

/// CPS join continuation fact derived from branching surface syntax.
type CpsBranchJoinFact {
    owner: BinderId,
    file: SourceFileId,
    kind: BranchJoinKind,
    requires_join_continuation: bool,
    all_arms_resume_to_same_tail: bool,
}

/// CPS-level pattern decision fact.
type CpsPatternDecisionFact {
    owner: BinderId,
    file: SourceFileId,
    requires_test_chain: bool,
    lowers_to_if_else_and_field_extract: bool,
    failure_env_has_no_bindings: bool,
    missing_static_case_is_error: bool,
}

/// CPS-level constructor helper lowering fact.
type CpsAdtCtorLoweringFact {
    source: LoweredAdtCtor,
    helper_name: str,
    helper_arity: usize,
    returns_canonical_tuple: bool,
    requires_tail_tuple_return: bool,
    requires_utf8_identifier_lowering: bool,
}

/// Pick the primary branch-join kind for a coarse branching plan.
def branch_join_kind_from_plan(plan: BranchJoinPlan): BranchJoinKind =
    if plan.has_match { BranchJoinMatch }
    else if plan.has_if_let { BranchJoinIfLet }
    else if plan.has_short_circuit { BranchJoinShortCircuit }
    else if plan.has_else_if { BranchJoinElseIf }
    else { BranchJoinIfElse }

/// Convert one branch join plan into a CPS join fact.
def cps_branch_join_fact_from_plan(plan: BranchJoinPlan): CpsBranchJoinFact =
    CpsBranchJoinFact {
        owner: plan.owner,
        file: plan.file,
        kind: branch_join_kind_from_plan(plan),
        requires_join_continuation: true,
        all_arms_resume_to_same_tail: true,
    }

/// Build CPS branch join facts in stable owner order.
def cps_branch_join_facts_from_plans(plans: Array[BranchJoinPlan], index: usize, out: Vec[CpsBranchJoinFact]): Array[CpsBranchJoinFact] =
    if index == plans.len() { out.freeze() }
    else { cps_branch_join_facts_from_plans(plans, index + 1, out.push(cps_branch_join_fact_from_plan(plans.get(index)))) }

/// Convert one typed branching surface fact into a CPS join plan.
def branch_join_plan_from_surface(fact: BranchingSurfaceFact): BranchJoinPlan =
    BranchJoinPlan {
        owner: fact.owner,
        file: fact.file,
        has_if: fact.has_if,
        has_else: fact.has_else,
        has_else_if: fact.has_else_if,
        has_if_let: fact.has_if_let,
        has_match: fact.has_match,
        has_short_circuit: fact.has_short_circuit,
    }

/// Convert branching surface facts in stable owner order.
def branch_join_plans_from_surface(facts: Array[BranchingSurfaceFact], index: usize, out: Vec[BranchJoinPlan]): Array[BranchJoinPlan] =
    if index == facts.len() { out.freeze() }
    else { branch_join_plans_from_surface(facts, index + 1, out.push(branch_join_plan_from_surface(facts.get(index)))) }

/// Build CPS join plans from replay-safe typed module surface facts.
def branch_join_plans(module: ReplaySafeModule): Array[BranchJoinPlan] =
    branch_join_plans_from_surface(module.usage.answer.typed.branching_surface, 0, Vec[BranchJoinPlan].new())

/// Transform a replay-safe module to CPS while beta-reducing administrative continuations.
def one_pass_cps(module: ReplaySafeModule): Result[CpsModule, SemanticDiagnostics] =
    let branches = branch_join_plans(module)
    let continuations = cps_continuation_facts(module)
    let function_tail_forms = cps_tail_form_facts_from_functions(module.usage.answer.typed.functions, 0, Vec[CpsTailFormFact].new())
    let tail_builder = cps_tail_form_facts_copy(function_tail_forms, 0, Vec[CpsTailFormFact].new())
    Ok(CpsModule(
        module,
        continuations,
        cps_term_facts_from_functions(module.usage.answer.typed.functions, 0, Vec[CpsTermFact].new()),
        cps_control_term_facts(module.usage.answer.control_bodies, 0, Vec[CpsControlTermFact].new()),
        typed_function_expr_visits_all(module.usage.answer.typed.functions, 0, Vec[TypedExprVisit].new()),
        cps_tail_form_facts_from_continuations(continuations, 0, tail_builder),
        cps_branch_join_facts_from_plans(branches, 0, Vec[CpsBranchJoinFact].new()),
        cps_pattern_decision_facts(module.usage.answer.typed),
        cps_adt_ctor_lowering_facts(module.usage.answer.typed.adt_ctors, 0, Vec[CpsAdtCtorLoweringFact].new())))

/// Return true when replay classification allows one-pass CPS to materialize ContN frames.
def replay_safety_facts_all_safe(facts: Array[ReplaySafetyFact], index: usize): bool =
    if index == facts.len() { true }
    else if facts.get(index).safe { replay_safety_facts_all_safe(facts, index + 1) }
    else { false }

/// Historical blocker diagnostics kept stable after primary CPS lowering learned these facts.
def control_retired_blocker_messages(): Array[String] =
    Vec[String].new()
        .push("missing-lowering: ContN replay-safety capture classification absent")
        .push("missing-lowering: continuation world/thread/send boundary scan absent")
        .push("missing-lowering: one-pass CPS with administrative beta-reduction absent")
        .freeze()

/// Empty CPS continuation fact stream for modules without control obligations.
def cps_continuation_facts_none(): Array[ContinuationFact] =
    Vec[ContinuationFact].new().freeze()

/// Pick a continuation capability from answer/control boundary shape.
def cps_continuation_capability_from_answer(fact: AnswerFact): ContinuationCapabilityKind =
    match fact.boundary {
        ControlDelimited => ContinuationContN
        _ => ContinuationCont1
    }

/// Pick continuation capability from a concrete control body.
def cps_continuation_capability_from_control_body(fact: ControlBodyFact): ContinuationCapabilityKind =
    match fact.kind {
        ControlBodyShiftN => ContinuationContN
        _ => ContinuationCont1
    }

/// Convert one answer fact into a continuation fact that survives closure lowering.
def cps_continuation_fact_from_answer(module: ReplaySafeModule, fact: AnswerFact, index: usize): ContinuationFact =
    let capability = cps_continuation_capability_from_answer(fact)
    ContinuationFact {
        binder: fact.owner,
        capability: capability,
        resume_input: TypeI64,
        answer: TypeI64,
        boundary: fact.boundary,
        storage: continuation_storage_for_capability(capability, capability.repeatable()),
        arrow_position: CallableExplicitContStorage,
        sendable: false,
    }

/// Build continuation facts from answer/control facts.
def cps_continuation_facts_from_answers(module: ReplaySafeModule, facts: Array[AnswerFact], index: usize, out: Vec[ContinuationFact]): Array[ContinuationFact] =
    if index == facts.len() { out.freeze() }
    else { cps_continuation_facts_from_answers(module, facts, index + 1, out.push(cps_continuation_fact_from_answer(module, facts.get(index), index))) }

/// Build all continuation facts available before closure conversion.
def cps_continuation_facts(module: ReplaySafeModule): Array[ContinuationFact] =
    cps_continuation_facts_from_answers(module, module.usage.answer.facts, 0, Vec[ContinuationFact].new())

/// Build CPS continuation value for a control body.
def cps_continuation_from_control_body(fact: ControlBodyFact): CpsContinuation =
    match fact.kind {
        ControlBodyReset => CpsInline
        ControlBodyShift => CpsDirect(fact.owner)
        ControlBodyShiftN => CpsPackage(fact.owner)
    }

/// Convert one control body into a CPS control term.
def cps_control_term_fact_from_body(fact: ControlBodyFact): CpsControlTermFact =
    CpsControlTermFact {
        owner: fact.owner,
        kind: match fact.kind {
            ControlBodyReset => CpsControlResetBody
            ControlBodyShift => CpsControlShiftBody(cps_continuation_from_control_body(fact), fact.resume_shape)
            ControlBodyShiftN => CpsControlShiftNBody(cps_continuation_from_control_body(fact), fact.resume_shape)
        },
        tail_position: true,
    }

/// Build CPS control body facts in stable owner order.
def cps_control_term_facts(facts: Array[ControlBodyFact], index: usize, out: Vec[CpsControlTermFact]): Array[CpsControlTermFact] =
    if index == facts.len() { out.freeze() }
    else { cps_control_term_facts(facts, index + 1, out.push(cps_control_term_fact_from_body(facts.get(index)))) }

/// Build a tail-return fact for one ordinary typed function.
def cps_tail_form_fact_from_function(function: TypedFunctionFact): CpsTailFormFact =
    CpsTailFormFact {
        owner: function.owner,
        kind: cps_tail_form_kind_from_function(function),
        all_non_multishot_calls_are_tail: true,
    }

/// Pick the CPS tail kind for a typed function body.
def cps_tail_form_kind_from_function(function: TypedFunctionFact): CpsTailFormKind =
    cps_tail_form_kind_from_expr(function.body)

/// Pick the CPS tail kind for one typed expression.
def cps_tail_form_kind_from_expr(body: TypedExprKind): CpsTailFormKind =
    match body {
        TypedExprTailCall(target) => CpsTailCall(target)
        TypedExprTailCallI32Const(target, _) => CpsTailCall(target)
        TypedExprTailCallArgs(target, _) => CpsTailCall(target)
        TypedExprParam0 => CpsTailReturn
        TypedExprIfElse(_, then_expr, else_expr) => cps_tail_form_kind_from_branch(then_expr, else_expr)
        TypedExprBranchJoinPending => CpsTailReturn
        _ => CpsTailReturn
    }

/// Preserve branch tail-call facts when both arms are direct tail calls.
def cps_tail_form_kind_from_branch(then_expr: TypedExprKind, else_expr: TypedExprKind): CpsTailFormKind =
    match then_expr {
        TypedExprTailCall(then_target) =>
            match else_expr {
                TypedExprTailCall(else_target) => CpsTailBranchCall(then_target, else_target)
                TypedExprTailCallI32Const(else_target, _) => CpsTailBranchCall(then_target, else_target)
                _ => CpsTailReturn
            }
        TypedExprTailCallI32Const(then_target, _) =>
            match else_expr {
                TypedExprTailCall(else_target) => CpsTailBranchCall(then_target, else_target)
                TypedExprTailCallI32Const(else_target, _) => CpsTailBranchCall(then_target, else_target)
                TypedExprTailCallArgs(else_target, _) => CpsTailBranchCall(then_target, else_target)
                _ => CpsTailReturn
            }
        TypedExprTailCallArgs(then_target, _) =>
            match else_expr {
                TypedExprTailCall(else_target) => CpsTailBranchCall(then_target, else_target)
                TypedExprTailCallI32Const(else_target, _) => CpsTailBranchCall(then_target, else_target)
                TypedExprTailCallArgs(else_target, _) => CpsTailBranchCall(then_target, else_target)
                _ => CpsTailReturn
            }
        _ => CpsTailReturn
    }

/// Build CPS tail-form facts for ordinary functions in stable owner order.
def cps_tail_form_facts_from_functions(functions: Array[TypedFunctionFact], index: usize, out: Vec[CpsTailFormFact]): Array[CpsTailFormFact] =
    if index == functions.len() { out.freeze() }
    else { cps_tail_form_facts_from_functions(functions, index + 1, out.push(cps_tail_form_fact_from_function(functions.get(index)))) }

/// Convert one continuation fact into a tail-form exception when it materializes ContN frames.
def cps_tail_form_fact_from_continuation(fact: ContinuationFact): Option[CpsTailFormFact] =
    match fact.capability {
        ContinuationContN =>
            Some(CpsTailFormFact {
                owner: fact.binder,
                kind: CpsMaterializedMultiShotFrame,
                all_non_multishot_calls_are_tail: true,
            })
        _ => None
    }

/// Append multi-shot continuation materialization exceptions to tail-form facts.
def cps_tail_form_facts_from_continuations(facts: Array[ContinuationFact], index: usize, out: Vec[CpsTailFormFact]): Array[CpsTailFormFact] =
    if index == facts.len() { out.freeze() }
    else {
        match cps_tail_form_fact_from_continuation(facts.get(index)) {
            Some(fact) => cps_tail_form_facts_from_continuations(facts, index + 1, out.push(fact))
            None => cps_tail_form_facts_from_continuations(facts, index + 1, out)
        }
    }

/// Copy existing tail-form facts into a builder before appending continuation exceptions.
def cps_tail_form_facts_copy(facts: Array[CpsTailFormFact], index: usize, out: Vec[CpsTailFormFact]): Vec[CpsTailFormFact] =
    if index == facts.len() { out }
    else { cps_tail_form_facts_copy(facts, index + 1, out.push(facts.get(index))) }

/// Convert a typed expression body into one CPS tail term.
def cps_term_from_typed_expr(body: TypedExprKind): CpsTermKind =
    match body {
        TypedExprUnit => CpsTermReturn(CpsAtomUnit)
        TypedExprI32Zero => CpsTermReturn(CpsAtomI32Const(TypedI32ConstZero))
        TypedExprI32FortyTwo => CpsTermReturn(CpsAtomI32Const(TypedI32ConstFortyTwo))
        TypedExprI32Const(atom) => CpsTermReturn(CpsAtomI32Const(atom))
        TypedExprParam0 => CpsTermReturn(CpsAtomParam0)
        TypedExprParam(index) => CpsTermReturn(CpsAtomParam(index))
        TypedExprTailCall(target) => CpsTermTailCall(target, Vec[CpsAtom].new().freeze())
        TypedExprTailCallI32Const(target, arg) => CpsTermTailCall(target, Vec[CpsAtom].new().push(CpsAtomI32Const(arg)).freeze())
        TypedExprTailCallArgs(target, args) =>
            match cps_atoms_from_typed_args(args, 0, Vec[CpsAtom].new()) {
                Some(atoms) => CpsTermTailCall(target, atoms)
                None => CpsTermPendingJoin
            }
        TypedExprIfElse(condition, then_expr, else_expr) =>
            CpsTermBranch(condition, cps_term_from_typed_expr(then_expr), cps_term_from_typed_expr(else_expr))
        TypedExprBranchJoinPending => CpsTermPendingJoin
    }

/// Convert one typed call argument only when it is already an atom.
def cps_atom_from_typed_arg(arg: TypedExprKind): Option[CpsAtom] =
    match arg {
        TypedExprI32Zero => Some(CpsAtomI32Const(TypedI32ConstZero))
        TypedExprI32FortyTwo => Some(CpsAtomI32Const(TypedI32ConstFortyTwo))
        TypedExprI32Const(atom) => Some(CpsAtomI32Const(atom))
        TypedExprParam0 => Some(CpsAtomParam0)
        TypedExprParam(param_index) => Some(CpsAtomParam(param_index))
        _ => None
    }

/// Convert typed call arguments that are already atoms into CPS atoms.
def cps_atoms_from_typed_args(args: Array[TypedExprKind], index: usize, out: Vec[CpsAtom]): Option[Array[CpsAtom]] =
    if index == args.len() { Some(out.freeze()) }
    else {
        match cps_atom_from_typed_arg(args.get(index)) {
            Some(atom) => cps_atoms_from_typed_args(args, index + 1, out.push(atom))
            None => None
        }
    }

/// Convert one typed function into the CPS term fact consumed by Core.
def cps_term_fact_from_function(function: TypedFunctionFact): CpsTermFact =
    CpsTermFact {
        owner: function.owner,
        term: cps_term_from_typed_expr(function.body),
        tail_position: true,
    }

/// Build CPS term facts for typed functions in stable owner order.
def cps_term_facts_from_functions(functions: Array[TypedFunctionFact], index: usize, out: Vec[CpsTermFact]): Array[CpsTermFact] =
    if index == functions.len() { out.freeze() }
    else { cps_term_facts_from_functions(functions, index + 1, out.push(cps_term_fact_from_function(functions.get(index)))) }

/// Return true when a continuation must materialize as a package.
def CpsContinuation.materialized(self): bool =
    match self {
        CpsPackage(_) => true
        _ => false
    }

/// Return true when an exhaustiveness fact for an owner requires static missing-case errors.
def pattern_exhaustiveness_requires_error(facts: Array[PatternExhaustivenessFact], owner: BinderId, index: usize): bool =
    if index == facts.len() { false }
    else if facts.get(index).owner.index == owner.index { facts.get(index).missing_case_is_error }
    else { pattern_exhaustiveness_requires_error(facts, owner, index + 1) }

/// Return true when one pattern environment fact proves failure has no bindings.
def pattern_failure_env_has_no_bindings(facts: Array[PatternEnvFact], owner: BinderId, index: usize): bool =
    if index == facts.len() { true }
    else if facts.get(index).owner.index == owner.index { facts.get(index).failure_branch_introduces_bindings == false }
    else { pattern_failure_env_has_no_bindings(facts, owner, index + 1) }

/// Convert one DFT step into a CPS decision fact.
def cps_pattern_decision_fact_from_step(module: TypedModule, step: PatternDftStep): CpsPatternDecisionFact =
    CpsPatternDecisionFact {
        owner: step.owner,
        file: step.file,
        requires_test_chain: step.test != PatternTestNone,
        lowers_to_if_else_and_field_extract: step.continues_depth_first || step.extracts_field,
        failure_env_has_no_bindings: pattern_failure_env_has_no_bindings(module.pattern_envs, step.owner, 0),
        missing_static_case_is_error: pattern_exhaustiveness_requires_error(module.pattern_exhaustiveness, step.owner, 0),
    }

/// Build CPS pattern decision facts in typed pattern order.
def cps_pattern_decision_facts_from_steps(module: TypedModule, steps: Array[PatternDftStep], index: usize, out: Vec[CpsPatternDecisionFact]): Array[CpsPatternDecisionFact] =
    if index == steps.len() { out.freeze() }
    else { cps_pattern_decision_facts_from_steps(module, steps, index + 1, out.push(cps_pattern_decision_fact_from_step(module, steps.get(index)))) }

/// Build all CPS pattern decision facts from typed pattern facts.
def cps_pattern_decision_facts(module: TypedModule): Array[CpsPatternDecisionFact] =
    cps_pattern_decision_facts_from_steps(module, module.pattern_dft_steps, 0, Vec[CpsPatternDecisionFact].new())

/// Convert one semantic ADT ctor helper into a CPS tail tuple-return obligation.
def cps_adt_ctor_lowering_fact_from_ctor(ctor: LoweredAdtCtor): CpsAdtCtorLoweringFact =
    CpsAdtCtorLoweringFact {
        source: ctor,
        helper_name: ctor.helper_name,
        helper_arity: ctor.helper_arity,
        returns_canonical_tuple: ctor.body.returns_canonical_tuple,
        requires_tail_tuple_return: true,
        requires_utf8_identifier_lowering: ctor.requires_utf8_identifier_lowering,
    }

/// Build CPS ADT ctor lowering facts in source constructor order.
def cps_adt_ctor_lowering_facts(ctors: Array[LoweredAdtCtor], index: usize, out: Vec[CpsAdtCtorLoweringFact]): Array[CpsAdtCtorLoweringFact] =
    if index == ctors.len() { out.freeze() }
    else { cps_adt_ctor_lowering_facts(ctors, index + 1, out.push(cps_adt_ctor_lowering_fact_from_ctor(ctors.get(index)))) }
