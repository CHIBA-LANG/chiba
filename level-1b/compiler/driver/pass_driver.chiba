/// Single-threaded level-1b pass driver contract.
namespace compiler.driver.pass_driver

use compiler.cli.*
use compiler.source.project.*
use compiler.source.compile_if.*
use compiler.source.semantic_gate.*

/// Driver diagnostic with stable ordering key.
type DriverDiagnostic {
    file: String,
    line: usize,
    column: usize,
    message: String,
}

/// Ordered diagnostic list.
type DriverDiagnostics {
    items: Array[DriverDiagnostic],
}

/// One driver input.
type DriverInput {
    cli: ChibacCliConfig,
    project: ProjectSurface,
    target_facts: CompileTargetFacts,
}

/// Return true when a scanned compile_if fact admits the item for this target.
def source_compile_if_fact_enabled(fact: SourceCompileIfFacts, target: CompileTargetFacts): bool =
    match fact.shape {
        SourceCompileIfAbsent => true
        SourceCompileIfEqTarget => fact.has_target_predicate && target.target == "wasm32-unknown-wasi"
        SourceCompileIfEqBackend => fact.has_backend_predicate && target.backend == "wasm-gc"
        SourceCompileIfAll => source_compile_if_all_enabled(fact, target)
        SourceCompileIfAny => source_compile_if_any_enabled(fact, target)
        SourceCompileIfNot => source_compile_if_not_enabled(fact, target)
        SourceCompileIfUnknown => false
    }

/// Evaluate the supported all(...) compile_if shape.
def source_compile_if_all_enabled(fact: SourceCompileIfFacts, target: CompileTargetFacts): bool =
    {
        let target_ok = fact.has_target_predicate == false || target.target == "wasm32-unknown-wasi"
        let backend_ok = fact.has_backend_predicate == false || target.backend == "wasm-gc"
        target_ok && backend_ok
    }

/// Evaluate the supported or(...) compile_if shape.
def source_compile_if_any_enabled(fact: SourceCompileIfFacts, target: CompileTargetFacts): bool =
    {
        let target_ok = fact.has_target_predicate && target.target == "wasm32-unknown-wasi"
        let backend_ok = fact.has_backend_predicate && target.backend == "wasm-gc"
        target_ok || backend_ok
    }

/// Evaluate the supported not(...) compile_if shape.
def source_compile_if_not_enabled(fact: SourceCompileIfFacts, target: CompileTargetFacts): bool =
    !source_compile_if_any_enabled(fact, target)

/// Return true when a scanned item remains enabled after compile_if filtering.
def source_item_enabled_for_target(item: SourceItemScanResult, target: CompileTargetFacts): bool =
    match source_item_compile_if(item) {
        Some(fact) => source_compile_if_fact_enabled(fact, target)
        None => true
    }

/// Clear compile_if after the source driver has applied it.
def source_item_after_compile_if_filter(item: SourceItemScanResult): SourceItemScanResult =
    item

/// Copy enabled source items into a fresh item array.
def filter_source_items_for_target(items: Array[SourceItemScanResult], target: CompileTargetFacts, index: usize, out: Vec[SourceItemScanResult]): Array[SourceItemScanResult] =
    if index == items.len() { out.freeze() }
    else {
        let item = items.get(index)
        if source_item_enabled_for_target(item, target) {
            filter_source_items_for_target(items, target, index + 1, out.push(source_item_after_compile_if_filter(item)))
        } else { filter_source_items_for_target(items, target, index + 1, out) }
    }

/// Apply compile_if filtering to source facts before semantic gates.
def source_facts_with_filtered_items(facts: SourceProjectFacts, target: CompileTargetFacts): SourceProjectFacts =
    SourceProjectFacts {
        parser: facts.parser,
        headers: facts.headers,
        docs: facts.docs,
        compile_if: facts.compile_if,
        namespaces: facts.namespaces,
        namespace_warnings: facts.namespace_warnings,
        uses: facts.uses,
        items: filter_source_items_for_target(facts.items, target, 0, Vec[SourceItemScanResult].new()),
        owner_symbols: facts.owner_symbols,
        ast_owner_symbols: facts.ast_owner_symbols,
        ast_expr_nodes: facts.ast_expr_nodes,
        utf8_warnings: facts.utf8_warnings,
    }

/// Apply source-driver target filtering before gates.
def project_with_filtered_items(project: ProjectSurface, target: CompileTargetFacts): ProjectSurface =
    ProjectSurface {
        files: project.files,
        namespaces: project.namespaces,
        facts: source_facts_with_filtered_items(project.facts, target),
    }

/// Return true when source gates produced no diagnostics.
def source_gate_result_ok(result: SourceGateResult): bool =
    source_gate_errors_empty(source_gate_result_errors(result))

/// Return true when a source gate error array is empty.
def source_gate_errors_empty(errors: Array[SourceGateError]): bool =
    errors.len() == 0

/// Return source gate project without relying on method/field lowering at call sites.
def source_gate_result_project(result: SourceGateResult): ProjectSurface =
    result.project

/// Return source gate errors without relying on method/field lowering at call sites.
def source_gate_result_errors(result: SourceGateResult): Array[SourceGateError] =
    result.errors

/// Run source loading, header filtering, and source-level semantic gates.
def run_source_driver(input: DriverInput): Result[ProjectSurface, DriverDiagnostics] =
    {
        let filtered = project_with_filtered_items(input.project, input.target_facts)
        match check_source_semantic_gates(filtered) {
            result =>
                if source_gate_result_ok(result) { Ok(source_gate_result_project(result)) }
                else { Err(source_gate_diagnostics(source_gate_result_errors(result), 0, Vec[DriverDiagnostic].new())) }
        }
    }

/// Convert a source gate error into a driver diagnostic.
def source_gate_diagnostic(error: SourceGateError): DriverDiagnostic =
    DriverDiagnostic("<source>", 0, 0, error.message)

/// Convert source gate errors into deterministic driver diagnostics.
def source_gate_diagnostics(errors: Array[SourceGateError], index: usize, out: Vec[DriverDiagnostic]): DriverDiagnostics =
    if index == errors.len() { DriverDiagnostics(out.freeze()).stable_sort() }
    else { source_gate_diagnostics(errors, index + 1, out.push(source_gate_diagnostic(errors.get(index)))) }

/// Return true when `left` should appear before `right` in diagnostic order.
def driver_diagnostic_before(left: DriverDiagnostic, right: DriverDiagnostic): bool =
    if left.file < right.file { true }
    else if right.file < left.file { false }
    else if left.line < right.line { true }
    else if right.line < left.line { false }
    else if left.column < right.column { true }
    else if right.column < left.column { false }
    else { left.message < right.message }

/// Copy all diagnostics before `index` into `out`.
def driver_diagnostics_copy_prefix(items: Array[DriverDiagnostic], index: usize, out: Vec[DriverDiagnostic], cursor: usize): Vec[DriverDiagnostic] =
    if cursor == index { out }
    else { driver_diagnostics_copy_prefix(items, index, out.push(items.get(cursor)), cursor + 1) }

/// Copy all diagnostics from `index` to the end into `out`.
def driver_diagnostics_copy_suffix(items: Array[DriverDiagnostic], index: usize, out: Vec[DriverDiagnostic]): Vec[DriverDiagnostic] =
    if index == items.len() { out }
    else { driver_diagnostics_copy_suffix(items, index + 1, out.push(items.get(index))) }

/// Insert one diagnostic into an already sorted diagnostic array.
def driver_diagnostics_insert(sorted: Array[DriverDiagnostic], item: DriverDiagnostic, index: usize): Array[DriverDiagnostic] =
    if index == sorted.len() {
        driver_diagnostics_copy_prefix(sorted, index, Vec[DriverDiagnostic].new(), 0)
            .push(item)
            .freeze()
    } else if driver_diagnostic_before(item, sorted.get(index)) {
        driver_diagnostics_copy_suffix(sorted, index,
            driver_diagnostics_copy_prefix(sorted, index, Vec[DriverDiagnostic].new(), 0).push(item))
            .freeze()
    } else { driver_diagnostics_insert(sorted, item, index + 1) }

/// Sort diagnostic arrays with stable insertion order for equal keys.
def driver_diagnostics_sort_items(items: Array[DriverDiagnostic], index: usize, sorted: Array[DriverDiagnostic]): Array[DriverDiagnostic] =
    if index == items.len() { sorted }
    else { driver_diagnostics_sort_items(items, index + 1, driver_diagnostics_insert(sorted, items.get(index), 0)) }

/// Sort diagnostics by file, line, column, then message.
def DriverDiagnostics.stable_sort(self): DriverDiagnostics =
    DriverDiagnostics {
        items: driver_diagnostics_sort_items(self.items, 0, Vec[DriverDiagnostic].new().freeze()),
    }
