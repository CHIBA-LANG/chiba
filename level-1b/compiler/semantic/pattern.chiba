/// Pattern elaboration pass.
namespace compiler.semantic.pattern

use compiler.semantic.alpha.*

/// Elaborated pattern identifier.
type PatternId {
    index: usize,
}

/// Coarse source position that introduced a pattern before full AST parsing.
data PatternSourceKind {
    PatternSourceParam,
    PatternSourceLet,
    PatternSourceIfLet,
    PatternSourceMatchArm,
}

/// Pattern test emitted by depth-first destructuring lowering.
data PatternTestKind {
    PatternTestNone,
    PatternTestTag,
    PatternTestLiteral,
    PatternTestFieldShape,
}

/// One DFT pattern-lowering step.
type PatternDftStep {
    owner: BinderId,
    file: SourceFileId,
    source: PatternSourceKind,
    test: PatternTestKind,
    binds_value: bool,
    extracts_field: bool,
    continues_depth_first: bool,
    failure_goes_else: bool,
}

/// Exhaustiveness fact for match lowering.
type PatternExhaustivenessFact {
    owner: BinderId,
    file: SourceFileId,
    requires_bool_cases: bool,
    requires_data_union_variants: bool,
    wildcard_or_catchall_covers_rest: bool,
    guard_blocks_exhaustiveness: bool,
    exhaustive_static: bool,
    missing_case_is_error: bool,
}

/// Pattern environment rule needed by branch lowering.
type PatternEnvFact {
    owner: BinderId,
    file: SourceFileId,
    success_branch_introduces_bindings: bool,
    failure_branch_introduces_bindings: bool,
    wildcard_discards_value: bool,
    pattern_bind_allows_shadowing: bool,
}

/// Pattern facts needed by type inference.
type PatternFacts {
    patterns: Array[PatternId],
    dft_steps: Array[PatternDftStep],
    exhaustiveness: Array[PatternExhaustivenessFact],
    envs: Array[PatternEnvFact],
}

/// Elaborate parameter, `let`, and match patterns after alpha conversion.
def elaborate_patterns(module: AlphaModule): PatternFacts =
    PatternFacts(
        pattern_ids_from_binders(module.binders, 0, Vec[PatternId].new()),
        pattern_dft_steps_from_origins(module.origins, 0, Vec[PatternDftStep].new()),
        pattern_exhaustiveness_from_origins(module.origins, 0, Vec[PatternExhaustivenessFact].new()),
        pattern_envs_from_origins(module.origins, 0, Vec[PatternEnvFact].new()))

/// Build stable placeholder pattern ids from alpha binders until full pattern AST lowering lands.
def pattern_ids_from_binders(binders: Array[BinderId], index: usize, out: Vec[PatternId]): Array[PatternId] =
    if index == binders.len() { out.freeze() }
    else { pattern_ids_from_binders(binders, index + 1, out.push(PatternId { index: index })) }

/// Return true when an origin contains any pattern surface.
def origin_has_pattern_surface(origin: AlphaBinderOrigin): bool =
    if origin.surface.has_pattern_params { true }
    else if origin.surface.has_wildcard_let { true }
    else if origin.surface.has_if_let_expr { true }
    else if origin.surface.has_match_expr { true }
    else { origin.surface.has_deep_pattern_surface }

/// Pick the coarse source kind for one pattern surface.
def pattern_source_kind_from_origin(origin: AlphaBinderOrigin): PatternSourceKind =
    if origin.surface.has_match_expr { PatternSourceMatchArm }
    else if origin.surface.has_if_let_expr { PatternSourceIfLet }
    else if origin.surface.has_wildcard_let { PatternSourceLet }
    else { PatternSourceParam }

/// Pick the first DFT test required by one pattern surface.
def pattern_test_kind_from_origin(origin: AlphaBinderOrigin): PatternTestKind =
    if origin.surface.has_match_expr { PatternTestTag }
    else if origin.surface.has_if_let_expr { PatternTestTag }
    else if origin.surface.has_deep_pattern_surface { PatternTestFieldShape }
    else { PatternTestNone }

/// Return true when a pattern surface may bind values on success.
def pattern_surface_binds_value(origin: AlphaBinderOrigin): bool =
    if origin.surface.has_wildcard_let { false }
    else { origin.surface.has_pattern_params || origin.surface.has_if_let_expr || origin.surface.has_match_expr || origin.surface.has_deep_pattern_surface }

/// Build one DFT pattern-lowering step from a source origin.
def pattern_dft_step_from_origin(origin: AlphaBinderOrigin): Option[PatternDftStep] =
    if origin_has_pattern_surface(origin) {
        Some(PatternDftStep {
            owner: origin.binder,
            file: origin.file,
            source: pattern_source_kind_from_origin(origin),
            test: pattern_test_kind_from_origin(origin),
            binds_value: pattern_surface_binds_value(origin),
            extracts_field: origin.surface.has_deep_pattern_surface,
            continues_depth_first: origin.surface.has_deep_pattern_surface,
            failure_goes_else: origin.surface.has_if_let_expr,
        })
    } else { None }

/// Build DFT lowering steps in alpha order.
def pattern_dft_steps_from_origins(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[PatternDftStep]): Array[PatternDftStep] =
    if index == origins.len() { out.freeze() }
    else {
        match pattern_dft_step_from_origin(origins.get(index)) {
            Some(step) => pattern_dft_steps_from_origins(origins, index + 1, out.push(step))
            None => pattern_dft_steps_from_origins(origins, index + 1, out)
        }
    }

/// Build a conservative exhaustiveness fact for one match surface.
def pattern_exhaustiveness_from_origin(origin: AlphaBinderOrigin): Option[PatternExhaustivenessFact] =
    if origin.surface.has_match_expr {
        Some(PatternExhaustivenessFact {
            owner: origin.binder,
            file: origin.file,
            requires_bool_cases: true,
            requires_data_union_variants: true,
            wildcard_or_catchall_covers_rest: origin.surface.has_wildcard_let,
            guard_blocks_exhaustiveness: false,
            exhaustive_static: origin.surface.has_wildcard_let,
            missing_case_is_error: true,
        })
    } else { None }

/// Build match exhaustiveness facts in alpha order.
def pattern_exhaustiveness_from_origins(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[PatternExhaustivenessFact]): Array[PatternExhaustivenessFact] =
    if index == origins.len() { out.freeze() }
    else {
        match pattern_exhaustiveness_from_origin(origins.get(index)) {
            Some(fact) => pattern_exhaustiveness_from_origins(origins, index + 1, out.push(fact))
            None => pattern_exhaustiveness_from_origins(origins, index + 1, out)
        }
    }

/// Build one pattern environment fact from a source origin.
def pattern_env_from_origin(origin: AlphaBinderOrigin): Option[PatternEnvFact] =
    if origin_has_pattern_surface(origin) {
        Some(PatternEnvFact {
            owner: origin.binder,
            file: origin.file,
            success_branch_introduces_bindings: pattern_surface_binds_value(origin),
            failure_branch_introduces_bindings: false,
            wildcard_discards_value: origin.surface.has_wildcard_let,
            pattern_bind_allows_shadowing: true,
        })
    } else { None }

/// Build pattern environment facts in alpha order.
def pattern_envs_from_origins(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[PatternEnvFact]): Array[PatternEnvFact] =
    if index == origins.len() { out.freeze() }
    else {
        match pattern_env_from_origin(origins.get(index)) {
            Some(fact) => pattern_envs_from_origins(origins, index + 1, out.push(fact))
            None => pattern_envs_from_origins(origins, index + 1, out)
        }
    }
