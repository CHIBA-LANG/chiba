/// Capability legality rules for Ref, Ptr, UnsafeRef, Atomic, and ABI scalar types.
namespace compiler.semantic.capability_rules

use compiler.ir.control.*
use compiler.semantic.types.*
use compiler.semantic.type_unify.*

/// Atomic ordering accepted by semantic checks.
data AtomicOrdering {
    AtomicRelaxed,
    AtomicAcquire,
    AtomicRelease,
    AtomicAcqRel,
    AtomicSeqCst,
}

/// Capability check result.
data CapabilityCheck {
    CapabilityOk,
    CapabilityErr(String),
}

/// Unsafe lexical context derived by the parser/type checker.
data UnsafeContext {
    UnsafeOutside,
    UnsafeInside,
}

/// Convert the temporary depth counter into an explicit context fact.
def unsafe_context_from_depth(unsafe_depth: usize): UnsafeContext =
    match unsafe_depth {
        0 => UnsafeOutside
        _ => UnsafeInside
    }

/// Return true when unsafe-only capabilities are currently legal.
def UnsafeContext.active(self): bool =
    match self {
        UnsafeOutside => false
        UnsafeInside => true
    }

/// Check assignment through `Ref[T]`.
def check_ref_assignment(lhs: SemType, rhs: SemType): CapabilityCheck =
    match lhs {
        TyRef(inner) =>
            match unify(inner, rhs) {
                Ok(_) => CapabilityOk
                Err(_) => CapabilityErr("Ref assignment type mismatch")
            }
        _ => CapabilityErr("assignment lhs must be Ref[T]")
    }

/// Return true when a type can be stored in an `Atomic[T]`.
def atomic_payload_supported(ty: SemType): bool =
    match ty {
        TyNominal(id) =>
            if id.name == "i32" { true }
            else if id.name == "i64" { true }
            else if id.name == "usize" { true }
            else if id.name == "bool" { true }
            else { false }
        TyPtr(_) => true
        _ => false
    }

/// Check `Atomic[T]` payload legality.
def check_atomic_payload(ty: SemType): CapabilityCheck =
    match ty {
        TyAtomic(inner) =>
            if atomic_payload_supported(inner) { CapabilityOk }
            else { CapabilityErr("unsupported Atomic[T]") }
        _ => CapabilityErr("expected Atomic[T]")
    }

/// Check whether a type is legal outside an unsafe block.
def check_unsafe_type(ty: SemType, unsafe_depth: usize): CapabilityCheck =
    let context = unsafe_context_from_depth(unsafe_depth)
    match ty {
        TyPtr(_) =>
            if context.active() { CapabilityOk }
            else { CapabilityErr("Ptr requires unsafe block") }
        TyUnsafeRef(_) =>
            if context.active() { CapabilityOk }
            else { CapabilityErr("UnsafeRef requires unsafe block") }
        _ => CapabilityOk
    }

/// Check `Atomic.load` ordering.
def atomic_load_ordering_allowed(order: AtomicOrdering): bool =
    match order {
        AtomicRelease => false
        AtomicAcqRel => false
        _ => true
    }

/// Check `Atomic.store` ordering.
def atomic_store_ordering_allowed(order: AtomicOrdering): bool =
    match order {
        AtomicAcquire => false
        AtomicAcqRel => false
        _ => true
    }

/// Check that sendable callable storage excludes continuation variants.
def check_sendable_callable_storage(fact: CallableStorageFact): CapabilityCheck =
    if fact.excludes_continuations_for_send() { CapabilityOk }
    else { CapabilityErr("sendable callable storage excludes continuations") }

/// Check all callable storage facts for send legality.
def check_sendable_callable_storages(facts: Array[CallableStorageFact], index: usize): CapabilityCheck =
    if index == facts.len() { CapabilityOk }
    else {
        match check_sendable_callable_storage(facts.get(index)) {
            CapabilityOk => check_sendable_callable_storages(facts, index + 1)
            CapabilityErr(message) => CapabilityErr(message)
        }
    }
