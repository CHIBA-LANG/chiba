/// Generate generic surface facts in stable binder order.
def generic_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[GenericSurfaceFact]): Array[GenericSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match generic_surface_fact_from_skeleton(skeletons.get(index)) {
