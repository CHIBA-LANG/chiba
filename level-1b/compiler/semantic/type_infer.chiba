/// HM + row inference driver.
namespace compiler.semantic.type_infer

use compiler.source.project.*
use compiler.ir.control.*
use compiler.semantic.alpha.*
use compiler.semantic.pattern.*
use compiler.semantic.types.*

/// Coarse typed item category before full item lowering.
data TypedItemSkeletonKind {
    TypedItemFunction,
    TypedItemStaticValue,
    TypedItemExternFunction,
    TypedItemNominalType,
    TypedItemData,
    TypedItemUnion,
    TypedItemInterface,
}

/// Source item skeleton ready for real type-expression and body inference.
type TypedItemSkeleton {
    binder: BinderId,
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    skeleton_kind: TypedItemSkeletonKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Stable item-to-namespace ownership fact after alpha conversion.
type NamespaceOwnershipFact {
    owner: BinderId,
    file: SourceFileId,
    owner_namespace: NamespaceNameSlice,
}

/// Method/operator declaration surface fact after alpha conversion.
type MethodSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    receiver: SourceNameSlice,
    member: SourceNameSlice,
    operator: bool,
}

/// Branching surface fact used by typed lowering and CPS join planning.
type BranchingSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_if: bool,
    has_else: bool,
    has_else_if: bool,
    has_if_let: bool,
    has_match: bool,
    has_short_circuit: bool,
}

/// Delimited-control surface fact before answer/control checking.
type ControlSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_reset: bool,
    has_shift: bool,
    has_shiftn: bool,
}

/// Static value surface fact before module-load init dependency analysis.
type GlobalInitSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_initializer: bool,
    has_dependency: bool,
    world_local: bool,
    has_ref_type: bool,
}

/// Pipe surface fact before placeholder and receiver-first desugaring.
type PipeSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_pipe: bool,
    has_placeholder: bool,
    has_chain: bool,
}

/// Pattern surface fact before DFT lowering and exhaustiveness checks.
type PatternSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_match: bool,
    has_if_let: bool,
    has_deep_pattern: bool,
    has_pattern_params: bool,
    has_wildcard_let: bool,
}

/// Compiler intrinsic and tuple bridge surface before checked lowering.
type IntrinsicSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_compiler_intrinsic_call: bool,
    has_tuple_type_surface: bool,
}

/// Generic/template surface before definition-time and instantiation checks.
type GenericSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_explicit_type_params: bool,
    has_auto_generic_params: bool,
    has_explicit_instantiation_call: bool,
    has_generic_self_method: bool,
}

/// Classify a scanned source item into the first typed-lowering bucket.
def classify_typed_item_skeleton_kind(item: AlphaBinderOrigin): TypedItemSkeletonKind =
    match item.kind {
        SourceItemDef => {
            if item.surface.has_params { TypedItemFunction }
            else { TypedItemStaticValue }
        }
        SourceItemExtern => TypedItemExternFunction
        SourceItemType => TypedItemNominalType
        SourceItemData => TypedItemData
        SourceItemUnion => TypedItemUnion
        SourceItemInterface => TypedItemInterface
    }

/// Build source item skeletons from alpha origins before HM + row inference.
def typed_item_skeletons_from_alpha(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[TypedItemSkeleton]): Array[TypedItemSkeleton] =
    if index == origins.len() { out.freeze() }
    else {
        let origin = origins.get(index)
        typed_item_skeletons_from_alpha(
            origins,
            index + 1,
            out.push(TypedItemSkeleton {
                binder: origin.binder,
                file: origin.file,
                owner_namespace: origin.owner_namespace,
                kind: origin.kind,
                skeleton_kind: classify_typed_item_skeleton_kind(origin),
                name: origin.name,
                private: origin.private,
                attributes: origin.attributes,
                surface: origin.surface,
                line: origin.line,
                column: origin.column,
            }))
    }

/// Return true when placeholder pattern facts cover all source item skeletons.
def type_inference_has_pattern_coverage(skeletons: Array[TypedItemSkeleton], patterns: PatternFacts): bool =
    patterns.patterns.len() >= skeletons.len()

/// Return true when item surfaces mention callable or explicit continuation storage types.
def typed_item_skeletons_have_callable_storage_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_callable_arrow { true }
        else if surface.has_explicit_continuation_type { true }
        else { typed_item_skeletons_have_callable_storage_surface(skeletons, index + 1) }
    }

/// Pick callable position from coarse source surface facts.
def callable_storage_position_from_surface(surface: SourceItemSurfaceFacts): CallableArrowPosition =
    if surface.has_explicit_continuation_type { CallableExplicitContStorage }
    else if surface.has_send_callable_qualifier { CallableSendableStoragePosition }
    else { CallableStoragePosition }

/// Build erased callable variants required before backend-specific layout.
def callable_storage_variants_from_surface(surface: SourceItemSurfaceFacts): Array[CallableStorageVariant] =
    if surface.has_cont1_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantBoxedCont1)
            .freeze()
    } else if surface.has_contn_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantContN)
            .freeze()
    } else if surface.has_send_callable_qualifier {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .freeze()
    } else {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .push(CallableVariantBoxedCont1)
            .push(CallableVariantContN)
            .freeze()
    }

/// Create one callable storage fact from a typed item skeleton when needed.
def callable_storage_fact_from_skeleton(item: TypedItemSkeleton): Option[CallableStorageFact] =
    if item.surface.has_callable_arrow || item.surface.has_explicit_continuation_type {
        Some(CallableStorageFact {
            owner: item.binder,
            position: callable_storage_position_from_surface(item.surface),
            variants: callable_storage_variants_from_surface(item.surface),
            sendable: item.surface.has_send_callable_qualifier,
        })
    } else { None }

/// Generate callable storage facts from source item skeletons.
def callable_storage_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[CallableStorageFact]): Array[CallableStorageFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match callable_storage_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => callable_storage_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => callable_storage_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create a namespace ownership fact for an item owned by a source namespace.
def namespace_ownership_fact_from_skeleton(item: TypedItemSkeleton): Option[NamespaceOwnershipFact] =
    match item.owner_namespace {
        Some(namespace) =>
            Some(NamespaceOwnershipFact {
                owner: item.binder,
                file: item.file,
                owner_namespace: namespace,
            })
        None => None
    }

/// Generate item-to-namespace ownership facts in stable binder order.
def namespace_ownership_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[NamespaceOwnershipFact]): Array[NamespaceOwnershipFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match namespace_ownership_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create a method/operator surface fact from a method-like item skeleton.
def method_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[MethodSurfaceFact] =
    match item.surface.method_receiver {
        Some(receiver) =>
            match item.surface.method_member {
                Some(member) =>
                    Some(MethodSurfaceFact {
                        owner: item.binder,
                        file: item.file,
                        receiver: receiver,
                        member: member,
                        operator: item.surface.has_operator_method,
                    })
                None => None
            }
        None => None
    }

/// Generate method/operator surface facts in stable binder order.
def method_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[MethodSurfaceFact]): Array[MethodSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match method_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => method_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => method_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has branching syntax relevant to typed/CPS lowering.
def typed_item_has_branching_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_if_expr { true }
    else if item.surface.has_else_expr { true }
    else if item.surface.has_else_if_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_match_expr { true }
    else { item.surface.has_short_circuit_expr }

/// Create one branching surface fact from a typed item skeleton.
def branching_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[BranchingSurfaceFact] =
    if typed_item_has_branching_surface(item) {
        Some(BranchingSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_if: item.surface.has_if_expr,
            has_else: item.surface.has_else_expr,
            has_else_if: item.surface.has_else_if_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_match: item.surface.has_match_expr,
            has_short_circuit: item.surface.has_short_circuit_expr,
        })
    } else { None }

/// Generate branching surface facts in stable binder order.
def branching_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[BranchingSurfaceFact]): Array[BranchingSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match branching_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => branching_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => branching_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has delimited-control syntax.
def typed_item_has_control_surface_fact(item: TypedItemSkeleton): bool =
    if item.surface.has_reset_expr { true }
    else if item.surface.has_shift_expr { true }
    else { item.surface.has_shiftn_expr }

/// Create one delimited-control surface fact from a typed item skeleton.
def control_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[ControlSurfaceFact] =
    if typed_item_has_control_surface_fact(item) {
        Some(ControlSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_reset: item.surface.has_reset_expr,
            has_shift: item.surface.has_shift_expr,
            has_shiftn: item.surface.has_shiftn_expr,
        })
    } else { None }

/// Generate delimited-control surface facts in stable binder order.
def control_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[ControlSurfaceFact]): Array[ControlSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match control_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => control_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => control_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when a static value needs module-load init handling.
def typed_item_has_global_init_surface(item: TypedItemSkeleton): bool =
    if item.skeleton_kind != TypedItemStaticValue { false }
    else if item.surface.has_global_value_initializer { true }
    else { item.surface.has_global_value_dependency }

/// Create one global-init surface fact from a static value skeleton.
def global_init_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[GlobalInitSurfaceFact] =
    if typed_item_has_global_init_surface(item) {
        Some(GlobalInitSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_initializer: item.surface.has_global_value_initializer,
            has_dependency: item.surface.has_global_value_dependency,
            world_local: item.attributes.world_local,
            has_ref_type: item.surface.has_ref_type,
        })
    } else { None }

/// Generate global-init surface facts in stable binder order.
def global_init_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[GlobalInitSurfaceFact]): Array[GlobalInitSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match global_init_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => global_init_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => global_init_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item body contains pipe syntax.
def typed_item_has_pipe_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_pipe_expr { true }
    else if item.surface.has_pipe_placeholder { true }
    else { item.surface.has_pipe_chain }

/// Create one pipe surface fact from an item skeleton.
def pipe_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[PipeSurfaceFact] =
    if typed_item_has_pipe_surface(item) {
        Some(PipeSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_pipe: item.surface.has_pipe_expr,
            has_placeholder: item.surface.has_pipe_placeholder,
            has_chain: item.surface.has_pipe_chain,
        })
    } else { None }

/// Generate pipe surface facts in stable binder order.
def pipe_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[PipeSurfaceFact]): Array[PipeSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match pipe_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => pipe_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => pipe_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item needs pattern lowering or exhaustiveness checking.
def typed_item_has_pattern_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_match_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_deep_pattern_surface { true }
    else if item.surface.has_pattern_params { true }
    else { item.surface.has_wildcard_let }

/// Create one pattern surface fact from an item skeleton.
def pattern_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[PatternSurfaceFact] =
    if typed_item_has_pattern_surface(item) {
        Some(PatternSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_match: item.surface.has_match_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_deep_pattern: item.surface.has_deep_pattern_surface,
            has_pattern_params: item.surface.has_pattern_params,
            has_wildcard_let: item.surface.has_wildcard_let,
        })
    } else { None }

/// Generate pattern surface facts in stable binder order.
def pattern_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[PatternSurfaceFact]): Array[PatternSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match pattern_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => pattern_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => pattern_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item mentions compiler-owned intrinsic or tuple bridge surface.
def typed_item_has_intrinsic_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_compiler_intrinsic_call { true }
    else { item.surface.has_tuple_type_surface }

/// Create one intrinsic surface fact from an item skeleton.
def intrinsic_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[IntrinsicSurfaceFact] =
    if typed_item_has_intrinsic_surface(item) {
        Some(IntrinsicSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_compiler_intrinsic_call: item.surface.has_compiler_intrinsic_call,
            has_tuple_type_surface: item.surface.has_tuple_type_surface,
        })
    } else { None }

/// Generate intrinsic surface facts in stable binder order.
def intrinsic_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[IntrinsicSurfaceFact]): Array[IntrinsicSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match intrinsic_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => intrinsic_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => intrinsic_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item needs generic/template checking.
def typed_item_has_generic_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_explicit_type_params { true }
    else if item.surface.has_auto_generic_params { true }
    else if item.surface.has_explicit_instantiation_call { true }
    else { item.surface.has_generic_self_method }

/// Create one generic surface fact from an item skeleton.
def generic_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[GenericSurfaceFact] =
    if typed_item_has_generic_surface(item) {
        Some(GenericSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_explicit_type_params: item.surface.has_explicit_type_params,
            has_auto_generic_params: item.surface.has_auto_generic_params,
            has_explicit_instantiation_call: item.surface.has_explicit_instantiation_call,
            has_generic_self_method: item.surface.has_generic_self_method,
        })
    } else { None }

/// Generate generic surface facts in stable binder order.
def generic_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[GenericSurfaceFact]): Array[GenericSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match generic_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => generic_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => generic_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when item surfaces mention method-style receiver definitions.
def typed_item_skeletons_have_method_receiver_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_method_receiver { true }
        else if surface.has_operator_method { true }
        else { typed_item_skeletons_have_method_receiver_surface(skeletons, index + 1) }
    }

/// Return true when method receiver scope must bind `Self` with owner generics.
def typed_item_skeletons_have_generic_self_method_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_generic_self_method { true }
        else { typed_item_skeletons_have_generic_self_method_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention pattern parameters.
def typed_item_skeletons_have_pattern_param_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_pattern_params { true }
        else { typed_item_skeletons_have_pattern_param_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention explicit generic parameters.
def typed_item_skeletons_have_explicit_type_params(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_explicit_type_params { true }
        else { typed_item_skeletons_have_explicit_type_params(skeletons, index + 1) }
    }

/// Return true when generic inference or instantiation syntax needs checking.
def typed_item_skeletons_have_generic_instantiation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_auto_generic_params { true }
        else if surface.has_explicit_instantiation_call { true }
        else { typed_item_skeletons_have_generic_instantiation_surface(skeletons, index + 1) }
    }

/// Return true when local bindings need scope graph and shadow analysis.
def typed_item_skeletons_have_scope_shadow_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_let_binding { true }
        else if surface.has_wildcard_let { true }
        else if surface.has_scope_shadow_candidate { true }
        else { typed_item_skeletons_have_scope_shadow_surface(skeletons, index + 1) }
    }

/// Return true when owner namespaces must be resolved into stable symbols.
def typed_item_skeletons_have_namespace_ownership_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        match skeletons.get(index).owner_namespace {
            Some(_) => true
            None => typed_item_skeletons_have_namespace_ownership_surface(skeletons, index + 1)
        }
    }

/// Return true when item surfaces mention compiler-owned intrinsic or tuple surface.
def typed_item_skeletons_have_compiler_intrinsic_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_intrinsic_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_compiler_intrinsic_surface(skeletons, index + 1) }
    }

/// Return true when static globals need init order or cycle analysis.
def typed_item_skeletons_have_global_init_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_global_init_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_global_init_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need pipe lowering before type inference.
def typed_item_skeletons_have_pipe_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_pipe_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_pipe_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need match/if-let pattern lowering before inference.
def typed_item_skeletons_have_deep_pattern_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let item = skeletons.get(index)
        if item.surface.has_match_expr { true }
        else if item.surface.has_if_let_expr { true }
        else if item.surface.has_deep_pattern_surface { true }
        else { typed_item_skeletons_have_deep_pattern_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need string interpolation/slice lowering.
def typed_item_skeletons_have_string_slice_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_string_interpolation { true }
        else if surface.has_string_slice_surface { true }
        else if surface.has_char_at_surface { true }
        else { typed_item_skeletons_have_string_slice_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need index operator dispatch lowering.
def typed_item_skeletons_have_index_operator_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_index_expr { true }
        else if surface.has_index_slice_expr { true }
        else { typed_item_skeletons_have_index_operator_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need operator obligation resolution.
def typed_item_skeletons_have_operator_obligation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_infix_operator_expr { true }
        else if surface.has_operator_obligation_surface { true }
        else { typed_item_skeletons_have_operator_obligation_surface(skeletons, index + 1) }
    }

/// Infer HM + row types for an alpha-renamed module.
def infer_types(module: AlphaModule, patterns: PatternFacts): Result[TypedModule, SemanticDiagnostics] =
    let skeletons = typed_item_skeletons_from_alpha(module.origins, 0, Vec[TypedItemSkeleton].new())
    let callable_storage = callable_storage_facts_from_skeletons(skeletons, 0, Vec[CallableStorageFact].new())
    let namespace_ownership = namespace_ownership_facts_from_skeletons(skeletons, 0, Vec[NamespaceOwnershipFact].new())
    let method_surface = method_surface_facts_from_skeletons(skeletons, 0, Vec[MethodSurfaceFact].new())
    let branching_surface = branching_surface_facts_from_skeletons(skeletons, 0, Vec[BranchingSurfaceFact].new())
    let control_surface = control_surface_facts_from_skeletons(skeletons, 0, Vec[ControlSurfaceFact].new())
    let global_init_surface = global_init_surface_facts_from_skeletons(skeletons, 0, Vec[GlobalInitSurfaceFact].new())
    let pipe_surface = pipe_surface_facts_from_skeletons(skeletons, 0, Vec[PipeSurfaceFact].new())
    let pattern_surface = pattern_surface_facts_from_skeletons(skeletons, 0, Vec[PatternSurfaceFact].new())
    let intrinsic_surface = intrinsic_surface_facts_from_skeletons(skeletons, 0, Vec[IntrinsicSurfaceFact].new())
    let generic_surface = generic_surface_facts_from_skeletons(skeletons, 0, Vec[GenericSurfaceFact].new())
    if skeletons.len() == 0 {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: typed item skeletons absent"))
            .freeze()))
    } else if type_inference_has_pattern_coverage(skeletons, patterns) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pattern coverage for typed item skeletons absent"))
            .freeze()))
    } else if typed_item_skeletons_have_compiler_intrinsic_surface(skeletons, 0) {
        if intrinsic_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: compiler intrinsic surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: compiler intrinsic surface lowering absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_global_init_surface(skeletons, 0) {
        if global_init_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: global initialization surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: global initialization dependency and cycle analysis absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_pipe_surface(skeletons, 0) {
        if pipe_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pipe surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: pipe placeholder and receiver-first desugaring absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_deep_pattern_surface(skeletons, 0) {
        if pattern_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pattern surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: deep pattern match and if-let lowering absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_string_slice_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: string interpolation and slice lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_index_operator_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: index operator dispatch lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_operator_obligation_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: operator obligation resolution absent"))
            .freeze()))
    } else if typed_item_skeletons_have_callable_storage_surface(skeletons, 0) {
        if callable_storage.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: callable storage fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: callable storage type expression and body integration absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_generic_self_method_surface(skeletons, 0) {
        if generic_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: generic surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: generic method Self receiver binding absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_method_receiver_surface(skeletons, 0) {
        if method_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: method/operator surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: method receiver Self binding absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_pattern_param_surface(skeletons, 0) {
        if pattern_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pattern surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: function pattern parameter desugaring absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_generic_instantiation_surface(skeletons, 0) {
        if generic_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: generic surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: auto-generic and explicit instantiation checking absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_scope_shadow_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: local scope graph and shadowing analysis absent"))
            .freeze()))
    } else if typed_item_skeletons_have_namespace_ownership_surface(skeletons, 0) {
        if namespace_ownership.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: namespace ownership fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: source item type expression and body inference absent"))
                .freeze()))
        }
    } else if typed_item_skeletons_have_explicit_type_params(skeletons, 0) {
        if generic_surface.len() == 0 {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: generic surface fact generation absent"))
                .freeze()))
        } else {
            Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
                .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: explicit generic parameter binding absent"))
                .freeze()))
        }
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: source item type expression and body inference absent"))
            .freeze()))
    }

/// Build the typed module fact surface shared by later semantic passes.
def typed_module_from_skeletons(module: AlphaModule, skeletons: Array[TypedItemSkeleton], callable_storage: Array[CallableStorageFact], namespace_ownership: Array[NamespaceOwnershipFact], method_surface: Array[MethodSurfaceFact], branching_surface: Array[BranchingSurfaceFact], control_surface: Array[ControlSurfaceFact], global_init_surface: Array[GlobalInitSurfaceFact], pipe_surface: Array[PipeSurfaceFact], pattern_surface: Array[PatternSurfaceFact], intrinsic_surface: Array[IntrinsicSurfaceFact], generic_surface: Array[GenericSurfaceFact]): TypedModule =
    TypedModule {
        alpha: module,
        items: skeletons,
        callable_storage: callable_storage,
        namespace_ownership: namespace_ownership,
        method_surface: method_surface,
        branching_surface: branching_surface,
        control_surface: control_surface,
        global_init_surface: global_init_surface,
        pipe_surface: pipe_surface,
        pattern_surface: pattern_surface,
        intrinsic_surface: intrinsic_surface,
        generic_surface: generic_surface,
    }

/// Run the level-2 semantic checks that require inferred types.
def check_l2_types(module: TypedModule): Result[TypedModule, SemanticDiagnostics] =
    Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
        .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: level-2 typed semantic checks absent"))
        .freeze()))
