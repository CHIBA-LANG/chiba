        }
    }

/// Convert one pipe surface fact into a lowering obligation.
def pipe_lowering_obligation_from_surface(fact: PipeSurfaceFact): PipeLoweringObligation =
    PipeLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_placeholder_expansion: fact.has_placeholder,
        requires_receiver_first_desugar: fact.has_pipe,
        repeated_placeholder_lhs_is_single_eval: true,
    }

/// Convert pipe surface facts in stable owner order.
def pipe_lowering_obligations_from_surface(facts: Array[PipeSurfaceFact], index: usize, out: Vec[PipeLoweringObligation]): Array[PipeLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { pipe_lowering_obligations_from_surface(facts, index + 1, out.push(pipe_lowering_obligation_from_surface(facts.get(index)))) }

/// Return true when an item needs pattern lowering or exhaustiveness checking.
def typed_item_has_pattern_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_match_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_deep_pattern_surface { true }
    else if item.surface.has_pattern_params { true }
    else { item.surface.has_wildcard_let }

/// Create one pattern surface fact from an item skeleton.
def pattern_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[PatternSurfaceFact] =
    if typed_item_has_pattern_surface(item) {
        Some(PatternSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_match: item.surface.has_match_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_deep_pattern: item.surface.has_deep_pattern_surface,
            has_pattern_params: item.surface.has_pattern_params,
            has_wildcard_let: item.surface.has_wildcard_let,
        })
    } else { None }

/// Generate pattern surface facts in stable binder order.
def pattern_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[PatternSurfaceFact]): Array[PatternSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match pattern_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => pattern_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => pattern_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Convert one pattern surface fact into lowering obligations.
def pattern_lowering_obligation_from_surface(fact: PatternSurfaceFact): PatternLoweringObligation =
    PatternLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_match_exhaustiveness: fact.has_match,
        requires_if_let_dual_env: fact.has_if_let,
        requires_deep_pattern_dft: fact.has_deep_pattern,
        requires_function_param_desugar: fact.has_pattern_params,
        wildcard_let_discards_value: fact.has_wildcard_let,
    }

/// Convert pattern surface facts in stable owner order.
def pattern_lowering_obligations_from_surface(facts: Array[PatternSurfaceFact], index: usize, out: Vec[PatternLoweringObligation]): Array[PatternLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { pattern_lowering_obligations_from_surface(facts, index + 1, out.push(pattern_lowering_obligation_from_surface(facts.get(index)))) }

/// Return true when an item mentions compiler-owned intrinsic or tuple bridge surface.
def typed_item_has_intrinsic_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_compiler_intrinsic_call { true }
    else { item.surface.has_tuple_type_surface }

/// Create one intrinsic surface fact from an item skeleton.
