/// HM + row inference driver.
namespace compiler.semantic.type_infer

use compiler.source.project.*
use compiler.source.scan.*
use compiler.ir.control.*
use compiler.semantic.alpha.*
use compiler.semantic.pattern.*
use compiler.semantic.types.*

/// Coarse typed item category before full item lowering.
data TypedItemSkeletonKind {
    TypedItemFunction,
    TypedItemStaticValue,
    TypedItemExternFunction,
    TypedItemNominalType,
    TypedItemData,
    TypedItemUnion,
    TypedItemInterface,
}

/// Source item skeleton ready for real type-expression and body inference.
type TypedItemSkeleton {
    binder: BinderId,
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    skeleton_kind: TypedItemSkeletonKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Minimal typed body shape accepted by the first codegen vertical slice.
data TypedI32ConstAtom {
    TypedI32ConstZero,
    TypedI32ConstFortyTwo,
}

/// Minimal branch condition accepted by the first branch codegen slice.
data TypedBranchCondition {
    TypedBranchConditionTrue,
    TypedBranchConditionFalse,
    TypedBranchConditionParam0,
}

/// Minimal typed body shape accepted by the first codegen vertical slice.
data TypedFunctionBodyKind {
    TypedFunctionReturnUnit,
    TypedFunctionReturnI32Zero,
    TypedFunctionReturnI32FortyTwo,
    TypedFunctionReturnParam0,
    TypedFunctionTailCall(str),
    TypedFunctionTailCallI32Const(str, TypedI32ConstAtom),
    TypedFunctionIfElseI32Const(TypedBranchCondition, TypedI32ConstAtom, TypedI32ConstAtom),
    TypedFunctionIfElseTailCallI32Const(TypedBranchCondition, str, TypedI32ConstAtom, str, TypedI32ConstAtom),
    TypedFunctionBranchJoinPending,
}

/// Function body fact that has passed the narrow C08 primary codegen subset.
type TypedFunctionBodyFact {
    owner: BinderId,
    file: SourceFileId,
    symbol: str,
    local_symbol: str,
    is_main: bool,
    returns_i32: bool,
    i32_param_count: usize,
    body: TypedFunctionBodyKind,
}

/// Scan a minimal no-argument tail-call target from a function body region.
def typed_function_tail_call_target_slice(text: String, offset: usize, end: usize): Option[SourceNameSlice] =
    if offset >= end { None }
    else if offset >= text.len() { None }
    else if source_is_ident_start(text.byte_at(offset)) {
        let name_end = source_scan_namespace_name_end(text, offset)
        let call_start = source_skip_spaces(text, name_end)
        if call_start + 1 < end && text.byte_at(call_start) == 40 && text.byte_at(call_start + 1) == 41 {
            Some(SourceNameSlice { offset: offset, len: name_end - offset })
        } else { typed_function_tail_call_target_slice(text, offset + 1, end) }
    } else { typed_function_tail_call_target_slice(text, offset + 1, end) }

/// Convert a source name slice into the current minimal symbol spelling.
def typed_function_tail_call_target_text(text: String, slice: SourceNameSlice): str =
    text.slice(slice.offset, slice.len)

/// Return true when a source symbol is already namespace-qualified.
def typed_symbol_is_qualified(symbol: str, index: usize): bool =
    if index == symbol.len() { false }
    else if symbol.byte_at(index) == 46 { true }
    else { typed_symbol_is_qualified(symbol, index + 1) }

/// Convert a namespace slice into the current minimal symbol spelling.
def typed_namespace_symbol_text(text: String, namespace: NamespaceNameSlice): str =
    text.slice(namespace.offset, namespace.len)

/// Qualify a local symbol with an owner namespace.
def typed_qualified_symbol_text(text: String, namespace: NamespaceNameSlice, local: str): str =
    typed_namespace_symbol_text(text, namespace).concat(".").concat(local)

/// Build the canonical minimal function symbol for a skeleton.
def typed_function_symbol_from_name(text: String, item: TypedItemSkeleton, name: SourceNameSlice): str =
    let local = typed_function_tail_call_target_text(text, name)
    match item.owner_namespace {
        Some(namespace) => typed_qualified_symbol_text(text, namespace, local)
        None => local
    }

/// Resolve a raw tail-call target in the lexical owner namespace.
def typed_resolve_tail_call_target(text: String, item: TypedItemSkeleton, target: str): str =
    if typed_symbol_is_qualified(target, 0) { target }
    else {
        match item.owner_namespace {
            Some(namespace) => typed_qualified_symbol_text(text, namespace, target)
            None => target
        }
    }

/// Return true when a minimal body starts with one exact atom.
def typed_function_body_starts_with_atom(text: String, start: usize, end: usize, atom: str): bool =
    let offset = source_skip_spaces(text, start)
    if offset + atom.len() > end { false }
    else if source_starts_with_at(text, offset, atom, 0) == false { false }
    else { source_word_boundary_after(text, offset, atom.len()) }

/// Pick the minimal i32 const atom at the start of a source region.
def typed_i32_const_atom_from_region(text: String, start: usize, end: usize): Option[TypedI32ConstAtom] =
    if typed_function_body_starts_with_atom(text, start, end, "42") { Some(TypedI32ConstFortyTwo) }
    else if typed_function_body_starts_with_atom(text, start, end, "0") { Some(TypedI32ConstZero) }
    else { None }

/// Return true when the rest of a bounded region is whitespace only.
def typed_source_region_only_spaces(text: String, offset: usize, end: usize): bool =
    source_skip_spaces(text, offset) >= end

/// Return true when a narrow const call argument length is exactly closed in tail position.
def typed_i32_const_call_arg_exact_len(text: String, arg_start: usize, end: usize, len: usize): bool =
    let close = source_skip_spaces(text, arg_start + len)
    if close >= end { false }
    else if text.byte_at(close) != 41 { false }
    else { typed_source_region_only_spaces(text, close + 1, end) }

/// Return true when a narrow const call argument is exactly closed in tail position.
def typed_i32_const_call_arg_exact(text: String, arg_start: usize, end: usize, atom: TypedI32ConstAtom): bool =
    match atom {
        TypedI32ConstZero => typed_i32_const_call_arg_exact_len(text, arg_start, end, 1)
        TypedI32ConstFortyTwo => typed_i32_const_call_arg_exact_len(text, arg_start, end, 2)
    }

/// Find one byte in a bounded source region.
def typed_source_region_find_byte_or_end(text: String, offset: usize, end: usize, byte: u8): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if text.byte_at(offset) == byte { offset }
    else { typed_source_region_find_byte_or_end(text, offset + 1, end, byte) }

/// Find an ASCII token in a bounded source region.
def typed_source_region_find_text_or_end(text: String, offset: usize, end: usize, needle: str): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if source_starts_with_at(text, offset, needle, 0) { offset }
    else { typed_source_region_find_text_or_end(text, offset + 1, end, needle) }

/// Return the first parameter name in a function header.
def typed_function_first_param_name(text: String, item: TypedItemSkeleton): Option[SourceNameSlice] =
    let header_start = item.surface.header.offset
    let header_end = item.surface.header.offset + item.surface.header.len
    let open = typed_source_region_find_byte_or_end(text, header_start, header_end, 40)
    if open >= header_end { None }
    else { source_scan_ident_slice(text, open + 1) }

/// Return true when a function header has a first i32 parameter.
def typed_function_has_i32_param0(text: String, item: TypedItemSkeleton): bool =
    let header_end = item.surface.header.offset + item.surface.header.len
    match typed_function_first_param_name(text, item) {
        Some(param) => source_region_has_text(text, source_name_slice_end(param), header_end, "i32")
        None => false
    }

/// Count the narrow i32 params understood by the first executable function slice.
def typed_function_i32_param_count(text: String, item: TypedItemSkeleton): usize =
    if typed_function_has_i32_param0(text, item) { 1 }
    else if typed_function_has_bool_param0(text, item) { 1 }
    else { 0 }

/// Return true when a function header has a first bool parameter.
def typed_function_has_bool_param0(text: String, item: TypedItemSkeleton): bool =
    let header_end = item.surface.header.offset + item.surface.header.len
    match typed_function_first_param_name(text, item) {
        Some(param) => source_region_has_text(text, source_name_slice_end(param), header_end, "bool")
        None => false
    }

/// Return true when a body returns the first parameter directly.
def typed_function_body_returns_param0(text: String, item: TypedItemSkeleton, start: usize, end: usize): bool =
    match typed_function_first_param_name(text, item) {
        Some(param) => {
            let offset = source_skip_spaces(text, start)
            if source_starts_with_at(text, offset, typed_function_tail_call_target_text(text, param), 0) == false { false }
            else { source_word_boundary_after(text, offset, param.len) }
        }
        None => false
    }

/// Scan a minimal one-i32-const-argument tail-call target from a function body.
def typed_function_tail_call_i32_const_slice(text: String, offset: usize, end: usize): Option[SourceNameSlice] =
    if offset >= end { None }
    else if offset >= text.len() { None }
    else if source_is_ident_start(text.byte_at(offset)) {
        let name_end = source_scan_namespace_name_end(text, offset)
        let call_start = source_skip_spaces(text, name_end)
        if call_start < end && text.byte_at(call_start) == 40 {
            let arg_start = source_skip_spaces(text, call_start + 1)
            match typed_i32_const_atom_from_region(text, arg_start, end) {
                Some(arg) =>
                    if typed_i32_const_call_arg_exact(text, arg_start, end, arg) {
                        Some(SourceNameSlice { offset: offset, len: name_end - offset })
                    } else { typed_function_tail_call_i32_const_slice(text, offset + 1, end) }
                None => typed_function_tail_call_i32_const_slice(text, offset + 1, end)
            }
        } else { typed_function_tail_call_i32_const_slice(text, offset + 1, end) }
    } else { typed_function_tail_call_i32_const_slice(text, offset + 1, end) }

/// Pick the i32 const argument of a minimal tail call.
def typed_function_tail_call_i32_const_arg(text: String, target: SourceNameSlice, end: usize): Option[TypedI32ConstAtom] =
    let call_start = source_skip_spaces(text, source_name_slice_end(target))
    if call_start >= end { None }
    else {
        let arg_start = source_skip_spaces(text, call_start + 1)
        match typed_i32_const_atom_from_region(text, arg_start, end) {
            Some(arg) =>
                if typed_i32_const_call_arg_exact(text, arg_start, end, arg) { Some(arg) }
                else { None }
            None => None
        }
    }

/// Parse a minimal one-i32-const-argument tail call from a bounded arm.
def typed_function_tail_call_i32_const_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedFunctionBodyKind] =
    match typed_function_tail_call_i32_const_slice(text, start, end) {
        Some(target) =>
            match typed_function_tail_call_i32_const_arg(text, target, end) {
                Some(arg) => Some(TypedFunctionTailCallI32Const(typed_resolve_tail_call_target(text, item, typed_function_tail_call_target_text(text, target)), arg))
                None => None
            }
        None => None
    }

/// Parse the literal condition of the first executable branch slice.
def typed_branch_condition_from_region(text: String, start: usize, end: usize): Option[TypedBranchCondition] =
    let offset = source_skip_spaces(text, start)
    if source_starts_with_at(text, offset, "if true", 0) { Some(TypedBranchConditionTrue) }
    else if source_starts_with_at(text, offset, "if false", 0) { Some(TypedBranchConditionFalse) }
    else { None }

/// Parse a literal or first-parameter branch condition.
def typed_branch_condition_from_item_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedBranchCondition] =
    match typed_branch_condition_from_region(text, start, end) {
        Some(condition) => Some(condition)
        None =>
            match typed_function_first_param_name(text, item) {
                Some(param) => {
                    let offset = source_skip_spaces(text, start)
                    let if_start = source_skip_spaces(text, offset + "if".len())
                    if source_starts_with_at(text, if_start, typed_function_tail_call_target_text(text, param), 0) {
                        if source_word_boundary_after(text, if_start, param.len) { Some(TypedBranchConditionParam0) }
                        else { None }
                    } else { None }
                }
                None => None
            }
    }

/// Parse a narrow `if true/false { const } else { const }` body.
def typed_function_if_else_const_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedFunctionBodyKind] =
    match typed_branch_condition_from_item_region(text, item, start, end) {
        Some(condition) => {
            let then_open = typed_source_region_find_byte_or_end(text, start, end, 123)
            let then_close = typed_source_region_find_byte_or_end(text, then_open, end, 125)
            let else_offset = typed_source_region_find_text_or_end(text, then_close, end, "else")
            let else_open = typed_source_region_find_byte_or_end(text, else_offset, end, 123)
            let else_close = typed_source_region_find_byte_or_end(text, else_open, end, 125)
            if then_open >= end || then_close >= end || else_offset >= end || else_open >= end || else_close > end {
                None
            } else {
                match typed_i32_const_atom_from_region(text, then_open + 1, then_close) {
                    Some(then_atom) =>
                        match typed_i32_const_atom_from_region(text, else_open + 1, else_close) {
                            Some(else_atom) => Some(TypedFunctionIfElseI32Const(condition, then_atom, else_atom))
                            None => None
                        }
                    None => None
                }
            }
        }
        None => None
    }

/// Parse a narrow `if true/false { f(const) } else { g(const) }` body.
def typed_function_if_else_tail_call_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedFunctionBodyKind] =
    match typed_branch_condition_from_item_region(text, item, start, end) {
        Some(condition) => {
            let then_open = typed_source_region_find_byte_or_end(text, start, end, 123)
            let then_close = typed_source_region_find_byte_or_end(text, then_open, end, 125)
            let else_offset = typed_source_region_find_text_or_end(text, then_close, end, "else")
            let else_open = typed_source_region_find_byte_or_end(text, else_offset, end, 123)
            let else_close = typed_source_region_find_byte_or_end(text, else_open, end, 125)
            if then_open >= end || then_close >= end || else_offset >= end || else_open >= end || else_close > end {
                None
            } else {
                match typed_function_tail_call_i32_const_body(text, item, then_open + 1, then_close) {
                    Some(TypedFunctionTailCallI32Const(then_target, then_arg)) =>
                        match typed_function_tail_call_i32_const_body(text, item, else_open + 1, else_close) {
                            Some(TypedFunctionTailCallI32Const(else_target, else_arg)) =>
                                Some(TypedFunctionIfElseTailCallI32Const(condition, then_target, then_arg, else_target, else_arg))
                            _ => None
                        }
                    _ => None
                }
            }
        }
        None => None
    }

/// Compare two minimal source symbols byte-for-byte.
def typed_function_symbol_eq(left: str, right: str, index: usize): bool =
    if index == left.len() && index == right.len() { true }
    else if index == left.len() { false }
    else if index == right.len() { false }
    else if left.byte_at(index) == right.byte_at(index) { typed_function_symbol_eq(left, right, index + 1) }
    else { false }

/// Return the callee target carried by a minimal typed body.
def typed_function_tail_call_target(body: TypedFunctionBodyKind): Option[str] =
    match body {
        TypedFunctionTailCall(target) => Some(target)
        TypedFunctionTailCallI32Const(target, _) => Some(target)
        _ => None
    }

/// Return true when the current typed function set defines one symbol.
def typed_functions_have_symbol(functions: Array[TypedFunctionBodyFact], target: str, index: usize): bool =
    if index == functions.len() { false }
    else if typed_function_symbol_eq(functions.get(index).symbol, target, 0) { true }
    else { typed_functions_have_symbol(functions, target, index + 1) }

/// Return true when the same typed function symbol appears later.
def typed_functions_have_later_symbol(functions: Array[TypedFunctionBodyFact], target: str, index: usize): bool =
    if index == functions.len() { false }
    else if typed_function_symbol_eq(functions.get(index).symbol, target, 0) { true }
    else { typed_functions_have_later_symbol(functions, target, index + 1) }

/// Return true when typed function symbols are unique.
def typed_function_symbols_unique(functions: Array[TypedFunctionBodyFact], index: usize): bool =
    if index == functions.len() { true }
    else if typed_functions_have_later_symbol(functions, functions.get(index).symbol, index + 1) { false }
    else { typed_function_symbols_unique(functions, index + 1) }

/// Return true when exported main follows the current no-param ABI slice.
def typed_function_main_abi_valid(functions: Array[TypedFunctionBodyFact], index: usize): bool =
    if index == functions.len() { true }
    else {
        let function = functions.get(index)
        if function.is_main {
            if function.i32_param_count == 0 { typed_function_main_abi_valid(functions, index + 1) }
            else { false }
        } else { typed_function_main_abi_valid(functions, index + 1) }
    }

/// Return true when every minimal tail-call target resolves within this typed module.
def typed_function_tail_targets_resolved_for_body(functions: Array[TypedFunctionBodyFact], body: TypedFunctionBodyKind): bool =
    match body {
        TypedFunctionTailCall(target) => typed_functions_have_symbol(functions, target, 0)
        TypedFunctionTailCallI32Const(target, _) => typed_functions_have_symbol(functions, target, 0)
        TypedFunctionIfElseTailCallI32Const(_, then_target, _, else_target, _) =>
            if typed_functions_have_symbol(functions, then_target, 0) {
                typed_functions_have_symbol(functions, else_target, 0)
            } else { false }
        _ => true
    }

/// Return true when every function body has resolved minimal tail-call targets.
def typed_function_tail_targets_resolved(functions: Array[TypedFunctionBodyFact], index: usize): bool =
    if index == functions.len() { true }
    else if typed_function_tail_targets_resolved_for_body(functions, functions.get(index).body) {
        typed_function_tail_targets_resolved(functions, index + 1)
    } else { false }

/// Stable item-to-namespace ownership fact after alpha conversion.
type NamespaceOwnershipFact {
    owner: BinderId,
    file: SourceFileId,
    owner_namespace: NamespaceNameSlice,
}

/// Source import fact before full namespace/name resolution.
type NamespaceImportFact {
    file: SourceFileId,
    path: SourceNameSlice,
    glob: bool,
    multi: bool,
    line: usize,
    column: usize,
}

/// Method/operator declaration surface fact after alpha conversion.
type MethodSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    receiver: SourceNameSlice,
    member: SourceNameSlice,
    operator: bool,
}

/// Branching surface fact used by typed lowering and CPS join planning.
type BranchingSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_if: bool,
    has_else: bool,
    has_else_if: bool,
    has_if_let: bool,
    has_match: bool,
    has_short_circuit: bool,
}

/// Delimited-control surface fact before answer/control checking.
type ControlSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_reset: bool,
    has_shift: bool,
    has_shiftn: bool,
}

/// Static value surface fact before module-load init dependency analysis.
type GlobalInitSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_initializer: bool,
    has_dependency: bool,
    world_local: bool,
    has_ref_type: bool,
}

/// Global initialization obligation before dependency sorting and cycle checks.
type GlobalInitObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_module_load_init: bool,
    requires_dependency_edge: bool,
    requires_world_local_ref: bool,
}

/// Pipe surface fact before placeholder and receiver-first desugaring.
type PipeSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_pipe: bool,
    has_placeholder: bool,
    has_chain: bool,
}

/// Pipe lowering obligation before placeholder expansion and method/operator desugar.
type PipeLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_placeholder_expansion: bool,
    requires_receiver_first_desugar: bool,
    repeated_placeholder_lhs_is_single_eval: bool,
}

/// Pattern surface fact before DFT lowering and exhaustiveness checks.
type PatternSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_match: bool,
    has_if_let: bool,
    has_deep_pattern: bool,
    has_pattern_params: bool,
    has_wildcard_let: bool,
}

/// Pattern lowering obligation before DFT lowering and exhaustiveness checks.
type PatternLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_match_exhaustiveness: bool,
    requires_if_let_dual_env: bool,
    requires_deep_pattern_dft: bool,
    requires_function_param_desugar: bool,
    wildcard_let_discards_value: bool,
}

/// Compiler intrinsic and tuple bridge surface before checked lowering.
type IntrinsicSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_compiler_intrinsic_call: bool,
    has_tuple_type_surface: bool,
}

/// Compiler intrinsic lowering obligation before namespace resolution.
type IntrinsicLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    intrinsic_namespace: String,
    requires_tuple_bridge: bool,
    requires_compiler_intrinsic_resolution: bool,
}

/// Generic/template surface before definition-time and instantiation checks.
type GenericSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_explicit_type_params: bool,
    has_auto_generic_params: bool,
    has_explicit_instantiation_call: bool,
    has_generic_self_method: bool,
}

/// Generic/template obligation before body checking and instantiation discharge.
type GenericTemplateObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_explicit_param_binding: bool,
    requires_auto_generic_inference: bool,
    requires_instantiation_discharge: bool,
    requires_generic_self_receiver_binding: bool,
}

/// Operator use surface before overload candidate resolution.
type OperatorUseSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_infix_operator: bool,
    has_operator_obligation: bool,
    has_index: bool,
    has_index_slice: bool,
}

/// Closure/lambda surface before capture and env analysis.
type ClosureSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_lambda: bool,
    has_trailing_closure: bool,
    syntactic_no_capture: bool,
}

/// Classify a scanned source item into the first typed-lowering bucket.
def classify_typed_item_skeleton_kind(item: AlphaBinderOrigin): TypedItemSkeletonKind =
    match item.kind {
        SourceItemDef => {
            if item.surface.has_params { TypedItemFunction }
            else { TypedItemStaticValue }
        }
        SourceItemExtern => TypedItemExternFunction
        SourceItemType => TypedItemNominalType
        SourceItemData => TypedItemData
        SourceItemUnion => TypedItemUnion
        SourceItemInterface => TypedItemInterface
    }

/// Build source item skeletons from alpha origins before HM + row inference.
def typed_item_skeletons_from_alpha(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[TypedItemSkeleton]): Array[TypedItemSkeleton] =
    if index == origins.len() { out.freeze() }
    else {
        let origin = origins.get(index)
        typed_item_skeletons_from_alpha(
            origins,
            index + 1,
            out.push(TypedItemSkeleton {
                binder: origin.binder,
                file: origin.file,
                owner_namespace: origin.owner_namespace,
                kind: origin.kind,
                skeleton_kind: classify_typed_item_skeleton_kind(origin),
                name: origin.name,
                private: origin.private,
                attributes: origin.attributes,
                surface: origin.surface,
                line: origin.line,
                column: origin.column,
            }))
    }

/// Return true when placeholder pattern facts cover all source item skeletons.
def type_inference_has_pattern_coverage(skeletons: Array[TypedItemSkeleton], patterns: PatternFacts): bool =
    patterns.patterns.len() >= skeletons.len()

/// Return the text of one source file by stable id.
def typed_source_file_text(files: Array[SourceFile], file: SourceFileId, index: usize): String =
    if index == files.len() { "" }
    else if files.get(index).id.index == file.index { files.get(index).text }
    else { typed_source_file_text(files, file, index + 1) }

/// Return true when a source name slice equals a fixed ASCII identifier.
def source_name_slice_eq_text(text: String, name: SourceNameSlice, expected: str): bool =
    if name.len != expected.len() { false }
    else { source_starts_with_at(text, name.offset, expected, 0) }

/// Return true when a scanned item header mentions an i32 return annotation.
def typed_item_surface_returns_i32(text: String, item: TypedItemSkeleton): bool =
    source_region_has_text(text, item.surface.header.offset, item.surface.header.offset + item.surface.header.len, "i32")

/// Pick the minimal typed body form from the source body region.
def typed_function_body_kind_from_surface(text: String, item: TypedItemSkeleton): TypedFunctionBodyKind =
    let start = source_scan_item_body_region_start(text, item.surface.header.offset)
    let end = source_scan_item_region_end(text, item.surface.header.offset)
    if typed_item_has_branching_surface(item) {
        match typed_function_if_else_const_body(text, item, start, end) {
            Some(body) => body
            None =>
                match typed_function_if_else_tail_call_body(text, item, start, end) {
                    Some(body) => body
                    None => TypedFunctionBranchJoinPending
                }
        }
    }
    else if typed_function_body_returns_param0(text, item, start, end) { TypedFunctionReturnParam0 }
    else if typed_function_body_starts_with_atom(text, start, end, "42") { TypedFunctionReturnI32FortyTwo }
    else if typed_function_body_starts_with_atom(text, start, end, "0") { TypedFunctionReturnI32Zero }
    else {
        match typed_function_tail_call_i32_const_slice(text, start, end) {
            Some(target) =>
                match typed_function_tail_call_i32_const_arg(text, target, end) {
                    Some(arg) => TypedFunctionTailCallI32Const(typed_resolve_tail_call_target(text, item, typed_function_tail_call_target_text(text, target)), arg)
                    None => TypedFunctionReturnUnit
                }
            None =>
                match typed_function_tail_call_target_slice(text, start, end) {
                    Some(target) => TypedFunctionTailCall(typed_resolve_tail_call_target(text, item, typed_function_tail_call_target_text(text, target)))
                    None => TypedFunctionReturnUnit
                }
        }
    }

/// Convert one simple function skeleton into a typed function body fact.
def typed_function_body_fact_from_skeleton(project: ProjectSurface, item: TypedItemSkeleton): Option[TypedFunctionBodyFact] =
    match item.skeleton_kind {
        TypedItemFunction => {
            let text = typed_source_file_text(project.files, item.file, 0)
            let returns_i32 = typed_item_surface_returns_i32(text, item)
            match item.name {
                Some(name) =>
                    Some(TypedFunctionBodyFact {
                        owner: item.binder,
                        file: item.file,
                        symbol: typed_function_symbol_from_name(text, item, name),
                        local_symbol: typed_function_tail_call_target_text(text, name),
                        is_main: source_name_slice_eq_text(text, name, "main"),
                        returns_i32: returns_i32,
                        i32_param_count: typed_function_i32_param_count(text, item),
                        body: typed_function_body_kind_from_surface(text, item),
                    })
                None => None
            }
        }
        _ => None
    }

/// Build typed function body facts for the narrow codegen subset.
def typed_function_body_facts_from_skeletons(project: ProjectSurface, skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[TypedFunctionBodyFact]): Array[TypedFunctionBodyFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match typed_function_body_fact_from_skeleton(project, skeletons.get(index)) {
            Some(fact) => typed_function_body_facts_from_skeletons(project, skeletons, index + 1, out.push(fact))
            None => typed_function_body_facts_from_skeletons(project, skeletons, index + 1, out)
        }
    }

/// Return true when item surfaces mention callable or explicit continuation storage types.
def typed_item_skeletons_have_callable_storage_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_callable_arrow { true }
        else if surface.has_explicit_continuation_type { true }
        else if surface.has_lambda_expr { true }
        else if surface.has_trailing_closure_expr { true }
        else { typed_item_skeletons_have_callable_storage_surface(skeletons, index + 1) }
    }

/// Pick callable position from coarse source surface facts.
def callable_storage_position_from_surface(surface: SourceItemSurfaceFacts): CallableArrowPosition =
    if surface.has_explicit_continuation_type { CallableExplicitContStorage }
    else if surface.has_send_callable_qualifier { CallableSendableStoragePosition }
    else { CallableStoragePosition }

/// Build erased callable variants required before backend-specific layout.
def callable_storage_variants_from_surface(surface: SourceItemSurfaceFacts): Array[CallableStorageVariant] =
    if surface.has_cont1_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantBoxedCont1)
            .freeze()
    } else if surface.has_contn_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantContN)
            .freeze()
    } else if surface.has_send_callable_qualifier {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .freeze()
    } else {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .push(CallableVariantBoxedCont1)
            .push(CallableVariantContN)
            .freeze()
    }

/// Create one callable storage fact from a typed item skeleton when needed.
def callable_storage_fact_from_skeleton(item: TypedItemSkeleton): Option[CallableStorageFact] =
    if item.surface.has_callable_arrow || item.surface.has_explicit_continuation_type {
        Some(CallableStorageFact {
            owner: item.binder,
            position: callable_storage_position_from_surface(item.surface),
            variants: callable_storage_variants_from_surface(item.surface),
            sendable: item.surface.has_send_callable_qualifier,
        })
    } else { None }

/// Generate callable storage facts from source item skeletons.
def callable_storage_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[CallableStorageFact]): Array[CallableStorageFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match callable_storage_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => callable_storage_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => callable_storage_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create a namespace ownership fact for an item owned by a source namespace.
def namespace_ownership_fact_from_skeleton(item: TypedItemSkeleton): Option[NamespaceOwnershipFact] =
    match item.owner_namespace {
        Some(namespace) =>
            Some(NamespaceOwnershipFact {
                owner: item.binder,
                file: item.file,
                owner_namespace: namespace,
            })
        None => None
    }

/// Generate item-to-namespace ownership facts in stable binder order.
def namespace_ownership_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[NamespaceOwnershipFact]): Array[NamespaceOwnershipFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match namespace_ownership_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create one namespace import fact from a source `use`.
def namespace_import_fact_from_use(import_use: SourceUseScanResult): NamespaceImportFact =
    NamespaceImportFact {
        file: import_use.file,
        path: import_use.path,
        glob: import_use.glob,
        multi: import_use.multi,
        line: import_use.line,
        column: import_use.column,
    }

/// Generate namespace import facts in deterministic source order.
def namespace_import_facts_from_uses(uses: Array[SourceUseScanResult], index: usize, out: Vec[NamespaceImportFact]): Array[NamespaceImportFact] =
    if index == uses.len() { out.freeze() }
    else { namespace_import_facts_from_uses(uses, index + 1, out.push(namespace_import_fact_from_use(uses.get(index)))) }

/// Create a method/operator surface fact from a method-like item skeleton.
def method_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[MethodSurfaceFact] =
    match item.surface.method_receiver {
        Some(receiver) =>
            match item.surface.method_member {
                Some(member) =>
                    Some(MethodSurfaceFact {
                        owner: item.binder,
                        file: item.file,
                        receiver: receiver,
                        member: member,
                        operator: item.surface.has_operator_method,
                    })
                None => None
            }
        None => None
    }

/// Generate method/operator surface facts in stable binder order.
def method_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[MethodSurfaceFact]): Array[MethodSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match method_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => method_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => method_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has branching syntax relevant to typed/CPS lowering.
def typed_item_has_branching_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_if_expr { true }
    else if item.surface.has_else_expr { true }
    else if item.surface.has_else_if_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_match_expr { true }
    else { item.surface.has_short_circuit_expr }

/// Create one branching surface fact from a typed item skeleton.
def branching_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[BranchingSurfaceFact] =
    if typed_item_has_branching_surface(item) {
        Some(BranchingSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_if: item.surface.has_if_expr,
            has_else: item.surface.has_else_expr,
            has_else_if: item.surface.has_else_if_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_match: item.surface.has_match_expr,
            has_short_circuit: item.surface.has_short_circuit_expr,
        })
    } else { None }

/// Generate branching surface facts in stable binder order.
def branching_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[BranchingSurfaceFact]): Array[BranchingSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match branching_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => branching_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => branching_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has delimited-control syntax.
def typed_item_has_control_surface_fact(item: TypedItemSkeleton): bool =
    if item.surface.has_reset_expr { true }
    else if item.surface.has_shift_expr { true }
    else { item.surface.has_shiftn_expr }

/// Create one delimited-control surface fact from a typed item skeleton.
def control_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[ControlSurfaceFact] =
    if typed_item_has_control_surface_fact(item) {
