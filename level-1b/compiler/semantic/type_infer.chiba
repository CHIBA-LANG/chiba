        }
    }

/// Convert one global init surface fact into an init graph obligation.
def global_init_obligation_from_surface(fact: GlobalInitSurfaceFact): GlobalInitObligation =
    GlobalInitObligation {
        owner: fact.owner,
        file: fact.file,
        requires_module_load_init: fact.has_initializer,
        requires_dependency_edge: fact.has_dependency,
        requires_world_local_ref: fact.has_ref_type && fact.world_local,
    }

/// Convert global init facts in stable owner order.
def global_init_obligations_from_surface(facts: Array[GlobalInitSurfaceFact], index: usize, out: Vec[GlobalInitObligation]): Array[GlobalInitObligation] =
    if index == facts.len() { out.freeze() }
    else { global_init_obligations_from_surface(facts, index + 1, out.push(global_init_obligation_from_surface(facts.get(index)))) }

/// Return true when an item body contains pipe syntax.
def typed_item_has_pipe_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_pipe_expr { true }
    else if item.surface.has_pipe_placeholder { true }
    else { item.surface.has_pipe_chain }

