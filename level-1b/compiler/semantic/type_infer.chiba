    Vec[String].new()
        .push("missing-facts: method/operator surface fact generation absent")
        .push("missing-lowering: method receiver Self binding absent")
        .push("missing-facts: generic surface fact generation absent")
        .push("missing-lowering: generic method Self receiver binding absent")
        .push("missing-facts: pattern surface fact generation absent")
        .push("missing-lowering: function pattern parameter desugaring absent")
        .push("missing-lowering: explicit generic parameter binding absent")
        .push("missing-lowering: auto-generic and explicit instantiation checking absent")
        .push("missing-lowering: local scope graph and shadowing analysis absent")
        .push("missing-facts: namespace ownership fact generation absent")
        .push("missing-facts: namespace import fact generation absent")
        .push("missing-lowering: import and name resolution absent")
        .push("missing-facts: compiler intrinsic surface fact generation absent")
        .push("missing-lowering: compiler intrinsic surface lowering absent")
        .push("missing-facts: global initialization surface fact generation absent")
        .push("missing-lowering: global initialization dependency and cycle analysis absent")
        .push("missing-facts: pipe surface fact generation absent")
        .push("missing-lowering: pipe placeholder and receiver-first desugaring absent")
        .push("missing-lowering: deep pattern match and if-let lowering absent")
        .push("missing-lowering: string interpolation and slice lowering absent")
        .push("missing-facts: operator use surface fact generation absent")
        .push("missing-lowering: index operator dispatch lowering absent")
        .push("missing-lowering: operator obligation resolution absent")
        .push("missing-facts: callable storage fact generation absent")
        .push("missing-lowering: callable storage type expression and body integration absent")
        .push("missing-lowering: checked-template body analysis absent")
        .push("invalid-surface: operator overload candidate missing")
