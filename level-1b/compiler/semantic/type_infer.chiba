    else { generic_template_obligations_from_surface(facts, index + 1, out.push(generic_template_obligation_from_surface(facts.get(index)))) }

/// Return true when an item uses operator overload surface.
def typed_item_has_operator_use_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_infix_operator_expr { true }
