/// HM + row inference driver.
namespace compiler.semantic.type_infer

use compiler.source.project.*
use compiler.source.scan.*
use compiler.ir.control.*
use compiler.semantic.alpha.*
use compiler.semantic.pattern.*
use compiler.semantic.types.*
use compiler.semantic.adt_tuple_lowering.*

/// Coarse typed item category before full item lowering.
data TypedItemSkeletonKind {
    TypedItemFunction,
    TypedItemStaticValue,
    TypedItemExternFunction,
    TypedItemNominalType,
    TypedItemData,
    TypedItemUnion,
    TypedItemInterface,
}

/// Source item skeleton ready for real type-expression and body inference.
type TypedItemSkeleton {
    binder: BinderId,
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    skeleton_kind: TypedItemSkeletonKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Typed expression shape used by semantic lowering before CPS.
data TypedI32ConstAtom {
    TypedI32ConstZero,
    TypedI32ConstFortyTwo,
    TypedI32ConstSmall(usize),
}

/// Typed branch condition carried by typed expression lowering.
data TypedBranchCondition {
    TypedBranchConditionTrue,
    TypedBranchConditionFalse,
    TypedBranchConditionParam(usize),
}

/// Typed expression shape used by semantic lowering before CPS.
data TypedExprKind {
    TypedExprUnit,
    TypedExprI32Const(TypedI32ConstAtom),
    TypedExprParam(usize),
    TypedExprTailCall(str),
    TypedExprTailCallArgs(str, Array[TypedExprKind]),
    TypedExprIfElse(TypedBranchCondition, TypedExprKind, TypedExprKind),
    TypedExprBranchJoinPending,
}

/// Stable traversal event for typed expression lowering.
data TypedExprVisitKind {
    TypedVisitUnit,
    TypedVisitAtom,
    TypedVisitTailCall,
    TypedVisitBranch,
    TypedVisitPending,
}

/// One typed expression traversal fact in depth-first order.
type TypedExprVisit {
    owner: BinderId,
    kind: TypedExprVisitKind,
    tail_position: bool,
}

/// Function body fact that has passed the narrow C08 primary codegen subset.
type TypedFunctionFact {
    owner: BinderId,
    file: SourceFileId,
    symbol: str,
    local_symbol: str,
    is_main: bool,
    returns_i32: bool,
    i32_param_count: usize,
    body: TypedExprKind,
}

/// Pick traversal kind for one typed expression node.
def typed_expr_visit_kind(expr: TypedExprKind): TypedExprVisitKind =
    match expr {
        TypedExprUnit => TypedVisitUnit
        TypedExprI32Const(_) => TypedVisitAtom
        TypedExprParam(_) => TypedVisitAtom
        TypedExprTailCall(_) => TypedVisitTailCall
        TypedExprTailCallArgs(_, _) => TypedVisitTailCall
        TypedExprIfElse(_, _, _) => TypedVisitBranch
        TypedExprBranchJoinPending => TypedVisitPending
    }

/// Traverse a typed expression recursively in primary lowering order.
def typed_expr_traverse(owner: BinderId, expr: TypedExprKind, tail_position: bool, out: Vec[TypedExprVisit]): Vec[TypedExprVisit] =
    {
        let with_self = out.push(TypedExprVisit(owner, typed_expr_visit_kind(expr), tail_position))
        match expr {
            TypedExprIfElse(_, then_expr, else_expr) =>
                typed_expr_traverse(owner, else_expr, tail_position, typed_expr_traverse(owner, then_expr, tail_position, with_self))
            TypedExprTailCallArgs(_, args) => typed_expr_traverse_args(owner, args, 0, false, with_self)
            _ => with_self
        }
    }

/// Traverse typed call arguments left-to-right.
def typed_expr_traverse_args(owner: BinderId, args: Array[TypedExprKind], index: usize, tail_position: bool, out: Vec[TypedExprVisit]): Vec[TypedExprVisit] =
    if index == args.len() { out }
    else { typed_expr_traverse_args(owner, args, index + 1, tail_position, typed_expr_traverse(owner, args.get(index), tail_position, out)) }

/// Traverse one typed function body.
def typed_function_expr_visits(function: TypedFunctionFact): Array[TypedExprVisit] =
    typed_expr_traverse(function.owner, function.body, true, Vec[TypedExprVisit].new()).freeze()

/// Append visits for one function into a builder.
def typed_function_expr_visits_append(function: TypedFunctionFact, index: usize, visits: Array[TypedExprVisit], out: Vec[TypedExprVisit]): Vec[TypedExprVisit] =
    if index == visits.len() { out }
    else { typed_function_expr_visits_append(function, index + 1, visits, out.push(visits.get(index))) }

/// Traverse all typed function bodies.
def typed_function_expr_visits_all(functions: Array[TypedFunctionFact], index: usize, out: Vec[TypedExprVisit]): Array[TypedExprVisit] =
    if index == functions.len() { out.freeze() }
    else {
        let visits = typed_function_expr_visits(functions.get(index))
        typed_function_expr_visits_all(functions, index + 1, typed_function_expr_visits_append(functions.get(index), 0, visits, out))
    }

/// Scan a function-slice no-argument tail-call target from a function body region.
def typed_no_arg_call_exact(text: String, call_start: usize, end: usize): bool =
    if call_start >= end { false }
    else if text.byte_at(call_start) != 40 { false }
    else {
        let close = source_skip_spaces(text, call_start + 1)
        if close >= end { false }
        else if text.byte_at(close) != 41 { false }
        else { typed_source_region_only_spaces(text, close + 1, end) }
    }

/// Scan a function-slice no-argument tail-call target from a function body region.
def typed_function_tail_call_target_slice(text: String, offset: usize, end: usize): Option[SourceNameSlice] =
    if offset >= end { None }
    else if offset >= text.len() { None }
    else if source_is_ident_start(text.byte_at(offset)) {
        let name_end = source_scan_namespace_name_end(text, offset)
        let call_start = source_skip_spaces(text, name_end)
        if typed_no_arg_call_exact(text, call_start, end) {
            Some(SourceNameSlice { offset: offset, len: name_end - offset })
        } else { typed_function_tail_call_target_slice(text, offset + 1, end) }
    } else { typed_function_tail_call_target_slice(text, offset + 1, end) }

/// Convert a source name slice into the current function-slice symbol spelling.
def typed_function_tail_call_target_text(text: String, slice: SourceNameSlice): str =
    text.slice(slice.offset, slice.len)

/// Return true when a source symbol is already namespace-qualified.
def typed_symbol_is_qualified(symbol: str, index: usize): bool =
    if index == symbol.len() { false }
    else if symbol.byte_at(index) == 46 { true }
    else { typed_symbol_is_qualified(symbol, index + 1) }

/// Convert a namespace slice into the current function-slice symbol spelling.
def typed_namespace_symbol_text(text: String, namespace: NamespaceNameSlice): str =
    text.slice(namespace.offset, namespace.len)

/// Qualify a local symbol with an owner namespace.
def typed_qualified_symbol_text(text: String, namespace: NamespaceNameSlice, local: str): str =
    typed_namespace_symbol_text(text, namespace).concat(".").concat(local)

/// Build the canonical function-slice function symbol for a skeleton.
def typed_function_symbol_from_name(text: String, item: TypedItemSkeleton, name: SourceNameSlice): str =
    let local = typed_function_tail_call_target_text(text, name)
    match item.owner_namespace {
        Some(namespace) => typed_qualified_symbol_text(text, namespace, local)
        None => local
    }

/// Resolve a raw tail-call target in the lexical owner namespace.
def typed_resolve_tail_call_target(text: String, item: TypedItemSkeleton, target: str): str =
    if typed_symbol_is_qualified(target, 0) { target }
    else {
        match item.owner_namespace {
            Some(namespace) => typed_qualified_symbol_text(text, namespace, target)
            None => target
        }
    }

/// Return true when a function-slice body starts with one exact atom.
def typed_function_body_starts_with_atom(text: String, start: usize, end: usize, atom: str): bool =
    let offset = source_skip_spaces(text, start)
    if offset + atom.len() > end { false }
    else if source_starts_with_at(text, offset, atom, 0) == false { false }
    else { source_word_boundary_after(text, offset, atom.len()) }

/// Pick the function-slice i32 const atom at the start of a source region.
def typed_i32_const_atom_from_region(text: String, start: usize, end: usize): Option[TypedI32ConstAtom] =
    if typed_function_body_starts_with_atom(text, start, end, "42") { Some(TypedI32ConstFortyTwo) }
    else if typed_function_body_starts_with_atom(text, start, end, "0") { Some(TypedI32ConstZero) }
    else { None }

/// Return true when a byte is an ASCII decimal digit.
def typed_is_ascii_digit(byte: u8): bool =
    byte >= 48 && byte <= 57

/// Parse a small unsigned integer literal from a source region.
def typed_parse_small_i32_digits(text: String, offset: usize, end: usize, value: usize): Option[TypedI32ConstAtom] =
    if offset >= end { Some(TypedI32ConstSmall(value)) }
    else if offset >= text.len() { Some(TypedI32ConstSmall(value)) }
    else if typed_is_ascii_digit(text.byte_at(offset)) {
        typed_parse_small_i32_digits(text, offset + 1, end, value * 10 + (text.byte_at(offset) - 48))
    } else if typed_source_region_only_spaces(text, offset, end) {
        Some(TypedI32ConstSmall(value))
    } else { None }

/// Parse an exact small i32 literal from a source region.
def typed_small_i32_const_exact_from_region(text: String, start: usize, end: usize): Option[TypedI32ConstAtom] =
    let offset = source_skip_spaces(text, start)
    if offset >= end { None }
    else if typed_is_ascii_digit(text.byte_at(offset)) == false { None }
    else { typed_parse_small_i32_digits(text, offset, end, 0) }

/// Return true when the rest of a bounded region is whitespace only.
def typed_source_region_only_spaces(text: String, offset: usize, end: usize): bool =
    source_skip_spaces(text, offset) >= end

/// Pick an exact i32 const atom when it is the full tail expression.
def typed_i32_const_atom_exact_len(text: String, start: usize, end: usize, atom: TypedI32ConstAtom, len: usize): Option[TypedI32ConstAtom] =
    let offset = source_skip_spaces(text, start)
    if typed_source_region_only_spaces(text, offset + len, end) { Some(atom) }
    else { None }

/// Pick the function-slice i32 const atom only when it occupies the full source region.
def typed_i32_const_atom_exact_from_region(text: String, start: usize, end: usize): Option[TypedI32ConstAtom] =
    match typed_i32_const_atom_from_region(text, start, end) {
        Some(TypedI32ConstZero) => typed_i32_const_atom_exact_len(text, start, end, TypedI32ConstZero, 1)
        Some(TypedI32ConstFortyTwo) => typed_i32_const_atom_exact_len(text, start, end, TypedI32ConstFortyTwo, 2)
        Some(TypedI32ConstSmall(value)) => Some(TypedI32ConstSmall(value))
        None => typed_small_i32_const_exact_from_region(text, start, end)
    }

/// Return true when a narrow const call argument length is exactly closed in tail position.
def typed_i32_const_call_arg_exact_len(text: String, arg_start: usize, end: usize, len: usize): bool =
    let close = source_skip_spaces(text, arg_start + len)
    if close >= end { false }
    else if text.byte_at(close) != 41 { false }
    else { typed_source_region_only_spaces(text, close + 1, end) }

/// Return true when a narrow const call argument is exactly closed in tail position.
def typed_i32_const_call_arg_exact(text: String, arg_start: usize, end: usize, atom: TypedI32ConstAtom): bool =
    match atom {
        TypedI32ConstZero => typed_i32_const_call_arg_exact_len(text, arg_start, end, 1)
        TypedI32ConstFortyTwo => typed_i32_const_call_arg_exact_len(text, arg_start, end, 2)
        TypedI32ConstSmall(_) => {
            let close = typed_source_region_find_byte_or_end(text, arg_start, end, 41)
            if close >= end { false }
            else { typed_source_region_only_spaces(text, close + 1, end) }
        }
    }

/// Find one byte in a bounded source region.
def typed_source_region_find_byte_or_end(text: String, offset: usize, end: usize, byte: u8): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if text.byte_at(offset) == byte { offset }
    else { typed_source_region_find_byte_or_end(text, offset + 1, end, byte) }

/// Find an ASCII token in a bounded source region.
def typed_source_region_find_text_or_end(text: String, offset: usize, end: usize, needle: str): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if source_starts_with_at(text, offset, needle, 0) { offset }
    else { typed_source_region_find_text_or_end(text, offset + 1, end, needle) }

/// Find the matching `}` for a `{` while preserving nested expression bodies.
def typed_source_region_matching_brace(text: String, open: usize, end: usize, depth: usize): usize =
    if open >= end { end }
    else if open >= text.len() { end }
    else {
        let next = open + 1
        if text.byte_at(open) == 123 { typed_source_region_matching_brace(text, next, end, depth + 1) }
        else if text.byte_at(open) == 125 {
            if depth == 1 { open }
            else { typed_source_region_matching_brace(text, next, end, depth - 1) }
        }
        else { typed_source_region_matching_brace(text, next, end, depth) }
    }

/// Find the matching `}` for one known opening brace.
def typed_source_region_match_open_brace(text: String, open: usize, end: usize): usize =
    if open >= end { end }
    else if open >= text.len() { end }
    else if text.byte_at(open) != 123 { end }
    else { typed_source_region_matching_brace(text, open, end, 0) }

/// Return the first parameter name in a function header.
def typed_function_first_param_name(text: String, item: TypedItemSkeleton): Option[SourceNameSlice] =
    let header_start = item.surface.header.offset
    let header_end = item.surface.header.offset + item.surface.header.len
    let open = typed_source_region_find_byte_or_end(text, header_start, header_end, 40)
    if open >= header_end { None }
    else { source_scan_ident_slice(text, open + 1) }

/// Return the close paren for a function header parameter list.
def typed_function_param_list_close(text: String, item: TypedItemSkeleton): usize =
    let header_start = item.surface.header.offset
    let header_end = item.surface.header.offset + item.surface.header.len
    let open = typed_source_region_find_byte_or_end(text, header_start, header_end, 40)
    if open >= header_end { header_end }
    else { typed_source_region_find_byte_or_end(text, open + 1, header_end, 41) }

/// Return the first byte after one simple parameter declaration.
def typed_function_param_decl_end(text: String, offset: usize, end: usize): usize =
    let comma = typed_source_region_find_byte_or_end(text, offset, end, 44)
    if comma < end { comma }
    else { end }

/// Return true when a parameter declaration contains an i32/bool ABI type.
def typed_function_param_decl_is_i32_like(text: String, start: usize, end: usize): bool =
    if source_region_has_text(text, start, end, "i32") { true }
    else { source_region_has_text(text, start, end, "bool") }

/// Count simple i32-like parameters in declaration order.
def typed_function_i32_param_count_loop(text: String, offset: usize, close: usize, count: usize): usize =
    let start = source_skip_spaces(text, offset)
    if start >= close { count }
    else {
        let item_end = typed_function_param_decl_end(text, start, close)
        let next_count = if typed_function_param_decl_is_i32_like(text, start, item_end) { count + 1 } else { count }
        let next = source_skip_spaces(text, item_end)
        if next < close && text.byte_at(next) == 44 { typed_function_i32_param_count_loop(text, next + 1, close, next_count) }
        else { next_count }
    }

/// Count the narrow i32 params understood by the first executable function slice.
def typed_function_i32_param_count(text: String, item: TypedItemSkeleton): usize =
    let header_start = item.surface.header.offset
    let header_end = item.surface.header.offset + item.surface.header.len
    let open = typed_source_region_find_byte_or_end(text, header_start, header_end, 40)
    let close = typed_function_param_list_close(text, item)
    if open >= header_end { 0 }
    else { typed_function_i32_param_count_loop(text, open + 1, close, 0) }

/// Return true when a bounded source region exactly names one parameter.
def typed_source_region_is_param(text: String, param: SourceNameSlice, start: usize, end: usize): bool =
    let offset = source_skip_spaces(text, start)
    if source_starts_with_at(text, offset, typed_function_tail_call_target_text(text, param), 0) == false { false }
    else if source_word_boundary_after(text, offset, param.len) == false { false }
    else { typed_source_region_only_spaces(text, offset + param.len, end) }

/// Return true when a source type slice is one of the primitive direct backend types.
def typed_type_slice_is_primitive_i32_like(text: String, ty: SourceNameSlice): bool =
    source_name_slice_eq_text(text, ty, "i32") || source_name_slice_eq_text(text, ty, "bool")

/// Pick an indexed function parameter from a bounded source region.
def typed_function_param_index_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[usize] =
    typed_function_param_index_from_region_loop(text, item, start, end, item.surface.header.offset, 0)

/// Pick an indexed function parameter by scanning the function header.
def typed_function_param_index_from_region_loop(text: String, item: TypedItemSkeleton, start: usize, end: usize, offset: usize, index: usize): Option[usize] =
    let close = typed_function_param_list_close(text, item)
    let param_start = source_skip_spaces(text, offset)
    let open = typed_source_region_find_byte_or_end(text, item.surface.header.offset, item.surface.header.offset + item.surface.header.len, 40)
    let scan_start = if param_start <= open { source_skip_spaces(text, open + 1) } else { param_start }
    if scan_start >= close { None }
    else {
        match source_scan_ident_slice(text, scan_start) {
            Some(param) =>
                if typed_source_region_is_param(text, param, start, end) { Some(index) }
                else {
                    let decl_end = typed_function_param_decl_end(text, source_name_slice_end(param), close)
                    let next = source_skip_spaces(text, decl_end)
                    if next < close && text.byte_at(next) == 44 { typed_function_param_index_from_region_loop(text, item, start, end, next + 1, index + 1) }
                    else { None }
                }
            None => None
        }
    }

/// Return the type annotation slice for a parameter declaration.
def typed_function_param_type_slice(text: String, param: SourceNameSlice, decl_end: usize): Option[SourceNameSlice] =
    let colon = typed_source_region_find_byte_or_end(text, source_name_slice_end(param), decl_end, 58)
    if colon >= decl_end { None }
    else {
        let ty_start = source_skip_spaces(text, colon + 1)
        if ty_start >= decl_end { None }
        else {
            let ty_end = source_scan_namespace_name_end(text, ty_start)
            if ty_end <= ty_start { None }
            else { Some(SourceNameSlice { offset: ty_start, len: ty_end - ty_start }) }
        }
    }

/// Pick a parameter type slice when a bounded region exactly names that parameter.
def typed_function_param_type_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[SourceNameSlice] =
    typed_function_param_type_from_region_loop(text, item, start, end, item.surface.header.offset)

/// Scan function params until the source region matches one param name.
def typed_function_param_type_from_region_loop(text: String, item: TypedItemSkeleton, start: usize, end: usize, offset: usize): Option[SourceNameSlice] =
    let close = typed_function_param_list_close(text, item)
    let param_start = source_skip_spaces(text, offset)
    let open = typed_source_region_find_byte_or_end(text, item.surface.header.offset, item.surface.header.offset + item.surface.header.len, 40)
    let scan_start = if param_start <= open { source_skip_spaces(text, open + 1) } else { param_start }
    if scan_start >= close { None }
    else {
        match source_scan_ident_slice(text, scan_start) {
            Some(param) => {
                let decl_end = typed_function_param_decl_end(text, source_name_slice_end(param), close)
                if typed_source_region_is_param(text, param, start, end) {
                    typed_function_param_type_slice(text, param, decl_end)
                } else {
                    let next = source_skip_spaces(text, decl_end)
                    if next < close && text.byte_at(next) == 44 { typed_function_param_type_from_region_loop(text, item, start, end, next + 1) }
                    else { None }
                }
            }
            None => None
        }
    }

/// Pick a typed indexed parameter expression from a bounded source region.
def typed_function_param_expr_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    match typed_function_param_index_from_region(text, item, start, end) {
        Some(index) => Some(TypedExprParam(index))
        None => None
    }

/// Return true when a byte can separate simple call arguments.
def typed_call_arg_separator(byte: u8): bool =
    if byte == 44 { true }
    else { byte == 41 }

/// Find the next top-level call argument boundary.
def typed_call_arg_end(text: String, offset: usize, end: usize): usize =
    typed_call_arg_end_nested(text, offset, end, 0, 0, 0)

/// Find the next top-level call argument boundary while preserving nested delimiters.
def typed_call_arg_end_nested(text: String, offset: usize, end: usize, paren_depth: usize, brace_depth: usize, bracket_depth: usize): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else {
        let byte = text.byte_at(offset)
        if paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 && typed_call_arg_separator(byte) { offset }
        else if byte == 40 { typed_call_arg_end_nested(text, offset + 1, end, paren_depth + 1, brace_depth, bracket_depth) }
        else if byte == 41 {
            if paren_depth == 0 { offset }
            else { typed_call_arg_end_nested(text, offset + 1, end, paren_depth - 1, brace_depth, bracket_depth) }
        }
        else if byte == 123 { typed_call_arg_end_nested(text, offset + 1, end, paren_depth, brace_depth + 1, bracket_depth) }
        else if byte == 125 {
            if brace_depth == 0 { offset }
            else { typed_call_arg_end_nested(text, offset + 1, end, paren_depth, brace_depth - 1, bracket_depth) }
        }
        else if byte == 91 { typed_call_arg_end_nested(text, offset + 1, end, paren_depth, brace_depth, bracket_depth + 1) }
        else if byte == 93 {
            if bracket_depth == 0 { offset }
            else { typed_call_arg_end_nested(text, offset + 1, end, paren_depth, brace_depth, bracket_depth - 1) }
        }
        else { typed_call_arg_end_nested(text, offset + 1, end, paren_depth, brace_depth, bracket_depth) }
    }

/// Parse one atom argument in a source-slice call.
def typed_call_arg_expr_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    match typed_function_param_expr_from_region(text, item, start, end) {
        Some(param) => Some(param)
        None =>
        match typed_i32_const_atom_exact_from_region(text, start, end) {
            Some(atom) => Some(TypedExprI32Const(atom))
            None => typed_function_expr_from_region(text, item, start, end)
        }
    }

/// Return true when a bounded source region is exactly the pipe placeholder.
def typed_pipe_arg_is_placeholder(text: String, start: usize, end: usize): bool =
    let offset = source_skip_spaces(text, start)
    if offset >= end { false }
    else if text.byte_at(offset) != 95 { false }
    else { typed_source_region_only_spaces(text, offset + 1, end) }

/// Parse one simple pipe RHS argument, replacing every `_` with the same lhs value.
def typed_pipe_call_arg_expr_from_region(text: String, item: TypedItemSkeleton, lhs: TypedExprKind, start: usize, end: usize): Option[TypedExprKind] =
    if typed_pipe_arg_is_placeholder(text, start, end) { Some(lhs) }
    else { typed_call_arg_expr_from_region(text, item, start, end) }

/// Parse comma-separated pipe RHS arguments.
def typed_pipe_call_arg_exprs(text: String, item: TypedItemSkeleton, lhs: TypedExprKind, offset: usize, close: usize, out: Vec[TypedExprKind]): Option[Array[TypedExprKind]] =
    let start = source_skip_spaces(text, offset)
    if start >= close { Some(out.freeze()) }
    else {
        let arg_end = typed_call_arg_end(text, start, close)
        match typed_pipe_call_arg_expr_from_region(text, item, lhs, start, arg_end) {
            Some(arg) => {
                let next = source_skip_spaces(text, arg_end)
                if next >= close { Some(out.push(arg).freeze()) }
                else if text.byte_at(next) == 44 { typed_pipe_call_arg_exprs(text, item, lhs, next + 1, close, out.push(arg)) }
                else { None }
            }
            None => None
        }
    }

/// Return true when a pipe RHS argument list already uses `_`.
def typed_pipe_args_have_placeholder(text: String, offset: usize, close: usize): bool =
    let start = source_skip_spaces(text, offset)
    if start >= close { false }
    else {
        let arg_end = typed_call_arg_end(text, start, close)
        if typed_pipe_arg_is_placeholder(text, start, arg_end) { true }
        else {
            let next = source_skip_spaces(text, arg_end)
            if next < close && text.byte_at(next) == 44 { typed_pipe_args_have_placeholder(text, next + 1, close) }
            else { false }
        }
    }

/// Prepend the pipe lhs value to an argument array for receiver-first pipe calls.
def typed_pipe_prepend_lhs_arg(lhs: TypedExprKind, args: Array[TypedExprKind], index: usize, out: Vec[TypedExprKind]): Array[TypedExprKind] =
    if index == args.len() { out.freeze() }
    else { typed_pipe_prepend_lhs_arg(lhs, args, index + 1, out.push(args.get(index))) }

/// Append one receiver expression before explicit method call arguments.
def typed_method_receiver_first_args(receiver: TypedExprKind, args: Array[TypedExprKind], index: usize, out: Vec[TypedExprKind]): Array[TypedExprKind] =
    if index == args.len() { out.freeze() }
    else { typed_method_receiver_first_args(receiver, args, index + 1, out.push(args.get(index))) }

/// Return true when a typed expression can still be used as a direct CPS atom.
def typed_expr_is_atom_arg(expr: TypedExprKind): bool =
    match expr {
        TypedExprI32Const(_) => true
        TypedExprParam(_) => true
        _ => false
    }

/// Parse a simple pipe RHS call and expand placeholder/default receiver position.
def typed_pipe_rhs_expr(text: String, item: TypedItemSkeleton, lhs: TypedExprKind, start: usize, end: usize): Option[TypedExprKind] =
    let offset = source_skip_spaces(text, start)
    if offset >= end { None }
    else if source_is_ident_start(text.byte_at(offset)) == false { None }
    else {
        let name_end = source_scan_namespace_name_end(text, offset)
        let call_start = source_skip_spaces(text, name_end)
        if call_start >= end {
            Some(TypedExprTailCallArgs(
                typed_resolve_tail_call_target(text, item, text.slice(offset, name_end - offset)),
                Vec[TypedExprKind].new().push(lhs).freeze()))
        }
        else if text.byte_at(call_start) == 40 {
            let close = typed_source_region_find_byte_or_end(text, call_start + 1, end, 41)
            if close >= end { None }
            else if typed_source_region_only_spaces(text, close + 1, end) == false { None }
            else {
                match typed_pipe_call_arg_exprs(text, item, lhs, call_start + 1, close, Vec[TypedExprKind].new()) {
                    Some(args) =>
                        if typed_pipe_args_have_placeholder(text, call_start + 1, close) {
                            Some(TypedExprTailCallArgs(
                                typed_resolve_tail_call_target(text, item, text.slice(offset, name_end - offset)),
                                args))
                        } else {
                            Some(TypedExprTailCallArgs(
                                typed_resolve_tail_call_target(text, item, text.slice(offset, name_end - offset)),
                                typed_pipe_prepend_lhs_arg(lhs, args, 0, Vec[TypedExprKind].new().push(lhs))))
                        }
                    None => None
                }
            }
        } else { None }
    }

/// Continue a pipe chain as a left fold over simple RHS call segments.
def typed_pipe_expr_continue(text: String, item: TypedItemSkeleton, lhs: TypedExprKind, start: usize, end: usize): Option[TypedExprKind] =
    if typed_expr_is_atom_arg(lhs) == false { None }
    else {
        let pipe = typed_source_region_find_text_or_end(text, start, end, "|>")
        let segment_end = if pipe < end { pipe } else { end }
        match typed_pipe_rhs_expr(text, item, lhs, start, segment_end) {
            Some(next_lhs) =>
                if pipe < end { typed_pipe_expr_continue(text, item, next_lhs, pipe + 2, end) }
                else { Some(next_lhs) }
            None => None
        }
    }

/// Parse a simple pipe expression into executable left-folded tail-call form.
def typed_pipe_expr_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    let pipe = typed_source_region_find_text_or_end(text, start, end, "|>")
    if pipe >= end { None }
    else {
        match typed_call_arg_expr_from_region(text, item, start, pipe) {
            Some(lhs) => typed_pipe_expr_continue(text, item, lhs, pipe + 2, end)
            None => None
        }
    }

/// Parse simple comma-separated atom arguments.
def typed_call_arg_exprs(text: String, item: TypedItemSkeleton, offset: usize, close: usize, out: Vec[TypedExprKind]): Option[Array[TypedExprKind]] =
    let start = source_skip_spaces(text, offset)
    if start >= close { Some(out.freeze()) }
    else {
        let arg_end = typed_call_arg_end(text, start, close)
        match typed_call_arg_expr_from_region(text, item, start, arg_end) {
            Some(arg) => {
                let next = source_skip_spaces(text, arg_end)
                if next >= close { Some(out.push(arg).freeze()) }
                else if text.byte_at(next) == 44 { typed_call_arg_exprs(text, item, next + 1, close, out.push(arg)) }
                else { None }
            }
            None => None
        }
    }

/// Parse a source-slice tail call with zero or more simple atom arguments.
def typed_function_tail_call_args_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    let offset = source_skip_spaces(text, start)
    if offset >= end { None }
    else if source_is_ident_start(text.byte_at(offset)) == false { None }
    else {
        let name_end = source_scan_namespace_name_end(text, offset)
        let call_start = source_skip_spaces(text, name_end)
        if call_start < end && text.byte_at(call_start) == 46 {
            typed_method_tail_call_args_body(text, item, offset, name_end, call_start, end)
        }
        else if call_start >= end || text.byte_at(call_start) != 40 { None }
        else {
            let close = typed_source_region_find_byte_or_end(text, call_start + 1, end, 41)
            if close >= end { None }
            else if typed_source_region_only_spaces(text, close + 1, end) == false { None }
            else {
                match typed_call_arg_exprs(text, item, call_start + 1, close, Vec[TypedExprKind].new()) {
                    Some(args) =>
                        Some(TypedExprTailCallArgs(
                            typed_resolve_tail_call_target(text, item, text.slice(offset, name_end - offset)),
                            args))
                    None => None
                }
            }
        }
    }

/// Parse a single top-level infix operator expression that maps to a method protocol call.
def typed_operator_expr_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    match typed_operator_find_add(text, source_skip_spaces(text, start), end, 0, 0, 0) {
        Some(op) => typed_operator_add_expr_body(text, item, start, op, end)
        None => None
    }

/// Find a top-level `+` operator in a bounded expression.
def typed_operator_find_add(text: String, offset: usize, end: usize, paren_depth: usize, brace_depth: usize, bracket_depth: usize): Option[usize] =
    if offset >= end { None }
    else if offset >= text.len() { None }
    else {
        let byte = text.byte_at(offset)
        if paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 && byte == 43 { Some(offset) }
        else if byte == 40 { typed_operator_find_add(text, offset + 1, end, paren_depth + 1, brace_depth, bracket_depth) }
        else if byte == 41 {
            typed_operator_find_add(text, offset + 1, end, if paren_depth > 0 { paren_depth - 1 } else { 0 }, brace_depth, bracket_depth)
        }
        else if byte == 123 { typed_operator_find_add(text, offset + 1, end, paren_depth, brace_depth + 1, bracket_depth) }
        else if byte == 125 {
            typed_operator_find_add(text, offset + 1, end, paren_depth, if brace_depth > 0 { brace_depth - 1 } else { 0 }, bracket_depth)
        }
        else if byte == 91 { typed_operator_find_add(text, offset + 1, end, paren_depth, brace_depth, bracket_depth + 1) }
        else if byte == 93 {
            typed_operator_find_add(text, offset + 1, end, paren_depth, brace_depth, if bracket_depth > 0 { bracket_depth - 1 } else { 0 })
        }
        else { typed_operator_find_add(text, offset + 1, end, paren_depth, brace_depth, bracket_depth) }
    }

/// Lower nominal `left + right` to `Receiver.op_add(left, right)` when receiver type is known.
def typed_operator_add_expr_body(text: String, item: TypedItemSkeleton, start: usize, op: usize, end: usize): Option[TypedExprKind] =
    match typed_function_expr_from_region(text, item, start, op) {
        Some(left) =>
            match typed_function_expr_from_region(text, item, op + 1, end) {
                Some(right) =>
                    match typed_function_param_type_from_region(text, item, start, op) {
                        Some(receiver_ty) =>
                            if typed_type_slice_is_primitive_i32_like(text, receiver_ty) { None }
                            else {
                                Some(TypedExprTailCallArgs(
                                    typed_resolve_tail_call_target(text, item, typed_function_tail_call_target_text(text, receiver_ty).concat(".op_add")),
                                    Vec[TypedExprKind].new().push(left).push(right).freeze()))
                            }
                        None => None
                    }
                None => None
            }
        None => None
    }

/// Parse a source-slice receiver.method(args) call as receiver-first method form.
def typed_method_tail_call_args_body(text: String, item: TypedItemSkeleton, receiver_start: usize, receiver_end: usize, dot: usize, end: usize): Option[TypedExprKind] =
    let member_start = source_skip_spaces(text, dot + 1)
    if member_start >= end || source_is_ident_start(text.byte_at(member_start)) == false { None }
    else {
        let member_end = source_scan_namespace_name_end(text, member_start)
        let call_start = source_skip_spaces(text, member_end)
        if call_start >= end || text.byte_at(call_start) != 40 { None }
        else {
            let close = typed_source_region_find_byte_or_end(text, call_start + 1, end, 41)
            if close >= end { None }
            else if typed_source_region_only_spaces(text, close + 1, end) == false { None }
            else {
                match typed_call_arg_exprs(text, item, call_start + 1, close, Vec[TypedExprKind].new()) {
                    Some(args) => typed_method_or_qualified_call_expr(text, item, receiver_start, receiver_end, member_start, member_end, args)
                    None => None
                }
            }
        }
    }

/// Parse a dotted call as either receiver method or qualified static function.
def typed_method_or_qualified_call_expr(text: String, item: TypedItemSkeleton, receiver_start: usize, receiver_end: usize, member_start: usize, member_end: usize, args: Array[TypedExprKind]): Option[TypedExprKind] =
    match typed_call_arg_expr_from_region(text, item, receiver_start, receiver_end) {
        Some(receiver) =>
            Some(TypedExprTailCallArgs(
                typed_method_target_from_receiver(text, item, receiver_start, receiver_end, member_start, member_end),
                typed_method_receiver_first_args(receiver, args, 0, Vec[TypedExprKind].new().push(receiver))))
        None =>
            Some(TypedExprTailCallArgs(
                typed_resolve_tail_call_target(
                    text,
                    item,
                    text.slice(receiver_start, receiver_end - receiver_start).concat(".").concat(text.slice(member_start, member_end - member_start))),
                args))
    }

/// Resolve a method call target through the receiver's declared nominal type when available.
def typed_method_target_from_receiver(text: String, item: TypedItemSkeleton, receiver_start: usize, receiver_end: usize, member_start: usize, member_end: usize): str =
    match typed_function_param_type_from_region(text, item, receiver_start, receiver_end) {
        Some(receiver_ty) =>
            typed_resolve_tail_call_target(
                text,
                item,
                typed_function_tail_call_target_text(text, receiver_ty).concat(".").concat(text.slice(member_start, member_end - member_start)))
        None =>
            typed_resolve_tail_call_target(
                text,
                item,
                text.slice(receiver_start, receiver_end - receiver_start).concat(".").concat(text.slice(member_start, member_end - member_start)))
    }

/// Parse the literal condition of the first executable branch slice.
def typed_branch_literal_condition_matches(text: String, offset: usize, prefix: str, literal: str): bool =
    let condition_start = offset + prefix.len()
    if source_starts_with_at(text, offset, prefix.concat(literal), 0) == false { false }
    else { source_word_boundary_after(text, condition_start, literal.len()) }

/// Parse the literal condition of the first executable branch slice.
def typed_branch_condition_from_region(text: String, start: usize, end: usize): Option[TypedBranchCondition] =
    let offset = source_skip_spaces(text, start)
    if typed_branch_literal_condition_matches(text, offset, "if ", "true") { Some(TypedBranchConditionTrue) }
    else if typed_branch_literal_condition_matches(text, offset, "if ", "false") { Some(TypedBranchConditionFalse) }
    else { None }

/// Parse a literal or indexed-parameter branch condition.
def typed_branch_condition_from_item_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedBranchCondition] =
    match typed_branch_condition_from_region(text, start, end) {
        Some(condition) => Some(condition)
        None => {
            let offset = source_skip_spaces(text, start)
            let if_start = source_skip_spaces(text, offset + "if".len())
            let condition_end = typed_source_region_find_byte_or_end(text, if_start, end, 123)
            match typed_function_param_index_from_region(text, item, if_start, condition_end) {
                Some(index) => Some(TypedBranchConditionParam(index))
                None => None
            }
        }
    }

/// Pick a non-branch typed expression from a bounded source region.
def typed_function_non_branch_expr_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    match typed_operator_expr_body(text, item, start, end) {
        Some(operator) => Some(operator)
        None =>
        match typed_pipe_expr_body(text, item, start, end) {
            Some(pipe) => Some(pipe)
            None =>
            match typed_function_param_expr_from_region(text, item, start, end) {
                Some(param) => Some(param)
                None =>
                match typed_i32_const_atom_exact_from_region(text, start, end) {
                    Some(atom) => Some(TypedExprI32Const(atom))
                    None =>
                        match typed_function_tail_call_args_body(text, item, start, end) {
                            Some(body) => Some(body)
                            None =>
                                match typed_function_tail_call_target_slice(text, start, end) {
                                    Some(target) => Some(TypedExprTailCallArgs(
                                        typed_resolve_tail_call_target(text, item, typed_function_tail_call_target_text(text, target)),
                                        Vec[TypedExprKind].new().freeze()))
                                    None => None
                                }
                        }
                }
            }
        }
    }

/// Convert an i32 atom into the typed expression form used by backend slices.
def typed_expr_from_i32_atom(atom: TypedI32ConstAtom): TypedExprKind =
    TypedExprI32Const(atom)

/// Find a continuation resume argument start for a known bootstrap continuation name.
def typed_control_resume_arg_start(text: String, offset: usize, end: usize, name: str): Option[usize] =
    if offset >= end { None }
    else if source_starts_with_at(text, offset, name, 0) {
        let open = source_skip_spaces(text, offset + name.len())
        if open < end && text.byte_at(open) == 40 { Some(source_skip_spaces(text, open + 1)) }
        else { None }
    } else { None }

/// Parse the numeric argument of a continuation resume call.
def typed_control_resume_const_at(text: String, offset: usize, end: usize): Option[TypedI32ConstAtom] =
    match typed_control_resume_arg_start(text, offset, end, "k") {
        Some(arg) => {
            let close = typed_source_region_find_byte_or_end(text, arg, end, 41)
            if close >= end { None }
            else { typed_i32_const_atom_exact_from_region(text, arg, close) }
        }
        None =>
            match typed_control_resume_arg_start(text, offset, end, "retry") {
                Some(arg) => {
                    let close = typed_source_region_find_byte_or_end(text, arg, end, 41)
                    if close >= end { None }
                    else { typed_i32_const_atom_exact_from_region(text, arg, close) }
                }
                None => None
            }
    }

/// Return the final numeric resume value from a reset/shift/shiftn body.
def typed_control_last_resume_const(text: String, offset: usize, end: usize, last: Option[TypedI32ConstAtom]): Option[TypedI32ConstAtom] =
    if offset >= end { last }
    else {
        match typed_control_resume_const_at(text, offset, end) {
            Some(atom) => typed_control_last_resume_const(text, offset + 1, end, Some(atom))
            None => typed_control_last_resume_const(text, offset + 1, end, last)
        }
    }

/// Lower a simple delimited-control fixture to the value produced by its final resume.
def typed_control_expr_from_region(text: String, start: usize, end: usize): Option[TypedExprKind] =
    match typed_control_last_resume_const(text, start, end, None) {
        Some(atom) => Some(typed_expr_from_i32_atom(atom))
        None => None
    }

/// Parse a narrow `if cond { expr } else { expr }` body.
def typed_function_if_else_expr_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    match typed_branch_condition_from_item_region(text, item, start, end) {
        Some(condition) => {
            let then_open = typed_source_region_find_byte_or_end(text, start, end, 123)
            let then_close = typed_source_region_match_open_brace(text, then_open, end)
            let else_offset = typed_source_region_find_text_or_end(text, then_close, end, "else")
            let else_body = source_skip_spaces(text, else_offset + "else".len())
            let else_open = typed_source_region_find_byte_or_end(text, else_body, end, 123)
            let else_close = typed_source_region_match_open_brace(text, else_open, end)
            if then_open >= end || then_close >= end || else_offset >= end {
                None
            } else {
                match typed_function_expr_from_region(text, item, then_open + 1, then_close) {
                    Some(then_expr) => {
                        let else_start =
                            if source_starts_with_at(text, else_body, "if", 0) { else_body }
                            else { else_open + 1 }
                        let else_end =
                            if source_starts_with_at(text, else_body, "if", 0) { end }
                            else { else_close }
                        if else_start >= end || else_end > end { None }
                        else {
                            match typed_function_expr_from_region(text, item, else_start, else_end) {
                            Some(else_expr) => Some(TypedExprIfElse(condition, then_expr, else_expr))
                            None => None
                        }
                        }
                    }
                    None => None
                }
            }
        }
        None => None
    }

/// Return the indexed parameter used as a bounded match scrutinee.
def typed_match_scrutinee_param_index(text: String, item: TypedItemSkeleton, start: usize, open: usize): Option[usize] =
    typed_function_param_index_from_region(text, item, start + "match".len(), open)

/// Locate the body expression that follows one `pattern =>` arm.
def typed_match_arm_expr_start(text: String, pattern: usize, end: usize, label: str): usize =
    if pattern >= end { end }
    else {
        let arrow = typed_source_region_find_text_or_end(text, pattern + label.len(), end, "=>")
        if arrow >= end { end }
        else { source_skip_spaces(text, arrow + 2) }
    }

/// Locate the next bool match arm after one body start.
def typed_match_next_bool_arm(text: String, offset: usize, close: usize): usize =
    let true_at = typed_source_region_find_text_or_end(text, offset, close, "true")
    let false_at = typed_source_region_find_text_or_end(text, offset, close, "false")
    if true_at < false_at { true_at } else { false_at }

/// Parse a narrow bool `match param { true => expr false => expr }` body.
def typed_function_match_bool_expr_body(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    let offset = source_skip_spaces(text, start)
    if source_starts_with_at(text, offset, "match", 0) == false { None }
    else {
        let open = typed_source_region_find_byte_or_end(text, offset, end, 123)
        let close = typed_source_region_match_open_brace(text, open, end)
        if open >= end || close > end { None }
        else {
            match typed_match_scrutinee_param_index(text, item, offset, open) {
                Some(param_index) => {
                    let true_pattern = typed_source_region_find_text_or_end(text, open + 1, close, "true")
                    let false_pattern = typed_source_region_find_text_or_end(text, open + 1, close, "false")
                    if true_pattern >= close || false_pattern >= close { None }
                    else {
                        let true_expr_start = typed_match_arm_expr_start(text, true_pattern, close, "true")
                        let false_expr_start = typed_match_arm_expr_start(text, false_pattern, close, "false")
                        let true_expr_end = typed_match_next_bool_arm(text, true_expr_start, close)
                        let false_expr_end = typed_match_next_bool_arm(text, false_expr_start, close)
                        match typed_function_expr_from_region(text, item, true_expr_start, true_expr_end) {
                            Some(then_expr) =>
                                match typed_function_expr_from_region(text, item, false_expr_start, false_expr_end) {
                                    Some(else_expr) => Some(TypedExprIfElse(TypedBranchConditionParam(param_index), then_expr, else_expr))
                                    None => None
                                }
                            None => None
                        }
                    }
                }
                None => None
            }
        }
    }

/// Pick a typed expression from a bounded source region.
def typed_function_expr_from_region(text: String, item: TypedItemSkeleton, start: usize, end: usize): Option[TypedExprKind] =
    let offset = source_skip_spaces(text, start)
    if offset >= end { None }
    else if source_starts_with_at(text, offset, "match", 0) {
        match typed_function_match_bool_expr_body(text, item, offset, end) {
            Some(body) => Some(body)
            None => typed_function_non_branch_expr_from_region(text, item, offset, end)
        }
    }
    else if source_starts_with_at(text, offset, "if", 0) {
        match typed_function_if_else_expr_body(text, item, offset, end) {
            Some(body) => Some(body)
            None => typed_function_non_branch_expr_from_region(text, item, offset, end)
        }
    }
    else { typed_function_non_branch_expr_from_region(text, item, offset, end) }

/// Compare two function-slice source symbols byte-for-byte.
def typed_function_symbol_eq(left: str, right: str, index: usize): bool =
    if index == left.len() && index == right.len() { true }
    else if index == left.len() { false }
    else if index == right.len() { false }
    else if left.byte_at(index) == right.byte_at(index) { typed_function_symbol_eq(left, right, index + 1) }
    else { false }

/// Return the callee target carried by a function-slice typed body.
def typed_function_tail_call_target(body: TypedExprKind): Option[str] =
    match body {
        TypedExprTailCall(target) => Some(target)
        TypedExprTailCallArgs(target, _) => Some(target)
        _ => None
    }

/// Return true when the current typed function set defines one symbol.
def typed_functions_have_symbol(functions: Array[TypedFunctionFact], target: str, index: usize): bool =
    if index == functions.len() { false }
    else if typed_function_symbol_eq(functions.get(index).symbol, target, 0) { true }
    else { typed_functions_have_symbol(functions, target, index + 1) }

/// Return true when the same typed function symbol appears later.
def typed_functions_have_later_symbol(functions: Array[TypedFunctionFact], target: str, index: usize): bool =
    if index == functions.len() { false }
    else if typed_function_symbol_eq(functions.get(index).symbol, target, 0) { true }
    else { typed_functions_have_later_symbol(functions, target, index + 1) }

/// Return true when typed function symbols are unique.
def typed_function_symbols_unique(functions: Array[TypedFunctionFact], index: usize): bool =
    if index == functions.len() { true }
    else if typed_functions_have_later_symbol(functions, functions.get(index).symbol, index + 1) { false }
    else { typed_function_symbols_unique(functions, index + 1) }

/// Return true when exported main follows the current no-param ABI slice.
def typed_function_main_abi_valid(functions: Array[TypedFunctionFact], index: usize): bool =
    if index == functions.len() { true }
    else {
        let function = functions.get(index)
        if function.is_main {
            if function.i32_param_count == 0 { typed_function_main_abi_valid(functions, index + 1) }
            else { false }
        } else { typed_function_main_abi_valid(functions, index + 1) }
    }

/// Return true when every function-slice tail-call target resolves within this typed module.
def typed_function_tail_targets_resolved_for_body(functions: Array[TypedFunctionFact], body: TypedExprKind): bool =
    match body {
        TypedExprTailCall(target) => typed_functions_have_symbol(functions, target, 0)
        TypedExprTailCallArgs(target, args) =>
            typed_functions_have_symbol(functions, target, 0) && typed_function_tail_targets_resolved_for_args(functions, args, 0)
        TypedExprIfElse(_, then_expr, else_expr) =>
            typed_function_tail_targets_resolved_for_body(functions, then_expr) && typed_function_tail_targets_resolved_for_body(functions, else_expr)
        _ => true
    }

/// Return true when every nested expression argument has resolved tail-call targets.
def typed_function_tail_targets_resolved_for_args(functions: Array[TypedFunctionFact], args: Array[TypedExprKind], index: usize): bool =
    if index == args.len() { true }
    else if typed_function_tail_targets_resolved_for_body(functions, args.get(index)) {
        typed_function_tail_targets_resolved_for_args(functions, args, index + 1)
    } else { false }

/// Return true when every function body has resolved function-slice tail-call targets.
def typed_function_tail_targets_resolved(functions: Array[TypedFunctionFact], index: usize): bool =
    if index == functions.len() { true }
    else if typed_function_tail_targets_resolved_for_body(functions, functions.get(index).body) {
        typed_function_tail_targets_resolved(functions, index + 1)
    } else { false }

/// Stable item-to-namespace ownership fact after alpha conversion.
type NamespaceOwnershipFact {
    owner: BinderId,
    file: SourceFileId,
    owner_namespace: NamespaceNameSlice,
}

/// Source import fact before full namespace/name resolution.
type NamespaceImportFact {
    file: SourceFileId,
    path: SourceNameSlice,
    glob: bool,
    multi: bool,
    line: usize,
    column: usize,
}

/// Method/operator declaration surface fact after alpha conversion.
type MethodSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    receiver: SourceNameSlice,
    member: SourceNameSlice,
    operator: bool,
}

/// Branching surface fact used by typed lowering and CPS join planning.
type BranchingSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_if: bool,
    has_else: bool,
    has_else_if: bool,
    has_if_let: bool,
    has_match: bool,
    has_short_circuit: bool,
}

/// Delimited-control surface fact before answer/control checking.
type ControlSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_reset: bool,
    has_shift: bool,
    has_shiftn: bool,
}

/// Static value surface fact before module-load init dependency analysis.
type GlobalInitSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_initializer: bool,
    has_dependency: bool,
    world_local: bool,
    has_ref_type: bool,
}

/// Global initialization obligation before dependency sorting and cycle checks.
type GlobalInitObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_module_load_init: bool,
    requires_dependency_edge: bool,
    requires_world_local_ref: bool,
}

/// Pipe surface fact before placeholder and receiver-first desugaring.
type PipeSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_pipe: bool,
    has_placeholder: bool,
    has_chain: bool,
}

/// Pipe lowering obligation before placeholder expansion and method/operator desugar.
type PipeLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_placeholder_expansion: bool,
    requires_receiver_first_desugar: bool,
    repeated_placeholder_lhs_is_single_eval: bool,
}

/// Pattern surface fact before DFT lowering and exhaustiveness checks.
type PatternSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_match: bool,
    has_if_let: bool,
    has_deep_pattern: bool,
    has_pattern_params: bool,
    has_wildcard_let: bool,
}

/// Pattern lowering obligation before DFT lowering and exhaustiveness checks.
type PatternLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_match_exhaustiveness: bool,
    requires_if_let_dual_env: bool,
    requires_deep_pattern_dft: bool,
    requires_function_param_desugar: bool,
    wildcard_let_discards_value: bool,
}

/// Compiler intrinsic and tuple bridge surface before checked lowering.
type IntrinsicSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_compiler_intrinsic_call: bool,
    has_tuple_type_surface: bool,
    has_tuple_to_adt: bool,
    has_adt_to_tuple: bool,
    has_unsafe_cast: bool,
}

/// Compiler intrinsic lowering obligation before namespace resolution.
type IntrinsicLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    intrinsic_namespace: String,
    tuple_to_adt_identity: Option[AdtTupleIntrinsicIdentity],
    adt_to_tuple_identity: Option[AdtTupleIntrinsicIdentity],
    requires_tuple_bridge: bool,
    requires_method_first_bridge: bool,
    unsafe_cast_is_compiler_only: bool,
    requires_compiler_intrinsic_resolution: bool,
}

/// Generic/template surface before definition-time and instantiation checks.
type GenericSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_explicit_type_params: bool,
    has_auto_generic_params: bool,
    has_explicit_instantiation_call: bool,
    has_generic_self_method: bool,
}

/// Generic/template obligation before body checking and instantiation discharge.
type GenericTemplateObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_explicit_param_binding: bool,
    requires_auto_generic_inference: bool,
    requires_instantiation_discharge: bool,
    requires_generic_self_receiver_binding: bool,
}

/// Operator use surface before overload candidate resolution.
type OperatorUseSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    operator_kind: SourceOperatorUseKind,
    has_infix_operator: bool,
    has_operator_obligation: bool,
    has_index: bool,
    has_index_slice: bool,
}

/// Closure/lambda surface before capture and env analysis.
type ClosureSurfaceFact {
    owner: BinderId,
    file: SourceFileId,
    has_lambda: bool,
    has_trailing_closure: bool,
    syntactic_no_capture: bool,
}

/// Classify a scanned source item into the first typed-lowering bucket.
def classify_typed_item_skeleton_kind(item: AlphaBinderOrigin): TypedItemSkeletonKind =
    match item.kind {
        SourceItemDef => {
            if item.surface.has_params { TypedItemFunction }
            else { TypedItemStaticValue }
        }
        SourceItemExtern => TypedItemExternFunction
        SourceItemType => TypedItemNominalType
        SourceItemData => TypedItemData
        SourceItemUnion => TypedItemUnion
        SourceItemInterface => TypedItemInterface
    }

/// Build source item skeletons from alpha origins before HM + row inference.
def typed_item_skeletons_from_alpha(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[TypedItemSkeleton]): Array[TypedItemSkeleton] =
    if index == origins.len() { out.freeze() }
    else {
        let origin = origins.get(index)
        typed_item_skeletons_from_alpha(
            origins,
            index + 1,
            out.push(TypedItemSkeleton {
                binder: origin.binder,
                file: origin.file,
                owner_namespace: origin.owner_namespace,
                kind: origin.kind,
                skeleton_kind: classify_typed_item_skeleton_kind(origin),
                name: origin.name,
                private: origin.private,
                attributes: origin.attributes,
                surface: origin.surface,
                line: origin.line,
                column: origin.column,
            }))
    }

/// Return true when placeholder pattern facts cover all source item skeletons.
def type_inference_has_pattern_coverage(skeletons: Array[TypedItemSkeleton], patterns: PatternFacts): bool =
    patterns.patterns.len() >= skeletons.len()

/// Return the text of one source file by stable id.
def typed_source_file_text(files: Array[SourceFile], file: SourceFileId, index: usize): String =
    if index == files.len() { "" }
    else if files.get(index).id.index == file.index { files.get(index).text }
    else { typed_source_file_text(files, file, index + 1) }

/// Return true when a source name slice equals a fixed ASCII identifier.
def source_name_slice_eq_text(text: String, name: SourceNameSlice, expected: str): bool =
    if name.len != expected.len() { false }
    else { source_starts_with_at(text, name.offset, expected, 0) }

/// Return true when a scanned item header mentions an i32 return annotation.
def typed_item_surface_returns_i32(text: String, item: TypedItemSkeleton): bool =
    source_region_has_text(text, item.surface.header.offset, item.surface.header.offset + item.surface.header.len, "i32")

/// Pick the function-slice typed body form from the source body region.
def typed_function_body_kind_from_surface(text: String, item: TypedItemSkeleton): TypedExprKind =
    let start = source_scan_item_body_region_start(text, item.surface.header.offset)
    let end = source_scan_item_region_end(text, item.surface.header.offset)
    if typed_item_has_control_surface_fact(item) {
        match typed_control_expr_from_region(text, start, end) {
            Some(body) => body
            None => TypedExprUnit
        }
    }
    else {
        match typed_function_expr_from_region(text, item, start, end) {
            Some(body) => body
            None =>
                if typed_item_has_branching_surface(item) { TypedExprBranchJoinPending }
                else { TypedExprUnit }
        }
    }

/// Convert one simple function skeleton into a typed function body fact.
def typed_function_fact_from_skeleton(project: ProjectSurface, item: TypedItemSkeleton): Option[TypedFunctionFact] =
    match item.skeleton_kind {
        TypedItemFunction => {
            let text = typed_source_file_text(project.files, item.file, 0)
            let returns_i32 = typed_item_surface_returns_i32(text, item)
            match item.name {
                Some(name) =>
                    Some(TypedFunctionFact {
                        owner: item.binder,
                        file: item.file,
                        symbol: typed_function_symbol_from_name(text, item, name),
                        local_symbol: typed_function_tail_call_target_text(text, name),
                        is_main: source_name_slice_eq_text(text, name, "main"),
                        returns_i32: returns_i32,
                        i32_param_count: typed_function_i32_param_count(text, item),
                        body: typed_function_body_kind_from_surface(text, item),
                    })
                None => None
            }
        }
        _ => None
    }

/// Build typed function body facts for the narrow codegen subset.
def typed_function_facts_from_skeletons(project: ProjectSurface, skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[TypedFunctionFact]): Array[TypedFunctionFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match typed_function_fact_from_skeleton(project, skeletons.get(index)) {
            Some(fact) => typed_function_facts_from_skeletons(project, skeletons, index + 1, out.push(fact))
            None => typed_function_facts_from_skeletons(project, skeletons, index + 1, out)
        }
    }

/// Find one byte in a bounded source region.
def typed_adt_find_byte_or_end(text: String, offset: usize, end: usize, byte: u8): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if text.byte_at(offset) == byte { offset }
    else { typed_adt_find_byte_or_end(text, offset + 1, end, byte) }

/// Return true for bytes ignored between data constructors.
def typed_adt_ctor_separator(byte: u8): bool =
    if byte == 32 { true }
    else if byte == 9 { true }
    else if byte == 10 { true }
    else if byte == 13 { true }
    else if byte == 44 { true }
    else { false }

/// Find the next constructor name inside a data body.
def typed_adt_next_ctor_offset(text: String, offset: usize, end: usize): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else if source_is_uppercase_ident_start(text.byte_at(offset)) { offset }
    else { typed_adt_next_ctor_offset(text, offset + 1, end) }

/// Return true when one payload type byte contributes to arity.
def typed_adt_payload_token_byte(byte: u8): bool =
    if typed_adt_ctor_separator(byte) { false }
    else if byte == 40 { false }
    else if byte == 41 { false }
    else { true }

/// Count top-level payload commas while respecting generic brackets.
def typed_adt_payload_arity_loop(text: String, offset: usize, end: usize, square_depth: usize, seen_token: bool, commas: usize): usize =
    if offset >= end {
        if seen_token { commas + 1 } else { 0 }
    } else if offset >= text.len() {
        if seen_token { commas + 1 } else { 0 }
    } else {
        let byte = text.byte_at(offset)
        if byte == 41 && square_depth == 0 {
            if seen_token { commas + 1 } else { 0 }
        } else if byte == 91 {
            typed_adt_payload_arity_loop(text, offset + 1, end, square_depth + 1, seen_token, commas)
        } else if byte == 93 {
            typed_adt_payload_arity_loop(text, offset + 1, end, if square_depth > 0 { square_depth - 1 } else { 0 }, seen_token, commas)
        } else if byte == 44 && square_depth == 0 {
            typed_adt_payload_arity_loop(text, offset + 1, end, square_depth, seen_token, commas + 1)
        } else {
            typed_adt_payload_arity_loop(text, offset + 1, end, square_depth, seen_token || typed_adt_payload_token_byte(byte), commas)
        }
    }

/// Count payload arity from an opening paren offset.
def typed_adt_payload_arity(text: String, open: usize, end: usize): usize =
    typed_adt_payload_arity_loop(text, open + 1, end, 0, false, 0)

/// Find the close paren for one constructor payload.
def typed_adt_payload_close_or_end(text: String, offset: usize, end: usize, square_depth: usize): usize =
    if offset >= end { end }
    else if offset >= text.len() { end }
    else {
        let byte = text.byte_at(offset)
        if byte == 41 && square_depth == 0 { offset }
        else if byte == 91 { typed_adt_payload_close_or_end(text, offset + 1, end, square_depth + 1) }
        else if byte == 93 { typed_adt_payload_close_or_end(text, offset + 1, end, if square_depth > 0 { square_depth - 1 } else { 0 }) }
        else { typed_adt_payload_close_or_end(text, offset + 1, end, square_depth) }
    }

/// Build placeholder payload types until full type-expression lowering owns constructor signatures.
def typed_adt_payload_types(owner_seed: usize, arity: usize, index: usize, out: Vec[SemType]): Array[SemType] =
    if index == arity { out.freeze() }
    else {
        typed_adt_payload_types(
            owner_seed,
            arity,
            index + 1,
            out.push(TyVar(TypeVar { index: owner_seed * 1000 + index + 1 })))
    }

/// Build nominal data identity from source owner namespace and item name.
def typed_adt_data_nominal_id(text: String, item: TypedItemSkeleton, name: SourceNameSlice): NominalId =
    NominalId {
        namespace_name: match item.owner_namespace {
            Some(namespace) => typed_namespace_symbol_text(text, namespace)
            None => ""
        },
        name: typed_function_tail_call_target_text(text, name),
    }

/// Scan one data body and lower each constructor to canonical tuple contract.
def typed_adt_ctors_from_data_body(text: String, data_type: NominalId, owner_seed: usize, offset: usize, end: usize, out: Vec[LoweredAdtCtor]): Vec[LoweredAdtCtor] =
    let ctor_offset = typed_adt_next_ctor_offset(text, offset, end)
    if ctor_offset >= end { out }
    else {
        let ctor_end = source_scan_namespace_name_end(text, ctor_offset)
        let ctor_name = text.slice(ctor_offset, ctor_end - ctor_offset)
        let after_name = source_skip_spaces(text, ctor_end)
        let arity = if after_name < end && text.byte_at(after_name) == 40 { typed_adt_payload_arity(text, after_name, end) } else { 0 }
        let next_offset = if after_name < end && text.byte_at(after_name) == 40 {
            typed_adt_payload_close_or_end(text, after_name + 1, end, 0) + 1
        } else { ctor_end }
        typed_adt_ctors_from_data_body(
            text,
            data_type,
            owner_seed,
            next_offset,
            end,
            out.push(lower_adt_ctor(AdtVariantDecl {
                data_type: data_type,
                ctor_name: ctor_name,
                tag: AdtVariantTag { symbol: adt_ctor_symbol_from_name(ctor_name) },
                payload: typed_adt_payload_types(owner_seed, arity, 0, Vec[SemType].new()),
            })))
    }

/// Lower constructor facts from one data skeleton.
def typed_adt_ctors_from_skeleton(project: ProjectSurface, item: TypedItemSkeleton, out: Vec[LoweredAdtCtor]): Vec[LoweredAdtCtor] =
    match item.skeleton_kind {
        TypedItemData =>
            match item.name {
                Some(name) => {
                    let text = typed_source_file_text(project.files, item.file, 0)
                    let region_end = source_scan_item_region_end(text, item.surface.header.offset)
                    let body_open = typed_adt_find_byte_or_end(text, item.surface.header.offset, region_end, 123)
                    let body_close = typed_adt_find_byte_or_end(text, body_open, region_end, 125)
                    if body_open >= region_end { out }
                    else { typed_adt_ctors_from_data_body(text, typed_adt_data_nominal_id(text, item, name), item.binder.index, body_open + 1, body_close, out) }
                }
                None => out
            }
        _ => out
    }

/// Build all ADT constructor tuple contracts from data skeletons.
def typed_adt_ctors_from_skeletons(project: ProjectSurface, skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[LoweredAdtCtor]): Array[LoweredAdtCtor] =
    if index == skeletons.len() { out.freeze() }
    else { typed_adt_ctors_from_skeletons(project, skeletons, index + 1, typed_adt_ctors_from_skeleton(project, skeletons.get(index), out)) }

/// Return true when item surfaces mention callable or explicit continuation storage types.
def typed_item_skeletons_have_callable_storage_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_callable_arrow { true }
        else if surface.has_explicit_continuation_type { true }
        else if surface.has_lambda_expr { true }
        else if surface.has_trailing_closure_expr { true }
        else { typed_item_skeletons_have_callable_storage_surface(skeletons, index + 1) }
    }

/// Pick callable position from coarse source surface facts.
def callable_storage_position_from_surface(surface: SourceItemSurfaceFacts): CallableArrowPosition =
    if surface.has_explicit_continuation_type { CallableExplicitContStorage }
    else if surface.has_send_callable_qualifier { CallableSendableStoragePosition }
    else { CallableStoragePosition }

/// Build erased callable variants required before backend-specific layout.
def callable_storage_variants_from_surface(surface: SourceItemSurfaceFacts): Array[CallableStorageVariant] =
    if surface.has_cont1_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantBoxedCont1)
            .freeze()
    } else if surface.has_contn_type {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantContN)
            .freeze()
    } else if surface.has_send_callable_qualifier {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .freeze()
    } else {
        Vec[CallableStorageVariant].new()
            .push(CallableVariantFunction)
            .push(CallableVariantClosure)
            .push(CallableVariantBoxedCont1)
            .push(CallableVariantContN)
            .freeze()
    }

/// Create one callable storage fact from a typed item skeleton when needed.
def callable_storage_fact_from_skeleton(item: TypedItemSkeleton): Option[CallableStorageFact] =
    if item.surface.has_callable_arrow || item.surface.has_explicit_continuation_type {
        Some(CallableStorageFact {
            owner: item.binder,
            position: callable_storage_position_from_surface(item.surface),
            variants: callable_storage_variants_from_surface(item.surface),
            sendable: item.surface.has_send_callable_qualifier,
        })
    } else { None }

/// Generate callable storage facts from source item skeletons.
def callable_storage_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[CallableStorageFact]): Array[CallableStorageFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match callable_storage_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => callable_storage_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => callable_storage_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create a namespace ownership fact for an item owned by a source namespace.
def namespace_ownership_fact_from_skeleton(item: TypedItemSkeleton): Option[NamespaceOwnershipFact] =
    match item.owner_namespace {
        Some(namespace) =>
            Some(NamespaceOwnershipFact {
                owner: item.binder,
                file: item.file,
                owner_namespace: namespace,
            })
        None => None
    }

/// Generate item-to-namespace ownership facts in stable binder order.
def namespace_ownership_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[NamespaceOwnershipFact]): Array[NamespaceOwnershipFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match namespace_ownership_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => namespace_ownership_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Create one namespace import fact from a source `use`.
def namespace_import_fact_from_use(import_use: SourceUseScanResult): NamespaceImportFact =
    NamespaceImportFact {
        file: import_use.file,
        path: import_use.path,
        glob: import_use.glob,
        multi: import_use.multi,
        line: import_use.line,
        column: import_use.column,
    }

/// Generate namespace import facts in deterministic source order.
def namespace_import_facts_from_uses(uses: Array[SourceUseScanResult], index: usize, out: Vec[NamespaceImportFact]): Array[NamespaceImportFact] =
    if index == uses.len() { out.freeze() }
    else { namespace_import_facts_from_uses(uses, index + 1, out.push(namespace_import_fact_from_use(uses.get(index)))) }

/// Create a method/operator surface fact from a method-like item skeleton.
def method_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[MethodSurfaceFact] =
    match item.surface.method_receiver {
        Some(receiver) =>
            match item.surface.method_member {
                Some(member) =>
                    Some(MethodSurfaceFact {
                        owner: item.binder,
                        file: item.file,
                        receiver: receiver,
                        member: member,
                        operator: item.surface.has_operator_method,
                    })
                None => None
            }
        None => None
    }

/// Generate method/operator surface facts in stable binder order.
def method_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[MethodSurfaceFact]): Array[MethodSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match method_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => method_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => method_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has branching syntax relevant to typed/CPS lowering.
def typed_item_has_branching_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_if_expr { true }
    else if item.surface.has_else_expr { true }
    else if item.surface.has_else_if_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_match_expr { true }
    else { item.surface.has_short_circuit_expr }

/// Create one branching surface fact from a typed item skeleton.
def branching_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[BranchingSurfaceFact] =
    if typed_item_has_branching_surface(item) {
        Some(BranchingSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_if: item.surface.has_if_expr,
            has_else: item.surface.has_else_expr,
            has_else_if: item.surface.has_else_if_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_match: item.surface.has_match_expr,
            has_short_circuit: item.surface.has_short_circuit_expr,
        })
    } else { None }

/// Generate branching surface facts in stable binder order.
def branching_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[BranchingSurfaceFact]): Array[BranchingSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match branching_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => branching_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => branching_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item has delimited-control syntax.
def typed_item_has_control_surface_fact(item: TypedItemSkeleton): bool =
    if item.surface.has_reset_expr { true }
    else if item.surface.has_shift_expr { true }
    else { item.surface.has_shiftn_expr }

/// Create one delimited-control surface fact from a typed item skeleton.
def control_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[ControlSurfaceFact] =
    if typed_item_has_control_surface_fact(item) {
        Some(ControlSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_reset: item.surface.has_reset_expr,
            has_shift: item.surface.has_shift_expr,
            has_shiftn: item.surface.has_shiftn_expr,
        })
    } else { None }

/// Generate delimited-control surface facts in stable binder order.
def control_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[ControlSurfaceFact]): Array[ControlSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match control_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => control_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => control_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when a static value needs module-load init handling.
def typed_item_has_global_init_surface(item: TypedItemSkeleton): bool =
    if item.skeleton_kind != TypedItemStaticValue { false }
    else if item.surface.has_global_value_initializer { true }
    else { item.surface.has_global_value_dependency }

/// Create one global-init surface fact from a static value skeleton.
def global_init_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[GlobalInitSurfaceFact] =
    if typed_item_has_global_init_surface(item) {
        Some(GlobalInitSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_initializer: item.surface.has_global_value_initializer,
            has_dependency: item.surface.has_global_value_dependency,
            world_local: item.attributes.world_local,
            has_ref_type: item.surface.has_ref_type,
        })
    } else { None }

/// Generate global-init surface facts in stable binder order.
def global_init_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[GlobalInitSurfaceFact]): Array[GlobalInitSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match global_init_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => global_init_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => global_init_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Convert one global init surface fact into an init graph obligation.
def global_init_obligation_from_surface(fact: GlobalInitSurfaceFact): GlobalInitObligation =
    GlobalInitObligation {
        owner: fact.owner,
        file: fact.file,
        requires_module_load_init: fact.has_initializer,
        requires_dependency_edge: fact.has_dependency,
        requires_world_local_ref: fact.has_ref_type && fact.world_local,
    }

/// Convert global init facts in stable owner order.
def global_init_obligations_from_surface(facts: Array[GlobalInitSurfaceFact], index: usize, out: Vec[GlobalInitObligation]): Array[GlobalInitObligation] =
    if index == facts.len() { out.freeze() }
    else { global_init_obligations_from_surface(facts, index + 1, out.push(global_init_obligation_from_surface(facts.get(index)))) }

/// Return true when an item body contains pipe syntax.
def typed_item_has_pipe_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_pipe_expr { true }
    else if item.surface.has_pipe_placeholder { true }
    else { item.surface.has_pipe_chain }

/// Create one pipe surface fact from an item skeleton.
def pipe_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[PipeSurfaceFact] =
    if typed_item_has_pipe_surface(item) {
        Some(PipeSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_pipe: item.surface.has_pipe_expr,
            has_placeholder: item.surface.has_pipe_placeholder,
            has_chain: item.surface.has_pipe_chain,
        })
    } else { None }

/// Generate pipe surface facts in stable binder order.
def pipe_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[PipeSurfaceFact]): Array[PipeSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match pipe_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => pipe_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => pipe_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Convert one pipe surface fact into a lowering obligation.
def pipe_lowering_obligation_from_surface(fact: PipeSurfaceFact): PipeLoweringObligation =
    PipeLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_placeholder_expansion: fact.has_placeholder,
        requires_receiver_first_desugar: fact.has_pipe,
        repeated_placeholder_lhs_is_single_eval: true,
    }

/// Convert pipe surface facts in stable owner order.
def pipe_lowering_obligations_from_surface(facts: Array[PipeSurfaceFact], index: usize, out: Vec[PipeLoweringObligation]): Array[PipeLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { pipe_lowering_obligations_from_surface(facts, index + 1, out.push(pipe_lowering_obligation_from_surface(facts.get(index)))) }

/// Return true when an item needs pattern lowering or exhaustiveness checking.
def typed_item_has_pattern_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_match_expr { true }
    else if item.surface.has_if_let_expr { true }
    else if item.surface.has_deep_pattern_surface { true }
    else if item.surface.has_pattern_params { true }
    else { item.surface.has_wildcard_let }

/// Create one pattern surface fact from an item skeleton.
def pattern_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[PatternSurfaceFact] =
    if typed_item_has_pattern_surface(item) {
        Some(PatternSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_match: item.surface.has_match_expr,
            has_if_let: item.surface.has_if_let_expr,
            has_deep_pattern: item.surface.has_deep_pattern_surface,
            has_pattern_params: item.surface.has_pattern_params,
            has_wildcard_let: item.surface.has_wildcard_let,
        })
    } else { None }

/// Generate pattern surface facts in stable binder order.
def pattern_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[PatternSurfaceFact]): Array[PatternSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match pattern_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => pattern_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => pattern_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Convert one pattern surface fact into lowering obligations.
def pattern_lowering_obligation_from_surface(fact: PatternSurfaceFact): PatternLoweringObligation =
    PatternLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_match_exhaustiveness: fact.has_match,
        requires_if_let_dual_env: fact.has_if_let,
        requires_deep_pattern_dft: fact.has_deep_pattern,
        requires_function_param_desugar: fact.has_pattern_params,
        wildcard_let_discards_value: fact.has_wildcard_let,
    }

/// Convert pattern surface facts in stable owner order.
def pattern_lowering_obligations_from_surface(facts: Array[PatternSurfaceFact], index: usize, out: Vec[PatternLoweringObligation]): Array[PatternLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { pattern_lowering_obligations_from_surface(facts, index + 1, out.push(pattern_lowering_obligation_from_surface(facts.get(index)))) }

/// Return true when an item mentions compiler-owned intrinsic or tuple bridge surface.
def typed_item_has_intrinsic_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_compiler_intrinsic_call { true }
    else { item.surface.has_tuple_type_surface }

/// Return true when one typed item region contains exact compiler intrinsic text.
def typed_item_region_has_intrinsic_text(project: ProjectSurface, item: TypedItemSkeleton, text: str): bool =
    let file_text = typed_source_file_text(project.files, item.file, 0)
    source_region_has_text(file_text, item.surface.header.offset, source_scan_item_region_end(file_text, item.surface.header.offset), text)

/// Create one intrinsic surface fact from an item skeleton.
def intrinsic_surface_fact_from_skeleton(project: ProjectSurface, item: TypedItemSkeleton): Option[IntrinsicSurfaceFact] =
    if typed_item_has_intrinsic_surface(item) {
        Some(IntrinsicSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_compiler_intrinsic_call: item.surface.has_compiler_intrinsic_call,
            has_tuple_type_surface: item.surface.has_tuple_type_surface,
            has_tuple_to_adt: typed_item_region_has_intrinsic_text(project, item, "tuple_to_adt["),
            has_adt_to_tuple: typed_item_region_has_intrinsic_text(project, item, "adt_to_tuple["),
            has_unsafe_cast: typed_item_region_has_intrinsic_text(project, item, "unsafe_cast["),
        })
    } else { None }

/// Generate intrinsic surface facts in stable binder order.
def intrinsic_surface_facts_from_skeletons(project: ProjectSurface, skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[IntrinsicSurfaceFact]): Array[IntrinsicSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match intrinsic_surface_fact_from_skeleton(project, skeletons.get(index)) {
            Some(fact) => intrinsic_surface_facts_from_skeletons(project, skeletons, index + 1, out.push(fact))
            None => intrinsic_surface_facts_from_skeletons(project, skeletons, index + 1, out)
        }
    }

/// Return tuple_to_adt identity when surface mentions that bridge.
def intrinsic_tuple_to_adt_identity(fact: IntrinsicSurfaceFact): Option[AdtTupleIntrinsicIdentity] =
    if fact.has_tuple_to_adt { Some(adt_tuple_intrinsic_identity(TupleToAdt)) }
    else { None }

/// Return adt_to_tuple identity when surface mentions that bridge.
def intrinsic_adt_to_tuple_identity(fact: IntrinsicSurfaceFact): Option[AdtTupleIntrinsicIdentity] =
    if fact.has_adt_to_tuple { Some(adt_tuple_intrinsic_identity(AdtToTuple)) }
    else { None }

/// Convert one intrinsic surface fact into a lowering obligation.
def intrinsic_lowering_obligation_from_surface(fact: IntrinsicSurfaceFact): IntrinsicLoweringObligation =
    IntrinsicLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        intrinsic_namespace: "compiler.intrinsic",
        tuple_to_adt_identity: intrinsic_tuple_to_adt_identity(fact),
        adt_to_tuple_identity: intrinsic_adt_to_tuple_identity(fact),
        requires_tuple_bridge: fact.has_tuple_type_surface,
        requires_method_first_bridge: fact.has_tuple_to_adt || fact.has_adt_to_tuple,
        unsafe_cast_is_compiler_only: fact.has_unsafe_cast,
        requires_compiler_intrinsic_resolution: fact.has_compiler_intrinsic_call,
    }

/// Convert intrinsic surface facts in stable owner order.
def intrinsic_lowering_obligations_from_surface(facts: Array[IntrinsicSurfaceFact], index: usize, out: Vec[IntrinsicLoweringObligation]): Array[IntrinsicLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { intrinsic_lowering_obligations_from_surface(facts, index + 1, out.push(intrinsic_lowering_obligation_from_surface(facts.get(index)))) }

/// Return true when an item needs generic/template checking.
def typed_item_has_generic_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_explicit_type_params { true }
    else if item.surface.has_auto_generic_params { true }
    else if item.surface.has_explicit_instantiation_call { true }
    else { item.surface.has_generic_self_method }

/// Create one generic surface fact from an item skeleton.
def generic_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[GenericSurfaceFact] =
    if typed_item_has_generic_surface(item) {
        Some(GenericSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_explicit_type_params: item.surface.has_explicit_type_params,
            has_auto_generic_params: item.surface.has_auto_generic_params,
            has_explicit_instantiation_call: item.surface.has_explicit_instantiation_call,
            has_generic_self_method: item.surface.has_generic_self_method,
        })
    } else { None }

/// Generate generic surface facts in stable binder order.
def generic_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[GenericSurfaceFact]): Array[GenericSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match generic_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => generic_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => generic_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Convert one generic surface fact into a template obligation.
def generic_template_obligation_from_surface(fact: GenericSurfaceFact): GenericTemplateObligation =
    GenericTemplateObligation {
        owner: fact.owner,
        file: fact.file,
        requires_explicit_param_binding: fact.has_explicit_type_params,
        requires_auto_generic_inference: fact.has_auto_generic_params,
        requires_instantiation_discharge: fact.has_explicit_instantiation_call,
        requires_generic_self_receiver_binding: fact.has_generic_self_method,
    }

/// Convert generic surface facts in stable owner order.
def generic_template_obligations_from_surface(facts: Array[GenericSurfaceFact], index: usize, out: Vec[GenericTemplateObligation]): Array[GenericTemplateObligation] =
    if index == facts.len() { out.freeze() }
    else { generic_template_obligations_from_surface(facts, index + 1, out.push(generic_template_obligation_from_surface(facts.get(index)))) }

/// Return true when an item uses operator overload surface.
def typed_item_has_operator_use_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_infix_operator_expr { true }
    else if item.surface.has_operator_obligation_surface { true }
    else if item.surface.has_index_expr { true }
    else { item.surface.has_index_slice_expr }

/// Create one operator use surface fact from an item skeleton.
def operator_use_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[OperatorUseSurfaceFact] =
    if typed_item_has_operator_use_surface(item) {
        Some(OperatorUseSurfaceFact {
            owner: item.binder,
            file: item.file,
            operator_kind: item.surface.operator_use_kind,
            has_infix_operator: item.surface.has_infix_operator_expr,
            has_operator_obligation: item.surface.has_operator_obligation_surface,
            has_index: item.surface.has_index_expr,
            has_index_slice: item.surface.has_index_slice_expr,
        })
    } else { None }

/// Generate operator use surface facts in stable binder order.
def operator_use_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[OperatorUseSurfaceFact]): Array[OperatorUseSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match operator_use_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => operator_use_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => operator_use_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when an item contains closure/lambda surface.
def typed_item_has_closure_surface(item: TypedItemSkeleton): bool =
    if item.surface.has_lambda_expr { true }
    else { item.surface.has_trailing_closure_expr }

/// Create one closure surface fact from an item skeleton.
def closure_surface_fact_from_skeleton(item: TypedItemSkeleton): Option[ClosureSurfaceFact] =
    if typed_item_has_closure_surface(item) {
        Some(ClosureSurfaceFact {
            owner: item.binder,
            file: item.file,
            has_lambda: item.surface.has_lambda_expr,
            has_trailing_closure: item.surface.has_trailing_closure_expr,
            syntactic_no_capture: item.surface.has_let_binding == false && item.surface.has_ref_type == false && item.surface.has_global_value_dependency == false,
        })
    } else { None }

/// Generate closure surface facts in stable binder order.
def closure_surface_facts_from_skeletons(skeletons: Array[TypedItemSkeleton], index: usize, out: Vec[ClosureSurfaceFact]): Array[ClosureSurfaceFact] =
    if index == skeletons.len() { out.freeze() }
    else {
        match closure_surface_fact_from_skeleton(skeletons.get(index)) {
            Some(fact) => closure_surface_facts_from_skeletons(skeletons, index + 1, out.push(fact))
            None => closure_surface_facts_from_skeletons(skeletons, index + 1, out)
        }
    }

/// Return true when closure/lambda surfaces are syntactically capture-free.
def closure_surface_all_syntactic_no_capture(facts: Array[ClosureSurfaceFact], index: usize): bool =
    if index == facts.len() { true }
    else if facts.get(index).syntactic_no_capture { closure_surface_all_syntactic_no_capture(facts, index + 1) }
    else { false }

/// Return true when item surfaces mention method-style receiver definitions.
def typed_item_skeletons_have_method_receiver_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_method_receiver { true }
        else if surface.has_operator_method { true }
        else { typed_item_skeletons_have_method_receiver_surface(skeletons, index + 1) }
    }

/// Return true when method receiver scope must bind `Self` with owner generics.
def typed_item_skeletons_have_generic_self_method_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_generic_self_method { true }
        else { typed_item_skeletons_have_generic_self_method_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention pattern parameters.
def typed_item_skeletons_have_pattern_param_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_pattern_params { true }
        else { typed_item_skeletons_have_pattern_param_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention explicit generic parameters.
def typed_item_skeletons_have_explicit_type_params(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if skeletons.get(index).surface.has_explicit_type_params { true }
        else { typed_item_skeletons_have_explicit_type_params(skeletons, index + 1) }
    }

/// Return true when generic inference or instantiation syntax needs checking.
def typed_item_skeletons_have_generic_instantiation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_auto_generic_params { true }
        else if surface.has_explicit_instantiation_call { true }
        else { typed_item_skeletons_have_generic_instantiation_surface(skeletons, index + 1) }
    }

/// Return true when local bindings need scope graph and shadow analysis.
def typed_item_skeletons_have_scope_shadow_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_let_binding { true }
        else if surface.has_wildcard_let { true }
        else if surface.has_scope_shadow_candidate { true }
        else { typed_item_skeletons_have_scope_shadow_surface(skeletons, index + 1) }
    }

/// Return true when owner namespaces must be resolved into stable symbols.
def typed_item_skeletons_have_namespace_ownership_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        match skeletons.get(index).owner_namespace {
            Some(_) => true
            None => typed_item_skeletons_have_namespace_ownership_surface(skeletons, index + 1)
        }
    }

/// Return true when item surfaces mention compiler-owned intrinsic or tuple surface.
def typed_item_skeletons_have_compiler_intrinsic_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_intrinsic_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_compiler_intrinsic_surface(skeletons, index + 1) }
    }

/// Return true when static globals need init order or cycle analysis.
def typed_item_skeletons_have_global_init_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_global_init_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_global_init_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need pipe lowering before type inference.
def typed_item_skeletons_have_pipe_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        if typed_item_has_pipe_surface(skeletons.get(index)) { true }
        else { typed_item_skeletons_have_pipe_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need match/if-let pattern lowering before inference.
def typed_item_skeletons_have_deep_pattern_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let item = skeletons.get(index)
        if item.surface.has_match_expr { true }
        else if item.surface.has_if_let_expr { true }
        else if item.surface.has_deep_pattern_surface { true }
        else { typed_item_skeletons_have_deep_pattern_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need string interpolation/slice lowering.
def typed_item_skeletons_have_string_slice_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_string_interpolation { true }
        else if surface.has_string_slice_surface { true }
        else if surface.has_char_at_surface { true }
        else { typed_item_skeletons_have_string_slice_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need index operator dispatch lowering.
def typed_item_skeletons_have_index_operator_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_index_expr { true }
        else if surface.has_index_slice_expr { true }
        else { typed_item_skeletons_have_index_operator_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need operator obligation resolution.
def typed_item_skeletons_have_operator_obligation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let item = skeletons.get(index)
        if item.surface.has_infix_operator_expr { true }
        else if item.surface.has_operator_obligation_surface { true }
        else { typed_item_skeletons_have_operator_obligation_surface(skeletons, index + 1) }
    }

/// Infer HM + row types for an alpha-renamed module.
def infer_types(module: AlphaModule, patterns: PatternFacts): Result[TypedModule, SemanticDiagnostics] =
    let skeletons = typed_item_skeletons_from_alpha(module.origins, 0, Vec[TypedItemSkeleton].new())
    let callable_storage = callable_storage_facts_from_skeletons(skeletons, 0, Vec[CallableStorageFact].new())
    let namespace_ownership = namespace_ownership_facts_from_skeletons(skeletons, 0, Vec[NamespaceOwnershipFact].new())
    let namespace_imports = namespace_import_facts_from_uses(module.uses, 0, Vec[NamespaceImportFact].new())
    let method_surface = method_surface_facts_from_skeletons(skeletons, 0, Vec[MethodSurfaceFact].new())
    let branching_surface = branching_surface_facts_from_skeletons(skeletons, 0, Vec[BranchingSurfaceFact].new())
    let control_surface = control_surface_facts_from_skeletons(skeletons, 0, Vec[ControlSurfaceFact].new())
    let global_init_surface = global_init_surface_facts_from_skeletons(skeletons, 0, Vec[GlobalInitSurfaceFact].new())
    let global_init_obligations = global_init_obligations_from_surface(global_init_surface, 0, Vec[GlobalInitObligation].new())
    let pipe_surface = pipe_surface_facts_from_skeletons(skeletons, 0, Vec[PipeSurfaceFact].new())
    let pipe_lowering_obligations = pipe_lowering_obligations_from_surface(pipe_surface, 0, Vec[PipeLoweringObligation].new())
    let pattern_surface = pattern_surface_facts_from_skeletons(skeletons, 0, Vec[PatternSurfaceFact].new())
    let pattern_lowering_obligations = pattern_lowering_obligations_from_surface(pattern_surface, 0, Vec[PatternLoweringObligation].new())
    let intrinsic_surface = intrinsic_surface_facts_from_skeletons(module.project, skeletons, 0, Vec[IntrinsicSurfaceFact].new())
    let intrinsic_lowering_obligations = intrinsic_lowering_obligations_from_surface(intrinsic_surface, 0, Vec[IntrinsicLoweringObligation].new())
    let generic_surface = generic_surface_facts_from_skeletons(skeletons, 0, Vec[GenericSurfaceFact].new())
    let generic_template_obligations = generic_template_obligations_from_surface(generic_surface, 0, Vec[GenericTemplateObligation].new())
    let operator_use_surface = operator_use_surface_facts_from_skeletons(skeletons, 0, Vec[OperatorUseSurfaceFact].new())
    let closure_surface = closure_surface_facts_from_skeletons(skeletons, 0, Vec[ClosureSurfaceFact].new())
    let functions = typed_function_facts_from_skeletons(module.project, skeletons, 0, Vec[TypedFunctionFact].new())
    let adt_ctors = typed_adt_ctors_from_skeletons(module.project, skeletons, 0, Vec[LoweredAdtCtor].new())
    if skeletons.len() == 0 {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: typed item skeletons absent"))
            .freeze()))
    } else if type_inference_has_pattern_coverage(skeletons, patterns) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pattern coverage for typed item skeletons absent"))
            .freeze()))
    } else if typed_function_symbols_unique(functions, 0) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "invalid-surface: duplicate function symbol"))
            .freeze()))
    } else if typed_function_main_abi_valid(functions, 0) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "invalid-surface: exported main cannot take i32 params in current ABI slice"))
            .freeze()))
    } else if typed_function_tail_targets_resolved(functions, 0) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: namespace-aware typed callee resolution absent"))
            .freeze()))
    } else if functions.len() > 0 || skeletons.len() > 0 {
        Ok(typed_module_from_skeletons(module, skeletons, functions, adt_ctors, callable_storage, namespace_ownership, namespace_imports, method_surface, branching_surface, control_surface, global_init_surface, pipe_surface, pattern_surface, patterns, intrinsic_surface, generic_surface, operator_use_surface, closure_surface))
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: source item type expression and body inference absent"))
            .freeze()))
    }

/// Build the typed module fact surface shared by later semantic passes.
def typed_module_from_skeletons(module: AlphaModule, skeletons: Array[TypedItemSkeleton], functions: Array[TypedFunctionFact], adt_ctors: Array[LoweredAdtCtor], callable_storage: Array[CallableStorageFact], namespace_ownership: Array[NamespaceOwnershipFact], namespace_imports: Array[NamespaceImportFact], method_surface: Array[MethodSurfaceFact], branching_surface: Array[BranchingSurfaceFact], control_surface: Array[ControlSurfaceFact], global_init_surface: Array[GlobalInitSurfaceFact], pipe_surface: Array[PipeSurfaceFact], pattern_surface: Array[PatternSurfaceFact], patterns: PatternFacts, intrinsic_surface: Array[IntrinsicSurfaceFact], generic_surface: Array[GenericSurfaceFact], operator_use_surface: Array[OperatorUseSurfaceFact], closure_surface: Array[ClosureSurfaceFact]): TypedModule =
    TypedModule {
        alpha: module,
        items: skeletons,
        functions: functions,
        adt_ctors: adt_ctors,
        callable_storage: callable_storage,
        namespace_ownership: namespace_ownership,
        namespace_imports: namespace_imports,
        method_surface: method_surface,
        branching_surface: branching_surface,
        control_surface: control_surface,
        global_init_surface: global_init_surface,
        pipe_surface: pipe_surface,
        pattern_surface: pattern_surface,
        pattern_dft_steps: patterns.dft_steps,
        pattern_exhaustiveness: patterns.exhaustiveness,
        pattern_envs: patterns.envs,
        intrinsic_surface: intrinsic_surface,
        generic_surface: generic_surface,
        operator_use_surface: operator_use_surface,
        closure_surface: closure_surface,
        method_operator_index: method_operator_index_empty(),
    }

/// Run the level-2 semantic checks that require inferred types.
def check_l2_types(module: TypedModule): Result[TypedModule, SemanticDiagnostics] =
    if module.items.len() == 0 {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: L2 typed item facts absent"))
            .freeze()))
    } else { Ok(module) }

/// Historical diagnostics kept stable for tooling while primary lowering now continues with facts.
