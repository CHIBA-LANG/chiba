/// HM + row inference driver.
namespace compiler.semantic.type_infer

use compiler.source.project.*
use compiler.semantic.alpha.*
use compiler.semantic.pattern.*
use compiler.semantic.types.*

/// Coarse typed item category before full item lowering.
data TypedItemSkeletonKind {
    TypedItemFunction,
    TypedItemStaticValue,
    TypedItemExternFunction,
    TypedItemNominalType,
    TypedItemData,
    TypedItemUnion,
    TypedItemInterface,
}

/// Source item skeleton ready for real type-expression and body inference.
type TypedItemSkeleton {
    binder: BinderId,
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    skeleton_kind: TypedItemSkeletonKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Classify a scanned source item into the first typed-lowering bucket.
def classify_typed_item_skeleton_kind(item: AlphaBinderOrigin): TypedItemSkeletonKind =
    match item.kind {
        SourceItemDef => {
            if item.surface.has_params { TypedItemFunction }
            else { TypedItemStaticValue }
        }
        SourceItemExtern => TypedItemExternFunction
        SourceItemType => TypedItemNominalType
        SourceItemData => TypedItemData
        SourceItemUnion => TypedItemUnion
        SourceItemInterface => TypedItemInterface
    }

/// Build source item skeletons from alpha origins before HM + row inference.
def typed_item_skeletons_from_alpha(origins: Array[AlphaBinderOrigin], index: usize, out: Vec[TypedItemSkeleton]): Array[TypedItemSkeleton] =
    if index == origins.len() { out.freeze() }
    else {
        let origin = origins.get(index)
        typed_item_skeletons_from_alpha(
            origins,
            index + 1,
            out.push(TypedItemSkeleton {
                binder: origin.binder,
                file: origin.file,
                owner_namespace: origin.owner_namespace,
                kind: origin.kind,
                skeleton_kind: classify_typed_item_skeleton_kind(origin),
                name: origin.name,
                private: origin.private,
                attributes: origin.attributes,
                surface: origin.surface,
                line: origin.line,
                column: origin.column,
            }))
    }

/// Return true when placeholder pattern facts cover all source item skeletons.
def type_inference_has_pattern_coverage(skeletons: Array[TypedItemSkeleton], patterns: PatternFacts): bool =
    patterns.patterns.len() >= skeletons.len()

/// Return true when item surfaces mention callable or explicit continuation storage types.
def typed_item_skeletons_have_callable_storage_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_callable_arrow { true }
        else if surface.has_explicit_continuation_type { true }
        else { typed_item_skeletons_have_callable_storage_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention method-style receiver definitions.
def typed_item_skeletons_have_method_receiver_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_method_receiver { true }
        else if surface.has_operator_method { true }
        else { typed_item_skeletons_have_method_receiver_surface(skeletons, index + 1) }
    }

/// Return true when method receiver scope must bind `Self` with owner generics.
def typed_item_skeletons_have_generic_self_method_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_generic_self_method { true }
        else { typed_item_skeletons_have_generic_self_method_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention pattern parameters.
def typed_item_skeletons_have_pattern_param_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_pattern_params { true }
        else { typed_item_skeletons_have_pattern_param_surface(skeletons, index + 1) }
    }

/// Return true when item surfaces mention explicit generic parameters.
def typed_item_skeletons_have_explicit_type_params(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_explicit_type_params { true }
        else { typed_item_skeletons_have_explicit_type_params(skeletons, index + 1) }
    }

/// Return true when generic inference or instantiation syntax needs checking.
def typed_item_skeletons_have_generic_instantiation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_auto_generic_params { true }
        else if surface.has_explicit_instantiation_call { true }
        else { typed_item_skeletons_have_generic_instantiation_surface(skeletons, index + 1) }
    }

/// Return true when local bindings need scope graph and shadow analysis.
def typed_item_skeletons_have_scope_shadow_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_let_binding { true }
        else if surface.has_wildcard_let { true }
        else if surface.has_scope_shadow_candidate { true }
        else { typed_item_skeletons_have_scope_shadow_surface(skeletons, index + 1) }
    }

/// Return true when owner namespaces must be resolved into stable symbols.
def typed_item_skeletons_have_namespace_ownership_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        match skeletons.get(index).owner_namespace {
            Some(_) => true
            None => typed_item_skeletons_have_namespace_ownership_surface(skeletons, index + 1)
        }
    }

/// Return true when item surfaces mention compiler-owned intrinsic or tuple surface.
def typed_item_skeletons_have_compiler_intrinsic_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_compiler_intrinsic_call { true }
        else if surface.has_tuple_type_surface { true }
        else { typed_item_skeletons_have_compiler_intrinsic_surface(skeletons, index + 1) }
    }

/// Return true when static globals need init order or cycle analysis.
def typed_item_skeletons_have_global_init_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let item = skeletons.get(index)
        if item.surface.has_global_value_initializer { true }
        else if item.surface.has_global_value_dependency { true }
        else { typed_item_skeletons_have_global_init_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need pipe lowering before type inference.
def typed_item_skeletons_have_pipe_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_pipe_expr { true }
        else if surface.has_pipe_placeholder { true }
        else if surface.has_pipe_chain { true }
        else { typed_item_skeletons_have_pipe_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need match/if-let pattern lowering before inference.
def typed_item_skeletons_have_deep_pattern_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_match_expr { true }
        else if surface.has_if_let_expr { true }
        else if surface.has_deep_pattern_surface { true }
        else { typed_item_skeletons_have_deep_pattern_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need string interpolation/slice lowering.
def typed_item_skeletons_have_string_slice_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_string_interpolation { true }
        else if surface.has_string_slice_surface { true }
        else if surface.has_char_at_surface { true }
        else { typed_item_skeletons_have_string_slice_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need index operator dispatch lowering.
def typed_item_skeletons_have_index_operator_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_index_expr { true }
        else if surface.has_index_slice_expr { true }
        else { typed_item_skeletons_have_index_operator_surface(skeletons, index + 1) }
    }

/// Return true when item bodies need operator obligation resolution.
def typed_item_skeletons_have_operator_obligation_surface(skeletons: Array[TypedItemSkeleton], index: usize): bool =
    if index == skeletons.len() { false }
    else {
        let surface = skeletons.get(index).surface
        if surface.has_infix_operator_expr { true }
        else if surface.has_operator_obligation_surface { true }
        else { typed_item_skeletons_have_operator_obligation_surface(skeletons, index + 1) }
    }

/// Infer HM + row types for an alpha-renamed module.
def infer_types(module: AlphaModule, patterns: PatternFacts): Result[TypedModule, SemanticDiagnostics] =
    let skeletons = typed_item_skeletons_from_alpha(module.origins, 0, Vec[TypedItemSkeleton].new())
    if skeletons.len() == 0 {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: typed item skeletons absent"))
            .freeze()))
    } else if type_inference_has_pattern_coverage(skeletons, patterns) == false {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: pattern coverage for typed item skeletons absent"))
            .freeze()))
    } else if typed_item_skeletons_have_compiler_intrinsic_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: compiler intrinsic surface lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_global_init_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: global initialization dependency and cycle analysis absent"))
            .freeze()))
    } else if typed_item_skeletons_have_pipe_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: pipe placeholder and receiver-first desugaring absent"))
            .freeze()))
    } else if typed_item_skeletons_have_deep_pattern_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: deep pattern match and if-let lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_string_slice_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: string interpolation and slice lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_index_operator_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: index operator dispatch lowering absent"))
            .freeze()))
    } else if typed_item_skeletons_have_operator_obligation_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: operator obligation resolution absent"))
            .freeze()))
    } else if typed_item_skeletons_have_callable_storage_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: callable storage fact generation absent"))
            .freeze()))
    } else if typed_item_skeletons_have_generic_self_method_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: generic method Self receiver binding absent"))
            .freeze()))
    } else if typed_item_skeletons_have_method_receiver_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: method receiver Self binding absent"))
            .freeze()))
    } else if typed_item_skeletons_have_pattern_param_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: function pattern parameter desugaring absent"))
            .freeze()))
    } else if typed_item_skeletons_have_generic_instantiation_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: auto-generic and explicit instantiation checking absent"))
            .freeze()))
    } else if typed_item_skeletons_have_scope_shadow_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: local scope graph and shadowing analysis absent"))
            .freeze()))
    } else if typed_item_skeletons_have_namespace_ownership_surface(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: namespace ownership resolution absent"))
            .freeze()))
    } else if typed_item_skeletons_have_explicit_type_params(skeletons, 0) {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: explicit generic parameter binding absent"))
            .freeze()))
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: source item type expression and body inference absent"))
            .freeze()))
    }

/// Run the level-2 semantic checks that require inferred types.
def check_l2_types(module: TypedModule): Result[TypedModule, SemanticDiagnostics] =
    Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
        .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-lowering: level-2 typed semantic checks absent"))
        .freeze()))
