/// ADT constructor and tuple-view lowering after type and exhaustiveness checks.
namespace compiler.semantic.adt_tuple_lowering

use compiler.semantic.types.*
use compiler.semantic.type_record.*
use compiler.ir.control.*

/// Canonical symbol tag assigned to one ADT constructor.
type AdtVariantTag {
    symbol: str,
}

/// Typed ADT variant declaration after constructor resolution.
type AdtVariantDecl {
    data_type: NominalId,
    ctor_name: str,
    tag: AdtVariantTag,
    payload: Array[SemType],
}

/// Tuple representation of one ADT variant value.
type AdtTupleShape {
    tag: AdtVariantTag,
    payload: Array[SemType],
}

/// Role of one field in the canonical tuple view.
data AdtTupleFieldRole {
    AdtTupleTagField,
    AdtTuplePayloadField,
}

/// Canonical tuple field produced by constructor lowering.
type AdtTupleField {
    position: usize,
    name: RowFieldId,
    ty: SemType,
    role: AdtTupleFieldRole,
}

/// Backend-neutral constructor helper body contract.
type AdtCtorHelperBody {
    tag_literal: AdtVariantTag,
    parameter_count: usize,
    tuple_fields: Array[AdtTupleField],
    returns_canonical_tuple: bool,
}

/// Lowered constructor helper used before row/record lowering.
type LoweredAdtCtor {
    source: AdtVariantDecl,
    tuple_shape: AdtTupleShape,
    helper_name: str,
    helper_arity: usize,
    tuple_fields: Array[AdtTupleField],
    tuple_record_shape: AggregateShape,
    body: AdtCtorHelperBody,
}

/// Constructor lowering strategy after usage analysis.
data ConstructorLoweringStrategy {
    ConstructorAllocateValue,
    ConstructorMutateOnceUsedInput,
}

/// Usage-sensitive constructor lowering obligation.
type ConstructorMutationObligation {
    ctor: AdtVariantDecl,
    input: SemType,
    use_count: UseCount,
    strategy: ConstructorLoweringStrategy,
}

/// Direction of checked ADT/tuple conversion.
data AdtTupleConversionKind {
    AdtToTuple
    TupleToAdt
}

/// Compiler-owned identity of one ADT tuple bridge intrinsic.
type AdtTupleIntrinsicIdentity {
    intrinsic_namespace: str,
    source_name: str,
}

/// Checked conversion fact produced only after type and exhaustiveness checks.
type AdtTupleConversion {
    kind: AdtTupleConversionKind,
    adt_type: SemType,
    tuple_type: SemType,
    intrinsic: AdtTupleIntrinsicIdentity,
}

/// Build the canonical tuple shape for one variant.
def AdtVariantDecl.tuple_shape(self): AdtTupleShape =
    AdtTupleShape { tag: self.canonical_tag(), payload: self.payload }

/// Return one decimal digit as source text.
def adt_decimal_digit_text(digit: usize): str =
    if digit == 0 { "0" }
    else if digit < 2 { "1" }
    else if digit == 2 { "2" }
    else if digit == 3 { "3" }
    else if digit == 4 { "4" }
    else if digit == 5 { "5" }
    else if digit == 6 { "6" }
    else if digit == 7 { "7" }
    else if digit == 8 { "8" }
    else { "9" }

/// Convert a usize to decimal source text.
def adt_usize_decimal_text(value: usize): str =
    if value < 10 { adt_decimal_digit_text(value) }
    else { adt_usize_decimal_text(value / 10).concat(adt_decimal_digit_text(value % 10)) }

/// Canonical tuple field name: `_1`, `_2`, ...
def adt_tuple_field_name(position: usize): RowFieldId =
    RowFieldId { name: "_".concat(adt_usize_decimal_text(position)) }

/// Return true for ASCII uppercase constructor bytes.
def adt_ctor_byte_is_upper(byte: u8): bool = byte >= 65 && byte <= 90

/// Return true for ASCII lowercase constructor bytes.
def adt_ctor_byte_is_lower(byte: u8): bool = byte >= 97 && byte <= 122

/// Return true for ASCII digit constructor bytes.
def adt_ctor_byte_is_digit(byte: u8): bool = byte >= 48 && byte <= 57

/// Return true when byte continues one lowercase word segment.
def adt_ctor_byte_is_word_tail(byte: u8): bool =
    if adt_ctor_byte_is_lower(byte) { true }
    else { adt_ctor_byte_is_digit(byte) }

/// Lowercase one ASCII identifier byte as source text.
def adt_ctor_byte_lower_text(byte: u8): str =
    if byte == 65 || byte == 97 { "a" }
    else if byte == 66 || byte == 98 { "b" }
    else if byte == 67 || byte == 99 { "c" }
    else if byte == 68 || byte == 100 { "d" }
    else if byte == 69 || byte == 101 { "e" }
    else if byte == 70 || byte == 102 { "f" }
    else if byte == 71 || byte == 103 { "g" }
    else if byte == 72 || byte == 104 { "h" }
    else if byte == 73 || byte == 105 { "i" }
    else if byte == 74 || byte == 106 { "j" }
    else if byte == 75 || byte == 107 { "k" }
    else if byte == 76 || byte == 108 { "l" }
    else if byte == 77 || byte == 109 { "m" }
    else if byte == 78 || byte == 110 { "n" }
    else if byte == 79 || byte == 111 { "o" }
    else if byte == 80 || byte == 112 { "p" }
    else if byte == 81 || byte == 113 { "q" }
    else if byte == 82 || byte == 114 { "r" }
    else if byte == 83 || byte == 115 { "s" }
    else if byte == 84 || byte == 116 { "t" }
    else if byte == 85 || byte == 117 { "u" }
    else if byte == 86 || byte == 118 { "v" }
    else if byte == 87 || byte == 119 { "w" }
    else if byte == 88 || byte == 120 { "x" }
    else if byte == 89 || byte == 121 { "y" }
    else if byte == 90 || byte == 122 { "z" }
    else if byte == 48 { "0" }
    else if byte == 49 { "1" }
    else if byte == 50 { "2" }
    else if byte == 51 { "3" }
    else if byte == 52 { "4" }
    else if byte == 53 { "5" }
    else if byte == 54 { "6" }
    else if byte == 55 { "7" }
    else if byte == 56 { "8" }
    else if byte == 57 { "9" }
    else { "_" }

/// Convert BigCamel constructor names to canonical snake_case tag names.
def adt_ctor_snake_loop(name: str, index: usize, out: str, prev_tail: bool): str =
    if index == name.len() { out }
    else {
        let byte = name.byte_at(index)
        let needs_sep = index > 0 && adt_ctor_byte_is_upper(byte) && prev_tail
        let prefix = if needs_sep { out.concat("_") } else { out }
        adt_ctor_snake_loop(name, index + 1, prefix.concat(adt_ctor_byte_lower_text(byte)), adt_ctor_byte_is_word_tail(byte))
    }

/// Convert constructor name to canonical symbol tag, e.g. `HttpError` -> `:http_error`.
def adt_ctor_symbol_from_name(name: str): str =
    ":".concat(adt_ctor_snake_loop(name, 0, "", false))

/// Canonical symbol tag derived from constructor source name.
def AdtVariantDecl.canonical_tag(self): AdtVariantTag =
    AdtVariantTag { symbol: adt_ctor_symbol_from_name(self.ctor_name) }

/// Build the synthetic constructor helper name.
def AdtVariantDecl.helper_name(self): str = "__ADT_CTOR_".concat(self.ctor_name)

/// Semantic type of canonical constructor symbol tags.
def adt_symbol_type(): SemType =
    TyNominal(NominalId { namespace_name: "std", name: "Symbol" })

/// Build tuple field facts for constructor payloads; `_1` is always the symbol tag.
def adt_tuple_fields_from_payload(payload: Array[SemType], index: usize, out: Vec[AdtTupleField]): Array[AdtTupleField] =
    if index == payload.len() { out.freeze() }
    else {
        let position = index + 2
        adt_tuple_fields_from_payload(payload, index + 1, out.push(AdtTupleField {
            position: position,
            name: adt_tuple_field_name(position),
            ty: payload.get(index),
            role: AdtTuplePayloadField,
        }))
    }

/// Build canonical tuple fields for one ADT constructor.
def adt_tuple_fields_for_variant(variant: AdtVariantDecl): Array[AdtTupleField] =
    adt_tuple_fields_from_payload(variant.payload, 0, Vec[AdtTupleField].new().push(AdtTupleField {
        position: 1,
        name: adt_tuple_field_name(1),
        ty: adt_symbol_type(),
        role: AdtTupleTagField,
    }))

/// Convert tuple field facts to row aggregate fields for later row/record lowering.
def adt_tuple_fields_to_aggregate_fields(fields: Array[AdtTupleField], index: usize, out: Vec[AggregateField]): Array[AggregateField] =
    if index == fields.len() { out.freeze() }
    else {
        let field = fields.get(index)
        adt_tuple_fields_to_aggregate_fields(fields, index + 1, out.push(AggregateField { name: field.name, ty: field.ty }))
    }

/// Build row-backed tuple shape; `_1` is the canonical symbol tag field.
def adt_tuple_record_shape(fields: Array[AdtTupleField]): AggregateShape =
    build_aggregate_shape(AggregateTuple, adt_tuple_fields_to_aggregate_fields(fields, 0, Vec[AggregateField].new()))

/// Lower one checked constructor to a tuple-producing helper.
def lower_adt_ctor(variant: AdtVariantDecl): LoweredAdtCtor =
    let tuple_fields = adt_tuple_fields_for_variant(variant)
    let tuple_shape = variant.tuple_shape()
    LoweredAdtCtor {
        source: variant,
        tuple_shape: tuple_shape,
        helper_name: variant.helper_name(),
        helper_arity: variant.payload.len(),
        tuple_fields: tuple_fields,
        tuple_record_shape: adt_tuple_record_shape(tuple_fields),
        body: AdtCtorHelperBody {
            tag_literal: tuple_shape.tag,
            parameter_count: variant.payload.len(),
            tuple_fields: tuple_fields,
            returns_canonical_tuple: true,
        },
    }

/// Lower constructors in deterministic variant order.
def lower_adt_ctors(variants: Array[AdtVariantDecl], index: usize, out: Vec[LoweredAdtCtor]): Array[LoweredAdtCtor] =
    if index == variants.len() { out.freeze() }
    else { lower_adt_ctors(variants, index + 1, out.push(lower_adt_ctor(variants.get(index)))) }

/// Return the compiler intrinsic identity for a checked bridge direction.
def adt_tuple_intrinsic_identity(kind: AdtTupleConversionKind): AdtTupleIntrinsicIdentity =
    match kind {
        AdtToTuple => AdtTupleIntrinsicIdentity { intrinsic_namespace: "compiler.intrinsic", source_name: "adt_to_tuple" }
        TupleToAdt => AdtTupleIntrinsicIdentity { intrinsic_namespace: "compiler.intrinsic", source_name: "tuple_to_adt" }
    }

/// Choose mutation lowering when a constructor input is proven exactly once-used.
def constructor_strategy_for_use(used_once: bool): ConstructorLoweringStrategy =
    if used_once { ConstructorMutateOnceUsedInput }
    else { ConstructorAllocateValue }

/// Choose constructor strategy from usage facts.
def constructor_strategy_for_use_count(use_count: UseCount): ConstructorLoweringStrategy =
    match use_count {
        UseOne => ConstructorMutateOnceUsedInput
        _ => ConstructorAllocateValue
    }

/// Build the constructor mutation obligation from real usage count facts.
def constructor_mutation_obligation_from_use(ctor: AdtVariantDecl, input: SemType, use_count: UseCount): ConstructorMutationObligation =
    ConstructorMutationObligation {
        ctor: ctor,
        input: input,
        use_count: use_count,
        strategy: constructor_strategy_for_use_count(use_count),
    }

/// Build the constructor mutation obligation after type and usage facts exist.
def constructor_mutation_obligation(ctor: AdtVariantDecl, input: SemType, used_once: bool): ConstructorMutationObligation =
    ConstructorMutationObligation {
        ctor: ctor,
        input: input,
        use_count: if used_once { UseOne } else { UseMany },
        strategy: constructor_strategy_for_use(used_once),
    }

/// Return true when the conversion may be emitted.
def AdtTupleConversion.checked(self): bool =
    match self.kind {
        AdtToTuple => true
        TupleToAdt => true
    }
