/// Record, tuple, data, and union type rules over canonical rows.
namespace compiler.semantic.type_record

use compiler.semantic.types.*
use compiler.semantic.type_row.*

/// Aggregate kind whose layout is backed by row facts.
data AggregateKind {
    AggregateRecord,
    AggregateTuple,
    AggregateDataPayload,
    AggregateUnion,
}

/// Aggregate field declaration.
type AggregateField {
    name: RowFieldId,
    ty: SemType,
}

/// Aggregate shape after canonicalization.
type AggregateShape {
    kind: AggregateKind,
    row: CanonicalRow,
}

/// Canonical identity for an anonymous tuple backend nominal.
type TupleNominalIdentity {
    tuple_key: str,
    nominal: NominalId,
}

/// Return one decimal digit as source text.
def record_decimal_digit_text(digit: usize): str =
    if digit == 0 { "0" }
    else if digit < 2 { "1" }
    else if digit == 2 { "2" }
    else if digit == 3 { "3" }
    else if digit == 4 { "4" }
    else if digit == 5 { "5" }
    else if digit == 6 { "6" }
    else if digit == 7 { "7" }
    else if digit == 8 { "8" }
    else { "9" }

/// Convert a usize to decimal source text.
def record_usize_decimal_text(value: usize): str =
    if value < 10 { record_decimal_digit_text(value) }
    else { record_usize_decimal_text(value / 10).concat(record_decimal_digit_text(value % 10)) }

/// Stable type key fragment for an optional type variable.
def semantic_type_var_tail_key(tail: Option[TypeVar]): str =
    match tail {
        None => "none"
        Some(var) => "var".concat(record_usize_decimal_text(var.index))
    }

/// Stable type key for row field ids.
def semantic_row_field_key(fields: Array[RowFieldId], index: usize, out: str): str =
    if index == fields.len() { out }
    else {
        let sep = if index == 0 { "" } else { "," }
        semantic_row_field_key(fields, index + 1, out.concat(sep).concat(fields.get(index).name))
    }

/// Stable type key for type arrays in source order.
def semantic_type_array_key(items: Array[SemType], index: usize, out: str): str =
    if index == items.len() { out }
    else {
        let sep = if index == 0 { "" } else { "," }
        semantic_type_array_key(items, index + 1, out.concat(sep).concat(semantic_type_key(items.get(index))))
    }

/// Stable semantic type key used by tuple nominal identity.
def semantic_type_key(ty: SemType): str =
    match ty {
        TyVar(var) => "var(".concat(record_usize_decimal_text(var.index)).concat(")")
        TyNominal(id) => "nominal(".concat(id.namespace_name).concat("::").concat(id.name).concat(")")
        TyFunction(params, ret) => "fn(".concat(semantic_type_array_key(params, 0, "")).concat(")->").concat(semantic_type_key(ret))
        TyRow(fields, tail) => "row(".concat(semantic_row_field_key(fields, 0, "")).concat("|").concat(semantic_type_var_tail_key(tail)).concat(")")
        TyArray(inner) => "array(".concat(semantic_type_key(inner)).concat(")")
        TySlice(inner) => "slice(".concat(semantic_type_key(inner)).concat(")")
        TyRef(inner) => "ref(".concat(semantic_type_key(inner)).concat(")")
        TyUnsafeRef(inner) => "unsafe_ref(".concat(semantic_type_key(inner)).concat(")")
        TyPtr(inner) => "ptr(".concat(semantic_type_key(inner)).concat(")")
        TyAtomic(inner) => "atomic(".concat(semantic_type_key(inner)).concat(")")
    }

/// Ordered element type-key sequence for tuple element types.
def tuple_type_key_sequence(types: Array[SemType], index: usize, out: str): str =
    if index == types.len() { out }
    else {
        let sep = if index == 0 { "" } else { "," }
        tuple_type_key_sequence(types, index + 1, out.concat(sep).concat(semantic_type_key(types.get(index))))
    }

/// Canonical tuple key shared by ordinary tuples and ADT tuple bridge values.
def tuple_key_from_types(types: Array[SemType]): str =
    "tuple(".concat(tuple_type_key_sequence(types, 0, "")).concat(")")

/// Canonical anonymous backend nominal derived only from ordered element types.
def tuple_nominal_identity_from_types(types: Array[SemType]): TupleNominalIdentity =
    let key = tuple_key_from_types(types)
    TupleNominalIdentity {
        tuple_key: key,
        nominal: NominalId { namespace_name: "compiler.tuple", name: key },
    }

/// Convert aggregate declarations into row fields.
def aggregate_fields_to_row_fields(fields: Array[AggregateField], index: usize, out: Vec[CanonicalRowField]): Array[CanonicalRowField] =
    if index == fields.len() { out.freeze() }
    else {
        let field = fields.get(index)
        aggregate_fields_to_row_fields(fields, index + 1, out.push(CanonicalRowField { id: field.name, ty: field.ty }))
    }

/// Build a record/tuple/data/union aggregate shape.
def build_aggregate_shape(kind: AggregateKind, fields: Array[AggregateField]): AggregateShape =
    AggregateShape {
        kind: kind,
        row: canonicalize_row(aggregate_fields_to_row_fields(fields, 0, Vec[CanonicalRowField].new()), None),
    }

/// Return true when aggregate field access uses row-field lowering.
def AggregateKind.uses_row_field_lowering(self): bool =
    match self {
        AggregateRecord => true
        AggregateTuple => true
        AggregateDataPayload => true
        AggregateUnion => true
    }
