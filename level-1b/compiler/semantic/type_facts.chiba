/// Typed facts produced by HM + row inference.
namespace compiler.semantic.type_facts

use compiler.ir.type_ir.*
use compiler.semantic.abi_capability.*
use compiler.semantic.types.*

/// Type equality and row/capability constraints.
data SemanticConstraint {
    ConstraintEq(SemType, SemType),
    ConstraintRowEq(SemType, SemType),
    ConstraintFieldPresent(SemType, RowFieldId),
    ConstraintFieldType(SemType, RowFieldId, SemType),
    ConstraintCapability(SemType, String),
    ConstraintAbi(SemType, ExternAbi),
}

/// Structural obligation kept for checked templates and specialization.
data SemanticObligation {
    ObligationField(SemType, RowFieldId, SemType),
    ObligationMethod(SemType, String, Array[SemType], SemType),
    ObligationOperator(String, SemType, Array[SemType], SemType),
    ObligationShapeDispatch(String, SemType, Array[SemType], SemType),
    ObligationContinuationCapability(SemType, ContinuationResumeKind),
}

/// Facts attached to one typed expression or definition.
type TypedFacts {
    root_type: SemType,
    constraints: Array[SemanticConstraint],
    obligations: Array[SemanticObligation],
}

/// Semantic type used by the first i32 codegen vertical slice.
def typed_fact_i32_type(): SemType =
    TyNominal(NominalId { namespace_name: "std", name: "i32" })

/// Semantic type used for unit-returning functions in the minimal slice.
def typed_fact_unit_type(): SemType =
    TyNominal(NominalId { namespace_name: "std", name: "Unit" })

/// Pick the root semantic type for one typed function fact.
def typed_fact_root_type_from_function(function: TypedFunctionBodyFact): SemType =
    if function.returns_i32 { typed_fact_i32_type() }
    else { typed_fact_unit_type() }

/// Build one derived typed fact from a typed function body fact.
def typed_fact_from_function(function: TypedFunctionBodyFact): TypedFacts =
    TypedFacts {
        root_type: typed_fact_root_type_from_function(function),
        constraints: Vec[SemanticConstraint].new().freeze(),
        obligations: Vec[SemanticObligation].new().freeze(),
    }

/// Build typed facts from minimal function facts without empty-stream pass-through.
def typed_facts_from_functions(functions: Array[TypedFunctionBodyFact], index: usize, out: Vec[TypedFacts]): Array[TypedFacts] =
    if index == functions.len() { out.freeze() }
    else { typed_facts_from_functions(functions, index + 1, out.push(typed_fact_from_function(functions.get(index)))) }

/// Build typed facts after inference.
def build_typed_facts(module: TypedModule): Result[Array[TypedFacts], SemanticDiagnostics] =
    if module.functions.len() > 0 {
        Ok(typed_facts_from_functions(module.functions, 0, Vec[TypedFacts].new()))
    } else {
        Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
            .push(SemanticDiagnostic("<semantic>", 0, 0, "missing-facts: typed fact derivation from inferred source absent"))
            .freeze()))
    }

/// Return true when typed facts contain specialization obligations.
def TypedFacts.has_obligations(self): bool =
    self.obligations.len() != 0
