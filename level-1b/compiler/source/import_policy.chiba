/// Source import policy for level-1b.
///
/// The parser keeps file-level attributes in the source model. The source
/// driver uses this contract before item collection so default prelude imports
/// are deterministic and Metal files stay isolated.
namespace compiler.source.import_policy

use compiler.source.project.*

/// Default prelude import decision for one source file.
data PreludeImportPolicy {
    PreludeImportDefault,
    PreludeImportDisabled,
    PreludeImportMetal,
}

/// Decide the prelude import policy from source header facts.
def prelude_policy_for_header(is_metal: bool, no_prelude_import: bool): PreludeImportPolicy =
    if is_metal { PreludeImportMetal }
    else if no_prelude_import { PreludeImportDisabled }
    else { PreludeImportDefault }

/// Decide the prelude import policy from scanned source header facts.
def SourceHeaderFacts.prelude_policy(self): PreludeImportPolicy =
    prelude_policy_for_header(self.is_metal, self.no_prelude_import)

/// Return true when the source driver must inject `use prelude.*`.
def PreludeImportPolicy.should_inject(self): bool =
    match self {
        PreludeImportDefault => true
        PreludeImportDisabled => false
        PreludeImportMetal => false
    }

/// Fully qualified namespace imported by the default prelude rule.
def default_prelude_namespace(): Str = "prelude"

/// Import scope input collected before real name resolution.
type SourceImportScopeInput {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    explicit_uses: Array[SourceUseScanResult],
    prelude_policy: PreludeImportPolicy,
}

/// Import/name resolution blocker emitted while the resolver is not implemented.
type SourceImportResolutionBlocker {
    file: SourceFileId,
    message: String,
}

/// Import/name-resolution obligation before symbol lookup.
type SourceNameResolutionObligation {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    explicit_use_count: usize,
    prelude_injected: bool,
    requires_visibility_check: bool,
    requires_conflict_check: bool,
}

/// Import/name resolution transition result.
type SourceImportResolution {
    scopes: Array[SourceImportScopeInput],
    obligations: Array[SourceNameResolutionObligation],
    blockers: Array[SourceImportResolutionBlocker],
}

/// Return true when one scanned use belongs to a file.
def source_use_belongs_to_file(import_use: SourceUseScanResult, file: SourceFileId): bool =
    import_use.file.index == file.index

/// Collect explicit use declarations for one file.
def source_uses_for_file(uses: Array[SourceUseScanResult], file: SourceFileId, index: usize, out: Vec[SourceUseScanResult]): Array[SourceUseScanResult] =
    if index == uses.len() { out.freeze() }
    else if source_use_belongs_to_file(uses.get(index), file) {
        source_uses_for_file(uses, file, index + 1, out.push(uses.get(index)))
    } else {
        source_uses_for_file(uses, file, index + 1, out)
    }

/// Find the scanned file-header namespace for one file.
def source_owner_namespace_for_file(namespaces: Array[NamespaceScanResult], file: SourceFileId, index: usize): Option[NamespaceNameSlice] =
    if index == namespaces.len() { None }
    else if namespaces.get(index).file.index == file.index { Some(namespaces.get(index).name) }
    else { source_owner_namespace_for_file(namespaces, file, index + 1) }

/// Build one import scope input from header, namespace, and use facts.
def source_import_scope_for_header(project: ProjectSurface, header: SourceHeaderFacts): SourceImportScopeInput =
    SourceImportScopeInput {
        file: header.file,
        owner_namespace: source_owner_namespace_for_file(project.facts.namespaces, header.file, 0),
        explicit_uses: source_uses_for_file(project.facts.uses, header.file, 0, Vec[SourceUseScanResult].new()),
        prelude_policy: header.prelude_policy(),
    }

/// Build import scope inputs in deterministic file order.
def source_import_scope_inputs(headers: Array[SourceHeaderFacts], project: ProjectSurface, index: usize, out: Vec[SourceImportScopeInput]): Array[SourceImportScopeInput] =
    if index == headers.len() { out.freeze() }
    else { source_import_scope_inputs(headers, project, index + 1, out.push(source_import_scope_for_header(project, headers.get(index)))) }

/// Return true when one import scope needs unresolved name visibility work.
def source_import_scope_needs_resolution(scope: SourceImportScopeInput): bool =
    if scope.explicit_uses.len() > 0 { true }
    else { scope.prelude_policy.should_inject() }

/// Convert one import scope into a name-resolution obligation.
def source_name_resolution_obligation_from_scope(scope: SourceImportScopeInput): SourceNameResolutionObligation =
    SourceNameResolutionObligation {
        file: scope.file,
        owner_namespace: scope.owner_namespace,
        explicit_use_count: scope.explicit_uses.len(),
        prelude_injected: scope.prelude_policy.should_inject(),
        requires_visibility_check: source_import_scope_needs_resolution(scope),
        requires_conflict_check: source_import_scope_needs_resolution(scope),
    }

/// Build name-resolution obligations in deterministic file order.
def source_name_resolution_obligations(scopes: Array[SourceImportScopeInput], index: usize, out: Vec[SourceNameResolutionObligation]): Array[SourceNameResolutionObligation] =
    if index == scopes.len() { out.freeze() }
    else { source_name_resolution_obligations(scopes, index + 1, out.push(source_name_resolution_obligation_from_scope(scopes.get(index)))) }

/// Collect blockers for import scopes while real resolution is absent.
def source_import_resolution_blockers(scopes: Array[SourceImportScopeInput], index: usize, out: Vec[SourceImportResolutionBlocker]): Array[SourceImportResolutionBlocker] =
    if index == scopes.len() { out.freeze() }
    else {
        let scope = scopes.get(index)
        let next_out =
            if source_import_scope_needs_resolution(scope) {
                out.push(SourceImportResolutionBlocker(scope.file, "missing-lowering: source import/name resolution absent"))
            } else { out }
        source_import_resolution_blockers(scopes, index + 1, next_out)
    }

/// Build fail-closed import/name resolution result from source facts.
def resolve_source_imports(project: ProjectSurface): SourceImportResolution =
    let scopes = source_import_scope_inputs(project.facts.headers, project, 0, Vec[SourceImportScopeInput].new())
    SourceImportResolution {
        scopes: scopes,
        obligations: source_name_resolution_obligations(scopes, 0, Vec[SourceNameResolutionObligation].new()),
        blockers: source_import_resolution_blockers(scopes, 0, Vec[SourceImportResolutionBlocker].new()),
    }

/// Return true when import/name resolution is still blocking source semantics.
def source_project_needs_import_resolution(project: ProjectSurface): bool =
    resolve_source_imports(project).blockers.len() > 0
