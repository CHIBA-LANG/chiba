/// Project source loading and namespace scan contract.
namespace compiler.source.project

/// Source file identifier after deterministic project scan.
type SourceFileId {
    index: usize,
}

/// Include directory supplied by `-I/--include`.
type IncludeDir {
    path: String,
}

/// Source file loaded from an include root or explicit CLI input.
type SourceFile {
    id: SourceFileId,
    path: String,
    text: String,
}

/// Namespace declaration surface.
type NamespaceSurface {
    name: str,
    doc_path: Option[String],
    doc_comment: Option[String],
    file: SourceFileId,
}

/// Namespace name slice discovered in source text.
type NamespaceNameSlice {
    offset: usize,
    len: usize,
}

/// Source item name slice discovered in source text.
type SourceNameSlice {
    offset: usize,
    len: usize,
}

/// Result of scanning for one namespace declaration.
type NamespaceScanResult {
    file: SourceFileId,
    name: NamespaceNameSlice,
    line: usize,
    column: usize,
}

/// Namespace form not handled by the transition scanner.
type SourceNamespaceScanWarning {
    file: SourceFileId,
    line: usize,
    column: usize,
}

/// Source use declaration discovered before full import resolution.
type SourceUseScanResult {
    file: SourceFileId,
    path: SourceNameSlice,
    glob: bool,
    multi: bool,
    line: usize,
    column: usize,
}

/// Stable owner-scoped symbol fact before full name resolution.
type SourceOwnerSymbolFact {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    name: Option[SourceNameSlice],
    kind: SourceItemKind,
    private: bool,
    line: usize,
    column: usize,
}

/// Header attributes discovered before item parsing.
type SourceHeaderFacts {
    file: SourceFileId,
    is_metal: bool,
    no_prelude_import: bool,
}

/// Documentation facts discovered near the namespace declaration.
type SourceDocFacts {
    file: SourceFileId,
    has_doc_comment: bool,
    has_doc_path: bool,
}

/// Compile-if attributes discovered before item filtering.
data SourceCompileIfShape {
    SourceCompileIfAbsent,
    SourceCompileIfEqTarget,
    SourceCompileIfEqBackend,
    SourceCompileIfAll,
    SourceCompileIfAny,
    SourceCompileIfNot,
    SourceCompileIfUnknown,
}

/// Compile-if attributes discovered before item filtering.
type SourceCompileIfFacts {
    file: SourceFileId,
    has_compile_if: bool,
    expr: Option[SourceNameSlice],
    shape: SourceCompileIfShape,
    has_target_predicate: bool,
    has_backend_predicate: bool,
    has_all_predicate: bool,
    has_any_predicate: bool,
    has_not_predicate: bool,
    has_unknown_predicate: bool,
}

/// Source item kind visible to early gates before full AST lowering.
data SourceItemKind {
    SourceItemDef,
    SourceItemType,
    SourceItemData,
    SourceItemUnion,
    SourceItemInterface,
    SourceItemExtern,
}

/// Attribute facts attached to a source item before full AST parsing.
type SourceItemAttributeFacts {
    compile_if: Option[SourceCompileIfFacts],
    world_local: bool,
}

/// Surface slices for source item lowering before full AST parsing.
type SourceItemSurfaceFacts {
    header: SourceNameSlice,
    has_params: bool,
    has_type_annotation: bool,
    has_body: bool,
    has_ref_type: bool,
    has_callable_arrow: bool,
    has_explicit_continuation_type: bool,
    has_method_receiver: bool,
    has_operator_method: bool,
    has_self_type: bool,
    has_pattern_params: bool,
    has_explicit_type_params: bool,
    has_compiler_intrinsic_call: bool,
    has_tuple_type_surface: bool,
    has_global_value_initializer: bool,
    has_global_value_dependency: bool,
    has_pipe_expr: bool,
    has_pipe_placeholder: bool,
    has_pipe_chain: bool,
    has_match_expr: bool,
    has_if_let_expr: bool,
    has_deep_pattern_surface: bool,
    has_generic_self_method: bool,
    has_string_interpolation: bool,
    has_string_slice_surface: bool,
    has_char_at_surface: bool,
    has_index_expr: bool,
    has_index_slice_expr: bool,
    has_infix_operator_expr: bool,
    has_operator_obligation_surface: bool,
    has_auto_generic_params: bool,
    has_explicit_instantiation_call: bool,
    has_let_binding: bool,
    has_wildcard_let: bool,
    has_scope_shadow_candidate: bool,
}

/// Source item discovered by the byte-level scanner.
type SourceItemScanResult {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Non-ASCII byte discovered by the transition scanner before UTF-8 support lands.
type SourceUtf8ScanWarning {
    file: SourceFileId,
    line: usize,
    column: usize,
}

/// Source facts derived from byte-level source scans.
type SourceProjectFacts {
    headers: Array[SourceHeaderFacts],
    docs: Array[SourceDocFacts],
    compile_if: Array[SourceCompileIfFacts],
    namespaces: Array[NamespaceScanResult],
    namespace_warnings: Array[SourceNamespaceScanWarning],
    uses: Array[SourceUseScanResult],
    items: Array[SourceItemScanResult],
    owner_symbols: Array[SourceOwnerSymbolFact],
    utf8_warnings: Array[SourceUtf8ScanWarning],
}

/// Source-level project summary.
type ProjectSurface {
    files: Array[SourceFile],
    namespaces: Array[NamespaceSurface],
    facts: SourceProjectFacts,
}

/// Load project files in deterministic path order.
def load_project(inputs: Array[String], includes: Array[IncludeDir]): ProjectSurface = __compiler_builtin("std.source_load_project")

/// Return namespaces sorted by file path and source span.
def ProjectSurface.sorted_namespaces(self): Array[NamespaceSurface] = self.namespaces
