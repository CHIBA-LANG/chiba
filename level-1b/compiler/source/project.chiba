/// Project source loading and namespace scan contract.
namespace compiler.source.project

/// Source file identifier after deterministic project scan.
type SourceFileId {
    index: usize,
}

/// Include directory supplied by `-I/--include`.
type IncludeDir {
    path: String,
}

/// Source file loaded from an include root or explicit CLI input.
type SourceFile {
    id: SourceFileId,
    path: String,
    text: String,
}

/// Namespace declaration surface.
type NamespaceSurface {
    name: str,
    doc_path: Option[String],
    doc_comment: Option[String],
    file: SourceFileId,
}

/// Namespace name slice discovered in source text.
type NamespaceNameSlice {
    offset: usize,
    len: usize,
}

/// Source item name slice discovered in source text.
type SourceNameSlice {
    offset: usize,
    len: usize,
}

/// Result of scanning for one namespace declaration.
type NamespaceScanResult {
    file: SourceFileId,
    name: NamespaceNameSlice,
    line: usize,
    column: usize,
}

/// Namespace form not handled by the transition scanner.
type SourceNamespaceScanWarning {
    file: SourceFileId,
    line: usize,
    column: usize,
}

/// Source use declaration discovered before full import resolution.
type SourceUseScanResult {
    file: SourceFileId,
    path: SourceNameSlice,
    group_prefix: Option[SourceNameSlice],
    group_member: Option[SourceNameSlice],
    group_member_count: usize,
    glob: bool,
    multi: bool,
    line: usize,
    column: usize,
}

/// Stable owner-scoped symbol fact before full name resolution.
type SourceOwnerSymbolFact {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    name: Option[SourceNameSlice],
    kind: SourceItemKind,
    private: bool,
    line: usize,
    column: usize,
}

/// Parser-owned owner symbol fact before full SourceItem replacement.
data SourceAstExprShape {
    SourceAstExprUnknown,
    SourceAstExprI32Const,
    SourceAstExprI32AddMul,
    SourceAstExprI32IfElse,
    SourceAstExprI32PrefixNeg,
    SourceAstExprI32MatchParam,
}

/// Parser-owned expression node kind before full AST object lowering.
data SourceAstExprNodeKind {
    SourceAstExprNodeUnknown,
    SourceAstExprNodeI32Const,
    SourceAstExprNodeParam,
    SourceAstExprNodeBinary,
    SourceAstExprNodePrefixNeg,
    SourceAstExprNodeIfElse,
    SourceAstExprNodeMatch,
    SourceAstExprNodeCall,
    SourceAstExprNodeMethodCall,
    SourceAstExprNodeIndex,
    SourceAstExprNodeIndexSlice,
    SourceAstExprNodeLocal,
    SourceAstExprNodeStringLiteral,
    SourceAstExprNodeCast,
    SourceAstExprNodeStructNew,
    SourceAstExprNodeFieldGet,
}

/// Parser-owned expression node fact for recursive source AST traversal.
type SourceAstExprNodeFact {
    file: SourceFileId,
    owner_namespace: String,
    owner_name: String,
    node_id: usize,
    kind: SourceAstExprNodeKind,
    value: usize,
    param_index: usize,
    left: usize,
    right: usize,
    then_node: usize,
    else_node: usize,
    callee: String,
    member: String,
    args: Array[usize],
    arg0: usize,
    arg1: usize,
    arg2: usize,
    arg_count: usize,
}

/// Parser-owned owner symbol fact before full SourceItem replacement.
type SourceAstOwnerSymbolFact {
    file: SourceFileId,
    owner_namespace: String,
    name: String,
    body_shape: SourceAstExprShape,
    has_i32_const_body: bool,
    i32_const_body: usize,
    has_i32_add_mul_body: bool,
    has_i32_if_else_body: bool,
    has_i32_prefix_neg_body: bool,
    has_i32_match_param_body: bool,
    namespace_count: usize,
    def_item_count: usize,
    from_chibacc: bool,
    root_node_id: usize,
    i32_param_count: usize,
}

/// Header attributes discovered before item parsing.
type SourceHeaderFacts {
    file: SourceFileId,
    is_metal: bool,
    no_prelude_import: bool,
}

/// Documentation facts discovered near the namespace declaration.
type SourceDocFacts {
    file: SourceFileId,
    has_doc_comment: bool,
    has_doc_path: bool,
}

/// Compile-if attributes discovered before item filtering.
data SourceCompileIfShape {
    SourceCompileIfAbsent,
    SourceCompileIfEqTarget,
    SourceCompileIfEqBackend,
    SourceCompileIfAll,
    SourceCompileIfAny,
    SourceCompileIfNot,
    SourceCompileIfUnknown,
}

/// Compile-if attributes discovered before item filtering.
type SourceCompileIfFacts {
    file: SourceFileId,
    has_compile_if: bool,
    expr: Option[SourceNameSlice],
    shape: SourceCompileIfShape,
    has_target_predicate: bool,
    has_backend_predicate: bool,
    has_all_predicate: bool,
    has_any_predicate: bool,
    has_not_predicate: bool,
    has_unknown_predicate: bool,
}

/// Source item kind visible to early gates before full AST lowering.
data SourceItemKind {
    SourceItemDef,
    SourceItemType,
    SourceItemData,
    SourceItemUnion,
    SourceItemInterface,
    SourceItemExtern,
}

/// First operator kind discovered by the transition scanner.
data SourceOperatorUseKind {
    SourceOperatorUseUnknown,
    SourceOperatorUseAdd,
    SourceOperatorUseSub,
    SourceOperatorUseMul,
    SourceOperatorUseDiv,
    SourceOperatorUseIndex,
    SourceOperatorUseIndexSlice,
}

/// Attribute facts attached to a source item before full AST parsing.
type SourceItemAttributeFacts {
    compile_if: Option[SourceCompileIfFacts],
    world_local: bool,
}

/// Surface slices for source item lowering before full AST parsing.
type SourceItemSurfaceFacts {
    header: SourceNameSlice,
    has_params: bool,
    has_type_annotation: bool,
    has_body: bool,
    has_ref_type: bool,
    has_callable_arrow: bool,
    has_explicit_continuation_type: bool,
    has_cont1_type: bool,
    has_contn_type: bool,
    has_send_callable_qualifier: bool,
    has_method_receiver: bool,
    has_operator_method: bool,
    method_receiver: Option[SourceNameSlice],
    method_member: Option[SourceNameSlice],
    has_self_type: bool,
    has_pattern_params: bool,
    has_explicit_type_params: bool,
    has_compiler_intrinsic_call: bool,
    has_tuple_type_surface: bool,
    has_global_value_initializer: bool,
    has_global_value_dependency: bool,
    has_pipe_expr: bool,
    has_pipe_placeholder: bool,
    has_pipe_chain: bool,
    has_if_expr: bool,
    has_else_expr: bool,
    has_else_if_expr: bool,
    has_match_expr: bool,
    has_if_let_expr: bool,
    has_deep_pattern_surface: bool,
    has_short_circuit_expr: bool,
    has_reset_expr: bool,
    has_shift_expr: bool,
    has_shiftn_expr: bool,
    has_lambda_expr: bool,
    has_trailing_closure_expr: bool,
    has_generic_self_method: bool,
    has_string_interpolation: bool,
    has_string_slice_surface: bool,
    has_char_at_surface: bool,
    has_index_expr: bool,
    has_index_slice_expr: bool,
    has_infix_operator_expr: bool,
    operator_use_kind: SourceOperatorUseKind,
    has_operator_obligation_surface: bool,
    has_auto_generic_params: bool,
    has_explicit_instantiation_call: bool,
    has_let_binding: bool,
    has_wildcard_let: bool,
    has_scope_shadow_candidate: bool,
}

/// Source item discovered by the byte-level scanner.
type SourceItemScanResult {
    file: SourceFileId,
    owner_namespace: Option[NamespaceNameSlice],
    kind: SourceItemKind,
    name: Option[SourceNameSlice],
    private: bool,
    attributes: SourceItemAttributeFacts,
    surface: SourceItemSurfaceFacts,
    line: usize,
    column: usize,
}

/// Access item attributes through a helper so seed WAT lowering does not need chained fields.
def source_item_attributes(item: SourceItemScanResult): SourceItemAttributeFacts =
    item.attributes

/// Access item surface through a helper so seed WAT lowering does not need chained fields.
def source_item_surface(item: SourceItemScanResult): SourceItemSurfaceFacts =
    item.surface

/// Return item compile_if facts through a helper.
def source_item_compile_if(item: SourceItemScanResult): Option[SourceCompileIfFacts] =
    source_item_attributes(item).compile_if

/// Return item world-local marker through a helper.
def source_item_world_local(item: SourceItemScanResult): bool =
    source_item_attributes(item).world_local

/// Return whether the item surface has params.
def source_item_surface_has_params(item: SourceItemScanResult): bool =
    source_item_surface(item).has_params

/// Return whether the item surface has a type annotation.
def source_item_surface_has_type_annotation(item: SourceItemScanResult): bool =
    source_item_surface(item).has_type_annotation

/// Return whether the item surface has a body.
def source_item_surface_has_body(item: SourceItemScanResult): bool =
    source_item_surface(item).has_body

/// Return whether the item surface contains a Ref type.
def source_item_surface_has_ref_type(item: SourceItemScanResult): bool =
    source_item_surface(item).has_ref_type

/// Non-ASCII byte discovered by the transition scanner before UTF-8 support lands.
type SourceUtf8ScanWarning {
    file: SourceFileId,
    line: usize,
    column: usize,
}

/// Frontend source mode used to derive project facts.
data SourceFrontendMode {
    SourceFrontendScannerFallback,
    SourceFrontendChibalexChibaccPrimary,
}

/// Parsed module fact expected from the chibalex/chibacc primary path.
type SourceParsedModuleFacts {
    file: SourceFileId,
    has_token_stream: bool,
    has_ast: bool,
    ast_primary_path: bool,
    ast_item_count: usize,
    ast_namespace_count: usize,
    ast_def_item_count: usize,
    ast_owner_symbol_count: usize,
    ast_from_chibacc: bool,
    has_recoverable_errors: bool,
}

/// Verified generated frontend evidence for one source module.
type SourceFrontendEvidence {
    file: SourceFileId,
    has_token_stream: bool,
    has_ast: bool,
    ast_item_count: usize,
    ast_namespace_count: usize,
    ast_def_item_count: usize,
    ast_owner_symbol_count: usize,
    ast_owner_namespace: String,
    ast_def_item_name: String,
    ast_def_body_shape: SourceAstExprShape,
    ast_def_has_i32_const_body: bool,
    ast_def_i32_const_body: usize,
    ast_def_has_i32_add_mul_body: bool,
    ast_def_has_i32_if_else_body: bool,
    ast_def_has_i32_prefix_neg_body: bool,
    ast_branch_owner_namespace: String,
    ast_branch_def_item_name: String,
    ast_branch_body_shape: SourceAstExprShape,
    ast_branch_has_if_else_body: bool,
    ast_neg_owner_namespace: String,
    ast_neg_def_item_name: String,
    ast_neg_body_shape: SourceAstExprShape,
    ast_neg_has_prefix_neg_body: bool,
    ast_match_owner_namespace: String,
    ast_match_def_item_name: String,
    ast_match_body_shape: SourceAstExprShape,
    ast_match_has_param_body: bool,
    ast_expression_owner_namespace: String,
    ast_expression_def_item_name: String,
    ast_expression_body_shape: SourceAstExprShape,
    ast_expression_has_add_mul_body: bool,
    ast_expression_has_if_else_body: bool,
    ast_expression_has_prefix_neg_body: bool,
    ast_expr_node_count: usize,
    ast_expr_nodes: Array[SourceAstExprNodeFact],
    ast_from_chibacc: bool,
    has_recoverable_errors: bool,
}

/// Parser facts for the eventual generated frontend primary path.
type SourceParserFacts {
    mode: SourceFrontendMode,
    modules: Array[SourceParsedModuleFacts],
    chibalex_spec: String,
    chibacc_spec: String,
    token_primary_path_ready: bool,
    ast_primary_path_blocked: bool,
    diagnostic: String,
}

/// Source facts derived from byte-level source scans.
type SourceProjectFacts {
    parser: SourceParserFacts,
    headers: Array[SourceHeaderFacts],
    docs: Array[SourceDocFacts],
    compile_if: Array[SourceCompileIfFacts],
    namespaces: Array[NamespaceScanResult],
    namespace_warnings: Array[SourceNamespaceScanWarning],
    uses: Array[SourceUseScanResult],
    items: Array[SourceItemScanResult],
    owner_symbols: Array[SourceOwnerSymbolFact],
    ast_owner_symbols: Array[SourceAstOwnerSymbolFact],
    ast_expr_nodes: Array[SourceAstExprNodeFact],
    utf8_warnings: Array[SourceUtf8ScanWarning],
}

/// Source-level project summary.
type ProjectSurface {
    files: Array[SourceFile],
    namespaces: Array[NamespaceSurface],
    facts: SourceProjectFacts,
}

/// Synthetic file id used by the internal seed smoke project.
def bootstrap_demo_file_id(): SourceFileId =
    SourceFileId { index: 0 }

/// Internal source file used when the seed smoke request has no host inputs.
def bootstrap_demo_source_file(): SourceFile =
    SourceFile {
        id: bootstrap_demo_file_id(),
        path: "<bootstrap-demo>",
        text: "namespace demo\ndef main(): i32 = 2 + 3 * 4",
    }

/// Parser module fact for the internal seed smoke project.
def bootstrap_demo_parsed_module(): SourceParsedModuleFacts =
    SourceParsedModuleFacts {
        file: bootstrap_demo_file_id(),
        has_token_stream: true,
        has_ast: true,
        ast_primary_path: true,
        ast_item_count: 1,
        ast_namespace_count: 1,
        ast_def_item_count: 1,
        ast_owner_symbol_count: 1,
        ast_from_chibacc: true,
        has_recoverable_errors: false,
    }

/// Parser facts for the internal seed smoke project.
def bootstrap_demo_parser_facts(): SourceParserFacts =
    SourceParserFacts {
        mode: SourceFrontendChibalexChibaccPrimary,
        modules: Vec[SourceParsedModuleFacts].new().push(bootstrap_demo_parsed_module()).freeze(),
        chibalex_spec: "src/frontend/chiba-level1.chibalex",
        chibacc_spec: "src/frontend/chiba-level1.chibacc",
        token_primary_path_ready: true,
        ast_primary_path_blocked: false,
        diagnostic: "",
    }

/// Parser-owned owner symbol for the internal `demo::main` seed smoke body.
def bootstrap_demo_ast_owner_symbol(): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: bootstrap_demo_file_id(),
        owner_namespace: "demo",
        name: "main",
        body_shape: SourceAstExprUnknown,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: false,
        has_i32_if_else_body: false,
        has_i32_prefix_neg_body: false,
        has_i32_match_param_body: false,
        namespace_count: 1,
        def_item_count: 1,
        from_chibacc: true,
        root_node_id: 0,
        i32_param_count: 0,
    }

/// Build one parser-owned AST node for the internal seed smoke body.
def bootstrap_demo_ast_node(node_id: usize, kind: SourceAstExprNodeKind, value: usize, left: usize, right: usize): SourceAstExprNodeFact =
    SourceAstExprNodeFact {
        file: bootstrap_demo_file_id(),
        owner_namespace: "demo",
        owner_name: "main",
        node_id: node_id,
        kind: kind,
        value: value,
        param_index: 0,
        left: left,
        right: right,
        then_node: 0,
        else_node: 0,
        callee: "",
        member: "",
        args: Vec[usize].new().freeze(),
        arg0: 0,
        arg1: 0,
        arg2: 0,
        arg_count: 0,
    }

/// Parser-owned AST nodes for `2 + 3 * 4`.
def bootstrap_demo_ast_expr_nodes(): Array[SourceAstExprNodeFact] =
    Vec[SourceAstExprNodeFact].new()
        .push(bootstrap_demo_ast_node(0, SourceAstExprNodeBinary, 0, 1, 2))
        .push(bootstrap_demo_ast_node(1, SourceAstExprNodeI32Const, 2, 0, 0))
        .push(bootstrap_demo_ast_node(2, SourceAstExprNodeBinary, 2, 3, 4))
        .push(bootstrap_demo_ast_node(3, SourceAstExprNodeI32Const, 3, 0, 0))
        .push(bootstrap_demo_ast_node(4, SourceAstExprNodeI32Const, 4, 0, 0))
        .freeze()

/// Source facts for the internal parser-owned seed smoke project.
def bootstrap_demo_source_project_facts(): SourceProjectFacts =
    SourceProjectFacts {
        parser: bootstrap_demo_parser_facts(),
        headers: Vec[SourceHeaderFacts].new().freeze(),
        docs: Vec[SourceDocFacts].new().freeze(),
        compile_if: Vec[SourceCompileIfFacts].new().freeze(),
        namespaces: Vec[NamespaceScanResult].new().freeze(),
        namespace_warnings: Vec[SourceNamespaceScanWarning].new().freeze(),
        uses: Vec[SourceUseScanResult].new().freeze(),
        items: Vec[SourceItemScanResult].new().freeze(),
        owner_symbols: Vec[SourceOwnerSymbolFact].new().freeze(),
        ast_owner_symbols: Vec[SourceAstOwnerSymbolFact].new().push(bootstrap_demo_ast_owner_symbol()).freeze(),
        ast_expr_nodes: bootstrap_demo_ast_expr_nodes(),
        utf8_warnings: Vec[SourceUtf8ScanWarning].new().freeze(),
    }

/// Internal parser-owned demo project used by the seed smoke path.
def bootstrap_demo_project_surface(): ProjectSurface =
    ProjectSurface {
        files: Vec[SourceFile].new().push(bootstrap_demo_source_file()).freeze(),
        namespaces: Vec[NamespaceSurface].new().freeze(),
        facts: bootstrap_demo_source_project_facts(),
    }

/// Empty parser facts used by the self-hosted empty-project bootstrap path.
def empty_source_parser_facts(): SourceParserFacts =
    SourceParserFacts {
        mode: SourceFrontendChibalexChibaccPrimary,
        modules: Vec[SourceParsedModuleFacts].new().freeze(),
        chibalex_spec: "src/frontend/chiba-level1.chibalex",
        chibacc_spec: "src/frontend/chiba-level1.chibacc",
        token_primary_path_ready: true,
        ast_primary_path_blocked: false,
        diagnostic: "",
    }

/// Empty source facts for an empty compile request.
def empty_source_project_facts(): SourceProjectFacts =
    SourceProjectFacts {
        parser: empty_source_parser_facts(),
        headers: Vec[SourceHeaderFacts].new().freeze(),
        docs: Vec[SourceDocFacts].new().freeze(),
        compile_if: Vec[SourceCompileIfFacts].new().freeze(),
        namespaces: Vec[NamespaceScanResult].new().freeze(),
        namespace_warnings: Vec[SourceNamespaceScanWarning].new().freeze(),
        uses: Vec[SourceUseScanResult].new().freeze(),
        items: Vec[SourceItemScanResult].new().freeze(),
        owner_symbols: Vec[SourceOwnerSymbolFact].new().freeze(),
        ast_owner_symbols: Vec[SourceAstOwnerSymbolFact].new().freeze(),
        ast_expr_nodes: Vec[SourceAstExprNodeFact].new().freeze(),
        utf8_warnings: Vec[SourceUtf8ScanWarning].new().freeze(),
    }

/// Empty project value constructed inside Wasm without host project-loading imports.
def empty_project_surface(): ProjectSurface =
    ProjectSurface {
        files: Vec[SourceFile].new().freeze(),
        namespaces: Vec[NamespaceSurface].new().freeze(),
        facts: empty_source_project_facts(),
    }

/// Return true when a compile request has no project inputs to load.
def load_project_is_empty_request(inputs: Array[String], includes: Array[IncludeDir]): bool =
    inputs.len() == 0 && includes.len() == 0

/// Host-backed project loading for non-empty requests.
def load_project_host(inputs: Array[String], includes: Array[IncludeDir]): ProjectSurface = __compiler_builtin("std.source_load_project")

/// Load project files in deterministic path order.
def load_project(inputs: Array[String], includes: Array[IncludeDir]): ProjectSurface =
    if load_project_is_empty_request(inputs, includes) { bootstrap_demo_project_surface() }
    else { load_project_host(inputs, includes) }

/// Return namespaces sorted by file path and source span.
def ProjectSurface.sorted_namespaces(self): Array[NamespaceSurface] = self.namespaces
