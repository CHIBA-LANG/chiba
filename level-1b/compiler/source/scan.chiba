/// Byte-level source scanner for early project facts.
namespace compiler.source.scan

use compiler.source.project.*
use std.option.*
use std.string.*

/// Cursor used while scanning one source file.
type SourceScanCursor {
    offset: usize,
    line: usize,
    column: usize,
}

/// Return true when an ASCII byte is whitespace inside source headers.
def source_is_space(byte: u8): bool =
    if byte == 32 { true }
    else if byte == 9 { true }
    else if byte == 13 { true }
    else { false }

/// Return true when an ASCII byte may start a namespace segment.
def source_is_ident_start(byte: u8): bool =
    if byte >= 65 && byte <= 90 { true }
    else if byte >= 97 && byte <= 122 { true }
    else if byte == 95 { true }
    else { false }

/// Return true when an ASCII byte may continue a namespace segment.
def source_is_ident_continue(byte: u8): bool =
    if source_is_ident_start(byte) { true }
    else if byte >= 48 && byte <= 57 { true }
    else if byte == 46 { true }
    else { false }

/// Return true when an ASCII byte may start a constructor pattern.
def source_is_uppercase_ident_start(byte: u8): bool =
    byte >= 65 && byte <= 90

/// Return true when byte belongs to non-ASCII UTF-8 source.
def source_is_non_ascii(byte: u8): bool =
    byte >= 128

/// Match a byte string at a source offset.
def source_starts_with_at(text: String, offset: usize, needle: String, index: usize): bool =
    if index == needle.len() { true }
    else if offset + index >= text.len() { false }
    else if text.byte_at(offset + index) == needle.byte_at(index) {
        source_starts_with_at(text, offset, needle, index + 1)
    } else { false }

/// Return true when a source text contains a header attribute.
def source_has_header_attr(text: String, attr: String, offset: usize): bool =
    if offset >= text.len() { false }
    else if source_starts_with_at(text, offset, attr, 0) { true }
    else { source_has_header_attr(text, attr, offset + 1) }

/// Scan file header attributes used by import policy and Metal isolation.
def source_scan_header(file: SourceFile): SourceHeaderFacts =
    SourceHeaderFacts {
        file: file.id,
        is_metal: source_has_header_attr(file.text, "#![Metal]", 0),
        no_prelude_import: source_has_header_attr(file.text, "#![no_prelude_import]", 0),
    }

/// Scan source documentation facts near namespace declarations.
def source_scan_doc_facts(file: SourceFile): SourceDocFacts =
    SourceDocFacts {
        file: file.id,
        has_doc_comment: source_has_header_attr(file.text, "///", 0),
        has_doc_path: source_has_header_attr(file.text, "#[doc(path=", 0),
    }

/// Scan compile_if attributes before item filtering.
def source_scan_compile_if_facts(file: SourceFile): SourceCompileIfFacts =
    let expr = source_scan_compile_if_expr(file.text, 0)
    SourceCompileIfFacts {
        file: file.id,
        has_compile_if: expr.is_some(),
        expr: expr,
        shape: source_scan_compile_if_shape(file.text, expr),
        has_target_predicate: source_has_header_attr(file.text, "target=", 0),
        has_backend_predicate: source_has_header_attr(file.text, "backend=", 0),
        has_all_predicate: source_has_header_attr(file.text, "all(", 0),
        has_any_predicate: source_has_header_attr(file.text, "or(", 0),
        has_not_predicate: source_has_header_attr(file.text, "not(", 0),
        has_unknown_predicate: source_has_header_attr(file.text, "xor(", 0),
    }

/// Scan one line-start compile_if attribute for attachment to the next item.
def source_scan_compile_if_facts_at(file: SourceFileId, text: String, offset: usize): Option[SourceCompileIfFacts] =
    if source_starts_with_at(text, offset, "#[compile_if(", 0) {
        let start = offset + "#[compile_if(".len()
        let end = source_scan_compile_if_expr_end(text, start)
        let expr = Some(SourceNameSlice { offset: start, len: end - start })
        Some(SourceCompileIfFacts {
            file: file,
            has_compile_if: true,
            expr: expr,
            shape: source_scan_compile_if_shape(text, expr),
            has_target_predicate: source_line_has_text(text, start, "target="),
            has_backend_predicate: source_line_has_text(text, start, "backend="),
            has_all_predicate: source_starts_with_at(text, start, "all(", 0),
            has_any_predicate: source_starts_with_at(text, start, "or(", 0),
            has_not_predicate: source_starts_with_at(text, start, "not(", 0),
            has_unknown_predicate: source_starts_with_at(text, start, "xor(", 0),
        })
    } else { None }

/// Empty item attributes used when no line attribute is pending.
def source_item_attributes_none(): SourceItemAttributeFacts =
    SourceItemAttributeFacts { compile_if: None, world_local: false }

/// Build item attributes from a pending compile_if attribute.
def source_item_attributes_from_pending(compile_if: Option[SourceCompileIfFacts], world_local: bool): SourceItemAttributeFacts =
    SourceItemAttributeFacts { compile_if: compile_if, world_local: world_local }

/// Classify the top-level compile_if predicate shape.
def source_scan_compile_if_shape_at(text: String, offset: usize): SourceCompileIfShape =
    if source_starts_with_at(text, offset, "target=", 0) { SourceCompileIfEqTarget }
    else if source_starts_with_at(text, offset, "backend=", 0) { SourceCompileIfEqBackend }
    else if source_starts_with_at(text, offset, "all(", 0) { SourceCompileIfAll }
    else if source_starts_with_at(text, offset, "or(", 0) { SourceCompileIfAny }
    else if source_starts_with_at(text, offset, "not(", 0) { SourceCompileIfNot }
    else { SourceCompileIfUnknown }

/// Classify a scanned compile_if expression, or absent when no attribute exists.
def source_scan_compile_if_shape(text: String, expr: Option[SourceNameSlice]): SourceCompileIfShape =
    match expr {
        Some(slice) => source_scan_compile_if_shape_at(text, slice.offset)
        None => SourceCompileIfAbsent
    }

/// Scan to the closing attribute bracket for one compile_if expression.
def source_scan_compile_if_expr_end(text: String, offset: usize): usize =
    if offset >= text.len() { offset }
    else if text.byte_at(offset) == 93 { offset }
    else { source_scan_compile_if_expr_end(text, offset + 1) }

/// Scan the first compile_if expression slice.
def source_scan_compile_if_expr(text: String, offset: usize): Option[SourceNameSlice] =
    if offset >= text.len() { None }
    else if source_starts_with_at(text, offset, "#[compile_if(", 0) {
        let start = offset + "#[compile_if(".len()
        let end = source_scan_compile_if_expr_end(text, start)
        Some(SourceNameSlice { offset: start, len: end - start })
    } else { source_scan_compile_if_expr(text, offset + 1) }

/// Skip horizontal whitespace after a token.
def source_skip_spaces(text: String, offset: usize): usize =
    if offset >= text.len() { offset }
    else if source_is_space(text.byte_at(offset)) { source_skip_spaces(text, offset + 1) }
    else { offset }

/// Scan to the end of one namespace name.
def source_scan_namespace_name_end(text: String, offset: usize): usize =
    if offset >= text.len() { offset }
    else if source_is_ident_continue(text.byte_at(offset)) { source_scan_namespace_name_end(text, offset + 1) }
    else { offset }

/// Try to scan a namespace declaration at one line start.
def source_scan_namespace_at(file: SourceFileId, text: String, offset: usize, line: usize): Option[NamespaceScanResult] =
    if source_starts_with_at(text, offset, "namespace", 0) {
        let start = source_skip_spaces(text, offset + "namespace".len())
        if start < text.len() && source_is_ident_start(text.byte_at(start)) {
            let end = source_scan_namespace_name_end(text, start)
            Some(NamespaceScanResult {
                file: file,
                name: NamespaceNameSlice { offset: start, len: end - start },
                line: line,
                column: start - offset,
            })
        } else { None }
    } else { None }

/// Return true when one source line contains a byte before newline.
def source_line_has_byte(text: String, offset: usize, byte: u8): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if text.byte_at(offset) == byte { true }
    else { source_line_has_byte(text, offset + 1, byte) }

/// Return the first byte offset on one line, or text.len() when absent.
def source_line_find_byte_or_end(text: String, offset: usize, byte: u8): usize =
    if offset >= text.len() { text.len() }
    else if text.byte_at(offset) == 10 { text.len() }
    else if text.byte_at(offset) == byte { offset }
    else { source_line_find_byte_or_end(text, offset + 1, byte) }

/// Return true when one source line contains an ASCII token.
def source_line_has_text(text: String, offset: usize, needle: String): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if source_starts_with_at(text, offset, needle, 0) { true }
    else { source_line_has_text(text, offset + 1, needle) }

/// Return true when one source line contains an ASCII token before a stop byte.
def source_line_has_text_before_byte(text: String, offset: usize, needle: String, stop: u8): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if text.byte_at(offset) == stop { false }
    else if source_starts_with_at(text, offset, needle, 0) { true }
    else { source_line_has_text_before_byte(text, offset + 1, needle, stop) }

/// Return true when one source line contains a byte before a stop byte.
def source_line_has_byte_before_byte(text: String, offset: usize, byte: u8, stop: u8): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if text.byte_at(offset) == stop { false }
    else if text.byte_at(offset) == byte { true }
    else { source_line_has_byte_before_byte(text, offset + 1, byte, stop) }

/// Return true when a bounded source region contains an ASCII token.
def source_region_has_text(text: String, offset: usize, end: usize, needle: String): bool =
    if offset >= end { false }
    else if offset >= text.len() { false }
    else if source_starts_with_at(text, offset, needle, 0) { true }
    else { source_region_has_text(text, offset + 1, end, needle) }

/// Count occurrences of an ASCII token in a bounded source region.
def source_region_count_text(text: String, offset: usize, end: usize, needle: String, count: usize): usize =
    if offset >= end { count }
    else if offset >= text.len() { count }
    else if source_starts_with_at(text, offset, needle, 0) {
        source_region_count_text(text, offset + needle.len(), end, needle, count + 1)
    } else { source_region_count_text(text, offset + 1, end, needle, count) }

/// Return true when byte before offset is not an identifier continuation.
def source_word_boundary_before(text: String, offset: usize): bool =
    if offset == 0 { true }
    else { source_is_ident_continue(text.byte_at(offset - 1)) == false }

/// Return true when byte after a word is not an identifier continuation.
def source_word_boundary_after(text: String, offset: usize, len: usize): bool =
    if offset + len >= text.len() { true }
    else { source_is_ident_continue(text.byte_at(offset + len)) == false }

/// Return true when one source line contains an ASCII word with identifier boundaries.
def source_line_has_word(text: String, offset: usize, word: String): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if source_starts_with_at(text, offset, word, 0) && source_word_boundary_before(text, offset) && source_word_boundary_after(text, offset, word.len()) { true }
    else { source_line_has_word(text, offset + 1, word) }

/// Return the first identifier slice after an offset.
def source_scan_ident_slice(text: String, offset: usize): Option[SourceNameSlice] =
    let start = source_skip_spaces(text, offset)
    if start < text.len() && source_is_ident_start(text.byte_at(start)) {
        let end = source_scan_namespace_name_end(text, start)
        Some(SourceNameSlice { offset: start, len: end - start })
    } else { None }

/// Return the offset after one identifier slice.
def source_name_slice_end(name: SourceNameSlice): usize =
    name.offset + name.len

/// Scan a method receiver from a `def Receiver.member(` header.
def source_scan_method_receiver(text: String, offset: usize): Option[SourceNameSlice] =
    if source_starts_with_at(text, offset, "def", 0) {
        match source_scan_ident_slice(text, offset + "def".len()) {
            Some(receiver) =>
                if source_name_slice_end(receiver) < text.len() && text.byte_at(source_name_slice_end(receiver)) == 46 { Some(receiver) }
                else { None }
            None => None
        }
    } else { None }

/// Scan a method member from a `def Receiver.member(` header.
def source_scan_method_member(text: String, offset: usize): Option[SourceNameSlice] =
    match source_scan_method_receiver(text, offset) {
        Some(receiver) => source_scan_ident_slice(text, source_name_slice_end(receiver) + 1)
        None => None
    }

/// Return true when a header contains `Ctor(` before a stop byte.
def source_line_has_uppercase_call_before_byte(text: String, offset: usize, stop: u8): bool =
    if offset >= text.len() { false }
    else if text.byte_at(offset) == 10 { false }
    else if text.byte_at(offset) == stop { false }
    else if source_is_uppercase_ident_start(text.byte_at(offset)) {
        let end = source_scan_namespace_name_end(text, offset)
        if end < text.len() && text.byte_at(end) == 40 { true }
        else { source_line_has_uppercase_call_before_byte(text, offset + 1, stop) }
    } else { source_line_has_uppercase_call_before_byte(text, offset + 1, stop) }

/// Return true when one line start begins a top-level item or namespace boundary.
def source_line_starts_item_boundary(text: String, offset: usize): bool =
    if source_starts_with_at(text, offset, "namespace ", 0) { true }
    else if source_starts_with_at(text, offset, "def ", 0) { true }
    else if source_starts_with_at(text, offset, "type ", 0) { true }
    else if source_starts_with_at(text, offset, "data ", 0) { true }
    else if source_starts_with_at(text, offset, "union ", 0) { true }
    else if source_starts_with_at(text, offset, "interface ", 0) { true }
    else if source_starts_with_at(text, offset, "extern ", 0) { true }
    else { source_starts_with_at(text, offset, "private ", 0) }

/// Scan from a body line to the next top-level item boundary or EOF.
def source_scan_next_item_boundary(text: String, offset: usize): usize =
    if offset >= text.len() { text.len() }
    else if source_line_starts_item_boundary(text, offset) { offset }
    else {
        let next = source_next_line_offset(text, offset)
        if next == offset { text.len() }
        else { source_scan_next_item_boundary(text, next) }
    }

/// Return the byte range end for one scanned item including its indented body.
def source_scan_item_region_end(text: String, offset: usize): usize =
    source_scan_next_item_boundary(text, source_next_line_offset(text, offset))

/// Return true when an item region mentions compiler-owned intrinsic surface.
def source_scan_item_has_compiler_intrinsic_call(text: String, offset: usize): bool =
    let end = source_scan_item_region_end(text, offset)
    if source_region_has_text(text, offset, end, "tuple_to_adt[") { true }
    else if source_region_has_text(text, offset, end, "adt_to_tuple[") { true }
    else if source_region_has_text(text, offset, end, "unsafe_cast[") { true }
    else { source_region_has_text(text, offset, end, "__compiler_builtin(") }

/// Return true when an item region mentions compiler-owned tuple type surface.
def source_scan_item_has_tuple_type_surface(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "Tuple[")

/// Return true when a static global initializer starts from another identifier.
def source_scan_item_has_global_value_dependency(text: String, offset: usize): bool =
    let eq = source_line_find_byte_or_end(text, offset, 61)
    if eq >= text.len() { false }
    else {
        let start = source_skip_spaces(text, eq + 1)
        if start >= text.len() { false }
        else if text.byte_at(start) == 10 { false }
        else { source_is_ident_start(text.byte_at(start)) }
    }

/// Return true when an item region contains a pipe expression.
def source_scan_item_has_pipe_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "|>")

/// Return true when an item pipe region contains a placeholder hole.
def source_scan_item_has_pipe_placeholder(text: String, offset: usize): bool =
    if source_scan_item_has_pipe_expr(text, offset) {
        source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "_")
    } else { false }

/// Return true when an item region contains more than one pipe operator.
def source_scan_item_has_pipe_chain(text: String, offset: usize): bool =
    source_region_count_text(text, offset, source_scan_item_region_end(text, offset), "|>", 0) > 1

/// Return true when an item region contains an if expression.
def source_scan_item_has_if_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "if ")

/// Return true when an item region contains an else branch.
def source_scan_item_has_else_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "else")

/// Return true when an item region contains an else-if branch.
def source_scan_item_has_else_if_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "else if")

/// Return true when an item region contains a match expression.
def source_scan_item_has_match_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "match ")

/// Return true when an item region contains an if-let expression.
def source_scan_item_has_if_let_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "if let ")

/// Return true when match/if-let syntax carries nested destructuring surface.
def source_scan_item_has_deep_pattern_surface(text: String, offset: usize): bool =
    let end = source_scan_item_region_end(text, offset)
    if source_scan_item_has_match_expr(text, offset) == false && source_scan_item_has_if_let_expr(text, offset) == false { false }
    else if source_region_has_text(text, offset, end, "((") { true }
    else if source_region_has_text(text, offset, end, "{ ") { true }
    else if source_region_has_text(text, offset, end, " @ ") { true }
    else { source_region_has_text(text, offset, end, "=>") }

/// Return true when an item region contains short-circuit boolean branching.
def source_scan_item_has_short_circuit_expr(text: String, offset: usize): bool =
    let end = source_scan_item_region_end(text, offset)
    if source_region_has_text(text, offset, end, "&&") { true }
    else { source_region_has_text(text, offset, end, "||") }

/// Return true when an item region contains a reset expression.
def source_scan_item_has_reset_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "reset ")

/// Return true when an item region contains a one-shot shift expression.
def source_scan_item_has_shift_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "shift ")

/// Return true when an item region contains a multi-shot shiftn expression.
def source_scan_item_has_shiftn_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "shiftn ")

/// Return true when an item region contains lambda arrow surface.
def source_scan_item_has_lambda_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "=>")

/// Return true when an item region contains trailing closure surface.
def source_scan_item_has_trailing_closure_expr(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "{|")

/// Return true when a method receiver uses generic owner syntax and `Self`.
def source_scan_item_has_generic_self_method(text: String, offset: usize): bool =
    source_line_has_text_before_byte(text, offset, ".", 40)
        && source_line_has_byte_before_byte(text, offset, 91, 40)
        && source_line_has_word(text, offset, "Self")

/// Return true when an item region contains string interpolation syntax.
def source_scan_item_has_string_interpolation(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), "\${")

/// Return true when an item region contains string/slice indexing surface.
def source_scan_item_has_string_slice_surface(text: String, offset: usize): bool =
    let end = source_scan_item_region_end(text, offset)
    if source_region_has_text(text, offset, end, ".slice(") { true }
    else { source_region_has_text(text, offset, end, "..") }

/// Return true when an item region contains explicit codepoint access surface.
def source_scan_item_has_char_at_surface(text: String, offset: usize): bool =
    source_region_has_text(text, offset, source_scan_item_region_end(text, offset), ".char_at(")

/// Return the start of an item body/initializer region when it is on the header line.
def source_scan_item_body_region_start(text: String, offset: usize): usize =
    let eq = source_line_find_byte_or_end(text, offset, 61)
    if eq >= text.len() { offset }
    else { eq + 1 }

/// Return true when an item body contains indexing surface.
def source_scan_item_has_index_expr(text: String, offset: usize): bool =
    source_region_has_text(text, source_scan_item_body_region_start(text, offset), source_scan_item_region_end(text, offset), "[")

/// Return true when an item body contains range indexing surface.
def source_scan_item_has_index_slice_expr(text: String, offset: usize): bool =
    if source_scan_item_has_index_expr(text, offset) {
        source_region_has_text(text, source_scan_item_body_region_start(text, offset), source_scan_item_region_end(text, offset), "..")
    } else { false }

/// Return the first operator kind visible in the item body.
def source_scan_item_operator_use_kind(text: String, offset: usize): SourceOperatorUseKind =
    let start = source_scan_item_body_region_start(text, offset)
    let end = source_scan_item_region_end(text, offset)
    if source_region_has_text(text, start, end, " + ") { SourceOperatorUseAdd }
    else if source_region_has_text(text, start, end, " - ") { SourceOperatorUseSub }
    else if source_region_has_text(text, start, end, " * ") { SourceOperatorUseMul }
    else if source_region_has_text(text, start, end, " / ") { SourceOperatorUseDiv }
    else if source_scan_item_has_index_slice_expr(text, offset) { SourceOperatorUseIndexSlice }
    else if source_scan_item_has_index_expr(text, offset) { SourceOperatorUseIndex }
    else { SourceOperatorUseUnknown }

/// Return true when an item body contains an infix operator surface.
def source_scan_item_has_infix_operator_expr(text: String, offset: usize): bool =
    let start = source_scan_item_body_region_start(text, offset)
    let end = source_scan_item_region_end(text, offset)
    if source_region_has_text(text, start, end, " + ") { true }
    else if source_region_has_text(text, start, end, " - ") { true }
    else if source_region_has_text(text, start, end, " * ") { true }
    else if source_region_has_text(text, start, end, " / ") { true }
    else { source_region_has_text(text, start, end, ".*") }

/// Return true when operator surface needs typed obligation resolution.
def source_scan_item_has_operator_obligation_surface(text: String, offset: usize): bool =
    if source_scan_item_has_infix_operator_expr(text, offset) { true }
    else { source_line_has_text_before_byte(text, offset, ".op_", 40) }

/// Return true when a function parameter list contains omitted type annotations.
def source_scan_item_has_auto_generic_params(text: String, offset: usize): bool =
    if source_line_has_byte(text, offset, 40) == false { false }
    else if source_line_has_text_before_byte(text, offset, ":", 41) { false }
    else { true }

/// Return true when an item body contains explicit generic instantiation syntax.
def source_scan_item_has_explicit_instantiation_call(text: String, offset: usize): bool =
    source_region_has_text(text, source_scan_item_body_region_start(text, offset), source_scan_item_region_end(text, offset), "](")

/// Return true when an item body contains local let binding surface.
def source_scan_item_has_let_binding(text: String, offset: usize): bool =
    source_region_has_text(text, source_scan_item_body_region_start(text, offset), source_scan_item_region_end(text, offset), "let ")

/// Return true when an item body contains wildcard discard let surface.
def source_scan_item_has_wildcard_let(text: String, offset: usize): bool =
    source_region_has_text(text, source_scan_item_body_region_start(text, offset), source_scan_item_region_end(text, offset), "let _")

/// Return true when local or pattern bindings require scope/shadow analysis.
def source_scan_item_has_scope_shadow_candidate(text: String, offset: usize): bool =
    if source_scan_item_has_let_binding(text, offset) { true }
    else if source_scan_item_has_match_expr(text, offset) { true }
    else { source_scan_item_has_if_let_expr(text, offset) }

/// Try to detect an inline namespace block unsupported by the transition scanner.
def source_scan_namespace_warning_at(file: SourceFileId, text: String, offset: usize, line: usize): Option[SourceNamespaceScanWarning] =
    let start = source_skip_spaces(text, offset)
    if source_starts_with_at(text, start, "namespace", 0) {
        if start > offset {
            Some(SourceNamespaceScanWarning { file: file, line: line, column: start - offset })
        } else if source_line_has_byte(text, start, 123) {
            Some(SourceNamespaceScanWarning { file: file, line: line, column: 0 })
        } else { None }
    } else { None }

/// Scan to the end of a use declaration line.
def source_scan_use_end(text: String, offset: usize): usize =
    if offset >= text.len() { offset }
    else if text.byte_at(offset) == 10 { offset }
    else { source_scan_use_end(text, offset + 1) }

/// Return the first byte on a use line, or the line end when absent.
def source_scan_use_byte_or_end(text: String, offset: usize, byte: u8): usize =
    if offset >= text.len() { offset }
    else if text.byte_at(offset) == 10 { offset }
    else if text.byte_at(offset) == byte { offset }
    else { source_scan_use_byte_or_end(text, offset + 1, byte) }

/// Return the byte offset immediately after the grouped import prefix.
def source_scan_group_prefix_end(text: String, start: usize, open: usize): usize =
    if open > start && text.byte_at(open - 1) == 46 { open - 1 }
    else { open }

/// Return the first grouped use member slice.
def source_scan_first_group_member(text: String, open: usize, close: usize): Option[SourceNameSlice] =
    let member_start = source_skip_spaces(text, open + 1)
    if member_start >= close { None }
    else if source_is_ident_start(text.byte_at(member_start)) {
        let member_end = source_scan_namespace_name_end(text, member_start)
        Some(SourceNameSlice { offset: member_start, len: member_end - member_start })
    } else { None }

/// Count grouped import members in `use a.{b,c}` syntax.
def source_scan_group_member_count(text: String, offset: usize, close: usize, count: usize): usize =
    if offset >= close { count }
    else {
        let start = source_skip_spaces(text, offset)
        if start >= close { count }
        else if source_is_ident_start(text.byte_at(start)) {
            let end = source_scan_namespace_name_end(text, start)
            let next = source_skip_spaces(text, end)
            if next < close && text.byte_at(next) == 44 {
                source_scan_group_member_count(text, next + 1, close, count + 1)
            } else {
                source_scan_group_member_count(text, close, close, count + 1)
            }
        } else {
            source_scan_group_member_count(text, close, close, count)
        }
    }

/// Try to scan a source use declaration at one line start.
def source_scan_use_at(file: SourceFileId, text: String, offset: usize, line: usize): Option[SourceUseScanResult] =
    if source_starts_with_at(text, offset, "use ", 0) {
        let start = source_skip_spaces(text, offset + "use".len())
        let end = source_scan_use_end(text, start)
        let open = source_scan_use_byte_or_end(text, start, 123)
        let close = source_scan_use_byte_or_end(text, start, 125)
        let grouped = open < end && close < end && open < close
        let prefix_end = if grouped { source_scan_group_prefix_end(text, start, open) } else { end }
        Some(SourceUseScanResult {
            file: file,
            path: SourceNameSlice { offset: start, len: end - start },
            group_prefix: if grouped { Some(SourceNameSlice { offset: start, len: prefix_end - start }) } else { None },
            group_member: if grouped { source_scan_first_group_member(text, open, close) } else { None },
            group_member_count: if grouped { source_scan_group_member_count(text, open + 1, close, 0) } else { 0 },
            glob: source_line_has_byte(text, start, 42),
            multi: grouped,
            line: line,
            column: start - offset,
        })
    } else { None }

/// Return true when one item line already opens an inline body or initializer.
def source_scan_item_has_body(text: String, offset: usize): bool =
    if source_line_has_byte(text, offset, 61) { true }
    else { source_line_has_byte(text, offset, 123) }

/// Return true when one item line mentions explicit continuation storage type sugar.
def source_scan_item_has_explicit_continuation_type(text: String, offset: usize): bool =
    if source_scan_item_has_cont1_type(text, offset) { true }
    else { source_scan_item_has_contn_type(text, offset) }

/// Return true when one item line mentions one-shot continuation type sugar.
def source_scan_item_has_cont1_type(text: String, offset: usize): bool =
    if source_line_has_text(text, offset, "cont1 ") { true }
    else { source_line_has_text(text, offset, "Cont1[") }

/// Return true when one item line mentions multi-shot continuation type sugar.
def source_scan_item_has_contn_type(text: String, offset: usize): bool =
    if source_line_has_text(text, offset, "contN ") { true }
    else { source_line_has_text(text, offset, "ContN[") }

/// Scan item surface shape on one source line.
def source_scan_item_surface(text: String, offset: usize): SourceItemSurfaceFacts =
    let end = source_scan_use_end(text, offset)
    SourceItemSurfaceFacts {
        header: SourceNameSlice { offset: offset, len: end - offset },
        has_params: source_line_has_byte(text, offset, 40),
        has_type_annotation: source_line_has_byte(text, offset, 58),
        has_body: source_scan_item_has_body(text, offset),
        has_ref_type: source_line_has_text(text, offset, "Ref["),
        has_callable_arrow: source_line_has_text(text, offset, "->"),
        has_explicit_continuation_type: source_scan_item_has_explicit_continuation_type(text, offset),
        has_cont1_type: source_scan_item_has_cont1_type(text, offset),
        has_contn_type: source_scan_item_has_contn_type(text, offset),
        has_send_callable_qualifier: source_line_has_text(text, offset, ") send"),
        has_method_receiver: source_line_has_text_before_byte(text, offset, ".", 40),
        has_operator_method: source_line_has_text_before_byte(text, offset, ".op_", 40),
        method_receiver: source_scan_method_receiver(text, offset),
        method_member: source_scan_method_member(text, offset),
        has_self_type: source_line_has_word(text, offset, "Self"),
        has_pattern_params: source_line_has_uppercase_call_before_byte(text, offset, 61),
        has_explicit_type_params: source_line_has_byte_before_byte(text, offset, 91, 40),
        has_compiler_intrinsic_call: source_scan_item_has_compiler_intrinsic_call(text, offset),
        has_tuple_type_surface: source_scan_item_has_tuple_type_surface(text, offset),
        has_global_value_initializer: source_line_has_byte(text, offset, 40) == false && source_scan_item_has_body(text, offset),
        has_global_value_dependency: source_line_has_byte(text, offset, 40) == false && source_scan_item_has_global_value_dependency(text, offset),
        has_pipe_expr: source_scan_item_has_pipe_expr(text, offset),
        has_pipe_placeholder: source_scan_item_has_pipe_placeholder(text, offset),
        has_pipe_chain: source_scan_item_has_pipe_chain(text, offset),
        has_if_expr: source_scan_item_has_if_expr(text, offset),
        has_else_expr: source_scan_item_has_else_expr(text, offset),
        has_else_if_expr: source_scan_item_has_else_if_expr(text, offset),
        has_match_expr: source_scan_item_has_match_expr(text, offset),
        has_if_let_expr: source_scan_item_has_if_let_expr(text, offset),
        has_deep_pattern_surface: source_scan_item_has_deep_pattern_surface(text, offset),
        has_short_circuit_expr: source_scan_item_has_short_circuit_expr(text, offset),
        has_reset_expr: source_scan_item_has_reset_expr(text, offset),
        has_shift_expr: source_scan_item_has_shift_expr(text, offset),
        has_shiftn_expr: source_scan_item_has_shiftn_expr(text, offset),
        has_lambda_expr: source_scan_item_has_lambda_expr(text, offset),
        has_trailing_closure_expr: source_scan_item_has_trailing_closure_expr(text, offset),
        has_generic_self_method: source_scan_item_has_generic_self_method(text, offset),
        has_string_interpolation: source_scan_item_has_string_interpolation(text, offset),
        has_string_slice_surface: source_scan_item_has_string_slice_surface(text, offset),
        has_char_at_surface: source_scan_item_has_char_at_surface(text, offset),
        has_index_expr: source_scan_item_has_index_expr(text, offset),
        has_index_slice_expr: source_scan_item_has_index_slice_expr(text, offset),
        has_infix_operator_expr: source_scan_item_has_infix_operator_expr(text, offset),
        operator_use_kind: source_scan_item_operator_use_kind(text, offset),
        has_operator_obligation_surface: source_scan_item_has_operator_obligation_surface(text, offset),
        has_auto_generic_params: source_scan_item_has_auto_generic_params(text, offset),
        has_explicit_instantiation_call: source_scan_item_has_explicit_instantiation_call(text, offset),
        has_let_binding: source_scan_item_has_let_binding(text, offset),
        has_wildcard_let: source_scan_item_has_wildcard_let(text, offset),
        has_scope_shadow_candidate: source_scan_item_has_scope_shadow_candidate(text, offset),
    }

/// Try to scan a source item at one line start.
def source_scan_item_at(file: SourceFileId, owner_namespace: Option[NamespaceNameSlice], text: String, offset: usize, line: usize, attributes: SourceItemAttributeFacts): Option[SourceItemScanResult] =
    let surface = source_scan_item_surface(text, offset)
    if source_starts_with_at(text, offset, "private ", 0) {
        source_scan_private_item_at(file, owner_namespace, text, offset + "private".len(), line, attributes, surface)
    } else if source_starts_with_at(text, offset, "def ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemDef, name: source_scan_item_name(text, offset + "def".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, offset, "type ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemType, name: source_scan_item_name(text, offset + "type".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, offset, "data ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemData, name: source_scan_item_name(text, offset + "data".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, offset, "union ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemUnion, name: source_scan_item_name(text, offset + "union".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, offset, "interface ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemInterface, name: source_scan_item_name(text, offset + "interface".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, offset, "extern ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemExtern, name: source_scan_item_name(text, offset + "extern".len()), private: false, attributes: attributes, surface: surface, line: line, column: 0 })
    } else { None }

/// Try to scan an item after a private visibility modifier.
def source_scan_private_item_at(file: SourceFileId, owner_namespace: Option[NamespaceNameSlice], text: String, offset: usize, line: usize, attributes: SourceItemAttributeFacts, surface: SourceItemSurfaceFacts): Option[SourceItemScanResult] =
    let start = source_skip_spaces(text, offset)
    if source_starts_with_at(text, start, "def ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemDef, name: source_scan_item_name(text, start + "def".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, start, "type ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemType, name: source_scan_item_name(text, start + "type".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, start, "data ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemData, name: source_scan_item_name(text, start + "data".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, start, "union ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemUnion, name: source_scan_item_name(text, start + "union".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, start, "interface ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemInterface, name: source_scan_item_name(text, start + "interface".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else if source_starts_with_at(text, start, "extern ", 0) {
        Some(SourceItemScanResult { file: file, owner_namespace: owner_namespace, kind: SourceItemExtern, name: source_scan_item_name(text, start + "extern".len()), private: true, attributes: attributes, surface: surface, line: line, column: 0 })
    } else { None }

/// Try to scan the first ASCII item name after an item keyword.
def source_scan_item_name(text: String, offset: usize): Option[SourceNameSlice] =
    let start = source_skip_spaces(text, offset)
    if start < text.len() && source_is_ident_start(text.byte_at(start)) {
        let end = source_scan_namespace_name_end(text, start)
        Some(SourceNameSlice { offset: start, len: end - start })
    } else { None }

/// Advance to the start offset of the next line.
def source_next_line_offset(text: String, offset: usize): usize =
    if offset >= text.len() { offset }
    else if text.byte_at(offset) == 10 { offset + 1 }
    else { source_next_line_offset(text, offset + 1) }

/// Scan non-ASCII bytes so the transition scanner cannot silently miss UTF-8 identifiers.
def source_scan_utf8_warnings_loop(file: SourceFileId, text: String, offset: usize, line: usize, column: usize, out: Vec[SourceUtf8ScanWarning]): Array[SourceUtf8ScanWarning] =
    if offset >= text.len() { out.freeze() }
    else {
        let byte = text.byte_at(offset)
        if byte == 10 {
            source_scan_utf8_warnings_loop(file, text, offset + 1, line + 1, 0, out)
        } else if source_is_non_ascii(byte) {
            source_scan_utf8_warnings_loop(
                file,
                text,
                offset + 1,
                line,
                column + 1,
                out.push(SourceUtf8ScanWarning { file: file, line: line, column: column }))
        } else {
            source_scan_utf8_warnings_loop(file, text, offset + 1, line, column + 1, out)
        }
    }

/// Scan non-ASCII bytes in one file.
def source_scan_utf8_warnings(file: SourceFile): Array[SourceUtf8ScanWarning] =
    source_scan_utf8_warnings_loop(file.id, file.text, 0, 1, 0, Vec[SourceUtf8ScanWarning].new())

/// Scan line starts until the first namespace declaration is found.
def source_scan_first_namespace_line(file: SourceFileId, text: String, offset: usize, line: usize): Option[NamespaceScanResult] =
    if offset >= text.len() { None }
    else {
        match source_scan_namespace_at(file, text, offset, line) {
            Some(result) => Some(result)
            None => {
                let next = source_next_line_offset(text, offset)
                if next == offset { None }
                else { source_scan_first_namespace_line(file, text, next, line + 1) }
            }
        }
    }

/// Scan the first namespace declaration in one source file.
def source_scan_first_namespace(file: SourceFile): Option[NamespaceScanResult] =
    source_scan_first_namespace_line(file.id, file.text, 0, 1)

/// Scan namespace warnings from line starts.
def source_scan_namespace_warnings_line(file: SourceFileId, text: String, offset: usize, line: usize, out: Vec[SourceNamespaceScanWarning]): Array[SourceNamespaceScanWarning] =
    if offset >= text.len() { out.freeze() }
    else {
        let next_out = match source_scan_namespace_warning_at(file, text, offset, line) {
            Some(result) => out.push(result)
            None => out
        }
        let next = source_next_line_offset(text, offset)
        if next == offset { next_out.freeze() }
        else { source_scan_namespace_warnings_line(file, text, next, line + 1, next_out) }
    }

/// Scan namespace forms not handled by the transition scanner.
def source_scan_namespace_warnings(file: SourceFile): Array[SourceNamespaceScanWarning] =
    source_scan_namespace_warnings_line(file.id, file.text, 0, 1, Vec[SourceNamespaceScanWarning].new())

/// Scan use declarations from line starts.
def source_scan_uses_line(file: SourceFileId, text: String, offset: usize, line: usize, out: Vec[SourceUseScanResult]): Array[SourceUseScanResult] =
    if offset >= text.len() { out.freeze() }
    else {
        let next_out = match source_scan_use_at(file, text, offset, line) {
            Some(result) => out.push(result)
            None => out
        }
        let next = source_next_line_offset(text, offset)
        if next == offset { next_out.freeze() }
        else { source_scan_uses_line(file, text, next, line + 1, next_out) }
    }

/// Scan source use declarations in one file.
def source_scan_uses(file: SourceFile): Array[SourceUseScanResult] =
    source_scan_uses_line(file.id, file.text, 0, 1, Vec[SourceUseScanResult].new())

/// Scan item declarations from line starts, carrying pending line attributes.
def source_scan_items_line(file: SourceFileId, owner_namespace: Option[NamespaceNameSlice], text: String, offset: usize, line: usize, pending_compile_if: Option[SourceCompileIfFacts], pending_world_local: bool, out: Vec[SourceItemScanResult]): Array[SourceItemScanResult] =
    if offset >= text.len() { out.freeze() }
    else {
        let next = source_next_line_offset(text, offset)
        match source_scan_compile_if_facts_at(file, text, offset) {
            Some(facts) => {
                if next == offset { out.freeze() }
                else { source_scan_items_line(file, owner_namespace, text, next, line + 1, Some(facts), pending_world_local, out) }
            }
            None => {
                if source_starts_with_at(text, offset, "#[world_local]", 0) {
                    if next == offset { out.freeze() }
                    else { source_scan_items_line(file, owner_namespace, text, next, line + 1, pending_compile_if, true, out) }
                } else {
                    let attributes = source_item_attributes_from_pending(pending_compile_if, pending_world_local)
                    let next_out = match source_scan_item_at(file, owner_namespace, text, offset, line, attributes) {
                        Some(result) => out.push(result)
                        None => out
                    }
                    let saw_item = match source_scan_item_at(file, owner_namespace, text, offset, line, source_item_attributes_none()) {
                        Some(_) => true
                        None => false
                    }
                    let next_compile_if = if saw_item { None } else { pending_compile_if }
                    let next_world_local = if saw_item { false } else { pending_world_local }
                    if next == offset { next_out.freeze() }
                    else { source_scan_items_line(file, owner_namespace, text, next, line + 1, next_compile_if, next_world_local, next_out) }
                }
            }
        }
    }

/// Return the file-header namespace owner, when the transition scanner found one.
def source_scan_file_owner_namespace(file: SourceFile): Option[NamespaceNameSlice] =
    match source_scan_first_namespace(file) {
        Some(namespace) => Some(namespace.name)
        None => None
    }

/// Scan source item declarations in one file.
def source_scan_items(file: SourceFile): Array[SourceItemScanResult] =
    source_scan_items_line(file.id, source_scan_file_owner_namespace(file), file.text, 0, 1, None, false, Vec[SourceItemScanResult].new())

/// Build one generated-lexer token fact for a source file.
def source_parsed_module_facts_from_scanned_file(file: SourceFile): SourceParsedModuleFacts =
    SourceParsedModuleFacts {
        file: file.id,
        has_token_stream: true,
        has_ast: false,
        ast_primary_path: false,
        ast_item_count: 0,
        ast_namespace_count: 0,
        ast_def_item_count: 0,
        ast_owner_symbol_count: 0,
        ast_from_chibacc: false,
        has_recoverable_errors: false,
    }

/// Return true when every parsed module has real chibacc AST facts.
def source_parsed_module_has_primary_item_facts(module: SourceParsedModuleFacts): bool =
    module.ast_item_count > 0 && module.ast_namespace_count > 0 && module.ast_def_item_count > 0 && module.ast_owner_symbol_count > 0

/// Return true when every parsed module has real chibacc AST facts.
def source_parsed_modules_all_ast_primary(modules: Array[SourceParsedModuleFacts], index: usize): bool =
    if index == modules.len() { true }
    else if modules.get(index).has_ast && modules.get(index).ast_primary_path && modules.get(index).ast_from_chibacc && source_parsed_module_has_primary_item_facts(modules.get(index)) {
        source_parsed_modules_all_ast_primary(modules, index + 1)
    }
    else { false }

/// Return true when frontend evidence belongs to a parsed module.
def source_frontend_evidence_matches_module(evidence: SourceFrontendEvidence, module: SourceParsedModuleFacts): bool =
    evidence.file.index == module.file.index

/// Convert verified frontend evidence into parsed-module primary facts.
def source_parsed_module_with_frontend_evidence(module: SourceParsedModuleFacts, evidence: SourceFrontendEvidence): SourceParsedModuleFacts =
    SourceParsedModuleFacts {
        file: module.file,
        has_token_stream: module.has_token_stream || evidence.has_token_stream,
        has_ast: evidence.has_ast && evidence.ast_item_count > 0,
        ast_primary_path: evidence.has_ast && evidence.ast_from_chibacc && evidence.ast_item_count > 0 && evidence.ast_namespace_count > 0 && evidence.ast_def_item_count > 0 && evidence.ast_owner_symbol_count > 0,
        ast_item_count: evidence.ast_item_count,
        ast_namespace_count: evidence.ast_namespace_count,
        ast_def_item_count: evidence.ast_def_item_count,
        ast_owner_symbol_count: evidence.ast_owner_symbol_count,
        ast_from_chibacc: evidence.ast_from_chibacc,
        has_recoverable_errors: evidence.has_recoverable_errors,
    }

/// Apply one verified generated-frontend evidence fact to parser module facts.
def source_parsed_modules_apply_frontend_evidence(modules: Array[SourceParsedModuleFacts], evidence: SourceFrontendEvidence, index: usize, out: Vec[SourceParsedModuleFacts]): Array[SourceParsedModuleFacts] =
    if index == modules.len() { out.freeze() }
    else {
        let module = modules.get(index)
        let next = if source_frontend_evidence_matches_module(evidence, module) {
            source_parsed_module_with_frontend_evidence(module, evidence)
        } else { module }
        source_parsed_modules_apply_frontend_evidence(modules, evidence, index + 1, out.push(next))
    }

/// Apply generated frontend evidence facts in deterministic order.
def source_parsed_modules_apply_frontend_evidence_all(modules: Array[SourceParsedModuleFacts], evidence: Array[SourceFrontendEvidence], index: usize): Array[SourceParsedModuleFacts] =
    if index == evidence.len() { modules }
    else {
        let next = source_parsed_modules_apply_frontend_evidence(modules, evidence.get(index), 0, Vec[SourceParsedModuleFacts].new())
        source_parsed_modules_apply_frontend_evidence_all(next, evidence, index + 1)
    }

/// Build parser facts in deterministic file order.
def scan_project_parsed_modules_from_files(files: Array[SourceFile], index: usize, out: Vec[SourceParsedModuleFacts]): Array[SourceParsedModuleFacts] =
    if index == files.len() { out.freeze() }
    else { scan_project_parsed_modules_from_files(files, index + 1, out.push(source_parsed_module_facts_from_scanned_file(files.get(index)))) }

/// Build parser facts from scanner tokens plus verified generated frontend evidence.
def scan_project_parser_facts_from_primary_evidence(files: Array[SourceFile], evidence: Array[SourceFrontendEvidence]): SourceParserFacts =
    let scanned = scan_project_parsed_modules_from_files(files, 0, Vec[SourceParsedModuleFacts].new())
    let modules = source_parsed_modules_apply_frontend_evidence_all(scanned, evidence, 0)
    SourceParserFacts {
        mode: SourceFrontendChibalexChibaccPrimary,
        modules: modules,
        chibalex_spec: "src/frontend/chiba-level1.chibalex",
        chibacc_spec: "src/frontend/chiba-level1.chibacc",
        token_primary_path_ready: true,
        ast_primary_path_blocked: source_parsed_modules_all_ast_primary(modules, 0) == false,
        diagnostic: if source_parsed_modules_all_ast_primary(modules, 0) { "" } else { "missing-lowering: chibacc AST primary path still scanner-derived" },
    }

/// Record source parser facts for the generated frontend transition path.
def scan_project_parser_facts_from_primary_tokens(files: Array[SourceFile]): SourceParserFacts =
    scan_project_parser_facts_from_primary_evidence(files, Vec[SourceFrontendEvidence].new().freeze())

/// Build source facts from already loaded files.
def scan_project_source_facts(project: ProjectSurface): SourceProjectFacts =
    SourceProjectFacts {
        parser: scan_project_parser_facts_from_primary_tokens(project.files),
        headers: scan_project_headers(project.files, 0, Vec[SourceHeaderFacts].new()),
        docs: scan_project_docs(project.files, 0, Vec[SourceDocFacts].new()),
        compile_if: scan_project_compile_if(project.files, 0, Vec[SourceCompileIfFacts].new()),
        namespaces: scan_project_namespaces(project.files, 0, Vec[NamespaceScanResult].new()),
        namespace_warnings: scan_project_namespace_warnings(project.files, 0, Vec[SourceNamespaceScanWarning].new()),
        uses: scan_project_uses(project.files, 0, Vec[SourceUseScanResult].new()),
        items: scan_project_items(project.files, 0, Vec[SourceItemScanResult].new()),
        owner_symbols: scan_project_owner_symbols(project.files, 0, Vec[SourceOwnerSymbolFact].new()),
        ast_owner_symbols: source_ast_owner_symbols_from_evidence(Vec[SourceFrontendEvidence].new().freeze(), 0, Vec[SourceAstOwnerSymbolFact].new()),
        ast_expr_nodes: source_ast_expr_nodes_from_evidence(Vec[SourceFrontendEvidence].new().freeze(), 0, Vec[SourceAstExprNodeFact].new()),
        utf8_warnings: scan_project_utf8_warnings(project.files, 0, Vec[SourceUtf8ScanWarning].new()),
    }

/// Convert one primary AST evidence fact into parser-owned owner symbol facts.
def source_ast_owner_symbol_from_evidence(evidence: SourceFrontendEvidence): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: evidence.file,
        owner_namespace: evidence.ast_owner_namespace,
        name: evidence.ast_def_item_name,
        body_shape: evidence.ast_def_body_shape,
        has_i32_const_body: evidence.ast_def_has_i32_const_body,
        i32_const_body: evidence.ast_def_i32_const_body,
        has_i32_add_mul_body: evidence.ast_def_has_i32_add_mul_body,
        has_i32_if_else_body: evidence.ast_def_has_i32_if_else_body,
        has_i32_prefix_neg_body: evidence.ast_def_has_i32_prefix_neg_body,
        has_i32_match_param_body: false,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: 0,
        i32_param_count: 0,
    }

/// Convert one primary expression AST evidence fact into a parser-owned owner symbol.
def source_ast_expression_owner_symbol_from_evidence(evidence: SourceFrontendEvidence): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: evidence.file,
        owner_namespace: evidence.ast_expression_owner_namespace,
        name: evidence.ast_expression_def_item_name,
        body_shape: evidence.ast_expression_body_shape,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: evidence.ast_expression_has_add_mul_body,
        has_i32_if_else_body: evidence.ast_expression_has_if_else_body,
        has_i32_prefix_neg_body: evidence.ast_expression_has_prefix_neg_body,
        has_i32_match_param_body: false,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: 0,
        i32_param_count: 0,
    }

/// Convert one primary branch AST evidence fact into a parser-owned owner symbol.
def source_ast_branch_owner_symbol_from_evidence(evidence: SourceFrontendEvidence): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: evidence.file,
        owner_namespace: evidence.ast_branch_owner_namespace,
        name: evidence.ast_branch_def_item_name,
        body_shape: evidence.ast_branch_body_shape,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: false,
        has_i32_if_else_body: evidence.ast_branch_has_if_else_body,
        has_i32_prefix_neg_body: false,
        has_i32_match_param_body: false,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: 0,
        i32_param_count: 0,
    }

/// Convert one primary prefix-neg AST evidence fact into a parser-owned owner symbol.
def source_ast_neg_owner_symbol_from_evidence(evidence: SourceFrontendEvidence): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: evidence.file,
        owner_namespace: evidence.ast_neg_owner_namespace,
        name: evidence.ast_neg_def_item_name,
        body_shape: evidence.ast_neg_body_shape,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: false,
        has_i32_if_else_body: false,
        has_i32_prefix_neg_body: evidence.ast_neg_has_prefix_neg_body,
        has_i32_match_param_body: false,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: 0,
        i32_param_count: 0,
    }

/// Convert one primary match AST evidence fact into a parser-owned owner symbol.
def source_ast_match_owner_symbol_from_evidence(evidence: SourceFrontendEvidence): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: evidence.file,
        owner_namespace: evidence.ast_match_owner_namespace,
        name: evidence.ast_match_def_item_name,
        body_shape: evidence.ast_match_body_shape,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: false,
        has_i32_if_else_body: false,
        has_i32_prefix_neg_body: false,
        has_i32_match_param_body: evidence.ast_match_has_param_body,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: 0,
        i32_param_count: 1,
    }

/// Return true when an AST node kind can be used as a function body root.
def source_ast_expr_node_is_root_candidate(node: SourceAstExprNodeFact): bool =
    match node.kind {
        SourceAstExprNodeI32Const => true
        SourceAstExprNodeParam => true
        SourceAstExprNodeBinary => true
        SourceAstExprNodePrefixNeg => true
        SourceAstExprNodeIfElse => true
        SourceAstExprNodeMatch => true
        SourceAstExprNodeCall => true
        SourceAstExprNodeMethodCall => true
        SourceAstExprNodeIndex => true
        SourceAstExprNodeIndexSlice => true
        SourceAstExprNodeLocal => true
        SourceAstExprNodeStringLiteral => true
        SourceAstExprNodeCast => true
        SourceAstExprNodeStructNew => true
        SourceAstExprNodeFieldGet => true
        SourceAstExprNodeUnknown => false
    }

/// Return true when a direct AST owner symbol is already present.
def source_ast_owner_pair_eq(left_ns: str, left_name: str, right_ns: str, right_name: str): bool =
    if left_ns == right_ns {
        left_name == right_name
    } else { false }

/// Return true when a direct AST owner symbol is already present.
def source_ast_owner_symbol_in_evidence_slots(evidence: SourceFrontendEvidence, namespace: str, name: str): bool =
    if source_ast_owner_pair_eq(evidence.ast_owner_namespace, evidence.ast_def_item_name, namespace, name) { true }
    else if source_ast_owner_pair_eq(evidence.ast_branch_owner_namespace, evidence.ast_branch_def_item_name, namespace, name) { true }
    else if source_ast_owner_pair_eq(evidence.ast_neg_owner_namespace, evidence.ast_neg_def_item_name, namespace, name) { true }
    else if source_ast_owner_pair_eq(evidence.ast_match_owner_namespace, evidence.ast_match_def_item_name, namespace, name) { true }
    else if source_ast_owner_pair_eq(evidence.ast_expression_owner_namespace, evidence.ast_expression_def_item_name, namespace, name) { true }
    else { false }

/// Return true when a node belongs to one owner.
def source_ast_node_owner_eq(node: SourceAstExprNodeFact, namespace: str, name: str): bool =
    source_ast_owner_pair_eq(node.owner_namespace, node.owner_name, namespace, name)

/// Return true when a node is a direct root for one owner.
def source_ast_node_is_direct_root(node: SourceAstExprNodeFact): bool =
    if node.node_id == 0 { source_ast_expr_node_is_root_candidate(node) } else { false }

/// Return true when an earlier direct AST root already introduced the same owner.
def source_ast_direct_root_seen_before(nodes: Array[SourceAstExprNodeFact], current: usize, namespace: str, name: str, index: usize): bool =
    if index >= current { false }
    else {
        let node = nodes.get(index)
        if node.node_id == 0 && source_ast_node_owner_eq(node, namespace, name) { true }
        else { source_ast_direct_root_seen_before(nodes, current, namespace, name, index + 1) }
    }

/// Convert one direct AST root node into a parser-owned owner symbol.
def source_ast_owner_symbol_from_direct_node(evidence: SourceFrontendEvidence, node: SourceAstExprNodeFact): SourceAstOwnerSymbolFact =
    SourceAstOwnerSymbolFact {
        file: node.file,
        owner_namespace: node.owner_namespace,
        name: node.owner_name,
        body_shape: SourceAstExprUnknown,
        has_i32_const_body: false,
        i32_const_body: 0,
        has_i32_add_mul_body: false,
        has_i32_if_else_body: false,
        has_i32_prefix_neg_body: false,
        has_i32_match_param_body: false,
        namespace_count: evidence.ast_namespace_count,
        def_item_count: evidence.ast_def_item_count,
        from_chibacc: evidence.ast_from_chibacc,
        root_node_id: node.node_id,
        i32_param_count: source_ast_owner_param_count(evidence.ast_expr_nodes, node.owner_namespace, node.owner_name, 0, 0),
    }

/// Infer an AST-owned function i32 param count from its direct expression nodes.
def source_ast_node_param_count_candidate(node: SourceAstExprNodeFact, namespace: str, name: str, count: usize): usize =
    if source_ast_node_owner_eq(node, namespace, name) {
        match node.kind {
            SourceAstExprNodeParam =>
                if node.param_index + 1 > count { node.param_index + 1 } else { count }
            SourceAstExprNodeLocal =>
                if node.param_index + 1 > count { node.param_index + 1 } else { count }
            _ => count
        }
    } else { count }

/// Infer an AST-owned function i32 param count from its direct expression nodes.
def source_ast_owner_param_count(nodes: Array[SourceAstExprNodeFact], namespace: str, name: str, index: usize, count: usize): usize =
    if index == nodes.len() { count }
    else {
        let node = nodes.get(index)
        let next_count = source_ast_node_param_count_candidate(node, namespace, name, count)
        source_ast_owner_param_count(nodes, namespace, name, index + 1, next_count)
    }

/// Append parser-owned owner symbols discovered from direct AST root nodes.
def source_ast_should_append_direct_root(evidence: SourceFrontendEvidence, nodes: Array[SourceAstExprNodeFact], index: usize, node: SourceAstExprNodeFact): bool =
    if source_ast_node_is_direct_root(node) == false { false }
    else if source_ast_owner_symbol_in_evidence_slots(evidence, node.owner_namespace, node.owner_name) { false }
    else { source_ast_direct_root_seen_before(nodes, index, node.owner_namespace, node.owner_name, 0) == false }

/// Append parser-owned owner symbols discovered from direct AST root nodes.
def source_ast_owner_symbols_append_direct_roots(evidence: SourceFrontendEvidence, nodes: Array[SourceAstExprNodeFact], index: usize, out: Vec[SourceAstOwnerSymbolFact]): Vec[SourceAstOwnerSymbolFact] =
    if index == nodes.len() { out }
    else {
        let node = nodes.get(index)
        if source_ast_should_append_direct_root(evidence, nodes, index, node) {
            source_ast_owner_symbols_append_direct_roots(evidence, nodes, index + 1, out.push(source_ast_owner_symbol_from_direct_node(evidence, node)))
        } else {
            source_ast_owner_symbols_append_direct_roots(evidence, nodes, index + 1, out)
        }
    }

/// Build parser-owned owner symbol facts from verified chibacc evidence.
def source_ast_owner_symbols_from_evidence(evidence: Array[SourceFrontendEvidence], index: usize, out: Vec[SourceAstOwnerSymbolFact]): Array[SourceAstOwnerSymbolFact] =
    if index == evidence.len() { out.freeze() }
    else {
        let item = evidence.get(index)
        let has_direct_nodes = if item.ast_from_chibacc { item.ast_expr_nodes.len() > 0 } else { true }
        let with_item = if has_direct_nodes && item.ast_owner_symbol_count > 0 && item.ast_namespace_count > 0 && item.ast_def_item_count > 0 && item.ast_owner_namespace.len() > 0 && item.ast_def_item_name.len() > 0 && (item.ast_def_has_i32_const_body || item.ast_def_has_i32_add_mul_body || item.ast_def_has_i32_if_else_body || item.ast_def_has_i32_prefix_neg_body) {
            out.push(source_ast_owner_symbol_from_evidence(item))
        } else { out }
        let with_branch = if has_direct_nodes && item.ast_branch_owner_namespace.len() > 0 && item.ast_branch_def_item_name.len() > 0 && item.ast_branch_has_if_else_body {
            with_item.push(source_ast_branch_owner_symbol_from_evidence(item))
        } else { with_item }
        let with_neg = if has_direct_nodes && item.ast_neg_owner_namespace.len() > 0 && item.ast_neg_def_item_name.len() > 0 && item.ast_neg_has_prefix_neg_body {
            with_branch.push(source_ast_neg_owner_symbol_from_evidence(item))
        } else { with_branch }
        let with_match = if has_direct_nodes && item.ast_match_owner_namespace.len() > 0 && item.ast_match_def_item_name.len() > 0 && item.ast_match_has_param_body {
            with_neg.push(source_ast_match_owner_symbol_from_evidence(item))
        } else { with_neg }
        let with_expr = if has_direct_nodes && item.ast_expression_owner_namespace.len() > 0 && item.ast_expression_def_item_name.len() > 0 && (item.ast_expression_has_add_mul_body || item.ast_expression_has_if_else_body || item.ast_expression_has_prefix_neg_body) {
            with_match.push(source_ast_expression_owner_symbol_from_evidence(item))
        } else { with_match }
        let with_direct_roots = if item.ast_expr_nodes.len() > 0 {
            source_ast_owner_symbols_append_direct_roots(item, item.ast_expr_nodes, 0, with_expr)
        } else { with_expr }
        source_ast_owner_symbols_from_evidence(evidence, index + 1, with_direct_roots)
    }

/// Append one parser-owned AST expression node fact.
def source_ast_expr_node_push(out: Vec[SourceAstExprNodeFact], evidence: SourceFrontendEvidence, owner: String, name: String, node_id: usize, kind: SourceAstExprNodeKind, value: usize, param_index: usize, left: usize, right: usize, then_node: usize, else_node: usize): Vec[SourceAstExprNodeFact] =
    out.push(SourceAstExprNodeFact {
        file: evidence.file,
        owner_namespace: owner,
        owner_name: name,
        node_id: node_id,
        kind: kind,
        value: value,
        param_index: param_index,
        left: left,
        right: right,
        then_node: then_node,
        else_node: else_node,
        callee: "",
        member: "",
        args: Vec[usize].new().freeze(),
        arg0: 0,
        arg1: 0,
        arg2: 0,
        arg_count: 0,
    })

/// Append parser-owned AST expression node facts supplied directly by frontend evidence.
def source_ast_expr_nodes_append_direct(nodes: Array[SourceAstExprNodeFact], index: usize, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    if index == nodes.len() { out }
    else { source_ast_expr_nodes_append_direct(nodes, index + 1, out.push(nodes.get(index))) }

/// Append recursive AST expression nodes for the generated `main = 2 + 3 * 4` slice.
/// Binary node value uses PrimitiveBinaryOp ordinal: add=0, sub=1, mul=2, div=3.
def source_ast_expr_nodes_add_mul(evidence: SourceFrontendEvidence, owner: String, name: String, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    source_ast_expr_node_push(
        source_ast_expr_node_push(
            source_ast_expr_node_push(
                source_ast_expr_node_push(
                    source_ast_expr_node_push(out, evidence, owner, name, 0, SourceAstExprNodeBinary, 0, 0, 1, 2, 0, 0),
                    evidence, owner, name, 1, SourceAstExprNodeI32Const, 2, 0, 0, 0, 0, 0),
                evidence, owner, name, 2, SourceAstExprNodeBinary, 2, 0, 3, 4, 0, 0),
            evidence, owner, name, 3, SourceAstExprNodeI32Const, 3, 0, 0, 0, 0, 0),
        evidence, owner, name, 4, SourceAstExprNodeI32Const, 4, 0, 0, 0, 0, 0)

/// Append recursive AST expression nodes for the generated branch slice.
def source_ast_expr_nodes_if_else(evidence: SourceFrontendEvidence, owner: String, name: String, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    source_ast_expr_node_push(
        source_ast_expr_node_push(
            source_ast_expr_node_push(out, evidence, owner, name, 0, SourceAstExprNodeIfElse, 0, 0, 0, 0, 1, 2),
            evidence, owner, name, 1, SourceAstExprNodeI32Const, 7, 0, 0, 0, 0, 0),
        evidence, owner, name, 2, SourceAstExprNodeI32Const, 13, 0, 0, 0, 0, 0)

/// Append recursive AST expression nodes for the generated prefix-neg slice.
def source_ast_expr_nodes_prefix_neg(evidence: SourceFrontendEvidence, owner: String, name: String, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    source_ast_expr_node_push(
        source_ast_expr_node_push(out, evidence, owner, name, 0, SourceAstExprNodePrefixNeg, 0, 0, 1, 0, 0, 0),
        evidence, owner, name, 1, SourceAstExprNodeI32Const, 7, 0, 0, 0, 0, 0)

/// Append recursive AST expression nodes for the generated match-param slice.
def source_ast_expr_nodes_match_param(evidence: SourceFrontendEvidence, owner: String, name: String, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    source_ast_expr_node_push(
        source_ast_expr_node_push(
            source_ast_expr_node_push(
                source_ast_expr_node_push(out, evidence, owner, name, 0, SourceAstExprNodeMatch, 0, 0, 1, 0, 2, 3),
                evidence, owner, name, 1, SourceAstExprNodeParam, 0, 0, 0, 0, 0, 0),
            evidence, owner, name, 2, SourceAstExprNodeI32Const, 7, 0, 0, 0, 0, 0),
        evidence, owner, name, 3, SourceAstExprNodeI32Const, 13, 0, 0, 0, 0, 0)

/// Append AST expression nodes for one parser-owned symbol shape.
def source_ast_expr_nodes_for_shape(evidence: SourceFrontendEvidence, owner: String, name: String, shape: SourceAstExprShape, out: Vec[SourceAstExprNodeFact]): Vec[SourceAstExprNodeFact] =
    match shape {
        SourceAstExprI32AddMul => source_ast_expr_nodes_add_mul(evidence, owner, name, out)
        SourceAstExprI32IfElse => source_ast_expr_nodes_if_else(evidence, owner, name, out)
        SourceAstExprI32PrefixNeg => source_ast_expr_nodes_prefix_neg(evidence, owner, name, out)
        SourceAstExprI32MatchParam => source_ast_expr_nodes_match_param(evidence, owner, name, out)
        SourceAstExprI32Const => source_ast_expr_node_push(out, evidence, owner, name, 0, SourceAstExprNodeI32Const, evidence.ast_def_i32_const_body, 0, 0, 0, 0, 0)
        SourceAstExprUnknown => out
    }

/// Build parser-owned recursive expression node facts from verified chibacc evidence.
def source_ast_expr_nodes_from_evidence(evidence: Array[SourceFrontendEvidence], index: usize, out: Vec[SourceAstExprNodeFact]): Array[SourceAstExprNodeFact] =
    if index == evidence.len() { out.freeze() }
    else {
        let item = evidence.get(index)
        let with_match = if item.ast_expr_nodes.len() > 0 {
            source_ast_expr_nodes_append_direct(item.ast_expr_nodes, 0, out)
        } else {
            let with_main = if item.ast_owner_namespace.len() > 0 && item.ast_def_item_name.len() > 0 {
                source_ast_expr_nodes_for_shape(item, item.ast_owner_namespace, item.ast_def_item_name, item.ast_def_body_shape, out)
            } else { out }
            let with_branch = if item.ast_branch_owner_namespace.len() > 0 && item.ast_branch_def_item_name.len() > 0 {
                source_ast_expr_nodes_for_shape(item, item.ast_branch_owner_namespace, item.ast_branch_def_item_name, item.ast_branch_body_shape, with_main)
            } else { with_main }
            let with_neg = if item.ast_neg_owner_namespace.len() > 0 && item.ast_neg_def_item_name.len() > 0 {
                source_ast_expr_nodes_for_shape(item, item.ast_neg_owner_namespace, item.ast_neg_def_item_name, item.ast_neg_body_shape, with_branch)
            } else { with_branch }
            if item.ast_match_owner_namespace.len() > 0 && item.ast_match_def_item_name.len() > 0 {
                source_ast_expr_nodes_for_shape(item, item.ast_match_owner_namespace, item.ast_match_def_item_name, item.ast_match_body_shape, with_neg)
            } else { with_neg }
        }
        source_ast_expr_nodes_from_evidence(evidence, index + 1, with_match)
    }

/// Build source facts with verified chibalex/chibacc frontend evidence.
def scan_project_source_facts_from_primary_evidence(project: ProjectSurface, evidence: Array[SourceFrontendEvidence]): SourceProjectFacts =
    SourceProjectFacts {
        parser: scan_project_parser_facts_from_primary_evidence(project.files, evidence),
        headers: scan_project_headers(project.files, 0, Vec[SourceHeaderFacts].new()),
        docs: scan_project_docs(project.files, 0, Vec[SourceDocFacts].new()),
        compile_if: scan_project_compile_if(project.files, 0, Vec[SourceCompileIfFacts].new()),
        namespaces: scan_project_namespaces(project.files, 0, Vec[NamespaceScanResult].new()),
        namespace_warnings: scan_project_namespace_warnings(project.files, 0, Vec[SourceNamespaceScanWarning].new()),
        uses: scan_project_uses(project.files, 0, Vec[SourceUseScanResult].new()),
        items: scan_project_items(project.files, 0, Vec[SourceItemScanResult].new()),
        owner_symbols: scan_project_owner_symbols(project.files, 0, Vec[SourceOwnerSymbolFact].new()),
        ast_owner_symbols: source_ast_owner_symbols_from_evidence(evidence, 0, Vec[SourceAstOwnerSymbolFact].new()),
        ast_expr_nodes: source_ast_expr_nodes_from_evidence(evidence, 0, Vec[SourceAstExprNodeFact].new()),
        utf8_warnings: scan_project_utf8_warnings(project.files, 0, Vec[SourceUtf8ScanWarning].new()),
    }

/// Replace parser facts with verified primary frontend evidence while preserving loaded files.
def project_with_primary_frontend_evidence(project: ProjectSurface, evidence: Array[SourceFrontendEvidence]): ProjectSurface =
    ProjectSurface {
        files: project.files,
        namespaces: project.namespaces,
        facts: scan_project_source_facts_from_primary_evidence(project, evidence),
    }

/// Scan header facts in deterministic file order.
def scan_project_headers(files: Array[SourceFile], index: usize, out: Vec[SourceHeaderFacts]): Array[SourceHeaderFacts] =
    if index == files.len() { out.freeze() }
    else { scan_project_headers(files, index + 1, out.push(source_scan_header(files.get(index)))) }

/// Scan doc facts in deterministic file order.
def scan_project_docs(files: Array[SourceFile], index: usize, out: Vec[SourceDocFacts]): Array[SourceDocFacts] =
    if index == files.len() { out.freeze() }
    else { scan_project_docs(files, index + 1, out.push(source_scan_doc_facts(files.get(index)))) }

/// Scan compile_if facts in deterministic file order.
def scan_project_compile_if(files: Array[SourceFile], index: usize, out: Vec[SourceCompileIfFacts]): Array[SourceCompileIfFacts] =
    if index == files.len() { out.freeze() }
    else { scan_project_compile_if(files, index + 1, out.push(source_scan_compile_if_facts(files.get(index)))) }

/// Append item scan results for one file.
def scan_project_items_append(items: Array[SourceItemScanResult], index: usize, out: Vec[SourceItemScanResult]): Vec[SourceItemScanResult] =
    if index == items.len() { out }
    else { scan_project_items_append(items, index + 1, out.push(items.get(index))) }

/// Scan item facts in deterministic file order.
def scan_project_items(files: Array[SourceFile], index: usize, out: Vec[SourceItemScanResult]): Array[SourceItemScanResult] =
    if index == files.len() { out.freeze() }
    else { scan_project_items(files, index + 1, scan_project_items_append(source_scan_items(files.get(index)), 0, out)) }

/// Append owner symbol facts for scanned items.
def source_owner_symbols_from_items(items: Array[SourceItemScanResult], index: usize, out: Vec[SourceOwnerSymbolFact]): Vec[SourceOwnerSymbolFact] =
    if index == items.len() { out }
    else {
        let item = items.get(index)
        source_owner_symbols_from_items(
            items,
            index + 1,
            out.push(SourceOwnerSymbolFact {
                file: item.file,
                owner_namespace: item.owner_namespace,
                name: item.name,
                kind: item.kind,
                private: item.private,
                line: item.line,
                column: item.column,
            }))
    }

/// Scan owner-scoped symbol facts in deterministic file order.
def scan_project_owner_symbols(files: Array[SourceFile], index: usize, out: Vec[SourceOwnerSymbolFact]): Array[SourceOwnerSymbolFact] =
    if index == files.len() { out.freeze() }
    else { scan_project_owner_symbols(files, index + 1, source_owner_symbols_from_items(source_scan_items(files.get(index)), 0, out)) }

/// Append use scan results for one file.
def scan_project_uses_append(uses: Array[SourceUseScanResult], index: usize, out: Vec[SourceUseScanResult]): Vec[SourceUseScanResult] =
    if index == uses.len() { out }
    else { scan_project_uses_append(uses, index + 1, out.push(uses.get(index))) }

/// Scan use declarations in deterministic file order.
def scan_project_uses(files: Array[SourceFile], index: usize, out: Vec[SourceUseScanResult]): Array[SourceUseScanResult] =
    if index == files.len() { out.freeze() }
    else { scan_project_uses(files, index + 1, scan_project_uses_append(source_scan_uses(files.get(index)), 0, out)) }

/// Append UTF-8 scan warnings for one file.
def scan_project_utf8_warnings_append(warnings: Array[SourceUtf8ScanWarning], index: usize, out: Vec[SourceUtf8ScanWarning]): Vec[SourceUtf8ScanWarning] =
    if index == warnings.len() { out }
    else { scan_project_utf8_warnings_append(warnings, index + 1, out.push(warnings.get(index))) }

/// Scan UTF-8 warnings in deterministic file order.
def scan_project_utf8_warnings(files: Array[SourceFile], index: usize, out: Vec[SourceUtf8ScanWarning]): Array[SourceUtf8ScanWarning] =
    if index == files.len() { out.freeze() }
    else { scan_project_utf8_warnings(files, index + 1, scan_project_utf8_warnings_append(source_scan_utf8_warnings(files.get(index)), 0, out)) }

/// Scan namespace facts in deterministic file order.
def scan_project_namespaces(files: Array[SourceFile], index: usize, out: Vec[NamespaceScanResult]): Array[NamespaceScanResult] =
    if index == files.len() { out.freeze() }
    else {
        match source_scan_first_namespace(files.get(index)) {
            Some(result) => scan_project_namespaces(files, index + 1, out.push(result))
            None => scan_project_namespaces(files, index + 1, out)
        }
    }

/// Append namespace warnings for one file.
def scan_project_namespace_warnings_append(warnings: Array[SourceNamespaceScanWarning], index: usize, out: Vec[SourceNamespaceScanWarning]): Vec[SourceNamespaceScanWarning] =
    if index == warnings.len() { out }
    else { scan_project_namespace_warnings_append(warnings, index + 1, out.push(warnings.get(index))) }

/// Scan namespace warnings in deterministic file order.
def scan_project_namespace_warnings(files: Array[SourceFile], index: usize, out: Vec[SourceNamespaceScanWarning]): Array[SourceNamespaceScanWarning] =
    if index == files.len() { out.freeze() }
    else { scan_project_namespace_warnings(files, index + 1, scan_project_namespace_warnings_append(source_scan_namespace_warnings(files.get(index)), 0, out)) }
