/// Source-level semantic gates before body type checking.
namespace compiler.source.semantic_gate

use compiler.source.project.*

/// Source semantic gate error kind.
data SourceGateErrorKind {
    SourceGateUtf8ScannerUnsupported,
    SourceGateUnknownCompileIfPredicate,
    SourceGateMissingNamespace,
    SourceGateItemScanAbsent,
    SourceGateTypedItemLoweringAbsent,
    SourceGateTopLevelRefNeedsWorldLocal,
    SourceGateAtomicPayloadUnsupported,
    SourceGateAtomicLoadOrdering,
    SourceGateAtomicStoreOrdering,
    SourceGatePtrNeedsUnsafe,
    SourceGateUnsafeRefNeedsUnsafe,
    SourceGateMetalPointerMustUsePtr,
    SourceGateRefArrayDirectAssignment,
    SourceGateUnresolvedMethod,
    SourceGateRowMissingField,
}

/// Source semantic gate error.
type SourceGateError {
    file: SourceFileId,
    kind: SourceGateErrorKind,
    message: String,
}

/// Result of source-level semantic gates.
type SourceGateResult {
    project: ProjectSurface,
    errors: Array[SourceGateError],
}

/// Check source-level capability and surface rules using parsed project facts.
def check_source_semantic_gates(project: ProjectSurface): SourceGateResult =
    SourceGateResult(
        project,
        source_gate_errors(project))

/// Return true when project source facts contain at least one namespace.
def source_project_has_namespace(project: ProjectSurface): bool =
    project.facts.namespaces.len() > 0

/// Return true when project source facts contain at least one item declaration.
def source_project_has_item(project: ProjectSurface): bool =
    project.facts.items.len() > 0

/// Return true when byte-level scanner saw non-ASCII source before UTF-8 scanner support exists.
def source_project_has_utf8_warning(project: ProjectSurface): bool =
    project.facts.utf8_warnings.len() > 0

/// Return true when any compile_if fact contains an unknown predicate shape.
def source_compile_if_has_unknown(facts: Array[SourceCompileIfFacts], index: usize): bool =
    if index == facts.len() { false }
    else if facts.get(index).has_unknown_predicate { true }
    else {
        match facts.get(index).shape {
            SourceCompileIfUnknown => true
            _ => source_compile_if_has_unknown(facts, index + 1)
        }
    }

/// Return true when project source facts contain an unsupported compile_if predicate.
def source_project_has_unknown_compile_if(project: ProjectSurface): bool =
    source_compile_if_has_unknown(project.facts.compile_if, 0)

/// Build fail-closed source gate diagnostics from source scan facts.
def source_gate_errors(project: ProjectSurface): Array[SourceGateError] =
    if source_project_has_utf8_warning(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateUtf8ScannerUnsupported,
                "missing-facts: UTF-8 aware source scanner absent"))
            .freeze()
    } else if source_project_has_unknown_compile_if(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateUnknownCompileIfPredicate,
                "missing-facts: unknown compile_if predicate shape"))
            .freeze()
    } else if source_project_has_namespace(project) == false {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateMissingNamespace,
                "missing-facts: namespace scan found no namespace"))
            .freeze()
    } else if source_project_has_item(project) == false {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateItemScanAbsent,
                "missing-facts: source item scan absent"))
            .freeze()
    } else {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateTypedItemLoweringAbsent,
                "missing-lowering: typed item lowering absent"))
            .freeze()
    }

/// Return true when the gate result can continue to type checking.
def SourceGateResult.ok(self): bool =
    self.errors.len() == 0
