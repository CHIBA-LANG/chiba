/// Source-level semantic gates before body type checking.
namespace compiler.source.semantic_gate

use compiler.source.project.*
use compiler.source.import_policy.*

/// Source semantic gate error kind.
data SourceGateErrorKind {
    SourceGateParserPrimaryPathAbsent,
    SourceGateUtf8ScannerUnsupported,
    SourceGateUnknownCompileIfPredicate,
    SourceGateCompileIfFilteringAbsent,
    SourceGateInlineNamespaceUnsupported,
    SourceGateImportResolutionAbsent,
    SourceGateExternAbiSignatureAbsent,
    SourceGateTopLevelRefNeedsWorldLocal,
    SourceGateDefBodyAbsent,
    SourceGateSelfOutsideMethod,
    SourceGateDuplicateItem,
    SourceGateMissingNamespace,
    SourceGateItemScanAbsent,
    SourceGateTypedItemLoweringAbsent,
    SourceGateAtomicPayloadUnsupported,
    SourceGateAtomicLoadOrdering,
    SourceGateAtomicStoreOrdering,
    SourceGatePtrNeedsUnsafe,
    SourceGateUnsafeRefNeedsUnsafe,
    SourceGateMetalPointerMustUsePtr,
    SourceGateRefArrayDirectAssignment,
    SourceGateUnresolvedMethod,
    SourceGateRowMissingField,
}

/// Source semantic gate error.
type SourceGateError {
    file: SourceFileId,
    kind: SourceGateErrorKind,
    message: String,
}

/// Result of source-level semantic gates.
type SourceGateResult {
    project: ProjectSurface,
    errors: Array[SourceGateError],
}

/// Check source-level capability and surface rules using parsed project facts.
def check_source_semantic_gates(project: ProjectSurface): SourceGateResult =
    SourceGateResult(
        project,
        source_gate_errors(project))

/// Return true when project source facts contain at least one namespace.
def source_project_has_namespace(project: ProjectSurface): bool =
    project.facts.namespaces.len() > 0

/// Return true when project source facts contain at least one item declaration.
def source_project_has_item(project: ProjectSurface): bool =
    project.facts.items.len() > 0

/// Return true when byte-level scanner saw non-ASCII source before UTF-8 scanner support exists.
def source_project_has_utf8_warning(project: ProjectSurface): bool =
    project.facts.utf8_warnings.len() > 0

/// Return true when project facts still come from scanner fallback.
def source_project_parser_primary_blocked(project: ProjectSurface): bool =
    project.facts.parser.primary_path_blocked

/// Return true when project source facts contain namespace forms needing full parser assembly.
def source_project_has_namespace_warning(project: ProjectSurface): bool =
    project.facts.namespace_warnings.len() > 0

/// Return true when any compile_if fact contains an unknown predicate shape.
def source_compile_if_has_unknown(facts: Array[SourceCompileIfFacts], index: usize): bool =
    if index == facts.len() { false }
    else if facts.get(index).has_unknown_predicate { true }
    else {
        match facts.get(index).shape {
            SourceCompileIfUnknown => true
            _ => source_compile_if_has_unknown(facts, index + 1)
        }
    }

/// Return true when project source facts contain an unsupported compile_if predicate.
def source_project_has_unknown_compile_if(project: ProjectSurface): bool =
    source_compile_if_has_unknown(project.facts.compile_if, 0)

/// Return true when item scan has compile_if attributes that have not been filtered.
def source_items_have_compile_if(items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else {
        match items.get(index).attributes.compile_if {
            Some(_) => true
            None => source_items_have_compile_if(items, index + 1)
        }
    }

/// Return true when project items still need compile_if filtering.
def source_project_has_unfiltered_compile_if_items(project: ProjectSurface): bool =
    source_items_have_compile_if(project.facts.items, 0)

/// Return true when an extern item lacks any scanned ABI type annotation.
def source_items_have_extern_without_type_annotation(items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else {
        let item = items.get(index)
        match item.kind {
            SourceItemExtern => {
                if item.surface.has_type_annotation { source_items_have_extern_without_type_annotation(items, index + 1) }
                else { true }
            }
            _ => source_items_have_extern_without_type_annotation(items, index + 1)
        }
    }

/// Return true when project source facts contain an extern requiring ABI signature parsing.
def source_project_has_extern_without_type_annotation(project: ProjectSurface): bool =
    source_items_have_extern_without_type_annotation(project.facts.items, 0)

/// Return true when a top-level static Ref lacks the required world-local marker.
def source_items_have_static_ref_without_world_local(items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else {
        let item = items.get(index)
        match item.kind {
            SourceItemDef => {
                if item.surface.has_params {
                    source_items_have_static_ref_without_world_local(items, index + 1)
                } else if item.surface.has_ref_type && item.attributes.world_local == false {
                    true
                } else {
                    source_items_have_static_ref_without_world_local(items, index + 1)
                }
            }
            _ => source_items_have_static_ref_without_world_local(items, index + 1)
        }
    }

/// Return true when project source facts contain a static Ref missing world-local.
def source_project_has_static_ref_without_world_local(project: ProjectSurface): bool =
    source_items_have_static_ref_without_world_local(project.facts.items, 0)

/// Return true when a source def lacks a scanned body or initializer marker.
def source_items_have_def_without_body(items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else {
        let item = items.get(index)
        match item.kind {
            SourceItemDef => {
                if item.surface.has_body { source_items_have_def_without_body(items, index + 1) }
                else { true }
            }
            _ => source_items_have_def_without_body(items, index + 1)
        }
    }

/// Return true when project source facts contain a def needing body parsing.
def source_project_has_def_without_body(project: ProjectSurface): bool =
    source_items_have_def_without_body(project.facts.items, 0)

/// Return true when a source item mentions `Self` outside method receiver scope.
def source_items_have_self_outside_method(items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else {
        let item = items.get(index)
        if item.surface.has_self_type && item.surface.has_method_receiver == false { true }
        else { source_items_have_self_outside_method(items, index + 1) }
    }

/// Return true when project source facts contain illegal `Self` use.
def source_project_has_self_outside_method(project: ProjectSurface): bool =
    source_items_have_self_outside_method(project.facts.items, 0)

/// Return the source text for a scanned file id.
def source_project_file_text(files: Array[SourceFile], file: SourceFileId, index: usize): String =
    if index == files.len() { "" }
    else {
        let item = files.get(index)
        if item.id.index == file.index { item.text }
        else { source_project_file_text(files, file, index + 1) }
    }

/// Compare two source slices byte-for-byte.
def source_slices_equal(left_text: String, left_offset: usize, right_text: String, right_offset: usize, len: usize, index: usize): bool =
    if index == len { true }
    else if left_offset + index >= left_text.len() { false }
    else if right_offset + index >= right_text.len() { false }
    else if left_text.byte_at(left_offset + index) == right_text.byte_at(right_offset + index) {
        source_slices_equal(left_text, left_offset, right_text, right_offset, len, index + 1)
    } else { false }

/// Compare two source item name slices by source text.
def source_name_slices_equal(project: ProjectSurface, left_file: SourceFileId, left: SourceNameSlice, right_file: SourceFileId, right: SourceNameSlice): bool =
    if left.len != right.len { false }
    else {
        source_slices_equal(
            source_project_file_text(project.files, left_file, 0),
            left.offset,
            source_project_file_text(project.files, right_file, 0),
            right.offset,
            left.len,
            0)
    }

/// Compare two namespace owner slices by source text.
def source_namespace_slices_equal(project: ProjectSurface, left_file: SourceFileId, left: NamespaceNameSlice, right_file: SourceFileId, right: NamespaceNameSlice): bool =
    if left.len != right.len { false }
    else {
        source_slices_equal(
            source_project_file_text(project.files, left_file, 0),
            left.offset,
            source_project_file_text(project.files, right_file, 0),
            right.offset,
            left.len,
            0)
    }

/// Return true when two optional owner namespaces are the same namespace.
def source_owner_namespace_equal(project: ProjectSurface, left: SourceItemScanResult, right: SourceItemScanResult): bool =
    match left.owner_namespace {
        None =>
            match right.owner_namespace {
                None => true
                Some(_) => false
            }
        Some(left_ns) =>
            match right.owner_namespace {
                Some(right_ns) => source_namespace_slices_equal(project, left.file, left_ns, right.file, right_ns)
                None => false
            }
    }

/// Return true when two scanned items have the same source-facing name.
def source_item_name_equal(project: ProjectSurface, left: SourceItemScanResult, right: SourceItemScanResult): bool =
    match left.name {
        None => false
        Some(left_name) =>
            match right.name {
                Some(right_name) => source_name_slices_equal(project, left.file, left_name, right.file, right_name)
                None => false
            }
    }

/// Return true when one item duplicates a later item in the same namespace.
def source_item_has_later_duplicate(project: ProjectSurface, items: Array[SourceItemScanResult], left_index: usize, right_index: usize): bool =
    if right_index == items.len() { false }
    else {
        let left = items.get(left_index)
        let right = items.get(right_index)
        if source_owner_namespace_equal(project, left, right) && source_item_name_equal(project, left, right) { true }
        else { source_item_has_later_duplicate(project, items, left_index, right_index + 1) }
    }

/// Return true when scanned items contain a duplicate in one namespace.
def source_items_have_duplicate_item(project: ProjectSurface, items: Array[SourceItemScanResult], index: usize): bool =
    if index == items.len() { false }
    else if source_item_has_later_duplicate(project, items, index, index + 1) { true }
    else { source_items_have_duplicate_item(project, items, index + 1) }

/// Return true when project source facts contain duplicate item names.
def source_project_has_duplicate_item(project: ProjectSurface): bool =
    source_items_have_duplicate_item(project, project.facts.items, 0)

/// Build fail-closed source gate diagnostics from source scan facts.
def source_gate_errors(project: ProjectSurface): Array[SourceGateError] =
    if source_project_has_utf8_warning(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateUtf8ScannerUnsupported,
                "missing-facts: UTF-8 aware source scanner absent"))
            .freeze()
    } else if source_project_has_unknown_compile_if(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateUnknownCompileIfPredicate,
                "missing-facts: unknown compile_if predicate shape"))
            .freeze()
    } else if source_project_has_namespace_warning(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateInlineNamespaceUnsupported,
                "missing-lowering: inline namespace block assembly absent"))
            .freeze()
    } else if source_project_has_namespace(project) == false {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateMissingNamespace,
                "missing-facts: namespace scan found no namespace"))
            .freeze()
    } else if source_project_has_item(project) == false {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateItemScanAbsent,
                "missing-facts: source item scan absent"))
            .freeze()
    } else if source_project_has_unfiltered_compile_if_items(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateCompileIfFilteringAbsent,
                "missing-lowering: item compile_if filtering absent"))
            .freeze()
    } else if source_project_has_extern_without_type_annotation(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateExternAbiSignatureAbsent,
                "missing-facts: extern ABI signature type annotations absent"))
            .freeze()
    } else if source_project_has_static_ref_without_world_local(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateTopLevelRefNeedsWorldLocal,
                "missing-attribute: top-level Ref requires world_local"))
            .freeze()
    } else if source_project_has_def_without_body(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateDefBodyAbsent,
                "missing-facts: source def body or initializer absent"))
            .freeze()
    } else if source_project_has_self_outside_method(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateSelfOutsideMethod,
                "invalid-surface: Self only valid in method receiver scope"))
            .freeze()
    } else if source_project_has_duplicate_item(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateDuplicateItem,
                "invalid-surface: duplicate item in namespace"))
            .freeze()
    } else if source_project_needs_import_resolution(project) {
        Vec[SourceGateError].new()
            .push(SourceGateError(
                SourceFileId { index: 0 },
                SourceGateImportResolutionAbsent,
                "missing-lowering: source import/name resolution absent"))
            .freeze()
    } else { Vec[SourceGateError].new().freeze() }

/// Return true when the gate result can continue to type checking.
def SourceGateResult.ok(self): bool =
    self.errors.len() == 0
