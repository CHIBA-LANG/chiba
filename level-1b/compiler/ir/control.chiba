/// Control IR after answer/control and CPS passes.
namespace compiler.ir.control

use compiler.ir.common.*
use compiler.ir.type_ir.*
use compiler.ir.typed.*

/// Usage count used by control and closure passes.
data UseCount {
    UseZero,
    UseOne,
    UseMany,
}

/// Control boundary kind.
data ControlBoundary {
    ControlNone,
    ControlReset,
    ControlShift,
    ControlDelimited,
}

/// Continuation storage obligation decided before backend lowering.
data ContinuationStorageKind {
    ContinuationDirectResume,
    ContinuationBoxedOneShot,
    ContinuationRepeatableFrameChain,
    ContinuationErasedCallableVariant,
}

/// Callable arrow position that created a continuation obligation.
data CallableArrowPosition {
    CallableParameterPosition,
    CallableStoragePosition,
    CallableSendableStoragePosition,
    CallableExplicitContStorage,
}

/// Runtime variant allowed inside erased callable storage.
data CallableStorageVariant {
    CallableVariantFunction,
    CallableVariantClosure,
    CallableVariantBoxedCont1,
    CallableVariantContN,
}

/// Callable storage lowering obligation before backend-specific layout.
type CallableStorageFact {
    owner: BinderId,
    position: CallableArrowPosition,
    variants: Array[CallableStorageVariant],
    sendable: bool,
}

/// Return true when a callable storage variant is a continuation.
def CallableStorageVariant.is_continuation(self): bool =
    match self {
        CallableVariantBoxedCont1 => true
        CallableVariantContN => true
        _ => false
    }

/// Return true when a callable storage fact excludes continuation variants for send.
def CallableStorageFact.excludes_continuations_for_send(self): bool =
    if self.sendable { callable_storage_variants_have_continuation(self.variants, 0) == false }
    else { true }

/// Return true when a variant array contains a continuation variant.
def callable_storage_variants_have_continuation(variants: Array[CallableStorageVariant], index: usize): bool =
    if index == variants.len() { false }
    else if variants.get(index).is_continuation() { true }
    else { callable_storage_variants_have_continuation(variants, index + 1) }

/// Continuation fact that must survive control, usage, and closure passes.
type ContinuationFact {
    binder: BinderId,
    capability: ContinuationCapabilityKind,
    resume_input: TypeIr,
    answer: TypeIr,
    boundary: ControlBoundary,
    storage: ContinuationStorageKind,
    arrow_position: CallableArrowPosition,
    sendable: bool,
}

/// Return true when a continuation storage obligation materializes an object.
def ContinuationStorageKind.materializes_runtime_object(self): bool =
    match self {
        ContinuationBoxedOneShot => true
        ContinuationRepeatableFrameChain => true
        ContinuationErasedCallableVariant => true
        _ => false
    }

/// Return true when storage is legal for `((A) -> B) send`.
def ContinuationFact.allowed_in_sendable_callable(self): bool = false

/// Pick the default storage obligation for an explicitly typed continuation.
def continuation_storage_for_capability(capability: ContinuationCapabilityKind, escaping: bool): ContinuationStorageKind =
    match capability {
        ContinuationCont1 =>
            if escaping { ContinuationBoxedOneShot }
            else { ContinuationDirectResume }
        ContinuationContN => ContinuationRepeatableFrameChain
    }

/// CPS module after one-pass CPS and beta reduction.
type CpsIrModule {
    source: TypedModule,
    usage: Array[UseFact],
    continuations: Array[ContinuationFact],
}

/// Use fact for a binder or continuation.
type UseFact {
    binder: BinderId,
    count: UseCount,
}
