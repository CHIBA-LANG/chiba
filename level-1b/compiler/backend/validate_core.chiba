/// Wasm-GC Core validator.
namespace compiler.backend.validate_core

use compiler.backend.core.*
use compiler.ir.common.*

/// Core validation error.
data CoreValidationError {
    CoreDanglingLayout(str),
    CoreDanglingSymbol(str),
    CoreMissingOwner(str),
    CoreIllegalTailCall(str),
    CoreIllegalContinuationPackage(str),
}

/// Validated Core module accepted by backend emit.
type ValidatedCoreModule {
    core: WasmGcCoreModule,
}

/// Return true when a layout table contains a layout id with the expected kind.
def WasmGcLayoutTable.contains_layout(self, layout: WasmGcLayout, index: usize): bool =
    if index == self.entries.len() { false }
    else {
        let entry = self.entries.get(index)
        if entry.id == layout.id && entry.kind.eq(layout.kind) { true }
        else { self.contains_layout(layout, index + 1) }
    }

/// Compare layout kinds by ADT variant.
def WasmGcLayoutKind.eq(self, other: WasmGcLayoutKind): bool =
    match self {
        LayoutStruct => match other { LayoutStruct => true  _ => false }
        LayoutArray => match other { LayoutArray => true  _ => false }
        LayoutClosureEnv => match other { LayoutClosureEnv => true  _ => false }
        LayoutContinuationFrame => match other { LayoutContinuationFrame => true  _ => false }
        LayoutContinuationFrameChain => match other { LayoutContinuationFrameChain => true  _ => false }
        LayoutBoxedCont1 => match other { LayoutBoxedCont1 => true  _ => false }
        LayoutContNPackage => match other { LayoutContNPackage => true  _ => false }
        LayoutContinuationPackage => match other { LayoutContinuationPackage => true  _ => false }
        LayoutSliceView => match other { LayoutSliceView => true  _ => false }
    }

/// Return true when a Core kind may appear in tail position.
def CoreOpKind.allows_tail_position(self): bool =
    match self {
        CoreOpTailCall => true
        CoreOpClosureCall => true
        _ => false
    }

/// Validate a tail-call annotation.
def validate_core_tail(op: CoreOp): Option[CoreValidationError] =
    match op.tail {
        CorePlainCall => None
        CoreTailCall =>
            if op.kind.allows_tail_position() { None }
            else { Some(CoreIllegalTailCall("tailcall attached to non-call Core op")) }
    }

/// Validate a layout reference required by a Core operation.
def validate_core_layout(module: WasmGcCoreModule, op: CoreOp): Option[CoreValidationError] =
    match op.layout {
        None =>
            if op.kind.requires_layout() { Some(CoreDanglingLayout("missing required layout")) }
            else { None }
        Some(layout) =>
            if module.layouts.contains_layout(layout, 0) { None }
            else { Some(CoreDanglingLayout(layout.key)) }
    }

/// Validate that materialized runtime ops keep source owner provenance.
def validate_core_owner(op: CoreOp): Option[CoreValidationError] =
    if op.kind.requires_layout() {
        match op.owner {
            Some(_) => None
            None => Some(CoreMissingOwner("runtime Core op missing owner provenance"))
        }
    } else { None }

/// Validate continuation package operations.
def validate_core_continuation_package(op: CoreOp): Option[CoreValidationError] =
    match op.kind {
        CoreOpBoxedCont1 =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutBoxedCont1) { None }
                    else { Some(CoreIllegalContinuationPackage("boxed Cont1 must use one-shot layout")) }
                None => Some(CoreIllegalContinuationPackage("boxed Cont1 missing layout"))
            }
        CoreOpContinuationFrameChain =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContinuationFrameChain) { None }
                    else { Some(CoreIllegalContinuationPackage("ContN frame chain must use frame-chain layout")) }
                None => Some(CoreIllegalContinuationPackage("ContN frame chain missing layout"))
            }
        CoreOpContNPackage =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContNPackage) { None }
                    else { Some(CoreIllegalContinuationPackage("ContN package must use repeatable package layout")) }
                None => Some(CoreIllegalContinuationPackage("ContN package missing layout"))
            }
        CoreOpContinuationPackage =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContinuationPackage) { None }
                    else { Some(CoreIllegalContinuationPackage("continuation package must use package layout")) }
                None => Some(CoreIllegalContinuationPackage("continuation package missing layout"))
            }
        _ => None
    }

/// Return true when a Core op materializes a ContN frame chain.
def core_op_is_contn_frame_chain(op: CoreOp): bool =
    match op.kind {
        CoreOpContinuationFrameChain => true
        _ => false
    }

/// Return true when a Core op materializes a ContN package.
def core_op_is_contn_package(op: CoreOp): bool =
    match op.kind {
        CoreOpContNPackage => true
        _ => false
    }

/// Return true when two binder ids are the same origin.
def binder_id_eq(left: BinderId, right: BinderId): bool = left.id == right.id

/// Return the latest ContN frame-chain owner after observing one op.
def core_contn_frame_owner_after(op: CoreOp, current: Option[BinderId]): Option[BinderId] =
    if core_op_is_contn_frame_chain(op) { op.owner }
    else { current }

/// Validate that a ContN package follows a same-owner emitted frame chain.
def validate_core_continuation_order(op: CoreOp, frame_owner: Option[BinderId]): Option[CoreValidationError] =
    if core_op_is_contn_package(op) {
        match op.owner {
            Some(package_owner) =>
                match frame_owner {
                    Some(owner) =>
                        if binder_id_eq(package_owner, owner) { None }
                        else { Some(CoreIllegalContinuationPackage("ContN package owner does not match preceding frame chain")) }
                    None => Some(CoreIllegalContinuationPackage("ContN package missing preceding frame chain"))
                }
            None => Some(CoreIllegalContinuationPackage("ContN package missing owner"))
        }
    } else { None }

/// Append an optional validation error to a builder.
def push_validation_error(out: Vec[CoreValidationError], error: Option[CoreValidationError]): Vec[CoreValidationError] =
    match error {
        Some(item) => out.push(item)
        None => out
    }

/// Validate one Core op.
def validate_core_op(module: WasmGcCoreModule, op: CoreOp, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    out
        |> push_validation_error(validate_core_layout(module, op))
        |> push_validation_error(validate_core_owner(op))
        |> push_validation_error(validate_core_tail(op))
        |> push_validation_error(validate_core_continuation_package(op))

/// Validate Core operations after tracking frame-chain materialization.
def validate_core_ops_with_contn_frame(module: WasmGcCoreModule, index: usize, frame_owner: Option[BinderId], out: Vec[CoreValidationError]): Array[CoreValidationError] =
    if index == module.ops.len() { out.freeze() }
    else {
        let op = module.ops.get(index)
        let next_frame_owner = core_contn_frame_owner_after(op, frame_owner)
        validate_core_ops_with_contn_frame(
            module,
            index + 1,
            next_frame_owner,
            validate_core_op(module, op, out)
                |> push_validation_error(validate_core_continuation_order(op, frame_owner)))
    }

/// Validate Core operations in stable order.
def validate_core_ops(module: WasmGcCoreModule, index: usize, out: Vec[CoreValidationError]): Array[CoreValidationError] =
    validate_core_ops_with_contn_frame(module, index, None, out)

/// Validate symbols, layouts, tailcall facts, and continuation packages.
def validate_wasm_gc_core(module: WasmGcCoreModule): Result[ValidatedCoreModule, Array[CoreValidationError]] =
    match validate_core_ops(module, 0, Vec[CoreValidationError].new()) {
        errors =>
            if errors.len() == 0 { Ok(ValidatedCoreModule { core: module }) }
            else { Err(errors) }
    }

/// Return true when an error blocks WAT emission.
def CoreValidationError.blocks_emit(self): bool = true
