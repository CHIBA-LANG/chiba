/// Wasm-GC Core validator.
namespace compiler.backend.validate_core

use compiler.backend.core.*
use compiler.ir.common.*

/// Core validation error.
data CoreValidationError {
    CoreDanglingLayout(str),
    CoreDanglingSymbol(str),
    CoreDuplicateSymbol(str),
    CoreMissingOwner(str),
    CoreIllegalTailCall(str),
    CoreNonTailCps(str),
    CoreMissingBranchBody(str),
    CoreMissingPatternDecision(str),
    CoreMissingUtf8IdentifierLowering(str),
    CoreInvalidTupleNominalIdentity(str),
    CoreInvalidIntrinsicBridge(str),
    CoreIllegalRuntimeState(str),
    CoreIllegalContinuationPackage(str),
}

/// Validated Core module accepted by backend emit.
type BackendValidatedCoreModule {
    core: WasmGcCoreModule,
}

/// Latest observed ContN frame-chain state while validating op order.
type ContNFrameChainState {
    owner: Option[BinderId],
    frame_count: usize,
    pending_stackless_count: usize,
}

/// Return true when a layout table contains a layout id with the expected kind.
def WasmGcLayoutTable.contains_layout(self, layout: WasmGcLayout, index: usize): bool =
    if index == self.entries.len() { false }
    else {
        let entry = self.entries.get(index)
        if entry.id == layout.id && entry.kind.eq(layout.kind) { true }
        else { self.contains_layout(layout, index + 1) }
    }

/// Compare layout kinds by ADT variant.
def WasmGcLayoutKind.eq(self, other: WasmGcLayoutKind): bool =
    match self {
        LayoutStruct => match other { LayoutStruct => true, _ => false }
        LayoutArray => match other { LayoutArray => true, _ => false }
        LayoutClosureEnv => match other { LayoutClosureEnv => true, _ => false }
        LayoutContinuationFrame => match other { LayoutContinuationFrame => true, _ => false }
        LayoutContinuationFrameChain => match other { LayoutContinuationFrameChain => true, _ => false }
        LayoutBoxedCont1 => match other { LayoutBoxedCont1 => true, _ => false }
        LayoutContNPackage => match other { LayoutContNPackage => true, _ => false }
        LayoutContinuationPackage => match other { LayoutContinuationPackage => true, _ => false }
        LayoutSliceView => match other { LayoutSliceView => true, _ => false }
    }

/// Return true when a Core kind may appear in tail position.
def CoreOpKind.allows_tail_position(self): bool =
    match self {
        CoreOpTailCall => true
        CoreOpClosureCall => true
        _ => false
    }

/// Validate a tail-call annotation.
def validate_core_tail(op: CoreOp): Option[CoreValidationError] =
    match op.tail {
        CorePlainCall => None
        CoreTailCall =>
            if op.kind.allows_tail_position() { None }
            else { Some(CoreIllegalTailCall("tailcall attached to non-call Core op")) }
    }

/// Validate the CPS invariant: ordinary functions cannot lower to fallthrough blocks.
def validate_core_cps_tail_form(op: CoreOp): Option[CoreValidationError] =
    match op.kind {
        CoreOpFunction =>
            match core_block_terminator_for_op(op) {
                CoreBlockContinue => Some(CoreNonTailCps("ordinary CPS function lowered to non-tail fallthrough"))
                _ => None
            }
        CoreOpContNPackage => None
        CoreOpContinuationFrameChain => None
        _ => None
    }

/// Return true when one Core branch condition reads an indexed parameter.
def core_branch_condition_reads_param(condition: CoreBranchCondition): bool =
    match condition {
        CoreBranchConditionParam(_) => true
        _ => false
    }

/// Return true when a Core expression body reads any indexed parameter.
def core_function_body_reads_param(body: CoreExprKind): bool =
    match body {
        CoreExprParam(_) => true
        CoreExprTypedParam(_, _) => true
        CoreExprCast(value, _) => core_function_body_reads_param(value)
        CoreExprStructNew(_, args) => core_function_body_args_read_param(args, 0)
        CoreExprFieldGet(_, value, _) => core_function_body_reads_param(value)
        CoreExprCall(_, args, _) => core_function_body_args_read_param(args, 0)
        CoreExprTailCallArgs(_, args) => core_function_body_args_read_param(args, 0)
        CoreExprPrimitiveBinary(_, left, right) =>
            if core_function_body_reads_param(left) { true }
            else { core_function_body_reads_param(right) }
        CoreExprIfElse(condition, then_expr, else_expr) =>
            if core_branch_condition_reads_param(condition) { true }
            else if core_function_body_reads_param(then_expr) { true }
            else { core_function_body_reads_param(else_expr) }
        _ => false
    }

/// Return true when any Core expression argument reads an indexed parameter.
def core_function_body_args_read_param(args: Array[CoreExprKind], index: usize): bool =
    if index == args.len() { false }
    else if core_function_body_reads_param(args.get(index)) { true }
    else { core_function_body_args_read_param(args, index + 1) }

/// Validate that branch join facts are not emitted as fake function bodies.
def core_op_param_count(op: CoreOp): usize =
    if op.param_types.len() > 0 { op.param_types.len() } else { op.i32_param_count }

/// Validate that branch join facts are not emitted as fake function bodies.
def validate_core_function_body(op: CoreOp): Option[CoreValidationError] =
    match op.function_body {
        Some(CoreExprBranchJoinPending) => Some(CoreMissingBranchBody("branch join function body lowering absent"))
        Some(body) => {
            let param_count = core_op_param_count(op)
            if core_function_body_reads_param(body) && param_count == 0 { Some(CoreMissingBranchBody("function body reads missing param")) }
            else if core_function_body_max_param_index(body, 0) >= param_count && param_count > 0 { Some(CoreMissingBranchBody("function body reads missing param")) }
            else { None }
        }
        _ => None
    }

/// Return the largest parameter index read by a Core expression.
def core_function_body_max_param_index(body: CoreExprKind, current: usize): usize =
    match body {
        CoreExprParam(index) => if index > current { index } else { current }
        CoreExprTypedParam(index, _) => if index > current { index } else { current }
        CoreExprCast(value, _) => core_function_body_max_param_index(value, current)
        CoreExprStructNew(_, args) => core_function_body_args_max_param_index(args, 0, current)
        CoreExprFieldGet(_, value, _) => core_function_body_max_param_index(value, current)
        CoreExprCall(_, args, _) => core_function_body_args_max_param_index(args, 0, current)
        CoreExprTailCallArgs(_, args) => core_function_body_args_max_param_index(args, 0, current)
        CoreExprPrimitiveBinary(_, left, right) =>
            core_function_body_max_param_index(right, core_function_body_max_param_index(left, current))
        CoreExprIfElse(condition, then_expr, else_expr) =>
            core_function_body_max_param_index(else_expr, core_function_body_max_param_index(then_expr, core_branch_condition_max_param_index(condition, current)))
        _ => current
    }

/// Return the largest parameter index read by a Core branch condition.
def core_branch_condition_max_param_index(condition: CoreBranchCondition, current: usize): usize =
    match condition {
        CoreBranchConditionParam(index) => if index > current { index } else { current }
        _ => current
    }

/// Return the largest parameter index read by Core expression arguments.
def core_function_body_args_max_param_index(args: Array[CoreExprKind], index: usize, current: usize): usize =
    if index == args.len() { current }
    else { core_function_body_args_max_param_index(args, index + 1, core_function_body_max_param_index(args.get(index), current)) }

/// Validate a layout reference required by a Core operation.
def validate_core_layout(module: WasmGcCoreModule, op: CoreOp): Option[CoreValidationError] =
    match op.layout {
        None =>
            if op.kind.requires_layout() { Some(CoreDanglingLayout("missing required layout")) }
            else { None }
        Some(layout) =>
            if module.layouts.contains_layout(layout, 0) { None }
            else { Some(CoreDanglingLayout(layout.key)) }
    }

/// Compare two Core symbols byte-for-byte.
def core_symbol_eq(left: str, right: str, index: usize): bool =
    if index == left.len() && index == right.len() { true }
    else if index == left.len() { false }
    else if index == right.len() { false }
    else if left.byte_at(index) == right.byte_at(index) { core_symbol_eq(left, right, index + 1) }
    else { false }

/// Return true when one Core op defines a function symbol.
def core_op_defines_symbol(op: CoreOp, target: str): bool =
    match op.function_symbol {
        Some(symbol) => core_symbol_eq(symbol.name, target, 0)
        None => false
    }

/// Return true when a Core module defines one function symbol.
def core_module_contains_symbol(module: WasmGcCoreModule, target: str, index: usize): bool =
    if index == module.ops.len() { false }
    else if core_op_defines_symbol(module.ops.get(index), target) { true }
    else { core_module_contains_symbol(module, target, index + 1) }

/// Return true when the same symbol appears later in the Core op stream.
def core_module_has_later_symbol(module: WasmGcCoreModule, target: str, index: usize): bool =
    if index == module.ops.len() { false }
    else if core_op_defines_symbol(module.ops.get(index), target) { true }
    else { core_module_has_later_symbol(module, target, index + 1) }

/// Validate that emitted function symbols are unique.
def validate_core_duplicate_symbol(module: WasmGcCoreModule, op: CoreOp, next_index: usize): Option[CoreValidationError] =
    match op.function_symbol {
        Some(symbol) =>
            if core_module_has_later_symbol(module, symbol.name, next_index) { Some(CoreDuplicateSymbol("duplicate Core function symbol")) }
            else { None }
        None => None
    }

/// Validate direct symbol references inside Core function bodies.
def validate_core_symbol(module: WasmGcCoreModule, op: CoreOp): Option[CoreValidationError] =
    match op.function_body {
        Some(CoreExprCall(target, args, _)) =>
            if core_module_contains_symbol(module, target, 0) == false { Some(CoreDanglingSymbol("call target symbol is not defined")) }
            else { validate_core_expr_arg_symbols(module, args, 0) }
        Some(CoreExprTailCall(target)) =>
            if core_module_contains_symbol(module, target, 0) { None }
            else { Some(CoreDanglingSymbol("tail-call target symbol is not defined")) }
        Some(CoreExprTailCallArgs(target, args)) =>
            if core_module_contains_symbol(module, target, 0) == false { Some(CoreDanglingSymbol("tail-call target symbol is not defined")) }
            else { validate_core_expr_arg_symbols(module, args, 0) }
        Some(CoreExprPrimitiveBinary(_, left, right)) =>
            match validate_core_expr_symbol(module, left) {
                Some(error) => Some(error)
                None => validate_core_expr_symbol(module, right)
            }
        Some(CoreExprIfElse(_, then_expr, else_expr)) =>
            match validate_core_expr_symbol(module, then_expr) {
                Some(error) => Some(error)
                None => validate_core_expr_symbol(module, else_expr)
            }
        _ => None
    }

/// Validate symbol references inside nested Core expressions.
def validate_core_expr_symbol(module: WasmGcCoreModule, body: CoreExprKind): Option[CoreValidationError] =
    match body {
        CoreExprCast(value, _) => validate_core_expr_symbol(module, value)
        CoreExprStructNew(_, args) => validate_core_expr_arg_symbols(module, args, 0)
        CoreExprFieldGet(_, value, _) => validate_core_expr_symbol(module, value)
        CoreExprCall(target, args, _) =>
            if core_module_contains_symbol(module, target, 0) == false { Some(CoreDanglingSymbol("call target symbol is not defined")) }
            else { validate_core_expr_arg_symbols(module, args, 0) }
        CoreExprTailCall(target) =>
            if core_module_contains_symbol(module, target, 0) { None }
            else { Some(CoreDanglingSymbol("tail-call target symbol is not defined")) }
        CoreExprTailCallArgs(target, args) =>
            if core_module_contains_symbol(module, target, 0) == false { Some(CoreDanglingSymbol("tail-call target symbol is not defined")) }
            else { validate_core_expr_arg_symbols(module, args, 0) }
        CoreExprPrimitiveBinary(_, left, right) =>
            match validate_core_expr_symbol(module, left) {
                Some(error) => Some(error)
                None => validate_core_expr_symbol(module, right)
            }
        CoreExprIfElse(_, then_expr, else_expr) =>
            match validate_core_expr_symbol(module, then_expr) {
                Some(error) => Some(error)
                None => validate_core_expr_symbol(module, else_expr)
            }
        _ => None
    }

/// Validate symbol references inside Core expression arguments.
def validate_core_expr_arg_symbols(module: WasmGcCoreModule, args: Array[CoreExprKind], index: usize): Option[CoreValidationError] =
    if index == args.len() { None }
    else {
        match validate_core_expr_symbol(module, args.get(index)) {
            Some(error) => Some(error)
            None => validate_core_expr_arg_symbols(module, args, index + 1)
        }
    }

/// Validate that materialized runtime ops keep source owner provenance.
def validate_core_owner(op: CoreOp): Option[CoreValidationError] =
    if op.kind.requires_owner() {
        match op.owner {
            Some(_) => None
            None => Some(CoreMissingOwner("runtime Core op missing owner provenance"))
        }
    } else { None }

/// Validate continuation package operations.
def validate_core_continuation_package(op: CoreOp): Option[CoreValidationError] =
    match op.kind {
        CoreOpBoxedCont1 =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutBoxedCont1) { None }
                    else { Some(CoreIllegalContinuationPackage("boxed Cont1 must use one-shot layout")) }
                None => Some(CoreIllegalContinuationPackage("boxed Cont1 missing layout"))
            }
        CoreOpContinuationFrameChain =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContinuationFrameChain) { None }
                    else { Some(CoreIllegalContinuationPackage("ContN frame chain must use frame-chain layout")) }
                None => Some(CoreIllegalContinuationPackage("ContN frame chain missing layout"))
            }
        CoreOpContNPackage =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContNPackage) { None }
                    else { Some(CoreIllegalContinuationPackage("ContN package must use repeatable package layout")) }
                None => Some(CoreIllegalContinuationPackage("ContN package missing layout"))
            }
        CoreOpContinuationPackage =>
            match op.layout {
                Some(layout) =>
                    if layout.kind.eq(LayoutContinuationPackage) { None }
                    else { Some(CoreIllegalContinuationPackage("continuation package must use package layout")) }
                None => Some(CoreIllegalContinuationPackage("continuation package missing layout"))
            }
        _ => None
    }

/// Validate runtime state attached to materialized continuation operations.
def validate_core_runtime_state(op: CoreOp): Option[CoreValidationError] =
    match op.kind {
        CoreOpBoxedCont1 =>
            match op.runtime_state {
                CoreConsumedStateMachine => None
                _ => Some(CoreIllegalRuntimeState("boxed Cont1 must carry consumed-state machine"))
            }
        _ =>
            match op.runtime_state {
                CoreConsumedStateMachine => Some(CoreIllegalRuntimeState("consumed-state machine attached to non-Cont1 op"))
                _ => None
            }
    }

/// Return true when a Core op materializes a ContN frame chain.
def core_op_is_contn_frame_chain(op: CoreOp): bool =
    match op.kind {
        CoreOpContinuationFrameChain => true
        _ => false
    }

/// Return true when a Core op materializes a stackless resume function.
def core_op_is_stackless_function(op: CoreOp): bool =
    match op.kind {
        CoreOpStacklessFunction => true
        _ => false
    }

/// Validate that a ContN frame-chain op carries at least one lowered frame.
def validate_core_contn_frame_count(op: CoreOp): Option[CoreValidationError] =
    if core_op_is_contn_frame_chain(op) {
        if op.frame_count == 0 { Some(CoreIllegalContinuationPackage("ContN frame chain has no stackless resume frames")) }
        else { None }
    } else { None }

/// Validate that frame-chain count matches preceding stackless resume functions.
def validate_core_contn_stackless_count(op: CoreOp, frame_state: ContNFrameChainState): Option[CoreValidationError] =
    if core_op_is_contn_frame_chain(op) {
        if op.frame_count == frame_state.pending_stackless_count { None }
        else { Some(CoreIllegalContinuationPackage("ContN frame chain missing stackless resume functions")) }
    } else { None }

/// Return true when a Core op materializes a ContN package.
def core_op_is_contn_package(op: CoreOp): bool =
    match op.kind {
        CoreOpContNPackage => true
        _ => false
    }

/// Return true when two binder ids are the same origin.
def binder_id_eq(left: BinderId, right: BinderId): bool = left.index == right.index

/// Return the latest ContN frame-chain state after observing one op.
def core_contn_frame_state_after(op: CoreOp, current: ContNFrameChainState): ContNFrameChainState =
    if core_op_is_stackless_function(op) {
        ContNFrameChainState {
            owner: current.owner,
            frame_count: current.frame_count,
            pending_stackless_count: current.pending_stackless_count + 1,
        }
    } else if core_op_is_contn_frame_chain(op) {
        ContNFrameChainState {
            owner: op.owner,
            frame_count: op.frame_count,
            pending_stackless_count: 0,
        }
    } else { current }

/// Validate that a ContN package follows a same-owner emitted frame chain with matching frame count.
def validate_core_continuation_order(op: CoreOp, frame_state: ContNFrameChainState): Option[CoreValidationError] =
    if core_op_is_contn_package(op) {
        match op.owner {
            Some(package_owner) =>
                match frame_state.owner {
                    Some(owner) =>
                        if binder_id_eq(package_owner, owner) {
                            if op.frame_count == frame_state.frame_count { None }
                            else { Some(CoreIllegalContinuationPackage("ContN package frame count does not match preceding frame chain")) }
                        } else { Some(CoreIllegalContinuationPackage("ContN package owner does not match preceding frame chain")) }
                    None => Some(CoreIllegalContinuationPackage("ContN package missing preceding frame chain"))
                }
            None => Some(CoreIllegalContinuationPackage("ContN package missing owner"))
        }
    } else { None }

/// Append an optional validation error to a builder.
def push_validation_error(out: Vec[CoreValidationError], error: Option[CoreValidationError]): Vec[CoreValidationError] =
    match error {
        Some(item) => out.push(item)
        None => out
    }

/// Validate one Core op.
def validate_core_op(module: WasmGcCoreModule, op: CoreOp, next_index: usize, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    out
        |> push_validation_error(validate_core_layout(module, op))
        |> push_validation_error(validate_core_symbol(module, op))
        |> push_validation_error(validate_core_duplicate_symbol(module, op, next_index))
        |> push_validation_error(validate_core_owner(op))
        |> push_validation_error(validate_core_tail(op))
        |> push_validation_error(validate_core_cps_tail_form(op))
        |> push_validation_error(validate_core_function_body(op))
        |> push_validation_error(validate_core_runtime_state(op))
        |> push_validation_error(validate_core_continuation_package(op))
        |> push_validation_error(validate_core_contn_frame_count(op))

/// Validate Core operations after tracking frame-chain materialization.
def validate_core_ops_with_contn_frame(module: WasmGcCoreModule, index: usize, frame_state: ContNFrameChainState, out: Vec[CoreValidationError]): Array[CoreValidationError] =
    if index == module.ops.len() { out.freeze() }
    else {
        let op = module.ops.get(index)
        let next_frame_state = core_contn_frame_state_after(op, frame_state)
        validate_core_ops_with_contn_frame(
            module,
            index + 1,
            next_frame_state,
            validate_core_op(module, op, index + 1, out)
                |> push_validation_error(validate_core_contn_stackless_count(op, frame_state))
                |> push_validation_error(validate_core_continuation_order(op, frame_state)))
    }

/// Validate Core operations in stable order.
def validate_core_ops(module: WasmGcCoreModule, index: usize, out: Vec[CoreValidationError]): Array[CoreValidationError] =
    validate_core_ops_with_contn_frame(module, index, ContNFrameChainState { owner: None, frame_count: 0, pending_stackless_count: 0 }, out)

/// Validate that pattern decisions are not silently dropped before executable lowering.
def validate_core_pattern_decisions(module: WasmGcCoreModule, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    if module.pattern_decision_obligations.len() == 0 { out }
    else { out.push(CoreMissingPatternDecision("pattern decision tree lowering absent")) }

/// Return true when a tuple nominal identity is canonical and non-empty.
def core_tuple_nominal_identity_valid(identity: TupleNominalIdentity): bool =
    identity.tuple_key.len() > 0 &&
    identity.nominal.namespace_name == "compiler.tuple" &&
    identity.nominal.name == identity.tuple_key

/// Validate tuple nominal identity carried by an ADT constructor obligation.
def validate_core_adt_ctor_tuple_nominal(obligation: CoreAdtCtorLoweringObligation): Option[CoreValidationError] =
    if core_tuple_nominal_identity_valid(obligation.tuple_nominal) { None }
    else { Some(CoreInvalidTupleNominalIdentity("ADT tuple bridge has non-canonical tuple nominal identity")) }

/// Validate tuple nominal identities before executable ADT ctor lowering lands.
def validate_core_adt_ctor_tuple_nominals(obligations: Array[CoreAdtCtorLoweringObligation], index: usize, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    if index == obligations.len() { out }
    else {
        validate_core_adt_ctor_tuple_nominals(
            obligations,
            index + 1,
            out |> push_validation_error(validate_core_adt_ctor_tuple_nominal(obligations.get(index))))
    }

/// Return true when ADT ctor obligations need UTF-8 identifier lowering.
def core_adt_ctor_obligations_need_utf8_lowering(obligations: Array[CoreAdtCtorLoweringObligation], index: usize): bool =
    if index == obligations.len() { false }
    else if obligations.get(index).requires_utf8_identifier_lowering { true }
    else { core_adt_ctor_obligations_need_utf8_lowering(obligations, index + 1) }

/// Validate that UTF-8 constructor identifiers cannot pass through ASCII tag canonicalization.
def validate_core_utf8_identifier_lowering(module: WasmGcCoreModule, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    if core_adt_ctor_obligations_need_utf8_lowering(module.adt_ctor_obligations, 0) {
        out.push(CoreMissingUtf8IdentifierLowering("UTF-8 ADT constructor identifier lowering absent"))
    } else { out }

/// Validate one compiler intrinsic tuple bridge obligation.
def validate_core_intrinsic_bridge_obligation(obligation: CoreIntrinsicBridgeLoweringObligation): Option[CoreValidationError] =
    if obligation.intrinsic_namespace != "compiler.intrinsic" {
        Some(CoreInvalidIntrinsicBridge("compiler intrinsic bridge has non-canonical namespace"))
    } else if obligation.tuple_to_adt_identity.is_some() && obligation.adt_to_tuple_identity.is_some() && obligation.has_typed_roundtrip == false {
        Some(CoreInvalidIntrinsicBridge("compiler intrinsic bridge missing typed roundtrip identity"))
    } else if obligation.tuple_to_adt_identity.is_some() && obligation.adt_to_tuple_identity.is_some() && obligation.emits_identity_conversion_helpers == false {
        Some(CoreInvalidIntrinsicBridge("compiler intrinsic bridge missing executable identity conversion helpers"))
    } else { None }

/// Validate compiler intrinsic tuple bridge obligations before executable roundtrip lowering.
def validate_core_intrinsic_bridges(obligations: Array[CoreIntrinsicBridgeLoweringObligation], index: usize, out: Vec[CoreValidationError]): Vec[CoreValidationError] =
    if index == obligations.len() { out }
    else {
        validate_core_intrinsic_bridges(
            obligations,
            index + 1,
            out |> push_validation_error(validate_core_intrinsic_bridge_obligation(obligations.get(index))))
    }

/// Validate symbols, layouts, tailcall facts, and continuation packages.
def validate_wasm_gc_core(module: WasmGcCoreModule): Result[BackendValidatedCoreModule, Array[CoreValidationError]] =
    match validate_core_intrinsic_bridges(module.intrinsic_bridge_obligations, 0, validate_core_utf8_identifier_lowering(module, validate_core_pattern_decisions(module, validate_core_adt_ctor_tuple_nominals(module.adt_ctor_obligations, 0, validate_core_ops(module, 0, Vec[CoreValidationError].new()))))).freeze() {
        errors =>
            if errors.len() == 0 { Ok(BackendValidatedCoreModule { core: module }) }
            else { Err(errors) }
    }

/// Return true when an error blocks WAT emission.
def CoreValidationError.blocks_emit(self): bool = true
