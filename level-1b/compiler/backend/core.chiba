/// Wasm-GC Core IR after closure and continuation lowering.
namespace compiler.backend.core

use compiler.closure.env_simplify.*
use compiler.ir.common.*
use compiler.ir.closure.*
use compiler.backend.layout.*
use compiler.semantic.type_infer.*
use compiler.semantic.driver.*

/// Direct import target selected before emit.
data CoreImportModule {
    CoreImportWasi,
    CoreImportEnv,
}

/// Tail position fact attached before WAT emit.
data CoreTailPosition {
    CoreTailCall,
    CorePlainCall,
}

/// Backend-neutral block terminator required after Core lowering.
data CoreBlockTerminator {
    CoreBlockReturn,
    CoreBlockTailCall,
    CoreBlockContinue,
}

/// Runtime state machine required by a materialized Core operation.
data CoreRuntimeState {
    CoreNoRuntimeState,
    CoreConsumedStateMachine,
}

/// Minimal function body form accepted by the first executable WAT slice.
data CoreFunctionBody {
    CoreFunctionReturnUnit,
    CoreFunctionReturnI32Zero,
    CoreFunctionReturnI32FortyTwo,
}

/// Core operation class understood by the dumb backend emitter.
data CoreOpKind {
    CoreOpFunction,
    CoreOpStacklessFunction,
    CoreOpStructNew,
    CoreOpArrayNew,
    CoreOpClosureCall,
    CoreOpBoxedCont1,
    CoreOpContinuationFrameChain,
    CoreOpContNPackage,
    CoreOpContinuationPackage,
    CoreOpTailCall,
    CoreOpImportCall(CoreImportModule),
}

/// One lowered Core operation.
type CoreOp {
    owner: Option[BinderId],
    kind: CoreOpKind,
    export_main: bool,
    function_body: Option[CoreFunctionBody],
    layout: Option[WasmGcLayout],
    tail: CoreTailPosition,
    runtime_state: CoreRuntimeState,
    frame_count: usize,
}

/// Wasm-GC Core module with a stable layout table.
type WasmGcCoreModule {
    source: OptimizedClosureModule,
    layouts: WasmGcLayoutTable,
    ops: Array[CoreOp],
    block_obligations: Array[CoreBlockLoweringObligation],
}

/// Core-to-block lowering obligation before executable WAT emission.
type CoreBlockLoweringObligation {
    owner: Option[BinderId],
    terminator: CoreBlockTerminator,
    requires_function_return: bool,
    requires_tail_call: bool,
}

/// Return the closure environment layout used by escaping closures.
def closure_env_layout(): WasmGcLayout = layout_closure_env()

/// Reach the typed module that fed the closure/control/backend pipeline.
def optimized_closure_typed_module(module: OptimizedClosureModule): TypedModule =
    module.source.source.source.source.source.source.usage.answer.typed

/// Convert a C08 typed function body to backend Core body form.
def core_function_body_from_typed(body: TypedFunctionBodyKind): CoreFunctionBody =
    match body {
        TypedFunctionReturnUnit => CoreFunctionReturnUnit
        TypedFunctionReturnI32Zero => CoreFunctionReturnI32Zero
        TypedFunctionReturnI32FortyTwo => CoreFunctionReturnI32FortyTwo
    }

/// Lower one typed function fact into a Core function op.
def lower_typed_function_fact(fact: TypedFunctionBodyFact): CoreOp =
    CoreOp {
        owner: Some(fact.owner),
        kind: CoreOpFunction,
        export_main: fact.is_main,
        function_body: Some(core_function_body_from_typed(fact.body)),
        layout: None,
        tail: CorePlainCall,
        runtime_state: CoreNoRuntimeState,
        frame_count: 0,
    }

/// Lower typed function facts into Core ops before closure/continuation materialization.
def lower_typed_function_facts(facts: Array[TypedFunctionBodyFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else { lower_typed_function_facts(facts, index + 1, out.push(lower_typed_function_fact(facts.get(index)))) }

/// Lower one closure lowering fact into an optional Core operation.
def lower_closure_fact(fact: ClosureLoweringFact): Option[CoreOp] =
    match fact.kind {
        ClosureNoCaptureDirect => None
        ClosureKnownCallableDirect => None
        ClosureErasedCallableDispatch => None
        ClosureCapturingEnv =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpClosureCall,
                export_main: false,
                function_body: None,
                layout: Some(closure_env_layout()),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            })
    }

/// Lower closure facts into a stable Core op stream.
def lower_closure_facts(facts: Array[ClosureLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else {
        match lower_closure_fact(facts.get(index)) {
            Some(op) => lower_closure_facts(facts, index + 1, out.push(op))
            None => lower_closure_facts(facts, index + 1, out)
        }
    }

/// Pick the Core layout for one continuation lowering fact.
def continuation_core_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 => Some(layout_boxed_cont1())
        ContinuationLowerRepeatableContN => Some(layout_continuation_package())
        ContinuationLowerErasedCallableVariant => Some(layout_erased_continuation_package())
    }

/// Layout used by the repeatable frame chain inside a ContN package.
def continuation_frame_chain_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerRepeatableContN => Some(layout_continuation_frame_chain())
        _ => None
    }

/// Lower a continuation fact to a Core op without erasing Cont1/ContN semantics.
def lower_continuation_fact(fact: ContinuationLoweringFact): Option[CoreOp] =
    match fact.kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpBoxedCont1,
                export_main: false,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreConsumedStateMachine,
                frame_count: 0,
            })
        ContinuationLowerRepeatableContN =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContNPackage,
                export_main: false,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: fact.frames.len(),
            })
        ContinuationLowerErasedCallableVariant =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContinuationPackage,
                export_main: false,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            })
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_frame_core_ops(out: Vec[CoreOp], frames: Array[ContinuationFrame], index: usize): Vec[CoreOp] =
    if index == frames.len() { out }
    else {
        let frame = frames.get(index)
        push_continuation_frame_core_ops(
            out.push(CoreOp {
                owner: Some(frame.owner),
                kind: CoreOpStacklessFunction,
                export_main: false,
                function_body: None,
                layout: None,
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            }),
            frames,
            index + 1)
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_core_ops(out: Vec[CoreOp], fact: ContinuationLoweringFact): Vec[CoreOp] =
    match fact.kind {
        ContinuationLowerRepeatableContN =>
            push_continuation_frame_core_ops(out, fact.frames, 0)
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContinuationFrameChain,
                    export_main: false,
                    function_body: None,
                    layout: continuation_frame_chain_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                })
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContNPackage,
                    export_main: false,
                    function_body: None,
                    layout: continuation_core_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                })
        _ =>
            match lower_continuation_fact(fact) {
                Some(op) => out.push(op)
                None => out
            }
    }

/// Lower continuation facts into a stable Core op stream.
def lower_continuation_facts(facts: Array[ContinuationLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else { lower_continuation_facts(facts, index + 1, push_continuation_core_ops(out, facts.get(index))) }

/// Pick the block terminator required by one Core op.
def core_block_terminator_for_op(op: CoreOp): CoreBlockTerminator =
    match op.tail {
        CoreTailCall => CoreBlockTailCall
        CorePlainCall =>
            match op.kind {
                CoreOpTailCall => CoreBlockTailCall
                _ => CoreBlockContinue
            }
    }

/// Convert one Core op into a block-lowering obligation.
def core_block_lowering_obligation_from_op(op: CoreOp): CoreBlockLoweringObligation =
    let terminator = core_block_terminator_for_op(op)
    CoreBlockLoweringObligation {
        owner: op.owner,
        terminator: terminator,
        requires_function_return: false,
        requires_tail_call: terminator == CoreBlockTailCall,
    }

/// Convert Core ops into block-lowering obligations in stable order.
def core_block_lowering_obligations(ops: Array[CoreOp], index: usize, out: Vec[CoreBlockLoweringObligation]): Array[CoreBlockLoweringObligation] =
    if index == ops.len() { out.freeze() }
    else { core_block_lowering_obligations(ops, index + 1, out.push(core_block_lowering_obligation_from_op(ops.get(index)))) }

/// Append one Core op array to another builder.
def append_core_ops(out: Vec[CoreOp], ops: Array[CoreOp], index: usize): Vec[CoreOp] =
    if index == ops.len() { out }
    else { append_core_ops(out.push(ops.get(index)), ops, index + 1) }

/// Lower optimized closure Core to Wasm-GC Core.
def lower_wasm_gc_core(module: OptimizedClosureModule): WasmGcCoreModule =
    let function_ops = lower_typed_function_facts(optimized_closure_typed_module(module).functions, 0, Vec[CoreOp].new())
    let closure_ops = lower_closure_facts(module.closures, 0, Vec[CoreOp].new())
    let continuation_ops = lower_continuation_facts(module.continuations, 0, Vec[CoreOp].new())
    let ops = append_core_ops(Vec[CoreOp].new(), function_ops, 0)
        |> append_core_ops(closure_ops, 0)
        |> append_core_ops(continuation_ops, 0)
    WasmGcCoreModule {
        source: module,
        layouts: build_wasm_gc_layouts(module),
        ops: ops,
        block_obligations: core_block_lowering_obligations(ops, 0, Vec[CoreBlockLoweringObligation].new()),
    }

/// Return true when a Core op requires a layout reference.
def CoreOpKind.requires_layout(self): bool =
    match self {
        CoreOpStructNew => true
        CoreOpArrayNew => true
        CoreOpClosureCall => true
        CoreOpBoxedCont1 => true
        CoreOpContinuationFrameChain => true
        CoreOpContNPackage => true
        CoreOpContinuationPackage => true
        _ => false
    }

/// Return true when a Core op must preserve source owner provenance.
def CoreOpKind.requires_owner(self): bool =
    if self.requires_layout() { true }
    else {
        match self {
            CoreOpStacklessFunction => true
            _ => false
        }
    }
