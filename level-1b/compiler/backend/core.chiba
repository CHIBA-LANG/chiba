/// Wasm-GC Core IR after closure and continuation lowering.
namespace compiler.backend.core

use compiler.closure.env_simplify.*
use compiler.ir.common.*
use compiler.ir.closure.*
use compiler.backend.layout.*
use compiler.semantic.type_infer.*
use compiler.semantic.driver.*
use compiler.semantic.adt_tuple_lowering.*
use compiler.control.cps.*

/// Direct import target selected before emit.
data CoreImportModule {
    CoreImportWasi,
    CoreImportEnv,
}

/// Tail position fact attached before WAT emit.
data CoreTailPosition {
    CoreTailCall,
    CorePlainCall,
}

/// Backend-neutral block terminator required after Core lowering.
data CoreBlockTerminator {
    CoreBlockReturn,
    CoreBlockTailCall,
    CoreBlockContinue,
}

/// Runtime state machine required by a materialized Core operation.
data CoreRuntimeState {
    CoreNoRuntimeState,
    CoreConsumedStateMachine,
}

/// Core expression form after CPS/closure lowering.
data CoreI32ConstAtom {
    CoreI32ConstLiteral(usize),
}

/// Core branch condition carried by expression lowering.
data CoreBranchCondition {
    CoreBranchConditionTrue,
    CoreBranchConditionFalse,
    CoreBranchConditionParam(usize),
}

/// Core expression form after CPS/closure lowering.
data CoreExprKind {
    CoreExprUnit,
    CoreExprI32Const(CoreI32ConstAtom),
    CoreExprParam(usize),
    CoreExprTypedParam(usize, CoreValueType),
    CoreExprLocal(str, CoreValueType),
    CoreExprStringLiteral(str),
    CoreExprCast(CoreExprKind, CoreValueType),
    CoreExprStructNew(WasmGcLayout, Array[CoreExprKind]),
    CoreExprFieldGet(WasmGcLayout, CoreExprKind, usize),
    CoreExprCall(str, Array[CoreExprKind], CoreValueType),
    CoreExprTailCall(str),
    CoreExprTailCallArgs(str, Array[CoreExprKind]),
    CoreExprPrimitiveBinary(PrimitiveBinaryOp, CoreExprKind, CoreExprKind),
    CoreExprIfElse(CoreBranchCondition, CoreExprKind, CoreExprKind),
    CoreExprBranchJoinPending,
}

/// Core operation class understood by the dumb backend emitter.
data CoreOpKind {
    CoreOpFunction,
    CoreOpStacklessFunction,
    CoreOpAdtTupleCtor,
    CoreOpStructNew,
    CoreOpArrayNew,
    CoreOpClosureCall,
    CoreOpBoxedCont1,
    CoreOpContinuationFrameChain,
    CoreOpContNPackage,
    CoreOpContinuationPackage,
    CoreOpTailCall,
    CoreOpImportCall(CoreImportModule),
}

/// Minimal symbol attached to an emitted Core function.
type CoreFunctionSymbol {
    name: str,
}

/// One lowered Core operation.
type CoreOp {
    owner: Option[BinderId],
    kind: CoreOpKind,
    export_main: bool,
    function_symbol: Option[CoreFunctionSymbol],
    i32_param_count: usize,
    param_types: Array[CoreValueType],
    result_type: CoreValueType,
    function_body: Option[CoreExprKind],
    adt_tuple_ctor: Option[CoreAdtCtorLoweringObligation],
    layout: Option[WasmGcLayout],
    tail: CoreTailPosition,
    runtime_state: CoreRuntimeState,
    frame_count: usize,
    frame_index: usize,
}

/// Wasm-GC Core module with a stable layout table.
type WasmGcCoreModule {
    source: OptimizedClosureModule,
    layouts: WasmGcLayoutTable,
    ops: Array[CoreOp],
    block_obligations: Array[CoreBlockLoweringObligation],
    branch_join_obligations: Array[CoreBranchJoinLoweringObligation],
    pattern_decision_obligations: Array[CorePatternDecisionLoweringObligation],
    adt_ctor_obligations: Array[CoreAdtCtorLoweringObligation],
    intrinsic_bridge_obligations: Array[CoreIntrinsicBridgeLoweringObligation],
    intrinsic_bridge_roundtrips: Array[IntrinsicBridgeRoundtripFact],
}

/// Core-to-block lowering obligation before executable WAT emission.
type CoreBlockLoweringObligation {
    owner: Option[BinderId],
    terminator: CoreBlockTerminator,
    requires_function_return: bool,
    requires_tail_call: bool,
}

/// Core obligation for a CPS branch join continuation.
type CoreBranchJoinLoweringObligation {
    owner: BinderId,
    kind: BranchJoinKind,
    requires_join_block: bool,
    requires_tail_terminator: bool,
}

/// Core obligation for lowering pattern decisions to branch tests and field extracts.
type CorePatternDecisionLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_test_chain: bool,
    requires_if_else_lowering: bool,
    requires_field_extracts: bool,
    failure_env_has_no_bindings: bool,
    missing_static_case_is_error: bool,
}

/// Core obligation for lowering ADT constructor helper bodies to executable tuple returns.
type CoreAdtCtorLoweringObligation {
    helper_name: str,
    helper_arity: usize,
    tuple_fields: Array[AdtTupleField],
    tuple_nominal: TupleNominalIdentity,
    requires_symbol_tag_field: bool,
    requires_tuple_record_return: bool,
    requires_utf8_identifier_lowering: bool,
}

/// Core obligation for compiler intrinsic tuple bridge lowering.
type CoreIntrinsicBridgeLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    intrinsic_namespace: String,
    tuple_to_adt_identity: Option[AdtTupleIntrinsicIdentity],
    adt_to_tuple_identity: Option[AdtTupleIntrinsicIdentity],
    requires_tuple_bridge: bool,
    unsafe_cast_is_compiler_only: bool,
    has_typed_roundtrip: bool,
    emits_identity_conversion_helpers: bool,
}

/// Return the closure environment layout used by escaping closures.
def closure_env_layout(): WasmGcLayout = layout_closure_env()

/// Read optimized closure source through a helper for seed WAT lowering.
def optimized_closure_source(module: OptimizedClosureModule): LiftedClosureModule = module.source

/// Read lifted closure source through a helper for seed WAT lowering.
def lifted_source_for_core(module: LiftedClosureModule): ClosureConvertedModule = module.source

/// Read closure-converted source through a helper for seed WAT lowering.
def closure_converted_source_for_core(module: ClosureConvertedModule): SimplifiedContinuationModule = module.source

/// Read simplified continuation source through a helper for seed WAT lowering.
def simplified_source_for_core(module: SimplifiedContinuationModule): CpsUsageModule = module.source

/// Read CPS usage source through a helper for seed WAT lowering.
def cps_usage_source_for_core(module: CpsUsageModule): CpsModule = module.source

/// Read replay-safe CPS source through a helper for seed WAT lowering.
def cps_source_for_core(module: CpsModule): ReplaySafeModule = module.source

/// Read replay usage through a helper for seed WAT lowering.
def replay_usage_for_core(module: ReplaySafeModule): UsageModule = module.usage

/// Read answer-control module through a helper for seed WAT lowering.
def usage_answer_for_core(module: UsageModule): AnswerControlModule = module.answer

/// Read typed module through a helper for seed WAT lowering.
def answer_typed_for_core(module: AnswerControlModule): TypedModule = module.typed

/// Reach the typed module that fed the closure/control/backend pipeline.
def optimized_closure_typed_module(module: OptimizedClosureModule): TypedModule =
    answer_typed_for_core(usage_answer_for_core(replay_usage_for_core(cps_source_for_core(optimized_closure_cps_module(module)))))

/// Reach the CPS module that fed closure conversion.
def optimized_closure_cps_module(module: OptimizedClosureModule): CpsModule =
    cps_usage_source_for_core(simplified_source_for_core(closure_converted_source_for_core(lifted_source_for_core(optimized_closure_source(module)))))

/// Convert typed semantic value type to backend Core value type.
def core_value_type_from_typed(ty: TypedValueType): CoreValueType =
    match ty {
        TypedValUnit => CoreValUnit
        TypedValBool => CoreValBool
        TypedValI32 => CoreValI32
        TypedValI64 => CoreValI64
        TypedValF32 => CoreValF32
        TypedValF64 => CoreValF64
        TypedValUsize => CoreValUsize
        TypedValString => CoreValString
        TypedValStr => CoreValStr
        TypedValEqRef => CoreValEqRef
        TypedValFuncRef => CoreValFuncRef
        TypedValArrayU8Ref => CoreValArrayU8Ref
        TypedValLayoutRef(label) => CoreValLayoutRef(label)
        TypedValNullableLayoutRef(label) => CoreValNullableLayoutRef(label)
    }

/// Convert typed parameter value types into backend Core value types.
def core_value_types_from_typed(types: Array[TypedValueType], index: usize, out: Vec[CoreValueType]): Array[CoreValueType] =
    if index == types.len() { out.freeze() }
    else { core_value_types_from_typed(types, index + 1, out.push(core_value_type_from_typed(types.get(index)))) }

/// Normalize layout labels before storing them in layout field tables.
def core_layout_field_label(label: str): str =
    if label.len() == 0 { label }
    else if label.byte_at(0) == 36 { label }
    else { "$".concat(label) }

/// Convert typed field hints to layout field entries until layout fields become typed.
def core_wasm_gc_fields_from_typed(types: Array[TypedValueType], index: usize, out: Vec[WasmGcFieldLayout]): Array[WasmGcFieldLayout] =
    if index == types.len() { out.freeze() }
    else {
        core_wasm_gc_fields_from_typed(
            types,
            index + 1,
            out.push(wasm_gc_field("_", core_value_type_from_typed(types.get(index)))))
    }

/// Build a typed ad-hoc layout from semantic hints.
def core_wasm_gc_layout_from_typed(label: str, fields: Array[TypedValueType]): WasmGcLayout =
    WasmGcLayout {
        id: 1000 + fields.len(),
        key: label,
        kind: LayoutStruct,
        fields: core_wasm_gc_fields_from_typed(fields, 0, Vec[WasmGcFieldLayout].new()),
    }

/// Convert a typed i32 const atom to Core.
def core_i32_const_atom_from_typed(atom: TypedI32ConstAtom): CoreI32ConstAtom =
    match atom {
        TypedI32ConstLiteral(value) => CoreI32ConstLiteral(value)
    }

/// Convert a typed branch condition to Core.
def core_branch_condition_from_typed(condition: TypedBranchCondition): CoreBranchCondition =
    match condition {
        TypedBranchConditionTrue => CoreBranchConditionTrue
        TypedBranchConditionFalse => CoreBranchConditionFalse
        TypedBranchConditionParam(index) => CoreBranchConditionParam(index)
    }

/// Convert one CPS atom to Core expression form.
def core_expr_from_cps_atom(atom: CpsAtom): CoreExprKind =
    match atom {
        CpsAtomUnit => CoreExprUnit
        CpsAtomI32Const(atom) => CoreExprI32Const(core_i32_const_atom_from_typed(atom))
        CpsAtomParam(index) => CoreExprTypedParam(index, CoreValI32)
        CpsAtomTypedParam(index, ty) => CoreExprTypedParam(index, core_value_type_from_typed(ty))
        CpsAtomLocal(name, ty) => CoreExprLocal(name, core_value_type_from_typed(ty))
        CpsAtomStringLiteral(text) => CoreExprStringLiteral(text)
    }

/// Convert a small resume result into an executable Core atom.
def core_expr_from_usize(value: usize): CoreExprKind =
    CoreExprI32Const(CoreI32ConstLiteral(value))

/// Convert CPS tail-call arguments to Core atoms.
def core_expr_args_from_cps_atoms(args: Array[CpsAtom], index: usize, out: Vec[CoreExprKind]): Array[CoreExprKind] =
    if index == args.len() { out.freeze() }
    else { core_expr_args_from_cps_atoms(args, index + 1, out.push(core_expr_from_cps_atom(args.get(index)))) }

/// Convert CPS tail-call expression arguments to Core expressions.
def core_expr_args_from_cps_terms(args: Array[CpsTermKind], index: usize, out: Vec[CoreExprKind]): Array[CoreExprKind] =
    if index == args.len() { out.freeze() }
    else { core_expr_args_from_cps_terms(args, index + 1, out.push(core_expr_from_cps_term(args.get(index)))) }

/// Convert a CPS tail call to Core expression form.
def core_expr_from_cps_tail_call_arg(target: str, args: Array[CpsAtom]): CoreExprKind =
    if args.len() == 0 { CoreExprTailCall(target) }
    else if args.len() > 1 { CoreExprTailCallArgs(target, core_expr_args_from_cps_atoms(args, 0, Vec[CoreExprKind].new())) }
    else { CoreExprTailCallArgs(target, Vec[CoreExprKind].new().push(core_expr_from_cps_atom(args.get(0))).freeze()) }

/// Convert a CPS tail term to backend Core expression form.
def core_expr_from_cps_term(term: CpsTermKind): CoreExprKind =
    match term {
        CpsTermReturn(atom) => core_expr_from_cps_atom(atom)
        CpsTermTailCall(target, args) => core_expr_from_cps_tail_call_arg(target, args)
        CpsTermTailCallExprs(target, args) => CoreExprTailCallArgs(target, core_expr_args_from_cps_terms(args, 0, Vec[CoreExprKind].new()))
        CpsTermCast(value, ty) => CoreExprCast(core_expr_from_cps_term(value), core_value_type_from_typed(ty))
        CpsTermStructNew(layout, fields, args) =>
            CoreExprStructNew(core_wasm_gc_layout_from_typed(layout, fields), core_expr_args_from_cps_terms(args, 0, Vec[CoreExprKind].new()))
        CpsTermFieldGet(layout, fields, value, index) =>
            CoreExprFieldGet(core_wasm_gc_layout_from_typed(layout, fields), core_expr_from_cps_term(value), index)
        CpsTermCall(target, args, ty) =>
            CoreExprCall(target, core_expr_args_from_cps_terms(args, 0, Vec[CoreExprKind].new()), core_value_type_from_typed(ty))
        CpsTermPrimitiveBinary(op, left, right) => CoreExprPrimitiveBinary(op, core_expr_from_cps_term(left), core_expr_from_cps_term(right))
        CpsTermBranch(condition, then_term, else_term) =>
            CoreExprIfElse(
                core_branch_condition_from_typed(condition),
                core_expr_from_cps_term(then_term),
                core_expr_from_cps_term(else_term))
        CpsTermPendingJoin => CoreExprBranchJoinPending
        _ => CoreExprBranchJoinPending
    }

/// Convert an extracted stackless resume body into backend Core expression form.
def core_expr_from_stackless_resume_body(body: StacklessResumeBodyKind): CoreExprKind =
    match body {
        StacklessResumeBodyShiftN => CoreExprBranchJoinPending
        StacklessResumeBodyShift => CoreExprBranchJoinPending
        StacklessResumeBodyReset => CoreExprBranchJoinPending
        StacklessResumeBodyConst(value) => core_expr_from_usize(value)
        StacklessResumeBodyParam(index) => CoreExprTypedParam(index, CoreValI32)
        StacklessResumeBodyMultiResume(_, last) => core_expr_from_usize(last)
        StacklessResumeBodyPending => CoreExprBranchJoinPending
    }

/// Convert one stackless resume body into the expression for a specific frame.
def core_expr_from_stackless_resume_frame_body(body: StacklessResumeBodyKind, frame_index: usize): CoreExprKind =
    match body {
        StacklessResumeBodyMultiResume(first, last) =>
            if frame_index == 0 { core_expr_from_usize(first) } else { core_expr_from_usize(last) }
        _ => core_expr_from_stackless_resume_body(body)
    }

/// Return the i32 parameter count required by one stackless resume body.
def core_stackless_resume_param_count(body: StacklessResumeBodyKind): usize =
    match body {
        StacklessResumeBodyParam(index) => index + 1
        _ => 0
    }

/// Build a typed parameter vector for legacy i32-param function facts.
def core_i32_param_types(count: usize, out: Vec[CoreValueType]): Array[CoreValueType] =
    if count == 0 { out.freeze() }
    else { core_i32_param_types(count - 1, out.push(CoreValI32)) }

/// Return true when two binder ids identify the same owner.
def core_binder_id_eq(left: BinderId, right: BinderId): bool = left.index == right.index

/// Find the typed function metadata for one CPS term owner.
def core_typed_function_for_owner(functions: Array[TypedFunctionFact], owner: BinderId, index: usize): Option[TypedFunctionFact] =
    if index == functions.len() { None }
    else if core_binder_id_eq(functions.get(index).owner, owner) { Some(functions.get(index)) }
    else { core_typed_function_for_owner(functions, owner, index + 1) }

/// Lower one CPS term fact into a Core function op.
def lower_cps_term_fact(term: CpsTermFact, function: TypedFunctionFact): CoreOp =
    CoreOp {
        owner: Some(term.owner),
        kind: CoreOpFunction,
        export_main: function.is_main,
        function_symbol: Some(CoreFunctionSymbol { name: function.symbol }),
        i32_param_count: function.i32_param_count,
        param_types: core_value_types_from_typed(function.param_types, 0, Vec[CoreValueType].new()),
        result_type: core_value_type_from_typed(function.result_type),
        function_body: Some(core_expr_from_cps_term(term.term)),
        adt_tuple_ctor: None,
        layout: None,
        tail: CorePlainCall,
        runtime_state: CoreNoRuntimeState,
        frame_count: 0,
        frame_index: 0,
    }

/// Lower CPS term facts into Core ops before closure/continuation materialization.
def lower_cps_term_facts(terms: Array[CpsTermFact], functions: Array[TypedFunctionFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == terms.len() { out.freeze() }
    else {
        let term = terms.get(index)
        match core_typed_function_for_owner(functions, term.owner, 0) {
            Some(function) => lower_cps_term_facts(terms, functions, index + 1, out.push(lower_cps_term_fact(term, function)))
            None => lower_cps_term_facts(terms, functions, index + 1, out)
        }
    }

/// Lower one closure lowering fact into an optional Core operation.
def lower_closure_fact(fact: ClosureLoweringFact): Option[CoreOp] =
    match fact.kind {
        ClosureNoCaptureDirect => None
        ClosureKnownCallableDirect => None
        ClosureErasedCallableDispatch => None
        ClosureCapturingEnv =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpClosureCall,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                param_types: Vec[CoreValueType].new().freeze(),
                result_type: CoreValUnit,
                function_body: None,
                adt_tuple_ctor: None,
                layout: Some(closure_env_layout()),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
                frame_index: 0,
            })
    }

/// Lower closure facts into a stable Core op stream.
def lower_closure_facts(facts: Array[ClosureLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else {
        match lower_closure_fact(facts.get(index)) {
            Some(op) => lower_closure_facts(facts, index + 1, out.push(op))
            None => lower_closure_facts(facts, index + 1, out)
        }
    }

/// Pick the Core layout for one continuation lowering fact.
def continuation_core_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 => Some(layout_boxed_cont1())
        ContinuationLowerRepeatableContN => Some(layout_continuation_package())
        ContinuationLowerErasedCallableVariant => Some(layout_erased_continuation_package())
    }

/// Layout used by the repeatable frame chain inside a ContN package.
def continuation_frame_chain_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerRepeatableContN => Some(layout_continuation_frame_chain())
        _ => None
    }

/// Lower a continuation fact to a Core op without erasing Cont1/ContN semantics.
def lower_continuation_fact(fact: ContinuationLoweringFact): Option[CoreOp] =
    match fact.kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpBoxedCont1,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                param_types: Vec[CoreValueType].new().freeze(),
                result_type: CoreValUnit,
                function_body: None,
                adt_tuple_ctor: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreConsumedStateMachine,
                frame_count: 0,
                frame_index: 0,
            })
        ContinuationLowerRepeatableContN =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContNPackage,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                param_types: Vec[CoreValueType].new().freeze(),
                result_type: CoreValUnit,
                function_body: None,
                adt_tuple_ctor: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: fact.frames.len(),
                frame_index: 0,
            })
        ContinuationLowerErasedCallableVariant =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContinuationPackage,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                param_types: Vec[CoreValueType].new().freeze(),
                result_type: CoreValUnit,
                function_body: None,
                adt_tuple_ctor: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
                frame_index: 0,
            })
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_frame_core_ops(out: Vec[CoreOp], frames: Array[ContinuationFrame], index: usize): Vec[CoreOp] =
    if index == frames.len() { out }
    else {
        let frame = frames.get(index)
        push_continuation_frame_core_ops(
            out.push(CoreOp {
                owner: Some(frame.owner),
                kind: CoreOpStacklessFunction,
                export_main: false,
                function_symbol: None,
                i32_param_count: core_stackless_resume_param_count(frame.resume.body),
                param_types: core_i32_param_types(core_stackless_resume_param_count(frame.resume.body), Vec[CoreValueType].new()),
                result_type: CoreValI32,
                function_body: Some(core_expr_from_stackless_resume_frame_body(frame.resume.body, index)),
                adt_tuple_ctor: None,
                layout: None,
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
                frame_index: index,
            }),
            frames,
            index + 1)
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_core_ops(out: Vec[CoreOp], fact: ContinuationLoweringFact): Vec[CoreOp] =
    match fact.kind {
        ContinuationLowerRepeatableContN =>
            push_continuation_frame_core_ops(out, fact.frames, 0)
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContinuationFrameChain,
                    export_main: false,
                    function_symbol: None,
                    i32_param_count: 0,
                    param_types: Vec[CoreValueType].new().freeze(),
                    result_type: CoreValUnit,
                    function_body: None,
                    adt_tuple_ctor: None,
                    layout: continuation_frame_chain_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                    frame_index: 0,
                })
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContNPackage,
                    export_main: false,
                    function_symbol: None,
                    i32_param_count: 0,
                    param_types: Vec[CoreValueType].new().freeze(),
                    result_type: CoreValUnit,
                    function_body: None,
                    adt_tuple_ctor: None,
                    layout: continuation_core_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                    frame_index: 0,
                })
        _ =>
            match lower_continuation_fact(fact) {
                Some(op) => out.push(op)
                None => out
            }
    }

/// Lower continuation facts into a stable Core op stream.
def lower_continuation_facts(facts: Array[ContinuationLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else { lower_continuation_facts(facts, index + 1, push_continuation_core_ops(out, facts.get(index))) }

/// Pick the block terminator required by one lowered Core function body.
def core_function_body_terminator(body: Option[CoreExprKind]): CoreBlockTerminator =
    match body {
        Some(CoreExprTailCall(_)) => CoreBlockTailCall
        Some(CoreExprTailCallArgs(_, _)) => CoreBlockTailCall
        Some(CoreExprCall(_, _, _)) => CoreBlockReturn
        Some(CoreExprStructNew(_, _)) => CoreBlockReturn
        Some(CoreExprFieldGet(_, _, _)) => CoreBlockReturn
        Some(CoreExprCast(_, _)) => CoreBlockReturn
        Some(CoreExprPrimitiveBinary(_, _, _)) => CoreBlockReturn
        Some(CoreExprBranchJoinPending) => CoreBlockContinue
        None => CoreBlockContinue
        _ => CoreBlockReturn
    }

/// Pick the block terminator required by one Core op.
def core_block_terminator_for_op(op: CoreOp): CoreBlockTerminator =
    match op.kind {
        CoreOpFunction => core_function_body_terminator(op.function_body)
        _ =>
            match op.tail {
                CoreTailCall => CoreBlockTailCall
                CorePlainCall =>
                    match op.kind {
                        CoreOpTailCall => CoreBlockTailCall
                        _ => CoreBlockContinue
                    }
            }
    }

/// Convert one Core op into a block-lowering obligation.
def core_block_lowering_obligation_from_op(op: CoreOp): CoreBlockLoweringObligation =
    let terminator = core_block_terminator_for_op(op)
    CoreBlockLoweringObligation {
        owner: op.owner,
        terminator: terminator,
        requires_function_return: terminator == CoreBlockReturn,
        requires_tail_call: terminator == CoreBlockTailCall,
    }

/// Convert Core ops into block-lowering obligations in stable order.
def core_block_lowering_obligations(ops: Array[CoreOp], index: usize, out: Vec[CoreBlockLoweringObligation]): Array[CoreBlockLoweringObligation] =
    if index == ops.len() { out.freeze() }
    else { core_block_lowering_obligations(ops, index + 1, out.push(core_block_lowering_obligation_from_op(ops.get(index)))) }

/// Convert one CPS branch join fact into a backend-neutral Core obligation.
def core_branch_join_lowering_obligation_from_fact(fact: CpsBranchJoinFact): CoreBranchJoinLoweringObligation =
    CoreBranchJoinLoweringObligation {
        owner: fact.owner,
        kind: fact.kind,
        requires_join_block: fact.requires_join_continuation,
        requires_tail_terminator: fact.all_arms_resume_to_same_tail,
    }

/// Convert CPS branch join facts into Core obligations.
def core_branch_join_lowering_obligations(facts: Array[CpsBranchJoinFact], index: usize, out: Vec[CoreBranchJoinLoweringObligation]): Array[CoreBranchJoinLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_branch_join_lowering_obligations(facts, index + 1, out.push(core_branch_join_lowering_obligation_from_fact(facts.get(index)))) }

/// Convert one CPS pattern decision into a backend-neutral Core obligation.
def core_pattern_decision_lowering_obligation_from_fact(fact: CpsPatternDecisionFact): CorePatternDecisionLoweringObligation =
    CorePatternDecisionLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_test_chain: fact.requires_test_chain,
        requires_if_else_lowering: fact.requires_test_chain,
        requires_field_extracts: fact.lowers_to_if_else_and_field_extract,
        failure_env_has_no_bindings: fact.failure_env_has_no_bindings,
        missing_static_case_is_error: fact.missing_static_case_is_error,
    }

/// Convert CPS pattern decision facts into Core lowering obligations.
def core_pattern_decision_lowering_obligations(facts: Array[CpsPatternDecisionFact], index: usize, out: Vec[CorePatternDecisionLoweringObligation]): Array[CorePatternDecisionLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_pattern_decision_lowering_obligations(facts, index + 1, out.push(core_pattern_decision_lowering_obligation_from_fact(facts.get(index)))) }

/// Convert one CPS ADT constructor fact into a Core tuple-return lowering obligation.
def core_adt_ctor_lowering_obligation_from_fact(fact: CpsAdtCtorLoweringFact): CoreAdtCtorLoweringObligation =
    CoreAdtCtorLoweringObligation {
        helper_name: fact.helper_name,
        helper_arity: fact.helper_arity,
        tuple_fields: fact.source.tuple_fields,
        tuple_nominal: fact.tuple_nominal,
        requires_symbol_tag_field: fact.returns_canonical_tuple,
        requires_tuple_record_return: fact.requires_tail_tuple_return,
        requires_utf8_identifier_lowering: fact.requires_utf8_identifier_lowering,
    }

/// Convert CPS ADT constructor facts into Core obligations.
def core_adt_ctor_lowering_obligations(facts: Array[CpsAdtCtorLoweringFact], index: usize, out: Vec[CoreAdtCtorLoweringObligation]): Array[CoreAdtCtorLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_adt_ctor_lowering_obligations(facts, index + 1, out.push(core_adt_ctor_lowering_obligation_from_fact(facts.get(index)))) }

/// Lower one ADT constructor tuple helper into an executable Core helper function.
def lower_adt_ctor_helper_op(obligation: CoreAdtCtorLoweringObligation): CoreOp =
    CoreOp {
        owner: None,
        kind: CoreOpAdtTupleCtor,
        export_main: false,
        function_symbol: Some(CoreFunctionSymbol { name: obligation.helper_name }),
        i32_param_count: obligation.helper_arity,
        param_types: Vec[CoreValueType].new().freeze(),
        result_type: CoreValEqRef,
        function_body: None,
        adt_tuple_ctor: Some(obligation),
        layout: None,
        tail: CorePlainCall,
        runtime_state: CoreNoRuntimeState,
        frame_count: 0,
        frame_index: 0,
    }

/// Lower ADT constructor tuple obligations into executable Core helper ops.
def lower_adt_ctor_helper_ops(obligations: Array[CoreAdtCtorLoweringObligation], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == obligations.len() { out.freeze() }
    else { lower_adt_ctor_helper_ops(obligations, index + 1, out.push(lower_adt_ctor_helper_op(obligations.get(index)))) }

/// Convert one CPS intrinsic bridge fact into a Core lowering obligation.
def core_intrinsic_bridge_lowering_obligation_from_fact(fact: CpsIntrinsicBridgeFact): CoreIntrinsicBridgeLoweringObligation =
    CoreIntrinsicBridgeLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        intrinsic_namespace: fact.intrinsic_namespace,
        tuple_to_adt_identity: fact.tuple_to_adt_identity,
        adt_to_tuple_identity: fact.adt_to_tuple_identity,
        requires_tuple_bridge: fact.requires_tuple_bridge,
        unsafe_cast_is_compiler_only: fact.unsafe_cast_is_compiler_only,
        has_typed_roundtrip: false,
        emits_identity_conversion_helpers: false,
    }

/// Return true when a typed roundtrip fact exists for the same owner.
def core_intrinsic_bridge_has_roundtrip(roundtrips: Array[IntrinsicBridgeRoundtripFact], owner: BinderId, index: usize): bool =
    if index == roundtrips.len() { false }
    else if roundtrips.get(index).owner.index == owner.index && roundtrips.get(index).preserves_identity { true }
    else { core_intrinsic_bridge_has_roundtrip(roundtrips, owner, index + 1) }

/// Attach typed roundtrip evidence to one Core intrinsic bridge obligation.
def core_intrinsic_bridge_mark_roundtrip(obligation: CoreIntrinsicBridgeLoweringObligation, roundtrips: Array[IntrinsicBridgeRoundtripFact]): CoreIntrinsicBridgeLoweringObligation =
    CoreIntrinsicBridgeLoweringObligation {
        owner: obligation.owner,
        file: obligation.file,
        intrinsic_namespace: obligation.intrinsic_namespace,
        tuple_to_adt_identity: obligation.tuple_to_adt_identity,
        adt_to_tuple_identity: obligation.adt_to_tuple_identity,
        requires_tuple_bridge: obligation.requires_tuple_bridge,
        unsafe_cast_is_compiler_only: obligation.unsafe_cast_is_compiler_only,
        has_typed_roundtrip: core_intrinsic_bridge_has_roundtrip(roundtrips, obligation.owner, 0),
        emits_identity_conversion_helpers: core_intrinsic_bridge_has_roundtrip(roundtrips, obligation.owner, 0),
    }

/// Convert CPS intrinsic bridge facts into Core lowering obligations.
def core_intrinsic_bridge_lowering_obligations(facts: Array[CpsIntrinsicBridgeFact], roundtrips: Array[IntrinsicBridgeRoundtripFact], index: usize, out: Vec[CoreIntrinsicBridgeLoweringObligation]): Array[CoreIntrinsicBridgeLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_intrinsic_bridge_lowering_obligations(facts, roundtrips, index + 1, out.push(core_intrinsic_bridge_mark_roundtrip(core_intrinsic_bridge_lowering_obligation_from_fact(facts.get(index)), roundtrips))) }

/// Append one Core op array to another builder.
def append_core_ops(out: Vec[CoreOp], ops: Array[CoreOp], index: usize): Vec[CoreOp] =
    if index == ops.len() { out }
    else { append_core_ops(out.push(ops.get(index)), ops, index + 1) }

/// Append one layout table to a builder.
def append_wasm_gc_layouts(out: Vec[WasmGcLayout], layouts: Array[WasmGcLayout], index: usize): Vec[WasmGcLayout] =
    if index == layouts.len() { out }
    else { append_wasm_gc_layouts(out.push(layouts.get(index)), layouts, index + 1) }

/// Read a layout key through a typed helper so WAT lowering keeps field ownership.
def core_layout_key(layout: WasmGcLayout): str = layout.key

/// Classify layout kinds without relying on derived enum equality in active WAT lowering.
def core_layout_kind_is_struct(kind: WasmGcLayoutKind): bool =
    match kind {
        LayoutStruct => true
        _ => false
    }

/// Push expression-owned typed layouts so WAT can declare their real fields.
def core_layouts_push_unique(out: Vec[WasmGcLayout], layout: WasmGcLayout): Vec[WasmGcLayout] =
    if core_layout_kind_is_struct(layout.kind) && core_layout_key(layout).len() > 0 { out.push(layout) }
    else { out }

/// Collect layouts referenced by Core expression forms.
def collect_core_expr_layouts(expr: CoreExprKind, out: Vec[WasmGcLayout]): Vec[WasmGcLayout] =
    match expr {
        CoreExprCast(value, _) => collect_core_expr_layouts(value, out)
        CoreExprStructNew(layout, args) => collect_core_expr_array_layouts(args, 0, core_layouts_push_unique(out, layout))
        CoreExprFieldGet(layout, value, _) => collect_core_expr_layouts(value, core_layouts_push_unique(out, layout))
        CoreExprCall(_, args, _) => collect_core_expr_array_layouts(args, 0, out)
        CoreExprTailCallArgs(_, args) => collect_core_expr_array_layouts(args, 0, out)
        CoreExprPrimitiveBinary(_, left, right) => collect_core_expr_layouts(right, collect_core_expr_layouts(left, out))
        CoreExprIfElse(_, then_expr, else_expr) => collect_core_expr_layouts(else_expr, collect_core_expr_layouts(then_expr, out))
        _ => out
    }

/// Collect layouts from Core expression arrays.
def collect_core_expr_array_layouts(args: Array[CoreExprKind], index: usize, out: Vec[WasmGcLayout]): Vec[WasmGcLayout] =
    if index == args.len() { out }
    else { collect_core_expr_array_layouts(args, index + 1, collect_core_expr_layouts(args.get(index), out)) }

/// Collect layouts referenced by one Core op.
def collect_core_op_layouts(op: CoreOp, out: Vec[WasmGcLayout]): Vec[WasmGcLayout] =
    match op.function_body {
        Some(body) => collect_core_expr_layouts(body, out)
        None => out
    }

/// Collect all typed layouts referenced by executable Core ops.
def collect_core_ops_layouts(ops: Array[CoreOp], index: usize, out: Vec[WasmGcLayout]): Array[WasmGcLayout] =
    if index == ops.len() { out.freeze() }
    else { collect_core_ops_layouts(ops, index + 1, collect_core_op_layouts(ops.get(index), out)) }

/// Return true when a layout key appeared earlier in the collected layout stream.
def core_layout_key_seen_before(layouts: Array[WasmGcLayout], index: usize, key: str, cursor: usize): bool =
    if cursor >= index { false }
    else if core_layout_key(layouts.get(cursor)) == key { true }
    else { core_layout_key_seen_before(layouts, index, key, cursor + 1) }

/// Deduplicate concrete WAT layout declarations by stable layout key.
def dedupe_wasm_gc_layouts(layouts: Array[WasmGcLayout], index: usize, out: Vec[WasmGcLayout]): Array[WasmGcLayout] =
    if index == layouts.len() { out.freeze() }
    else {
        let layout = layouts.get(index)
        if core_layout_key_seen_before(layouts, index, core_layout_key(layout), 0) {
            dedupe_wasm_gc_layouts(layouts, index + 1, out)
        } else {
            dedupe_wasm_gc_layouts(layouts, index + 1, out.push(layout))
        }
    }

/// Append Core expression-owned layouts after canonical runtime layouts.
def append_collected_core_layouts(out: Vec[WasmGcLayout], layouts: Array[WasmGcLayout], index: usize): Vec[WasmGcLayout] =
    if index == layouts.len() { out }
    else { append_collected_core_layouts(core_layouts_push_unique(out, layouts.get(index)), layouts, index + 1) }

/// Lower optimized closure Core to Wasm-GC Core.
def wasm_gc_layout_table_entries(table: WasmGcLayoutTable): Array[WasmGcLayout] = table.entries

/// Lower optimized closure Core to Wasm-GC Core.
def lower_wasm_gc_core(module: OptimizedClosureModule): WasmGcCoreModule =
    let cps_module = optimized_closure_cps_module(module)
    let function_ops = lower_cps_term_facts(cps_module.terms, optimized_closure_typed_module(module).functions, 0, Vec[CoreOp].new())
    let closure_ops = lower_closure_facts(module.closures, 0, Vec[CoreOp].new())
    let continuation_ops = lower_continuation_facts(module.continuations, 0, Vec[CoreOp].new())
    let branch_join_obligations = core_branch_join_lowering_obligations(cps_module.branch_joins, 0, Vec[CoreBranchJoinLoweringObligation].new())
    let pattern_decision_obligations = core_pattern_decision_lowering_obligations(cps_module.pattern_decisions, 0, Vec[CorePatternDecisionLoweringObligation].new())
    let adt_ctor_obligations = core_adt_ctor_lowering_obligations(cps_module.adt_ctors, 0, Vec[CoreAdtCtorLoweringObligation].new())
    let intrinsic_bridge_obligations = core_intrinsic_bridge_lowering_obligations(cps_module.intrinsic_bridges, cps_module.intrinsic_bridge_roundtrips, 0, Vec[CoreIntrinsicBridgeLoweringObligation].new())
    let adt_ctor_ops = lower_adt_ctor_helper_ops(adt_ctor_obligations, 0, Vec[CoreOp].new())
    let ops = append_core_ops(Vec[CoreOp].new(), function_ops, 0)
        |> append_core_ops(closure_ops, 0)
        |> append_core_ops(continuation_ops, 0)
        |> append_core_ops(adt_ctor_ops, 0)
    let base_layouts = build_wasm_gc_layouts(module)
    let layout_entries = wasm_gc_layout_table_entries(base_layouts)
    WasmGcCoreModule {
        source: module,
        layouts: WasmGcLayoutTable { entries: layout_entries },
        ops: ops,
        block_obligations: Vec[CoreBlockLoweringObligation].new().freeze(),
        branch_join_obligations: branch_join_obligations,
        pattern_decision_obligations: pattern_decision_obligations,
        adt_ctor_obligations: Vec[CoreAdtCtorLoweringObligation].new().freeze(),
        intrinsic_bridge_obligations: intrinsic_bridge_obligations,
        intrinsic_bridge_roundtrips: cps_module.intrinsic_bridge_roundtrips,
    }

/// Return true when a Core op requires a layout reference.
def CoreOpKind.requires_layout(self): bool =
    match self {
        CoreOpStructNew => true
        CoreOpArrayNew => true
        CoreOpClosureCall => true
        CoreOpBoxedCont1 => true
        CoreOpContinuationFrameChain => true
        CoreOpContNPackage => true
        CoreOpContinuationPackage => true
        _ => false
    }

/// Return true when a Core op must preserve source owner provenance.
def CoreOpKind.requires_owner(self): bool =
    if self.requires_layout() { true }
    else {
        match self {
            CoreOpStacklessFunction => true
            CoreOpAdtTupleCtor => true
            _ => false
        }
    }
