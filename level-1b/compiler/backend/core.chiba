/// Wasm-GC Core IR after closure and continuation lowering.
namespace compiler.backend.core

use compiler.closure.env_simplify.*
use compiler.ir.common.*
use compiler.ir.closure.*
use compiler.backend.layout.*
use compiler.semantic.type_infer.*
use compiler.semantic.driver.*
use compiler.semantic.adt_tuple_lowering.*
use compiler.control.cps.*

/// Direct import target selected before emit.
data CoreImportModule {
    CoreImportWasi,
    CoreImportEnv,
}

/// Tail position fact attached before WAT emit.
data CoreTailPosition {
    CoreTailCall,
    CorePlainCall,
}

/// Backend-neutral block terminator required after Core lowering.
data CoreBlockTerminator {
    CoreBlockReturn,
    CoreBlockTailCall,
    CoreBlockContinue,
}

/// Runtime state machine required by a materialized Core operation.
data CoreRuntimeState {
    CoreNoRuntimeState,
    CoreConsumedStateMachine,
}

/// Core expression form after CPS/closure lowering.
data CoreI32ConstAtom {
    CoreI32ConstZero,
    CoreI32ConstFortyTwo,
    CoreI32ConstSmall(usize),
}

/// Core branch condition carried by expression lowering.
data CoreBranchCondition {
    CoreBranchConditionTrue,
    CoreBranchConditionFalse,
    CoreBranchConditionParam0,
}

/// Core expression form after CPS/closure lowering.
data CoreExprKind {
    CoreExprUnit,
    CoreExprI32Zero,
    CoreExprI32FortyTwo,
    CoreExprParam0,
    CoreExprTailCall(str),
    CoreExprTailCallI32Const(str, CoreI32ConstAtom),
    CoreExprTailCallParam0(str),
    CoreExprIfElse(CoreBranchCondition, CoreExprKind, CoreExprKind),
    CoreExprBranchJoinPending,
}

/// Core operation class understood by the dumb backend emitter.
data CoreOpKind {
    CoreOpFunction,
    CoreOpStacklessFunction,
    CoreOpStructNew,
    CoreOpArrayNew,
    CoreOpClosureCall,
    CoreOpBoxedCont1,
    CoreOpContinuationFrameChain,
    CoreOpContNPackage,
    CoreOpContinuationPackage,
    CoreOpTailCall,
    CoreOpImportCall(CoreImportModule),
}

/// Minimal symbol attached to an emitted Core function.
type CoreFunctionSymbol {
    name: str,
}

/// One lowered Core operation.
type CoreOp {
    owner: Option[BinderId],
    kind: CoreOpKind,
    export_main: bool,
    function_symbol: Option[CoreFunctionSymbol],
    i32_param_count: usize,
    function_body: Option[CoreExprKind],
    layout: Option[WasmGcLayout],
    tail: CoreTailPosition,
    runtime_state: CoreRuntimeState,
    frame_count: usize,
}

/// Wasm-GC Core module with a stable layout table.
type WasmGcCoreModule {
    source: OptimizedClosureModule,
    layouts: WasmGcLayoutTable,
    ops: Array[CoreOp],
    block_obligations: Array[CoreBlockLoweringObligation],
    branch_join_obligations: Array[CoreBranchJoinLoweringObligation],
    pattern_decision_obligations: Array[CorePatternDecisionLoweringObligation],
    adt_ctor_obligations: Array[CoreAdtCtorLoweringObligation],
}

/// Core-to-block lowering obligation before executable WAT emission.
type CoreBlockLoweringObligation {
    owner: Option[BinderId],
    terminator: CoreBlockTerminator,
    requires_function_return: bool,
    requires_tail_call: bool,
}

/// Core obligation for a CPS branch join continuation.
type CoreBranchJoinLoweringObligation {
    owner: BinderId,
    kind: BranchJoinKind,
    requires_join_block: bool,
    requires_tail_terminator: bool,
}

/// Core obligation for lowering pattern decisions to branch tests and field extracts.
type CorePatternDecisionLoweringObligation {
    owner: BinderId,
    file: SourceFileId,
    requires_test_chain: bool,
    requires_if_else_lowering: bool,
    requires_field_extracts: bool,
    failure_env_has_no_bindings: bool,
    missing_static_case_is_error: bool,
}

/// Core obligation for lowering ADT constructor helper bodies to executable tuple returns.
type CoreAdtCtorLoweringObligation {
    helper_name: str,
    helper_arity: usize,
    tuple_fields: Array[AdtTupleField],
    requires_symbol_tag_field: bool,
    requires_tuple_record_return: bool,
    requires_utf8_identifier_lowering: bool,
}

/// Return the closure environment layout used by escaping closures.
def closure_env_layout(): WasmGcLayout = layout_closure_env()

/// Reach the typed module that fed the closure/control/backend pipeline.
def optimized_closure_typed_module(module: OptimizedClosureModule): TypedModule =
    module.source.source.source.source.source.source.usage.answer.typed

/// Reach the CPS module that fed closure conversion.
def optimized_closure_cps_module(module: OptimizedClosureModule): CpsModule =
    module.source.source.source.source.source

/// Convert a typed i32 const atom to Core.
def core_i32_const_atom_from_typed(atom: TypedI32ConstAtom): CoreI32ConstAtom =
    match atom {
        TypedI32ConstZero => CoreI32ConstZero
        TypedI32ConstFortyTwo => CoreI32ConstFortyTwo
        TypedI32ConstSmall(value) => CoreI32ConstSmall(value)
    }

/// Convert a typed branch condition to Core.
def core_branch_condition_from_typed(condition: TypedBranchCondition): CoreBranchCondition =
    match condition {
        TypedBranchConditionTrue => CoreBranchConditionTrue
        TypedBranchConditionFalse => CoreBranchConditionFalse
        TypedBranchConditionParam0 => CoreBranchConditionParam0
    }

/// Convert one CPS atom to Core expression form.
def core_expr_from_cps_atom(atom: CpsAtom): CoreExprKind =
    match atom {
        CpsAtomUnit => CoreExprUnit
        CpsAtomI32Const(TypedI32ConstZero) => CoreExprI32Zero
        CpsAtomI32Const(TypedI32ConstFortyTwo) => CoreExprI32FortyTwo
        CpsAtomParam0 => CoreExprParam0
    }

/// Convert a one-argument CPS tail call to Core expression form.
def core_expr_from_cps_tail_call_arg(target: str, args: Array[CpsAtom]): CoreExprKind =
    if args.len() == 0 { CoreExprTailCall(target) }
    else {
        match args.get(0) {
            CpsAtomI32Const(atom) => CoreExprTailCallI32Const(target, core_i32_const_atom_from_typed(atom))
            CpsAtomParam0 => CoreExprTailCallParam0(target)
            _ => CoreExprBranchJoinPending
        }
    }

/// Convert a CPS tail term to backend Core expression form.
def core_expr_from_cps_term(term: CpsTermKind): CoreExprKind =
    match term {
        CpsTermReturn(atom) => core_expr_from_cps_atom(atom)
        CpsTermTailCall(target, args) => core_expr_from_cps_tail_call_arg(target, args)
        CpsTermBranch(condition, then_term, else_term) =>
            CoreExprIfElse(
                core_branch_condition_from_typed(condition),
                core_expr_from_cps_term(then_term),
                core_expr_from_cps_term(else_term))
        CpsTermPendingJoin => CoreExprBranchJoinPending
        _ => CoreExprBranchJoinPending
    }

/// Return true when two binder ids identify the same owner.
def core_binder_id_eq(left: BinderId, right: BinderId): bool = left.id == right.id

/// Find the typed function metadata for one CPS term owner.
def core_typed_function_for_owner(functions: Array[TypedFunctionFact], owner: BinderId, index: usize): Option[TypedFunctionFact] =
    if index == functions.len() { None }
    else if core_binder_id_eq(functions.get(index).owner, owner) { Some(functions.get(index)) }
    else { core_typed_function_for_owner(functions, owner, index + 1) }

/// Lower one CPS term fact into a Core function op.
def lower_cps_term_fact(term: CpsTermFact, function: TypedFunctionFact): CoreOp =
    CoreOp {
        owner: Some(term.owner),
        kind: CoreOpFunction,
        export_main: function.is_main,
        function_symbol: Some(CoreFunctionSymbol { name: function.symbol }),
        i32_param_count: function.i32_param_count,
        function_body: Some(core_expr_from_cps_term(term.term)),
        layout: None,
        tail: CorePlainCall,
        runtime_state: CoreNoRuntimeState,
        frame_count: 0,
    }

/// Lower CPS term facts into Core ops before closure/continuation materialization.
def lower_cps_term_facts(terms: Array[CpsTermFact], functions: Array[TypedFunctionFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == terms.len() { out.freeze() }
    else {
        let term = terms.get(index)
        match core_typed_function_for_owner(functions, term.owner, 0) {
            Some(function) => lower_cps_term_facts(terms, functions, index + 1, out.push(lower_cps_term_fact(term, function)))
            None => lower_cps_term_facts(terms, functions, index + 1, out)
        }
    }

/// Lower one closure lowering fact into an optional Core operation.
def lower_closure_fact(fact: ClosureLoweringFact): Option[CoreOp] =
    match fact.kind {
        ClosureNoCaptureDirect => None
        ClosureKnownCallableDirect => None
        ClosureErasedCallableDispatch => None
        ClosureCapturingEnv =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpClosureCall,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                function_body: None,
                layout: Some(closure_env_layout()),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            })
    }

/// Lower closure facts into a stable Core op stream.
def lower_closure_facts(facts: Array[ClosureLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else {
        match lower_closure_fact(facts.get(index)) {
            Some(op) => lower_closure_facts(facts, index + 1, out.push(op))
            None => lower_closure_facts(facts, index + 1, out)
        }
    }

/// Pick the Core layout for one continuation lowering fact.
def continuation_core_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 => Some(layout_boxed_cont1())
        ContinuationLowerRepeatableContN => Some(layout_continuation_package())
        ContinuationLowerErasedCallableVariant => Some(layout_erased_continuation_package())
    }

/// Layout used by the repeatable frame chain inside a ContN package.
def continuation_frame_chain_layout(kind: ContinuationLoweringKind): Option[WasmGcLayout] =
    match kind {
        ContinuationLowerRepeatableContN => Some(layout_continuation_frame_chain())
        _ => None
    }

/// Lower a continuation fact to a Core op without erasing Cont1/ContN semantics.
def lower_continuation_fact(fact: ContinuationLoweringFact): Option[CoreOp] =
    match fact.kind {
        ContinuationLowerDirectCont1 => None
        ContinuationLowerBoxedCont1 =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpBoxedCont1,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreConsumedStateMachine,
                frame_count: 0,
            })
        ContinuationLowerRepeatableContN =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContNPackage,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: fact.frames.len(),
            })
        ContinuationLowerErasedCallableVariant =>
            Some(CoreOp {
                owner: Some(fact.owner),
                kind: CoreOpContinuationPackage,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                function_body: None,
                layout: continuation_core_layout(fact.kind),
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            })
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_frame_core_ops(out: Vec[CoreOp], frames: Array[ContinuationFrame], index: usize): Vec[CoreOp] =
    if index == frames.len() { out }
    else {
        let frame = frames.get(index)
        push_continuation_frame_core_ops(
            out.push(CoreOp {
                owner: Some(frame.owner),
                kind: CoreOpStacklessFunction,
                export_main: false,
                function_symbol: None,
                i32_param_count: 0,
                function_body: None,
                layout: None,
                tail: CorePlainCall,
                runtime_state: CoreNoRuntimeState,
                frame_count: 0,
            }),
            frames,
            index + 1)
    }

/// Push all Core ops needed for one continuation lowering fact.
def push_continuation_core_ops(out: Vec[CoreOp], fact: ContinuationLoweringFact): Vec[CoreOp] =
    match fact.kind {
        ContinuationLowerRepeatableContN =>
            push_continuation_frame_core_ops(out, fact.frames, 0)
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContinuationFrameChain,
                    export_main: false,
                    function_symbol: None,
                    i32_param_count: 0,
                    function_body: None,
                    layout: continuation_frame_chain_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                })
                .push(CoreOp {
                    owner: Some(fact.owner),
                    kind: CoreOpContNPackage,
                    export_main: false,
                    function_symbol: None,
                    i32_param_count: 0,
                    function_body: None,
                    layout: continuation_core_layout(fact.kind),
                    tail: CorePlainCall,
                    runtime_state: CoreNoRuntimeState,
                    frame_count: fact.frames.len(),
                })
        _ =>
            match lower_continuation_fact(fact) {
                Some(op) => out.push(op)
                None => out
            }
    }

/// Lower continuation facts into a stable Core op stream.
def lower_continuation_facts(facts: Array[ContinuationLoweringFact], index: usize, out: Vec[CoreOp]): Array[CoreOp] =
    if index == facts.len() { out.freeze() }
    else { lower_continuation_facts(facts, index + 1, push_continuation_core_ops(out, facts.get(index))) }

/// Pick the block terminator required by one lowered Core function body.
def core_function_body_terminator(body: Option[CoreExprKind]): CoreBlockTerminator =
    match body {
        Some(CoreExprTailCall(_)) => CoreBlockTailCall
        Some(CoreExprTailCallI32Const(_, _)) => CoreBlockTailCall
        Some(CoreExprBranchJoinPending) => CoreBlockContinue
        None => CoreBlockContinue
        _ => CoreBlockReturn
    }

/// Pick the block terminator required by one Core op.
def core_block_terminator_for_op(op: CoreOp): CoreBlockTerminator =
    match op.kind {
        CoreOpFunction => core_function_body_terminator(op.function_body)
        _ =>
            match op.tail {
                CoreTailCall => CoreBlockTailCall
                CorePlainCall =>
                    match op.kind {
                        CoreOpTailCall => CoreBlockTailCall
                        _ => CoreBlockContinue
                    }
            }
    }

/// Convert one Core op into a block-lowering obligation.
def core_block_lowering_obligation_from_op(op: CoreOp): CoreBlockLoweringObligation =
    let terminator = core_block_terminator_for_op(op)
    CoreBlockLoweringObligation {
        owner: op.owner,
        terminator: terminator,
        requires_function_return: terminator == CoreBlockReturn,
        requires_tail_call: terminator == CoreBlockTailCall,
    }

/// Convert Core ops into block-lowering obligations in stable order.
def core_block_lowering_obligations(ops: Array[CoreOp], index: usize, out: Vec[CoreBlockLoweringObligation]): Array[CoreBlockLoweringObligation] =
    if index == ops.len() { out.freeze() }
    else { core_block_lowering_obligations(ops, index + 1, out.push(core_block_lowering_obligation_from_op(ops.get(index)))) }

/// Convert one CPS branch join fact into a backend-neutral Core obligation.
def core_branch_join_lowering_obligation_from_fact(fact: CpsBranchJoinFact): CoreBranchJoinLoweringObligation =
    CoreBranchJoinLoweringObligation {
        owner: fact.owner,
        kind: fact.kind,
        requires_join_block: fact.requires_join_continuation,
        requires_tail_terminator: fact.all_arms_resume_to_same_tail,
    }

/// Convert CPS branch join facts into Core obligations.
def core_branch_join_lowering_obligations(facts: Array[CpsBranchJoinFact], index: usize, out: Vec[CoreBranchJoinLoweringObligation]): Array[CoreBranchJoinLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_branch_join_lowering_obligations(facts, index + 1, out.push(core_branch_join_lowering_obligation_from_fact(facts.get(index)))) }

/// Convert one CPS pattern decision into a backend-neutral Core obligation.
def core_pattern_decision_lowering_obligation_from_fact(fact: CpsPatternDecisionFact): CorePatternDecisionLoweringObligation =
    CorePatternDecisionLoweringObligation {
        owner: fact.owner,
        file: fact.file,
        requires_test_chain: fact.requires_test_chain,
        requires_if_else_lowering: fact.requires_test_chain,
        requires_field_extracts: fact.lowers_to_if_else_and_field_extract,
        failure_env_has_no_bindings: fact.failure_env_has_no_bindings,
        missing_static_case_is_error: fact.missing_static_case_is_error,
    }

/// Convert CPS pattern decision facts into Core lowering obligations.
def core_pattern_decision_lowering_obligations(facts: Array[CpsPatternDecisionFact], index: usize, out: Vec[CorePatternDecisionLoweringObligation]): Array[CorePatternDecisionLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_pattern_decision_lowering_obligations(facts, index + 1, out.push(core_pattern_decision_lowering_obligation_from_fact(facts.get(index)))) }

/// Convert one CPS ADT constructor fact into a Core tuple-return lowering obligation.
def core_adt_ctor_lowering_obligation_from_fact(fact: CpsAdtCtorLoweringFact): CoreAdtCtorLoweringObligation =
    CoreAdtCtorLoweringObligation {
        helper_name: fact.helper_name,
        helper_arity: fact.helper_arity,
        tuple_fields: fact.source.tuple_fields,
        requires_symbol_tag_field: fact.returns_canonical_tuple,
        requires_tuple_record_return: fact.requires_tail_tuple_return,
        requires_utf8_identifier_lowering: fact.requires_utf8_identifier_lowering,
    }

/// Convert CPS ADT constructor facts into Core obligations.
def core_adt_ctor_lowering_obligations(facts: Array[CpsAdtCtorLoweringFact], index: usize, out: Vec[CoreAdtCtorLoweringObligation]): Array[CoreAdtCtorLoweringObligation] =
    if index == facts.len() { out.freeze() }
    else { core_adt_ctor_lowering_obligations(facts, index + 1, out.push(core_adt_ctor_lowering_obligation_from_fact(facts.get(index)))) }

/// Append one Core op array to another builder.
def append_core_ops(out: Vec[CoreOp], ops: Array[CoreOp], index: usize): Vec[CoreOp] =
    if index == ops.len() { out }
    else { append_core_ops(out.push(ops.get(index)), ops, index + 1) }

/// Lower optimized closure Core to Wasm-GC Core.
def lower_wasm_gc_core(module: OptimizedClosureModule): WasmGcCoreModule =
    let cps_module = optimized_closure_cps_module(module)
    let function_ops = lower_cps_term_facts(cps_module.terms, optimized_closure_typed_module(module).functions, 0, Vec[CoreOp].new())
    let closure_ops = lower_closure_facts(module.closures, 0, Vec[CoreOp].new())
    let continuation_ops = lower_continuation_facts(module.continuations, 0, Vec[CoreOp].new())
    let branch_join_obligations = core_branch_join_lowering_obligations(cps_module.branch_joins, 0, Vec[CoreBranchJoinLoweringObligation].new())
    let pattern_decision_obligations = core_pattern_decision_lowering_obligations(cps_module.pattern_decisions, 0, Vec[CorePatternDecisionLoweringObligation].new())
    let adt_ctor_obligations = core_adt_ctor_lowering_obligations(cps_module.adt_ctors, 0, Vec[CoreAdtCtorLoweringObligation].new())
    let ops = append_core_ops(Vec[CoreOp].new(), function_ops, 0)
        |> append_core_ops(closure_ops, 0)
        |> append_core_ops(continuation_ops, 0)
    WasmGcCoreModule {
        source: module,
        layouts: build_wasm_gc_layouts(module),
        ops: ops,
        block_obligations: core_block_lowering_obligations(ops, 0, Vec[CoreBlockLoweringObligation].new()),
        branch_join_obligations: branch_join_obligations,
        pattern_decision_obligations: pattern_decision_obligations,
        adt_ctor_obligations: adt_ctor_obligations,
    }

/// Return true when a Core op requires a layout reference.
def CoreOpKind.requires_layout(self): bool =
    match self {
        CoreOpStructNew => true
        CoreOpArrayNew => true
        CoreOpClosureCall => true
        CoreOpBoxedCont1 => true
        CoreOpContinuationFrameChain => true
        CoreOpContNPackage => true
        CoreOpContinuationPackage => true
        _ => false
    }

/// Return true when a Core op must preserve source owner provenance.
def CoreOpKind.requires_owner(self): bool =
    if self.requires_layout() { true }
    else {
        match self {
            CoreOpStacklessFunction => true
            _ => false
        }
    }
