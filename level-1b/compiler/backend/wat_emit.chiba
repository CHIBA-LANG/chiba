/// WAT emitter for validated Wasm-GC Core.
namespace compiler.backend.wat_emit

use compiler.backend.validate_core.*
use compiler.semantic.driver.*

/// Textual WAT module.
type WatModule {
    text: String,
}

/// Return a stable label for a Core operation kind.
def CoreOpKind.wat_label(self): String =
    match self {
        CoreOpFunction => "function"
        CoreOpStacklessFunction => "stackless.function"
        CoreOpStructNew => "struct.new"
        CoreOpArrayNew => "array.new"
        CoreOpClosureCall => "closure.call"
        CoreOpBoxedCont1 => "cont1.boxed"
        CoreOpContinuationFrameChain => "continuation.frame_chain"
        CoreOpContNPackage => "contN.package"
        CoreOpContinuationPackage => "continuation.package"
        CoreOpTailCall => "return_call"
        CoreOpImportCall(module) =>
            match module {
                CoreImportWasi => "import.wasi"
                CoreImportEnv => "import.env"
            }
    }

/// Emit one Core op as WAT text.
def emit_core_op(op: CoreOp): Result[String, SemanticDiagnostics] =
    Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
        .push(SemanticDiagnostic("<backend>", 0, 0, "missing-backend-layout: WAT lowering for ".concat(op.kind.wat_label()).concat(" absent")))
        .freeze()))

/// Emit validated Core as WAT.
def emit_wat(module: ValidatedCoreModule): Result[WatModule, SemanticDiagnostics] =
    Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new()
        .push(SemanticDiagnostic("<backend>", 0, 0, "missing-backend-layout: executable WAT emission absent"))
        .freeze()))

/// Return the text carried by a WAT module.
def WatModule.as_string(self): String = self.text
