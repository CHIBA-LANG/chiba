/// WAT emitter for validated Wasm-GC Core.
namespace compiler.backend.wat_emit

use compiler.backend.validate_core.*
use compiler.backend.layout.*
use compiler.semantic.driver.*
use compiler.semantic.adt_tuple_lowering.*
use std.diagnostic.*

/// Textual WAT module.
type WatModule {
    text: String,
}

/// Executable WAT emission obligation for non-empty Core programs.
type WatEmissionObligation {
    op: CoreOpKind,
    requires_executable_instruction: bool,
    requires_layout_serialization: bool,
}

/// One source-facing symbol mapping for diagnostics and WAT comments.
type SymbolDebugEntry {
    source_symbol: String,
    lowered_symbol: String,
    mangled_symbol: String,
}

/// Deterministic symbol debug map emitted beside backend output.
type SymbolDebugManifest {
    entries: Array[SymbolDebugEntry],
}

/// Build one source-facing debug entry for a Core function symbol.
def symbol_debug_entry_from_op(op: CoreOp): Option[SymbolDebugEntry] =
    match op.function_symbol {
        Some(symbol) =>
            Some(SymbolDebugEntry {
                source_symbol: symbol.name,
                lowered_symbol: symbol.name,
                mangled_symbol: "$chiba.".concat(symbol.name),
            })
        None => None
    }

/// Collect symbol debug entries in Core op order.
def build_symbol_debug_entries(ops: Array[CoreOp], index: usize, out: Vec[SymbolDebugEntry]): Array[SymbolDebugEntry] =
    if index == ops.len() { out.freeze() }
    else {
        match symbol_debug_entry_from_op(ops.get(index)) {
            Some(entry) => build_symbol_debug_entries(ops, index + 1, out.push(entry))
            None => build_symbol_debug_entries(ops, index + 1, out)
        }
    }

/// Build the symbol debug manifest from validated Core symbols.
def build_symbol_debug_manifest(module: ValidatedCoreModule): Result[SymbolDebugManifest, SemanticDiagnostics] =
    Ok(SymbolDebugManifest {
        entries: build_symbol_debug_entries(module.core.ops, 0, Vec[SymbolDebugEntry].new()),
    })

/// Render one debug symbol mapping.
def symbol_debug_entry_as_text(entry: SymbolDebugEntry): String =
    entry.source_symbol
        .concat(" -> ")
        .concat(entry.lowered_symbol)
        .concat(" -> ")
        .concat(entry.mangled_symbol)
        .concat("\n")

/// Render debug symbol entries in stable order.
def symbol_debug_entries_as_text(entries: Array[SymbolDebugEntry], index: usize, out: String): String =
    if index == entries.len() { out }
    else { symbol_debug_entries_as_text(entries, index + 1, out.concat(symbol_debug_entry_as_text(entries.get(index)))) }

/// Render a symbol debug manifest in source/lowered/mangled order.
def symbol_debug_manifest_as_text(manifest: SymbolDebugManifest): String =
    symbol_debug_entries_as_text(manifest.entries, 0, "source symbol -> lowered symbol -> final mangled name\n")

/// Return the WAT type label for a backend layout kind.
def WasmGcLayoutKind.wat_type_label(self): str =
    match self {
        LayoutStruct => "$chiba.layout.struct"
        LayoutArray => "$chiba.layout.array"
        LayoutClosureEnv => "$chiba.layout.closure_env"
        LayoutContinuationFrame => "$chiba.layout.continuation_frame"
        LayoutContinuationFrameChain => "$chiba.layout.continuation_frame_chain"
        LayoutBoxedCont1 => "$chiba.layout.boxed_cont1"
        LayoutContNPackage => "$chiba.layout.contN_package"
        LayoutContinuationPackage => "$chiba.layout.continuation_package"
        LayoutSliceView => "$chiba.layout.slice_view"
    }

/// Emit a conservative Wasm-GC struct type for one layout entry.
def emit_layout_type(layout: WasmGcLayout): String =
    match layout.kind {
        LayoutArray =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (array (mut i32)))\n")
        LayoutSliceView =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field (ref null $chiba.layout.array)) (field i32) (field i32)))\n")
        LayoutClosureEnv =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field funcref) (field eqref)))\n")
        LayoutContinuationFrame =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field funcref) (field eqref)))\n")
        LayoutContinuationFrameChain =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field (ref null $chiba.layout.continuation_frame)) (field (ref null $chiba.layout.continuation_frame_chain))))\n")
        LayoutBoxedCont1 =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field (ref null $chiba.layout.continuation_frame)) (field (mut i32))))\n")
        LayoutContNPackage =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field (ref null $chiba.layout.continuation_frame_chain)) (field i32)))\n")
        LayoutContinuationPackage =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct (field i32) (field eqref)))\n")
        LayoutStruct =>
            "(type ".concat(layout.kind.wat_type_label()).concat(" (struct))\n")
    }

/// Append canonical layout type declarations.
def append_layout_types(layouts: Array[WasmGcLayout], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == layouts.len() { builder }
    else { append_layout_types(layouts, index + 1, builder.push_str(emit_layout_type(layouts.get(index)))) }

/// Return a stable label for a Core operation kind.
def CoreOpKind.wat_label(self): String =
    match self {
        CoreOpFunction => "function"
        CoreOpStacklessFunction => "stackless.function"
        CoreOpAdtTupleCtor => "adt.tuple_ctor"
        CoreOpStructNew => "struct.new"
        CoreOpArrayNew => "array.new"
        CoreOpClosureCall => "closure.call"
        CoreOpBoxedCont1 => "cont1.boxed"
        CoreOpContinuationFrameChain => "continuation.frame_chain"
        CoreOpContNPackage => "contN.package"
        CoreOpContinuationPackage => "continuation.package"
        CoreOpTailCall => "return_call"
        CoreOpImportCall(module) =>
            match module {
                CoreImportWasi => "import.wasi"
                CoreImportEnv => "import.env"
            }
    }

/// Return one decimal digit as WAT source text.
def emit_core_decimal_digit(value: usize): String =
    if value == 0 { "0" }
    else if value == 1 { "1" }
    else if value == 2 { "2" }
    else if value == 3 { "3" }
    else if value == 4 { "4" }
    else if value == 5 { "5" }
    else if value == 6 { "6" }
    else if value == 7 { "7" }
    else if value == 8 { "8" }
    else { "9" }

/// Emit a small integer as decimal WAT source text.
def emit_core_small_usize(value: usize): String =
    if value < 10 { emit_core_decimal_digit(value) }
    else { emit_core_small_usize(value / 10).concat(emit_core_decimal_digit(value % 10)) }

/// Return true when a semantic tuple-key byte can appear directly in a WAT id.
def emit_wat_id_byte_is_safe(byte: u8): bool =
    (byte >= 48 && byte <= 57) ||
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122)

/// Return one ASCII byte as source text for WAT id generation.
def emit_wat_ascii_byte_text(byte: u8): String =
    if byte == 48 { "0" }
    else if byte == 49 { "1" }
    else if byte == 50 { "2" }
    else if byte == 51 { "3" }
    else if byte == 52 { "4" }
    else if byte == 53 { "5" }
    else if byte == 54 { "6" }
    else if byte == 55 { "7" }
    else if byte == 56 { "8" }
    else if byte == 57 { "9" }
    else if byte == 65 || byte == 97 { "a" }
    else if byte == 66 || byte == 98 { "b" }
    else if byte == 67 || byte == 99 { "c" }
    else if byte == 68 || byte == 100 { "d" }
    else if byte == 69 || byte == 101 { "e" }
    else if byte == 70 || byte == 102 { "f" }
    else if byte == 71 || byte == 103 { "g" }
    else if byte == 72 || byte == 104 { "h" }
    else if byte == 73 || byte == 105 { "i" }
    else if byte == 74 || byte == 106 { "j" }
    else if byte == 75 || byte == 107 { "k" }
    else if byte == 76 || byte == 108 { "l" }
    else if byte == 77 || byte == 109 { "m" }
    else if byte == 78 || byte == 110 { "n" }
    else if byte == 79 || byte == 111 { "o" }
    else if byte == 80 || byte == 112 { "p" }
    else if byte == 81 || byte == 113 { "q" }
    else if byte == 82 || byte == 114 { "r" }
    else if byte == 83 || byte == 115 { "s" }
    else if byte == 84 || byte == 116 { "t" }
    else if byte == 85 || byte == 117 { "u" }
    else if byte == 86 || byte == 118 { "v" }
    else if byte == 87 || byte == 119 { "w" }
    else if byte == 88 || byte == 120 { "x" }
    else if byte == 89 || byte == 121 { "y" }
    else { "z" }

/// Encode one tuple-key byte into a deterministic WAT id fragment.
def emit_wat_id_byte(byte: u8): String =
    if emit_wat_id_byte_is_safe(byte) { emit_wat_ascii_byte_text(byte) }
    else { "_".concat(emit_core_small_usize(byte)).concat("_") }

/// Sanitize a canonical tuple key into a stable WAT id suffix.
def emit_wat_id_suffix(text: str, index: usize, out: String): String =
    if index == text.len() { out }
    else { emit_wat_id_suffix(text, index + 1, out.concat(emit_wat_id_byte(text.byte_at(index)))) }

/// WAT type label for a canonical anonymous tuple nominal.
def emit_tuple_nominal_type_label(identity: TupleNominalIdentity): String =
    "$chiba.adt_tuple.".concat(emit_wat_id_suffix(identity.tuple_key, 0, ""))

/// Emit the body instructions for one lowered Core function.
def emit_core_i32_const_atom(atom: CoreI32ConstAtom): String =
    match atom {
        CoreI32ConstLiteral(value) => "i32.const ".concat(emit_core_small_usize(value))
    }

/// Emit a Wasm numeric instruction for a builtin primitive method body.
def emit_core_primitive_binary_op(op: PrimitiveBinaryOp): str =
    match op {
        PrimitiveBinaryAdd => "i32.add"
        PrimitiveBinarySub => "i32.sub"
        PrimitiveBinaryMul => "i32.mul"
        PrimitiveBinaryDiv => "i32.div_s"
    }

/// Emit the literal condition for the first executable branch slice.
def emit_core_branch_condition(condition: CoreBranchCondition): String =
    match condition {
        CoreBranchConditionTrue => "i32.const 1"
        CoreBranchConditionFalse => "i32.const 0"
        CoreBranchConditionParam(index) => emit_core_param(index)
    }

/// Emit a local.get instruction for one indexed i32 parameter.
def emit_core_param(index: usize): String =
    "local.get ".concat(emit_core_small_usize(index))

/// Emit Core tail-call arguments in evaluation order.
def emit_core_tail_call_args(args: Array[CoreExprKind], index: usize): String =
    if index == args.len() { "" }
    else {
        let current = emit_core_expr_value_instruction(args.get(index))
        if index + 1 == args.len() { current }
        else { current.concat(" ").concat(emit_core_tail_call_args(args, index + 1)) }
    }

/// Emit a multi-argument Core tail call.
def emit_core_tail_call_args_expr(target: str, args: Array[CoreExprKind]): String =
    emit_core_tail_call_args(args, 0).concat(" return_call $chiba.").concat(target)

/// Emit one Core expression without the function result prefix.
def emit_core_expr_instruction(body: CoreExprKind): String =
    match body {
        CoreExprI32Const(atom) => emit_core_i32_const_atom(atom)
        CoreExprParam(index) => emit_core_param(index)
        CoreExprTailCall(target) => "return_call $chiba.".concat(target)
        CoreExprTailCallArgs(target, args) => emit_core_tail_call_args_expr(target, args)
        CoreExprPrimitiveBinary(op, left, right) =>
            emit_core_expr_value_instruction(left).concat(" ").concat(emit_core_expr_value_instruction(right)).concat(" ").concat(emit_core_primitive_binary_op(op))
        CoreExprIfElse(condition, then_expr, else_expr) => emit_core_if_else_expr(condition, then_expr, else_expr)
        CoreExprBranchJoinPending => "unreachable"
        CoreExprUnit => ""
    }

/// Emit one Core expression in value position. Nested calls must not return from the enclosing function.
def emit_core_expr_value_instruction(body: CoreExprKind): String =
    match body {
        CoreExprI32Const(atom) => emit_core_i32_const_atom(atom)
        CoreExprParam(index) => emit_core_param(index)
        CoreExprTailCall(target) => "call $chiba.".concat(target)
        CoreExprTailCallArgs(target, args) => emit_core_tail_call_args(args, 0).concat(" call $chiba.").concat(target)
        CoreExprPrimitiveBinary(op, left, right) =>
            emit_core_expr_value_instruction(left).concat(" ").concat(emit_core_expr_value_instruction(right)).concat(" ").concat(emit_core_primitive_binary_op(op))
        CoreExprIfElse(condition, then_expr, else_expr) => emit_core_if_else_expr(condition, then_expr, else_expr)
        CoreExprBranchJoinPending => "unreachable"
        CoreExprUnit => ""
    }

/// Emit an executable if/else expression.
def emit_core_if_else_expr(condition: CoreBranchCondition, then_expr: CoreExprKind, else_expr: CoreExprKind): String =
    "(result i32) (if (result i32) ("
        .concat(emit_core_branch_condition(condition))
        .concat(") (then (")
        .concat(emit_core_expr_instruction(then_expr))
        .concat(")) (else (")
        .concat(emit_core_expr_instruction(else_expr))
        .concat(")))")

/// Emit parameters for the first executable i32 function slice.
def emit_core_function_params(i32_param_count: usize): String =
    if i32_param_count == 0 { "" }
    else { "(param i32) ".concat(emit_core_function_params(i32_param_count - 1)) }

/// Emit the body instructions for one lowered Core function.
def emit_core_function_body(body: Option[CoreExprKind]): String =
    match body {
        Some(CoreExprI32Const(atom)) => "(result i32) ".concat(emit_core_i32_const_atom(atom))
        Some(CoreExprParam(index)) => "(result i32) ".concat(emit_core_param(index))
        Some(CoreExprTailCall(target)) => "(result i32) return_call $chiba.".concat(target)
        Some(CoreExprTailCallArgs(target, args)) =>
            "(result i32) ".concat(emit_core_tail_call_args_expr(target, args))
        Some(CoreExprPrimitiveBinary(op, left, right)) =>
            "(result i32) ".concat(emit_core_expr_instruction(left)).concat(" ").concat(emit_core_expr_instruction(right)).concat(" ").concat(emit_core_primitive_binary_op(op))
        Some(CoreExprIfElse(condition, then_expr, else_expr)) => emit_core_if_else_expr(condition, then_expr, else_expr)
        Some(CoreExprBranchJoinPending) => "(result i32) unreachable"
        Some(CoreExprUnit) => ""
        None => ""
    }

/// Emit an optional stable function label.
def emit_core_function_symbol(symbol: Option[CoreFunctionSymbol]): String =
    match symbol {
        Some(name) => "$chiba.".concat(name.name).concat(" ")
        None => ""
    }

/// Emit ADT tuple helper parameters in the canonical payload order.
def emit_adt_tuple_ctor_params(count: usize): String =
    if count == 0 { "" }
    else { "(param i32) ".concat(emit_adt_tuple_ctor_params(count - 1)) }

/// Emit an i32 field for a tuple struct smoke layout.
def emit_adt_tuple_struct_fields(fields: Array[AdtTupleField], index: usize): String =
    if index == fields.len() { "" }
    else { "(field i32) ".concat(emit_adt_tuple_struct_fields(fields, index + 1)) }

/// Emit constructor tuple values: stable tag code first, then payload params.
def emit_adt_tuple_ctor_values(obligation: CoreAdtCtorLoweringObligation, index: usize): String =
    if index == obligation.tuple_fields.len() { "" }
    else if index == 0 { "i32.const 0 ".concat(emit_adt_tuple_ctor_values(obligation, index + 1)) }
    else { "local.get ".concat(emit_core_small_usize(index - 1)).concat(" ").concat(emit_adt_tuple_ctor_values(obligation, index + 1)) }

/// Emit one executable ADT constructor helper that returns the canonical tuple object.
def emit_adt_tuple_ctor_function(obligation: CoreAdtCtorLoweringObligation): String =
    let tuple_label = emit_tuple_nominal_type_label(obligation.tuple_nominal)
    "(func $chiba."
        .concat(obligation.helper_name)
        .concat(" ")
        .concat(emit_adt_tuple_ctor_params(obligation.helper_arity))
        .concat("(result (ref ")
        .concat(tuple_label)
        .concat(")) ")
        .concat(emit_adt_tuple_ctor_values(obligation, 0))
        .concat("struct.new ")
        .concat(tuple_label)
        .concat(")\n")

/// Emit boxed Cont1 runtime resume with one-shot consumed-state enforcement.
def emit_boxed_cont1_resume_function(): String =
    "(func (param (ref null $chiba.layout.boxed_cont1)) (result i32)\n"
        .concat("  (local $box (ref $chiba.layout.boxed_cont1))\n")
        .concat("  local.get 0\n")
        .concat("  ref.cast (ref $chiba.layout.boxed_cont1)\n")
        .concat("  local.tee $box\n")
        .concat("  struct.get $chiba.layout.boxed_cont1 1\n")
        .concat("  if\n")
        .concat("    unreachable\n")
        .concat("  end\n")
        .concat("  local.get $box\n")
        .concat("  i32.const 1\n")
        .concat("  struct.set $chiba.layout.boxed_cont1 1\n")
        .concat("  i32.const 0)\n")

/// Emit a materialized ContN frame-chain allocation shape.
def emit_contn_frame_chain_function(): String =
    "(func (result (ref $chiba.layout.continuation_frame_chain))\n"
        .concat("  ref.null $chiba.layout.continuation_frame\n")
        .concat("  ref.null $chiba.layout.continuation_frame_chain\n")
        .concat("  struct.new $chiba.layout.continuation_frame_chain)\n")

/// Emit a repeatable ContN package allocation shape.
def emit_contn_package_function(): String =
    "(func (result (ref $chiba.layout.contN_package))\n"
        .concat("  ref.null $chiba.layout.continuation_frame_chain\n")
        .concat("  i32.const 1\n")
        .concat("  struct.new $chiba.layout.contN_package)\n")

/// Emit an erased callable continuation package allocation shape.
def emit_erased_continuation_package_function(): String =
    "(func (result (ref $chiba.layout.continuation_package))\n"
        .concat("  i32.const 0\n")
        .concat("  ref.null any\n")
        .concat("  struct.new $chiba.layout.continuation_package)\n")

/// Emit an erased closure call through a typed funcref value.
def emit_closure_call_function(): String =
    "(type $chiba.closure.i32_to_i32 (func (param i32) (result i32)))\n"
        .concat("(func (param funcref) (param eqref) (param i32) (result i32)\n")
        .concat("  local.get 2\n")
        .concat("  local.get 0\n")
        .concat("  ref.cast (ref $chiba.closure.i32_to_i32)\n")
        .concat("  call_ref $chiba.closure.i32_to_i32)\n")

/// Emit a concrete heap struct allocation smoke op.
def emit_struct_new_function(): String =
    "(func (result eqref)\n"
        .concat("  struct.new $chiba.layout.struct)\n")

/// Emit a concrete heap array allocation smoke op.
def emit_array_new_function(): String =
    "(func (result eqref)\n"
        .concat("  i32.const 0\n")
        .concat("  i32.const 0\n")
        .concat("  array.new $chiba.layout.array)\n")

/// Emit one representation-preserving tuple bridge identity helper.
def emit_intrinsic_bridge_identity_function(name: str): String =
    "(func $chiba.compiler.intrinsic."
        .concat(name)
        .concat(" (param eqref) (result eqref) local.get 0)\n")

/// Emit executable identity conversion helpers for compiler tuple bridge intrinsics.
def emit_intrinsic_bridge_functions(obligation: CoreIntrinsicBridgeLoweringObligation): String =
    if obligation.emits_identity_conversion_helpers == false { "" }
    else {
        let tuple_to_adt = match obligation.tuple_to_adt_identity {
            Some(identity) => emit_intrinsic_bridge_identity_function(identity.source_name)
            None => ""
        }
        let adt_to_tuple = match obligation.adt_to_tuple_identity {
            Some(identity) => emit_intrinsic_bridge_identity_function(identity.source_name)
            None => ""
        }
        tuple_to_adt.concat(adt_to_tuple)
    }

/// Append executable compiler intrinsic bridge helpers once per Core obligation.
def append_intrinsic_bridge_helpers(obligations: Array[CoreIntrinsicBridgeLoweringObligation], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == obligations.len() { builder }
    else {
        append_intrinsic_bridge_helpers(
            obligations,
            index + 1,
            builder.push_str(emit_intrinsic_bridge_functions(obligations.get(index))))
    }

/// Return true when one Core op carries a tuple constructor with the same canonical tuple key.
def core_op_has_tuple_nominal_key(op: CoreOp, key: str): bool =
    match op.adt_tuple_ctor {
        Some(obligation) => obligation.tuple_nominal.tuple_key == key
        None => false
    }

/// Return true when the same canonical tuple type has already been emitted.
def prior_tuple_nominal_type_emitted(ops: Array[CoreOp], index: usize, key: str): bool =
    if index == 0 { false }
    else if core_op_has_tuple_nominal_key(ops.get(index - 1), key) { true }
    else { prior_tuple_nominal_type_emitted(ops, index - 1, key) }

/// Emit one canonical tuple type declaration.
def emit_tuple_nominal_type(obligation: CoreAdtCtorLoweringObligation): String =
    "(type ".concat(emit_tuple_nominal_type_label(obligation.tuple_nominal))
        .concat(" (struct ")
        .concat(emit_adt_tuple_struct_fields(obligation.tuple_fields, 0))
        .concat("))\n")

/// Append each canonical tuple nominal struct type exactly once.
def append_tuple_nominal_types(ops: Array[CoreOp], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == ops.len() { builder }
    else {
        match ops.get(index).adt_tuple_ctor {
            Some(obligation) =>
                if prior_tuple_nominal_type_emitted(ops, index, obligation.tuple_nominal.tuple_key) {
                    append_tuple_nominal_types(ops, index + 1, builder)
                } else {
                    append_tuple_nominal_types(ops, index + 1, builder.push_str(emit_tuple_nominal_type(obligation)))
                }
            None => append_tuple_nominal_types(ops, index + 1, builder)
        }
    }

/// Emit a function, exporting the first typed `main` slice as WebAssembly main.
def emit_core_function(op: CoreOp): String =
    let head = if op.export_main { "(func ".concat(emit_core_function_symbol(op.function_symbol)).concat("(export \"main\") ") }
        else { "(func ".concat(emit_core_function_symbol(op.function_symbol)) }
    head.concat(emit_core_function_params(op.i32_param_count)).concat(emit_core_function_body(op.function_body)).concat(")\n")

/// Emit one Core op as WAT text.
def emit_core_op(op: CoreOp): Result[String, SemanticDiagnostics] =
    match op.kind {
        CoreOpFunction => Ok(emit_core_function(op))
        CoreOpAdtTupleCtor =>
            match op.adt_tuple_ctor {
                Some(obligation) => Ok(emit_adt_tuple_ctor_function(obligation))
                None => Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new().push(SemanticDiagnostic("<backend>", 0, 0, "ADT tuple constructor op missing lowering payload")).freeze()))
            }
        /// source-contract: CoreOpStacklessFunction => Ok("(func ".concat(emit_core_function_body(op.function_body))
        CoreOpStacklessFunction =>
            if op.i32_param_count == 0 { Ok("(func ".concat(emit_core_function_body(op.function_body)).concat(")\n")) }
            else { Ok("(func ".concat(emit_core_function_params(op.i32_param_count)).concat(emit_core_function_body(op.function_body)).concat(")\n")) }
        CoreOpStructNew => Ok(emit_struct_new_function())
        CoreOpArrayNew => Ok(emit_array_new_function())
        CoreOpClosureCall => Ok(emit_closure_call_function())
        CoreOpBoxedCont1 => Ok(emit_boxed_cont1_resume_function())
        CoreOpContinuationFrameChain => Ok(emit_contn_frame_chain_function())
        CoreOpContNPackage => Ok(emit_contn_package_function())
        CoreOpContinuationPackage => Ok(emit_erased_continuation_package_function())
        CoreOpTailCall => Err(SemanticDiagnostics(Vec[SemanticDiagnostic].new().push(SemanticDiagnostic("<backend>", 0, 0, "standalone CoreOpTailCall emission absent; tail calls must lower through CoreOpFunction body")).freeze()))
        CoreOpImportCall(module) =>
            match module {
                CoreImportWasi => Ok("(import \"wasi_snapshot_preview1\" \"proc_exit\" (func))\n")
                CoreImportEnv => Ok("(import \"env\" \"chiba_host_call\" (func))\n")
            }
    }

/// Return true for module imports, which must be emitted before function bodies.
def CoreOpKind.is_import(self): bool =
    match self {
        CoreOpImportCall(_) => true
        _ => false
    }

/// Append one emitted Core op to the WAT builder.
def append_core_op_wat(builder: DiagnosticBuilder, op: CoreOp): Result[DiagnosticBuilder, SemanticDiagnostics] =
    match emit_core_op(op) {
        Ok(text) => Ok(builder.push_str(text))
        Err(errors) => Err(errors)
    }

/// Append all Core ops in stable order.
def append_core_ops_wat(ops: Array[CoreOp], index: usize, builder: DiagnosticBuilder): Result[DiagnosticBuilder, SemanticDiagnostics] =
    if index == ops.len() { Ok(builder) }
    else {
        match append_core_op_wat(builder, ops.get(index)) {
            Ok(next) => append_core_ops_wat(ops, index + 1, next)
            Err(errors) => Err(errors)
        }
    }

/// Append only import Core ops before runtime function definitions.
def append_import_core_ops_wat(ops: Array[CoreOp], index: usize, builder: DiagnosticBuilder): Result[DiagnosticBuilder, SemanticDiagnostics] =
    if index == ops.len() { Ok(builder) }
    else {
        let op = ops.get(index)
        if op.kind.is_import() {
            match append_core_op_wat(builder, op) {
                Ok(next) => append_import_core_ops_wat(ops, index + 1, next)
                Err(errors) => Err(errors)
            }
        } else { append_import_core_ops_wat(ops, index + 1, builder) }
    }

/// Append non-import Core ops after imports.
def append_runtime_core_ops_wat(ops: Array[CoreOp], index: usize, builder: DiagnosticBuilder): Result[DiagnosticBuilder, SemanticDiagnostics] =
    if index == ops.len() { Ok(builder) }
    else {
        let op = ops.get(index)
        if op.kind.is_import() { append_runtime_core_ops_wat(ops, index + 1, builder) }
        else {
            match append_core_op_wat(builder, op) {
                Ok(next) => append_runtime_core_ops_wat(ops, index + 1, next)
                Err(errors) => Err(errors)
            }
        }
    }

/// Convert one Core op into an executable WAT emission obligation.
def wat_emission_obligation_from_op(op: CoreOp): WatEmissionObligation =
    WatEmissionObligation {
        op: op.kind,
        requires_executable_instruction: true,
        requires_layout_serialization: op.kind.requires_layout(),
    }

/// Build WAT emission obligations in stable Core op order.
def wat_emission_obligations(ops: Array[CoreOp], index: usize, out: Vec[WatEmissionObligation]): Array[WatEmissionObligation] =
    if index == ops.len() { out.freeze() }
    else { wat_emission_obligations(ops, index + 1, out.push(wat_emission_obligation_from_op(ops.get(index)))) }

/// Emit validated Core as WAT.
def emit_wat(module: ValidatedCoreModule): Result[WatModule, SemanticDiagnostics] =
    let obligations = wat_emission_obligations(module.core.ops, 0, Vec[WatEmissionObligation].new())
    if obligations.len() == 0 {
        Ok(empty_wat_module())
    } else {
        let builder = DiagnosticBuilder.new().push_str("(module\n")
        let with_layouts = append_layout_types(module.core.layouts.entries, 0, builder)
        let with_tuple_types = append_tuple_nominal_types(module.core.ops, 0, with_layouts)
        let with_intrinsic_helpers = append_intrinsic_bridge_helpers(module.core.intrinsic_bridge_obligations, 0, with_tuple_types)
        match append_import_core_ops_wat(module.core.ops, 0, with_intrinsic_helpers) {
            Ok(with_imports) =>
                match append_runtime_core_ops_wat(module.core.ops, 0, with_imports) {
                    Ok(done) => Ok(WatModule { text: done.push_str(")\n").finish() })
                    Err(errors) => Err(errors)
                }
            Err(errors) => Err(errors)
        }
    }

/// Minimal executable module for an empty validated Core program.
def empty_wat_module(): WatModule =
    WatModule { text: "(module)\n" }

/// Return the text carried by a WAT module.
def WatModule.as_string(self): String = self.text
