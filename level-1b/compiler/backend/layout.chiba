/// Stable Wasm-GC layout table construction.
namespace compiler.backend.layout

use compiler.closure.env_simplify.*

/// Wasm-GC heap layout kind.
data WasmGcLayoutKind {
    LayoutStruct,
    LayoutArray,
    LayoutClosureEnv,
    LayoutContinuationFrame,
    LayoutContinuationFrameChain,
    LayoutBoxedCont1,
    LayoutContNPackage,
    LayoutContinuationPackage,
    LayoutSliceView,
}

/// Backend-neutral value type used before WAT-specific spelling.
data CoreValueType {
    CoreValUnit,
    CoreValBool,
    CoreValI32,
    CoreValI64,
    CoreValF32,
    CoreValF64,
    CoreValUsize,
    CoreValString,
    CoreValStr,
    CoreValEqRef,
    CoreValFuncRef,
    CoreValArrayU8Ref,
    CoreValLayoutRef(str),
    CoreValNullableLayoutRef(str),
}

/// Field entry in a Wasm-GC layout.
type WasmGcFieldLayout {
    name: str,
    value_type: CoreValueType,
}

/// Stable layout table entry.
type WasmGcLayout {
    id: usize,
    key: str,
    kind: WasmGcLayoutKind,
    fields: Array[WasmGcFieldLayout],
}

/// Layout table consumed by Core lowering and WAT emit.
type WasmGcLayoutTable {
    entries: Array[WasmGcLayout],
}

/// Build a field layout entry.
def wasm_gc_field(name: str, value_type: CoreValueType): WasmGcFieldLayout =
    WasmGcFieldLayout { name: name, value_type: value_type }

/// Return the typed field entry at a stable layout index.
def wasm_gc_layout_field_type(layout: WasmGcLayout, index: usize): CoreValueType =
    if index >= layout.fields.len() { CoreValEqRef }
    else { layout.fields.get(index).value_type }

/// Empty layout field array.
def empty_wasm_gc_fields(): Array[WasmGcFieldLayout] =
    Vec[WasmGcFieldLayout].new().freeze()

/// Managed `Array[u8]` layout used by String.
def layout_array_u8(): WasmGcLayout =
    WasmGcLayout {
        id: 0,
        key: "std.Array[u8]",
        kind: LayoutArray,
        fields: empty_wasm_gc_fields(),
    }

/// Managed `Slice[u8]` view used by `str`.
def layout_slice_u8(): WasmGcLayout =
    WasmGcLayout {
        id: 1,
        key: "std.Slice[u8]",
        kind: LayoutSliceView,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("backing", CoreValArrayU8Ref))
            .push(wasm_gc_field("offset", CoreValUsize))
            .push(wasm_gc_field("len", CoreValUsize))
            .freeze(),
    }

/// Generic closure environment package layout.
def layout_closure_env(): WasmGcLayout =
    WasmGcLayout {
        id: 2,
        key: "compiler.closure.env",
        kind: LayoutClosureEnv,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("fun", CoreValFuncRef))
            .push(wasm_gc_field("env", CoreValEqRef))
            .freeze(),
    }

/// Delimited-continuation frame layout.
def layout_continuation_frame(): WasmGcLayout =
    WasmGcLayout {
        id: 3,
        key: "compiler.continuation.frame",
        kind: LayoutContinuationFrame,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("resume", CoreValFuncRef))
            .push(wasm_gc_field("state", CoreValEqRef))
            .freeze(),
    }

/// Repeatable frame chain used by multi-shot `ContN`.
def layout_continuation_frame_chain(): WasmGcLayout =
    WasmGcLayout {
        id: 4,
        key: "compiler.continuation.frame_chain",
        kind: LayoutContinuationFrameChain,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("head", CoreValLayoutRef("$chiba.layout.continuation_frame")))
            .push(wasm_gc_field("parent", CoreValNullableLayoutRef("$chiba.layout.continuation_frame_chain")))
            .freeze(),
    }

/// Boxed one-shot `Cont1` consumed-state machine.
def layout_boxed_cont1(): WasmGcLayout =
    WasmGcLayout {
        id: 5,
        key: "compiler.continuation.boxed_cont1",
        kind: LayoutBoxedCont1,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("frame", CoreValLayoutRef("$chiba.layout.continuation_frame")))
            .push(wasm_gc_field("consumed", CoreValBool))
            .freeze(),
    }

/// Multi-shot continuation package layout.
def layout_continuation_package(): WasmGcLayout =
    WasmGcLayout {
        id: 6,
        key: "compiler.continuation.contN_package",
        kind: LayoutContNPackage,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("frames", CoreValLayoutRef("$chiba.layout.continuation_frame_chain")))
            .push(wasm_gc_field("repeatable", CoreValBool))
            .freeze(),
    }

/// Erased callable continuation package layout.
def layout_erased_continuation_package(): WasmGcLayout =
    WasmGcLayout {
        id: 7,
        key: "compiler.continuation.erased_callable_package",
        kind: LayoutContinuationPackage,
        fields: Vec[WasmGcFieldLayout].new()
            .push(wasm_gc_field("tag", CoreValUsize))
            .push(wasm_gc_field("payload", CoreValEqRef))
            .freeze(),
    }

/// Build canonical Wasm-GC layouts from optimized closure Core.
def build_wasm_gc_layouts(module: OptimizedClosureModule): WasmGcLayoutTable =
    WasmGcLayoutTable {
        entries: Vec[WasmGcLayout].new()
            .push(layout_array_u8())
            .push(layout_slice_u8())
            .push(layout_closure_env())
            .push(layout_continuation_frame())
            .push(layout_continuation_frame_chain())
            .push(layout_boxed_cont1())
            .push(layout_continuation_package())
            .push(layout_erased_continuation_package())
            .freeze(),
    }

/// Return true when a layout is a runtime package.
def WasmGcLayoutKind.is_package(self): bool =
    match self {
        LayoutClosureEnv => true
        LayoutContinuationFrame => true
        LayoutContinuationFrameChain => true
        LayoutBoxedCont1 => true
        LayoutContNPackage => true
        LayoutContinuationPackage => true
        _ => false
    }
