/// Continuation simplification on CPS Core.
namespace compiler.closure.continuation_simplify

use compiler.closure.usage_cps.*
use compiler.ir.type_ir.*

/// Continuation simplification decision.
data ContinuationSimplification {
    ContinuationDeleted(BinderId, ContinuationCapabilityKind),
    ContinuationInlined(BinderId, ContinuationCapabilityKind),
    ContinuationBoxedOneShot(BinderId),
    ContinuationPackaged(BinderId),
}

/// CPS module after dead and single-use continuations have been simplified.
type SimplifiedContinuationModule {
    source: CpsUsageModule,
    decisions: Array[ContinuationSimplification],
}

/// Delete unused continuations, inline single-use continuations, and mark
/// many-use continuations as package-lowering inputs.
def simplify_continuations(module: CpsUsageModule): SimplifiedContinuationModule =
    SimplifiedContinuationModule(module, simplify_continuation_facts(module.facts, 0, Vec[ContinuationSimplification].new()))

/// Convert one use fact into a continuation simplification decision if needed.
def push_continuation_simplification(out: Vec[ContinuationSimplification], fact: CpsUseFact): Vec[ContinuationSimplification] =
    match fact.subject {
        UseSubjectContinuation(binder, capability) =>
            push_continuation_capability_simplification(out, binder, capability, fact.count)
        _ => out
    }

/// Convert use count and continuation capability into a lowering decision.
def push_continuation_capability_simplification(out: Vec[ContinuationSimplification], binder: BinderId, capability: ContinuationCapabilityKind, count: UsageCount): Vec[ContinuationSimplification] =
    match capability {
        ContinuationCont1 =>
            match count {
                UseZero => out.push(ContinuationDeleted(binder, capability))
                UseOne => out.push(ContinuationInlined(binder, capability))
                UseMany => out.push(ContinuationBoxedOneShot(binder))
            }
        ContinuationContN =>
            match count {
                UseZero => out.push(ContinuationDeleted(binder, capability))
                _ => out.push(ContinuationPackaged(binder))
            }
    }

/// Build continuation simplification decisions in stable fact order.
def simplify_continuation_facts(facts: Array[CpsUseFact], index: usize, out: Vec[ContinuationSimplification]): Array[ContinuationSimplification] =
    if index == facts.len() { out.freeze() }
    else { simplify_continuation_facts(facts, index + 1, push_continuation_simplification(out, facts.get(index))) }

/// Return true when a continuation decision allocates a runtime package.
def ContinuationSimplification.materializes_package(self): bool =
    match self {
        ContinuationBoxedOneShot(_) => true
        ContinuationPackaged(_) => true
        _ => false
    }

/// Return the original continuation capability preserved by simplification.
def ContinuationSimplification.capability(self): ContinuationCapabilityKind =
    match self {
        ContinuationDeleted(_, capability) => capability
        ContinuationInlined(_, capability) => capability
        ContinuationBoxedOneShot(_) => ContinuationCont1
        ContinuationPackaged(_) => ContinuationContN
    }

/// Return the continuation owner binder for stable downstream lowering.
def ContinuationSimplification.owner(self): BinderId =
    match self {
        ContinuationDeleted(binder, _) => binder
        ContinuationInlined(binder, _) => binder
        ContinuationBoxedOneShot(binder) => binder
        ContinuationPackaged(binder) => binder
    }
