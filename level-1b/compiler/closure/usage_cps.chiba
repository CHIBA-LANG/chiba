/// CPS-level usage analysis for closure and continuation lowering.
namespace compiler.closure.usage_cps

use compiler.control.cps.*
use compiler.control.continuation_usage.*
use compiler.ir.control.*
use compiler.ir.type_ir.*
use compiler.semantic.driver.*

/// Runtime value class whose use count affects package materialization.
data RuntimeUseSubject {
    UseSubjectBinder(BinderId),
    UseSubjectLambda(BinderId),
    UseSubjectClosure(BinderId),
    UseSubjectContinuation(BinderId, ContinuationCapabilityKind),
}

/// CPS-level use fact after administrative beta-reduction.
type CpsUseFact {
    subject: RuntimeUseSubject,
    count: UsageCount,
}

/// CPS module annotated with final use counts for closure conversion.
type CpsUsageModule {
    source: CpsModule,
    facts: Array[CpsUseFact],
}

/// Recompute use counts on CPS Core.
def analyze_cps_usage(module: CpsModule): Result[CpsUsageModule, SemanticDiagnostics] =
    if module.continuations.len() == 0 {
        Ok(CpsUsageModule(module, cps_usage_facts_none()))
    } else {
        Ok(CpsUsageModule(
            module,
            cps_usage_facts(module.continuations, 0, Vec[CpsUseFact].new())))
    }

/// Empty CPS usage fact stream for modules without runtime closure/continuation subjects.
def cps_usage_facts_none(): Array[CpsUseFact] =
    Vec[CpsUseFact].new().freeze()

/// Convert continuation facts into CPS usage facts without losing capability kind.
def cps_usage_facts(facts: Array[ContinuationFact], index: usize, out: Vec[CpsUseFact]): Array[CpsUseFact] =
    if index == facts.len() { out.freeze() }
    else {
        let fact = facts.get(index)
        cps_usage_facts(facts, index + 1, out.push(CpsUseFact(
            UseSubjectContinuation(fact.binder, fact.capability),
            continuation_storage_use_count(fact.storage))))
    }

/// Map storage obligations to runtime use classes.
def continuation_storage_use_count(storage: ContinuationStorageKind): UsageCount =
    match storage {
        ContinuationDirectResume => UseOne
        ContinuationBoxedOneShot => UseOne
        ContinuationRepeatableFrameChain => UseMany
        ContinuationErasedCallableVariant => UseMany
    }

/// Return true when a fact permits direct call/direct continuation lowering.
def CpsUseFact.single_use(self): bool =
    match self.count {
        UseOne => true
        _ => false
    }
