/// Closure conversion and capture legality.
namespace compiler.closure.closure_convert

use compiler.closure.continuation_simplify.*
use compiler.closure.usage_cps.*
use compiler.ir.closure.*
use compiler.ir.type_ir.*
use compiler.control.replay_safety.*
use compiler.semantic.driver.*

/// Captured runtime value accepted by closure conversion.
data CaptureKind {
    CaptureValue,
    CaptureReplaySafeContinuation,
    CaptureSharedRefCell,
    CaptureWorldLocalRejected,
    CaptureThreadLocalRejected,
    CaptureUnsafeRejected,
}

/// One field in a closure environment or continuation package.
type CaptureField {
    binder: BinderId,
    kind: CaptureKind,
}

/// Runtime call shape after closure conversion.
data ClosureCallKind {
    ClosureDirectFunction(BinderId),
    ClosureKnownCode(BinderId),
    ClosureUnknownFunctionValue,
}

/// Stable closure or continuation environment layout.
type ClosureEnvLayout {
    owner: BinderId,
    fields: Array[CaptureField],
}

/// ContN lowering obligation before frame-chain extraction.
type ContinuationFrameChainObligation {
    owner: BinderId,
    requires_stackless_resume_function: bool,
    requires_frame_chain: bool,
    requires_repeatable_package: bool,
}

/// Cont1 lowering obligation before direct/boxed one-shot lowering.
type ContinuationOneShotObligation {
    owner: BinderId,
    requires_direct_resume: bool,
    requires_boxed_state_machine: bool,
    requires_consumed_state: bool,
}

/// Continuation capture plan before concrete frame/body extraction.
type ContinuationCapturePlan {
    owner: BinderId,
    capability: ContinuationCapabilityKind,
    requires_capture_scan: bool,
    requires_frame_body_extraction: bool,
    ref_capture_uses_shared_reference_semantics: bool,
    requires_consumed_state: bool,
}

/// Module after escaping lambdas have explicit code/env packages.
type ClosureConvertedModule {
    source: SimplifiedContinuationModule,
    layouts: Array[ClosureEnvLayout],
    continuations: Array[ContinuationLoweringFact],
    continuation_capture_plans: Array[ContinuationCapturePlan],
}

/// Convert escaping lambdas and packaged continuations to explicit env layouts.
def convert_closures(module: SimplifiedContinuationModule): Result[ClosureConvertedModule, SemanticDiagnostics] =
    Ok(ClosureConvertedModule(
        module,
        closure_env_layouts_for_module(module),
        continuation_lowering_facts_from_module(module, module.decisions, 0, Vec[ContinuationLoweringFact].new()),
        continuation_capture_plans(module.decisions, 0, Vec[ContinuationCapturePlan].new())))

/// Empty capture list for a directified closure or continuation package.
def empty_capture_fields(): Array[CaptureField] =
    Vec[CaptureField].new().freeze()

/// Build a conservative capture field for a runtime closure subject.
def closure_runtime_capture_field(owner: BinderId): CaptureField =
    CaptureField {
        binder: owner,
        kind: CaptureValue,
    }

/// Build capture fields for a non-empty closure environment.
def closure_runtime_capture_fields(owner: BinderId): Array[CaptureField] =
    Vec[CaptureField].new().push(closure_runtime_capture_field(owner)).freeze()

/// Return true when a CPS use subject is a lambda/closure needing env extraction.
def cps_use_fact_requires_closure_capture(fact: CpsUseFact): bool =
    if fact.syntactic_no_capture { false }
    else {
        match fact.subject {
            UseSubjectLambda(_) => true
            UseSubjectClosure(_) => true
            _ => false
        }
    }

/// Return the precise capture extraction blocker for a lambda/closure subject.
def closure_usage_capture_extraction_blocker(fact: CpsUseFact): Option[SemanticDiagnostic] =
    if fact.syntactic_no_capture { None }
    else {
        match fact.subject {
            UseSubjectLambda(_) =>
                Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: lambda capture extraction absent"))
            UseSubjectClosure(_) =>
                Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: closure env field extraction absent"))
            _ => None
        }
    }

/// Collect blockers for lambda/closure subjects before env layout.
def closure_usage_capture_extraction_blockers(facts: Array[CpsUseFact], index: usize, out: Vec[SemanticDiagnostic]): Array[SemanticDiagnostic] =
    if index == facts.len() { out.freeze() }
    else {
        match closure_usage_capture_extraction_blocker(facts.get(index)) {
            Some(error) => closure_usage_capture_extraction_blockers(facts, index + 1, out.push(error))
            None => closure_usage_capture_extraction_blockers(facts, index + 1, out)
        }
    }

/// Return true when any lambda/closure subject still lacks capture facts.
def closure_usage_requires_capture_extraction(facts: Array[CpsUseFact], index: usize): bool =
    if index == facts.len() { false }
    else if cps_use_fact_requires_closure_capture(facts.get(index)) { true }
    else { closure_usage_requires_capture_extraction(facts, index + 1) }

/// Convert a packaged ContN decision into a frame-chain obligation.
def continuation_frame_chain_obligation(decision: ContinuationSimplification): Option[ContinuationFrameChainObligation] =
    match decision {
        ContinuationPackaged(owner) =>
            Some(ContinuationFrameChainObligation {
                owner: owner,
                requires_stackless_resume_function: true,
                requires_frame_chain: true,
                requires_repeatable_package: true,
            })
        _ => None
    }

/// Build ContN frame-chain obligations in stable decision order.
def continuation_frame_chain_obligations(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ContinuationFrameChainObligation]): Array[ContinuationFrameChainObligation] =
    if index == decisions.len() { out.freeze() }
    else {
        match continuation_frame_chain_obligation(decisions.get(index)) {
            Some(obligation) => continuation_frame_chain_obligations(decisions, index + 1, out.push(obligation))
            None => continuation_frame_chain_obligations(decisions, index + 1, out)
        }
    }

/// Convert a Cont1 simplification into direct or boxed one-shot obligations.
def continuation_one_shot_obligation(decision: ContinuationSimplification): Option[ContinuationOneShotObligation] =
    match decision {
        ContinuationInlined(owner, ContinuationCont1) =>
            Some(ContinuationOneShotObligation {
                owner: owner,
                requires_direct_resume: true,
                requires_boxed_state_machine: false,
                requires_consumed_state: false,
            })
        ContinuationBoxedOneShot(owner) =>
            Some(ContinuationOneShotObligation {
                owner: owner,
                requires_direct_resume: false,
                requires_boxed_state_machine: true,
                requires_consumed_state: true,
            })
        _ => None
    }

/// Build Cont1 lowering obligations in stable decision order.
def continuation_one_shot_obligations(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ContinuationOneShotObligation]): Array[ContinuationOneShotObligation] =
    if index == decisions.len() { out.freeze() }
    else {
        match continuation_one_shot_obligation(decisions.get(index)) {
            Some(obligation) => continuation_one_shot_obligations(decisions, index + 1, out.push(obligation))
            None => continuation_one_shot_obligations(decisions, index + 1, out)
        }
    }

/// Build a capture plan for a materialized continuation decision.
def continuation_capture_plan(decision: ContinuationSimplification): Option[ContinuationCapturePlan] =
    match decision {
        ContinuationBoxedOneShot(owner) =>
            Some(ContinuationCapturePlan {
                owner: owner,
                capability: ContinuationCont1,
                requires_capture_scan: true,
                requires_frame_body_extraction: false,
                ref_capture_uses_shared_reference_semantics: true,
                requires_consumed_state: true,
            })
        ContinuationPackaged(owner) =>
            Some(ContinuationCapturePlan {
                owner: owner,
                capability: ContinuationContN,
                requires_capture_scan: true,
                requires_frame_body_extraction: true,
                ref_capture_uses_shared_reference_semantics: true,
                requires_consumed_state: false,
            })
        _ => None
    }

/// Build capture plans for materialized continuation decisions.
def continuation_capture_plans(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ContinuationCapturePlan]): Array[ContinuationCapturePlan] =
    if index == decisions.len() { out.freeze() }
    else {
        match continuation_capture_plan(decisions.get(index)) {
            Some(plan) => continuation_capture_plans(decisions, index + 1, out.push(plan))
            None => continuation_capture_plans(decisions, index + 1, out)
        }
    }

/// Append a closure environment layout for decisions that materialize.
def push_closure_env_layout(out: Vec[ClosureEnvLayout], decision: ContinuationSimplification): Vec[ClosureEnvLayout] =
    match decision {
        _ => out
    }

/// Build an empty env layout for syntactically no-capture lambda/closure subjects.
def closure_usage_env_layout(fact: CpsUseFact): Option[ClosureEnvLayout] =
    if fact.syntactic_no_capture {
        match fact.subject {
            UseSubjectLambda(owner) => Some(ClosureEnvLayout(owner, empty_capture_fields()))
            UseSubjectClosure(owner) => Some(ClosureEnvLayout(owner, empty_capture_fields()))
            _ => None
        }
    } else {
        match fact.subject {
            UseSubjectLambda(owner) => Some(ClosureEnvLayout(owner, closure_runtime_capture_fields(owner)))
            UseSubjectClosure(owner) => Some(ClosureEnvLayout(owner, closure_runtime_capture_fields(owner)))
            _ => None
        }
    }

/// Build closure env layouts from CPS usage facts before continuation packages.
def closure_env_layouts_from_usage(facts: Array[CpsUseFact], index: usize, out: Vec[ClosureEnvLayout]): Vec[ClosureEnvLayout] =
    if index == facts.len() { out }
    else {
        match closure_usage_env_layout(facts.get(index)) {
            Some(layout) => closure_env_layouts_from_usage(facts, index + 1, out.push(layout))
            None => closure_env_layouts_from_usage(facts, index + 1, out)
        }
    }

/// Map a simplification decision to target-independent continuation lowering.
def continuation_lowering_kind(decision: ContinuationSimplification): ContinuationLoweringKind =
    match decision {
        ContinuationBoxedOneShot(_) => ContinuationLowerBoxedCont1
        ContinuationPackaged(_) => ContinuationLowerRepeatableContN
        _ => ContinuationLowerDirectCont1
    }

/// Return true when runtime state must trap on repeated one-shot resume.
def continuation_lowering_consumed_state(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationBoxedOneShot(_) => true
        _ => false
    }

/// Return true when two binder ids identify the same owner.
def closure_binder_id_eq(left: BinderId, right: BinderId): bool = left.id == right.id

/// Convert a CPS control body kind into a stackless resume body kind.
def stackless_resume_body_from_control(kind: CpsControlTermKind): StacklessResumeBodyKind =
    match kind {
        CpsControlResetBody => StacklessResumeBodyReset
        CpsControlShiftBody(_) => StacklessResumeBodyShift
        CpsControlShiftNBody(_) => StacklessResumeBodyShiftN
    }

/// Find the CPS control body extracted for one continuation owner.
def stackless_resume_body_for_owner(terms: Array[CpsControlTermFact], owner: BinderId, index: usize): StacklessResumeBodyKind =
    if index == terms.len() { StacklessResumeBodyPending }
    else {
        let term = terms.get(index)
        if closure_binder_id_eq(term.owner, owner) { stackless_resume_body_from_control(term.kind) }
        else { stackless_resume_body_for_owner(terms, owner, index + 1) }
    }

/// Build a stackless resume function from the CPS control body for a repeatable ContN frame.
def stackless_resume_function_for_owner(module: SimplifiedContinuationModule, owner: BinderId): StacklessResumeFunction =
    StacklessResumeFunction {
        owner: owner,
        resume_input: TypeUnknown,
        answer: TypeUnknown,
        body: stackless_resume_body_for_owner(module.source.source.control_terms, owner, 0),
    }

/// Convert closure-conversion capture kind into closure IR capture class.
def continuation_capture_class(kind: CaptureKind): CaptureClass =
    match kind {
        CaptureValue => CaptureValue
        CaptureReplaySafeContinuation => CaptureReplaySafeContinuation
        CaptureSharedRefCell => CaptureSharedRefCell
        CaptureWorldLocalRejected => CaptureRejectedWorldLocal
        CaptureThreadLocalRejected => CaptureRejectedThreadLocal
        CaptureUnsafeRejected => CaptureRejectedUnsafe
    }

/// Convert one continuation capture into an EnvField.
def continuation_env_field_from_capture(field: CaptureField): EnvField =
    EnvField {
        binder: field.binder,
        class: continuation_capture_class(field.kind),
    }

/// Build conservative capture fields for a materialized continuation frame.
def continuation_capture_fields_for_owner(owner: BinderId): Array[CaptureField] =
    Vec[CaptureField].new()
        .push(CaptureField { binder: owner, kind: CaptureReplaySafeContinuation })
        .freeze()

/// Convert continuation capture fields to EnvFields.
def continuation_env_fields_from_captures(fields: Array[CaptureField], index: usize, out: Vec[EnvField]): Array[EnvField] =
    if index == fields.len() { out.freeze() }
    else { continuation_env_fields_from_captures(fields, index + 1, out.push(continuation_env_field_from_capture(fields.get(index)))) }

/// Build conservative EnvFields for a materialized continuation frame.
def continuation_env_fields_for_owner(owner: BinderId): Array[EnvField] =
    continuation_env_fields_from_captures(continuation_capture_fields_for_owner(owner), 0, Vec[EnvField].new())

/// Build a repeatable ContN frame with the CPS control body attached.
def continuation_frame_for_owner(module: SimplifiedContinuationModule, owner: BinderId): ContinuationFrame =
    ContinuationFrame {
        owner: owner,
        resume: stackless_resume_function_for_owner(module, owner),
        captures: continuation_env_fields_for_owner(owner),
        parent: None,
    }

/// Build frame chain facts for continuation kinds that require materialized frames.
def continuation_lowering_frames(module: SimplifiedContinuationModule, decision: ContinuationSimplification): Array[ContinuationFrame] =
    match decision {
        ContinuationPackaged(owner) =>
            Vec[ContinuationFrame].new().push(continuation_frame_for_owner(module, owner)).freeze()
        _ => Vec[ContinuationFrame].new().freeze()
    }

/// Build a lowering fact for direct/deleted continuations that need no frame.
def continuation_lowering_fact(module: SimplifiedContinuationModule, decision: ContinuationSimplification): ContinuationLoweringFact =
    ContinuationLoweringFact {
        owner: decision.owner(),
        capability: decision.capability(),
        kind: continuation_lowering_kind(decision),
        frames: continuation_lowering_frames(module, decision),
        consumed_state: continuation_lowering_consumed_state(decision),
    }

/// Return true when a simplification decision must still reach backend lowering.
def continuation_decision_emits_lowering_fact(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationDeleted(_, _) => false
        _ => true
    }

/// Build continuation lowering facts in stable decision order.
def continuation_lowering_facts_from_module(module: SimplifiedContinuationModule, decisions: Array[ContinuationSimplification], index: usize, out: Vec[ContinuationLoweringFact]): Array[ContinuationLoweringFact] =
    if index == decisions.len() { out.freeze() }
    else {
        let decision = decisions.get(index)
        if continuation_decision_emits_lowering_fact(decision) {
            continuation_lowering_facts_from_module(module, decisions, index + 1, out.push(continuation_lowering_fact(module, decision)))
        } else {
            continuation_lowering_facts_from_module(module, decisions, index + 1, out)
        }
    }

/// Return true when a continuation decision needs real capture extraction.
def continuation_decision_requires_capture_extraction(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationBoxedOneShot(_) => true
        ContinuationPackaged(_) => true
        _ => false
    }

/// Return the precise capture extraction blocker for a materialized continuation.
def continuation_capture_extraction_blocker(decision: ContinuationSimplification): Option[SemanticDiagnostic] =
    match decision {
        ContinuationBoxedOneShot(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: boxed Cont1 capture extraction absent"))
        ContinuationPackaged(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: ContN frame-chain capture extraction absent"))
        _ => None
    }

/// Collect per-continuation blockers instead of collapsing materialization holes.
def continuation_capture_extraction_blockers(decisions: Array[ContinuationSimplification], index: usize, out: Vec[SemanticDiagnostic]): Array[SemanticDiagnostic] =
    if index == decisions.len() { out.freeze() }
    else {
        match continuation_capture_extraction_blocker(decisions.get(index)) {
            Some(error) => continuation_capture_extraction_blockers(decisions, index + 1, out.push(error))
            None => continuation_capture_extraction_blockers(decisions, index + 1, out)
        }
    }

/// Return true when any decision cannot be converted without capture facts.
def continuation_decisions_require_capture_extraction(decisions: Array[ContinuationSimplification], index: usize): bool =
    if index == decisions.len() { false }
    else if continuation_decision_requires_capture_extraction(decisions.get(index)) { true }
    else { continuation_decisions_require_capture_extraction(decisions, index + 1) }

/// Build closure environment layouts in stable decision order.
def closure_env_layouts(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ClosureEnvLayout]): Array[ClosureEnvLayout] =
    if index == decisions.len() { out.freeze() }
    else { closure_env_layouts(decisions, index + 1, push_closure_env_layout(out, decisions.get(index))) }

/// Build all closure env layouts, starting with no-capture closure/lambda subjects.
def closure_env_layouts_for_module(module: SimplifiedContinuationModule): Array[ClosureEnvLayout] =
    closure_env_layouts(module.decisions, 0, closure_env_layouts_from_usage(module.source.facts, 0, Vec[ClosureEnvLayout].new()))

/// Return true when a capture is legal to place in a runtime package.
def CaptureKind.package_legal(self): bool =
    match self {
        CaptureValue => true
        CaptureReplaySafeContinuation => true
        CaptureSharedRefCell => true
        _ => false
    }
