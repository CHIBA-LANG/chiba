/// Closure conversion and capture legality.
namespace compiler.closure.closure_convert

use compiler.closure.continuation_simplify.*
use compiler.closure.usage_cps.*
use compiler.ir.closure.*
use compiler.ir.type_ir.*
use compiler.control.replay_safety.*
use compiler.semantic.driver.*

/// Captured runtime value accepted by closure conversion.
data CaptureKind {
    CaptureValue,
    CaptureReplaySafeContinuation,
    CaptureSharedRefCell,
    CaptureWorldLocalRejected,
    CaptureThreadLocalRejected,
    CaptureUnsafeRejected,
}

/// One field in a closure environment or continuation package.
type CaptureField {
    binder: BinderId,
    kind: CaptureKind,
}

/// Runtime call shape after closure conversion.
data ClosureCallKind {
    ClosureDirectFunction(BinderId),
    ClosureKnownCode(BinderId),
    ClosureUnknownFunctionValue,
}

/// Stable closure or continuation environment layout.
type ClosureEnvLayout {
    owner: BinderId,
    fields: Array[CaptureField],
}

/// Module after escaping lambdas have explicit code/env packages.
type ClosureConvertedModule {
    source: SimplifiedContinuationModule,
    layouts: Array[ClosureEnvLayout],
    continuations: Array[ContinuationLoweringFact],
}

/// Convert escaping lambdas and packaged continuations to explicit env layouts.
def convert_closures(module: SimplifiedContinuationModule): Result[ClosureConvertedModule, SemanticDiagnostics] =
    if closure_usage_requires_capture_extraction(module.source.facts, 0) {
        Err(SemanticDiagnostics(closure_usage_capture_extraction_blockers(module.source.facts, 0, Vec[SemanticDiagnostic].new())))
    } else if continuation_decisions_require_capture_extraction(module.decisions, 0) {
        Err(SemanticDiagnostics(continuation_capture_extraction_blockers(module.decisions, 0, Vec[SemanticDiagnostic].new())))
    } else {
        Ok(ClosureConvertedModule(
            module,
            closure_env_layouts(module.decisions, 0, Vec[ClosureEnvLayout].new()),
            continuation_lowering_facts(module.decisions, 0, Vec[ContinuationLoweringFact].new())))
    }

/// Empty capture list for a directified closure or continuation package.
def empty_capture_fields(): Array[CaptureField] =
    Vec[CaptureField].new().freeze()

/// Return true when a CPS use subject is a lambda/closure needing env extraction.
def cps_use_fact_requires_closure_capture(fact: CpsUseFact): bool =
    match fact.subject {
        UseSubjectLambda(_) => true
        UseSubjectClosure(_) => true
        _ => false
    }

/// Return the precise capture extraction blocker for a lambda/closure subject.
def closure_usage_capture_extraction_blocker(fact: CpsUseFact): Option[SemanticDiagnostic] =
    match fact.subject {
        UseSubjectLambda(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: lambda capture extraction absent"))
        UseSubjectClosure(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: closure env field extraction absent"))
        _ => None
    }

/// Collect blockers for lambda/closure subjects before env layout.
def closure_usage_capture_extraction_blockers(facts: Array[CpsUseFact], index: usize, out: Vec[SemanticDiagnostic]): Array[SemanticDiagnostic] =
    if index == facts.len() { out.freeze() }
    else {
        match closure_usage_capture_extraction_blocker(facts.get(index)) {
            Some(error) => closure_usage_capture_extraction_blockers(facts, index + 1, out.push(error))
            None => closure_usage_capture_extraction_blockers(facts, index + 1, out)
        }
    }

/// Return true when any lambda/closure subject still lacks capture facts.
def closure_usage_requires_capture_extraction(facts: Array[CpsUseFact], index: usize): bool =
    if index == facts.len() { false }
    else if cps_use_fact_requires_closure_capture(facts.get(index)) { true }
    else { closure_usage_requires_capture_extraction(facts, index + 1) }

/// Append a closure environment layout for decisions that materialize.
def push_closure_env_layout(out: Vec[ClosureEnvLayout], decision: ContinuationSimplification): Vec[ClosureEnvLayout] =
    match decision {
        _ => out
    }

/// Map a simplification decision to target-independent continuation lowering.
def continuation_lowering_kind(decision: ContinuationSimplification): ContinuationLoweringKind =
    match decision {
        ContinuationBoxedOneShot(_) => ContinuationLowerBoxedCont1
        ContinuationPackaged(_) => ContinuationLowerRepeatableContN
        _ => ContinuationLowerDirectCont1
    }

/// Return true when runtime state must trap on repeated one-shot resume.
def continuation_lowering_consumed_state(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationBoxedOneShot(_) => true
        _ => false
    }

/// Build a lowering fact for direct/deleted continuations that need no frame.
def continuation_lowering_fact(decision: ContinuationSimplification): ContinuationLoweringFact =
    ContinuationLoweringFact {
        owner: decision.owner(),
        capability: decision.capability(),
        kind: continuation_lowering_kind(decision),
        frames: Vec[ContinuationFrame].new().freeze(),
        consumed_state: continuation_lowering_consumed_state(decision),
    }

/// Return true when a simplification decision must still reach backend lowering.
def continuation_decision_emits_lowering_fact(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationDeleted(_, _) => false
        _ => true
    }

/// Build continuation lowering facts in stable decision order.
def continuation_lowering_facts(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ContinuationLoweringFact]): Array[ContinuationLoweringFact] =
    if index == decisions.len() { out.freeze() }
    else {
        let decision = decisions.get(index)
        if continuation_decision_emits_lowering_fact(decision) {
            continuation_lowering_facts(decisions, index + 1, out.push(continuation_lowering_fact(decision)))
        } else {
            continuation_lowering_facts(decisions, index + 1, out)
        }
    }

/// Return true when a continuation decision needs real capture extraction.
def continuation_decision_requires_capture_extraction(decision: ContinuationSimplification): bool =
    match decision {
        ContinuationBoxedOneShot(_) => true
        ContinuationPackaged(_) => true
        _ => false
    }

/// Return the precise capture extraction blocker for a materialized continuation.
def continuation_capture_extraction_blocker(decision: ContinuationSimplification): Option[SemanticDiagnostic] =
    match decision {
        ContinuationBoxedOneShot(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: boxed Cont1 capture extraction absent"))
        ContinuationPackaged(_) =>
            Some(SemanticDiagnostic("<closure>", 0, 0, "missing-facts: ContN frame-chain capture extraction absent"))
        _ => None
    }

/// Collect per-continuation blockers instead of collapsing materialization holes.
def continuation_capture_extraction_blockers(decisions: Array[ContinuationSimplification], index: usize, out: Vec[SemanticDiagnostic]): Array[SemanticDiagnostic] =
    if index == decisions.len() { out.freeze() }
    else {
        match continuation_capture_extraction_blocker(decisions.get(index)) {
            Some(error) => continuation_capture_extraction_blockers(decisions, index + 1, out.push(error))
            None => continuation_capture_extraction_blockers(decisions, index + 1, out)
        }
    }

/// Return true when any decision cannot be converted without capture facts.
def continuation_decisions_require_capture_extraction(decisions: Array[ContinuationSimplification], index: usize): bool =
    if index == decisions.len() { false }
    else if continuation_decision_requires_capture_extraction(decisions.get(index)) { true }
    else { continuation_decisions_require_capture_extraction(decisions, index + 1) }

/// Build closure environment layouts in stable decision order.
def closure_env_layouts(decisions: Array[ContinuationSimplification], index: usize, out: Vec[ClosureEnvLayout]): Array[ClosureEnvLayout] =
    if index == decisions.len() { out.freeze() }
    else { closure_env_layouts(decisions, index + 1, push_closure_env_layout(out, decisions.get(index))) }

/// Return true when a capture is legal to place in a runtime package.
def CaptureKind.package_legal(self): bool =
    match self {
        CaptureValue => true
        CaptureReplaySafeContinuation => true
        CaptureSharedRefCell => true
        _ => false
    }
