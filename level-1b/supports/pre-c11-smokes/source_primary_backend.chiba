/// C11 fixture for source-slice backend artifact generation.
namespace pre_c11.source_primary_backend

/// Return the first i32 parameter directly.
def id(x: i32): i32 = x

/// Return a small const that is not 0 or 42.
def seven(): i32 = 7

/// No-arg callee used by source tail-call lowering.
def callee(): i32 = 42

/// Static value constant uses global-value surface instead of a zero-arg function.
def ONE: i32 = 7

/// Static value dependency verifies deterministic module-load init order.
def TWO: i32 = ONE + 35

/// Tail-call with a small const argument.
def main(): i32 = id(7)

/// Source no-arg tail-call fixture replacing the synthetic-only tailcall smoke.
def main_noarg_tail(): i32 = callee()

/// Literal branch with two distinct arms.
def literal_branch(): i32 = if true { 7 } else { 13 }

/// Parameter branch with tail-call arms.
def choose(flag: bool): i32 = if flag { id(7) } else { id(13) }

/// Else-if branch lowers as nested branch expression.
def choose_else_if(first: bool, second: bool): i32 = if first { id(7) } else if second { id(13) } else { id(42) }

/// Nested branch lowers both inner and outer else paths.
def choose_nested(outer: bool, inner: bool): i32 = if outer { if inner { id(7) } else { id(13) } } else { id(42) }

/// Match lowering with explicit bool arms.
def choose_match(flag: bool): i32 = match flag {
    true => id(7)
    false => id(13)
}

/// Match fallback arm lowers as the false branch for bool scrutinees.
def choose_match_fallback(flag: bool): i32 = match flag {
    true => id(7)
    _ => id(13)
}

/// Integer literal match lowers to a test-chain with fallback arm.
def choose_match_i32(value: i32): i32 = match value {
    0 => id(7)
    1 => id(13)
    _ => id(42)
}

/// Short-circuit AND lowers through branch condition code.
def short_and(left: bool, right: bool): i32 = if left && right { id(7) } else { id(13) }

/// Short-circuit OR lowers through branch condition code.
def short_or(left: bool, right: bool): i32 = if left || right { id(7) } else { id(13) }

/// Intrinsic-style i32 addition method used by operator lowering.
def i32.op_add(self: i32, other: i32): i32 = self + other

/// Intrinsic-style i32 subtraction method used by operator lowering.
def i32.op_sub(self: i32, other: i32): i32 = self - other

/// Intrinsic-style i32 multiplication method used by operator lowering.
def i32.op_mul(self: i32, other: i32): i32 = self * other

/// Intrinsic-style i32 division method used by operator lowering.
def i32.op_div(self: i32, other: i32): i32 = self / other

/// Add two i32 values through the operator lowering smoke path.
def add2(left: i32, right: i32): i32 = left + right

/// Subtract two i32 values through the operator lowering smoke path.
def sub2(left: i32, right: i32): i32 = left - right

/// Prefix negation lowers through the same method protocol as subtraction.
def neg_param(value: i32): i32 = -value

/// Prefix negation also works for literal operands.
def neg_literal(): i32 = -7

/// Prefix negation remains prefix when used as the right side of an infix expression.
def add_negative(left: i32, right: i32): i32 = left + -right

/// Multiply two i32 values through the operator lowering smoke path.
def mul2(left: i32, right: i32): i32 = left * right

/// Divide two i32 values through the operator lowering smoke path.
def div2(left: i32, right: i32): i32 = left / right

/// Preserve precedence while operator lowering still goes through methods.
def op_precedence(left: i32, mid: i32, right: i32): i32 = left + mid * right

/// Three-argument function used to verify non-param0 call argument lowering.
def add3(a: i32, b: i32, c: i32): i32 = a + b + c

/// Multi-argument tail call keeps argument order and mixed param/const lowering.
def call_add3(x: i32, y: i32): i32 = add3(x, y, 5)

/// Pipe without placeholder lowers to receiver-first function call.
def pipe_default(): i32 = 7 |> id

/// Pipe placeholder duplicates the input value at each placeholder site.
def pipe_placeholder(): i32 = 7 |> add2(_, _)

/// Pipe chain nests tail-call arguments left-to-right.
def pipe_chain(): i32 = 7 |> id |> id

/// Pipe RHS may be a qualified method-style callable.
def pipe_method_path(): i32 = 7 |> i32.i32_id

/// Method-style source expression lowers to receiver-first call shape.
def i32.i32_id(self: i32): i32 = self

/// Method call smoke using receiver-first semantics.
def method_style(x: i32): i32 = x.i32_id()

/// Qualified tail-call smoke keeps namespace-like target text visible.
def qualified_call(): i32 = i32.i32_id(31)

/// Static global constant can be read from executable WAT.
def global_const(): i32 = ONE

/// Static global dependency is initialized before exported functions run.
def global_dependency(): i32 = TWO

/// Static globals compose with ordinary expression lowering.
def global_expr_use(): i32 = TWO + ONE

/// Index operator method smoke keeps indexing on the method protocol.
def i32.op_index(self: i32, index: i32): i32 = self + index

/// Index syntax lowers to receiver-first op_index call.
def index_style(x: i32): i32 = x[7]

/// Slice operator method smoke keeps range indexing on the method protocol.
def i32.op_index_slice(self: i32, start: i32, len: i32): i32 = self + start + len

/// Range indexing syntax lowers to receiver-first op_index_slice call.
def index_slice_style(x: i32): i32 = x[7..13]

/// Tuple field access reads the first stable positional field.
def tuple_first(): i32 = (41, 1)._1

/// Tuple field access reads the second stable positional field.
def tuple_second(): i32 = (40, 2)._2

/// Tuple field access works for arity greater than two.
def tuple_third(): i32 = (38, 2, 1)._3
