/// C11 fixture for continuation package backend lowering.
namespace pre_c11.continuation_core

/// Multi-shot continuation should lower through a continuation package path.
def continuation_core(): i64 = reset {
    shiftn k {
        let first = k(1)
        k(2)
    }
}

/// Parameter resume bodies should lower to stackless functions with typed params.
def continuation_core_param(x: i64): i64 = reset {
    shiftn k {
        k(x)
    }
}
