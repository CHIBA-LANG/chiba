/// C10 fixture for multi-shot continuation package materialization.
namespace pre_c10.multishot_package

/// A continuation resumed more than once must be marked for package lowering.
def multishot_package(): i64 = reset {
    shiftn k {
        let first = k(1)
        k(2)
    }
}

/// A continuation resume can pass through an existing function parameter.
def multishot_param_package(x: i64): i64 = reset {
    shiftn k {
        k(x)
    }
}
