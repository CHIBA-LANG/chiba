#![CHIBALEX]

{
    namespace chibalexmini.attribute_tokens
    use metalstd.str.*
}

@ws = $WS+
@intlit = $ASCII_DIGIT+
@ident = $XID_START $XID_CONTINUE*
@strlit = "\"" [^"]* "\""

tokens :-
    @ws       ;
    "true"    { KwTrue }
    "false"   { KwFalse }
    @strlit   { StringLit(s) }
    @intlit   { IntLit(s) }
    @ident    { Ident(s) }
    "#!"      { HashBang }
    "#"       { Hash }
    "["       { LBracket }
    "]"       { RBracket }
    "("       { LParen }
    ")"       { RParen }
    "{"       { LBrace }
    "}"       { RBrace }
    ","       { Comma }
    "="       { Eq }

{
    data Token {
        Ident(Str),
        StringLit(Str),
        IntLit(Str),
        KwTrue,
        KwFalse,
        HashBang,
        Hash,
        LBracket,
        RBracket,
        LParen,
        RParen,
        LBrace,
        RBrace,
        Comma,
        Eq,
        LexError(i64),
        Eof,
    }
}
