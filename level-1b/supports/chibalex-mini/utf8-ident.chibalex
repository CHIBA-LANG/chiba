#![CHIBALEX]

{
    namespace chibalexmini.utf8_ident
    use metalstd.str.*
}

@ws = $WS+
@ident = $XID_START $XID_CONTINUE*

tokens :-
    @ws       ;
    "let"     { KwLet }
    @ident    { Ident(s) }
    "="       { Eq }

{
    data Token {
        Ident(Str),
        KwLet,
        Eq,
        LexError(i64),
        Eof,
    }
}
