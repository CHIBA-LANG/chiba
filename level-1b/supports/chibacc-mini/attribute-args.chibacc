#![CHIBACC]

{
    namespace chibaccmini.attribute_args
    use metalstd.vec.*
}

start attr

rule attr ::=
    Hash LBracket name:Ident RBracket => Attr(name, AttrArg_End)
    | Hash LBracket name:Ident LParen args:attr_args RParen RBracket => Attr(name, args)
    ;

rule attr_args ::=
    first:attr_arg rest:attr_args_tail => attr_args_cons(first, rest)
    ;

rule attr_args_tail ::=
    Comma next:attr_arg rest:attr_args_tail => attr_args_cons(next, rest)
    | Empty => AttrArg_End
    ;

rule attr_arg ::=
    name:Ident Eq value:attr_arg => AttrNamed(name, value)
    | name:Ident LParen args:attr_args RParen => AttrCall(name, args)
    | LBracket args:attr_args RBracket => AttrList(args)
    | LBrace fields:attr_fields RBrace => AttrObject(fields)
    | s:StringLit => AttrString(s)
    | n:IntLit => AttrInt(n)
    | KwTrue => AttrBool(true)
    | KwFalse => AttrBool(false)
    | name:Ident => AttrBare(name)
    ;

rule attr_fields ::=
    first:attr_field rest:attr_fields_tail => attr_fields_cons(first, rest)
    ;

rule attr_fields_tail ::=
    Comma next:attr_field rest:attr_fields_tail => attr_fields_cons(next, rest)
    | Empty => AttrField_End
    ;

rule attr_field ::=
    name:Ident Eq value:attr_arg => AttrField(name, value)
    ;

{
    def attr_args_cons(head: AST, tail: AST): AST =
        AttrArg_Cons(head, tail)

    def attr_fields_cons(head: AST, tail: AST): AST =
        AttrField_Cons(head, tail)

    data AST {
        Attr(Str, AST),
        AttrArg_Cons(AST, AST),
        AttrArg_End,
        AttrBare(Str),
        AttrString(Str),
        AttrInt(Str),
        AttrBool(bool),
        AttrNamed(Str, AST),
        AttrCall(Str, AST),
        AttrList(AST),
        AttrObject(AST),
        AttrField_Cons(AST, AST),
        AttrField_End,
        AttrField(Str, AST),
    }
}
