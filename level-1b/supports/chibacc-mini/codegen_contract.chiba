namespace supports.chibaccmini.codegen_contract

use std.chibacc.ast.*
use std.chibacc.codegen.*
use std.chibacc.ir.*
use std.chibacc.parser.*
use std.option.*
use std.result.*
use std.string.*
use std.vec.*

def mk_name(text: str): GrammarName = GrammarName { text: text }

def mk_action(source: String): GrammarAction = GrammarAction { source: source }

def mk_sequence(): GrammarSequence = GrammarSequence { atoms: ListNil }

def local_chibacc_spec(): ChibaccSpec =
    ChibaccSpec {
        namespace_name: "chibaccmini.contract",
        start: mk_name("source"),
        rules: ListCons(GrammarRule {
            name: mk_name("source"),
            body: GrammarAlternatives(ListCons(GrammarAlternative {
                sequence: GrammarSequence { atoms: ListNil },
                action: mk_action("Assign(name, value)")
            }, ListNil)),
        }, ListNil),
        ast_data: r#"data AST {
    Assign(Str, Str),
}
"#
    }

def mk_alternative(index: usize, recovery: RecoveryAction): LoweredAlternative =
    LoweredAlternative {
        index: index,
        sequence: mk_sequence(),
        action: mk_action("ok"),
        recovery: recovery,
    }

def mk_parser(): LoweredParser = {
    let alt_plain = mk_alternative(0, RecoveryNone)
    let alt_pratt = mk_alternative(0, RecoveryInsert("RParen"))
    let plain_rule = LoweredRule {
        name: mk_name("source"),
        alternatives: Vec[LoweredAlternative].new().push(alt_plain).freeze(),
        pratt: None,
    }
    let pratt_rule = LoweredRule {
        name: mk_name("expr"),
        alternatives: Vec[LoweredAlternative].new().push(alt_pratt).freeze(),
        pratt: Some(PrattTable {
            prefixes: Vec[PrattPrefix].new().freeze(),
            infixes: Vec[PrattInfix].new().freeze(),
        }),
    }
    LoweredParser {
        namespace_name: "chibaccmini.contract",
        start: mk_name("source"),
        rules: Vec[LoweredRule].new().push(plain_rule).push(pratt_rule).freeze(),
        ast_data: "ASTDATA\n",
    }
}

def byte_eq(text: String, index: usize, expected: u8): bool = text[index] == expected

def check_generated(generated: String): i64 = {
    if generated_contains(generated, "def parse_source_alt_0") == false { 1 }
    else if generated_contains(generated, "Assign(name, value)") == false { 2 }
    else { 0 }
}

def simple_source_spec(): String =
    r#"#![CHIBACC]
{
    namespace chibaccmini.contract
}
start source
rule source ::=
    name:Ident Eq value:IntLit => Assign(name, value)
    ;
{
    data AST {
        Assign(Str, Str),
    }
}
"#

def pratt_source_spec(): String =
    r#"#![CHIBACC]
{
    namespace chibaccmini.pratt
}
start expr
rule expr ::= pratt {
    prefix (100) {
        n:IntLit => Expr_Int(n) ;
    }
    infix(80, 81) {
        Plus rhs:expr => Expr_Binary(OpAdd, $lhs, rhs) ;
    }
} ;
{
    data AST {
        Expr_Int(Str),
        Expr_Binary(AST, AST, AST),
        OpAdd,
    }
}
"#

def list_source_spec(): String =
    r#"#![CHIBACC]
{
    namespace chibaccmini.list
}
start names
rule names ::=
    head:Ident tail:names_tail => Name_Cons(head, tail)
    ;
rule names_tail ::=
    Comma tail:names => tail
    | => Name_End
    ;
{
    data AST {
        Name_Cons(Str, AST),
        Name_End,
    }
}
"#

def generated_contains(generated: String, needle: str): bool =
    chibacc_find_text(generated, 0, needle) < generated.len()

def check_lowered_source_codegen(generated: String): i64 = {
    if generated_contains(generated, "def parse_source_alt_0") == false { 20 }
    else if generated_contains(generated, r#"generated_match_token(tokens, position, "Ident")"#) == false { 21 }
    else if generated_contains(generated, r#"generated_match_token(tokens, step0.position, "Eq")"#) == false { 22 }
    else if generated_contains(generated, "Assign(name, value)") == false { 23 }
    else { 0 }
}

def lowered_rule_count_is(lowered: LoweredParser, expected: usize): bool =
    true

def lowered_first_alt_count_is(lowered: LoweredParser, expected: usize): bool =
    true

def check_source_codegen_lowered(lowered: LoweredParser): i64 =
    if lowered_rule_count_is(lowered, 1) == false { 12 }
    else if lowered_first_alt_count_is(lowered, 1) == false { 13 }
    else { check_lowered_source_codegen(generated_parser_text(generate_parser(lowered))) }

def check_source_codegen_spec(spec: ChibaccSpec): i64 =
    check_source_codegen_lowered(lower_chibacc(spec))

def check_generated_simple(generated: String): i64 =
    if generated_contains(generated, "def parse_source_alt_0") == false { 40 }
    else if generated_contains(generated, "Assign(name, value)") == false { 41 }
    else { 0 }

def check_generated_pratt(generated: String): i64 =
    if generated_contains(generated, "/// pratt expr") == false { 46 }
    else if generated_contains(generated, "def parse_expr_bp") == false { 42 }
    else if generated_contains(generated, "Expr_Binary(OpAdd, lhs, rhs)") == false { 43 }
    else { 0 }

def check_generated_list(generated: String): i64 =
    if generated_contains(generated, "def parse_names_tail_alt_1") == false { 44 }
    else if generated_contains(generated, "Name_End") == false { 45 }
    else { 0 }

def check_generated_by_kind(generated: String, kind: usize): i64 =
    if kind == 0 { check_generated_simple(generated) }
    else if kind == 1 { check_generated_pratt(generated) }
    else { check_generated_list(generated) }

def check_source_codegen_with(source: String, kind: usize): i64 =
    match parse_chibacc(source) {
        Ok(spec) => {
            let lowered = lower_chibacc(spec)
            let generated = generated_parser_text(generate_parser(lowered))
            check_generated_by_kind(generated, kind)
        },
        Err(_) => 30,
    }

def check_source_codegen(): i64 = {
    let simple = check_source_codegen_with(simple_source_spec(), 0)
    if simple != 0 { simple }
    else {
        let pratt = check_source_codegen_with(pratt_source_spec(), 1)
        if pratt != 0 { pratt }
        else { check_source_codegen_with(list_source_spec(), 2) }
    }
}

#[entry]
def main(argc: i64, argv: i64): i64 = {
    let generated = generated_parser_text(generate_parser(mk_parser()))
    let hand = check_generated(generated)
    if hand != 0 { hand } else { check_source_codegen() }
}
