namespace bootstrap

use compiler.cli.*
use compiler.driver.nanopass_pipeline.*
use compiler.source.project.*

def main_error_code(cli: ChibacCliConfig, request: CompileRequest): i64 =
    source_stage_error_code(cli, request)

def source_stage_error_code(cli: ChibacCliConfig, request: CompileRequest): i64 =
    match run_source_driver(DriverInput {
        cli: cli,
        project: load_project(request.inputs, request.includes),
        target_facts: request.target_facts,
    }) {
        Ok(project) => semantic_stage_error_code(project)
        Err(_) => 2
    }

def semantic_stage_error_code(project: ProjectSurface): i64 =
    match run_typed_semantics(project) {
        Ok(typed) => backend_stage_error_code(typed)
        Err(_) => 3
    }

def backend_stage_error_code(typed: TypedModule): i64 =
    match run_wasm_gc_wat(typed) {
        Ok(_) => 9
        Err(_) => 4
    }

/// Seed entry until level-1b owns parser, semantic checker, and WAT emission.
def main(): i64 = {
    let cli = ChibacCliConfig {
        input_count: 0,
        include_count: 0,
        output_count: 0,
        target: ChibacTargetMissing,
        backend: ChibacBackendMissing,
        emit: ChibacEmitDefault,
        opt_level: ChibacOpt0,
        debug: false,
        error_format: ChibacErrorHuman,
        color: ChibacColorAuto,
        diagnostic_width: 0,
    }
    let request = CompileRequest {
        cli: cli,
        inputs: Vec[String].new().freeze(),
        includes: Vec[IncludeDir].new().freeze(),
        target_facts: CompileTargetFacts { target: "wasm32-unknown-wasi", backend: "wasm-gc" },
    }
    match compile_request_to_wat(request) {
        Ok(_) => 0,
        Err(_) => main_error_code(cli, request)
    }
}
