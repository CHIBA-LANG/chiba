/// UTF-8/WTF-8 byte string surface.
///
/// `String == Array[u8]` and `str == Slice[u8]`. Indexing returns bytes;
/// character inspection is explicit through `.char_at(index)`.
namespace std.string

/// Unicode scalar value decoded from a UTF-8/WTF-8 string view.
type Char {
    codepoint: u32,
}

/// Return the byte length of an owned string.
def String.len(self): usize = __compiler_builtin("std.string_len")

/// Return true when an owned string has no bytes.
def String.is_empty(self): bool = self.len() == 0

/// Return the byte at an index with bounds checking.
def String.byte_at(self, index: usize): u8 = __compiler_builtin("std.string_byte_at")

/// Return the byte at an index with bounds checking.
def String.get(self, index: usize): u8 = self.byte_at(index)

/// Return a managed byte view over an owned string.
def String.slice(self, offset: usize, len: usize): str = __compiler_builtin("std.string_slice")

/// Return a full managed byte view over an owned string.
def String.to_str(self): str = self.slice(0, self.len())

/// Return a full managed byte view over an owned string.
def String.to_slice(self): Slice[u8] = self.to_str()

/// Return this owned string.
def String.to_string(self): String = self

/// Copy the owned string bytes into a growable byte builder.
def String.to_byte_vec(self): Vec[u8] =
    self.to_str().to_byte_vec()

/// Copy the owned string bytes into a growable byte builder.
def String.to_vec(self): Vec[u8] = self.to_byte_vec()

/// Return the owned string as its immutable byte array representation.
def String.to_array(self): Array[u8] = self

/// Decode a codepoint beginning at a byte index.
def String.char_at(self, index: usize): Char = __compiler_builtin("std.string_char_at")

/// Return the byte length of a string slice.
def str.len(self): usize = __compiler_builtin("std.str_len")

/// Return true when a string slice has no bytes.
def str.is_empty(self): bool = self.len() == 0

/// Return the byte at an index with bounds checking.
def str.byte_at(self, index: usize): u8 = __compiler_builtin("std.str_byte_at")

/// Return the byte at an index with bounds checking.
def str.get(self, index: usize): u8 = self.byte_at(index)

/// Return a managed byte subview.
def str.slice(self, offset: usize, len: usize): str = __compiler_builtin("std.str_slice")

/// Copy a string view into an owned string.
def str.to_string(self): String = __compiler_builtin("std.str_to_string")

/// Return this managed byte view.
def str.to_str(self): str = self

/// Return this managed byte view as a generic byte slice.
def str.to_slice(self): Slice[u8] = self

/// Copy string-view bytes into a growable byte builder.
def str.to_byte_vec_loop(self, index: usize, out: Vec[u8]): Vec[u8] =
    if index == self.len() { out }
    else { self.to_byte_vec_loop(index + 1, out.push(self.byte_at(index))) }

/// Copy string-view bytes into a growable byte builder.
def str.to_byte_vec(self): Vec[u8] =
    self.to_byte_vec_loop(0, Vec[u8].new())

/// Copy string-view bytes into a growable byte builder.
def str.to_vec(self): Vec[u8] = self.to_byte_vec()

/// Copy string-view bytes into an immutable byte array.
def str.to_array(self): Array[u8] = self.to_byte_vec().freeze()

/// Decode a codepoint beginning at a byte index.
def str.char_at(self, index: usize): Char = __compiler_builtin("std.str_char_at")

/// Concatenate two owned strings.
def String.concat(self, other: String): String = __compiler_builtin("std.string_concat")
