/// Chibalex matching engine contract.
///
/// This module expresses speculative rule choice with `reset` / `shift` so the
/// same surface can lower to one-pass CPS and later direct code.
namespace std.chibalex.engine

use std.chibalex.ir.*
use std.regex.matcher.*
use std.regex.utf8.*

/// Candidate match for one rule.
type LexCandidate {
    rule: LexRuleId,
    end: usize,
}

/// Current lexer state.
type LexState {
    mode: LexMode,
    offset: usize,
    line: usize,
    column: usize,
}

/// Construct a lexer state value.
def lex_state(mode: LexMode, offset: usize, line: usize, column: usize): LexState =
    LexState(mode, offset, line, column)

/// Choose the better candidate by longest-match and source-order tie-break.
def LexCandidate.better_than(self, other: Option[LexCandidate]): bool =
    match other {
        None => true
        Some(prev) =>
            if self.end > prev.end { true }
            else if self.end == prev.end { self.rule.index < prev.rule.index }
            else { false }
    }

/// Speculatively resume candidate selection for lexer backtracking.
def choose_with_backtracking(candidate: LexCandidate): LexCandidate = reset {
    shift retry {
        let first = retry(candidate)
        retry(first)
    }
}

/// Return true when a lowered rule is active in the current mode.
def LexMode.eq(self, other: LexMode): bool = self.name == other.name

/// Build a candidate for one rule when it matches at the current offset.
def lex_candidate_for_rule(rule: LoweredLexRule, input: str, state: LexState): Option[LexCandidate] =
    if rule.mode.eq(state.mode) == false { None }
    else {
        match rule.program.longest_at(input, state.offset) {
            Some(found) =>
                if found.end > state.offset { Some(LexCandidate { rule: rule.id, end: found.end }) }
                else { None }
            None => None
        }
    }

/// Select the best candidate from all rules.
def find_best_rule_loop(rules: Array[LoweredLexRule], input: str, state: LexState, index: usize, best: Option[LexCandidate]): Option[LexCandidate] =
    if index == rules.len() { best }
    else {
        let candidate = lex_candidate_for_rule(rules.get(index), input, state)
        let next_best = match candidate {
            Some(found) =>
                if found.better_than(best) { Some(found) }
                else { best }
            None => best
        }
        find_best_rule_loop(rules, input, state, index + 1, next_best)
    }

/// Find the best rule at the current state.
def find_best_rule(lexer: LoweredLexer, input: str, state: LexState): Option[LexCandidate] =
    find_best_rule_loop(lexer.ordered_rules(), input, state, 0, None)

/// Advance one UTF-8 codepoint of line/column state.
def LexState.advance_char(self, input: str): LexState =
    if self.offset >= input.len() { self }
    else {
        let next = input.next_char_offset(self.offset)
        if input.byte_at(self.offset) == 10 { lex_state(self.mode, next, self.line + 1, 0) }
        else { lex_state(self.mode, next, self.line, self.column + 1) }
    }

/// Advance lexer state codepoint-by-codepoint until `end`.
def LexState.advance_until(self, input: str, end: usize): LexState =
    if self.offset >= end { self }
    else { self.advance_char(input).advance_until(input, end) }

/// Advance lexer state after a chosen match.
def LexState.advance(self, input: str, end: usize): LexState =
    self.advance_until(input, end)
