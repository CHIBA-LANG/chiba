/// Chibalex code generation contract.
///
/// Codegen serializes a validated [std.chibalex.ir.LoweredLexer] to
/// Chiba source. It does not emit pointer-shaped runtime APIs.
namespace std.chibalex.codegen

use std.diagnostic.*
use std.chibalex.ir.*
use std.regex.ast.*

/// Codegen completeness for generated lexer source.
data LexerCodegenStatus {
    LexerCodegenComplete,
}

/// Generated lexer source file.
type GeneratedLexer {
    source: String,
    status: LexerCodegenStatus,
    diagnostic: String,
}

/// Append generated lexer prelude.
def append_lexer_prelude(builder: DiagnosticBuilder, lexer: LoweredLexer): DiagnosticBuilder =
    builder
        .push_str("namespace ")
        .push_str(lexer.namespace_name)
        .push_str("\n")
        .push_str("/// Generated by std.chibalex.codegen.\n")
        .push_str("use std.chibalex.engine.*\n")
        .push_str("use std.chibalex.ir.*\n")
        .push_str("use std.regex.ast.*\n")
        .push_str("use std.regex.program.*\n")

/// Render a small usize as source text.
def lexer_codegen_decimal_digit(value: usize): str =
    if value == 0 { "0" }
    else if value == 1 { "1" }
    else if value == 2 { "2" }
    else if value == 3 { "3" }
    else if value == 4 { "4" }
    else if value == 5 { "5" }
    else if value == 6 { "6" }
    else if value == 7 { "7" }
    else if value == 8 { "8" }
    else { "9" }

/// Render a usize as source text.
def lexer_codegen_usize(value: usize): String =
    if value < 10 { lexer_codegen_decimal_digit(value) }
    else { lexer_codegen_usize(value / 10).concat(lexer_codegen_decimal_digit(value % 10)) }

/// Render a u32 codepoint as source text.
def lexer_codegen_u32(value: u32): String =
    if value < 10 { lexer_codegen_decimal_digit(value as usize) }
    else { lexer_codegen_u32(value / 10).concat(lexer_codegen_decimal_digit((value % 10) as usize)) }

/// Append a quoted source string. Lexer mode/action names are parsed identifiers.
def append_lexer_quoted(builder: DiagnosticBuilder, text: str): DiagnosticBuilder =
    builder.push_str(r#"""#).push_str(text).push_str(r#"""#)

/// Append a LexMode literal.
def append_lexer_mode(builder: DiagnosticBuilder, mode: LexMode): DiagnosticBuilder =
    append_lexer_quoted(builder.push_str(r#"LexMode { name: "#), mode.name).push_str(r#" }"#)

/// Append a RegexChar literal.
def append_regex_char(builder: DiagnosticBuilder, ch: RegexChar): DiagnosticBuilder =
    builder.push_str(r#"RegexChar { codepoint: "#).push_str(lexer_codegen_u32(ch.codepoint)).push_str(r#" }"#)

/// Append a RegexClassAtom literal.
def append_regex_class_atom(builder: DiagnosticBuilder, atom: RegexClassAtom): DiagnosticBuilder =
    match atom {
        RegexClassChar(ch) => append_regex_char(builder.push_str("RegexClassChar("), ch).push_str(")")
        RegexClassRange(start, end) => append_regex_char(append_regex_char(builder.push_str("RegexClassRange("), start).push_str(", "), end).push_str(")")
        RegexClassDigit => builder.push_str("RegexClassDigit")
        RegexClassWord => builder.push_str("RegexClassWord")
        RegexClassWhitespace => builder.push_str("RegexClassWhitespace")
        RegexClassXidStart => builder.push_str("RegexClassXidStart")
        RegexClassXidContinue => builder.push_str("RegexClassXidContinue")
    }

/// Append a RegexClassAtom list literal.
def append_regex_class_atoms(builder: DiagnosticBuilder, atoms: List[RegexClassAtom]): DiagnosticBuilder =
    match atoms {
        ListNil => builder.push_str("ListNil")
        ListCons(head, tail) => append_regex_class_atoms(append_regex_class_atom(builder.push_str("ListCons("), head).push_str(", "), tail).push_str(")")
    }

/// Append a RegexClass literal.
def append_regex_class(builder: DiagnosticBuilder, class: RegexClass): DiagnosticBuilder =
    append_regex_class_atoms(
        builder
            .push_str(r#"RegexClass { negated: "#)
            .push_str(if class.negated { "true" } else { "false" })
            .push_str(", atoms: "),
        class.atoms)
        .push_str(r#" }"#)

/// Append a quantifier mode literal.
def append_regex_quant_mode(builder: DiagnosticBuilder, mode: RegexQuantMode): DiagnosticBuilder =
    match mode {
        RegexGreedy => builder.push_str("RegexGreedy")
        RegexLazy => builder.push_str("RegexLazy")
    }

/// Append an optional usize literal.
def append_regex_optional_usize(builder: DiagnosticBuilder, value: Option[usize]): DiagnosticBuilder =
    match value {
        Some(item) => builder.push_str("Some(").push_str(lexer_codegen_usize(item)).push_str(")")
        None => builder.push_str("None")
    }

/// Append a RegexRepeat literal.
def append_regex_repeat(builder: DiagnosticBuilder, repeat: RegexRepeat): DiagnosticBuilder =
    append_regex_quant_mode(
        append_regex_optional_usize(
            builder
                .push_str(r#"RegexRepeat { min: "#)
                .push_str(lexer_codegen_usize(repeat.min))
                .push_str(", max: "),
            repeat.max)
            .push_str(", mode: "),
        repeat.mode)
        .push_str(r#" }"#)

/// Append a RegexAst list literal.
def append_regex_ast_list(builder: DiagnosticBuilder, items: List[RegexAst]): DiagnosticBuilder =
    match items {
        ListNil => builder.push_str("ListNil")
        ListCons(head, tail) => append_regex_ast_list(append_regex_ast(builder.push_str("ListCons("), head).push_str(", "), tail).push_str(")")
    }

/// Append a RegexAssertion literal.
def append_regex_assertion(builder: DiagnosticBuilder, assertion: RegexAssertion): DiagnosticBuilder =
    match assertion {
        RegexStart => builder.push_str("RegexStart")
        RegexEnd => builder.push_str("RegexEnd")
        RegexWordBoundary => builder.push_str("RegexWordBoundary")
        RegexNotWordBoundary => builder.push_str("RegexNotWordBoundary")
        RegexLookAhead(inner) => append_regex_ast(builder.push_str("RegexLookAhead("), inner).push_str(")")
        RegexNotLookAhead(inner) => append_regex_ast(builder.push_str("RegexNotLookAhead("), inner).push_str(")")
        RegexLookBehind(inner) => append_regex_ast(builder.push_str("RegexLookBehind("), inner).push_str(")")
        RegexNotLookBehind(inner) => append_regex_ast(builder.push_str("RegexNotLookBehind("), inner).push_str(")")
    }

/// Append a RegexAst literal.
def append_regex_ast(builder: DiagnosticBuilder, ast: RegexAst): DiagnosticBuilder =
    match ast {
        RegexEmpty => builder.push_str("RegexEmpty")
        RegexLiteral(ch) => append_regex_char(builder.push_str("RegexLiteral("), ch).push_str(")")
        RegexAny => builder.push_str("RegexAny")
        RegexClassExpr(class) => append_regex_class(builder.push_str("RegexClassExpr("), class).push_str(")")
        RegexSequence(items) => append_regex_ast_list(builder.push_str("RegexSequence("), items).push_str(")")
        RegexAlternative(items) => append_regex_ast_list(builder.push_str("RegexAlternative("), items).push_str(")")
        RegexCapture(inner) => append_regex_ast(builder.push_str("RegexCapture("), inner).push_str(")")
        RegexNonCapture(inner) => append_regex_ast(builder.push_str("RegexNonCapture("), inner).push_str(")")
        RegexRepeatExpr(inner, repeat) => append_regex_repeat(append_regex_ast(builder.push_str("RegexRepeatExpr("), inner).push_str(", "), repeat).push_str(")")
        RegexAssert(assertion) => append_regex_assertion(builder.push_str("RegexAssert("), assertion).push_str(")")
    }

/// Append a LexTransition literal.
def append_lexer_transition(builder: DiagnosticBuilder, transition: LexTransition): DiagnosticBuilder =
    match transition {
        LexStay => builder.push_str("LexStay")
        LexPush(mode) => append_lexer_mode(builder.push_str("LexPush("), mode).push_str(")")
        LexPop => builder.push_str("LexPop")
        LexGoto(mode) => append_lexer_mode(builder.push_str("LexGoto("), mode).push_str(")")
    }

/// Append a lowered rule literal.
def append_lowered_rule_literal(builder: DiagnosticBuilder, rule: LoweredLexRule): DiagnosticBuilder =
    append_lexer_transition(
        append_regex_ast(
            append_lexer_mode(
                builder
                    .push_str(r#"LoweredLexRule { id: LexRuleId { index: "#)
                    .push_str(lexer_codegen_usize(rule.id.index))
                    .push_str(r#" }, mode: "#),
                rule.mode)
                .push_str(", pattern: "),
            rule.pattern)
            .push_str(", program: compile_regex("),
            rule.pattern)
            .push_str(r#"), action: LexAction { body: "" }, transition: "#),
        rule.transition)
        .push_str(", trivia: ")
        .push_str(if rule.trivia { "true" } else { "false" })
        .push_str(r#" }"#)

/// Append generated rule array construction.
def append_lowered_rule_array(builder: DiagnosticBuilder, rules: Array[LoweredLexRule], index: usize): DiagnosticBuilder =
    if index == rules.len() { builder.push_str(".freeze()") }
    else { append_lowered_rule_array(append_lowered_rule_literal(builder.push_str(".push("), rules.get(index)).push_str(")"), rules, index + 1) }

/// Append generated mode array construction.
def append_lexer_mode_array(builder: DiagnosticBuilder, modes: Array[LexMode], index: usize): DiagnosticBuilder =
    if index == modes.len() { builder.push_str(".freeze()") }
    else { append_lexer_mode_array(append_lexer_mode(builder.push_str(".push("), modes.get(index)).push_str(")"), modes, index + 1) }

/// Append the lowered lexer factory used by generated lex_loop.
def append_generated_lexer_factory(builder: DiagnosticBuilder, lexer: LoweredLexer): DiagnosticBuilder =
    append_lowered_rule_array(
        append_lexer_mode_array(
            append_lexer_quoted(builder.push_str(r#"def generated_lexer(): LoweredLexer = LoweredLexer { namespace_name: "#), lexer.namespace_name)
                .push_str(", modes: Vec[LexMode].new()"),
            lexer.modes,
            0)
            .push_str(", rules: Vec[LoweredLexRule].new()"),
        lexer.rules,
        0)
        .push_str(r#", token_data: "" }
"#)

/// Append one lowered lexer rule summary.
def append_lexer_rule_summary(builder: DiagnosticBuilder, rule: LoweredLexRule): DiagnosticBuilder =
    builder
        .push_str("/// rule ")
        .push_str(lexer_codegen_usize(rule.id.index))
        .push_str("\n")

/// Append all lowered lexer rule summaries.
def append_lexer_rule_summaries(rules: Array[LoweredLexRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else { append_lexer_rule_summaries(rules, index + 1, append_lexer_rule_summary(builder, rules.get(index))) }

/// Append one token emission branch for a rule.
def append_lexer_emit_branch(builder: DiagnosticBuilder, rule: LoweredLexRule): DiagnosticBuilder =
    if rule.trivia {
        builder
    } else {
        builder
            .push_str("    else if rule.index == ")
            .push_str(lexer_codegen_usize(rule.id.index))
            .push_str(r#" { let s = input.slice(start, end - start); Some("#)
            .push_str(rule.action.body)
            .push_str(r#") }\n"#)
    }

/// Append token emission branches.
def append_lexer_emit_branches(rules: Array[LoweredLexRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else { append_lexer_emit_branches(rules, index + 1, append_lexer_emit_branch(builder, rules.get(index))) }

/// Return true when a byte can appear in a generated token constructor name.
def lexer_action_ctor_byte(byte: u8): bool =
    if byte >= 65 {
        if byte <= 90 { true } else {
            if byte >= 97 {
                if byte <= 122 { true } else {
                    if byte >= 48 {
                        if byte <= 57 { true } else { byte == 95 }
                    } else { byte == 95 }
                }
            } else {
                if byte >= 48 {
                    if byte <= 57 { true } else { byte == 95 }
                } else { byte == 95 }
            }
        }
    } else {
        if byte >= 48 {
            if byte <= 57 { true } else { byte == 95 }
        } else { byte == 95 }
    }

/// Find the end of the token constructor in an action such as `Ident(s)`.
def lexer_action_ctor_end(action: String, offset: usize): usize =
    if offset >= action.len() { offset }
    else {
        let byte = action.byte_at(offset)
        if lexer_action_ctor_byte(byte) { lexer_action_ctor_end(action, offset + 1) }
        else { offset }
    }

/// Return the constructor name emitted by one token action.
def lexer_action_ctor_name(action: String): str =
    action.slice(0, lexer_action_ctor_end(action, 0))

/// Return true when the token action carries the matched slice as payload.
def lexer_action_has_payload(action: String): bool =
    let end = lexer_action_ctor_end(action, 0)
    if end < action.len() {
        let byte = action.byte_at(end)
        byte == 40
    } else { false }

/// Append one token reflection match arm for `generated_name`.
def append_token_name_arm(builder: DiagnosticBuilder, rule: LoweredLexRule): DiagnosticBuilder =
    if rule.trivia { builder }
    else {
        let ctor = lexer_action_ctor_name(rule.action.body)
        let payload = lexer_action_has_payload(rule.action.body)
        builder
            .push_str("        ")
            .push_str(ctor)
            .push_str(if payload { r#"(_) => ""# } else { r#" => ""# })
            .push_str(ctor)
            .push_str(r#""
"#)
    }

/// Append token reflection name arms.
def append_token_name_arms(rules: Array[LoweredLexRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else { append_token_name_arms(rules, index + 1, append_token_name_arm(builder, rules.get(index))) }

/// Append one token reflection match arm for `generated_payload`.
def append_token_payload_arm(builder: DiagnosticBuilder, rule: LoweredLexRule): DiagnosticBuilder =
    if rule.trivia { builder }
    else if lexer_action_has_payload(rule.action.body) == false { builder }
    else {
        builder
            .push_str("        ")
            .push_str(lexer_action_ctor_name(rule.action.body))
            .push_str("(value) => value\n")
    }

/// Append token reflection payload arms.
def append_token_payload_arms(rules: Array[LoweredLexRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else { append_token_payload_arms(rules, index + 1, append_token_payload_arm(builder, rules.get(index))) }

/// Append generated Token reflection helpers consumed by generated parsers.
def append_token_reflection_helpers(builder: DiagnosticBuilder, lexer: LoweredLexer): DiagnosticBuilder =
    append_token_payload_arms(
        lexer.rules,
        0,
        append_token_name_arms(
            lexer.rules,
            0,
            builder
                .push_str("def Token.generated_name(self): str =\n")
                .push_str(r#"    match self {\n"#))
            .push_str(r#"        _ => ""
"#)
            .push_str(r#"    }\n"#)
            .push_str("def Token.generated_payload(self): str =\n")
            .push_str(r#"    match self {\n"#))
        .push_str(r#"        _ => ""
"#)
        .push_str(r#"    }\n"#)

/// Append generated runtime helpers.
def append_lexer_runtime(builder: DiagnosticBuilder, lexer: LoweredLexer): DiagnosticBuilder =
    append_lexer_emit_branches(
        lexer.rules,
        0,
        append_token_reflection_helpers(builder, lexer)
            .push_str("def generated_start_mode(): LexMode = generated_lexer().modes.get(0)\n")
            .push_str("def generated_after_transition(rule: LoweredLexRule, state: LexState): LexState =\n")
            .push_str(r#"    match rule.transition {\n"#)
            .push_str("        LexStay => state\n")
            .push_str("        LexGoto(mode) => lex_state(mode, state.offset, state.line, state.column)\n")
            .push_str("        LexPush(mode) => lex_state(mode, state.offset, state.line, state.column)\n")
            .push_str("        LexPop => lex_state(generated_start_mode(), state.offset, state.line, state.column)\n")
            .push_str(r#"    }\n"#)
            .push_str("def generated_emit_token(rule: LexRuleId, input: str, start: usize, end: usize): Option[Token] =\n")
            .push_str(r#"    if false { None }\n"#))
        .push_str(r#"    else { None }\n"#)
        .push_str("def lex_all(input: str): Array[TokenSpan] = lex_loop(input, lex_state(generated_start_mode(), 0, 0, 0), Vec[TokenSpan].new())\n")
        .push_str("def lex_all_from(input: str, offset: usize, out: Vec[TokenSpan]): Array[TokenSpan] = lex_loop(input, lex_state(generated_start_mode(), offset, 0, 0), out)\n")
        .push_str("def lex_loop(input: str, state: LexState, out: Vec[TokenSpan]): Array[TokenSpan] =\n")
        .push_str(r#"    if state.offset >= input.len() { out.freeze() }\n"#)
        .push_str(r#"    else {\n"#)
        .push_str("        let lexer = generated_lexer()\n")
        .push_str(r#"        match find_best_rule(lexer, input, state) {\n"#)
        .push_str(r#"            Some(found) => {\n"#)
        .push_str("                let rule = lexer.rules.get(found.rule.index)\n")
        .push_str("                let advanced = state.advance(input, found.end)\n")
        .push_str("                let next_state = generated_after_transition(rule, advanced)\n")
        .push_str(r#"                match generated_emit_token(found.rule, input, state.offset, found.end) {\n"#)
        .push_str(r#"                    Some(token) => lex_loop(input, next_state, out.push(TokenSpan { token: token, start: state.offset, end: found.end }))\n"#)
        .push_str("                    None => lex_loop(input, next_state, out)\n")
        .push_str(r#"                }\n"#)
        .push_str(r#"            }\n"#)
        .push_str("            None => lex_loop(input, state.advance_char(input), out)\n")
        .push_str(r#"        }\n"#)
        .push_str(r#"    }\n"#)

/// Generate Chiba source for a lowered lexer.
def generate_lexer(lexer: LoweredLexer): GeneratedLexer = {
    let builder0 = DiagnosticBuilder.new()
    let builder1 = append_lexer_prelude(builder0, lexer)
    let builder2 = append_lexer_rule_summaries(lexer.rules, 0, builder1)
    let builder3 = builder2
        .push_str(r#"type TokenSpan { token: Token, start: usize, end: usize }\n"#)
        .push_str(lexer.token_data)
        .push_str("\n")
    let builder4 = append_generated_lexer_factory(builder3, lexer)
    let source = append_lexer_runtime(builder4, lexer)
        .finish()
    GeneratedLexer {
        source: source,
        status: LexerCodegenComplete,
        diagnostic: "",
    }
}

/// Return the generated source text.
def generated_lexer_text(lexer: GeneratedLexer): String = lexer.source

/// Return true when codegen has produced executable lexer source.
def generated_lexer_complete(lexer: GeneratedLexer): bool =
    match lexer.status {
        LexerCodegenComplete => true
        _ => false
    }
