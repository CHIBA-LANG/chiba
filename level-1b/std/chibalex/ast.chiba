/// Chibalex source AST for level-1b.
///
/// This is the `.chibalex` front surface. Regex bodies are parsed by
/// [std.regex.parser], and modes are explicit nominal values.
namespace std.chibalex.ast

use std.regex.ast.*

/// Lexer mode name.
type LexMode {
    name: str,
}

/// Action emitted by one lexer rule.
type LexAction {
    body: String,
}

/// Mode transition after a rule fires.
data LexTransition {
    LexStay,
    LexPush(LexMode),
    LexPop,
    LexGoto(LexMode),
}

/// Builtin Chiba keyword surfaces that the level-1 lexer contract must cover.
data LexBuiltinKeyword {
    LexKeywordReset,
    LexKeywordShift,
    LexKeywordShiftn,
    LexKeywordCont1,
    LexKeywordContN,
}

/// UTF-8 handling required by generated lexers.
data LexUtf8Policy {
    LexUtf8Required,
    LexUtf8RejectInvalid,
}

/// Identifier policy used by `$XID_START` and `$XID_CONTINUE`.
type LexIdentifierPolicy {
    utf8: LexUtf8Policy,
    xid_start: String,
    xid_continue: String,
}

/// Keyword rule emitted before the generic identifier rule.
type LexKeywordRule {
    spelling: str,
    token_name: str,
    keyword: LexBuiltinKeyword,
}

/// Regex definition declared with `@name = ...`.
type LexRegexDef {
    name: str,
    ast: RegexAst,
}

/// Token rule in one mode.
type LexRule {
    mode: LexMode,
    pattern: RegexAst,
    action: LexAction,
    transition: LexTransition,
    trivia: bool,
}

/// Parsed `.chibalex` file.
type ChibalexSpec {
    namespace_name: str,
    modes: List[LexMode],
    identifier_policy: LexIdentifierPolicy,
    regex_defs: List[LexRegexDef],
    rules: List[LexRule],
    token_data: String,
}

/// Return true when a rule emits no token.
def LexRule.is_trivia(self): bool = self.trivia
