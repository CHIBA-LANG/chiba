/// Growable builder surface over managed array storage.
///
/// `Vec[T]` is a builder. Freezing it produces immutable `Array[T]`.
namespace std.vec

/// Growable builder for a managed array.
type Vec[T] {
    len: usize,
    capacity: usize,
}

/// Create an empty vector builder.
def Vec[T].new(): Vec[T] = __compiler_builtin("std.vec_new")

/// Return the number of initialized elements.
def Vec[T].len(self): usize = __compiler_builtin("std.vec_len")

/// Return true when a vector builder has no initialized elements.
def Vec[T].is_empty(self): bool = self.len() == 0

/// Read an initialized element by index with bounds checking.
def Vec[T].get(self, index: usize): T = __compiler_builtin("std.vec_get")

/// Append a value and return the updated builder.
def Vec[T].push(self, value: T): Vec[T] = __compiler_builtin("std.vec_push")

/// Append all array items and return the updated builder.
def Vec[T].extend_loop(self, values: Array[T], index: usize): Vec[T] =
    if index == values.len() { self }
    else { self.push(values.get(index)).extend_loop(values, index + 1) }

/// Append all array items and return the updated builder.
def Vec[T].extend(self, values: Array[T]): Vec[T] =
    self.extend_loop(values, 0)

/// Freeze the builder into an immutable managed array.
def Vec[T].freeze(self): Array[T] = __compiler_builtin("std.vec_freeze")

/// Produce a managed view over a builder range by freezing current contents.
def Vec[T].slice(self, offset: usize, len: usize): Slice[T] =
    self.freeze().slice(offset, len)

/// Convert the builder to an immutable array.
def Vec[T].to_array(self): Array[T] = self.freeze()

/// Return this builder; useful for generic collection conversion code.
def Vec[T].to_vec(self): Vec[T] = self

/// Convert the builder to a full managed view.
def Vec[T].to_slice(self): Slice[T] =
    self.to_array().to_slice()
