/// Chibacc code generation contract.
namespace std.chibacc.codegen

use std.array.*
use std.diagnostic.*
use std.chibacc.ir.*
use std.option.*
use std.string.*

/// Codegen completeness for generated parser source.
data ParserCodegenStatus {
    ParserCodegenComplete,
}

/// Generated parser source.
type GeneratedParser {
    source: String,
    status: ParserCodegenStatus,
    diagnostic: String,
}

/// Append parser runtime entry.
def append_parser_entry(builder: DiagnosticBuilder, parser: LoweredParser): DiagnosticBuilder =
    builder
        .push_str("def parse_tokens(tokens: Array[TokenSpan]): Result[AST, ParseFailure] = parse_")
        .push_str(parser.start.text)
        .push_str(r#"(tokens, ParsePosition { index: 0 }).map(|candidate| candidate.value)\n"#)

/// Append the generated parser prelude.
def append_parser_prelude(builder: DiagnosticBuilder, parser: LoweredParser): DiagnosticBuilder =
    builder
        .push_str("namespace ")
        .push_str(parser.namespace_name)
        .push_str("\n")
        .push_str("/// Generated by std.chibacc.codegen.\n")
        .push_str("use std.chibacc.engine.*\n")
        .push_str("/// Start rule: ")
        .push_str(parser.start.text)
        .push_str("\n")

/// Render a small usize as source text.
def parser_codegen_decimal_digit(value: usize): str =
    if value == 0 { "0" }
    else if value == 1 { "1" }
    else if value == 2 { "2" }
    else if value == 3 { "3" }
    else if value == 4 { "4" }
    else if value == 5 { "5" }
    else if value == 6 { "6" }
    else if value == 7 { "7" }
    else if value == 8 { "8" }
    else { "9" }

/// Render a usize as source text.
def parser_codegen_usize(value: usize): String =
    if value < 10 { parser_codegen_decimal_digit(value) }
    else { parser_codegen_usize(value / 10).concat(parser_codegen_decimal_digit(value % 10)) }

/// Append a quoted parser source string. Grammar names are identifiers.
def append_parser_quoted(builder: DiagnosticBuilder, text: str): DiagnosticBuilder =
    builder.push_str(r#"""#).push_str(text).push_str(r#"""#)

/// Append a list of expected token names into generated parser source.
def append_recovery_expected_source(builder: DiagnosticBuilder, expected: List[str]): DiagnosticBuilder =
    match expected {
        ListNil => { builder.push_str("ListNil") }
        ListCons(head, tail) => {
            append_recovery_expected_source(append_parser_quoted(builder.push_str("ListCons("), head).push_str(", "), tail).push_str(")")
        }
    }

/// Append a RecoveryAction expression into generated parser source.
def append_recovery_action_source(builder: DiagnosticBuilder, action: RecoveryAction): DiagnosticBuilder =
    match action {
        RecoveryNone => builder.push_str("RecoveryNone")
        RecoveryInsert(token) => append_parser_quoted(builder.push_str("RecoveryInsert("), token).push_str(")")
        RecoverySkipUntil(expected) =>
            append_recovery_expected_source(builder.push_str("RecoverySkipUntil("), expected).push_str(")")
    }

/// Append `recover(action, error)` for one alternative failure.
def append_recover_error_source(builder: DiagnosticBuilder, action: RecoveryAction): DiagnosticBuilder =
    append_recovery_action_source(builder.push_str("recover("), action).push_str(", error)")

/// Append one generated `Err(error)` branch with alternative recovery.
def append_recover_error_branch_source(builder: DiagnosticBuilder, action: RecoveryAction): DiagnosticBuilder =
    append_recover_error_source(builder.push_str("            Err(error) => Err("), action).push_str(")\n")

/// Return true when source starts with a fixed string at offset.
def parser_codegen_starts_with_at(source: String, offset: usize, needle: str, index: usize): bool =
    if index == needle.len() { true }
    else {
        let absolute = offset + index
        let same = source.byte_at(absolute) == needle.byte_at(index)
        if absolute >= source.len() { false }
        else {
            if same { parser_codegen_starts_with_at(source, offset, needle, index + 1) }
            else { false }
        }
    }

/// Append semantic action source, rewriting Pratt `$lhs` into an ordinary local.
def append_action_source(builder: DiagnosticBuilder, source: String, offset: usize): DiagnosticBuilder =
    if offset >= source.len() { builder }
    else if parser_codegen_starts_with_at(source, offset, "$lhs", 0) {
        append_action_source(builder.push_str("lhs"), source, offset + "$lhs".len())
    } else {
        let next = offset + 1
        append_action_source(builder.push_str(source.slice(offset, next - offset)), source, next)
    }

/// Append one lowered rule summary.
def append_rule_summary_with_pratt(base: DiagnosticBuilder, rule: LoweredRule): DiagnosticBuilder =
    match rule.pratt {
        Some(_) => base.push_str("/// pratt ").push_str(rule.name.text).push_str("\n")
        None => base
    }

/// Append one lowered rule summary.
def append_rule_summary(builder: DiagnosticBuilder, rule: LoweredRule): DiagnosticBuilder =
    append_rule_summary_with_pratt(
        builder
            .push_str("/// rule ")
            .push_str(rule.name.text)
            .push_str("\n"),
        rule)

/// Return true when a token atom is the generated epsilon marker.
def parser_atom_is_empty_token(name: str): bool = name == "Empty"

/// Append a token matcher call.
def append_token_parse_call(builder: DiagnosticBuilder, name: str, position_expr: str): DiagnosticBuilder =
    if parser_atom_is_empty_token(name) { builder.push_str("generated_match_empty(").push_str(position_expr).push_str(")") }
    else { append_parser_quoted(builder.push_str("generated_match_token(tokens, ").push_str(position_expr).push_str(", "), name).push_str(")") }

/// Append a rule parser call.
def append_rule_ref_parse_call(builder: DiagnosticBuilder, name: GrammarName, position_expr: str): DiagnosticBuilder =
    builder.push_str("parse_").push_str(name.text).push_str("(tokens, ").push_str(position_expr).push_str(")")

/// Append the call that consumes one grammar atom.
def append_atom_parse_call(builder: DiagnosticBuilder, atom: GrammarAtom, position_expr: str): DiagnosticBuilder =
    match atom {
        GrammarToken(name) => append_token_parse_call(builder, name, position_expr)
        GrammarRuleRef(name) => append_rule_ref_parse_call(builder, name, position_expr)
        GrammarBind(_, inner) => append_atom_parse_call(builder, inner, position_expr)
        GrammarOptional(inner) => append_atom_parse_call(builder, inner, position_expr)
        GrammarRepeatZeroOrMore(inner) => append_atom_parse_call(builder, inner, position_expr)
        GrammarRepeatOneOrMore(inner) => append_atom_parse_call(builder, inner, position_expr)
    }

/// Return the binding name for an atom when it has one.
def parser_atom_binding(atom: GrammarAtom): Option[str] =
    match atom {
        GrammarBind(name, _) => Some(name)
        _ => None
    }

/// Return the underlying atom after removing one binding wrapper.
def parser_atom_unbind(atom: GrammarAtom): GrammarAtom =
    match atom {
        GrammarBind(_, inner) => inner
        _ => atom
    }

/// Append one successful binding extraction.
def append_atom_binding(builder: DiagnosticBuilder, atom: GrammarAtom, step_name: str): DiagnosticBuilder =
    match parser_atom_binding(atom) {
        Some(name) => builder.push_str("            let ").push_str(name).push_str(" = ").push_str(step_name).push_str(".value\n")
        None => builder
    }

/// Append the generated name for a repeat consumer.
def append_repeat_consumer_name(builder: DiagnosticBuilder, prefix: str, step: usize): DiagnosticBuilder =
    builder.push_str(prefix).push_str("_repeat_").push_str(parser_codegen_usize(step))

/// Append one zero-or-more consumer function. It succeeds at the first position where the inner atom fails.
def append_repeat_consumer_function(builder: DiagnosticBuilder, prefix: str, step: usize, inner: GrammarAtom): DiagnosticBuilder =
    append_atom_parse_call(
        append_repeat_consumer_name(builder.push_str("def "), prefix, step)
            .push_str("(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[str], ParseFailure] =\n")
            .push_str("    match "),
        inner,
        "position")
        .push_str(r#" {\n"#)
        .push_str(r#"        Ok(next) => {\n"#)
        .push_str(r#"            if next.position.index == position.index { Ok(ParseCandidate[str] { value: "", position: position }) }
"#)
        .push_str(r#"            else { "#)
        .push_str(prefix)
        .push_str("_repeat_")
        .push_str(parser_codegen_usize(step))
        .push_str(r#"(tokens, next.position) }\n"#)
        .push_str(r#"        }\n"#)
        .push_str(r#"        Err(_) => Ok(ParseCandidate[str] { value: "", position: position })
"#)
        .push_str(r#"    }\n\n"#)

/// Append repeat consumers needed by one atom list.
def append_repeat_consumer_functions(builder: DiagnosticBuilder, prefix: str, atoms: List[GrammarAtom], step: usize): DiagnosticBuilder =
    match atoms {
        ListNil => builder
        ListCons(head, tail) => {
            let atom = parser_atom_unbind(head)
            match atom {
                GrammarRepeatZeroOrMore(inner) =>
                    append_repeat_consumer_functions(append_repeat_consumer_function(builder, prefix, step, inner), prefix, tail, step + 1)
                GrammarRepeatOneOrMore(inner) =>
                    append_repeat_consumer_functions(append_repeat_consumer_function(builder, prefix, step, inner), prefix, tail, step + 1)
                _ => append_repeat_consumer_functions(builder, prefix, tail, step + 1)
            }
        }
    }

/// Append recursive parse steps for one alternative.
def append_alt_steps(builder: DiagnosticBuilder, atoms: List[GrammarAtom], action: GrammarAction, recovery: RecoveryAction, step: usize, position_expr: str, repeat_prefix: str): DiagnosticBuilder =
    match atoms {
        ListNil =>
            append_action_source(
                builder
                    .push_str(r#"            Ok(ParseCandidate[AST] { value: "#),
                action.source,
                0)
                .push_str(", position: ")
                .push_str(position_expr)
                .push_str(r#" })\n"#)
        ListCons(head, tail) => {
            let atom = parser_atom_unbind(head)
            let step_name = "step".concat(parser_codegen_usize(step))
            match atom {
                GrammarOptional(inner) => {
                    let with_success = append_alt_steps(
                        append_atom_binding(
                            append_atom_parse_call(builder.push_str("        match "), inner, position_expr)
                                .push_str(r#" {\n"#)
                                .push_str("            Ok(")
                                .push_str(step_name)
                                .push_str(r#") => {\n"#)
                            head,
                            step_name),
                        tail,
                        action,
                        recovery,
                        step + 1,
                        step_name.concat(".position"),
                        repeat_prefix)
                        .push_str(r#"            }\n"#)
                        .push_str(r#"            Err(_) => {\n"#)
                    append_alt_steps(with_success, tail, action, recovery, step + 1, position_expr, repeat_prefix)
                        .push_str(r#"            }\n"#)
                        .push_str(r#"        }\n"#)
                }
                GrammarRepeatZeroOrMore(inner) =>
                    append_alt_steps(
                        append_repeat_consumer_name(builder.push_str("        match "), repeat_prefix, step)
                            .push_str("(tokens, ")
                            .push_str(position_expr)
                            .push_str(r#") {\n"#)
                            .push_str("            Ok(")
                            .push_str(step_name)
                            .push_str(r#") => {\n"#)
                        tail,
                        action,
                        recovery,
                        step + 1,
                        step_name.concat(".position"),
                        repeat_prefix)
                        .push_str(r#"            }\n"#)
                        .push_str("            Err(error) => Err(error)\n")
                        .push_str(r#"        }\n"#)
                GrammarRepeatOneOrMore(inner) =>
                    append_alt_steps(
                        append_repeat_consumer_name(
                            append_atom_parse_call(builder.push_str("        match "), inner, position_expr)
                                .push_str(r#" {\n"#)
                                .push_str("            Ok(")
                                .push_str(step_name)
                                .push_str(r#"_first) => {\n"#)
                                .push_str("                match "),
                            repeat_prefix,
                            step)
                            .push_str("(tokens, ")
                            .push_str(step_name)
                            .push_str(r#"_first.position) {\n"#)
                            .push_str("                    Ok(")
                            .push_str(step_name)
                            .push_str(r#") => {\n"#)
                        tail,
                        action,
                        recovery,
                        step + 1,
                        step_name.concat(".position"),
                        repeat_prefix)
                        .push_str(r#"                    }\n"#)
                        .push_str("                    Err(error) => Err(error)\n")
                        .push_str(r#"                }\n"#)
                        .push_str(r#"            }\n"#)
                        .push_str("            Err(error) => Err(error)\n")
                        .push_str(r#"        }\n"#)
                GrammarToken(name) =>
                    if parser_atom_is_empty_token(name) {
                        append_alt_steps(builder, tail, action, recovery, step + 1, position_expr, repeat_prefix)
                    } else {
                        let with_success = append_alt_steps(
                            append_atom_binding(
                                append_atom_parse_call(builder.push_str("        match "), atom, position_expr)
                                    .push_str(r#" {\n"#)
                                    .push_str("            Ok(")
                                    .push_str(step_name)
                                    .push_str(r#") => {\n"#)
                                head,
                                step_name),
                            tail,
                            action,
                            recovery,
                            step + 1,
                            step_name.concat(".position"),
                            repeat_prefix)
                            .push_str(r#"            }\n"#)
                        append_recover_error_branch_source(with_success, recovery)
                            .push_str(r#"        }\n"#)
                    }
                _ =>
                    {
                        let with_success = append_alt_steps(
                        append_atom_binding(
                            append_atom_parse_call(builder.push_str("        match "), atom, position_expr)
                                .push_str(r#" {\n"#)
                                .push_str("            Ok(")
                                .push_str(step_name)
                                .push_str(r#") => {\n"#)
                            head,
                            step_name),
                        tail,
                        action,
                        recovery,
                        step + 1,
                        step_name.concat(".position"),
                        repeat_prefix)
                        .push_str(r#"            }\n"#)
                        append_recover_error_branch_source(with_success, recovery)
                            .push_str(r#"        }\n"#)
                    }
            }
        }
    }

/// Append the call that consumes one Pratt infix atom, using right binding power for recursive RHS.
def append_pratt_infix_atom_parse_call(builder: DiagnosticBuilder, atom: GrammarAtom, position_expr: str, rule: LoweredRule, right_power: usize): DiagnosticBuilder =
    match atom {
        GrammarRuleRef(name) =>
            if name.text == rule.name.text {
                builder.push_str("parse_").push_str(rule.name.text).push_str("_bp(tokens, ").push_str(position_expr).push_str(", ").push_str(parser_codegen_usize(right_power)).push_str(")")
            } else { append_atom_parse_call(builder, atom, position_expr) }
        GrammarBind(_, inner) => append_pratt_infix_atom_parse_call(builder, inner, position_expr, rule, right_power)
        GrammarOptional(inner) => append_pratt_infix_atom_parse_call(builder, inner, position_expr, rule, right_power)
        GrammarRepeatZeroOrMore(inner) => append_pratt_infix_atom_parse_call(builder, inner, position_expr, rule, right_power)
        GrammarRepeatOneOrMore(inner) => append_pratt_infix_atom_parse_call(builder, inner, position_expr, rule, right_power)
        _ => append_atom_parse_call(builder, atom, position_expr)
    }

/// Append recursive parse steps for one Pratt infix arm.
def append_pratt_infix_steps(builder: DiagnosticBuilder, rule: LoweredRule, atoms: List[GrammarAtom], action: GrammarAction, step: usize, position_expr: str, right_power: usize, repeat_prefix: str): DiagnosticBuilder =
    match atoms {
        ListNil =>
            append_action_source(
                builder
                    .push_str(r#"            Ok(ParseCandidate[AST] { value: "#),
                action.source,
                0)
                .push_str(", position: ")
                .push_str(position_expr)
                .push_str(r#" })\n"#)
        ListCons(head, tail) => {
            let atom = parser_atom_unbind(head)
            let step_name = "step".concat(parser_codegen_usize(step))
            match atom {
                GrammarRepeatZeroOrMore(inner) =>
                    append_pratt_infix_steps(
                        append_repeat_consumer_name(builder.push_str("        match "), repeat_prefix, step)
                            .push_str("(tokens, ")
                            .push_str(position_expr)
                            .push_str(r#") {\n"#)
                            .push_str("            Ok(")
                            .push_str(step_name)
                            .push_str(r#") => {\n"#)
                        rule,
                        tail,
                        action,
                        step + 1,
                        step_name.concat(".position"),
                        right_power,
                        repeat_prefix)
                        .push_str(r#"            }\n"#)
                        .push_str("            Err(error) => Err(error)\n")
                        .push_str(r#"        }\n"#)
                GrammarRepeatOneOrMore(inner) =>
                    append_pratt_infix_steps(
                        append_repeat_consumer_name(
                            append_pratt_infix_atom_parse_call(builder.push_str("        match "), inner, position_expr, rule, right_power)
                                .push_str(r#" {\n"#)
                                .push_str("            Ok(")
                                .push_str(step_name)
                                .push_str(r#"_first) => {\n"#)
                                .push_str("                match "),
                            repeat_prefix,
                            step)
                            .push_str("(tokens, ")
                            .push_str(step_name)
                            .push_str(r#"_first.position) {\n"#)
                            .push_str("                    Ok(")
                            .push_str(step_name)
                            .push_str(r#") => {\n"#)
                        rule,
                        tail,
                        action,
                        step + 1,
                        step_name.concat(".position"),
                        right_power,
                        repeat_prefix)
                        .push_str(r#"                    }\n"#)
                        .push_str("                    Err(error) => Err(error)\n")
                        .push_str(r#"                }\n"#)
                        .push_str(r#"            }\n"#)
                        .push_str("            Err(error) => Err(error)\n")
                        .push_str(r#"        }\n"#)
                GrammarToken(name) =>
                    if parser_atom_is_empty_token(name) {
                        append_pratt_infix_steps(builder, rule, tail, action, step + 1, position_expr, right_power, repeat_prefix)
                    } else {
                        append_pratt_infix_steps(
                            append_atom_binding(
                                append_pratt_infix_atom_parse_call(builder.push_str("        match "), atom, position_expr, rule, right_power)
                                    .push_str(r#" {\n"#)
                                    .push_str("            Ok(")
                                    .push_str(step_name)
                                    .push_str(r#") => {\n"#)
                                head,
                                step_name),
                            rule,
                            tail,
                            action,
                            step + 1,
                            step_name.concat(".position"),
                            right_power,
                            repeat_prefix)
                            .push_str(r#"            }\n"#)
                            .push_str("            Err(error) => Err(error)\n")
                            .push_str(r#"        }\n"#)
                    }
                _ =>
                    append_pratt_infix_steps(
                        append_atom_binding(
                            append_pratt_infix_atom_parse_call(builder.push_str("        match "), atom, position_expr, rule, right_power)
                                .push_str(r#" {\n"#)
                                .push_str("            Ok(")
                                .push_str(step_name)
                                .push_str(r#") => {\n"#)
                            head,
                            step_name),
                        rule,
                        tail,
                        action,
                        step + 1,
                        step_name.concat(".position"),
                        right_power,
                        repeat_prefix)
                        .push_str(r#"            }\n"#)
                        .push_str("            Err(error) => Err(error)\n")
                        .push_str(r#"        }\n"#)
            }
        }
    }

/// Append one alternative parser.
def append_alternative_function(builder: DiagnosticBuilder, rule: LoweredRule, alt: LoweredAlternative): DiagnosticBuilder =
    append_alt_steps(
        append_repeat_consumer_functions(
            builder,
            "parse_".concat(rule.name.text).concat("_alt_").concat(parser_codegen_usize(alt.index)),
            alt.sequence.atoms,
            0)
            .push_str("def parse_")
            .push_str(rule.name.text)
            .push_str("_alt_")
            .push_str(parser_codegen_usize(alt.index))
            .push_str("(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] =\n"),
        alt.sequence.atoms,
        alt.action,
        alt.recovery,
        0,
        "position",
        "parse_".concat(rule.name.text).concat("_alt_").concat(parser_codegen_usize(alt.index)))
        .push_str("\n")

/// Append all alternative parser functions for one rule.
def append_alternative_functions(builder: DiagnosticBuilder, rule: LoweredRule, index: usize): DiagnosticBuilder =
    if index == rule.alternatives.len() { builder }
    else { append_alternative_functions(append_alternative_function(builder, rule, rule.alternatives.get(index)), rule, index + 1) }

/// Append alternative dispatch chain for one rule.
def append_rule_alt_dispatch(builder: DiagnosticBuilder, rule: LoweredRule, index: usize): DiagnosticBuilder =
    if index == rule.alternatives.len() {
        append_parser_quoted(builder.push_str("    Err(parse_failure(ListCons("), rule.name.text).push_str(", ListNil), position))\n")
    } else {
        let alt = rule.alternatives.get(index)
        append_rule_alt_dispatch(
            builder
                .push_str("    match parse_")
                .push_str(rule.name.text)
                .push_str("_alt_")
                .push_str(parser_codegen_usize(alt.index))
                .push_str(r#"(tokens, position) {\n"#)
                .push_str("        Ok(value) => Ok(value)\n")
                .push_str(r#"        Err(_) => {\n"#)
            rule,
            index + 1)
            .push_str(r#"        }\n"#)
            .push_str(r#"    }\n"#)
    }
}

/// Append one Pratt prefix parser function.
def append_pratt_prefix_function(builder: DiagnosticBuilder, rule: LoweredRule, arm: PrattPrefix, index: usize): DiagnosticBuilder =
    append_alt_steps(
        append_repeat_consumer_functions(
            builder,
            "parse_".concat(rule.name.text).concat("_prefix_").concat(parser_codegen_usize(index)),
            arm.sequence.atoms,
            0)
            .push_str("def parse_")
            .push_str(rule.name.text)
            .push_str("_prefix_")
            .push_str(parser_codegen_usize(index))
            .push_str("(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] =\n"),
        arm.sequence.atoms,
        arm.action,
        RecoveryNone,
        0,
        "position",
        "parse_".concat(rule.name.text).concat("_prefix_").concat(parser_codegen_usize(index)))
        .push_str("\n")

/// Append all Pratt prefix functions.
def append_pratt_prefix_functions(builder: DiagnosticBuilder, rule: LoweredRule, prefixes: Array[PrattPrefix], index: usize): DiagnosticBuilder =
    if index == prefixes.len() { builder }
    else { append_pratt_prefix_functions(append_pratt_prefix_function(builder, rule, prefixes.get(index), index), rule, prefixes, index + 1) }

/// Append one Pratt infix parser function.
def append_pratt_infix_function(builder: DiagnosticBuilder, rule: LoweredRule, arm: PrattInfix, index: usize): DiagnosticBuilder =
    append_pratt_infix_steps(
        append_repeat_consumer_functions(
            builder,
            "parse_".concat(rule.name.text).concat("_infix_").concat(parser_codegen_usize(index)),
            arm.sequence.atoms,
            0)
            .push_str("def parse_")
            .push_str(rule.name.text)
            .push_str("_infix_")
            .push_str(parser_codegen_usize(index))
            .push_str("(tokens: Array[TokenSpan], position: ParsePosition, lhs: AST): Result[ParseCandidate[AST], ParseFailure] =\n"),
        rule,
        arm.sequence.atoms,
        arm.action,
        0,
        "position",
        arm.right_power,
        "parse_".concat(rule.name.text).concat("_infix_").concat(parser_codegen_usize(index)))
        .push_str("\n")

/// Append all Pratt infix functions.
def append_pratt_infix_functions(builder: DiagnosticBuilder, rule: LoweredRule, infixes: Array[PrattInfix], index: usize): DiagnosticBuilder =
    if index == infixes.len() { builder }
    else { append_pratt_infix_functions(append_pratt_infix_function(builder, rule, infixes.get(index), index), rule, infixes, index + 1) }

/// Append prefix dispatch for a Pratt rule.
def append_pratt_prefix_dispatch(builder: DiagnosticBuilder, rule: LoweredRule, prefixes: Array[PrattPrefix], index: usize): DiagnosticBuilder =
    if index == prefixes.len() {
        append_parser_quoted(builder.push_str("    Err(parse_failure(ListCons("), rule.name.text).push_str(", ListNil), position))\n")
    } else {
        append_pratt_prefix_dispatch(
            builder
                .push_str("    match parse_")
                .push_str(rule.name.text)
                .push_str("_prefix_")
                .push_str(parser_codegen_usize(index))
                .push_str(r#"(tokens, position) {\n"#)
                .push_str("        Ok(value) => Ok(value)\n")
                .push_str(r#"        Err(_) => {\n"#)
            rule,
            prefixes,
            index + 1)
            .push_str(r#"        }\n"#)
            .push_str(r#"    }\n"#)
    }
}

/// Append infix dispatch for a Pratt rule.
def append_pratt_infix_dispatch(builder: DiagnosticBuilder, rule: LoweredRule, infixes: Array[PrattInfix], index: usize): DiagnosticBuilder =
    if index == infixes.len() {
        builder.push_str("    Ok(lhs)\n")
    } else {
        let arm = infixes.get(index)
        let with_try = builder
            .push_str("    if min_bp <= ")
            .push_str(parser_codegen_usize(arm.left_power))
            .push_str(r#" {\n"#)
            .push_str("        match parse_")
            .push_str(rule.name.text)
            .push_str("_infix_")
            .push_str(parser_codegen_usize(index))
            .push_str(r#"(tokens, lhs.position, lhs.value) {\n"#)
            .push_str("            Ok(next) => parse_")
            .push_str(rule.name.text)
            .push_str("_infix_loop(tokens, next, min_bp)\n")
            .push_str(r#"            Err(_) => {\n"#)
        let with_retry = append_pratt_infix_dispatch(with_try, rule, infixes, index + 1)
            .push_str(r#"            }\n"#)
            .push_str(r#"        }\n"#)
            .push_str(r#"    } else {\n"#)
        append_pratt_infix_dispatch(with_retry, rule, infixes, index + 1)
            .push_str(r#"    }\n"#)
    }
}

/// Append Pratt rule functions.
def append_pratt_rule_functions(builder: DiagnosticBuilder, rule: LoweredRule, table: PrattTable): DiagnosticBuilder = {
    let with_arms = append_pratt_infix_functions(
        append_pratt_prefix_functions(builder, rule, table.prefixes, 0),
        rule,
        table.infixes,
        0)
    let with_prefix = append_pratt_prefix_dispatch(
        with_arms
            .push_str("def parse_")
            .push_str(rule.name.text)
            .push_str("_prefix(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] =\n"),
        rule,
        table.prefixes,
        0)
    let with_loop = append_pratt_infix_dispatch(
        with_prefix
            .push_str("def parse_")
            .push_str(rule.name.text)
            .push_str("_infix_loop(tokens: Array[TokenSpan], lhs: ParseCandidate[AST], min_bp: usize): Result[ParseCandidate[AST], ParseFailure] =\n"),
        rule,
        table.infixes,
        0)
    with_loop
        .push_str("def parse_")
        .push_str(rule.name.text)
        .push_str("_bp(tokens: Array[TokenSpan], position: ParsePosition, min_bp: usize): Result[ParseCandidate[AST], ParseFailure] =\n")
        .push_str("    match parse_")
        .push_str(rule.name.text)
        .push_str(r#"_prefix(tokens, position) {\n"#)
        .push_str("        Ok(lhs) => parse_")
        .push_str(rule.name.text)
        .push_str("_infix_loop(tokens, lhs, min_bp)\n")
        .push_str("        Err(error) => Err(error)\n")
        .push_str(r#"    }\n"#)
        .push_str("def parse_")
        .push_str(rule.name.text)
        .push_str("(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] = parse_")
        .push_str(rule.name.text)
        .push_str("_bp(tokens, position, 0)\n")
}

/// Append one executable rule entry.
def append_rule_function(builder: DiagnosticBuilder, rule: LoweredRule): DiagnosticBuilder =
    match rule.pratt {
        Some(table) => append_pratt_rule_functions(builder, rule, table)
        None =>
            append_rule_alt_dispatch(
                append_alternative_functions(builder, rule, 0)
                    .push_str("def parse_")
                    .push_str(rule.name.text)
                    .push_str("(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] =\n"),
                rule,
                0)
    }

/// Append all lowered rule summaries in stable order.
def append_rule_summaries(rules: Array[LoweredRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else {
        let rule = rules.get(index)
        append_rule_summaries(rules, index + 1, append_rule_summary(builder, rule))
    }

/// Append parser rule functions in stable order.
def append_rule_functions(rules: Array[LoweredRule], index: usize, builder: DiagnosticBuilder): DiagnosticBuilder =
    if index == rules.len() { builder }
    else { append_rule_functions(rules, index + 1, append_rule_function(builder, rules.get(index))) }

/// Generate Chiba source for a lowered parser.
def generate_parser(parser: LoweredParser): GeneratedParser = {
    let builder0 = DiagnosticBuilder.new()
    let builder1 = append_parser_prelude(builder0, parser)
    let builder2 = append_rule_summaries(parser.rules, 0, builder1)
    let builder3 = append_rule_functions(parser.rules, 0, builder2
        .push_str("\n")
        .push_str(r#"def generated_match_empty(position: ParsePosition): Result[ParseCandidate[str], ParseFailure] = Ok(ParseCandidate[str] { value: "", position: position })
"#)
        .push_str("def generated_match_token(tokens: Array[TokenSpan], position: ParsePosition, expected: str): Result[ParseCandidate[str], ParseFailure] =\n")
        .push_str(r#"    if position.index >= tokens.len() { Err(parse_failure(ListCons(expected, ListNil), position)) }\n"#)
        .push_str(r#"    else {\n"#)
        .push_str("        let span = tokens.get(position.index)\n")
        .push_str(r#"        if span.token.generated_name() == expected { Ok(ParseCandidate[str] { value: span.token.generated_payload(), position: ParsePosition { index: position.index + 1 } }) }\n"#)
        .push_str(r#"        else { Err(parse_failure(ListCons(expected, ListNil), position)) }\n"#)
        .push_str(r#"    }\n\n"#))
    let builder4 = append_parser_entry(builder3.push_str("\n"), parser)
    let header = builder4.finish()
    GeneratedParser {
        source: header.concat(parser.ast_data),
        status: ParserCodegenComplete,
        diagnostic: "",
    }
}

/// Return the generated source text.
def generated_parser_text(parser: GeneratedParser): String = parser.source

/// Return true when codegen has produced executable parser source.
def generated_parser_complete(parser: GeneratedParser): bool =
    match parser.status {
        ParserCodegenComplete => true
        _ => false
    }
