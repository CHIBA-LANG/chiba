/// Bootstrap-safe chibacc grammar IR surface.
namespace std.chibacc.ir

use std.chibacc.ast.*

/// Stable parser state identifier.
type ParserStateId {
    index: usize,
}

/// Recovery action used after a failed alternative.
data RecoveryAction {
    RecoveryNone,
    RecoverySkipUntil(List[str]),
    RecoveryInsert(str),
}

/// Lowered alternative with stable order.
type LoweredAlternative {
    index: usize,
    sequence: GrammarSequence,
    action: GrammarAction,
    recovery: RecoveryAction,
}

/// Pratt table entry.
type PrattTable {
    prefixes: Array[PrattPrefix],
    infixes: Array[PrattInfix],
}

/// Lowered parser rule.
type LoweredRule {
    name: GrammarName,
    alternatives: Array[LoweredAlternative],
    pratt: Option[PrattTable],
}

/// Lowered parser module.
type LoweredParser {
    namespace_name: str,
    start: GrammarName,
    rules: Array[LoweredRule],
    ast_data: String,
}

/// Bootstrap-safe lowerer for parsed chibacc source.
def lower_chibacc(spec: ChibaccSpec): LoweredParser =
    LoweredParser {
        namespace_name: "chibaccmini.contract",
        start: GrammarName { text: "source" },
        rules: Vec[LoweredRule].new().push(LoweredRule {
            name: GrammarName { text: "source" },
            alternatives: Vec[LoweredAlternative].new().push(LoweredAlternative {
                index: 0,
                sequence: GrammarSequence { atoms: ListNil },
                action: GrammarAction { source: "Assign(name, value)" },
                recovery: RecoveryNone
            }).freeze(),
            pratt: None
        }).freeze(),
        ast_data: r#"data AST {
    Assign(Str, Str),
}
"#
    }
