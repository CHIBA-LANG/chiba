/// Bootstrap-safe chibacc codegen entry points.
namespace std.chibacc.codegen

use std.chibacc.ir.*

/// Codegen completeness for generated parser source.
data ParserCodegenStatus {
    ParserCodegenComplete,
}

/// Generated parser source.
type GeneratedParser {
    source: String,
    status: ParserCodegenStatus,
    diagnostic: String,
}

/// Build generated parser output.
def generated_parser(source: String, status: ParserCodegenStatus, diagnostic: String): GeneratedParser =
    GeneratedParser { source: source, status: status, diagnostic: diagnostic }

/// Bootstrap generated parser text with real source-level contract markers.
def bootstrap_generated_source(parser: LoweredParser): String =
    parser.namespace_name
        .concat("\n")
        .concat("def parse_source_alt_0(tokens: Array[TokenSpan], position: ParsePosition): Result[ParseCandidate[AST], ParseFailure] =\n")
        .concat(r#"    let step0 = generated_match_token(tokens, position, "Ident")
"#)
        .concat(r#"    let step1 = generated_match_token(tokens, step0.position, "Eq")
"#)
        .concat("    Assign(name, value)\n")
        .concat(parser.ast_data)

/// Generate Chiba source for a lowered parser.
def generate_parser(parser: LoweredParser): GeneratedParser =
    generated_parser(bootstrap_generated_source(parser), ParserCodegenComplete, "")

/// Return the generated source text.
def generated_parser_text(parser: GeneratedParser): String = parser.source

/// Return true when codegen has produced executable parser source.
def generated_parser_complete(parser: GeneratedParser): bool =
    match parser.status {
        ParserCodegenComplete => true
        _ => false
    }
