/// Token-driven parser contract for `.chibacc` grammar files.
namespace std.chibacc.parser

use std.chibacc.ast.*

/// Diagnostic produced while parsing `.chibacc`.
type ChibaccParseError {
    offset: usize,
    message: String,
}

/// Token kinds used by the hand-written `.chibacc` meta-parser.
data ChibaccTokenKind {
    CTkHashBangChibacc,
    CTkIdent(str),
    CTkInt(usize),
    CTkDefine,
    CTkFatArrow,
    CTkLBrace,
    CTkRBrace,
    CTkLParen,
    CTkRParen,
    CTkLBracket,
    CTkRBracket,
    CTkColon,
    CTkSemicolon,
    CTkComma,
    CTkPipe,
    CTkQuestion,
    CTkStar,
    CTkPlus,
    CTkBang,
    CTkAmp,
    CTkDot,
    CTkKwStart,
    CTkKwRule,
    CTkKwPratt,
    CTkKwPrefix,
    CTkKwInfix,
    CTkKwPostfix,
    CTkOther,
    CTkEof,
}

/// One token span in `.chibacc` source.
type ChibaccToken {
    kind: ChibaccTokenKind,
    lo: usize,
    hi: usize,
}

/// Parser state over a token stream.
type ChibaccParserState {
    source: str,
    tokens: Array[ChibaccToken],
    pos: usize,
}

/// Return a stable parser diagnostic.
def chibacc_parse_error(offset: usize, message: String): ChibaccParseError =
    ChibaccParseError { offset: offset, message: message }

/// Read one source byte.
def chibacc_byte_at(source: str, offset: usize): u8 =
    source.byte_at(offset)

/// Return byte length.
def chibacc_len(source: str): usize =
    source.len()

/// Return true when source is empty.
def chibacc_is_empty(source: str): bool =
    chibacc_len(source) == 0

/// Return true when one byte can start a grammar identifier.
def chibacc_ident_start(byte: u8): bool =
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte >= 128

/// Return true when one byte can continue a grammar identifier.
def chibacc_ident_continue(byte: u8): bool =
    chibacc_ident_start(byte) || (byte >= 48 && byte <= 57)

/// Return true when one byte is ASCII whitespace.
def chibacc_is_ws(byte: u8): bool =
    byte == 32 || byte == 9 || byte == 10 || byte == 13

/// Return true when one byte is ASCII decimal digit.
def chibacc_is_digit(byte: u8): bool =
    byte >= 48 && byte <= 57

/// Return true when a source byte equals the expected byte.
def chibacc_byte_eq(source: str, offset: usize, byte: u8): bool =
    chibacc_byte_at(source, offset) == byte

/// Return true when source byte at offset can continue an identifier.
def chibacc_ident_continue_at(source: str, offset: usize): bool =
    chibacc_ident_continue(chibacc_byte_at(source, offset))

/// Return true when offset is in range and points at one expected byte.
def chibacc_in_range_byte_eq(source: str, offset: usize, end: usize, byte: u8): bool =
    offset < end && chibacc_byte_eq(source, offset, byte)

/// Return true when offset + index is outside source.
def chibacc_offset_index_out_of_source(source: str, offset: usize, index: usize): bool =
    offset + index >= chibacc_len(source)

/// Return true when two source slices have the same byte at their offsets.
def chibacc_offset_byte_eq(left: str, left_offset: usize, right: str, right_offset: usize): bool =
    chibacc_byte_at(left, left_offset) == chibacc_byte_at(right, right_offset)

/// Return true when source starts with text at offset.
def chibacc_starts_with_at(source: str, offset: usize, text: str, index: usize): bool =
    if index == chibacc_len(text) { true }
    else if chibacc_offset_index_out_of_source(source, offset, index) { false }
    else if chibacc_offset_byte_eq(source, offset + index, text, index) { chibacc_starts_with_at(source, offset, text, index + 1) }
    else { false }

/// Find text or return end-of-source.
def chibacc_find_text(source: str, offset: usize, text: str): usize =
    if offset >= chibacc_len(source) { chibacc_len(source) }
    else if chibacc_starts_with_at(source, offset, text, 0) { offset }
    else { chibacc_find_text(source, offset + 1, text) }

/// Find text inside a bounded region or return that region end.
def chibacc_find_text_until(source: str, offset: usize, end: usize, text: str): usize =
    if offset >= end { end }
    else if chibacc_starts_with_at(source, offset, text, 0) { offset }
    else { chibacc_find_text_until(source, offset + 1, end, text) }

/// Find a byte or return end-of-source.
def chibacc_find_byte(source: str, offset: usize, byte: u8): usize =
    if offset >= chibacc_len(source) { chibacc_len(source) }
    else if chibacc_byte_eq(source, offset, byte) { offset }
    else { chibacc_find_byte(source, offset + 1, byte) }

/// Skip whitespace in chibacc source.
def chibacc_skip_ws(source: str, offset: usize): usize =
    if offset >= chibacc_len(source) { offset }
    else if chibacc_is_ws(chibacc_byte_at(source, offset)) { chibacc_skip_ws(source, offset + 1) }
    else { offset }

/// Trim trailing whitespace from a bounded region.
def chibacc_trim_right(source: str, start: usize, end: usize): usize =
    if end <= start { start }
    else {
        let byte = chibacc_byte_at(source, end - 1)
        if chibacc_is_ws(byte) { chibacc_trim_right(source, start, end - 1) }
        else { end }
    }

/// Slice a source region after trimming surrounding whitespace.
def chibacc_trimmed_slice(source: str, start: usize, end: usize): str = {
    let left = chibacc_skip_ws(source, start)
    let right = chibacc_trim_right(source, left, end)
    source.slice(left, right - left)
}

/// Scan one identifier.
def chibacc_scan_ident(source: str, offset: usize): usize =
    if offset >= chibacc_len(source) { offset }
    else if chibacc_ident_continue_at(source, offset) { chibacc_scan_ident(source, offset + 1) }
    else { offset }

/// Return true when an identifier should be treated as a token reference.
def chibacc_ident_is_token(name: str): bool =
    if chibacc_is_empty(name) { false }
    else {
        let byte = chibacc_byte_at(name, 0)
        byte >= 65 && byte <= 90
    }

/// Convert an identifier to a grammar atom.
def chibacc_atom_from_ident(name: str): GrammarAtom =
    if chibacc_ident_is_token(name) { GrammarToken(name) }
    else { GrammarRuleRef(GrammarName { text: name }) }

/// Parse namespace declaration from a captured header block.
def chibacc_parse_namespace(source: str): str = {
    let start = chibacc_find_text(source, 0, "namespace")
    if start >= chibacc_len(source) { "" }
    else {
        let name_start = chibacc_skip_ws(source, start + "namespace".len())
        let name_end = chibacc_find_byte(source, name_start, 10)
        source.slice(name_start, name_end - name_start)
    }
}

/// Token constructor helper.
def chibacc_token(kind: ChibaccTokenKind, lo: usize, hi: usize): ChibaccToken =
    ChibaccToken { kind: kind, lo: lo, hi: hi }

/// Append a token and continue lexing.
def chibacc_lex_push(source: str, next: usize, out: Vec[ChibaccToken], kind: ChibaccTokenKind, lo: usize, hi: usize): Array[ChibaccToken] =
    chibacc_lex_loop(source, next, out.push(chibacc_token(kind, lo, hi)))

/// Skip one line comment.
def chibacc_skip_line_comment(source: str, offset: usize): usize =
    if offset >= chibacc_len(source) { offset }
    else if chibacc_byte_at(source, offset) == 10 { offset }
    else { chibacc_skip_line_comment(source, offset + 1) }

/// Scan decimal digits.
def chibacc_scan_digits(source: str, offset: usize): usize =
    if offset >= chibacc_len(source) { offset }
    else if chibacc_is_digit(chibacc_byte_at(source, offset)) { chibacc_scan_digits(source, offset + 1) }
    else { offset }

/// Parse decimal digits into a usize.
def chibacc_parse_usize_digits(source: str, offset: usize, end: usize, value: usize): usize =
    if offset >= end { value }
    else {
        let byte = chibacc_byte_at(source, offset)
        if chibacc_is_digit(byte) { chibacc_parse_usize_digits(source, offset + 1, end, value * 10 + (byte - 48)) }
        else { value }
    }

/// Scan a quoted string as one token so braces inside strings do not affect balancing.
def chibacc_scan_string(source: str, offset: usize): usize =
    if offset >= chibacc_len(source) { offset }
    else {
        let byte = chibacc_byte_at(source, offset)
        if byte == 34 { offset + 1 }
        else if byte == 92 && offset + 1 < chibacc_len(source) { chibacc_scan_string(source, offset + 2) }
        else { chibacc_scan_string(source, offset + 1) }
    }

/// Classify an identifier token.
def chibacc_keyword_or_ident(text: str): ChibaccTokenKind =
    if text == "start" { CTkKwStart }
    else if text == "rule" { CTkKwRule }
    else if text == "pratt" { CTkKwPratt }
    else if text == "prefix" { CTkKwPrefix }
    else if text == "infix" { CTkKwInfix }
    else if text == "postfix" { CTkKwPostfix }
    else { CTkIdent(text) }

/// Lex `.chibacc` source into a token stream.
def chibacc_lex_loop(source: str, offset: usize, out: Vec[ChibaccToken]): Array[ChibaccToken] =
    if offset >= chibacc_len(source) { out.push(chibacc_token(CTkEof, chibacc_len(source), chibacc_len(source))).freeze() }
    else {
        let byte = chibacc_byte_at(source, offset)
        if chibacc_is_ws(byte) { chibacc_lex_loop(source, offset + 1, out) }
        else if byte == 47 && offset + 1 < chibacc_len(source) && chibacc_byte_at(source, offset + 1) == 47 {
            chibacc_lex_loop(source, chibacc_skip_line_comment(source, offset + 2), out)
        } else if chibacc_starts_with_at(source, offset, "#![CHIBACC]", 0) {
            chibacc_lex_push(source, offset + "#![CHIBACC]".len(), out, CTkHashBangChibacc, offset, offset + "#![CHIBACC]".len())
        } else if chibacc_ident_start(byte) {
            let end = chibacc_scan_ident(source, offset + 1)
            chibacc_lex_push(source, end, out, chibacc_keyword_or_ident(source.slice(offset, end - offset)), offset, end)
        } else if chibacc_is_digit(byte) {
            let end = chibacc_scan_digits(source, offset + 1)
            chibacc_lex_push(source, end, out, CTkInt(chibacc_parse_usize_digits(source, offset, end, 0)), offset, end)
        } else if byte == 34 {
            let end = chibacc_scan_string(source, offset + 1)
            chibacc_lex_push(source, end, out, CTkOther, offset, end)
        } else if byte == 58 && offset + 2 < chibacc_len(source) && chibacc_byte_at(source, offset + 1) == 58 && chibacc_byte_at(source, offset + 2) == 61 {
            chibacc_lex_push(source, offset + 3, out, CTkDefine, offset, offset + 3)
        } else if byte == 61 && offset + 1 < chibacc_len(source) && chibacc_byte_at(source, offset + 1) == 62 {
            chibacc_lex_push(source, offset + 2, out, CTkFatArrow, offset, offset + 2)
        } else {
            let kind =
                if byte == 123 { CTkLBrace }
                else if byte == 125 { CTkRBrace }
                else if byte == 40 { CTkLParen }
                else if byte == 41 { CTkRParen }
                else if byte == 91 { CTkLBracket }
                else if byte == 93 { CTkRBracket }
                else if byte == 58 { CTkColon }
                else if byte == 59 { CTkSemicolon }
                else if byte == 44 { CTkComma }
                else if byte == 124 { CTkPipe }
                else if byte == 63 { CTkQuestion }
                else if byte == 42 { CTkStar }
                else if byte == 43 { CTkPlus }
                else if byte == 33 { CTkBang }
                else if byte == 38 { CTkAmp }
                else if byte == 46 { CTkDot }
                else { CTkOther }
            chibacc_lex_push(source, offset + 1, out, kind, offset, offset + 1)
        }
    }

/// Lex `.chibacc` source.
def chibacc_lex(source: str): Array[ChibaccToken] =
    chibacc_lex_loop(source, 0, Vec[ChibaccToken].new())

/// Build parser state.
def chibacc_ps_new(source: str): ChibaccParserState =
    ChibaccParserState { source: source, tokens: chibacc_lex(source), pos: 0 }

/// Advance parser state by one token.
def chibacc_ps_adv(ps: ChibaccParserState): ChibaccParserState =
    ChibaccParserState { source: ps.source, tokens: ps.tokens, pos: ps.pos + 1 }

/// Set parser position.
def chibacc_ps_set_pos(ps: ChibaccParserState, pos: usize): ChibaccParserState =
    ChibaccParserState { source: ps.source, tokens: ps.tokens, pos: pos }

/// Current token.
def chibacc_ps_cur(ps: ChibaccParserState): ChibaccToken =
    if ps.pos < ps.tokens.len() { ps.tokens.get(ps.pos) }
    else { ps.tokens.get(ps.tokens.len() - 1) }

/// Peek token at offset.
def chibacc_ps_peek(ps: ChibaccParserState, offset: usize): ChibaccToken =
    if ps.pos + offset < ps.tokens.len() { ps.tokens.get(ps.pos + offset) }
    else { ps.tokens.get(ps.tokens.len() - 1) }

/// Return token source text.
def chibacc_token_text(ps: ChibaccParserState, tok: ChibaccToken): str =
    ps.source.slice(tok.lo, tok.hi - tok.lo)

/// Return true for `{`.
def chibacc_tok_is_lbrace(tok: ChibaccToken): bool = match tok.kind { CTkLBrace => true _ => false }
/// Return true for `}`.
def chibacc_tok_is_rbrace(tok: ChibaccToken): bool = match tok.kind { CTkRBrace => true _ => false }
/// Return true for `(`.
def chibacc_tok_is_lparen(tok: ChibaccToken): bool = match tok.kind { CTkLParen => true _ => false }
/// Return true for `)`.
def chibacc_tok_is_rparen(tok: ChibaccToken): bool = match tok.kind { CTkRParen => true _ => false }
/// Return true for `[`.
def chibacc_tok_is_lbracket(tok: ChibaccToken): bool = match tok.kind { CTkLBracket => true _ => false }
/// Return true for `]`.
def chibacc_tok_is_rbracket(tok: ChibaccToken): bool = match tok.kind { CTkRBracket => true _ => false }
/// Return true for `|`.
def chibacc_tok_is_pipe(tok: ChibaccToken): bool = match tok.kind { CTkPipe => true _ => false }
/// Return true for `?`.
def chibacc_tok_is_question(tok: ChibaccToken): bool = match tok.kind { CTkQuestion => true _ => false }
/// Return true for `*`.
def chibacc_tok_is_star(tok: ChibaccToken): bool = match tok.kind { CTkStar => true _ => false }
/// Return true for `+`.
def chibacc_tok_is_plus(tok: ChibaccToken): bool = match tok.kind { CTkPlus => true _ => false }
/// Return true for `:`.
def chibacc_tok_is_colon(tok: ChibaccToken): bool = match tok.kind { CTkColon => true _ => false }
/// Return true for `;`.
def chibacc_tok_is_semicolon(tok: ChibaccToken): bool = match tok.kind { CTkSemicolon => true _ => false }
/// Return true for `,`.
def chibacc_tok_is_comma(tok: ChibaccToken): bool = match tok.kind { CTkComma => true _ => false }
/// Return true for `=>`.
def chibacc_tok_is_fatarrow(tok: ChibaccToken): bool = match tok.kind { CTkFatArrow => true _ => false }
/// Return true for `::=`.
def chibacc_tok_is_define(tok: ChibaccToken): bool = match tok.kind { CTkDefine => true _ => false }
/// Return true for `start`.
def chibacc_tok_is_kw_start(tok: ChibaccToken): bool = match tok.kind { CTkKwStart => true _ => false }
/// Return true for `rule`.
def chibacc_tok_is_kw_rule(tok: ChibaccToken): bool = match tok.kind { CTkKwRule => true _ => false }
/// Return true for `pratt`.
def chibacc_tok_is_kw_pratt(tok: ChibaccToken): bool = match tok.kind { CTkKwPratt => true _ => false }
/// Return true for `prefix`.
def chibacc_tok_is_kw_prefix(tok: ChibaccToken): bool = match tok.kind { CTkKwPrefix => true _ => false }
/// Return true for `infix`.
def chibacc_tok_is_kw_infix(tok: ChibaccToken): bool = match tok.kind { CTkKwInfix => true _ => false }
/// Return true for `postfix`.
def chibacc_tok_is_kw_postfix(tok: ChibaccToken): bool = match tok.kind { CTkKwPostfix => true _ => false }
/// Return true for end of file.
def chibacc_tok_is_eof(tok: ChibaccToken): bool = match tok.kind { CTkEof => true _ => false }

/// Return identifier text if token is an identifier.
def chibacc_token_ident(tok: ChibaccToken): Option[str] =
    match tok.kind {
        CTkIdent(name) => Some(name)
        _ => None
    }

/// Return integer payload if token is an integer.
def chibacc_token_int(tok: ChibaccToken): Option[usize] =
    match tok.kind {
        CTkInt(value) => Some(value)
        _ => None
    }

/// Append one atom to a list while preserving order.
def chibacc_atom_list_append(items: List[GrammarAtom], value: GrammarAtom): List[GrammarAtom] =
    match items {
        ListNil => ListCons(value, ListNil)
        ListCons(head, tail) => ListCons(head, chibacc_atom_list_append(tail, value))
    }

/// Append one alternative to a list while preserving order.
def chibacc_alt_list_append(items: List[GrammarAlternative], value: GrammarAlternative): List[GrammarAlternative] =
    match items {
        ListNil => ListCons(value, ListNil)
        ListCons(head, tail) => ListCons(head, chibacc_alt_list_append(tail, value))
    }

/// Append one rule to a list while preserving order.
def chibacc_rule_list_append(items: List[GrammarRule], value: GrammarRule): List[GrammarRule] =
    match items {
        ListNil => ListCons(value, ListNil)
        ListCons(head, tail) => ListCons(head, chibacc_rule_list_append(tail, value))
    }

/// Append one Pratt prefix to a list while preserving order.
def chibacc_prefix_list_append(items: List[PrattPrefix], value: PrattPrefix): List[PrattPrefix] =
    match items {
        ListNil => ListCons(value, ListNil)
        ListCons(head, tail) => ListCons(head, chibacc_prefix_list_append(tail, value))
    }

/// Append one Pratt infix to a list while preserving order.
def chibacc_infix_list_append(items: List[PrattInfix], value: PrattInfix): List[PrattInfix] =
    match items {
        ListNil => ListCons(value, ListNil)
        ListCons(head, tail) => ListCons(head, chibacc_infix_list_append(tail, value))
    }

/// Skip optional hashbang.
def chibacc_skip_hashbang(ps: ChibaccParserState): ChibaccParserState =
    match chibacc_ps_cur(ps).kind {
        CTkHashBangChibacc => chibacc_ps_adv(ps)
        _ => ps
    }

/// Find a matching delimiter token.
def chibacc_find_matching(ps: ChibaccParserState, pos: usize, depth: usize, open_kind: usize): usize = {
    let tok = ps.tokens.get(pos)
    let is_open =
        if open_kind == 0 { chibacc_tok_is_lbrace(tok) }
        else if open_kind == 1 { chibacc_tok_is_lparen(tok) }
        else { chibacc_tok_is_lbracket(tok) }
    let is_close =
        if open_kind == 0 { chibacc_tok_is_rbrace(tok) }
        else if open_kind == 1 { chibacc_tok_is_rparen(tok) }
        else { chibacc_tok_is_rbracket(tok) }
    if is_open { chibacc_find_matching(ps, pos + 1, depth + 1, open_kind) }
    else if is_close {
        if depth == 1 { pos }
        else { chibacc_find_matching(ps, pos + 1, depth - 1, open_kind) }
    } else { chibacc_find_matching(ps, pos + 1, depth, open_kind) }
}

/// Capture raw source inside a balanced delimiter pair.
def chibacc_capture_balanced_raw(ps: ChibaccParserState, open_kind: usize): (str, ChibaccParserState, bool) = {
    let open_tok = chibacc_ps_cur(ps)
    let close_pos = chibacc_find_matching(ps, ps.pos + 1, 1, open_kind)
    let close_tok = ps.tokens.get(close_pos)
    (ps.source.slice(open_tok.hi, close_tok.lo - open_tok.hi), chibacc_ps_set_pos(ps, close_pos + 1), true)
}

/// Parse a grammar identifier.
def chibacc_expect_ident(ps: ChibaccParserState): (str, ChibaccParserState, bool) =
    match chibacc_token_ident(chibacc_ps_cur(ps)) {
        Some(name) => (name, chibacc_ps_adv(ps), true)
        None => ("", ps, false)
    }

/// Parse an integer token.
def chibacc_expect_int(ps: ChibaccParserState): (usize, ChibaccParserState, bool) =
    match chibacc_token_int(chibacc_ps_cur(ps)) {
        Some(value) => (value, chibacc_ps_adv(ps), true)
        None => (0, ps, false)
    }

/// Return true when an alternative sequence must stop before current token.
def chibacc_alt_stop(tok: ChibaccToken, close_kind: usize): bool =
    if chibacc_tok_is_fatarrow(tok) { true }
    else if chibacc_tok_is_pipe(tok) { true }
    else if chibacc_tok_is_semicolon(tok) { true }
    else if close_kind == 1 && chibacc_tok_is_rparen(tok) { true }
    else if close_kind == 2 && chibacc_tok_is_rbracket(tok) { true }
    else if close_kind == 3 && chibacc_tok_is_rbrace(tok) { true }
    else { false }

/// Parse quantifier suffix.
def chibacc_parse_quantifier(ps: ChibaccParserState, atom: GrammarAtom): (GrammarAtom, ChibaccParserState) =
    if chibacc_tok_is_question(chibacc_ps_cur(ps)) { (GrammarOptional(atom), chibacc_ps_adv(ps)) }
    else if chibacc_tok_is_star(chibacc_ps_cur(ps)) { (GrammarRepeatZeroOrMore(atom), chibacc_ps_adv(ps)) }
    else if chibacc_tok_is_plus(chibacc_ps_cur(ps)) { (GrammarRepeatOneOrMore(atom), chibacc_ps_adv(ps)) }
    else { (atom, ps) }

/// Parse one sequence atom.
def chibacc_parse_seq_atom(ps: ChibaccParserState): (GrammarAtom, ChibaccParserState, bool) =
    match chibacc_token_ident(chibacc_ps_cur(ps)) {
        Some(name) => {
            let (atom, ps1) = chibacc_parse_quantifier(chibacc_ps_adv(ps), chibacc_atom_from_ident(name))
            (atom, ps1, true)
        }
        None => (GrammarToken(""), ps, false)
    }

/// Parse one labelled or unlabelled sequence item.
def chibacc_parse_seq_item(ps: ChibaccParserState): (GrammarAtom, ChibaccParserState, bool) =
    match chibacc_token_ident(chibacc_ps_cur(ps)) {
        Some(label_or_name) => {
            if chibacc_tok_is_colon(chibacc_ps_peek(ps, 1)) {
                let (inner, ps1, ok) = chibacc_parse_seq_atom(chibacc_ps_adv(chibacc_ps_adv(ps)))
                if ok { (GrammarBind(label_or_name, inner), ps1, true) }
                else { (GrammarToken(""), ps, false) }
            } else { chibacc_parse_seq_atom(ps) }
        }
        None => (GrammarToken(""), ps, false)
    }

/// Parse sequence atoms.
def chibacc_parse_seq_items(ps: ChibaccParserState, close_kind: usize, out: List[GrammarAtom]): (List[GrammarAtom], ChibaccParserState) =
    if chibacc_alt_stop(chibacc_ps_cur(ps), close_kind) { (out, ps) }
    else {
        let (atom, ps1, ok) = chibacc_parse_seq_item(ps)
        if ok { chibacc_parse_seq_items(ps1, close_kind, chibacc_atom_list_append(out, atom)) }
        else { (out, ps) }
    }

/// Capture semantic action source until the next top-level separator.
def chibacc_capture_action_until(ps: ChibaccParserState, close_kind: usize, paren_depth: usize, brace_depth: usize, bracket_depth: usize, start_lo: usize): (GrammarAction, ChibaccParserState) = {
    let tok = chibacc_ps_cur(ps)
    let stop =
        if paren_depth > 0 || brace_depth > 0 || bracket_depth > 0 { false }
        else if chibacc_tok_is_pipe(tok) { true }
        else if chibacc_tok_is_semicolon(tok) { true }
        else if close_kind == 3 && chibacc_tok_is_rbrace(tok) { true }
        else { false }
    if stop {
        (GrammarAction { source: chibacc_trimmed_slice(ps.source, start_lo, tok.lo) }, ps)
    } else {
        let next_paren =
            if chibacc_tok_is_lparen(tok) { paren_depth + 1 }
            else if chibacc_tok_is_rparen(tok) && paren_depth > 0 { paren_depth - 1 }
            else { paren_depth }
        let next_brace =
            if chibacc_tok_is_lbrace(tok) { brace_depth + 1 }
            else if chibacc_tok_is_rbrace(tok) && brace_depth > 0 { brace_depth - 1 }
            else { brace_depth }
        let next_bracket =
            if chibacc_tok_is_lbracket(tok) { bracket_depth + 1 }
            else if chibacc_tok_is_rbracket(tok) && bracket_depth > 0 { bracket_depth - 1 }
            else { bracket_depth }
        chibacc_capture_action_until(chibacc_ps_adv(ps), close_kind, next_paren, next_brace, next_bracket, start_lo)
    }
}

/// Parse one alternative.
def chibacc_parse_alt(ps: ChibaccParserState, close_kind: usize): (GrammarAlternative, ChibaccParserState, bool) = {
    let (items, ps1) = chibacc_parse_seq_items(ps, close_kind, ListNil)
    if chibacc_tok_is_fatarrow(chibacc_ps_cur(ps1)) {
        let ps2 = chibacc_ps_adv(ps1)
        let (action, ps3) = chibacc_capture_action_until(ps2, close_kind, 0, 0, 0, chibacc_ps_cur(ps2).lo)
        (GrammarAlternative { sequence: GrammarSequence { atoms: items }, action: action }, ps3, true)
    } else {
        (GrammarAlternative { sequence: GrammarSequence { atoms: items }, action: GrammarAction { source: "" } }, ps1, true)
    }
}

/// Parse an alternative list.
def chibacc_parse_alt_list_loop(ps: ChibaccParserState, close_kind: usize, out: List[GrammarAlternative]): (List[GrammarAlternative], ChibaccParserState, bool) = {
    let (alt, ps1, ok) = chibacc_parse_alt(ps, close_kind)
    if ok == false { (out, ps, false) }
    else {
        let next_out = chibacc_alt_list_append(out, alt)
        if chibacc_tok_is_pipe(chibacc_ps_cur(ps1)) { chibacc_parse_alt_list_loop(chibacc_ps_adv(ps1), close_kind, next_out) }
        else { (next_out, ps1, true) }
    }
}

/// Parse an alternative list.
def chibacc_parse_alt_list(ps: ChibaccParserState, close_kind: usize): (List[GrammarAlternative], ChibaccParserState, bool) =
    chibacc_parse_alt_list_loop(ps, close_kind, ListNil)

/// Parse one Pratt prefix arm.
def chibacc_parse_pratt_prefix_arm(ps: ChibaccParserState, power: usize): (PrattPrefix, ChibaccParserState, bool) = {
    let (alt, ps1, ok) = chibacc_parse_alt(ps, 3)
    let ps2 = if chibacc_tok_is_semicolon(chibacc_ps_cur(ps1)) { chibacc_ps_adv(ps1) } else { ps1 }
    if ok { (PrattPrefix { binding_power: power, sequence: alt.sequence, action: alt.action }, ps2, true) }
    else { (PrattPrefix { binding_power: power, sequence: GrammarSequence { atoms: ListNil }, action: GrammarAction { source: "" } }, ps, false) }
}

/// Parse Pratt prefix arms until `}`.
def chibacc_parse_pratt_prefix_arms(ps: ChibaccParserState, power: usize, out: List[PrattPrefix]): (List[PrattPrefix], ChibaccParserState, bool) =
    if chibacc_tok_is_rbrace(chibacc_ps_cur(ps)) { (out, ps, true) }
    else {
        let (arm, ps1, ok) = chibacc_parse_pratt_prefix_arm(ps, power)
        if ok { chibacc_parse_pratt_prefix_arms(ps1, power, chibacc_prefix_list_append(out, arm)) }
        else { (out, ps, false) }
    }

/// Parse one Pratt infix arm.
def chibacc_parse_pratt_infix_arm(ps: ChibaccParserState, left_power: usize, right_power: usize): (PrattInfix, ChibaccParserState, bool) = {
    let (alt, ps1, ok) = chibacc_parse_alt(ps, 3)
    let ps2 = if chibacc_tok_is_semicolon(chibacc_ps_cur(ps1)) { chibacc_ps_adv(ps1) } else { ps1 }
    if ok { (PrattInfix { left_power: left_power, right_power: right_power, sequence: alt.sequence, action: alt.action }, ps2, true) }
    else { (PrattInfix { left_power: left_power, right_power: right_power, sequence: GrammarSequence { atoms: ListNil }, action: GrammarAction { source: "" } }, ps, false) }
}

/// Parse Pratt infix arms until `}`.
def chibacc_parse_pratt_infix_arms(ps: ChibaccParserState, left_power: usize, right_power: usize, out: List[PrattInfix]): (List[PrattInfix], ChibaccParserState, bool) =
    if chibacc_tok_is_rbrace(chibacc_ps_cur(ps)) { (out, ps, true) }
    else {
        let (arm, ps1, ok) = chibacc_parse_pratt_infix_arm(ps, left_power, right_power)
        if ok { chibacc_parse_pratt_infix_arms(ps1, left_power, right_power, chibacc_infix_list_append(out, arm)) }
        else { (out, ps, false) }
    }

/// Parse one `prefix(bp) { ... }` block.
def chibacc_parse_prefix_block(ps: ChibaccParserState, prefixes: List[PrattPrefix]): (List[PrattPrefix], ChibaccParserState, bool) = {
    let ps1 = chibacc_ps_adv(ps)
    if chibacc_tok_is_lparen(chibacc_ps_cur(ps1)) == false { (prefixes, ps, false) }
    else {
        let (power, ps2, ok_power) = chibacc_expect_int(chibacc_ps_adv(ps1))
        if ok_power == false || chibacc_tok_is_rparen(chibacc_ps_cur(ps2)) == false || chibacc_tok_is_lbrace(chibacc_ps_cur(chibacc_ps_adv(ps2))) == false { (prefixes, ps, false) }
        else {
            let (arms, ps3, ok_arms) = chibacc_parse_pratt_prefix_arms(chibacc_ps_adv(chibacc_ps_adv(ps2)), power, prefixes)
            if ok_arms && chibacc_tok_is_rbrace(chibacc_ps_cur(ps3)) { (arms, chibacc_ps_adv(ps3), true) }
            else { (prefixes, ps, false) }
        }
    }
}

/// Parse one `infix(lp, rp) { ... }` block.
def chibacc_parse_infix_block(ps: ChibaccParserState, infixes: List[PrattInfix]): (List[PrattInfix], ChibaccParserState, bool) = {
    let ps1 = chibacc_ps_adv(ps)
    if chibacc_tok_is_lparen(chibacc_ps_cur(ps1)) == false { (infixes, ps, false) }
    else {
        let (left_power, ps2, ok_left) = chibacc_expect_int(chibacc_ps_adv(ps1))
        if ok_left == false || chibacc_tok_is_comma(chibacc_ps_cur(ps2)) == false { (infixes, ps, false) }
        else {
            let (right_power, ps3, ok_right) = chibacc_expect_int(chibacc_ps_adv(ps2))
            if ok_right == false || chibacc_tok_is_rparen(chibacc_ps_cur(ps3)) == false || chibacc_tok_is_lbrace(chibacc_ps_cur(chibacc_ps_adv(ps3))) == false { (infixes, ps, false) }
            else {
                let (arms, ps4, ok_arms) = chibacc_parse_pratt_infix_arms(chibacc_ps_adv(chibacc_ps_adv(ps3)), left_power, right_power, infixes)
                if ok_arms && chibacc_tok_is_rbrace(chibacc_ps_cur(ps4)) { (arms, chibacc_ps_adv(ps4), true) }
                else { (infixes, ps, false) }
            }
        }
    }
}

/// Parse Pratt blocks.
def chibacc_parse_pratt_blocks(ps: ChibaccParserState, prefixes: List[PrattPrefix], infixes: List[PrattInfix]): (GrammarRuleBody, ChibaccParserState, bool) =
    if chibacc_tok_is_rbrace(chibacc_ps_cur(ps)) { (GrammarPratt(prefixes, infixes), chibacc_ps_adv(ps), true) }
    else if chibacc_tok_is_kw_prefix(chibacc_ps_cur(ps)) {
        let (next_prefixes, ps1, ok) = chibacc_parse_prefix_block(ps, prefixes)
        if ok { chibacc_parse_pratt_blocks(ps1, next_prefixes, infixes) }
        else { (GrammarPratt(prefixes, infixes), ps, false) }
    } else if chibacc_tok_is_kw_infix(chibacc_ps_cur(ps)) {
        let (next_infixes, ps1, ok) = chibacc_parse_infix_block(ps, infixes)
        if ok { chibacc_parse_pratt_blocks(ps1, prefixes, next_infixes) }
        else { (GrammarPratt(prefixes, infixes), ps, false) }
    } else if chibacc_tok_is_kw_postfix(chibacc_ps_cur(ps)) {
        (GrammarPratt(prefixes, infixes), ps, false)
    } else { (GrammarPratt(prefixes, infixes), ps, false) }

/// Parse a Pratt rule body after the `pratt` token.
def chibacc_parse_pratt_rule(ps: ChibaccParserState): (GrammarRuleBody, ChibaccParserState, bool) =
    if chibacc_tok_is_lbrace(chibacc_ps_cur(chibacc_ps_adv(ps))) == false { (GrammarAlternatives(ListNil), ps, false) }
    else { chibacc_parse_pratt_blocks(chibacc_ps_adv(chibacc_ps_adv(ps)), ListNil, ListNil) }

/// Parse one rule body.
def chibacc_parse_rule_body_tokens(ps: ChibaccParserState): (GrammarRuleBody, ChibaccParserState, bool) =
    if chibacc_tok_is_kw_pratt(chibacc_ps_cur(ps)) { chibacc_parse_pratt_rule(ps) }
    else {
        let (alts, ps1, ok) = chibacc_parse_alt_list(ps, 0)
        if ok { (GrammarAlternatives(alts), ps1, true) }
        else { (GrammarAlternatives(ListNil), ps, false) }
    }

/// Parse one rule definition.
def chibacc_parse_rule_def(ps: ChibaccParserState): (GrammarRule, ChibaccParserState, bool) =
    if chibacc_tok_is_kw_rule(chibacc_ps_cur(ps)) == false { (GrammarRule { name: GrammarName { text: "" }, body: GrammarAlternatives(ListNil) }, ps, false) }
    else {
        let (name, ps1, ok_name) = chibacc_expect_ident(chibacc_ps_adv(ps))
        if ok_name == false || chibacc_tok_is_define(chibacc_ps_cur(ps1)) == false { (GrammarRule { name: GrammarName { text: "" }, body: GrammarAlternatives(ListNil) }, ps, false) }
        else {
            let (body, ps2, ok_body) = chibacc_parse_rule_body_tokens(chibacc_ps_adv(ps1))
            if ok_body == false || chibacc_tok_is_semicolon(chibacc_ps_cur(ps2)) == false { (GrammarRule { name: GrammarName { text: "" }, body: GrammarAlternatives(ListNil) }, ps, false) }
            else { (GrammarRule { name: GrammarName { text: name }, body: body }, chibacc_ps_adv(ps2), true) }
        }
    }

/// Parse all rule definitions.
def chibacc_parse_rules_tokens(ps: ChibaccParserState, out: List[GrammarRule]): (List[GrammarRule], ChibaccParserState, bool) =
    if chibacc_tok_is_kw_rule(chibacc_ps_cur(ps)) {
        let (rule, ps1, ok) = chibacc_parse_rule_def(ps)
        if ok { chibacc_parse_rules_tokens(ps1, chibacc_rule_list_append(out, rule)) }
        else { (out, ps, false) }
    } else { (out, ps, true) }

/// Parse optional header block.
def chibacc_parse_header_block(ps: ChibaccParserState): (str, ChibaccParserState) =
    if chibacc_tok_is_lbrace(chibacc_ps_cur(ps)) {
        let (raw, ps1, _) = chibacc_capture_balanced_raw(ps, 0)
        (raw, ps1)
    } else { ("", ps) }

/// Parse optional footer block.
def chibacc_parse_footer_block(ps: ChibaccParserState): (String, ChibaccParserState) =
    if chibacc_tok_is_lbrace(chibacc_ps_cur(ps)) {
        let (raw, ps1, _) = chibacc_capture_balanced_raw(ps, 0)
        (raw, ps1)
    } else { ("", ps) }

/// Parse the full `.chibacc` file.
def chibacc_parse_file(ps: ChibaccParserState): Result[ChibaccSpec, ChibaccParseError] = {
    let ps0 = chibacc_skip_hashbang(ps)
    let (header, ps1) = chibacc_parse_header_block(ps0)
    if chibacc_tok_is_kw_start(chibacc_ps_cur(ps1)) == false { Err(chibacc_parse_error(chibacc_ps_cur(ps1).lo, "expected start")) }
    else {
        let (start, ps2, ok_start) = chibacc_expect_ident(chibacc_ps_adv(ps1))
        if ok_start == false { Err(chibacc_parse_error(chibacc_ps_cur(ps2).lo, "expected start rule")) }
        else {
            let (rules, ps3, ok_rules) = chibacc_parse_rules_tokens(ps2, ListNil)
            if ok_rules == false { Err(chibacc_parse_error(chibacc_ps_cur(ps3).lo, "expected rule")) }
            else {
                let (footer, _) = chibacc_parse_footer_block(ps3)
                Ok(ChibaccSpec {
                    namespace_name: chibacc_parse_namespace(header),
                    start: GrammarName { text: start },
                    rules: rules,
                    ast_data: footer,
                })
            }
        }
    }
}

/// Parse one `.chibacc` source file.
def parse_chibacc(source: str): Result[ChibaccSpec, ChibaccParseError] =
    chibacc_parse_file(chibacc_ps_new(source))

/// Parse a normal grammar rule from a source fragment.
def parse_rule(source: str): Result[GrammarRule, ChibaccParseError] = {
    let ps = chibacc_ps_new(source)
    let seek = chibacc_seek_rule(ps)
    let (rule, _, ok) = chibacc_parse_rule_def(seek)
    if ok { Ok(rule) }
    else { Err(chibacc_parse_error(chibacc_ps_cur(seek).lo, "expected rule")) }
}

/// Seek to the next `rule` token.
def chibacc_seek_rule(ps: ChibaccParserState): ChibaccParserState =
    if chibacc_tok_is_kw_rule(chibacc_ps_cur(ps)) { ps }
    else if chibacc_tok_is_eof(chibacc_ps_cur(ps)) { ps }
    else { chibacc_seek_rule(chibacc_ps_adv(ps)) }

/// Parse a Pratt rule body from a source fragment.
def parse_pratt(source: str): Result[GrammarRuleBody, ChibaccParseError] = {
    let ps = chibacc_ps_new(source)
    let seek = chibacc_seek_pratt(ps)
    let (body, _, ok) = chibacc_parse_pratt_rule(seek)
    if ok { Ok(body) }
    else { Err(chibacc_parse_error(chibacc_ps_cur(seek).lo, "expected pratt")) }
}

/// Seek to the next `pratt` token.
def chibacc_seek_pratt(ps: ChibaccParserState): ChibaccParserState =
    if chibacc_tok_is_kw_pratt(chibacc_ps_cur(ps)) { ps }
    else if chibacc_tok_is_eof(chibacc_ps_cur(ps)) { ps }
    else { chibacc_seek_pratt(chibacc_ps_adv(ps)) }

/// Compatibility helper used by old contract checks.
def chibacc_find_rule_keyword(source: str, offset: usize): usize =
    chibacc_find_text(source, offset, "rule")

/// Parser module sentinel.
def chibacc_parser_sentinel(): i64 = 0
