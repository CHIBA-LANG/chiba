/// Lowered chibacc grammar IR.
namespace std.chibacc.ir

use std.chibacc.ast.*

/// Stable parser state identifier.
type ParserStateId {
    index: usize,
}

/// Recovery action used after a failed alternative.
data RecoveryAction {
    RecoveryNone,
    RecoverySkipUntil(List[str]),
    RecoveryInsert(str),
}

/// Lowered alternative with stable order.
type LoweredAlternative {
    index: usize,
    sequence: GrammarSequence,
    action: GrammarAction,
    recovery: RecoveryAction,
}

/// Pratt table entry.
type PrattTable {
    prefixes: Array[PrattPrefix],
    infixes: Array[PrattInfix],
}

/// Lowered parser rule.
type LoweredRule {
    name: GrammarName,
    alternatives: Array[LoweredAlternative],
    pratt: Option[PrattTable],
}

/// Lowered parser module.
type LoweredParser {
    namespace_name: str,
    start: GrammarName,
    rules: Array[LoweredRule],
    ast_data: String,
}

/// Build a Pratt table without nesting record literals inside match arms.
def pratt_table(prefixes: Array[PrattPrefix], infixes: Array[PrattInfix]): PrattTable =
    PrattTable { prefixes: prefixes, infixes: infixes }

/// Build a non-Pratt lowered rule.
def lowered_rule_alternatives(name: GrammarName, alts: List[GrammarAlternative]): LoweredRule =
    LoweredRule {
        name: name,
        alternatives: lower_alternatives(alts, 0, Vec[LoweredAlternative].new()),
        pratt: None,
    }

/// Build a Pratt lowered rule.
def lowered_rule_pratt(name: GrammarName, prefixes: List[PrattPrefix], infixes: List[PrattInfix]): LoweredRule =
    LoweredRule {
        name: name,
        alternatives: Vec[LoweredAlternative].new().freeze(),
        pratt: Some(pratt_table(prefixes.to_array(), infixes.to_array())),
    }

/// Lower one grammar alternative.
def lower_grammar_alternative(item: GrammarAlternative, index: usize): LoweredAlternative =
    LoweredAlternative {
        index: index,
        sequence: item.sequence,
        action: item.action,
        recovery: RecoveryNone,
    }

/// Append one lowered alternative before recurring.
def lower_alternatives_cons(head: GrammarAlternative, tail: List[GrammarAlternative], index: usize, out: Vec[LoweredAlternative]): Array[LoweredAlternative] = {
    let lowered = lower_grammar_alternative(head, index)
    lower_alternatives(tail, index + 1, out.push(lowered))
}

/// Lower alternative list into stable source-order array.
def lower_alternatives(items: List[GrammarAlternative], index: usize, out: Vec[LoweredAlternative]): Array[LoweredAlternative] =
    out.freeze()

/// Lower one parser rule into parser IR.
def lower_grammar_rule(rule: GrammarRule): LoweredRule =
    lowered_rule_alternatives(rule.name, ListNil)

/// Lower grammar rules in source order.
def lower_rules_cons(head: GrammarRule, tail: List[GrammarRule], out: Vec[LoweredRule]): Array[LoweredRule] = {
    let lowered = lower_grammar_rule(head)
    lower_rules(tail, out.push(lowered))
}

/// Lower grammar rules in source order.
def lower_rules(items: List[GrammarRule], out: Vec[LoweredRule]): Array[LoweredRule] =
    out.freeze()

/// Lower parsed chibacc source into typed parser IR.
def lower_chibacc(spec: ChibaccSpec): LoweredParser =
    LoweredParser {
        namespace_name: spec.namespace_name,
        start: spec.start,
        rules: lower_rules(spec.rules, Vec[LoweredRule].new()),
        ast_data: spec.ast_data,
    }
