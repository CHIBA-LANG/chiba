/// Regex program IR for level-1b.
///
/// The program is still a typed ADT. Numeric backend opcodes are introduced
/// only after validation when emitting target-specific code.
namespace std.regex.program

use std.regex.ast.*

/// Program label used by branch instructions.
type RegexLabel {
    index: usize,
}

/// Typed regex instruction.
data RegexInstruction {
    RegexAccept,
    RegexMatchLiteral(RegexChar),
    RegexMatchAny,
    RegexMatchClass(RegexClass),
    RegexJump(RegexLabel),
    RegexSplit(RegexLabel, RegexLabel, RegexQuantMode),
    RegexEnterCapture(usize),
    RegexExitCapture(usize),
    RegexAssertInstruction(RegexAssertion),
}

/// Compiled regex program.
type RegexProgram {
    instructions: Array[RegexInstruction],
    capture_count: usize,
}

/// Compiler state for capture numbering.
type RegexCompileState {
    out: Vec[RegexInstruction],
    next_capture: usize,
}

/// Result of compiling a temporary instruction fragment while preserving capture numbering.
type RegexCompileFragmentResult {
    state: RegexCompileState,
    instructions: Array[RegexInstruction],
}

/// Return the finalized instruction stream.
def RegexCompileState.instructions(self): Array[RegexInstruction] =
    self.out.freeze()

/// Append one instruction to the compiler state.
def RegexCompileState.push(self, instruction: RegexInstruction): RegexCompileState =
    RegexCompileState { out: self.out.push(instruction), next_capture: self.next_capture }

/// Allocate the next capture slot.
def RegexCompileState.allocate_capture(self): (RegexCompileState, usize) =
    (RegexCompileState { out: self.out, next_capture: self.next_capture + 1 }, self.next_capture)

/// Append one instruction array to a builder.
def regex_emit_all(items: Array[RegexInstruction], index: usize, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    if index == items.len() { out }
    else { regex_emit_all(items, index + 1, out.push(items.get(index))) }

/// Compile one AST node into an immutable instruction fragment.
def regex_compile_fragment(ast: RegexAst): Array[RegexInstruction] =
    regex_compile_into(ast, Vec[RegexInstruction].new()).freeze()

/// Compile a temporary fragment with the real capture-numbering state.
def regex_compile_state_fragment(ast: RegexAst, state: RegexCompileState): RegexCompileFragmentResult =
    {
        let compiled = regex_compile_state_into(ast, RegexCompileState { out: Vec[RegexInstruction].new(), next_capture: state.next_capture })
        RegexCompileFragmentResult {
            state: RegexCompileState { out: state.out, next_capture: compiled.next_capture },
            instructions: compiled.instructions(),
        }
    }

/// Compile a sequence list into instruction builder form.
def regex_compile_sequence(items: List[RegexAst], out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    match items {
        ListNil => out
        ListCons(head, tail) => regex_compile_sequence(tail, regex_compile_into(head, out))
    }

/// Compile an alternation list into nested typed Split/Jump branches.
def regex_compile_alternative(items: List[RegexAst], out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    match items {
        ListNil => out
        ListCons(head, tail) =>
            match tail {
                ListNil => regex_compile_into(head, out)
                _ => {
                    let first = regex_compile_fragment(head)
                    let rest = regex_compile_alternative(tail, Vec[RegexInstruction].new()).freeze()
                    let split_index = out.len()
                    let first_start = split_index + 1
                    let rest_start = first_start + first.len() + 1
                    let end = rest_start + rest.len()
                    regex_emit_all(rest, 0,
                        regex_emit_all(first, 0,
                            out.push(RegexSplit(RegexLabel { index: first_start }, RegexLabel { index: rest_start }, RegexGreedy)))
                            .push(RegexJump(RegexLabel { index: end })))
                }
            }
    }

/// Compile a fixed number of required repeats.
def regex_compile_required_repeats(inner: RegexAst, count: usize, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    if count == 0 { out }
    else { regex_compile_required_repeats(inner, count - 1, regex_compile_into(inner, out)) }

/// Compile one optional repeat slot.
def regex_compile_optional_repeat_fragment(body: Array[RegexInstruction], mode: RegexQuantMode, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    {
        let split_index = out.len()
        let body_start = split_index + 1
        let end = body_start + body.len()
        match mode {
            RegexGreedy => regex_emit_all(body, 0, out.push(RegexSplit(RegexLabel { index: body_start }, RegexLabel { index: end }, mode)))
            RegexLazy => regex_emit_all(body, 0, out.push(RegexSplit(RegexLabel { index: end }, RegexLabel { index: body_start }, mode)))
        }
    }

/// Compile a bounded number of optional repeats.
def regex_compile_optional_repeats_fragment(body: Array[RegexInstruction], count: usize, mode: RegexQuantMode, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    if count == 0 { out }
    else { regex_compile_optional_repeats_fragment(body, count - 1, mode, regex_compile_optional_repeat_fragment(body, mode, out)) }

/// Compile unbounded repeat tail after required repetitions.
def regex_compile_unbounded_repeat_tail_fragment(body: Array[RegexInstruction], mode: RegexQuantMode, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    {
        let split_index = out.len()
        let body_start = split_index + 1
        let end = body_start + body.len() + 1
        let with_split = match mode {
            RegexGreedy => out.push(RegexSplit(RegexLabel { index: body_start }, RegexLabel { index: end }, mode))
            RegexLazy => out.push(RegexSplit(RegexLabel { index: end }, RegexLabel { index: body_start }, mode))
        }
        regex_emit_all(body, 0, with_split).push(RegexJump(RegexLabel { index: split_index }))
    }

/// Compile a quantified expression into typed branch instructions.
def regex_compile_repeat(inner: RegexAst, repeat: RegexRepeat, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    {
        let required = regex_compile_required_repeats(inner, repeat.min, out)
        match repeat.max {
            Some(max) =>
                if max <= repeat.min { required }
                else { regex_compile_optional_repeats(inner, max - repeat.min, repeat.mode, required) }
            None => regex_compile_unbounded_repeat_tail(inner, repeat.mode, required)
        }
    }

/// Compile one regex AST node into typed Thompson-style instruction form.
def regex_compile_into(ast: RegexAst, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    match ast {
        RegexEmpty => out
        RegexLiteral(ch) => out.push(RegexMatchLiteral(ch))
        RegexAny => out.push(RegexMatchAny)
        RegexClassExpr(class) => out.push(RegexMatchClass(class))
        RegexSequence(items) => regex_compile_sequence(items, out)
        RegexAlternative(items) => regex_compile_alternative(items, out)
        RegexCapture(inner) =>
            regex_compile_into(inner, out.push(RegexEnterCapture(0))).push(RegexExitCapture(0))
        RegexNonCapture(inner) => regex_compile_into(inner, out)
        RegexRepeatExpr(inner, repeat) => regex_compile_repeat(inner, repeat, out)
        RegexAssert(assertion) => out.push(RegexAssertInstruction(assertion))
    }

/// Compile one AST node while assigning stable capture numbers.
def regex_compile_state_into(ast: RegexAst, state: RegexCompileState): RegexCompileState =
    match ast {
        RegexEmpty => state
        RegexLiteral(ch) => state.push(RegexMatchLiteral(ch))
        RegexAny => state.push(RegexMatchAny)
        RegexClassExpr(class) => state.push(RegexMatchClass(class))
        RegexSequence(items) => regex_compile_state_sequence(items, state)
        RegexAlternative(items) => regex_compile_state_alternative(items, state)
        RegexCapture(inner) => {
            let allocated = state.allocate_capture()
            let next_state = allocated._1
            let capture_index = allocated._2
            regex_compile_state_into(inner, next_state.push(RegexEnterCapture(capture_index))).push(RegexExitCapture(capture_index))
        }
        RegexNonCapture(inner) => regex_compile_state_into(inner, state)
        RegexRepeatExpr(inner, repeat) => regex_compile_state_repeat(inner, repeat, state)
        RegexAssert(assertion) => state.push(RegexAssertInstruction(assertion))
    }

/// Compile an alternation list while assigning captures left-to-right.
def regex_compile_state_alternative(items: List[RegexAst], state: RegexCompileState): RegexCompileState =
    match items {
        ListNil => state
        ListCons(head, tail) =>
            match tail {
                ListNil => regex_compile_state_into(head, state)
                _ => {
                    let first = regex_compile_state_fragment(head, state)
                    let rest = regex_compile_state_alternative(tail, RegexCompileState { out: Vec[RegexInstruction].new(), next_capture: first.state.next_capture })
                    let split_index = state.out.len()
                    let first_start = split_index + 1
                    let rest_start = first_start + first.instructions.len() + 1
                    let end = rest_start + rest.instructions().len()
                    RegexCompileState {
                        out: regex_emit_all(rest.instructions(), 0,
                            regex_emit_all(first.instructions, 0,
                                state.out.push(RegexSplit(RegexLabel { index: first_start }, RegexLabel { index: rest_start }, RegexGreedy)))
                                .push(RegexJump(RegexLabel { index: end }))),
                        next_capture: rest.next_capture,
                    }
                }
            }
    }

/// Compile a fixed number of required repeat fragments with stable capture slots.
def regex_compile_required_repeat_fragments(body: Array[RegexInstruction], count: usize, out: Vec[RegexInstruction]): Vec[RegexInstruction] =
    if count == 0 { out }
    else { regex_compile_required_repeat_fragments(body, count - 1, regex_emit_all(body, 0, out)) }

/// Compile a quantified expression while allocating capture slots only once.
def regex_compile_state_repeat(inner: RegexAst, repeat: RegexRepeat, state: RegexCompileState): RegexCompileState =
    {
        let fragment = regex_compile_state_fragment(inner, state)
        let required = regex_compile_required_repeat_fragments(fragment.instructions, repeat.min, state.out)
        let out = match repeat.max {
            Some(max) =>
                if max <= repeat.min { required }
                else { regex_compile_optional_repeats_fragment(fragment.instructions, max - repeat.min, repeat.mode, required) }
            None => regex_compile_unbounded_repeat_tail_fragment(fragment.instructions, repeat.mode, required)
        }
        RegexCompileState { out: out, next_capture: fragment.state.next_capture }
    }

/// Compile a sequence list with capture numbering.
def regex_compile_state_sequence(items: List[RegexAst], state: RegexCompileState): RegexCompileState =
    match items {
        ListNil => state
        ListCons(head, tail) => regex_compile_state_sequence(tail, regex_compile_state_into(head, state))
    }

/// Count captures in an AST.
def regex_count_captures(ast: RegexAst): usize =
    match ast {
        RegexCapture(inner) => regex_count_captures(inner) + 1
        RegexNonCapture(inner) => regex_count_captures(inner)
        RegexRepeatExpr(inner, _) => regex_count_captures(inner)
        RegexSequence(items) => regex_count_captures_in_list(items, 0)
        RegexAlternative(items) => regex_count_captures_in_list(items, 0)
        _ => 0
    }

/// Count captures in a list.
def regex_count_captures_in_list(items: List[RegexAst], count: usize): usize =
    match items {
        ListNil => count
        ListCons(head, tail) => regex_count_captures_in_list(tail, count + regex_count_captures(head))
    }

/// Return how many capture slots a repeat can expose.
def regex_repeat_capture_slots(repeat: RegexRepeat): usize =
    match repeat.max {
        Some(max) => max
        None => repeat.min + 1
    }

/// Compile a regex AST into the typed program IR.
def compile_regex(ast: RegexAst): RegexProgram =
    let state = regex_compile_state_into(ast, RegexCompileState { out: Vec[RegexInstruction].new(), next_capture: 0 })
    RegexProgram {
        instructions: state.out.push(RegexAccept).freeze(),
        capture_count: state.next_capture,
    }

/// Return the number of instructions.
def RegexProgram.len(self): usize = self.instructions.len()

/// Return true when a program has no captures.
def RegexProgram.has_no_capture(self): bool = self.capture_count == 0
