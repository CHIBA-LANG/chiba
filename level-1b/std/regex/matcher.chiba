/// Regex matcher contract for level-1b.
///
/// Matching works over managed `str` values. Longest-match behavior is explicit
/// because chibalex depends on deterministic tie-breaking.
namespace std.regex.matcher

use std.regex.program.*
use std.regex.utf8.*

/// Captured byte range.
type RegexCaptureRange {
    start: usize,
    end: usize,
}

/// Successful match result.
type RegexMatch {
    start: usize,
    end: usize,
    captures: Array[RegexCaptureRange],
}

/// One backtracking VM state.
type RegexVmState {
    pc: usize,
    offset: usize,
    captures: Array[RegexCaptureRange],
}

/// Empty capture array for bootstrap subset matching.
def regex_empty_captures(): Array[RegexCaptureRange] =
    Vec[RegexCaptureRange].new().freeze()

/// Capture range with no observed start/end yet.
def regex_empty_capture_range(): RegexCaptureRange =
    RegexCaptureRange { start: 0, end: 0 }

/// Build an empty capture array with one slot per capture group.
def regex_empty_captures_count(count: usize, out: Vec[RegexCaptureRange]): Array[RegexCaptureRange] =
    if count == 0 { out.freeze() }
    else { regex_empty_captures_count(count - 1, out.push(regex_empty_capture_range())) }

/// Build initial capture storage for one program.
def regex_initial_captures(count: usize): Array[RegexCaptureRange] =
    regex_empty_captures_count(count, Vec[RegexCaptureRange].new())

/// Copy captures while replacing one range.
def regex_capture_set_loop(captures: Array[RegexCaptureRange], slot: usize, value: RegexCaptureRange, index: usize, out: Vec[RegexCaptureRange]): Array[RegexCaptureRange] =
    if index == captures.len() { out.freeze() }
    else {
        let next = if index == slot { value } else { captures.get(index) }
        regex_capture_set_loop(captures, slot, value, index + 1, out.push(next))
    }

/// Set one capture slot if it exists.
def regex_capture_set(captures: Array[RegexCaptureRange], slot: usize, value: RegexCaptureRange): Array[RegexCaptureRange] =
    if slot >= captures.len() { captures }
    else { regex_capture_set_loop(captures, slot, value, 0, Vec[RegexCaptureRange].new()) }

/// Record capture start at the current input offset.
def regex_capture_enter(captures: Array[RegexCaptureRange], slot: usize, offset: usize): Array[RegexCaptureRange] =
    if slot >= captures.len() { captures }
    else {
        let current = captures.get(slot)
        regex_capture_set(captures, slot, RegexCaptureRange { start: offset, end: current.end })
    }

/// Record capture end at the current input offset.
def regex_capture_exit(captures: Array[RegexCaptureRange], slot: usize, offset: usize): Array[RegexCaptureRange] =
    if slot >= captures.len() { captures }
    else {
        let current = captures.get(slot)
        regex_capture_set(captures, slot, RegexCaptureRange { start: current.start, end: offset })
    }

/// Compare two regex characters.
def RegexChar.eq(self, other: RegexChar): bool =
    self.codepoint == other.codepoint

/// Return true when a character is in one class atom.
def RegexClassAtom.matches(self, ch: Char): bool =
    match self {
        RegexClassChar(expected) => expected.codepoint == ch.codepoint
        RegexClassRange(start, end) => ch.codepoint >= start.codepoint && ch.codepoint <= end.codepoint
        RegexClassDigit => ch.codepoint >= 48 && ch.codepoint <= 57
        RegexClassWord =>
            if ch.codepoint >= 48 && ch.codepoint <= 57 { true }
            else if ch.codepoint >= 65 && ch.codepoint <= 90 { true }
            else if ch.codepoint >= 97 && ch.codepoint <= 122 { true }
            else { ch.codepoint == 95 }
        RegexClassWhitespace =>
            if ch.codepoint == 32 { true }
            else if ch.codepoint == 9 { true }
            else if ch.codepoint == 10 { true }
            else { ch.codepoint == 13 }
        RegexClassXidStart => ch.is_xid_start()
        RegexClassXidContinue => ch.is_xid_continue()
    }

/// Return true when any atom in a class matches.
def regex_class_atoms_match(atoms: List[RegexClassAtom], ch: Char): bool =
    match atoms {
        ListNil => false
        ListCons(head, tail) =>
            if head.matches(ch) { true }
            else { regex_class_atoms_match(tail, ch) }
    }

/// Return true when a character matches a class, including negation.
def RegexClass.matches(self, ch: Char): bool =
    if self.negated { regex_class_atoms_match(self.atoms, ch) == false }
    else { regex_class_atoms_match(self.atoms, ch) }

/// Match one instruction at an input offset.
def RegexInstruction.match_one(self, input: str, offset: usize): Option[usize] =
    match self {
        RegexAccept => Some(offset)
        RegexMatchLiteral(expected) =>
            if offset >= input.len() { None }
            else if expected.codepoint == input.char_at(offset).codepoint { Some(input.next_char_offset(offset)) }
            else { None }
        RegexMatchAny =>
            if offset >= input.len() { None }
            else { Some(input.next_char_offset(offset)) }
        RegexMatchClass(class) =>
            if offset >= input.len() { None }
            else if class.matches(input.char_at(offset)) { Some(input.next_char_offset(offset)) }
            else { None }
        RegexAssertInstruction(assertion) =>
            if regex_assertion_matches(assertion, input, offset) { Some(offset) }
            else { None }
        _ => None
    }

/// Match a zero-width assertion in the bootstrap subset.
def regex_assertion_matches(assertion: RegexAssertion, input: str, offset: usize): bool =
    match assertion {
        RegexStart => offset == 0
        RegexEnd => offset == input.len()
        RegexWordBoundary => true
        RegexNotWordBoundary => true
        _ => false
    }

/// Push a VM state.
def Vec[RegexVmState].push_state(self, pc: usize, offset: usize, captures: Array[RegexCaptureRange]): Vec[RegexVmState] =
    self.push(RegexVmState { pc: pc, offset: offset, captures: captures })

/// Copy live VM stack prefix before pushing a branch.
def regex_vm_stack_copy_prefix(stack: Array[RegexVmState], index: usize, sp: usize, out: Vec[RegexVmState]): Vec[RegexVmState] =
    if index == sp { out }
    else { regex_vm_stack_copy_prefix(stack, index + 1, sp, out.push(stack.get(index))) }

/// Push a branch on the live VM stack prefix.
def regex_vm_stack_push(stack: Array[RegexVmState], sp: usize, pc: usize, offset: usize, captures: Array[RegexCaptureRange]): Array[RegexVmState] =
    regex_vm_stack_copy_prefix(stack, 0, sp, Vec[RegexVmState].new()).push_state(pc, offset, captures).freeze()

/// Candidate accepted match carried by the VM.
type RegexAcceptedMatch {
    end: usize,
    captures: Array[RegexCaptureRange],
}

/// Return best accepted match by longest endpoint.
def regex_best_match(best: Option[RegexAcceptedMatch], candidate: RegexAcceptedMatch): Option[RegexAcceptedMatch] =
    match best {
        Some(current) =>
            if candidate.end > current.end { Some(candidate) }
            else { best }
        None => Some(candidate)
    }

/// Match a consuming or assertion instruction and continue VM.
def regex_vm_match_then(instructions: Array[RegexInstruction], input: str, pc: usize, offset: usize, captures: Array[RegexCaptureRange], stack: Array[RegexVmState], sp: usize, best: Option[RegexAcceptedMatch]): Option[RegexAcceptedMatch] =
    match instructions.get(pc).match_one(input, offset) {
        Some(next) => regex_vm_step(instructions, input, pc + 1, next, captures, stack, sp, best)
        None => regex_vm_pop(instructions, input, stack, sp, best)
    }

/// Pop next pending VM branch.
def regex_vm_pop(instructions: Array[RegexInstruction], input: str, stack: Array[RegexVmState], sp: usize, best: Option[RegexAcceptedMatch]): Option[RegexAcceptedMatch] =
    if sp == 0 { best }
    else {
        let next_sp = sp - 1
        let state = stack.get(next_sp)
        regex_vm_step(instructions, input, state.pc, state.offset, state.captures, stack, next_sp, best)
    }

/// Step a typed regex VM with explicit Split/Jump backtracking.
def regex_vm_step(instructions: Array[RegexInstruction], input: str, pc: usize, offset: usize, captures: Array[RegexCaptureRange], stack: Array[RegexVmState], sp: usize, best: Option[RegexAcceptedMatch]): Option[RegexAcceptedMatch] =
    if pc >= instructions.len() { regex_vm_pop(instructions, input, stack, sp, best) }
    else {
        match instructions.get(pc) {
            RegexAccept => regex_vm_pop(instructions, input, stack, sp, regex_best_match(best, RegexAcceptedMatch { end: offset, captures: captures }))
            RegexJump(label) => regex_vm_step(instructions, input, label.index, offset, captures, stack, sp, best)
            RegexSplit(first, second, mode) =>
                match mode {
                    RegexGreedy =>
                        regex_vm_step(instructions, input, first.index, offset, captures, regex_vm_stack_push(stack, sp, second.index, offset, captures), sp + 1, best)
                    RegexLazy =>
                        regex_vm_step(instructions, input, first.index, offset, captures, regex_vm_stack_push(stack, sp, second.index, offset, captures), sp + 1, best)
                }
            RegexEnterCapture(slot) => regex_vm_step(instructions, input, pc + 1, offset, regex_capture_enter(captures, slot, offset), stack, sp, best)
            RegexExitCapture(slot) => regex_vm_step(instructions, input, pc + 1, offset, regex_capture_exit(captures, slot, offset), stack, sp, best)
            _ => regex_vm_match_then(instructions, input, pc, offset, captures, stack, sp, best)
        }
    }

/// Interpret regex instructions and return longest accepted endpoint.
def regex_match_vm(instructions: Array[RegexInstruction], capture_count: usize, input: str, start: usize): Option[RegexAcceptedMatch] =
    regex_vm_step(instructions, input, 0, start, regex_initial_captures(capture_count), Vec[RegexVmState].new().freeze(), 0, None)

/// Match a regex at exactly `start`.
def RegexProgram.match_at(self, input: str, start: usize): Option[RegexMatch] =
    match regex_match_vm(self.instructions, self.capture_count, input, start) {
        Some(found) => Some(RegexMatch { start: start, end: found.end, captures: found.captures })
        None => None
    }

/// Find the first match at or after `start`.
def RegexProgram.find_from(self, input: str, start: usize): Option[RegexMatch] =
    if start > input.len() { None }
    else {
        match self.match_at(input, start) {
            Some(found) => Some(found)
            None => self.find_from(input, start + 1)
        }
    }

/// Find the first match in `input`.
def RegexProgram.find(self, input: str): Option[RegexMatch] =
    self.find_from(input, 0)

/// Find the longest match beginning at `start`.
def RegexProgram.longest_at(self, input: str, start: usize): Option[RegexMatch] =
    self.match_at(input, start)
