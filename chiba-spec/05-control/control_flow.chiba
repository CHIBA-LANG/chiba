// expect: accept
// expect: fact if and match are expressions
// expect: fact non-exhaustive match reports warning rather than runtime trap
// expect: fact loop tags resolve break/continue target structurally

namespace demo.control

def branch(flag: bool): i64 =
	if flag {
		1
	} else if false {
		2
	} else {
		3
	}

def choose(x: i64): i64 =
	match x {
		0 => 10
		1 => 11
		_ => 12
	}

def loop_value(): i64 = {
	for :outer {
		break :outer
	}
	1
}
// expect: runtime loop_value == 1
