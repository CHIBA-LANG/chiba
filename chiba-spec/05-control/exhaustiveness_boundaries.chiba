// expect: accept
// Boundary: exhaustiveness is semantic; warning policy is explicit.

namespace demo.exhaustiveness

data Tri = {
	A
	B
	C
}

def full(value: Tri): i64 =
	match value {
		A => 1
		B => 2
		C => 3
	}
// expect: fact exhaustive == true

def wildcard(value: Tri): i64 =
	match value {
		A => 1
		_ => 9
	}
// expect: fact exhaustive == true via wildcard

def missing(value: Tri): i64 =
	match value {
		A => 1
		B => 2
	}
// expect: warning non-exhaustive-match missing C
// expect: fact current level-1 policy is warning, not hard error
