namespace backend.wasm.wat
use metalstd.file.*
use metalstd.mem.*
use metalstd.str.*
use parser.chiba_level1.*
use backend.cir.ir.*

def wat_indent_loop(out: Str, i: i64, depth: i64): i64 =
    if i >= depth { 0 }
    else {
        let _ = str_push_cstr(out, "  ")
        wat_indent_loop(out, i + 1, depth)
    }

def wat_indent(out: Str, depth: i64): i64 =
    wat_indent_loop(out, 0, depth)

def wat_line(out: Str, depth: i64, text: i64): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, text)
    str_push(out, 10)
}

def wat_line_str(out: Str, depth: i64, prefix: i64, value: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, prefix)
    let _ = str_append(out, value)
    str_push(out, 10)
}

def wat_emit_string_byte_consts(out: Str, depth: i64, bytes: Str, i: i64): i64 =
    if i >= bytes.len { 0 }
    else {
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "i32.const ")
        let _ = str_append_i64(out, load8(bytes.ptr, i))
        let _ = str_push(out, 10)
        wat_emit_string_byte_consts(out, depth, bytes, i + 1)
    }

def wat_emit_string_array(out: Str, depth: i64, bytes: Str): i64 = {
    let _ = wat_emit_string_byte_consts(out, depth, bytes, 0)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "array.new_fixed $array_u8 ")
    let _ = str_append_i64(out, bytes.len)
    str_push(out, 10)
}

def wat_type_list_len(items: CirTypeList): i64 =
    match items {
        CirTypeEnd => 0
        CirTypeCons(_, tail) => 1 + wat_type_list_len(tail)
    }

def wat_type_storage_code(ty: CirType): Str =
    if wat_type_is_i64_storage(ty) != 0 { mk_str("i64", 3) } else { mk_str("ref", 3) }

def wat_tuple2_layout_name(a: CirType, b: CirType): Str = {
    let ac = wat_type_storage_code(a)
    let bc = wat_type_storage_code(b)
    if streq(ac, mk_str("i64", 3)) != 0 && streq(bc, mk_str("i64", 3)) != 0 { mk_str("tuple2_i64_i64", 14) }
    else if streq(ac, mk_str("ref", 3)) != 0 && streq(bc, mk_str("i64", 3)) != 0 { mk_str("tuple2_ref_i64", 14) }
    else if streq(ac, mk_str("i64", 3)) != 0 && streq(bc, mk_str("ref", 3)) != 0 { mk_str("tuple2_i64_ref", 14) }
    else { mk_str("tuple2_ref_ref", 14) }
}

def wat_tuple3_layout_name(a: CirType, b: CirType, c: CirType): Str = {
    let ac = wat_type_storage_code(a)
    let bc = wat_type_storage_code(b)
    let cc = wat_type_storage_code(c)
    if streq(ac, mk_str("i64", 3)) != 0 && streq(bc, mk_str("i64", 3)) != 0 && streq(cc, mk_str("i64", 3)) != 0 { mk_str("tuple3_i64_i64_i64", 18) }
    else { mk_str("", 0) }
}

def wat_tuple_layout_name_from_list(items: CirTypeList): Str =
    match items {
        CirTypeCons(a, CirTypeCons(b, CirTypeEnd)) => wat_tuple2_layout_name(a, b)
        CirTypeCons(a, CirTypeCons(b, CirTypeCons(c, CirTypeEnd))) => wat_tuple3_layout_name(a, b, c)
        _ => mk_str("", 0)
    }

def wat_tuple_layout_name_from_type(ty: CirType): Str =
    match ty {
        CirTyTuple(items) => wat_tuple_layout_name_from_list(items)
        _ => mk_str("", 0)
    }

def wat_nonempty_or_tuple_expr_name(name: Str, value: CirExpr): Str =
    if streq(name, mk_str("", 0)) == 0 { name } else { wat_tuple_layout_name_from_expr(value) }

def wat_tuple_layout_name_from_expr(expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_tuple_layout_name_from_expr(value)
        L7CoreOp(value, _) => wat_tuple_layout_name_from_expr(value)
        L6OpClosureEnv(value, _) => wat_tuple_layout_name_from_expr(value)
        L5OpContinuationPackage(_, _, value) => wat_tuple_layout_name_from_expr(value)
        L5OpCps(value, _) => wat_tuple_layout_name_from_expr(value)
        L4OpUsage(value, _) => wat_tuple_layout_name_from_expr(value)
        L3OpAnswerControl(value, ty, _) => {
            let name = wat_tuple_layout_name_from_type(ty)
            wat_nonempty_or_tuple_expr_name(name, value)
        }
        L2OpTyped(value, ty) => {
            let name = wat_tuple_layout_name_from_type(ty)
            wat_nonempty_or_tuple_expr_name(name, value)
        }
        L1OpCall(callee, args) =>
            if wat_expr_is_tuple_constructor(callee) != 0 { wat_tuple_layout_name_from_list(wat_expr_list_types(args)) }
            else { mk_str("", 0) }
        _ => mk_str("", 0)
    }

def wat_expr_is_tuple_constructor(expr: CirExpr): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpRef(ref) => wat_is_ref_name(ref, mk_str("__tuple", 7))
        _ => 0
    }

def wat_emit_string_interp_expr(out: Str, depth: i64, value: CirExpr): i64 = {
    let _ = wat_emit_expr(out, depth, value)
    0
}

def wat_emit_string_interp(out: Str, depth: i64, parts: CirStringPartList): i64 =
    match parts {
        CirStringPartEnd => wat_emit_string_array(out, depth, mk_str("", 0))
        CirStringPartChunk(chunk, CirStringPartEnd) => wat_emit_string_array(out, depth, chunk)
        CirStringPartExpr(value, CirStringPartEnd) => wat_emit_string_interp_expr(out, depth, value)
        CirStringPartChunk(chunk, rest) => {
            let _ = wat_emit_string_array(out, depth, chunk)
            let _ = wat_emit_string_interp(out, depth, rest)
            wat_line(out, depth, "call $__chiba_string_concat2")
        }
        CirStringPartExpr(value, rest) => {
            let _ = wat_emit_string_interp_expr(out, depth, value)
            let _ = wat_emit_string_interp(out, depth, rest)
            wat_line(out, depth, "call $__chiba_string_concat2")
        }
    }

def wat_local_name(out: Str, id: i64): i64 = {
    let _ = str_push_cstr(out, "$v")
    str_append_i64(out, id)
}

def wat_func_name(out: Str, name: Str): i64 = {
    let _ = str_push(out, 36)
    str_append(out, name)
}

def wat_func_name_with_arity(out: Str, name: Str, arity: i64): i64 = {
    let _ = wat_func_name(out, name)
    let _ = str_push_cstr(out, "__a")
    str_append_i64(out, arity)
}

def wat_ctor_func_name_with_arity(out: Str, name: Str, arity: i64): i64 = {
    let _ = str_push_cstr(out, "$ctor_")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, "__a")
    str_append_i64(out, arity)
}

def wat_ctor_layout_name(out: Str, layout: Str): i64 = {
    let _ = str_push(out, 36)
    str_append(out, layout)
}

def wat_ctor_func_name_from_layout(out: Str, layout: Str): i64 = {
    let _ = str_push_cstr(out, "$ctor_")
    str_append(out, layout)
}

def wat_binder_func_name(out: Str, binder: CirBinder): i64 =
    wat_func_name(out, binder.name)

def wat_param_list_len(params: CirParamList): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(_, rest) => 1 + wat_param_list_len(rest)
    }

def wat_emit_defined_func_name(out: Str, name: Str, params: CirParamList): i64 =
    if streq(name, mk_str("main", 4)) != 0 { wat_func_name(out, name) }
    else if wat_builtin_runtime_defined(name) != 0 { wat_func_name(out, name) }
    else if wat_known_param_type_exists(name, 0) != 0 { wat_func_name_with_arity(out, name, wat_param_list_len(params)) }
    else { wat_func_name(out, name) }

def wat_emit_defined_func_name_in(out: Str, items: AST, name: Str, params: CirParamList): i64 = {
    let arity = wat_param_list_len(params)
    let layout = wat_ctor_layout_name_for_call(items, name, arity)
    if layout.len != 0 { wat_ctor_func_name_from_layout(out, layout) }
    else { wat_emit_defined_func_name(out, name, params) }
}

def wat_nominal_ctor_body_layout(items: AST, body: CirExpr): Str =
    match body {
        L8ValidatedCoreOp(value, _) => wat_nominal_ctor_body_layout(items, value)
        L7CoreOp(value, _) => wat_nominal_ctor_body_layout(items, value)
        L6OpClosureEnv(value, _) => wat_nominal_ctor_body_layout(items, value)
        L5OpContinuationPackage(_, _, value) => wat_nominal_ctor_body_layout(items, value)
        L5OpCps(value, _) => wat_nominal_ctor_body_layout(items, value)
        L4OpUsage(value, _) => wat_nominal_ctor_body_layout(items, value)
        L3OpAnswerControl(value, _, _) => wat_nominal_ctor_body_layout(items, value)
        L2OpTyped(value, _) => wat_nominal_ctor_body_layout(items, value)
        L1OpNominalCtor(name, fields) => wat_ctor_layout_name_for_call(items, name, wat_record_field_exprs_len(fields))
        _ => mk_str("", 0)
    }

def wat_nominal_ctor_body_name(body: CirExpr): Str =
    match body {
        L8ValidatedCoreOp(value, _) => wat_nominal_ctor_body_name(value)
        L7CoreOp(value, _) => wat_nominal_ctor_body_name(value)
        L6OpClosureEnv(value, _) => wat_nominal_ctor_body_name(value)
        L5OpContinuationPackage(_, _, value) => wat_nominal_ctor_body_name(value)
        L5OpCps(value, _) => wat_nominal_ctor_body_name(value)
        L4OpUsage(value, _) => wat_nominal_ctor_body_name(value)
        L3OpAnswerControl(value, _, _) => wat_nominal_ctor_body_name(value)
        L2OpTyped(value, _) => wat_nominal_ctor_body_name(value)
        L1OpNominalCtor(name, _) => name
        _ => mk_str("", 0)
    }

def wat_first_param_valtype(items: AST, params: CirParamList): i64 =
    match params {
        CirParamCons(param, _) =>
            match param {
                L0Param(_, ty) => wat_valtype_from_ast_in(items, ty)
                L1Param(_, ty) => wat_valtype_from_ast_in(items, ty)
                _ => ""
            }
        _ => ""
    }

def wat_known_duplicate_ctor_layout(name: Str, arity: i64, first_type: i64): Str =
    if arity == 1 && streq(name, mk_str("TypeVar", 7)) != 0 {
        if streq(mk_str(first_type, strlen(first_type)), mk_str("i64", 3)) != 0 { mk_str("TypeVar__TypeVar__a1", 20) }
        else { mk_str("TypeIr__TypeVar__a1", 19) }
    } else if arity == 2 && streq(name, mk_str("NominalId", 9)) != 0 {
        if streq(mk_str(first_type, strlen(first_type)), mk_str("(ref $array_u8)", 15)) != 0 { mk_str("NominalId__NominalId__a2", 24) }
        else { mk_str("TypeIr__NominalId__a2", 22) }
    } else { mk_str("", 0) }

def wat_emit_defined_func_name_for_body(out: Str, items: AST, name: Str, params: CirParamList, body: CirExpr): i64 = {
    let layout0 = wat_nominal_ctor_body_layout(items, body)
    let ctor_name = wat_nominal_ctor_body_name(body)
    let first_type = wat_first_param_valtype(items, params)
    let typed_layout = if first_type == 0 { mk_str("", 0) } else { wat_known_duplicate_ctor_layout(name, wat_param_list_len(params), first_type) }
    let layout = if typed_layout.len != 0 { typed_layout } else { layout0 }
    if layout.len != 0 && streq(name, ctor_name) != 0 { wat_ctor_func_name_from_layout(out, layout) }
    else { wat_emit_defined_func_name(out, name, params) }
}

def wat_effective_defined_func_name_for_body(items: AST, name: Str, params: CirParamList, body: CirExpr): Str = {
    let layout0 = wat_nominal_ctor_body_layout(items, body)
    let ctor_name = wat_nominal_ctor_body_name(body)
    let first_type = wat_first_param_valtype(items, params)
    let typed_layout = if first_type == 0 { mk_str("", 0) } else { wat_known_duplicate_ctor_layout(name, wat_param_list_len(params), first_type) }
    let layout = if typed_layout.len != 0 { typed_layout } else { layout0 }
    if layout.len != 0 && streq(name, ctor_name) != 0 { layout }
    else { name }
}

def wat_ref_func_name(out: Str, cir_ref: CirRef): i64 =
    match cir_ref {
        L1RefGlobal(namespace_name, name, _) =>
            wat_func_name(out, name)
        L1RefUnresolved(namespace_name, name) =>
            wat_func_name(out, name)
        L1RefLocal(_, name) => wat_func_name(out, name)
        L0RefName(name) => wat_func_name(out, name)
    }

def wat_ref_func_name_with_args(out: Str, cir_ref: CirRef, args: CirExprList): i64 =
    match cir_ref {
        L1RefGlobal(namespace_name, name, _) =>
            if wat_ref_call_uses_arity_mangle(name) != 0 { wat_func_name_with_arity(out, name, wat_expr_list_len(args)) }
            else { wat_func_name(out, name) }
        L1RefUnresolved(namespace_name, name) =>
            if wat_ref_call_uses_arity_mangle(name) != 0 { wat_func_name_with_arity(out, name, wat_expr_list_len(args)) }
            else { wat_func_name(out, name) }
        L1RefLocal(_, name) => wat_func_name(out, name)
        L0RefName(name) => wat_func_name(out, name)
    }

def wat_ref_func_name_with_args_in(out: Str, items: AST, cir_ref: CirRef, args: CirExprList): i64 =
    match cir_ref {
        L1RefGlobal(namespace_name, name, _) => {
            let arity = wat_expr_list_len(args)
            let layout = wat_ctor_layout_name_for_call(items, name, arity)
            if layout.len != 0 { wat_ctor_func_name_from_layout(out, layout) }
            else if wat_ref_call_uses_arity_mangle(name) != 0 { wat_func_name_with_arity(out, name, arity) }
            else { wat_func_name(out, name) }
        }
        L1RefUnresolved(namespace_name, name) => {
            let arity = wat_expr_list_len(args)
            let layout = wat_ctor_layout_name_for_call(items, name, arity)
            if layout.len != 0 { wat_ctor_func_name_from_layout(out, layout) }
            else if wat_ref_call_uses_arity_mangle(name) != 0 { wat_func_name_with_arity(out, name, arity) }
            else { wat_func_name(out, name) }
        }
        L1RefLocal(_, name) => wat_func_name(out, name)
        L0RefName(name) => wat_func_name(out, name)
    }

def wat_ref_is_direct_callable(ref: CirRef): i64 =
    match ref {
        L1RefGlobal(_, _, _) => 1
        L1RefUnresolved(_, _) => 1
        L0RefName(_) => 1
        _ => 0
    }

def wat_ref_name_declared_zero_ctor(cir_ref: CirRef, items: AST, args: CirExprList): Str =
    if wat_expr_list_len(args) != 0 { mk_str("", 0) }
    else {
        match cir_ref {
            L1RefGlobal(_, name, _) =>
                {
                    let layout = wat_ctor_layout_name_for_call(items, name, 0)
                    if layout.len != 0 { layout }
                    else if wat_runtime_heap_type_defined(name) != 0 { name }
                    else { mk_str("", 0) }
                }
            L1RefUnresolved(_, name) =>
                {
                    let layout = wat_ctor_layout_name_for_call(items, name, 0)
                    if layout.len != 0 { layout }
                    else if wat_runtime_heap_type_defined(name) != 0 { name }
                    else { mk_str("", 0) }
                }
            L0RefName(name) =>
                {
                    let layout = wat_ctor_layout_name_for_call(items, name, 0)
                    if layout.len != 0 { layout }
                    else if wat_runtime_heap_type_defined(name) != 0 { name }
                    else { mk_str("", 0) }
                }
            _ => mk_str("", 0)
        }
    }

def wat_emit_zero_ctor_if_declared(out: Str, depth: i64, items: AST, cir_ref: CirRef, args: CirExprList): i64 = {
    let name = wat_ref_name_declared_zero_ctor(cir_ref, items, args)
    if name.len == 0 { 0 }
    else {
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "struct.new $")
        let _ = str_append(out, name)
        let _ = str_push(out, 10)
        1
    }
}

def wat_emit_ctor_call_if_declared(out: Str, depth: i64, items: AST, cir_ref: CirRef, args: CirExprList): i64 = {
    let name = wat_ref_call_name(cir_ref)
    let arity = wat_expr_list_len(args)
    let layout = if arity == 1 && streq(name, mk_str("Some", 4)) != 0 {
        wat_option_some_layout_for_payload_type(wat_expr_list_first_layout_valtype(args))
    } else { wat_ctor_layout_name_for_call(items, name, arity) }
    if layout.len == 0 { 0 }
    else {
        let _ = wat_emit_expr_list(out, depth, items, args)
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "struct.new $")
        let _ = str_append(out, layout)
        let _ = str_push(out, 10)
        1
    }
}

def wat_emit_ctor_call_if_declared_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, cir_ref: CirRef, args: CirExprList): i64 = {
    let name = wat_ref_call_name(cir_ref)
    let arity = wat_expr_list_len(args)
    let layout = if arity == 1 && streq(name, mk_str("Some", 4)) != 0 {
        let return_layout = wat_ast_return_option_some_layout(items, func_name)
        if return_layout.len != 0 { return_layout }
        else { wat_option_some_layout_for_payload_type(wat_expr_list_first_valtype_with_body(items, func_name, params, body, args)) }
    } else { wat_ctor_layout_name_for_call(items, name, arity) }
    if layout.len == 0 { 0 }
    else {
        let _ = wat_emit_expr_list_for_layout_with_body(out, depth, items, func_name, params, body, layout, args, 0)
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "struct.new $")
        let _ = str_append(out, layout)
        let _ = str_push(out, 10)
        1
    }
}

def wat_func_is_pure_ctor_wrapper(items: AST, name: Str, params: CirParamList, body: CirExpr): i64 = {
    let ctor_name = wat_nominal_ctor_body_name(body)
    if ctor_name.len == 0 { 0 }
    else if streq(name, ctor_name) == 0 { 0 }
    else {
        let layout = wat_nominal_ctor_body_layout(items, body)
        if layout.len != 0 { 1 } else { 0 }
    }
}

def wat_ref_call_uses_arity_mangle(name: Str): i64 =
    if wat_builtin_runtime_defined(name) != 0 { 0 }
    else if streq(name, mk_str("DiagnosticBuilder.push_str", 26)) != 0 { 0 }
    else if streq(name, mk_str("DiagnosticBuilder.new", 21)) != 0 { 0 }
    else if streq(name, mk_str("DiagnosticBuilder.finish", 24)) != 0 { 0 }
    else if streq(name, mk_str("Vec.push", 8)) != 0 { 0 }
    else if streq(name, mk_str("Vec.new", 7)) != 0 { 0 }
    else if streq(name, mk_str("Vec.freeze", 10)) != 0 { 0 }
    else if streq(name, mk_str("main", 4)) != 0 { 0 }
    else if wat_known_param_type_exists(name, 0) != 0 { 1 }
    else { 0 }

def wat_ref_call_name(cir_ref: CirRef): Str =
    match cir_ref {
        L1RefGlobal(_, name, _) => name
        L1RefUnresolved(_, name) => name
        L1RefLocal(_, name) => name
        L0RefName(name) => name
    }

def wat_ref_owner_name(cir_ref: CirRef): Str =
    match cir_ref {
        L1RefGlobal(_, name, _) => wat_symbol_name_last_part(name)
        L1RefUnresolved(_, name) => wat_symbol_name_last_part(name)
        L1RefLocal(_, name) => wat_symbol_name_last_part(name)
        L0RefName(name) => wat_symbol_name_last_part(name)
    }

def wat_symbol_name_last_part_loop(name: Str, index: i64, last: i64): Str =
    if index >= name.len {
        mk_str(name.ptr + last, name.len - last)
    } else if load8(name.ptr, index) == 46 {
        wat_symbol_name_last_part_loop(name, index + 1, index + 1)
    } else {
        wat_symbol_name_last_part_loop(name, index + 1, last)
    }

def wat_symbol_name_last_part(name: Str): Str =
    wat_symbol_name_last_part_loop(name, 0, 0)

def wat_symbol_name_last_part_len(name: Str): i64 =
    strlen(wat_symbol_name_last_part(name))

def wat_symbol_name_owner_loop(name: Str, index: i64, last_dot: i64): Str =
    if index >= name.len {
        if last_dot < 0 { mk_str("", 0) } else { mk_str(name.ptr, last_dot) }
    } else if load8(name.ptr, index) == 46 {
        wat_symbol_name_owner_loop(name, index + 1, index)
    } else {
        wat_symbol_name_owner_loop(name, index + 1, last_dot)
    }

def wat_symbol_name_owner(name: Str): Str =
    wat_symbol_name_owner_loop(name, 0, -1)

def wat_text_nonempty(text: Str): i64 =
    if streq(text, mk_str("", 0)) != 0 { 0 }
    else { 1 }

def wat_valtype_is_i64(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("i64", 3))

def wat_valtype_is_i32(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("i32", 3))

def wat_valtype_is_integer_scalar(ty: i64): i64 =
    if wat_valtype_is_i64(ty) != 0 { 1 }
    else { wat_valtype_is_i32(ty) }

def wat_valtype_is_array_u8_ref(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("(ref $array_u8)", 15))

def wat_valtype_is_eqref(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("eqref", 5))

def wat_valtype_cstr_eq(ty: i64, expected: Str): i64 =
    streq(mk_str(ty, strlen(ty)), expected)

def wat_owner_from_valtype(ty: i64): Str =
    if streq(mk_str(ty, strlen(ty)), mk_str("(ref $array_u8)", 15)) != 0 { mk_str("str", 3) }
    else if streq(mk_str(ty, strlen(ty)), mk_str("(ref $slice_u8)", 15)) != 0 { mk_str("Slice", 5) }
    else { mk_str("", 0) }

def wat_expr_is_definite_integer_scalar(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_definite_integer_scalar(value)
        L7CoreOp(value, _) => wat_expr_is_definite_integer_scalar(value)
        L6OpClosureEnv(value, _) => wat_expr_is_definite_integer_scalar(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_definite_integer_scalar(value)
        L5OpCps(value, _) => wat_expr_is_definite_integer_scalar(value)
        L4OpUsage(value, _) => wat_expr_is_definite_integer_scalar(value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyUnknown => wat_expr_is_definite_integer_scalar(value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_expr_is_definite_integer_scalar(value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L1OpInt(_) => 1
        L1OpBool(_) => 1
        L1OpUnit => 1
        L1OpPrefix(_, _) => 1
        L1OpBinary(_, _, _) => 1
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("", 0)) != 0 { wat_expr_is_definite_integer_scalar(value) }
                    else { wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty)) }
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty))
            }
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, name) => wat_local_name_is_bool(name)
                _ => 0
            }
        L1OpField(value, field) => wat_valtype_is_integer_scalar(wat_field_valtype_from_expr(value, field))
        L1OpCall(callee, _) => {
            let call_name = wat_expr_call_name(callee)
            let known_ty = wat_known_call_result_valtype(call_name)
            if wat_valtype_is_integer_scalar(known_ty) != 0 { 1 }
            else { wat_known_predicate_method_result(call_name) }
        }
        _ => 0
    }

def wat_call_name_from_expr(expr: CirExpr): Str =
    match wat_call_callee_shape(expr) {
        L2OpTyped(L1OpRef(ref), _) => wat_ref_call_name(ref)
        L1OpRef(ref) => wat_ref_call_name(ref)
        _ => wat_expr_call_name(expr)
    }

def wat_call_name_from_expr_keep_type(expr: CirExpr): Str =
    match wat_unwrap_pass_expr_keep_type(expr) {
        L2OpTyped(L1OpRef(ref), _) => wat_ref_call_name(ref)
        L1OpRef(ref) => wat_ref_call_name(ref)
        _ => wat_expr_call_name(expr)
    }

def wat_expr_is_definite_integer_scalar_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyUnknown => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L1OpRef(L1RefLocal(id, name)) => {
            let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
            if wat_text_nonempty(param_ty) != 0 { wat_valtype_is_integer_scalar(param_ty) }
            else {
                let local_ty = wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id)
                if wat_text_nonempty(local_ty) != 0 { wat_valtype_is_integer_scalar(local_ty) }
                else if wat_local_id_value_is_scalar_truthy_in_expr(items, func_name, params, body, body, id) != 0 { 1 }
                else { wat_local_name_is_bool(name) }
            }
        }
        L1OpField(value, field) => {
            let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
            let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
            let ty = if owner.len != 0 { wat_field_valtype_from_owner(owner, field) }
            else { wat_field_valtype_from_expr(value, field) }
            wat_valtype_is_integer_scalar(ty)
        }
        L1OpCall(_, _) => wat_valtype_is_integer_scalar(wat_expr_call_result_valtype_with_body(items, func_name, params, body, expr))
        _ => wat_expr_is_definite_integer_scalar(expr)
    }

def wat_source_items(ast: AST): AST =
    match ast {
        SourceFile(_, _, items) => items
        _ => Item_End
    }

def wat_is_gc_builtin_ref_name(name: Str): i64 =
    if streq(name, mk_str("Array", 5)) != 0 { 1 }
    else if streq(name, mk_str("Vec", 3)) != 0 { 1 }
    else if streq(name, mk_str("Option", 6)) != 0 { 1 }
    else if streq(name, mk_str("AST", 3)) != 0 { 1 }
    else if streq(name, mk_str("DiagnosticBuilder", 17)) != 0 { 1 }
    else { 0 }

def wat_ast_variant_declares_name(variant: AST, name: Str): i64 =
    match variant {
        AdtVariant(variant_name, _) => streq(variant_name, name)
        _ => 0
    }

def wat_ast_variants_declare_name(variants: AST, name: Str): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            if wat_ast_variant_declares_name(head, name) != 0 { 1 }
            else { wat_ast_variants_declare_name(tail, name) }
        _ => 0
    }

def wat_ast_item_declares_heap_ref_name(item: AST, name: Str): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_declares_heap_ref_name(inner, name)
        Item_Type(ty) =>
            match ty {
                TypeItem(type_name, _, _) => streq(type_name, name)
                TypeDecl(type_name, _, TypeDecl_Record(_)) => streq(type_name, name)
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(type_name, _, _) => streq(type_name, name)
                AdtItem(data_name, _, variants) =>
                    if streq(data_name, name) != 0 { 1 }
                    else { wat_ast_variants_declare_name(variants, name) }
                _ => 0
            }
        _ => 0
    }

def wat_ast_declares_heap_ref_name(items: AST, name: Str): i64 =
    if wat_is_gc_builtin_ref_name(name) != 0 { 1 }
    else {
        match items {
            Item_Cons(head, tail) =>
                if wat_ast_item_declares_heap_ref_name(head, name) != 0 { 1 }
                else { wat_ast_declares_heap_ref_name(tail, name) }
            _ => 0
        }
    }

def wat_is_scalar_type_name(name: Str): i64 =
    if streq(name, mk_str("i64", 3)) != 0 { 1 }
    else if streq(name, mk_str("i32", 3)) != 0 { 1 }
    else if streq(name, mk_str("usize", 5)) != 0 { 1 }
    else if streq(name, mk_str("u8", 2)) != 0 { 1 }
    else if streq(name, mk_str("bool", 4)) != 0 { 1 }
    else { 0 }

def wat_valtype_from_ast_in(items: AST, ty: AST): i64 =
    match ty {
        Type_Path(name, Type_Tail_Generic(_)) =>
            if streq(name, mk_str("Slice", 5)) != 0 { "(ref $slice_u8)" }
            else if wat_is_scalar_type_name(name) != 0 { "i64" }
            else { "eqref" }
        Type_Path(name, _) =>
            if streq(name, mk_str("", 0)) != 0 { "i64" }
            else if wat_is_scalar_type_name(name) != 0 { "i64" }
            else if streq(name, mk_str("String", 6)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("Str", 3)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("AST", 3)) != 0 { "eqref" }
            else if streq(name, mk_str("str", 3)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("Slice", 5)) != 0 { "(ref $slice_u8)" }
            else if wat_ast_declares_heap_ref_name(items, name) != 0 { "eqref" }
            else { "eqref" }
        _ => "i64"
    }

def wat_valtype_from_cir(ty: CirType): i64 =
    match ty {
        CirTyUnknown => ""
        CirTyString => "(ref $array_u8)"
        CirTyStr => "(ref $array_u8)"
        CirTySliceU8 => "(ref $slice_u8)"
        CirTyFn(_, _) => "funcref"
        CirTyContinuation(_, _, _) => "eqref"
        CirTyTuple(_) => "eqref"
        CirTyApp(_, _) => "eqref"
        CirTyConst(name) =>
            if wat_is_scalar_type_name(name) != 0 { "i64" }
            else if streq(name, mk_str("String", 6)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("Str", 3)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("str", 3)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("Slice", 5)) != 0 { "(ref $slice_u8)" }
            else { "eqref" }
        CirTyNominal(_, _) => "eqref"
        CirTyData(_, _) => "eqref"
        CirTyUnion(_, _) => "eqref"
        _ => "i64"
    }

def wat_type_is_i64_storage(ty: CirType): i64 =
    match ty {
        CirTyI64 => 1
        CirTyI32 => 1
        CirTyUsize => 1
        CirTyBool => 1
        CirTyConst(name) =>
            if streq(name, mk_str("u8", 2)) != 0 { 1 }
            else if wat_is_scalar_type_name(name) != 0 { 1 }
            else { 0 }
        _ => 0
    }

def wat_tuple_field_index_loop(field: Str, i: i64, acc: i64): i64 =
    if i >= field.len { acc - 1 }
    else {
        let ch = load8(field.ptr, i)
        if ch < 48 || ch > 57 { -1 }
        else { wat_tuple_field_index_loop(field, i + 1, acc * 10 + (ch - 48)) }
    }

def wat_tuple_field_index(field: Str): i64 =
    if field.len == 0 { -1 }
    else if field.len < 2 { -1 }
    else if load8(field.ptr, 0) != 95 { -1 }
    else if load8(field.ptr, 1) < 49 || load8(field.ptr, 1) > 57 { -1 }
    else { wat_tuple_field_index_loop(field, 1, 0) }

def wat_emit_tuple_struct_new(out: Str, depth: i64, args: CirExprList): i64 = {
    let layout = wat_tuple_layout_name_from_list(wat_expr_list_types(args))
    if streq(layout, mk_str("", 0)) != 0 {
        wat_line(out, depth, "unreachable ;; tuple arity/layout unsupported")
    } else {
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "struct.new $")
        let _ = str_append(out, layout)
        str_push(out, 10)
    }
}

def wat_expr_list_all_i64_storage(args: CirExprList): i64 =
    match args {
        CirExprEnd => 1
        CirExprCons(head, tail) =>
            if streq(mk_str(wat_valtype_from_expr(head), strlen(wat_valtype_from_expr(head))), mk_str("i64", 3)) != 0 { wat_expr_list_all_i64_storage(tail) } else { 0 }
    }

def wat_expr_list_types(args: CirExprList): CirTypeList =
    match args {
        CirExprEnd => CirTypeEnd
        CirExprCons(head, tail) => CirTypeCons(wat_expr_type(head), wat_expr_list_types(tail))
    }

def wat_valtype_from_ast(ty: AST): i64 =
    wat_valtype_from_ast_in(Item_End, ty)

def wat_type_owner_name_from_ast(ty: AST): Str =
    match ty {
        Type_Path(name, _) =>
            if streq(name, mk_str("String", 6)) != 0 { mk_str("String", 6) }
            else if streq(name, mk_str("Str", 3)) != 0 { mk_str("str", 3) }
            else if streq(name, mk_str("str", 3)) != 0 { mk_str("str", 3) }
            else if wat_is_scalar_type_name(name) != 0 { mk_str("", 0) }
            else { name }
        _ => mk_str("", 0)
    }

def wat_ast_def_params(rest: AST): AST =
    match rest {
        DefFun(_, params, _, _) => params
        _ => Param_End
    }

def wat_ast_def_ret(rest: AST): AST =
    match rest {
        DefFun(_, _, ret, _) => ret
        _ => Type_Path(mk_str("", 0), Type_Tail_End)
    }

def wat_ast_params_has_index(params: AST, index: i64): i64 =
    match params {
        Param_Cons(_, tail) =>
            if index == 0 { 1 }
            else { wat_ast_params_has_index(tail, index - 1) }
        _ => 0
    }

def wat_ast_nominal_fields_has_index(fields: AST, index: i64): i64 =
    match fields {
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(_, _) =>
                    if index == 0 { 1 }
                    else { wat_ast_nominal_fields_has_index(tail, index - 1) }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, _) =>
                            if index == 0 { 1 }
                            else { wat_ast_nominal_fields_has_index(tail, index - 1) }
                        _ => wat_ast_nominal_fields_has_index(tail, index)
                    }
                _ => wat_ast_nominal_fields_has_index(tail, index)
            }
        _ => 0
    }

def wat_ast_nominal_field_index(fields: AST, field: Str, index: i64): i64 =
    match fields {
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(name, _) =>
                    if streq(name, field) != 0 { index }
                    else { wat_ast_nominal_field_index(tail, field, index + 1) }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(name, _) =>
                            if streq(name, field) != 0 { index }
                            else { wat_ast_nominal_field_index(tail, field, index + 1) }
                        _ => wat_ast_nominal_field_index(tail, field, index)
                    }
                _ => wat_ast_nominal_field_index(tail, field, index)
            }
        _ => -1
    }

def wat_ast_item_record_field_index(item: AST, owner: Str, field: Str): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_record_field_index(inner, owner, field)
        Item_Type(ty) =>
            match ty {
                TypeDecl(name, _, TypeDecl_Record(fields)) =>
                    if streq(name, owner) != 0 { wat_ast_nominal_field_index(fields, field, 0) } else { -1 }
                TypeItem(name, _, fields) =>
                    if streq(name, owner) != 0 { wat_ast_nominal_field_index(fields, field, 0) } else { -1 }
                _ => -1
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) =>
                    if streq(name, owner) != 0 { wat_ast_nominal_field_index(fields, field, 0) } else { -1 }
                _ => -1
            }
        _ => -1
    }

def wat_ast_record_field_index(items: AST, owner: Str, field: Str): i64 =
    match items {
        Item_Cons(head, tail) => {
            let found = wat_ast_item_record_field_index(head, owner, field)
            if found >= 0 { found } else { wat_ast_record_field_index(tail, owner, field) }
        }
        _ => -1
    }

def wat_ast_item_record_field_count(item: AST, owner: Str): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_record_field_count(inner, owner)
        Item_Type(ty) =>
            match ty {
                TypeDecl(name, _, TypeDecl_Record(fields)) =>
                    if streq(name, owner) != 0 { wat_nominal_field_count(fields) } else { -1 }
                TypeItem(name, _, fields) =>
                    if streq(name, owner) != 0 { wat_nominal_field_count(fields) } else { -1 }
                _ => -1
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) =>
                    if streq(name, owner) != 0 { wat_nominal_field_count(fields) } else { -1 }
                _ => -1
            }
        _ => -1
    }

def wat_ast_record_field_count(items: AST, owner: Str): i64 =
    match items {
        Item_Cons(head, tail) => {
            let found = wat_ast_item_record_field_count(head, owner)
            if found >= 0 { found } else { wat_ast_record_field_count(tail, owner) }
        }
        _ => -1
    }

def wat_ast_item_record_field_layout_name(item: AST, owner: Str, field: Str): Str =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_record_field_layout_name(inner, owner, field)
        Item_Type(ty) =>
            match ty {
                TypeDecl(name, _, TypeDecl_Record(fields)) =>
                    if streq(name, owner) != 0 && wat_ast_nominal_field_index(fields, field, 0) >= 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, name, name, wat_nominal_field_count(fields))
                        out
                    } else { mk_str("", 0) }
                TypeItem(name, _, fields) =>
                    if streq(name, owner) != 0 && wat_ast_nominal_field_index(fields, field, 0) >= 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, name, name, wat_nominal_field_count(fields))
                        out
                    } else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) =>
                    if streq(name, owner) != 0 && wat_ast_nominal_field_index(fields, field, 0) >= 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, name, name, wat_nominal_field_count(fields))
                        out
                    } else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
        _ => mk_str("", 0)
    }

def wat_ast_record_field_layout_name(items: AST, owner: Str, field: Str): Str =
    match items {
        Item_Cons(head, tail) => {
            let found = wat_ast_item_record_field_layout_name(head, owner, field)
            if found.len != 0 { found } else { wat_ast_record_field_layout_name(tail, owner, field) }
        }
        _ => mk_str("", 0)
    }

def wat_ast_nominal_fields_count_is(fields: AST, arity: i64): i64 =
    if wat_nominal_field_count(fields) == arity { 1 } else { 0 }

def wat_ast_variant_args_count_is(args: AST, arity: i64): i64 =
    if wat_variant_arg_field_count(args) == arity { 1 } else { 0 }

def wat_ast_variants_declare_ctor_arity(variants: AST, name: Str, arity: i64): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            match head {
                AdtVariant(variant_name, args) =>
                    if streq(variant_name, name) != 0 && wat_ast_variant_args_count_is(args, arity) != 0 { 1 }
                    else { wat_ast_variants_declare_ctor_arity(tail, name, arity) }
                _ => wat_ast_variants_declare_ctor_arity(tail, name, arity)
            }
        _ => 0
    }

def wat_layout_name_with_owner(out: Str, owner: Str, name: Str, arity: i64): i64 = {
    let _ = str_append(out, owner)
    let _ = str_push_cstr(out, "__")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, "__a")
    str_append_i64(out, arity)
}

def wat_ast_variants_ctor_layout_name(owner: Str, variants: AST, name: Str, arity: i64): Str =
    match variants {
        AdtVariant_Cons(head, tail) =>
            match head {
                AdtVariant(variant_name, args) =>
                    if streq(variant_name, name) != 0 && wat_ast_variant_args_count_is(args, arity) != 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, owner, name, arity)
                        out
                    } else { wat_ast_variants_ctor_layout_name(owner, tail, name, arity) }
                _ => wat_ast_variants_ctor_layout_name(owner, tail, name, arity)
            }
        _ => mk_str("", 0)
    }

def wat_ast_item_ctor_layout_name(item: AST, name: Str, arity: i64): Str =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_ctor_layout_name(inner, name, arity)
        Item_Type(ty) =>
            match ty {
                TypeDecl(type_name, _, TypeDecl_Record(fields)) =>
                    if streq(type_name, name) != 0 && wat_ast_nominal_fields_count_is(fields, arity) != 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, type_name, name, arity)
                        out
                    } else { mk_str("", 0) }
                TypeItem(type_name, _, fields) =>
                    if streq(type_name, name) != 0 && wat_ast_nominal_fields_count_is(fields, arity) != 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, type_name, name, arity)
                        out
                    } else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(type_name, _, fields) =>
                    if streq(type_name, name) != 0 && wat_ast_nominal_fields_count_is(fields, arity) != 0 {
                        let out = str_new()
                        let _ = wat_layout_name_with_owner(out, type_name, name, arity)
                        out
                    } else { mk_str("", 0) }
                AdtItem(owner, _, variants) => wat_ast_variants_ctor_layout_name(owner, variants, name, arity)
                _ => mk_str("", 0)
            }
        _ => mk_str("", 0)
    }

def wat_ast_ctor_layout_name(items: AST, name: Str, arity: i64): Str =
    match items {
        Item_Cons(head, tail) => {
            let found = wat_ast_item_ctor_layout_name(head, name, arity)
            if found.len != 0 { found } else { wat_ast_ctor_layout_name(tail, name, arity) }
        }
        _ => mk_str("", 0)
    }

def wat_builtin_compat_ctor_layout(name: Str, arity: i64): Str =
    if arity == 0 && streq(name, mk_str("Nil", 3)) != 0 { mk_str("List__ListNil__a0", 17) }
    else if arity == 2 && streq(name, mk_str("Cons", 4)) != 0 { mk_str("List__ListCons__a2", 18) }
    else if arity == 0 && streq(name, mk_str("None", 4)) != 0 { mk_str("Option__None__a0", 16) }
    else if arity == 0 && streq(name, mk_str("CoreExprUnit", 12)) != 0 { mk_str("CoreExprKind__CoreExprUnit__a0", 30) }
    else if arity == 1 && streq(name, mk_str("CoreExprI32Const", 16)) != 0 { mk_str("CoreExprKind__CoreExprI32Const__a1", 34) }
    else if arity == 1 && streq(name, mk_str("CoreExprParam", 13)) != 0 { mk_str("CoreExprKind__CoreExprParam__a1", 31) }
    else if arity == 2 && streq(name, mk_str("CoreExprTypedParam", 18)) != 0 { mk_str("CoreExprKind__CoreExprTypedParam__a2", 36) }
    else if arity == 2 && streq(name, mk_str("CoreExprLocal", 13)) != 0 { mk_str("CoreExprKind__CoreExprLocal__a2", 31) }
    else if arity == 1 && streq(name, mk_str("CoreExprStringLiteral", 21)) != 0 { mk_str("CoreExprKind__CoreExprStringLiteral__a1", 39) }
    else if arity == 2 && streq(name, mk_str("CoreExprCast", 12)) != 0 { mk_str("CoreExprKind__CoreExprCast__a2", 30) }
