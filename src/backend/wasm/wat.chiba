                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let _ = if id >= 0 {
                            let _ = wat_emit_match_nested_payload_expr_with_body(out, depth, items, func_name, params, body_ctx, outer_layout, outer_index, value)
                            let _ = wat_emit_ref_cast_layout(out, depth, items, nested_layout)
                            let _ = wat_emit_struct_get_layout(out, depth, items, nested_layout, nested_index)
                            let _ = wat_indent(out, depth)
                            let _ = str_push_cstr(out, "local.set ")
                            let _ = wat_local_name(out, id)
                            str_push(out, 10)
                        } else { 0 }
                        0
                    }
                _ => 0
            }
            wat_match_nested_pattern_arg_store_with_body(out, depth, items, func_name, params, body_ctx, outer_layout, outer_index, nested_variant, tail, value, body, nested_index + 1)
        }
        _ => 0
    }

def wat_match_pattern_arg_store_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, variant: Str, args: AST, index: i64, value: CirExpr, body: CirExpr): i64 =
    match args {
        PatternList_Cons(head, tail) => {
            let _ = match head {
