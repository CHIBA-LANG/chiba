def wat_match_pattern_arg_binder_valtype_by_id(items: AST, variant: Str, args: AST, body: CirExpr, id: i64, index: i64): i64 =
    match args {
        PatternList_Cons(head, tail) => {
            let in_head = match head {
                Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => {
                    let local_id = wat_expr_local_id_by_name_in_expr(body, name)
                    if local_id == id { wat_match_pattern_binder_valtype(items, variant, index, name) } else { "" }
                }
                Pattern_IdentStart(name, _) => {
                    let local_id = wat_expr_local_id_by_name_in_expr(body, name)
                    if local_id == id { wat_match_pattern_binder_valtype(items, variant, index, name) } else { "" }
                }
                _ => wat_match_pattern_binder_valtype_by_id(items, head, body, id)
            }
            if wat_text_nonempty(in_head) != 0 { in_head }
            else {
                let nested = match head {
                    Pattern_IdentStart(nested_variant, PatternAfterIdent_Atom(PatternIdent_Call(nested_args))) =>
                        wat_match_pattern_arg_binder_valtype_by_id(items, nested_variant, nested_args, body, id, 0)
                    Pattern_IdentStart(nested_variant, PatternAfterIdent_Bind(PatternIdent_Call(nested_args))) =>
                        wat_match_pattern_arg_binder_valtype_by_id(items, nested_variant, nested_args, body, id, 0)
                    _ => ""
                }
                if wat_text_nonempty(nested) != 0 { nested }
                else { wat_match_pattern_arg_binder_valtype_by_id(items, variant, tail, body, id, index + 1) }
            }
        }
        _ => ""
    }

def wat_match_pattern_binder_valtype_by_id(items: AST, pattern: AST, body: CirExpr, id: i64): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_binder_valtype_by_id(items, variant, args, body, id, 0)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_binder_valtype_by_id(items, variant, args, body, id, 0)
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => {
            let local_id = wat_expr_local_id_by_name_in_expr(body, name)
            if local_id == id { wat_match_pattern_binder_valtype(items, mk_str("", 0), 0, name) } else { "" }
        }
        _ => ""
    }

def wat_local_valtype_by_id_in_match_arms(items: AST, func_name: Str, params: CirParamList, body: CirExpr, arms: CirMatchArmList, id: i64): i64 =
    match arms {
        CirMatchArmEnd => ""
        CirMatchArmCons(arm, rest) => {
            let in_head = match arm {
                L1MatchArm(pattern, _, arm_body) => {
                    let from_pattern = wat_match_pattern_binder_valtype_by_id(items, pattern, arm_body, id)
                    if wat_text_nonempty(from_pattern) != 0 { from_pattern }
                    else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, arm_body, id) }
                }
                _ => ""
            }
            if wat_text_nonempty(in_head) != 0 { in_head } else { wat_local_valtype_by_id_in_match_arms(items, func_name, params, body, rest, id) }
        }
    }

def wat_known_call_result_owner(name: Str): Str = {
    let exact = wat_known_call_result_owner_local(name)
    if exact.len != 0 { exact } else { wat_known_call_result_owner_local(wat_symbol_name_last_part(name)) }
}

def wat_known_call_result_owner_local(name: Str): Str =
    if streq(name, mk_str("new", 3)) != 0 { mk_str("Vec", 3) }
    else if streq(name, mk_str("push", 4)) != 0 { mk_str("Vec", 3) }
    else if streq(name, mk_str("freeze", 6)) != 0 { mk_str("Array", 5) }
    else if streq(name, mk_str("Array.slice", 11)) != 0 { mk_str("Slice", 5) }
    else if streq(name, mk_str("Array.to_slice", 14)) != 0 { mk_str("Slice", 5) }
    else if streq(name, mk_str("Slice.slice", 11)) != 0 { mk_str("Slice", 5) }
    else if streq(name, mk_str("generate_parser", 15)) != 0 { mk_str("GeneratedParser", 15) }
    else if streq(name, mk_str("generated_parser_text", 21)) != 0 { mk_str("String", 6) }
    else if streq(name, mk_str("concat", 6)) != 0 { mk_str("String", 6) }
    else { mk_str("", 0) }

def wat_expr_call_name(expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_call_name(value)
        L7CoreOp(value, _) => wat_expr_call_name(value)
        L6OpClosureEnv(value, _) => wat_expr_call_name(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_call_name(value)
        L5OpCps(value, _) => wat_expr_call_name(value)
        L4OpUsage(value, _) => wat_expr_call_name(value)
        L3OpAnswerControl(value, _, _) => wat_expr_call_name(value)
        L2OpTyped(value, _) => wat_expr_call_name(value)
        L1OpRef(ref) =>
            match ref {
                L1RefGlobal(_, _, _) => wat_ref_call_name(ref)
                L1RefUnresolved(_, _) => wat_ref_call_name(ref)
                L1RefLocal(_, _) => wat_ref_call_name(ref)
                _ => mk_str("", 0)
            }
        L1OpField(value, field) => {
            let owner = wat_expr_method_owner(value)
            if owner.len == 0 { mk_str("", 0) }
            else { wat_method_name(owner, field) }
        }
        L0OpField(value, field) => {
            let owner = wat_expr_method_owner(value)
            if owner.len == 0 { mk_str("", 0) }
            else { wat_method_name(owner, field) }
        }
        L1OpTypeApply(value, _) => wat_expr_call_name(value)
        L0OpTypeApply(value, _) => wat_expr_call_name(value)
        _ => mk_str("", 0)
    }

def wat_emit_import_params(out: Str, items: AST, params: CirParamList): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(_, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                L0Param(_, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_import_params(out, items, rest)
        }
    }

def wat_emit_known_import_sig(out: Str, name: Str): i64 =
    if streq(name, mk_str("Array.len", 9)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result i64)")
        1
    } else if streq(name, mk_str("Array.get", 9)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (result eqref)")
        1
    } else if streq(name, mk_str("Array.slice", 11)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (param i64) (result (ref $slice_u8))")
        1
    } else if streq(name, mk_str("Array.i64.len", 13)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result i64)")
        1
    } else if streq(name, mk_str("Array.i64.get", 13)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("Array.i64.slice", 15)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (param i64) (result (ref $slice_u8))")
        1
    } else if streq(name, mk_str("Array.to_slice", 14)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result (ref $slice_u8))")
        1
    } else if streq(name, mk_str("Slice.len", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (result i64)")
        1
    } else if streq(name, mk_str("Slice.get", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (param i64) (result eqref)")
        1
    } else if streq(name, mk_str("Slice.slice", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (param i64) (param i64) (result (ref $slice_u8))")
        1
    } else if streq(name, mk_str("Vec.new", 7)) != 0 {
        let _ = str_push_cstr(out, " (result eqref)")
        1
    } else if streq(name, mk_str("Vec.len", 7)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result i64)")
        1
    } else if streq(name, mk_str("Vec.push", 8)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param eqref) (result eqref)")
        1
    } else if streq(name, mk_str("Vec.freeze", 10)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.new", 21)) != 0 {
        let _ = str_push_cstr(out, " (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.push_str", 26)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param (ref $array_u8)) (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.finish", 24)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("String.len", 10)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (result i64)")
        1
    } else if streq(name, mk_str("String.byte_at", 14)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("String.slice", 12)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (param i64) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("String.char_at", 14)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("String.concat", 13)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param (ref $array_u8)) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.concat", 10)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param (ref $array_u8)) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.len", 7)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (result i64)")
        1
    } else if streq(name, mk_str("str.byte_at", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("str.slice", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (param i64) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.char_at", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else {
        0
    }

def wat_params_empty(params: CirParamList): i64 =
    match params {
        CirParamEnd => 1
        _ => 0
    }

def wat_emit_import(out: Str, items: AST, item: CirItem): i64 =
    match item {
        L1ItemExtern(binder, params, ret, import) => {
            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
            else {
                let _ = str_push_cstr(out, "  (import \"")
                let _ = str_append(out, import.module_name)
                let _ = str_push_cstr(out, "\" \"")
                let _ = str_append(out, import.symbol_name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_binder_func_name(out, binder)
                let handled = wat_emit_known_import_sig(out, binder.name)
                let _ = if handled == 0 {
                    let _ = wat_emit_import_params(out, items, params)
                    let _ = str_push_cstr(out, " (result ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ret))
                    str_push_cstr(out, ")")
                } else { 0 }
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            }
        }
        L8ValidatedCoreItemExtern(binder, params, ret, import) => {
            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
            else {
                let _ = str_push_cstr(out, "  (import \"")
                let _ = str_append(out, import.module_name)
                let _ = str_push_cstr(out, "\" \"")
                let _ = str_append(out, import.symbol_name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_binder_func_name(out, binder)
                let handled = wat_emit_known_import_sig(out, binder.name)
                let _ = if handled == 0 {
                    let _ = wat_emit_import_params(out, items, params)
                    let _ = str_push_cstr(out, " (result ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ret))
                    str_push_cstr(out, ")")
                } else { 0 }
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            }
        }
        _ => 0
    }

def wat_emit_imports(out: Str, ast_items: AST, items: CirItemList): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let _ = wat_emit_import(out, ast_items, item)
            wat_emit_imports(out, ast_items, rest)
        }
    }

def wat_item_defines_name(item: CirItem, name: Str): i64 =
    match item {
        L1ItemDef(binder, _, _, _) => streq(binder.name, name)
        L1ItemExtern(binder, _, _, _) => streq(binder.name, name)
        L8ValidatedCoreItemDef(binder, _, _, _) => streq(binder.name, name)
        L8ValidatedCoreItemExtern(binder, _, _, _) => streq(binder.name, name)
        _ => 0
    }

def wat_items_define_name(items: CirItemList, name: Str): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) =>
            if wat_item_defines_name(item, name) != 0 { 1 }
            else { wat_items_define_name(rest, name) }
    }

def wat_expr_list_references_unresolved(args: CirExprList, name: Str): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) =>
            if wat_expr_references_unresolved(head, name) != 0 { 1 }
            else { wat_expr_list_references_unresolved(tail, name) }
    }

def wat_stmt_list_references_unresolved(stmts: CirStmtList, name: Str): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let hit = match stmt {
                L1StmtLet(_, value) => wat_expr_references_unresolved(value, name)
                L1StmtLetPattern(_, value) => wat_expr_references_unresolved(value, name)
                L1StmtAssign(lhs, rhs) =>
                    if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
                    else { wat_expr_references_unresolved(rhs, name) }
                L1StmtExpr(value) => wat_expr_references_unresolved(value, name)
                L1StmtReturn(value) => wat_expr_references_unresolved(value, name)
                L1StmtFor(_, cond, body) =>
                    if wat_expr_references_unresolved(cond, name) != 0 { 1 }
                    else { wat_expr_references_unresolved(body, name) }
                _ => 0
            }
            if hit != 0 { 1 } else { wat_stmt_list_references_unresolved(rest, name) }
        }
    }

def wat_expr_references_unresolved(expr: CirExpr, name: Str): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_references_unresolved(value, name)
        L7CoreOp(value, _) => wat_expr_references_unresolved(value, name)
        L6OpClosureEnv(value, _) => wat_expr_references_unresolved(value, name)
        L5OpContinuationPackage(_, _, value) => wat_expr_references_unresolved(value, name)
        L5OpCps(value, _) => wat_expr_references_unresolved(value, name)
        L4OpUsage(value, _) => wat_expr_references_unresolved(value, name)
        L3OpAnswerControl(value, _, _) => wat_expr_references_unresolved(value, name)
        L2OpTyped(value, _) => wat_expr_references_unresolved(value, name)
        L1OpBlock(stmts, tail) =>
            if wat_stmt_list_references_unresolved(stmts, name) != 0 { 1 }
            else { wat_expr_references_unresolved(tail, name) }
        L1OpIf(cond, then_expr, else_expr) =>
            if wat_expr_references_unresolved(cond, name) != 0 { 1 }
            else if wat_expr_references_unresolved(then_expr, name) != 0 { 1 }
            else { wat_expr_references_unresolved(else_expr, name) }
        L1OpMatch(value, _) => wat_expr_references_unresolved(value, name)
        L1OpClosure(_, body) => wat_expr_references_unresolved(body, name)
        L1OpReset(_, body) => wat_expr_references_unresolved(body, name)
        L1OpShift(_, _, body) => wat_expr_references_unresolved(body, name)
        L1OpCall(callee, args) =>
            if wat_expr_references_unresolved(callee, name) != 0 { 1 }
            else {
                let call_name = wat_expr_call_name(callee)
                if streq(call_name, name) != 0 { 1 }
                else { wat_expr_list_references_unresolved(args, name) }
            }
        L1OpField(value, field) => {
            let owner = wat_expr_method_owner(value)
            let method_name = if owner.len == 0 { mk_str("", 0) } else { wat_method_name(owner, field) }
            if streq(method_name, name) != 0 { 1 } else { wat_expr_references_unresolved(value, name) }
        }
        L1OpIndex(value, args) =>
            if wat_expr_references_unresolved(value, name) != 0 { 1 }
            else { wat_expr_list_references_unresolved(args, name) }
        L1OpTypeApply(_, _) => 0
        L1OpAssign(lhs, rhs) =>
            if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
            else { wat_expr_references_unresolved(rhs, name) }
        L1OpUnsafe(value) => wat_expr_references_unresolved(value, name)
        L1OpCast(value, _) => wat_expr_references_unresolved(value, name)
        L1OpPrefix(_, value) => wat_expr_references_unresolved(value, name)
        L1OpBinary(_, lhs, rhs) =>
            if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
            else { wat_expr_references_unresolved(rhs, name) }
        L1OpRef(ref) =>
            match ref {
                L1RefUnresolved(_, ref_name) => streq(ref_name, name)
                L0RefName(ref_name) => streq(ref_name, name)
                _ => 0
            }
        _ => 0
    }

def wat_items_reference_unresolved(items: CirItemList, name: Str): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let hit = match item {
                L1ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L2ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L3ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L4ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L5ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L6ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L7CoreItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L8ValidatedCoreItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                _ => 0
            }
            if hit != 0 { 1 } else { wat_items_reference_unresolved(rest, name) }
        }
    }

def wat_emit_env_hole_import(out: Str, items: CirItemList, name: Str): i64 =
    if wat_items_define_name(items, name) != 0 { 0 }
    else if wat_builtin_runtime_defined(name) != 0 { 0 }
    else if wat_items_reference_unresolved(items, name) == 0 { 0 }
    else {
        let _ = str_push_cstr(out, "  (import \"env\" \"")
        let _ = str_append(out, name)
        let _ = str_push_cstr(out, "\" (func ")
        let _ = wat_func_name(out, name)
        let handled = wat_emit_known_import_sig(out, name)
        let _ = if handled == 0 { str_push_cstr(out, " (result i64)") } else { 0 }
        let _ = str_push_cstr(out, "))")
        str_push(out, 10)
    }

def wat_emit_env_hole_imports(out: Str, items: CirItemList): i64 = {
    let _ = wat_emit_env_hole_import(out, items, mk_str("left", 4))
    let _ = wat_emit_env_hole_import(out, items, mk_str("right", 5))
    let _ = wat_emit_env_hole_import(out, items, mk_str("share_state", 11))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.len", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.get", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.slice", 11))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.to_slice", 14))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Slice.len", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Slice.get", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Slice.slice", 11))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.new", 7))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.len", 7))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.push", 8))
    wat_emit_env_hole_import(out, items, mk_str("Vec.freeze", 10))
}

def wat_collect_expr_locals(out: Str, items: AST, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_collect_expr_locals(out, items, value)
        L7CoreOp(value, _) => wat_collect_expr_locals(out, items, value)
        L6OpClosureEnv(value, _) => wat_collect_expr_locals(out, items, value)
        L5OpContinuationPackage(binder, _, value) => {
            let _ = wat_emit_local_decl_with_type(out, binder.id, wat_let_local_decl_valtype(items, value))
            wat_collect_expr_locals(out, items, value)
        }
        L5OpCps(value, _) => wat_collect_expr_locals(out, items, value)
        L4OpUsage(value, _) => wat_collect_expr_locals(out, items, value)
        L3OpAnswerControl(value, _, _) => wat_collect_expr_locals(out, items, value)
        L2OpTyped(value, _) => wat_collect_expr_locals(out, items, value)
        L0OpBlock(stmts, tail) => {
            let _ = wat_collect_stmt_locals_with_tail(out, items, stmts, tail)
            wat_collect_expr_locals(out, items, tail)
        }
        L1OpBlock(stmts, tail) => {
            let _ = wat_collect_stmt_locals_with_tail(out, items, stmts, tail)
            wat_collect_expr_locals(out, items, tail)
        }
        L0OpIf(cond, then_expr, else_expr) => {
            let _ = wat_collect_expr_locals(out, items, cond)
            let _ = wat_collect_expr_locals(out, items, then_expr)
            wat_collect_expr_locals(out, items, else_expr)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let _ = wat_collect_expr_locals(out, items, cond)
            let _ = wat_collect_expr_locals(out, items, then_expr)
            wat_collect_expr_locals(out, items, else_expr)
        }
        L0OpMatch(value, arms) => {
            let _ = wat_collect_expr_locals(out, items, value)
            wat_collect_match_arm_locals_for_value(out, items, value, arms)
        }
        L1OpMatch(value, arms) => {
            let _ = wat_collect_expr_locals(out, items, value)
            wat_collect_match_arm_locals_for_value(out, items, value, arms)
        }
        L0OpClosure(params, body) => {
            let _ = wat_emit_params(out, Item_End, params)
            wat_collect_expr_locals(out, items, body)
        }
        L1OpClosure(params, body) => {
            let _ = wat_emit_params(out, Item_End, params)
            wat_collect_expr_locals(out, items, body)
        }
        L0OpReset(_, body) => wat_collect_expr_locals(out, items, body)
        L1OpReset(_, body) => wat_collect_expr_locals(out, items, body)
        L1OpShift(_, binder, body) => {
            let _ = wat_emit_local_decl(out, binder.id)
            wat_collect_expr_locals(out, items, body)
        }
        L1OpCall(callee, args) => {
            let _ = wat_collect_expr_locals(out, items, callee)
            wat_collect_expr_list_locals(out, items, args)
        }
        L0OpCall(callee, args) => {
            let _ = wat_collect_expr_locals(out, items, callee)
            wat_collect_expr_list_locals(out, items, args)
        }
        L0OpNominalCtor(_, fields) => wat_collect_record_field_expr_locals(out, items, fields)
        L1OpNominalCtor(_, fields) => wat_collect_record_field_expr_locals(out, items, fields)
        L0OpField(value, _) => wat_collect_expr_locals(out, items, value)
        L1OpField(value, _) => wat_collect_expr_locals(out, items, value)
        L0OpIndex(value, args) => {
            let _ = wat_collect_expr_locals(out, items, value)
            wat_collect_expr_list_locals(out, items, args)
        }
        L1OpIndex(value, args) => {
            let _ = wat_collect_expr_locals(out, items, value)
            wat_collect_expr_list_locals(out, items, args)
        }
        L0OpTypeApply(_, _) => 0
        L1OpTypeApply(_, _) => 0
        L1OpAssign(lhs, rhs) => {
            let _ = wat_collect_expr_locals(out, items, lhs)
            wat_collect_expr_locals(out, items, rhs)
        }
        L1OpUnsafe(value) => wat_collect_expr_locals(out, items, value)
        L1OpCast(value, _) => wat_collect_expr_locals(out, items, value)
        L1OpPrefix(_, value) => wat_collect_expr_locals(out, items, value)
        L1OpBinary(_, lhs, rhs) => {
            let _ = wat_collect_expr_locals(out, items, lhs)
            wat_collect_expr_locals(out, items, rhs)
        }
        _ => 0
    }

def wat_collect_match_pattern_locals(out: Str, items: AST, pattern: AST, body: CirExpr): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, variant, args, body, 0)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, variant, args, body, 0)
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => {
            let _ = if wat_pattern_name_is_ctor(items, name, 0) == 0 {
                let id = wat_expr_local_id_by_name_in_expr(body, name)
                if id >= 0 {
                    if wat_local_name_is_bool(name) != 0 { wat_emit_local_decl(out, id) }
                    else { wat_emit_local_decl_with_type(out, id, "eqref") }
                } else { 0 }
            } else { 0 }
            0
        }
        _ => 0
    }

def wat_collect_match_pattern_locals_for_value(out: Str, items: AST, pattern: AST, value: CirExpr, body: CirExpr): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, wat_pattern_variant_layout_for_value(items, variant, args, value), args, body, 0)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, wat_pattern_variant_layout_for_value(items, variant, args, value), args, body, 0)
        _ => wat_collect_match_pattern_locals(out, items, pattern, body)
    }

def wat_collect_match_pattern_arg_locals(out: Str, items: AST, variant: Str, args: AST, body: CirExpr, index: i64): i64 =
    match args {
        PatternList_Cons(head, tail) => {
            let _ = match head {
                Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) =>
                    if name.len == 0 { 0 }
                    else {
                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let binder_ty = wat_match_pattern_binder_valtype(items, variant, index, name)
                        let _ = if id >= 0 {
                            wat_emit_local_decl_with_type(out, id, binder_ty)
                        } else { 0 }
                        0
                    }
                Pattern_IdentStart(name, _) =>
                    if name.len == 0 { 0 }
                    else {
                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let binder_ty = wat_match_pattern_binder_valtype(items, variant, index, name)
                        let _ = if id >= 0 {
                            wat_emit_local_decl_with_type(out, id, binder_ty)
                        } else { 0 }
                        0
                    }
                _ => wat_collect_match_pattern_locals(out, items, head, body)
            }
            let _ = match head {
                Pattern_IdentStart(nested_variant, PatternAfterIdent_Atom(PatternIdent_Call(nested))) =>
                    wat_collect_match_pattern_arg_locals(out, items, nested_variant, nested, body, 0)
                Pattern_IdentStart(nested_variant, PatternAfterIdent_Bind(PatternIdent_Call(nested))) =>
                    wat_collect_match_pattern_arg_locals(out, items, nested_variant, nested, body, 0)
                _ => 0
            }
            wat_collect_match_pattern_arg_locals(out, items, variant, tail, body, index + 1)
        }
        _ => 0
    }

def wat_collect_match_arm_locals(out: Str, items: AST, arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmEnd => 0
        CirMatchArmCons(arm, rest) => {
            let _ = match arm {
                L1MatchArm(pattern, _, body) => {
                    let _ = wat_collect_match_pattern_locals(out, items, pattern, body)
                    wat_collect_expr_locals(out, items, body)
                }
                _ => 0
            }
            wat_collect_match_arm_locals(out, items, rest)
        }
    }

def wat_collect_match_arm_locals_for_value(out: Str, items: AST, value: CirExpr, arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmEnd => 0
        CirMatchArmCons(arm, rest) => {
            let _ = match arm {
                L1MatchArm(pattern, _, body) => {
                    let _ = wat_collect_match_pattern_locals_for_value(out, items, pattern, value, body)
                    wat_collect_expr_locals(out, items, body)
                }
                _ => 0
            }
            wat_collect_match_arm_locals_for_value(out, items, value, rest)
        }
    }

def wat_collect_expr_list_locals(out: Str, items: AST, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_collect_expr_locals(out, items, head)
            wat_collect_expr_list_locals(out, items, tail)
        }
    }

def wat_collect_record_field_expr_locals(out: Str, items: AST, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let _ = wat_collect_expr_locals(out, items, head.value)
            wat_collect_record_field_expr_locals(out, items, tail)
        }
    }

def wat_collect_stmt_locals_with_tail(out: Str, items: AST, stmts: CirStmtList, tail_expr: CirExpr): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let body_ctx = L1OpBlock(rest, tail_expr)
            let _ = match stmt {
                L1StmtLet(binder, value) => {
                    let _ = wat_emit_local_decl_with_type(out, binder.id, wat_let_local_decl_valtype(items, value))
                    wat_collect_expr_locals(out, items, value)
                }
                L1StmtLetPattern(pattern, value) => {
                    let _ = wat_collect_match_pattern_locals_for_value(out, items, pattern, value, body_ctx)
                    wat_collect_expr_locals(out, items, value)
                }
                L1StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals(out, items, lhs)
                    wat_collect_expr_locals(out, items, rhs)
                }
                L1StmtExpr(value) => wat_collect_expr_locals(out, items, value)
                L1StmtReturn(value) => wat_collect_expr_locals(out, items, value)
                L1StmtFor(_, cond, body) => {
                    let _ = wat_collect_expr_locals(out, items, cond)
                    wat_collect_expr_locals(out, items, body)
                }
                L2StmtLet(binder, ty, value) => {
                    let _ = wat_emit_local_decl_with_type(out, binder.id, wat_typed_let_local_decl_valtype(items, ty, value))
                    wat_collect_expr_locals(out, items, value)
                }
                L2StmtLetPattern(pattern, value) => {
                    let _ = wat_collect_match_pattern_locals_for_value(out, items, pattern, value, body_ctx)
                    wat_collect_expr_locals(out, items, value)
                }
                L2StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals(out, items, lhs)
                    wat_collect_expr_locals(out, items, rhs)
                }
                L2StmtExpr(value) => wat_collect_expr_locals(out, items, value)
                L2StmtReturn(value) => wat_collect_expr_locals(out, items, value)
                L2StmtFor(_, cond, body) => {
                    let _ = wat_collect_expr_locals(out, items, cond)
                    wat_collect_expr_locals(out, items, body)
                }
                _ => 0
            }
            wat_collect_stmt_locals_with_tail(out, items, rest, tail_expr)
        }
    }

def wat_collect_stmt_locals(out: Str, items: AST, stmts: CirStmtList): i64 =
    wat_collect_stmt_locals_with_tail(out, items, stmts, L1OpUnit)

def wat_collect_expr_locals_with_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L7CoreOp(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L6OpClosureEnv(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L5OpContinuationPackage(binder, _, value) => {
            let _ = wat_emit_local_decl_with_type(out, binder.id, wat_let_local_decl_valtype_with_body(items, func_name, params, body_ctx, value))
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        }
        L5OpCps(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L4OpUsage(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L3OpAnswerControl(value, _, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L2OpTyped(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L1OpUnsafe(value) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L0OpBlock(stmts, tail) => {
            let _ = wat_collect_stmt_locals_with_tail_body(out, items, func_name, params, body_ctx, stmts, tail)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, tail)
        }
        L1OpBlock(stmts, tail) => {
            let _ = wat_collect_stmt_locals_with_tail_body(out, items, func_name, params, body_ctx, stmts, tail)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, tail)
        }
        L0OpIf(cond, then_expr, else_expr) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, cond)
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, then_expr)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, else_expr)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, cond)
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, then_expr)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, else_expr)
        }
        L0OpMatch(value, arms) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
            wat_collect_match_arm_locals_with_body_for_value(out, items, func_name, params, body_ctx, value, arms)
        }
        L1OpMatch(value, arms) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
            wat_collect_match_arm_locals_with_body_for_value(out, items, func_name, params, body_ctx, value, arms)
        }
        L0OpClosure(closure_params, closure_body) => {
            let _ = wat_emit_params(out, Item_End, closure_params)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, closure_body)
        }
        L1OpClosure(closure_params, closure_body) => {
            let _ = wat_emit_params(out, Item_End, closure_params)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, closure_body)
        }
        L0OpReset(_, reset_body) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, reset_body)
        L1OpReset(_, reset_body) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, reset_body)
        L1OpShift(_, binder, shift_body) => {
            let _ = wat_emit_local_decl(out, binder.id)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, shift_body)
        }
        L1OpCall(callee, args) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, callee)
            wat_collect_expr_list_locals_with_body(out, items, func_name, params, body_ctx, args)
        }
        L0OpCall(callee, args) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, callee)
            wat_collect_expr_list_locals_with_body(out, items, func_name, params, body_ctx, args)
        }
        L0OpNominalCtor(_, fields) => wat_collect_record_field_expr_locals_with_body(out, items, func_name, params, body_ctx, fields)
        L1OpNominalCtor(_, fields) => wat_collect_record_field_expr_locals_with_body(out, items, func_name, params, body_ctx, fields)
        L0OpField(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L1OpField(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L0OpIndex(value, args) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
            wat_collect_expr_list_locals_with_body(out, items, func_name, params, body_ctx, args)
        }
        L1OpIndex(value, args) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
            wat_collect_expr_list_locals_with_body(out, items, func_name, params, body_ctx, args)
        }
        L1OpAssign(lhs, rhs) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, lhs)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, rhs)
        }
        L1OpCast(value, _) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L1OpPrefix(_, value) => wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, value)
        L1OpBinary(_, lhs, rhs) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, lhs)
            wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, rhs)
        }
        _ => 0
    }

def wat_collect_match_arm_locals_with_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmEnd => 0
        CirMatchArmCons(arm, rest) => {
            let _ = match arm {
                L1MatchArm(pattern, _, arm_body) => {
                    let _ = wat_collect_match_pattern_locals(out, items, pattern, arm_body)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, arm_body)
                }
                _ => 0
            }
            wat_collect_match_arm_locals_with_body(out, items, func_name, params, body_ctx, rest)
        }
    }

def wat_collect_match_pattern_locals_for_value_with_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, pattern: AST, value: CirExpr, body: CirExpr): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value), args, body, 0)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_collect_match_pattern_arg_locals(out, items, wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value), args, body, 0)
        _ => wat_collect_match_pattern_locals(out, items, pattern, body)
    }

def wat_collect_match_arm_locals_with_body_for_value(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, value: CirExpr, arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmEnd => 0
        CirMatchArmCons(arm, rest) => {
            let _ = match arm {
                L1MatchArm(pattern, _, arm_body) => {
                    let _ = wat_collect_match_pattern_locals_for_value_with_body(out, items, func_name, params, body_ctx, pattern, value, arm_body)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, arm_body)
                }
                _ => 0
            }
            wat_collect_match_arm_locals_with_body_for_value(out, items, func_name, params, body_ctx, value, rest)
        }
    }

def wat_collect_expr_list_locals_with_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, head)
            wat_collect_expr_list_locals_with_body(out, items, func_name, params, body_ctx, tail)
        }
    }

def wat_collect_record_field_expr_locals_with_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, body_ctx, head.value)
            wat_collect_record_field_expr_locals_with_body(out, items, func_name, params, body_ctx, tail)
        }
    }

def wat_collect_stmt_locals_with_tail_body(out: Str, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, stmts: CirStmtList, tail_expr: CirExpr): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let local_body_ctx = L1OpBlock(rest, tail_expr)
            let _ = match stmt {
                L1StmtLet(binder, value) => {
                    let _ = wat_emit_local_decl_with_type(out, binder.id, wat_let_local_decl_valtype_with_body(items, func_name, params, body_ctx, value))
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                }
                L1StmtLetPattern(pattern, value) => {
                    let _ = wat_collect_match_pattern_locals_for_value_with_body(out, items, func_name, params, local_body_ctx, pattern, value, local_body_ctx)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                }
                L1StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, lhs)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, rhs)
                }
                L1StmtExpr(value) => wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                L1StmtReturn(value) => wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                L1StmtFor(_, cond, loop_body) => {
                    let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, cond)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, loop_body)
                }
                L2StmtLet(binder, ty, value) => {
                    let _ = wat_emit_local_decl_with_type(out, binder.id, wat_typed_let_local_decl_valtype_with_body(items, func_name, params, body_ctx, ty, value))
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                }
                L2StmtLetPattern(pattern, value) => {
                    let _ = wat_collect_match_pattern_locals_for_value_with_body(out, items, func_name, params, local_body_ctx, pattern, value, local_body_ctx)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                }
                L2StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, lhs)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, rhs)
                }
                L2StmtExpr(value) => wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                L2StmtReturn(value) => wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, value)
                L2StmtFor(_, cond, loop_body) => {
                    let _ = wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, cond)
                    wat_collect_expr_locals_with_body(out, items, func_name, params, local_body_ctx, loop_body)
                }
                _ => 0
            }
            wat_collect_stmt_locals_with_tail_body(out, items, func_name, params, body_ctx, rest, tail_expr)
        }
    }

def wat_binary_instr(op: Str): i64 =
    if streq(op, mk_str("+", 1)) != 0 { "i64.add" }
    else if streq(op, mk_str("-", 1)) != 0 { "i64.sub" }
    else if streq(op, mk_str("*", 1)) != 0 { "i64.mul" }
    else if streq(op, mk_str("/", 1)) != 0 { "i64.div_s" }
    else if streq(op, mk_str("%", 1)) != 0 { "i64.rem_s" }
    else if streq(op, mk_str("==", 2)) != 0 { "i64.eq" }
    else if streq(op, mk_str("!=", 2)) != 0 { "i64.ne" }
    else if streq(op, mk_str("<", 1)) != 0 { "i64.lt_s" }
    else if streq(op, mk_str(">", 1)) != 0 { "i64.gt_s" }
    else if streq(op, mk_str("<=", 2)) != 0 { "i64.le_s" }
    else if streq(op, mk_str(">=", 2)) != 0 { "i64.ge_s" }
    else { "unreachable ;; unsupported-binary" }

def wat_binary_is_compare(op: Str): i64 =
    if streq(op, mk_str("==", 2)) != 0 { 1 }
    else if streq(op, mk_str("!=", 2)) != 0 { 1 }
    else if streq(op, mk_str("<", 1)) != 0 { 1 }
    else if streq(op, mk_str(">", 1)) != 0 { 1 }
    else if streq(op, mk_str("<=", 2)) != 0 { 1 }
    else if streq(op, mk_str(">=", 2)) != 0 { 1 }
    else { 0 }

def wat_valtype_is_array_u8(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("(ref $array_u8)", 15))

def wat_valtype_is_slice_u8(ty: i64): i64 =
    streq(mk_str(ty, strlen(ty)), mk_str("(ref $slice_u8)", 15))

def wat_valtype_is_ref_storage(ty: i64): i64 =
    if wat_valtype_is_i64(ty) != 0 { 0 }
    else if wat_valtype_is_i32(ty) != 0 { 0 }
    else if wat_text_nonempty(ty) == 0 { 0 }
    else { 1 }

def wat_expr_is_string_storage_in(items: AST, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_string_storage_in(items, value)
        L7CoreOp(value, _) => wat_expr_is_string_storage_in(items, value)
        L6OpClosureEnv(value, _) => wat_expr_is_string_storage_in(items, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_string_storage_in(items, value)
        L5OpCps(value, _) => wat_expr_is_string_storage_in(items, value)
        L4OpUsage(value, _) => wat_expr_is_string_storage_in(items, value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyString => 1
                CirTyStr => 1
                CirTyUnknown => wat_expr_is_string_storage_in(items, value)
                _ => wat_valtype_is_array_u8(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => 1
                CirTyStr => 1
                CirTyUnknown => wat_expr_is_string_storage_in(items, value)
                _ => wat_valtype_is_array_u8(wat_valtype_from_cir(ty))
            }
        L1OpUnsafe(value) => wat_expr_is_string_storage_in(items, value)
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("String", 6)) != 0 { 1 }
                    else if streq(name, mk_str("Str", 3)) != 0 { 1 }
                    else if streq(name, mk_str("str", 3)) != 0 { 1 }
                    else if streq(name, mk_str("", 0)) != 0 { wat_expr_is_string_storage_in(items, value) }
                    else { wat_valtype_is_array_u8(wat_valtype_from_ast_in(items, ty)) }
                _ => wat_valtype_is_array_u8(wat_valtype_from_ast_in(items, ty))
            }
        L1OpField(value, field) => wat_valtype_is_array_u8(wat_field_valtype_from_expr(value, field))
        _ => wat_valtype_is_array_u8(wat_valtype_from_expr_in(items, expr))
    }

def wat_expr_is_string_storage_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyString => 1
                CirTyStr => 1
                CirTyUnknown => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_array_u8(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => 1
                CirTyStr => 1
                CirTyUnknown => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_array_u8(wat_valtype_from_cir(ty))
            }
        L1OpUnsafe(value) => wat_expr_is_string_storage_with_body(items, func_name, params, body, value)
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("String", 6)) != 0 { 1 }
                    else if streq(name, mk_str("Str", 3)) != 0 { 1 }
                    else if streq(name, mk_str("str", 3)) != 0 { 1 }
                    else if streq(name, mk_str("", 0)) != 0 { wat_expr_is_string_storage_with_body(items, func_name, params, body, value) }
                    else { wat_valtype_is_array_u8(wat_valtype_from_ast_in(items, ty)) }
                _ => wat_valtype_is_array_u8(wat_valtype_from_ast_in(items, ty))
            }
        L1OpRef(L1RefLocal(id, _)) => {
            let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
            if wat_text_nonempty(param_ty) != 0 { wat_valtype_is_array_u8(param_ty) }
            else { wat_valtype_is_array_u8(wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id)) }
        }
        L1OpField(value, field) => {
            let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
            let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
            let ty = if owner.len != 0 { wat_field_valtype_from_owner(owner, field) } else { wat_field_valtype_from_expr(value, field) }
            wat_valtype_is_array_u8(ty)
        }
        _ => wat_valtype_is_array_u8(wat_valtype_from_expr_with_body(items, func_name, params, body, expr))
    }

def wat_binary_is_ref_equality_in(items: AST, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("==", 2)) == 0 && streq(op, mk_str("!=", 2)) == 0 { 0 }
    else if wat_binary_is_string_equality_in(items, op, lhs, rhs) != 0 { 0 }
    else if wat_expr_is_definite_integer_scalar(lhs) != 0 { 0 }
    else if wat_expr_is_definite_integer_scalar(rhs) != 0 { 0 }
    else {
        let lhs_ty = wat_valtype_from_expr_in(items, lhs)
        let rhs_ty = wat_valtype_from_expr_in(items, rhs)
        if wat_valtype_is_ref_storage(lhs_ty) == 0 { 0 }
        else if wat_valtype_is_ref_storage(rhs_ty) == 0 { 0 }
        else if wat_valtype_is_integer_scalar(lhs_ty) != 0 { 0 }
        else if wat_valtype_is_integer_scalar(rhs_ty) != 0 { 0 }
        else { 1 }
    }

def wat_binary_is_ref_equality_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("==", 2)) == 0 && streq(op, mk_str("!=", 2)) == 0 { 0 }
    else if wat_binary_is_string_equality_with_body(items, func_name, params, body, op, lhs, rhs) != 0 { 0 }
    else if wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, lhs) != 0 { 0 }
    else if wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, rhs) != 0 { 0 }
    else {
        let lhs_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, lhs)
        let rhs_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, rhs)
        if wat_valtype_is_ref_storage(lhs_ty) == 0 { 0 }
        else if wat_valtype_is_ref_storage(rhs_ty) == 0 { 0 }
        else if wat_valtype_is_integer_scalar(lhs_ty) != 0 { 0 }
        else if wat_valtype_is_integer_scalar(rhs_ty) != 0 { 0 }
        else { 1 }
    }

def wat_emit_array_u8_full_slice(out: Str, depth: i64, items: AST, expr: CirExpr): i64 = {
    let _ = wat_line(out, depth, "i32.const 0")
    let _ = wat_emit_expr_in(out, depth, items, expr)
    let _ = wat_line(out, depth, "i32.const 0")
    let _ = wat_emit_expr_in(out, depth, items, expr)
    let _ = wat_line(out, depth, "array.len")
    wat_line(out, depth, "struct.new $slice_u8")
}

def wat_emit_array_u8_full_slice_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 = {
    let _ = wat_line(out, depth, "i32.const 0")
    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, expr)
    let _ = wat_line(out, depth, "i32.const 0")
    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, expr)
    let _ = wat_line(out, depth, "array.len")
    wat_line(out, depth, "struct.new $slice_u8")
}

def wat_binary_is_string_equality_in(items: AST, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("==", 2)) == 0 && streq(op, mk_str("!=", 2)) == 0 { 0 }
    else if wat_expr_is_string_storage_in(items, lhs) == 0 { 0 }
    else { wat_expr_is_string_storage_in(items, rhs) }

def wat_binary_is_string_equality_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("==", 2)) == 0 && streq(op, mk_str("!=", 2)) == 0 { 0 }
    else if wat_expr_is_string_storage_with_body(items, func_name, params, body, lhs) == 0 { 0 }
    else { wat_expr_is_string_storage_with_body(items, func_name, params, body, rhs) }

def wat_binary_is_string_equality(op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    wat_binary_is_string_equality_in(Item_End, op, lhs, rhs)

def wat_binary_is_string_order_in(items: AST, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("<", 1)) == 0 && streq(op, mk_str(">", 1)) == 0 && streq(op, mk_str("<=", 2)) == 0 && streq(op, mk_str(">=", 2)) == 0 { 0 }
    else if wat_expr_is_string_storage_in(items, lhs) == 0 { 0 }
    else { wat_expr_is_string_storage_in(items, rhs) }

def wat_binary_is_string_order_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, op: Str, lhs: CirExpr, rhs: CirExpr): i64 =
    if streq(op, mk_str("<", 1)) == 0 && streq(op, mk_str(">", 1)) == 0 && streq(op, mk_str("<=", 2)) == 0 && streq(op, mk_str(">=", 2)) == 0 { 0 }
    else if wat_expr_is_string_storage_with_body(items, func_name, params, body, lhs) == 0 { 0 }
    else { wat_expr_is_string_storage_with_body(items, func_name, params, body, rhs) }

def wat_emit_string_order_from_cmp(out: Str, depth: i64, op: Str): i64 = {
    let _ = wat_line(out, depth, "i64.const 0")
    let _ = if streq(op, mk_str("<", 1)) != 0 { wat_line(out, depth, "i64.lt_s") }
        else if streq(op, mk_str(">", 1)) != 0 { wat_line(out, depth, "i64.gt_s") }
        else if streq(op, mk_str("<=", 2)) != 0 { wat_line(out, depth, "i64.le_s") }
        else { wat_line(out, depth, "i64.ge_s") }
    wat_line(out, depth, "i64.extend_i32_u")
}

def wat_expr_is_scalar_truthy(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_scalar_truthy(value)
        L7CoreOp(value, _) => wat_expr_is_scalar_truthy(value)
        L6OpClosureEnv(value, _) => wat_expr_is_scalar_truthy(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_scalar_truthy(value)
        L5OpCps(value, _) => wat_expr_is_scalar_truthy(value)
        L4OpUsage(value, _) => wat_expr_is_scalar_truthy(value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyUnknown => wat_expr_is_scalar_truthy(value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_expr_is_scalar_truthy(value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("", 0)) != 0 { wat_expr_is_scalar_truthy(value) }
                    else { wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty)) }
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty))
            }
        L1OpPrefix(_, _) => 1
        L1OpBinary(op, _, _) =>
            if wat_binary_is_compare(op) != 0 { 1 }
            else if streq(op, mk_str("&&", 2)) != 0 { 1 }
            else if streq(op, mk_str("||", 2)) != 0 { 1 }
            else { 1 }
        L1OpCall(callee, _) => {
            let call_name = wat_expr_call_name(callee)
            let known_ty = wat_known_call_result_valtype(call_name)
            if wat_valtype_is_integer_scalar(known_ty) != 0 { 1 }
            else { wat_known_predicate_method_result(call_name) }
        }
        L1OpField(value, field) => {
            let ty = wat_field_valtype_from_expr(value, field)
            wat_valtype_is_integer_scalar(ty)
        }
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, name) => wat_local_name_is_bool(name)
                _ => 0
            }
        L1OpInt(_) => 1
        L1OpBool(_) => 1
        L1OpUnit => 1
        _ => 0
    }

def wat_expr_is_scalar_truthy_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyUnknown => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value)
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_cir(ty))
            }
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("", 0)) != 0 { wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, value) }
                    else { wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty)) }
                _ => wat_valtype_is_integer_scalar(wat_valtype_from_ast(ty))
            }
        L1OpField(value, field) => {
            let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
            let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
            let ty = if owner.len != 0 { wat_field_valtype_from_owner(owner, field) } else { wat_field_valtype_from_expr(value, field) }
            wat_valtype_is_integer_scalar(ty)
        }
        L1OpCall(_, _) => wat_valtype_is_integer_scalar(wat_expr_call_result_valtype_with_body(items, func_name, params, body, expr))
        L1OpRef(L1RefLocal(id, name)) => {
            let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
            if wat_text_nonempty(param_ty) != 0 { wat_valtype_is_integer_scalar(param_ty) }
            else {
                let local_ty = wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id)
                if wat_text_nonempty(local_ty) != 0 { wat_valtype_is_integer_scalar(local_ty) }
                else { wat_local_name_is_bool(name) }
            }
        }
        _ => wat_expr_is_scalar_truthy(expr)
    }

def wat_emit_truthy_expr(out: Str, depth: i64, items: AST, expr: CirExpr): i64 = {
    let _ = wat_emit_expr_in(out, depth, items, expr)
    let ty = wat_valtype_from_expr_in(items, expr)
    if wat_valtype_is_i64(ty) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else if wat_valtype_is_i32(ty) != 0 {
        let _ = wat_line(out, depth, "i32.const 0")
        wat_line(out, depth, "i32.ne")
    } else if wat_expr_is_scalar_truthy(expr) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else if wat_expr_is_local_ref(expr) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else {
        let _ = wat_line(out, depth, "ref.is_null")
        wat_line(out, depth, "i32.eqz")
    }
}

def wat_emit_bool_i64_from_i32(out: Str, depth: i64): i64 =
    wat_line(out, depth, "i64.extend_i32_u")

def wat_is_ref_name(ref: CirRef, want: Str): i64 =
    match ref {
        L1RefGlobal(_, name, _) => streq(name, want)
        L1RefUnresolved(_, name) => streq(name, want)
        L0RefName(name) => streq(name, want)
        _ => 0
    }

def wat_is_string_char_method(field: Str): i64 =
    if streq(field, mk_str("char_at", 7)) != 0 { 1 }
    else if streq(field, mk_str("codepoint_at", 12)) != 0 { 1 }
    else { 0 }

def wat_is_string_concat_method(owner: Str, field: Str): i64 =
    if streq(field, mk_str("concat", 6)) == 0 { 0 }
    else if streq(owner, mk_str("String", 6)) != 0 { 1 }
    else if streq(owner, mk_str("str", 3)) != 0 { 1 }
    else { 0 }

def wat_is_string_to_slice_method(owner: Str, field: Str): i64 =
    if streq(field, mk_str("to_slice", 8)) == 0 { 0 }
    else if streq(owner, mk_str("String", 6)) != 0 { 1 }
    else if streq(owner, mk_str("str", 3)) != 0 { 1 }
    else { 0 }

def wat_is_array_like_owner(owner: Str): i64 =
    if streq(owner, mk_str("Array", 5)) != 0 { 1 }
    else if streq(owner, mk_str("Vec", 3)) != 0 { 1 }
    else { 0 }

def wat_ref_name_text(ref: CirRef): Str =
    match ref {
        L1RefGlobal(_, name, _) => name
        L1RefUnresolved(_, name) => name
        L0RefName(name) => name
        _ => mk_str("", 0)
    }

def wat_is_load8_name(name: Str): i64 =
    streq(name, mk_str("load8", 5))

def wat_emit_load8_call(out: Str, depth: i64, items: AST, args: CirExprList): i64 =
    match args {
        CirExprCons(ptr, CirExprCons(offset, CirExprEnd)) => {
            let _ = wat_emit_expr_in(out, depth, items, ptr)
            let _ = wat_emit_expr_in(out, depth, items, offset)
            let _ = wat_line(out, depth, "i32.wrap_i64")
            let _ = wat_line(out, depth, "array.get_u $array_u8")
            wat_line(out, depth, "i64.extend_i32_u")
        }
        _ => wat_line(out, depth, "unreachable ;; load8 arity unsupported")
    }

def wat_is_type_level_expr(expr: CirExpr): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpRef(L1RefGlobal(_, _, _)) => 1
        L1OpRef(L1RefUnresolved(_, _)) => 1
        L1OpRef(L0RefName(_)) => 1
        _ => 0
    }

def wat_type_list_first(args: CirTypeList): CirType =
    match args {
        CirTypeCons(head, _) => head
        _ => CirTyUnknown
    }

def wat_callable_ref_type_name(ty: CirType): Str =
    match ty {
        CirTyFn(params, ret) =>
            if wat_type_list_len(params) == 0 && wat_type_is_i64_storage(ret) != 0 { mk_str("chiba.fn0_i64", 13) }
            else if wat_type_list_len(params) == 1 && wat_type_is_i64_storage(wat_type_list_first(params)) != 0 && wat_type_is_i64_storage(ret) != 0 { mk_str("chiba.fn1_i64_i64", 17) }
            else { mk_str("", 0) }
        _ => mk_str("", 0)
    }

def wat_type_is_ref_layout(ty: CirType): i64 =
    match ty {
        CirTyString => 1
        CirTyStr => 1
        CirTySliceU8 => 1
        CirTyConst(name) =>
            if wat_is_scalar_type_name(name) != 0 { 0 } else { 1 }
        CirTyApp(_, _) => 1
        CirTyNominal(_, _) => 1
        CirTyData(_, _) => 1
        CirTyUnion(_, _) => 1
        _ => 0
    }

def wat_type_is_scalar_vec_or_array(ty: CirType): i64 =
    match ty {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(owner) =>
                    if streq(owner, mk_str("Vec", 3)) != 0 || streq(owner, mk_str("Array", 5)) != 0 {
                        wat_type_is_i64_storage(wat_type_list_first(args))
                    } else { 0 }
                _ => 0
            }
        _ => 0
    }

def wat_type_is_ref_vec_or_array(ty: CirType): i64 =
    match ty {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(owner) =>
                    if streq(owner, mk_str("Vec", 3)) != 0 || streq(owner, mk_str("Array", 5)) != 0 {
                        wat_type_is_ref_layout(wat_type_list_first(args))
                    } else { 0 }
                _ => 0
            }
        _ => 0
    }

def wat_expr_type(expr: CirExpr): CirType =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_type(value)
        L7CoreOp(value, _) => wat_expr_type(value)
        L6OpClosureEnv(value, _) => wat_expr_type(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_type(value)
        L5OpCps(value, _) => wat_expr_type(value)
        L4OpUsage(value, _) => wat_expr_type(value)
        L3OpAnswerControl(_, answer, _) => answer
        L2OpTyped(_, ty) => ty
        _ => CirTyUnknown
    }

def wat_expr_is_ref_vec_or_array(expr: CirExpr): i64 =
    wat_type_is_ref_vec_or_array(wat_expr_type(expr))

def wat_expr_is_scalar_vec_or_array(expr: CirExpr): i64 =
    wat_type_is_scalar_vec_or_array(wat_expr_type(expr))

def wat_expr_is_i64_type_application(expr: CirExpr): i64 =
    match wat_expr_type(expr) {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(_) => wat_type_is_i64_storage(wat_type_list_first(args))
                _ => 0
            }
        _ => 0
    }

def wat_expr_is_ref_type_application(expr: CirExpr): i64 =
    match wat_expr_type(expr) {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(_) => wat_type_is_ref_layout(wat_type_list_first(args))
                _ => 0
            }
        _ => 0
    }

def wat_array_like_runtime_name(owner: Str, field: Str, value: CirExpr): Str =
    if wat_expr_is_scalar_vec_or_array(value) != 0 || wat_expr_is_i64_type_application(value) != 0 {
        if streq(owner, mk_str("Vec", 3)) != 0 {
            if streq(field, mk_str("new", 3)) != 0 { mk_str("Vec.i64.new", 11) }
            else if streq(field, mk_str("len", 3)) != 0 { mk_str("Vec.i64.len", 11) }
            else if streq(field, mk_str("push", 4)) != 0 { mk_str("Vec.i64.push", 12) }
            else if streq(field, mk_str("freeze", 6)) != 0 { mk_str("Vec.i64.freeze", 14) }
            else { wat_method_name(owner, field) }
        } else if streq(owner, mk_str("Array", 5)) != 0 {
            if streq(field, mk_str("len", 3)) != 0 { mk_str("Array.i64.len", 13) }
            else if streq(field, mk_str("get", 3)) != 0 { mk_str("Array.i64.get", 13) }
            else if streq(field, mk_str("to_slice", 8)) != 0 { mk_str("Array.to_slice", 14) }
            else if streq(field, mk_str("slice", 5)) != 0 { mk_str("Array.i64.slice", 15) }
            else { wat_method_name(owner, field) }
        } else { wat_method_name(owner, field) }
    } else if wat_expr_is_ref_vec_or_array(value) != 0 || wat_expr_is_ref_type_application(value) != 0 {
        wat_method_name(owner, field)
    } else if streq(owner, mk_str("Array", 5)) != 0 {
        if streq(field, mk_str("to_slice", 8)) != 0 { mk_str("Array.to_slice", 14) }
        else if streq(field, mk_str("slice", 5)) != 0 { mk_str("Array.slice", 11) }
        else { wat_method_name(owner, field) }
    } else if streq(owner, mk_str("Slice", 5)) != 0 {
        wat_method_name(owner, field)
    } else { wat_method_name(owner, field) }

def wat_array_like_runtime_name_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, owner: Str, field: Str, value: CirExpr): Str = {
    let ty = wat_valtype_from_expr_with_body(items, func_name, params, body, value)
    if streq(owner, mk_str("Array", 5)) != 0 && streq(field, mk_str("len", 3)) != 0 && streq(mk_str(ty, strlen(ty)), mk_str("(ref $array_u8)", 15)) != 0 { mk_str("String.len", 10) }
    else if streq(owner, mk_str("Array", 5)) != 0 && streq(field, mk_str("to_slice", 8)) != 0 { mk_str("Array.to_slice", 14) }
    else if streq(owner, mk_str("Slice", 5)) != 0 { wat_method_name(owner, field) }
    else if wat_expr_is_scalar_vec_or_array(value) != 0 || wat_expr_is_i64_type_application(value) != 0 || wat_expr_is_ref_vec_or_array(value) != 0 || wat_expr_is_ref_type_application(value) != 0 { wat_array_like_runtime_name(owner, field, value) }
    else { wat_method_name(owner, field) }
}

def wat_expr_is_type_application(expr: CirExpr): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpTypeApply(_, _) => 1
        _ => 0
    }

def wat_type_application_owner(expr: CirExpr): Str =
    match wat_unwrap_pass_expr(expr) {
        L1OpTypeApply(value, _) =>
            match wat_unwrap_pass_expr(value) {
                L1OpRef(ref) => wat_ref_owner_name(ref)
                _ => mk_str("", 0)
            }
        _ => mk_str("", 0)
    }

def wat_effective_method_owner(expr: CirExpr): Str = {
    let type_owner = wat_type_application_owner(expr)
    if type_owner.len != 0 { type_owner } else { wat_expr_method_owner(expr) }
}

def wat_effective_method_owner_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): Str = {
    let type_owner = wat_type_application_owner(expr)
    if type_owner.len != 0 { type_owner } else { wat_expr_method_owner_with_body(items, func_name, params, body, expr) }
}

def wat_unwrap_pass_expr(expr: CirExpr): CirExpr =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_unwrap_pass_expr(value)
        L7CoreOp(value, _) => wat_unwrap_pass_expr(value)
        L6OpClosureEnv(value, _) => wat_unwrap_pass_expr(value)
        L5OpContinuationPackage(_, _, value) => wat_unwrap_pass_expr(value)
        L5OpCps(value, _) => wat_unwrap_pass_expr(value)
        L4OpUsage(value, _) => wat_unwrap_pass_expr(value)
        L3OpAnswerControl(value, _, _) => wat_unwrap_pass_expr(value)
        L2OpTyped(value, _) => wat_unwrap_pass_expr(value)
        L1OpUnsafe(value) => wat_unwrap_pass_expr(value)
        L1OpCast(value, _) => wat_unwrap_pass_expr(value)
        L1OpTypeApply(value, _) => wat_unwrap_pass_expr(value)
        _ => expr
    }

def wat_unwrap_pass_expr_keep_type(expr: CirExpr): CirExpr =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L7CoreOp(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L6OpClosureEnv(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L5OpContinuationPackage(_, _, value) => wat_unwrap_pass_expr_keep_type(value)
        L5OpCps(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L4OpUsage(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L3OpAnswerControl(value, _, _) => wat_unwrap_pass_expr_keep_type(value)
        L2OpTyped(value, ty) => L2OpTyped(wat_unwrap_pass_expr(value), ty)
        L1OpUnsafe(value) => wat_unwrap_pass_expr_keep_type(value)
        _ => expr
    }

def wat_call_callee_shape(expr: CirExpr): CirExpr =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_call_callee_shape(value)
        L7CoreOp(value, _) => wat_call_callee_shape(value)
        L6OpClosureEnv(value, _) => wat_call_callee_shape(value)
        L5OpContinuationPackage(_, _, value) => wat_call_callee_shape(value)
        L5OpCps(value, _) => wat_call_callee_shape(value)
        L4OpUsage(value, _) => wat_call_callee_shape(value)
        L3OpAnswerControl(value, _, _) => wat_call_callee_shape(value)
        L2OpTyped(value, ty) => L2OpTyped(wat_call_callee_shape(value), ty)
        L1OpUnsafe(value) => wat_call_callee_shape(value)
        L1OpCast(value, _) => wat_call_callee_shape(value)
        L1OpTypeApply(value, _) => wat_call_callee_shape(value)
        _ => expr
    }

def wat_expr_is_string_array(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_string_array(value)
        L7CoreOp(value, _) => wat_expr_is_string_array(value)
        L6OpClosureEnv(value, _) => wat_expr_is_string_array(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_string_array(value)
        L5OpCps(value, _) => wat_expr_is_string_array(value)
        L4OpUsage(value, _) => wat_expr_is_string_array(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyString => 1
                _ => wat_expr_is_string_array(value)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => 1
                CirTyStr => 1
                _ => wat_expr_is_string_array(value)
            }
        L1OpStringBytes(_) => 1
        _ => 0
    }

def wat_expr_method_value(expr: CirExpr): CirExpr =
    match wat_unwrap_pass_expr(expr) {
        L1OpTypeApply(value, _) => value
        _ => expr
    }

def wat_type_owner_name(ty: CirType): Str =
    match ty {
        CirTyString => mk_str("String", 6)
        CirTyStr => mk_str("str", 3)
        CirTySliceU8 => mk_str("Slice", 5)
        CirTyApp(callee, _) => wat_type_owner_name(callee)
        CirTyConst(name) => name
        CirTyNominal(id, _) => id.local_name
        CirTyData(id, _) => id.local_name
        CirTyUnion(id, _) => id.local_name
        _ => mk_str("", 0)
    }

def wat_expr_method_owner(expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_method_owner(value)
        L7CoreOp(value, _) => wat_expr_method_owner(value)
        L6OpClosureEnv(value, _) => wat_expr_method_owner(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_method_owner(value)
        L5OpCps(value, _) => wat_expr_method_owner(value)
        L4OpUsage(value, _) => wat_expr_method_owner(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyString => mk_str("String", 6)
                CirTyStr => mk_str("str", 3)
                CirTySliceU8 => mk_str("Slice", 5)
                CirTyApp(callee, _) => wat_type_owner_name(callee)
                CirTyConst(name) => name
                CirTyNominal(id, _) => id.local_name
                CirTyData(id, _) => id.local_name
                CirTyUnion(id, _) => id.local_name
                _ => wat_expr_method_owner(value)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => mk_str("String", 6)
                CirTyStr => mk_str("str", 3)
                CirTySliceU8 => mk_str("Slice", 5)
                CirTyApp(callee, _) => wat_type_owner_name(callee)
                CirTyConst(name) => name
                CirTyNominal(id, _) => id.local_name
                CirTyData(id, _) => id.local_name
                CirTyUnion(id, _) => id.local_name
                _ => wat_expr_method_owner(value)
            }
        L1OpUnsafe(value) => wat_expr_method_owner(value)
        L1OpCast(value, ty) => {
            let owner = wat_type_owner_name_from_ast(ty)
            if owner.len != 0 { owner } else { wat_expr_method_owner(value) }
        }
        L1OpTypeApply(value, _) =>
            match wat_unwrap_pass_expr(value) {
                L1OpRef(ref) =>
                    match ref {
                        L1RefGlobal(_, name, _) => name
                        L1RefUnresolved(_, name) => name
                        _ => mk_str("", 0)
                    }
                _ => mk_str("", 0)
            }
        L1OpCall(callee, _) => {
            let name = wat_expr_call_name(callee)
            let known = wat_known_call_result_owner(name)
            if known.len != 0 { known } else { mk_str("", 0) }
        }
        _ => mk_str("", 0)
    }

def wat_method_name(owner: Str, field: Str): Str = {
    let out = str_new()
    let _ = str_append(out, owner)
    let _ = str_push(out, 46)
    let _ = str_append(out, field)
    out
}

