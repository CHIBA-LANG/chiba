    else if arity == 1 && streq(name, mk_str("CoreExprTailCall", 16)) != 0 { mk_str("CoreExprKind__CoreExprTailCall__a1", 34) }
    else if arity == 2 && streq(name, mk_str("CoreExprTailCallArgs", 20)) != 0 { mk_str("CoreExprKind__CoreExprTailCallArgs__a2", 38) }
    else if arity == 3 && streq(name, mk_str("CoreExprPrimitiveBinary", 23)) != 0 { mk_str("CoreExprKind__CoreExprPrimitiveBinary__a3", 41) }
    else if arity == 3 && streq(name, mk_str("CoreExprIfElse", 14)) != 0 { mk_str("CoreExprKind__CoreExprIfElse__a3", 32) }
    else if arity == 0 && streq(name, mk_str("CoreExprBranchJoinPending", 25)) != 0 { mk_str("CoreExprKind__CoreExprBranchJoinPending__a0", 43) }
