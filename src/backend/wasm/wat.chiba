def wat_known_param_count_loop(func_name: Str, index: i64): i64 =
    if wat_known_param_type_exists(func_name, index) != 0 { wat_known_param_count_loop(func_name, index + 1) }
    else { index }

def wat_known_param_count(func_name: Str): i64 =
    wat_known_param_count_loop(func_name, 0)

def wat_param_valtype(items: AST, func_name: Str, index: i64, fallback_ty: AST): i64 = {
    let known = if wat_known_param_type_exists(func_name, index) != 0 { wat_known_param_type(func_name, index) } else { mk_str("", 0) }
    let fallback = if wat_known_param_type_exists(func_name, index) != 0 { mk_str("", 0) }
    else if index == 0 && wat_symbol_name_last_part_len(func_name) != func_name.len {
        let owner = wat_symbol_name_owner(func_name)
        match fallback_ty {
            Type_Path(name, _) =>
                if name.len == 0 {
                    if streq(owner, mk_str("String", 6)) != 0 { "(ref $array_u8)" }
                    else if streq(owner, mk_str("str", 3)) != 0 { "(ref $array_u8)" }
                    else { "eqref" }
                } else { wat_valtype_from_ast_in(items, fallback_ty) }
            _ => wat_valtype_from_ast_in(items, fallback_ty)
        }
    } else { wat_valtype_from_ast_in(items, fallback_ty) }
    let result = if wat_known_param_type_exists(func_name, index) != 0 { known }
    else { fallback }
    result
}

def wat_emit_params_for_func(out: Str, items: AST, func_name: Str, params: CirParamList, index: i64): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(binder, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = wat_local_name(out, binder.id)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_param_valtype(items, func_name, index, ty))
                    str_push(out, 41)
                }
                L0Param(name, ty) => {
                    let _ = str_push_cstr(out, " (param $")
                    let _ = str_push_cstr(out, name)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_param_valtype(items, func_name, index, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_params_for_func(out, items, func_name, rest, index + 1)
        }
    }

def wat_param_valtype_by_id(items: AST, func_name: Str, params: CirParamList, id: i64, index: i64): i64 =
    match params {
        CirParamEnd => ""
        CirParamCons(param, rest) => {
            let hit = match param {
                L1Param(binder, ty) =>
                    if binder.id == id { wat_param_valtype(items, func_name, index, ty) } else { "" }
                _ => ""
            }
            if wat_text_nonempty(hit) != 0 { hit }
            else { wat_param_valtype_by_id(items, func_name, rest, id, index + 1) }
        }
    }

def wat_param_owner_by_id_loop(func_name: Str, params: CirParamList, id: i64, index: i64): Str =
    match params {
        CirParamEnd => mk_str("", 0)
        CirParamCons(param, rest) => {
            let hit = match param {
                L1Param(binder, ty) =>
                    if binder.id == id {
                        let ty_owner = wat_type_owner_name_from_ast(ty)
                        if ty_owner.len != 0 { ty_owner }
                        else if index == 0 && wat_symbol_name_last_part_len(func_name) != func_name.len { wat_symbol_name_owner(func_name) }
                        else { mk_str("", 0) }
                    } else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
            if hit.len != 0 { hit } else { wat_param_owner_by_id_loop(func_name, rest, id, index + 1) }
        }
    }

def wat_param_owner_by_id(func_name: Str, params: CirParamList, id: i64): Str =
    wat_param_owner_by_id_loop(func_name, params, id, 0)

def wat_local_valtype_by_id_in_expr(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr, id: i64): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L7CoreOp(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L6OpClosureEnv(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L5OpContinuationPackage(_, _, value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L5OpCps(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L4OpUsage(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L3OpAnswerControl(value, _, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L2OpTyped(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1OpBlock(stmts, tail) => {
            let in_stmts = wat_local_valtype_by_id_in_stmt_list(items, func_name, params, body, stmts, id)
            if wat_text_nonempty(in_stmts) != 0 { in_stmts } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, tail, id) }
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let in_cond = wat_local_valtype_by_id_in_expr(items, func_name, params, body, cond, id)
            if wat_text_nonempty(in_cond) != 0 { in_cond }
            else {
                let in_then = wat_local_valtype_by_id_in_expr(items, func_name, params, body, then_expr, id)
                if wat_text_nonempty(in_then) != 0 { in_then } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, else_expr, id) }
            }
        }
        L1OpMatch(value, arms) => {
            let in_value = wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
            if wat_text_nonempty(in_value) != 0 { in_value } else { wat_local_valtype_by_id_in_match_arms(items, func_name, params, body, arms, id) }
        }
        L1OpCall(callee, args) => {
            let in_callee = wat_local_valtype_by_id_in_expr(items, func_name, params, body, callee, id)
            if wat_text_nonempty(in_callee) != 0 { in_callee } else { wat_local_valtype_by_id_in_expr_list(items, func_name, params, body, args, id) }
        }
        L1OpNominalCtor(_, fields) => wat_local_valtype_by_id_in_record_fields(items, func_name, params, body, fields, id)
        L1OpField(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1OpIndex(value, args) => {
            let in_value = wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
            if wat_text_nonempty(in_value) != 0 { in_value } else { wat_local_valtype_by_id_in_expr_list(items, func_name, params, body, args, id) }
        }
        L1OpAssign(lhs, rhs) => {
            let in_lhs = wat_local_valtype_by_id_in_expr(items, func_name, params, body, lhs, id)
            if wat_text_nonempty(in_lhs) != 0 { in_lhs } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, rhs, id) }
        }
        L1OpUnsafe(value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1OpCast(value, _) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1OpPrefix(_, value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1OpBinary(_, lhs, rhs) => {
            let in_lhs = wat_local_valtype_by_id_in_expr(items, func_name, params, body, lhs, id)
            if wat_text_nonempty(in_lhs) != 0 { in_lhs } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, rhs, id) }
        }
        _ => ""
    }

def wat_local_valtype_by_id_in_stmt(items: AST, func_name: Str, params: CirParamList, body: CirExpr, stmt: CirStmt, id: i64): i64 =
    match stmt {
        L1StmtLet(binder, value) =>
            if binder.id == id { wat_let_local_decl_valtype_with_body(items, func_name, params, body, value) }
            else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id) }
        L2StmtLet(binder, ty, value) =>
            if binder.id == id { wat_typed_let_local_decl_valtype_with_body(items, func_name, params, body, ty, value) }
            else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id) }
        L1StmtExpr(value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L2StmtExpr(value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1StmtReturn(value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L2StmtReturn(value) => wat_local_valtype_by_id_in_expr(items, func_name, params, body, value, id)
        L1StmtFor(_, cond, loop_body) => {
            let in_cond = wat_local_valtype_by_id_in_expr(items, func_name, params, body, cond, id)
            if wat_text_nonempty(in_cond) != 0 { in_cond } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, loop_body, id) }
        }
        L2StmtFor(_, cond, loop_body) => {
            let in_cond = wat_local_valtype_by_id_in_expr(items, func_name, params, body, cond, id)
            if wat_text_nonempty(in_cond) != 0 { in_cond } else { wat_local_valtype_by_id_in_expr(items, func_name, params, body, loop_body, id) }
        }
        _ => ""
    }

