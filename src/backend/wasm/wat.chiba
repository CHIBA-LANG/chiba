def wat_field_valtype_from_owner(owner: Str, field: Str): Str =
    if owner.len == 0 { "eqref" } else { wat_known_struct_field_valtype(owner, field) }

def wat_owner_from_known_field_name(field: Str): Str =
    if streq(field, mk_str("target", 6)) != 0 { mk_str("CompileTargetFacts", 18) }
    else if streq(field, mk_str("backend", 7)) != 0 { mk_str("CompileTargetFacts", 18) }
    else if streq(field, mk_str("has_compile_if", 14)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("shape", 5)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_target_predicate", 20)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_backend_predicate", 21)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_all_predicate", 17)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_any_predicate", 17)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_not_predicate", 17)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else if streq(field, mk_str("has_unknown_predicate", 21)) != 0 { mk_str("SourceCompileIfFacts", 20) }
    else { mk_str("", 0) }

def wat_known_struct_field_result_owner(owner: Str, field: Str): Str =
    if streq(owner, mk_str("TypedItemSkeleton", 17)) != 0 {
        if streq(field, mk_str("surface", 7)) != 0 { mk_str("SourceItemSurfaceFacts", 22) } else { mk_str("", 0) }
    } else if streq(owner, mk_str("SourceItemSurfaceFacts", 22)) != 0 {
        if streq(field, mk_str("header", 6)) != 0 { mk_str("SourceNameSlice", 15) }
        else { mk_str("", 0) }
    } else { mk_str("", 0) }

def wat_field_valtype_from_expr(value: CirExpr, field: Str): Str =
    match value {
        L8ValidatedCoreOp(inner, _) => wat_field_valtype_from_expr(inner, field)
        L7CoreOp(inner, _) => wat_field_valtype_from_expr(inner, field)
        L6OpClosureEnv(inner, _) => wat_field_valtype_from_expr(inner, field)
        L5OpContinuationPackage(_, _, inner) => wat_field_valtype_from_expr(inner, field)
        L5OpCps(inner, _) => wat_field_valtype_from_expr(inner, field)
        L4OpUsage(inner, _) => wat_field_valtype_from_expr(inner, field)
        L3OpAnswerControl(inner, answer, _) =>
            match answer {
                CirTyUnknown => wat_field_valtype_from_expr(inner, field)
                _ => wat_field_valtype_from_owner(wat_type_owner_name(answer), field)
            }
        L2OpTyped(inner, ty) =>
            match ty {
                CirTyUnknown => wat_field_valtype_from_expr(inner, field)
                _ => wat_field_valtype_from_owner(wat_type_owner_name(ty), field)
            }
        L1OpCast(inner, ty) => {
            let owner = wat_type_owner_name_from_ast(ty)
            if owner.len != 0 { wat_field_valtype_from_owner(owner, field) } else { wat_field_valtype_from_expr(inner, field) }
        }
        _ => wat_field_valtype_from_owner(wat_expr_method_owner(value), field)
    }

def wat_field_owner_from_expr(value: CirExpr): Str =
    match value {
        L8ValidatedCoreOp(inner, _) => wat_field_owner_from_expr(inner)
        L7CoreOp(inner, _) => wat_field_owner_from_expr(inner)
        L6OpClosureEnv(inner, _) => wat_field_owner_from_expr(inner)
        L5OpContinuationPackage(_, _, inner) => wat_field_owner_from_expr(inner)
        L5OpCps(inner, _) => wat_field_owner_from_expr(inner)
        L4OpUsage(inner, _) => wat_field_owner_from_expr(inner)
        L3OpAnswerControl(inner, answer, _) =>
            match answer {
                CirTyUnknown => wat_field_owner_from_expr(inner)
                _ => wat_type_owner_name(answer)
            }
        L2OpTyped(inner, ty) =>
            match ty {
                CirTyUnknown => wat_field_owner_from_expr(inner)
                _ => wat_type_owner_name(ty)
            }
        L1OpCast(inner, ty) => {
            let owner = wat_type_owner_name_from_ast(ty)
            if owner.len != 0 { owner } else { wat_field_owner_from_expr(inner) }
        }
        L1OpField(inner, field) => {
            let owner = wat_field_owner_from_expr(inner)
            if owner.len != 0 { wat_known_struct_field_result_owner(owner, field) } else { mk_str("", 0) }
        }
        _ => wat_expr_method_owner(value)
    }

def wat_emit_ref_cast(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.cast (ref $")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, ")")
    str_push(out, 10)
}

def wat_record_layout_name(items: AST, owner: Str): Str = {
    let ast_count = wat_ast_record_field_count(items, owner)
    if ast_count >= 0 { wat_ast_ctor_layout_name(items, owner, ast_count) }
    else { wat_ast_ctor_layout_name(items, owner, wat_known_struct_field_count(owner)) }
}

def wat_heap_layout_name(items: AST, owner: Str): Str = {
    let layout = wat_record_layout_name(items, owner)
    if layout.len != 0 { layout } else { owner }
}

def wat_emit_ref_cast_layout(out: Str, depth: i64, items: AST, owner: Str): i64 =
    wat_emit_ref_cast(out, depth, wat_heap_layout_name(items, owner))

def wat_emit_ref_test(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.test (ref $")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, ")")
    str_push(out, 10)
}

def wat_emit_ref_test_layout(out: Str, depth: i64, items: AST, owner: Str): i64 =
    wat_emit_ref_test(out, depth, wat_heap_layout_name(items, owner))

def wat_emit_struct_get(out: Str, depth: i64, owner: Str, index: i64): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "struct.get $")
    let _ = str_append(out, owner)
    let _ = str_push(out, 32)
    let _ = str_append_i64(out, index)
    str_push(out, 10)
}

def wat_emit_struct_get_layout(out: Str, depth: i64, items: AST, owner: Str, index: i64): i64 =
    wat_emit_struct_get(out, depth, wat_heap_layout_name(items, owner), index)

def wat_emit_ref_cast_named_layout(out: Str, depth: i64, layout: Str): i64 =
    wat_emit_ref_cast(out, depth, layout)

def wat_emit_struct_get_named_layout(out: Str, depth: i64, layout: Str, index: i64): i64 =
    wat_emit_struct_get(out, depth, layout, index)

def wat_ast_type_is_eqref_storage(ty: AST): i64 =
    match ty {
        Type_Path(name, _) =>
            if streq(name, mk_str("", 0)) != 0 { 0 }
            else if streq(name, mk_str("i64", 3)) != 0 { 0 }
            else if streq(name, mk_str("i32", 3)) != 0 { 0 }
            else if streq(name, mk_str("usize", 5)) != 0 { 0 }
            else if streq(name, mk_str("bool", 4)) != 0 { 0 }
            else if streq(name, mk_str("String", 6)) != 0 { 0 }
            else if streq(name, mk_str("Str", 3)) != 0 { 0 }
            else if streq(name, mk_str("str", 3)) != 0 { 0 }
            else { 1 }
        Type_Callable(_, _) => 1
        Type_Cont1(_, _) => 1
        Type_ContN(_, _) => 1
        Type_Row(_) => 1
        Type_Dyn(_) => 1
        _ => 1
    }

def wat_expr_is_zero_int(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_zero_int(value)
        L7CoreOp(value, _) => wat_expr_is_zero_int(value)
        L6OpClosureEnv(value, _) => wat_expr_is_zero_int(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_zero_int(value)
        L5OpCps(value, _) => wat_expr_is_zero_int(value)
        L4OpUsage(value, _) => wat_expr_is_zero_int(value)
        L3OpAnswerControl(value, _, _) => wat_expr_is_zero_int(value)
        L2OpTyped(value, _) => wat_expr_is_zero_int(value)
        L1OpInt(n) => streq(n, mk_str("0", 1))
        _ => 0
    }

def wat_symbol_contains_double_underscore_loop(name: Str, index: i64): i64 =
    if index + 1 >= name.len { 0 }
    else if load8(name.ptr, index) == 95 && load8(name.ptr, index + 1) == 95 { 1 }
    else { wat_symbol_contains_double_underscore_loop(name, index + 1) }

def wat_symbol_contains_double_underscore(name: Str): i64 =
    wat_symbol_contains_double_underscore_loop(name, 0)

def wat_match_pattern_binder_valtype(items: AST, variant: Str, index: i64, name: Str): i64 =
    if wat_text_nonempty(wat_layout_field_valtype(variant, index)) != 0 { wat_layout_field_valtype(variant, index) }
    else if streq(variant, mk_str("Result__Ok__a1", 14)) != 0 { "eqref" }
    else if streq(variant, mk_str("Result__Err__a1", 15)) != 0 { "eqref" }
    else {
        let from_variant = wat_ast_param_valtype(items, variant, index)
        if wat_text_nonempty(from_variant) != 0 { from_variant }
        else if streq(name, mk_str("digit", 5)) != 0 { "i64" }
        else if streq(name, mk_str("index", 5)) != 0 { "i64" }
        else if streq(name, mk_str("arg", 3)) != 0 { "i64" }
        else if streq(name, mk_str("offset", 6)) != 0 { "i64" }
        else if streq(name, mk_str("start", 5)) != 0 { "i64" }
        else if streq(name, mk_str("end", 3)) != 0 { "i64" }
        else if streq(name, mk_str("count", 5)) != 0 { "i64" }
        else if streq(name, mk_str("first", 5)) != 0 { "i64" }
        else if streq(name, mk_str("last", 4)) != 0 { "i64" }
        else if streq(name, mk_str("min", 3)) != 0 { "i64" }
        else if streq(name, mk_str("max", 3)) != 0 { "i64" }
        else if streq(name, mk_str("pos", 3)) != 0 { "i64" }
        else if streq(name, mk_str("pos1", 4)) != 0 { "i64" }
        else if streq(name, mk_str("pos2", 4)) != 0 { "i64" }
        else if streq(name, mk_str("recovered", 9)) != 0 { "i64" }
        else if streq(name, mk_str("recovered1", 10)) != 0 { "i64" }
        else if streq(name, mk_str("recovered2", 10)) != 0 { "i64" }
        else if streq(name, mk_str("fail_pos", 8)) != 0 { "i64" }
        else { "eqref" }
    }

def wat_pattern_first_binder_valtype(items: AST, variant: Str, args: AST): i64 =
    match args {
        PatternList_Cons(head, _) =>
            match head {
                Pattern_IdentStart(name, _) => wat_match_pattern_binder_valtype(items, variant, 0, name)
                _ => wat_ast_variant_field_valtype(items, variant, 0)
            }
        _ => wat_ast_variant_field_valtype(items, variant, 0)
    }

def wat_pattern_variant_layout_for_value(items: AST, variant: Str, args: AST, value: CirExpr): Str =
    if streq(variant, mk_str("Some", 4)) != 0 {
        let call_layout = wat_expr_option_some_layout_from_call(items, value)
        if call_layout.len != 0 { call_layout }
        else {
            let value_ty = wat_valtype_from_expr_in(items, value)
            let payload_ty = if wat_valtype_is_eqref(value_ty) != 0 { "eqref" } else { wat_pattern_first_binder_valtype(items, variant, args) }
            wat_option_some_layout_for_payload_type(payload_ty)
        }
    } else { wat_pattern_variant_layout(items, variant, args) }

def wat_pattern_variant_layout_for_value_with_body(items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, variant: Str, args: AST, value: CirExpr): Str =
    if streq(variant, mk_str("Some", 4)) != 0 {
        let call_layout = wat_expr_option_some_layout_from_call(items, value)
        if call_layout.len != 0 { call_layout }
        else {
            let local_layout = wat_known_local_option_some_layout_with_body(func_name, params, value)
            if local_layout.len != 0 { local_layout }
            else {
                let value_ty = wat_valtype_from_expr_with_body(items, func_name, params, body_ctx, value)
                let payload_ty = if wat_valtype_is_eqref(value_ty) != 0 { "eqref" } else { wat_pattern_first_binder_valtype(items, variant, args) }
                wat_option_some_layout_for_payload_type(payload_ty)
            }
        }
    } else { wat_pattern_variant_layout(items, variant, args) }

def wat_emit_nominal_ctor_fields(out: Str, depth: i64, items: AST, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let _ = wat_emit_expr_in(out, depth, items, head.value)
            wat_emit_nominal_ctor_fields(out, depth, items, tail)
        }
    }

def wat_emit_nominal_ctor_fields_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, head.value)
            wat_emit_nominal_ctor_fields_with_body(out, depth, items, func_name, params, body, tail)
        }
    }

def wat_emit_nominal_ctor_fields_for_layout_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, layout: Str, fields: CirRecordFieldExprList, index: i64): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let hint = wat_layout_field_valtype(layout, index)
            let _ = if wat_text_nonempty(hint) != 0 { wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, head.value, hint) }
                else { wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, head.value) }
            wat_emit_nominal_ctor_fields_for_layout_with_body(out, depth, items, func_name, params, body, layout, tail, index + 1)
        }
    }

def wat_record_field_exprs_len(fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(_, tail) => 1 + wat_record_field_exprs_len(tail)
    }

def wat_record_first_value_is_immediate_scalar(fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprCons(head, _) => wat_expr_is_definite_integer_scalar(head.value)
        _ => 0
    }

def wat_record_first_value_is_immediate_scalar_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprCons(head, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, head.value)
        _ => 0
    }

def wat_record_first_valtype(fields: CirRecordFieldExprList): Str =
    match fields {
        CirRecordFieldExprCons(head, _) => wat_valtype_from_expr_in(Item_End, head.value)
        _ => mk_str("", 0)
    }

def wat_record_first_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, fields: CirRecordFieldExprList): Str =
    match fields {
        CirRecordFieldExprCons(head, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, head.value)
        _ => mk_str("", 0)
    }

def wat_nominal_ctor_layout_for_fields(items: AST, name: Str, fields: CirRecordFieldExprList): Str = {
    let arity = wat_record_field_exprs_len(fields)
    if arity == 1 && streq(name, mk_str("Some", 4)) != 0 {
        wat_option_some_layout_for_payload_type(wat_record_first_valtype(fields))
    } else if arity == 1 && streq(name, mk_str("TypeVar", 7)) != 0 {
        if wat_record_first_value_is_immediate_scalar(fields) != 0 { mk_str("TypeVar__TypeVar__a1", 20) }
        else { mk_str("TypeIr__TypeVar__a1", 19) }
    } else { wat_ctor_layout_name_for_call(items, name, arity) }
}

def wat_nominal_ctor_layout_for_fields_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, name: Str, fields: CirRecordFieldExprList): Str = {
    let arity = wat_record_field_exprs_len(fields)
    if arity == 1 && streq(name, mk_str("Some", 4)) != 0 {
        wat_option_some_layout_for_payload_type(wat_record_first_valtype_with_body(items, func_name, params, body, fields))
    } else if arity == 1 && streq(name, mk_str("TypeVar", 7)) != 0 {
        if wat_record_first_value_is_immediate_scalar_with_body(items, func_name, params, body, fields) != 0 { mk_str("TypeVar__TypeVar__a1", 20) }
        else { mk_str("TypeIr__TypeVar__a1", 19) }
    } else { wat_ctor_layout_name_for_call(items, name, arity) }
}

def wat_emit_nominal_ctor(out: Str, depth: i64, items: AST, name: Str, fields: CirRecordFieldExprList): i64 = {
    let _ = wat_emit_nominal_ctor_fields(out, depth, items, fields)
    let layout = wat_nominal_ctor_layout_for_fields(items, name, fields)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "struct.new $")
    let _ = if layout.len != 0 { str_append(out, layout) } else {
        let _ = str_append(out, name)
        let _ = str_push_cstr(out, "__a")
        str_append_i64(out, wat_record_field_exprs_len(fields))
    }
    str_push(out, 10)
}

def wat_emit_nominal_ctor_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, name: Str, fields: CirRecordFieldExprList): i64 = {
    let layout = wat_nominal_ctor_layout_for_fields_with_body(items, func_name, params, body, name, fields)
    let _ = if layout.len != 0 { wat_emit_nominal_ctor_fields_for_layout_with_body(out, depth, items, func_name, params, body, layout, fields, 0) }
        else { wat_emit_nominal_ctor_fields_with_body(out, depth, items, func_name, params, body, fields) }
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "struct.new $")
    let _ = if layout.len != 0 { str_append(out, layout) } else {
        let _ = str_append(out, name)
        let _ = str_push_cstr(out, "__a")
        str_append_i64(out, wat_record_field_exprs_len(fields))
    }
    str_push(out, 10)
}

def wat_pattern_variant_name(pattern: AST): Str =
    match pattern {
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => name
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Call(_))) => name
        Pattern_IdentStart(name, PatternAfterIdent_Bind(PatternIdent_Name)) => name
        Pattern_IdentStart(name, PatternAfterIdent_Bind(PatternIdent_Call(_))) => name
        _ => mk_str("", 0)
    }

def wat_pattern_arg_count(args: AST): i64 =
    match args {
        PatternList_Cons(_, tail) => 1 + wat_pattern_arg_count(tail)
        _ => 0
    }

def wat_pattern_variant_layout(items: AST, variant: Str, args: AST): Str = {
    let layout = wat_ctor_layout_name_for_call(items, variant, wat_pattern_arg_count(args))
    if layout.len != 0 { layout } else { variant }
}

def wat_pattern_name_is_ctor(items: AST, name: Str, arity: i64): i64 = {
    let layout = wat_ctor_layout_name_for_call(items, name, arity)
    if layout.len != 0 { 1 }
    else if wat_runtime_heap_type_defined(name) != 0 { 1 }
    else { 0 }
}

def wat_expr_local_id_by_name_in_expr(expr: CirExpr, name: Str): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L7CoreOp(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L6OpClosureEnv(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L5OpContinuationPackage(_, _, value) => wat_expr_local_id_by_name_in_expr(value, name)
        L5OpCps(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L4OpUsage(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L3OpAnswerControl(value, _, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L2OpTyped(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(id, local_name) =>
                    if streq(local_name, name) != 0 { id } else { -1 }
                _ => -1
            }
        L1OpBlock(stmts, tail) => {
            let in_stmts = wat_stmt_list_local_id_by_name(stmts, name)
            if in_stmts >= 0 { in_stmts } else { wat_expr_local_id_by_name_in_expr(tail, name) }
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let in_cond = wat_expr_local_id_by_name_in_expr(cond, name)
            if in_cond >= 0 { in_cond }
            else {
                let in_then = wat_expr_local_id_by_name_in_expr(then_expr, name)
                if in_then >= 0 { in_then } else { wat_expr_local_id_by_name_in_expr(else_expr, name) }
            }
        }
        L1OpMatch(value, arms) => {
            let in_value = wat_expr_local_id_by_name_in_expr(value, name)
            if in_value >= 0 { in_value } else { wat_match_arms_local_id_by_name(arms, name) }
        }
        L1OpCall(callee, args) => {
            let in_callee = wat_expr_local_id_by_name_in_expr(callee, name)
            if in_callee >= 0 { in_callee } else { wat_expr_list_local_id_by_name(args, name) }
        }
        L1OpNominalCtor(_, fields) => wat_record_fields_local_id_by_name(fields, name)
        L1OpField(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L1OpIndex(value, args) => {
            let in_value = wat_expr_local_id_by_name_in_expr(value, name)
            if in_value >= 0 { in_value } else { wat_expr_list_local_id_by_name(args, name) }
        }
        L1OpAssign(lhs, rhs) => {
            let in_lhs = wat_expr_local_id_by_name_in_expr(lhs, name)
            if in_lhs >= 0 { in_lhs } else { wat_expr_local_id_by_name_in_expr(rhs, name) }
        }
        L1OpUnsafe(value) => wat_expr_local_id_by_name_in_expr(value, name)
        L1OpCast(value, _) => wat_expr_local_id_by_name_in_expr(value, name)
        L1OpPrefix(_, value) => wat_expr_local_id_by_name_in_expr(value, name)
        L1OpBinary(_, lhs, rhs) => {
            let in_lhs = wat_expr_local_id_by_name_in_expr(lhs, name)
            if in_lhs >= 0 { in_lhs } else { wat_expr_local_id_by_name_in_expr(rhs, name) }
        }
        _ => -1
    }

def wat_match_arms_local_id_by_name(arms: CirMatchArmList, name: Str): i64 =
    match arms {
        CirMatchArmEnd => -1
        CirMatchArmCons(arm, rest) => {
            let in_head = match arm {
                L1MatchArm(_, _, body) => wat_expr_local_id_by_name_in_expr(body, name)
                _ => -1
            }
            if in_head >= 0 { in_head } else { wat_match_arms_local_id_by_name(rest, name) }
        }
    }

def wat_expr_list_local_id_by_name(args: CirExprList, name: Str): i64 =
    match args {
        CirExprEnd => -1
        CirExprCons(head, tail) => {
            let in_head = wat_expr_local_id_by_name_in_expr(head, name)
            if in_head >= 0 { in_head } else { wat_expr_list_local_id_by_name(tail, name) }
        }
    }

def wat_record_fields_local_id_by_name(fields: CirRecordFieldExprList, name: Str): i64 =
    match fields {
        CirRecordFieldExprEnd => -1
        CirRecordFieldExprCons(head, tail) => {
            let in_head = wat_expr_local_id_by_name_in_expr(head.value, name)
            if in_head >= 0 { in_head } else { wat_record_fields_local_id_by_name(tail, name) }
        }
    }

def wat_stmt_local_id_by_name(stmt: CirStmt, name: Str): i64 =
    match stmt {
        L1StmtLet(_, value) => wat_expr_local_id_by_name_in_expr(value, name)
        L2StmtLet(_, _, value) => wat_expr_local_id_by_name_in_expr(value, name)
        L1StmtExpr(value) => wat_expr_local_id_by_name_in_expr(value, name)
        L2StmtExpr(value) => wat_expr_local_id_by_name_in_expr(value, name)
        L1StmtReturn(value) => wat_expr_local_id_by_name_in_expr(value, name)
        L2StmtReturn(value) => wat_expr_local_id_by_name_in_expr(value, name)
        L1StmtAssign(lhs, rhs) => {
            let in_lhs = wat_expr_local_id_by_name_in_expr(lhs, name)
            if in_lhs >= 0 { in_lhs } else { wat_expr_local_id_by_name_in_expr(rhs, name) }
        }
        L2StmtAssign(lhs, rhs) => {
            let in_lhs = wat_expr_local_id_by_name_in_expr(lhs, name)
            if in_lhs >= 0 { in_lhs } else { wat_expr_local_id_by_name_in_expr(rhs, name) }
        }
        _ => -1
    }

def wat_stmt_list_local_id_by_name(stmts: CirStmtList, name: Str): i64 =
    match stmts {
        CirStmtEnd => -1
        CirStmtCons(stmt, rest) => {
            let in_head = wat_stmt_local_id_by_name(stmt, name)
            if in_head >= 0 { in_head } else { wat_stmt_list_local_id_by_name(rest, name) }
        }
    }

def wat_match_pattern_arg_store(out: Str, depth: i64, items: AST, variant: Str, args: AST, index: i64, value: CirExpr, body: CirExpr): i64 =
    match args {
        PatternList_Cons(head, tail) => {
            let _ = match head {
                Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) =>
                    if name.len == 0 { 0 }
                    else {
                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let _ = if id >= 0 {
                            let _ = wat_emit_expr_in(out, depth, items, value)
                            let _ = wat_emit_ref_cast_layout(out, depth, items, variant)
                            let _ = wat_emit_struct_get_layout(out, depth, items, variant, index)
                            let _ = wat_indent(out, depth)
                            let _ = str_push_cstr(out, "local.set ")
                            let _ = wat_local_name(out, id)
                            str_push(out, 10)
                        } else { 0 }
                        0
                    }
                Pattern_IdentStart(name, _) =>
                    if name.len == 0 { 0 }
                    else {
                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let _ = if id >= 0 {
                            let _ = wat_emit_expr_in(out, depth, items, value)
                            let _ = wat_emit_ref_cast_layout(out, depth, items, variant)
                            let _ = wat_emit_struct_get_layout(out, depth, items, variant, index)
                            let _ = wat_indent(out, depth)
                            let _ = str_push_cstr(out, "local.set ")
                            let _ = wat_local_name(out, id)
                            str_push(out, 10)
                        } else { 0 }
                        0
                    }
                _ => 0
            }
            wat_match_pattern_arg_store(out, depth, items, variant, tail, index + 1, value, body)
        }
        _ => 0
    }

def wat_emit_match_nested_payload_expr(out: Str, depth: i64, items: AST, outer_layout: Str, outer_index: i64, value: CirExpr): i64 = {
    let _ = wat_emit_expr_in(out, depth, items, value)
    let _ = wat_emit_ref_cast_named_layout(out, depth, outer_layout)
    wat_emit_struct_get_named_layout(out, depth, outer_layout, outer_index)
}

def wat_emit_match_nested_payload_expr_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, outer_layout: Str, outer_index: i64, value: CirExpr): i64 = {
    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body_ctx, value)
    let _ = wat_emit_ref_cast_named_layout(out, depth, outer_layout)
    wat_emit_struct_get_named_layout(out, depth, outer_layout, outer_index)
}

def wat_match_nested_pattern_arg_store(out: Str, depth: i64, items: AST, outer_layout: Str, outer_index: i64, nested_variant: Str, nested_args: AST, value: CirExpr, body: CirExpr, nested_index: i64): i64 =
    match nested_args {
        PatternList_Cons(head, tail) => {
            let nested_arity = nested_index + wat_pattern_arg_count(nested_args)
            let found_layout = wat_ctor_layout_name_for_call(items, nested_variant, nested_arity)
            let nested_layout = if found_layout.len != 0 { found_layout } else { nested_variant }
            let _ = match head {
                Pattern_IdentStart(name, _) =>
                    if name.len == 0 { 0 }
                    else {
                        let id = wat_expr_local_id_by_name_in_expr(body, name)
                        let _ = if id >= 0 {
                            let _ = wat_emit_match_nested_payload_expr(out, depth, items, outer_layout, outer_index, value)
                            let _ = wat_emit_ref_cast_layout(out, depth, items, nested_layout)
                            let _ = wat_emit_struct_get_layout(out, depth, items, nested_layout, nested_index)
                            let _ = wat_indent(out, depth)
                            let _ = str_push_cstr(out, "local.set ")
                            let _ = wat_local_name(out, id)
                            str_push(out, 10)
                        } else { 0 }
                        0
                    }
                _ => 0
            }
            wat_match_nested_pattern_arg_store(out, depth, items, outer_layout, outer_index, nested_variant, tail, value, body, nested_index + 1)
        }
        _ => 0
    }

def wat_emit_match_pattern_binders(out: Str, depth: i64, items: AST, pattern: AST, value: CirExpr, body: CirExpr): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_store(out, depth, items, wat_pattern_variant_layout_for_value(items, variant, args, value), args, 0, value, body)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_store(out, depth, items, wat_pattern_variant_layout_for_value(items, variant, args, value), args, 0, value, body)
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => {
            let _ = if wat_pattern_name_is_ctor(items, name, 0) == 0 {
                let id = wat_expr_local_id_by_name_in_expr(body, name)
                if id >= 0 {
                    let _ = wat_emit_expr_in(out, depth, items, value)
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "local.set ")
                    let _ = wat_local_name(out, id)
                    str_push(out, 10)
                } else { 0 }
            } else { 0 }
            0
        }
        _ => 0
    }

def wat_match_nested_pattern_arg_store_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, outer_layout: Str, outer_index: i64, nested_variant: Str, nested_args: AST, value: CirExpr, body: CirExpr, nested_index: i64): i64 =
    match nested_args {
