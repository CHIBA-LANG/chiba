def wat_param_valtype(items: AST, func_name: Str, index: i64, fallback_ty: AST): i64 = {
    let known = if wat_known_param_type_exists(func_name, index) != 0 { wat_known_param_type(func_name, index) } else { mk_str("", 0) }
    let from_ast = if wat_known_param_type_exists(func_name, index) != 0 { mk_str("", 0) }
    else if wat_ast_has_param(items, func_name, index) != 0 { wat_ast_param_valtype(items, func_name, index) }
    else { mk_str("", 0) }
    let fallback = if wat_known_param_type_exists(func_name, index) != 0 || wat_ast_has_param(items, func_name, index) != 0 { mk_str("", 0) } else { wat_valtype_from_ast_in(items, fallback_ty) }
    let result = if wat_known_param_type_exists(func_name, index) != 0 { known }
    else if wat_ast_has_param(items, func_name, index) != 0 { from_ast }
    else { fallback }
    result
}

def wat_emit_params_for_func(out: Str, items: AST, func_name: Str, params: CirParamList, index: i64): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(binder, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = wat_local_name(out, binder.id)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_param_valtype(items, func_name, index, ty))
                    str_push(out, 41)
                }
                L0Param(name, ty) => {
                    let _ = str_push_cstr(out, " (param $")
                    let _ = str_push_cstr(out, name)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_param_valtype(items, func_name, index, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_params_for_func(out, items, func_name, rest, index + 1)
        }
    }

def wat_known_call_result_owner(name: Str): Str =
    if streq(name, mk_str("Vec.new", 7)) != 0 { mk_str("Vec", 3) }
    else if streq(name, mk_str("Vec.push", 8)) != 0 { mk_str("Vec", 3) }
    else if streq(name, mk_str("Vec.freeze", 10)) != 0 { mk_str("Array", 5) }
    else if streq(name, mk_str("generate_parser", 15)) != 0 { mk_str("GeneratedParser", 15) }
    else if streq(name, mk_str("generated_parser_text", 21)) != 0 { mk_str("String", 6) }
    else if streq(name, mk_str("str.concat", 10)) != 0 { mk_str("String", 6) }
    else if streq(name, mk_str("String.concat", 13)) != 0 { mk_str("String", 6) }
    else { mk_str("", 0) }

def wat_expr_call_name(expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_call_name(value)
        L7CoreOp(value, _) => wat_expr_call_name(value)
        L6OpClosureEnv(value, _) => wat_expr_call_name(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_call_name(value)
        L5OpCps(value, _) => wat_expr_call_name(value)
        L4OpUsage(value, _) => wat_expr_call_name(value)
        L3OpAnswerControl(value, _, _) => wat_expr_call_name(value)
        L2OpTyped(value, _) => wat_expr_call_name(value)
        L1OpRef(ref) =>
            match ref {
                L1RefGlobal(name) => name
                L1RefUnresolved(name) => name
                _ => mk_str("", 0)
            }
        L1OpField(value, field) => {
            let owner = wat_expr_method_owner(value)
            if owner.len == 0 { mk_str("", 0) }
            else { wat_method_name(owner, field) }
        }
        _ => mk_str("", 0)
    }

def wat_emit_import_params(out: Str, items: AST, params: CirParamList): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(_, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                L0Param(_, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_import_params(out, items, rest)
        }
    }

def wat_emit_known_import_sig(out: Str, name: Str): i64 =
    if streq(name, mk_str("Array.len", 9)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result i64)")
        1
    } else if streq(name, mk_str("Array.get", 9)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (result eqref)")
        1
    } else if streq(name, mk_str("Array.slice", 11)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param i64) (param i64) (result eqref)")
        1
    } else if streq(name, mk_str("Slice.len", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (result i64)")
        1
    } else if streq(name, mk_str("Slice.get", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (param i64) (result eqref)")
        1
    } else if streq(name, mk_str("Slice.slice", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $slice_u8)) (param i64) (param i64) (result (ref $slice_u8))")
        1
    } else if streq(name, mk_str("Vec.new", 7)) != 0 {
        let _ = str_push_cstr(out, " (result eqref)")
        1
    } else if streq(name, mk_str("Vec.len", 7)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result i64)")
        1
    } else if streq(name, mk_str("Vec.push", 8)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param eqref) (result eqref)")
        1
    } else if streq(name, mk_str("Vec.freeze", 10)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.new", 21)) != 0 {
        let _ = str_push_cstr(out, " (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.push_str", 26)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (param (ref $array_u8)) (result eqref)")
        1
    } else if streq(name, mk_str("DiagnosticBuilder.finish", 24)) != 0 {
        let _ = str_push_cstr(out, " (param eqref) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("String.len", 10)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (result i64)")
        1
    } else if streq(name, mk_str("String.byte_at", 14)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("String.slice", 12)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (param i64) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("String.char_at", 14)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("String.concat", 13)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param (ref $array_u8)) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.concat", 10)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param (ref $array_u8)) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.len", 7)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (result i64)")
        1
    } else if streq(name, mk_str("str.byte_at", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else if streq(name, mk_str("str.slice", 9)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (param i64) (result (ref $array_u8))")
        1
    } else if streq(name, mk_str("str.char_at", 11)) != 0 {
        let _ = str_push_cstr(out, " (param (ref $array_u8)) (param i64) (result i64)")
        1
    } else {
        0
    }

def wat_params_empty(params: CirParamList): i64 =
    match params {
        CirParamEnd => 1
        _ => 0
    }

def wat_emit_import(out: Str, items: AST, item: CirItem): i64 =
    match item {
        L1ItemExtern(binder, params, ret, import) => {
            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
            else {
                let _ = wat_debug_emit_name(binder.name)
                let _ = str_push_cstr(out, "  (import \"")
                let _ = str_append(out, import.module_name)
                let _ = str_push_cstr(out, "\" \"")
                let _ = str_append(out, import.symbol_name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_func_name(out, binder.name)
                let handled = wat_emit_known_import_sig(out, binder.name)
                let _ = if handled == 0 {
                    let _ = wat_emit_import_params(out, items, params)
                    let _ = str_push_cstr(out, " (result ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ret))
                    str_push_cstr(out, ")")
                } else { 0 }
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            }
        }
        L8ValidatedCoreItemExtern(binder, params, ret, import) => {
            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
            else {
                let _ = wat_debug_emit_name(binder.name)
                let _ = str_push_cstr(out, "  (import \"")
                let _ = str_append(out, import.module_name)
                let _ = str_push_cstr(out, "\" \"")
                let _ = str_append(out, import.symbol_name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_func_name(out, binder.name)
                let handled = wat_emit_known_import_sig(out, binder.name)
                let _ = if handled == 0 {
                    let _ = wat_emit_import_params(out, items, params)
                    let _ = str_push_cstr(out, " (result ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ret))
                    str_push_cstr(out, ")")
                } else { 0 }
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            }
        }
        _ => 0
    }

def wat_emit_imports(out: Str, ast_items: AST, items: CirItemList): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let _ = wat_emit_import(out, ast_items, item)
            wat_emit_imports(out, ast_items, rest)
        }
    }

def wat_item_defines_name(item: CirItem, name: Str): i64 =
    match item {
        L1ItemDef(binder, _, _, _) => streq(binder.name, name)
        L1ItemExtern(binder, _, _, _) => streq(binder.name, name)
        L8ValidatedCoreItemDef(binder, _, _, _) => streq(binder.name, name)
        L8ValidatedCoreItemExtern(binder, _, _, _) => streq(binder.name, name)
        _ => 0
    }

def wat_items_define_name(items: CirItemList, name: Str): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) =>
            if wat_item_defines_name(item, name) != 0 { 1 }
            else { wat_items_define_name(rest, name) }
    }

def wat_expr_list_references_unresolved(args: CirExprList, name: Str): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) =>
            if wat_expr_references_unresolved(head, name) != 0 { 1 }
            else { wat_expr_list_references_unresolved(tail, name) }
    }

def wat_stmt_list_references_unresolved(stmts: CirStmtList, name: Str): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let hit = match stmt {
                L1StmtLet(_, value) => wat_expr_references_unresolved(value, name)
                L1StmtLetPattern(_, value) => wat_expr_references_unresolved(value, name)
                L1StmtAssign(lhs, rhs) =>
                    if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
                    else { wat_expr_references_unresolved(rhs, name) }
                L1StmtExpr(value) => wat_expr_references_unresolved(value, name)
                L1StmtReturn(value) => wat_expr_references_unresolved(value, name)
                L1StmtFor(_, cond, body) =>
                    if wat_expr_references_unresolved(cond, name) != 0 { 1 }
                    else { wat_expr_references_unresolved(body, name) }
                _ => 0
            }
            if hit != 0 { 1 } else { wat_stmt_list_references_unresolved(rest, name) }
        }
    }

def wat_expr_references_unresolved(expr: CirExpr, name: Str): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_references_unresolved(value, name)
        L7CoreOp(value, _) => wat_expr_references_unresolved(value, name)
        L6OpClosureEnv(value, _) => wat_expr_references_unresolved(value, name)
        L5OpContinuationPackage(_, _, value) => wat_expr_references_unresolved(value, name)
        L5OpCps(value, _) => wat_expr_references_unresolved(value, name)
        L4OpUsage(value, _) => wat_expr_references_unresolved(value, name)
        L3OpAnswerControl(value, _, _) => wat_expr_references_unresolved(value, name)
        L2OpTyped(value, _) => wat_expr_references_unresolved(value, name)
        L1OpBlock(stmts, tail) =>
            if wat_stmt_list_references_unresolved(stmts, name) != 0 { 1 }
            else { wat_expr_references_unresolved(tail, name) }
        L1OpIf(cond, then_expr, else_expr) =>
            if wat_expr_references_unresolved(cond, name) != 0 { 1 }
            else if wat_expr_references_unresolved(then_expr, name) != 0 { 1 }
            else { wat_expr_references_unresolved(else_expr, name) }
        L1OpMatch(value, _) => wat_expr_references_unresolved(value, name)
        L1OpClosure(_, body) => wat_expr_references_unresolved(body, name)
        L1OpReset(_, body) => wat_expr_references_unresolved(body, name)
        L1OpShift(_, _, body) => wat_expr_references_unresolved(body, name)
        L1OpCall(callee, args) =>
            if wat_expr_references_unresolved(callee, name) != 0 { 1 }
            else {
                let call_name = wat_expr_call_name(callee)
                if streq(call_name, name) != 0 { 1 }
                else { wat_expr_list_references_unresolved(args, name) }
            }
        L1OpField(value, _) => wat_expr_references_unresolved(value, name)
        L1OpIndex(value, args) =>
            if wat_expr_references_unresolved(value, name) != 0 { 1 }
            else { wat_expr_list_references_unresolved(args, name) }
        L1OpTypeApply(_, _) => 0
        L1OpAssign(lhs, rhs) =>
            if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
            else { wat_expr_references_unresolved(rhs, name) }
        L1OpPrefix(_, value) => wat_expr_references_unresolved(value, name)
        L1OpBinary(_, lhs, rhs) =>
            if wat_expr_references_unresolved(lhs, name) != 0 { 1 }
            else { wat_expr_references_unresolved(rhs, name) }
        L1OpRef(L1RefUnresolved(ref_name)) => streq(ref_name, name)
        _ => 0
    }

def wat_items_reference_unresolved(items: CirItemList, name: Str): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let hit = match item {
                L1ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L2ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L3ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L4ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L5ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L6ItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L7CoreItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                L8ValidatedCoreItemDef(_, _, _, body) => wat_expr_references_unresolved(body, name)
                _ => 0
            }
            if hit != 0 { 1 } else { wat_items_reference_unresolved(rest, name) }
        }
    }

def wat_emit_env_hole_import(out: Str, items: CirItemList, name: Str): i64 =
    if wat_items_define_name(items, name) != 0 { 0 }
    else if wat_builtin_runtime_defined(name) != 0 { 0 }
    else if wat_items_reference_unresolved(items, name) == 0 { 0 }
    else {
        let _ = str_push_cstr(out, "  (import \"env\" \"")
        let _ = str_append(out, name)
        let _ = str_push_cstr(out, "\" (func ")
        let _ = wat_func_name(out, name)
        let handled = wat_emit_known_import_sig(out, name)
        let _ = if handled == 0 { str_push_cstr(out, " (result i64)") } else { 0 }
        let _ = str_push_cstr(out, "))")
        str_push(out, 10)
    }

def wat_emit_env_hole_imports(out: Str, items: CirItemList): i64 = {
    let _ = wat_emit_env_hole_import(out, items, mk_str("left", 4))
    let _ = wat_emit_env_hole_import(out, items, mk_str("right", 5))
    let _ = wat_emit_env_hole_import(out, items, mk_str("share_state", 11))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.len", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.get", 9))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Array.slice", 11))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.new", 7))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.len", 7))
    let _ = wat_emit_env_hole_import(out, items, mk_str("Vec.push", 8))
    wat_emit_env_hole_import(out, items, mk_str("Vec.freeze", 10))
}

def wat_collect_expr_locals(out: Str, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_collect_expr_locals(out, value)
        L7CoreOp(value, _) => wat_collect_expr_locals(out, value)
        L6OpClosureEnv(value, _) => wat_collect_expr_locals(out, value)
        L5OpContinuationPackage(binder, _, value) => {
            let _ = wat_emit_local_decl(out, binder.id)
            wat_collect_expr_locals(out, value)
        }
        L5OpCps(value, _) => wat_collect_expr_locals(out, value)
        L4OpUsage(value, _) => wat_collect_expr_locals(out, value)
        L3OpAnswerControl(value, _, _) => wat_collect_expr_locals(out, value)
        L2OpTyped(value, _) => wat_collect_expr_locals(out, value)
        L1OpBlock(stmts, tail) => {
            let _ = wat_collect_stmt_locals(out, stmts)
            wat_collect_expr_locals(out, tail)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let _ = wat_collect_expr_locals(out, cond)
            let _ = wat_collect_expr_locals(out, then_expr)
            wat_collect_expr_locals(out, else_expr)
        }
        L1OpMatch(value, _) => wat_collect_expr_locals(out, value)
        L1OpClosure(params, body) => {
            let _ = wat_emit_params(out, Item_End, params)
            wat_collect_expr_locals(out, body)
        }
        L1OpReset(_, body) => wat_collect_expr_locals(out, body)
        L1OpShift(_, binder, body) => {
            let _ = wat_emit_local_decl(out, binder.id)
            wat_collect_expr_locals(out, body)
        }
        L1OpCall(callee, args) => {
            let _ = wat_collect_expr_locals(out, callee)
            wat_collect_expr_list_locals(out, args)
        }
        L1OpField(value, _) => wat_collect_expr_locals(out, value)
        L1OpIndex(value, args) => {
            let _ = wat_collect_expr_locals(out, value)
            wat_collect_expr_list_locals(out, args)
        }
        L1OpTypeApply(_, _) => 0
        L1OpAssign(lhs, rhs) => {
            let _ = wat_collect_expr_locals(out, lhs)
            wat_collect_expr_locals(out, rhs)
        }
        L1OpPrefix(_, value) => wat_collect_expr_locals(out, value)
        L1OpBinary(_, lhs, rhs) => {
            let _ = wat_collect_expr_locals(out, lhs)
            wat_collect_expr_locals(out, rhs)
        }
        _ => 0
    }

def wat_collect_expr_list_locals(out: Str, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_collect_expr_locals(out, head)
            wat_collect_expr_list_locals(out, tail)
        }
    }

def wat_collect_stmt_locals(out: Str, stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let _ = match stmt {
                L1StmtLet(binder, value) => {
                    let _ = wat_emit_local_decl(out, binder.id)
                    wat_collect_expr_locals(out, value)
                }
                L1StmtLetPattern(_, value) => wat_collect_expr_locals(out, value)
                L1StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals(out, lhs)
                    wat_collect_expr_locals(out, rhs)
                }
                L1StmtExpr(value) => wat_collect_expr_locals(out, value)
                L1StmtReturn(value) => wat_collect_expr_locals(out, value)
                L1StmtFor(_, cond, body) => {
                    let _ = wat_collect_expr_locals(out, cond)
                    wat_collect_expr_locals(out, body)
                }
                L2StmtLet(binder, ty, value) => {
                    let _ = wat_emit_local_decl_with_type(out, binder.id, wat_valtype_from_cir(ty))
                    wat_collect_expr_locals(out, value)
                }
                L2StmtLetPattern(_, value) => wat_collect_expr_locals(out, value)
                L2StmtAssign(lhs, rhs) => {
                    let _ = wat_collect_expr_locals(out, lhs)
                    wat_collect_expr_locals(out, rhs)
                }
                L2StmtExpr(value) => wat_collect_expr_locals(out, value)
                L2StmtReturn(value) => wat_collect_expr_locals(out, value)
                L2StmtFor(_, cond, body) => {
                    let _ = wat_collect_expr_locals(out, cond)
                    wat_collect_expr_locals(out, body)
                }
                _ => 0
            }
            wat_collect_stmt_locals(out, rest)
        }
    }

def wat_binary_instr(op: Str): i64 =
    if streq(op, mk_str("+", 1)) != 0 { "i64.add" }
    else if streq(op, mk_str("-", 1)) != 0 { "i64.sub" }
    else if streq(op, mk_str("*", 1)) != 0 { "i64.mul" }
    else if streq(op, mk_str("/", 1)) != 0 { "i64.div_s" }
    else if streq(op, mk_str("%", 1)) != 0 { "i64.rem_s" }
    else if streq(op, mk_str("==", 2)) != 0 { "i64.eq" }
    else if streq(op, mk_str("!=", 2)) != 0 { "i64.ne" }
    else if streq(op, mk_str("<", 1)) != 0 { "i64.lt_s" }
    else if streq(op, mk_str(">", 1)) != 0 { "i64.gt_s" }
    else if streq(op, mk_str("<=", 2)) != 0 { "i64.le_s" }
    else if streq(op, mk_str(">=", 2)) != 0 { "i64.ge_s" }
    else { "unreachable ;; unsupported-binary" }

def wat_binary_is_compare(op: Str): i64 =
    if streq(op, mk_str("==", 2)) != 0 { 1 }
    else if streq(op, mk_str("!=", 2)) != 0 { 1 }
    else if streq(op, mk_str("<", 1)) != 0 { 1 }
    else if streq(op, mk_str(">", 1)) != 0 { 1 }
    else if streq(op, mk_str("<=", 2)) != 0 { 1 }
    else if streq(op, mk_str(">=", 2)) != 0 { 1 }
    else { 0 }

def wat_is_ref_name(ref: CirRef, want: Str): i64 =
    match ref {
        L1RefGlobal(name) => streq(name, want)
        L1RefUnresolved(name) => streq(name, want)
        _ => 0
    }

def wat_is_string_char_method(field: Str): i64 =
    if streq(field, mk_str("char_at", 7)) != 0 { 1 }
    else if streq(field, mk_str("codepoint_at", 12)) != 0 { 1 }
    else { 0 }

def wat_is_string_concat_method(owner: Str, field: Str): i64 =
    if streq(field, mk_str("concat", 6)) == 0 { 0 }
    else if streq(owner, mk_str("String", 6)) != 0 { 1 }
    else if streq(owner, mk_str("str", 3)) != 0 { 1 }
    else { 0 }

def wat_is_array_like_owner(owner: Str): i64 =
    if streq(owner, mk_str("Array", 5)) != 0 { 1 }
    else if streq(owner, mk_str("Vec", 3)) != 0 { 1 }
    else { 0 }

def wat_is_type_level_expr(expr: CirExpr): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpRef(L1RefGlobal(_)) => 1
        L1OpRef(L1RefUnresolved(_)) => 1
        _ => 0
    }

def wat_type_list_first(args: CirTypeList): CirType =
    match args {
        CirTypeCons(head, _) => head
        _ => CirTyUnknown
    }

def wat_type_is_ref_layout(ty: CirType): i64 =
    match ty {
        CirTyString => 1
        CirTyStr => 1
        CirTySliceU8 => 1
        CirTyConst(name) =>
            if wat_is_scalar_type_name(name) != 0 { 0 } else { 1 }
        CirTyApp(_, _) => 1
        CirTyNominal(_, _) => 1
        CirTyData(_, _) => 1
        CirTyUnion(_, _) => 1
        _ => 0
    }

def wat_type_is_scalar_vec_or_array(ty: CirType): i64 =
    match ty {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(owner) =>
                    if streq(owner, mk_str("Vec", 3)) != 0 || streq(owner, mk_str("Array", 5)) != 0 {
                        wat_type_is_i64_storage(wat_type_list_first(args))
                    } else { 0 }
                _ => 0
            }
        _ => 0
    }

def wat_type_is_ref_vec_or_array(ty: CirType): i64 =
    match ty {
        CirTyApp(callee, args) =>
            match callee {
                CirTyConst(owner) =>
                    if streq(owner, mk_str("Vec", 3)) != 0 || streq(owner, mk_str("Array", 5)) != 0 {
                        wat_type_is_ref_layout(wat_type_list_first(args))
                    } else { 0 }
                _ => 0
            }
        _ => 0
    }

def wat_expr_type(expr: CirExpr): CirType =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_type(value)
        L7CoreOp(value, _) => wat_expr_type(value)
        L6OpClosureEnv(value, _) => wat_expr_type(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_type(value)
        L5OpCps(value, _) => wat_expr_type(value)
        L4OpUsage(value, _) => wat_expr_type(value)
        L3OpAnswerControl(_, answer, _) => answer
        L2OpTyped(_, ty) => ty
        _ => CirTyUnknown
    }

def wat_expr_is_ref_vec_or_array(expr: CirExpr): i64 =
    wat_type_is_ref_vec_or_array(wat_expr_type(expr))

def wat_expr_is_scalar_vec_or_array(expr: CirExpr): i64 =
    wat_type_is_scalar_vec_or_array(wat_expr_type(expr))

def wat_array_like_runtime_name(owner: Str, field: Str, value: CirExpr): Str =
    if wat_expr_is_scalar_vec_or_array(value) != 0 {
        if streq(owner, mk_str("Vec", 3)) != 0 {
            if streq(field, mk_str("new", 3)) != 0 { mk_str("Vec.i64.new", 11) }
            else if streq(field, mk_str("len", 3)) != 0 { mk_str("Vec.i64.len", 11) }
            else if streq(field, mk_str("push", 4)) != 0 { mk_str("Vec.i64.push", 12) }
            else if streq(field, mk_str("freeze", 6)) != 0 { mk_str("Vec.i64.freeze", 14) }
            else { wat_method_name(owner, field) }
        } else if streq(owner, mk_str("Array", 5)) != 0 {
            if streq(field, mk_str("len", 3)) != 0 { mk_str("Array.i64.len", 13) }
            else if streq(field, mk_str("get", 3)) != 0 { mk_str("Array.i64.get", 13) }
            else { wat_method_name(owner, field) }
        } else { wat_method_name(owner, field) }
    } else { wat_method_name(owner, field) }

def wat_expr_is_type_application(expr: CirExpr): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpTypeApply(_, _) => 1
        _ => 0
    }

def wat_unwrap_pass_expr(expr: CirExpr): CirExpr =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_unwrap_pass_expr(value)
        L7CoreOp(value, _) => wat_unwrap_pass_expr(value)
        L6OpClosureEnv(value, _) => wat_unwrap_pass_expr(value)
        L5OpContinuationPackage(_, _, value) => wat_unwrap_pass_expr(value)
        L5OpCps(value, _) => wat_unwrap_pass_expr(value)
        L4OpUsage(value, _) => wat_unwrap_pass_expr(value)
        L3OpAnswerControl(value, _, _) => wat_unwrap_pass_expr(value)
        L2OpTyped(value, _) => wat_unwrap_pass_expr(value)
        _ => expr
    }

def wat_unwrap_pass_expr_keep_type(expr: CirExpr): CirExpr =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L7CoreOp(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L6OpClosureEnv(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L5OpContinuationPackage(_, _, value) => wat_unwrap_pass_expr_keep_type(value)
        L5OpCps(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L4OpUsage(value, _) => wat_unwrap_pass_expr_keep_type(value)
        L3OpAnswerControl(value, _, _) => wat_unwrap_pass_expr_keep_type(value)
        L2OpTyped(value, ty) => L2OpTyped(wat_unwrap_pass_expr(value), ty)
        _ => expr
    }

def wat_expr_is_string_array(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_string_array(value)
        L7CoreOp(value, _) => wat_expr_is_string_array(value)
        L6OpClosureEnv(value, _) => wat_expr_is_string_array(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_string_array(value)
        L5OpCps(value, _) => wat_expr_is_string_array(value)
        L4OpUsage(value, _) => wat_expr_is_string_array(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyString => 1
                _ => wat_expr_is_string_array(value)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => 1
                _ => wat_expr_is_string_array(value)
            }
        L1OpStringBytes(_) => 1
        _ => 0
    }

def wat_expr_method_value(expr: CirExpr): CirExpr =
    match wat_unwrap_pass_expr(expr) {
        L1OpTypeApply(value, _) => value
        _ => expr
    }

def wat_type_owner_name(ty: CirType): Str =
    match ty {
        CirTyString => mk_str("String", 6)
        CirTyStr => mk_str("str", 3)
        CirTySliceU8 => mk_str("Slice", 5)
        CirTyApp(callee, _) => wat_type_owner_name(callee)
        CirTyConst(name) => name
        CirTyNominal(id, _) => id.local_name
        CirTyData(id, _) => id.local_name
        CirTyUnion(id, _) => id.local_name
        _ => mk_str("", 0)
    }

def wat_expr_method_owner(expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_method_owner(value)
        L7CoreOp(value, _) => wat_expr_method_owner(value)
        L6OpClosureEnv(value, _) => wat_expr_method_owner(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_method_owner(value)
        L5OpCps(value, _) => wat_expr_method_owner(value)
        L4OpUsage(value, _) => wat_expr_method_owner(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyString => mk_str("String", 6)
                CirTyStr => mk_str("str", 3)
                CirTySliceU8 => mk_str("Slice", 5)
                CirTyApp(callee, _) => wat_type_owner_name(callee)
                CirTyConst(name) => name
                CirTyNominal(id, _) => id.local_name
                CirTyData(id, _) => id.local_name
                CirTyUnion(id, _) => id.local_name
                _ => wat_expr_method_owner(value)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyString => mk_str("String", 6)
                CirTyStr => mk_str("str", 3)
                CirTySliceU8 => mk_str("Slice", 5)
                CirTyApp(callee, _) => wat_type_owner_name(callee)
                CirTyConst(name) => name
                CirTyNominal(id, _) => id.local_name
                CirTyData(id, _) => id.local_name
                CirTyUnion(id, _) => id.local_name
                _ => wat_expr_method_owner(value)
            }
        L1OpTypeApply(value, _) =>
            match wat_unwrap_pass_expr(value) {
                L1OpRef(ref) =>
                    match ref {
                        L1RefGlobal(name) => name
                        L1RefUnresolved(name) => name
                        _ => mk_str("", 0)
                    }
                _ => mk_str("", 0)
            }
        L1OpCall(callee, _) => {
            let name = wat_expr_call_name(callee)
            let known = wat_known_call_result_owner(name)
            if known.len != 0 { known } else { mk_str("", 0) }
        }
        _ => mk_str("", 0)
    }

def wat_method_name(owner: Str, field: Str): Str = {
    let out = str_new()
    let _ = str_append(out, owner)
    let _ = str_push(out, 46)
    let _ = str_append(out, field)
    out
}

def wat_known_struct_field_index(owner: Str, field: Str): i64 =
    if streq(owner, mk_str("Range", 5)) != 0 {
        if streq(field, mk_str("start", 5)) != 0 { 0 }
        else if streq(field, mk_str("end", 3)) != 0 { 1 }
        else { -1 }
    } else if streq(owner, mk_str("DiagnosticBuilder", 17)) != 0 {
        if streq(field, mk_str("len", 3)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarName", 11)) != 0 {
        if streq(field, mk_str("text", 4)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarToken", 12)) != 0 {
        if streq(field, mk_str("text", 4)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarRuleRef", 14)) != 0 {
        if streq(field, mk_str("name", 4)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarBind", 11)) != 0 {
        if streq(field, mk_str("name", 4)) != 0 { 0 } else if streq(field, mk_str("value", 5)) != 0 { 1 } else { -1 }
    } else if streq(owner, mk_str("GrammarSequence", 15)) != 0 {
        if streq(field, mk_str("atoms", 5)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarAction", 13)) != 0 {
        if streq(field, mk_str("source", 6)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("GrammarAlternative", 18)) != 0 {
        if streq(field, mk_str("sequence", 8)) != 0 { 0 }
        else if streq(field, mk_str("action", 6)) != 0 { 1 }
        else { -1 }
    } else if streq(owner, mk_str("PrattTable", 10)) != 0 {
        if streq(field, mk_str("prefixes", 8)) != 0 { 0 }
        else if streq(field, mk_str("infixes", 7)) != 0 { 1 }
        else { -1 }
    } else if streq(owner, mk_str("GrammarRule", 11)) != 0 {
        if streq(field, mk_str("name", 4)) != 0 { 0 }
        else if streq(field, mk_str("alternatives", 12)) != 0 { 1 }
        else if streq(field, mk_str("pratt", 5)) != 0 { 2 }
        else { -1 }
    } else if streq(owner, mk_str("GeneratedParser", 15)) != 0 {
        if streq(field, mk_str("source", 6)) != 0 { 0 }
        else if streq(field, mk_str("status", 6)) != 0 { 1 }
        else if streq(field, mk_str("diagnostic", 10)) != 0 { 2 }
        else { -1 }
    } else if streq(owner, mk_str("ParserStateId", 13)) != 0 {
        if streq(field, mk_str("index", 5)) != 0 { 0 } else { -1 }
    } else if streq(owner, mk_str("LoweredAlternative", 18)) != 0 {
        if streq(field, mk_str("index", 5)) != 0 { 0 }
        else if streq(field, mk_str("sequence", 8)) != 0 { 1 }
        else if streq(field, mk_str("action", 6)) != 0 { 2 }
        else if streq(field, mk_str("recovery", 8)) != 0 { 3 }
        else { -1 }
    } else if streq(owner, mk_str("LoweredRule", 11)) != 0 {
        if streq(field, mk_str("name", 4)) != 0 { 0 }
        else if streq(field, mk_str("alternatives", 12)) != 0 { 1 }
        else if streq(field, mk_str("pratt", 5)) != 0 { 2 }
        else { -1 }
    } else if streq(owner, mk_str("LoweredParser", 13)) != 0 {
        if streq(field, mk_str("namespace_name", 14)) != 0 { 0 }
        else if streq(field, mk_str("start", 5)) != 0 { 1 }
        else if streq(field, mk_str("rules", 5)) != 0 { 2 }
        else if streq(field, mk_str("ast_data", 8)) != 0 { 3 }
        else { -1 }
    } else { -1 }

def wat_emit_ref_cast(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.cast (ref $")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, ")")
    str_push(out, 10)
}

def wat_emit_ref_test(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.test (ref $")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, ")")
    str_push(out, 10)
}

def wat_emit_struct_get(out: Str, depth: i64, owner: Str, index: i64): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "struct.get $")
    let _ = str_append(out, owner)
    let _ = str_push(out, 32)
    let _ = str_append_i64(out, index)
    str_push(out, 10)
}

def wat_emit_nominal_ctor_fields(out: Str, depth: i64, fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 0
        CirRecordFieldExprCons(head, tail) => {
            let _ = wat_emit_expr(out, depth, head.value)
            wat_emit_nominal_ctor_fields(out, depth, tail)
        }
    }

def wat_emit_nominal_ctor(out: Str, depth: i64, name: Str, fields: CirRecordFieldExprList): i64 = {
    let _ = wat_emit_nominal_ctor_fields(out, depth, fields)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "struct.new $")
    let _ = str_append(out, name)
    str_push(out, 10)
}

def wat_pattern_variant_name(pattern: AST): Str =
    match pattern {
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => name
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Call(_))) => name
        _ => mk_str("", 0)
    }

def wat_match_result_type(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_match_result_type(value)
        L7CoreOp(value, _) => wat_match_result_type(value)
        L6OpClosureEnv(value, _) => wat_match_result_type(value)
        L5OpContinuationPackage(_, _, value) => wat_match_result_type(value)
        L5OpCps(value, _) => wat_match_result_type(value)
        L4OpUsage(value, _) => wat_match_result_type(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyUnknown => wat_match_result_type(value)
                _ => wat_valtype_from_cir(answer)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_match_result_type(value)
                _ => wat_valtype_from_cir(ty)
            }
        L1OpIf(_, then_expr, _) => wat_match_result_type(then_expr)
        L1OpMatch(_, arms) =>
            match arms {
                CirMatchArmCons(L1MatchArm(_, _, body), _) => wat_match_result_type(body)
                _ => "i64"
            }
        L1OpNominalCtor(_, _) => "eqref"
        L1OpStringBytes(_) => "(ref $array_u8)"
        L1OpStringInterp(_) => "(ref $array_u8)"
        _ => wat_valtype_from_expr(expr)
    }

def wat_emit_match_variant_test(out: Str, depth: i64, value: CirExpr, variant: Str): i64 = {
    let _ = wat_emit_expr(out, depth, value)
    wat_emit_ref_test(out, depth, variant)
}

def wat_emit_match_expr(out: Str, depth: i64, value: CirExpr, arms: CirMatchArmList, result_ty: i64): i64 =
    match arms {
        CirMatchArmEnd => wat_line(out, depth, "unreachable ;; non-exhaustive match unsupported")
        CirMatchArmCons(arm, rest) =>
            match arm {
                L1MatchArm(pattern, MatchGuard_None, body) => {
                    let variant = wat_pattern_variant_name(pattern)
                    let _ = if variant.len == 0 { wat_line(out, depth, "i32.const 1") }
                    else { wat_emit_match_variant_test(out, depth, value, variant) }
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "if (result ")
                    let _ = str_push_cstr(out, result_ty)
                    let _ = str_push_cstr(out, ")")
                    let _ = str_push(out, 10)
                    let _ = wat_emit_expr(out, depth + 1, body)
                    let _ = match rest {
                        CirMatchArmEnd => {
                            let _ = wat_line(out, depth, "else")
                            wat_line(out, depth + 1, "unreachable ;; impossible final match arm miss")
                        }
                        _ => {
                            let _ = wat_line(out, depth, "else")
                            wat_emit_match_expr(out, depth + 1, value, rest, result_ty)
                        }
                    }
                    wat_line(out, depth, "end")
                }
                _ => wat_line(out, depth, "unreachable ;; guarded match unsupported")
            }
    }

def wat_emit_call_name(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "call ")
    let _ = wat_func_name(out, name)
    str_push(out, 10)
}

def wat_emit_method_call(out: Str, depth: i64, value: CirExpr, field: Str, args: CirExprList): i64 =
    if wat_is_string_char_method(field) != 0 && wat_expr_is_string_array(value) != 0 {
        wat_emit_string_char_method_call(out, depth, value, args)
    } else {
        let owner = wat_expr_method_owner(value)
        if owner.len == 0 {
            wat_line(out, depth, "unreachable ;; method call unsupported")
        } else if wat_is_string_concat_method(owner, field) != 0 {
            match args {
                CirExprCons(rhs, CirExprEnd) => {
                    let _ = wat_emit_expr(out, depth, value)
                    let _ = wat_emit_expr(out, depth, rhs)
                    wat_line(out, depth, "call $__chiba_string_concat2")
                }
                _ => wat_line(out, depth, "unreachable ;; string concat arity unsupported")
            }
        } else if wat_expr_is_type_application(value) != 0 && streq(owner, mk_str("Vec", 3)) != 0 {
            if streq(field, mk_str("new", 3)) != 0 {
                wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
            } else {
                wat_line(out, depth, "unreachable ;; generic Vec type method unsupported")
            }
        } else if wat_expr_is_scalar_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
            let _ = wat_emit_expr(out, depth, value)
            let _ = wat_emit_expr_list(out, depth, args)
            wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
        } else if wat_expr_is_ref_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
            let _ = wat_emit_expr(out, depth, value)
            let _ = wat_emit_expr_list(out, depth, args)
            wat_emit_call_name(out, depth, wat_method_name(owner, field))
        } else {
            let _ = if wat_expr_is_type_application(value) != 0 { 0 } else { wat_emit_expr(out, depth, value) }
            let _ = wat_emit_expr_list(out, depth, args)
            wat_emit_call_name(out, depth, wat_method_name(owner, field))
        }
    }

def wat_emit_expr_list(out: Str, depth: i64, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_emit_expr(out, depth, head)
            wat_emit_expr_list(out, depth, tail)
        }
    }

def wat_expr_list_len(args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(_, tail) => 1 + wat_expr_list_len(tail)
    }

def wat_emit_string_char_method_call(out: Str, depth: i64, value: CirExpr, args: CirExprList): i64 =
    match args {
        CirExprCons(index, CirExprEnd) => {
            let _ = wat_emit_expr(out, depth, value)
            let _ = wat_emit_expr(out, depth, index)
            wat_line(out, depth, "call $__chiba_string_codepoint_at")
        }
        _ => wat_line(out, depth, "unreachable ;; char_at arity unsupported")
    }

def wat_emit_stmt_list(out: Str, depth: i64, stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let _ = wat_emit_stmt(out, depth, stmt)
            wat_emit_stmt_list(out, depth, rest)
        }
    }

def wat_emit_return_expr(out: Str, depth: i64, value: CirExpr): i64 =
    match wat_unwrap_pass_expr(value) {
        L8ValidatedCoreOp(inner, _) => wat_emit_return_expr(out, depth, inner)
        L7CoreOp(inner, _) => wat_emit_return_expr(out, depth, inner)
        L6OpClosureEnv(inner, _) => wat_emit_return_expr(out, depth, inner)
        L5OpContinuationPackage(_, _, inner) => wat_emit_return_expr(out, depth, inner)
        L5OpCps(inner, _) => wat_emit_return_expr(out, depth, inner)
        L4OpUsage(inner, _) => wat_emit_return_expr(out, depth, inner)
        L3OpAnswerControl(inner, _, _) => wat_emit_return_expr(out, depth, inner)
        L2OpTyped(inner, _) => wat_emit_return_expr(out, depth, inner)
        L1OpCall(callee, args) => {
            let _ = wat_emit_expr_list(out, depth, args)
            match wat_unwrap_pass_expr(callee) {
                L1OpRef(L1RefGlobal(name)) => {
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "return_call ")
                    let _ = wat_func_name(out, name)
                    str_push(out, 10)
                }
                L1OpRef(L1RefUnresolved(name)) => {
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "return_call ")
                    let _ = wat_func_name(out, name)
                    str_push(out, 10)
                }
                _ => {
                    let _ = wat_emit_expr(out, depth, value)
                    wat_line(out, depth, "return")
                }
            }
        }
        _ => {
            let _ = wat_emit_expr(out, depth, value)
            wat_line(out, depth, "return")
        }
    }

def wat_emit_stmt(out: Str, depth: i64, stmt: CirStmt): i64 =
    match stmt {
        L1StmtLet(binder, value) => {
            let _ = wat_emit_expr(out, depth, value)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L1StmtExpr(value) => {
            let _ = wat_emit_expr(out, depth, value)
            wat_line(out, depth, "drop")
        }
        L1StmtReturn(value) => wat_emit_return_expr(out, depth, value)
        L1StmtAssign(_, _) => wat_line(out, depth, "unreachable ;; assign unsupported")
        L1StmtFor(_, cond, body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_expr(out, depth + 2, cond)
            let _ = wat_line(out, depth + 2, "i64.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr(out, depth + 2, body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        L1StmtLetPattern(_, _) => wat_line(out, depth, "unreachable ;; let-pattern unsupported")
        L1StmtUnsupported(_, _) => wat_line(out, depth, "unreachable ;; stmt unsupported")
        L2StmtLet(binder, _, value) => {
            let _ = wat_emit_expr(out, depth, value)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L2StmtExpr(value) => {
            let _ = wat_emit_expr(out, depth, value)
            wat_line(out, depth, "drop")
        }
        L2StmtReturn(value) => wat_emit_return_expr(out, depth, value)
        L2StmtAssign(lhs, rhs) => {
            let _ = wat_emit_expr(out, depth, L1OpAssign(lhs, rhs))
            wat_line(out, depth, "drop")
        }
        L2StmtFor(_, cond, body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_expr(out, depth + 2, cond)
            let _ = wat_line(out, depth + 2, "i64.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr(out, depth + 2, body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        L2StmtLetPattern(_, _) => wat_line(out, depth, "unreachable ;; let-pattern unsupported")
        _ => wat_line(out, depth, "unreachable ;; non-l1 stmt")
    }

def wat_emit_assign_expr(out: Str, depth: i64, lhs: CirExpr, rhs: CirExpr): i64 =
    match lhs {
        L8ValidatedCoreOp(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L7CoreOp(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L6OpClosureEnv(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L5OpCps(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L4OpUsage(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L3OpAnswerControl(value, _, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L2OpTyped(value, _) => wat_emit_assign_expr(out, depth, value, rhs)
        L1OpRef(L1RefLocal(id, _)) => {
            let _ = wat_emit_expr(out, depth, rhs)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.tee ")
            let _ = wat_local_name(out, id)
            str_push(out, 10)
        }
        _ => wat_line(out, depth, "unreachable ;; assign target unsupported")
    }

def wat_emit_expr(out: Str, depth: i64, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_emit_expr(out, depth, value)
        L7CoreOp(value, _) => wat_emit_expr(out, depth, value)
        L6OpClosureEnv(value, _) => wat_emit_expr(out, depth, value)
        L5OpContinuationPackage(_, _, value) => wat_emit_expr(out, depth, value)
        L5OpCps(value, _) => wat_emit_expr(out, depth, value)
        L4OpUsage(value, _) => wat_emit_expr(out, depth, value)
        L3OpAnswerControl(value, _, _) => wat_emit_expr(out, depth, value)
        L2OpTyped(value, _) => wat_emit_expr(out, depth, value)
        L1OpBlock(stmts, tail) => {
            let _ = wat_emit_stmt_list(out, depth, stmts)
            wat_emit_expr(out, depth, tail)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let _ = wat_emit_expr(out, depth, cond)
            let _ = wat_line(out, depth, "i64.const 0")
            let _ = wat_line(out, depth, "i64.ne")
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "if (result ")
            let _ = str_push_cstr(out, wat_match_result_type(expr))
            let _ = str_push_cstr(out, ")")
            let _ = str_push(out, 10)
            let _ = wat_emit_expr(out, depth + 1, then_expr)
            let _ = wat_line(out, depth, "else")
            let _ = wat_emit_expr(out, depth + 1, else_expr)
            wat_line(out, depth, "end")
        }
        L1OpMatch(value, arms) => wat_emit_match_expr(out, depth, value, arms, wat_match_result_type(expr))
        L1OpCall(callee, args) => {
            match wat_unwrap_pass_expr_keep_type(callee) {
                L2OpTyped(L1OpField(value, field), _) => wat_emit_method_call(out, depth, value, field, args)
                L1OpField(value, field) => wat_emit_method_call(out, depth, value, field, args)
                L2OpTyped(L1OpRef(ref), _) =>
                    if wat_is_ref_name(ref, mk_str("__tuple", 7)) != 0 {
                        if wat_expr_list_len(args) == 0 {
                            wat_line(out, depth, "i64.const 0")
                        } else {
                            let _ = wat_emit_expr_list(out, depth, args)
                            wat_line(out, depth, "struct.new $tuple2_i64")
                        }
                    } else {
                        let _ = wat_emit_expr_list(out, depth, args)
                        match ref {
                            L1RefGlobal(name) => {
                                let _ = wat_indent(out, depth)
                                let _ = str_push_cstr(out, "call ")
                                let _ = wat_func_name(out, name)
                                str_push(out, 10)
                            }
                            L1RefUnresolved(name) => {
                                let _ = wat_indent(out, depth)
                                let _ = str_push_cstr(out, "call ")
                                let _ = wat_func_name(out, name)
                                str_push(out, 10)
                            }
                            _ => wat_line(out, depth, "unreachable ;; indirect call unsupported")
                        }
                    }
                L1OpRef(ref) =>
                    if wat_is_ref_name(ref, mk_str("__tuple", 7)) != 0 {
                        if wat_expr_list_len(args) == 0 {
                            wat_line(out, depth, "i64.const 0")
                        } else {
                            let _ = wat_emit_expr_list(out, depth, args)
                            wat_line(out, depth, "struct.new $tuple2_i64")
                        }
                    } else {
                        let _ = wat_emit_expr_list(out, depth, args)
                        match ref {
                            L1RefGlobal(name) => {
                                let _ = wat_indent(out, depth)
                                let _ = str_push_cstr(out, "call ")
                                let _ = wat_func_name(out, name)
                                str_push(out, 10)
                            }
                            L1RefUnresolved(name) => {
                                let _ = wat_indent(out, depth)
                                let _ = str_push_cstr(out, "call ")
                                let _ = wat_func_name(out, name)
                                str_push(out, 10)
                            }
                            _ => wat_line(out, depth, "unreachable ;; indirect call unsupported")
                        }
                    }
                _ => wat_line(out, depth, "unreachable ;; indirect call unsupported")
            }
        }
        L1OpNominalCtor(name, fields) => wat_emit_nominal_ctor(out, depth, name, fields)
        L1OpField(value, field) => {
            let _ = wat_emit_expr(out, depth, value)
            if streq(field, mk_str("_1", 2)) != 0 { wat_line(out, depth, "struct.get $tuple2_i64 0") }
            else if streq(field, mk_str("_2", 2)) != 0 { wat_line(out, depth, "struct.get $tuple2_i64 1") }
            else {
                let owner = wat_expr_method_owner(value)
                let index = wat_known_struct_field_index(owner, field)
                if owner.len != 0 && index >= 0 {
                    let _ = wat_emit_ref_cast(out, depth, owner)
                    wat_emit_struct_get(out, depth, owner, index)
                } else {
                    wat_line(out, depth, "unreachable ;; field unsupported")
                }
            }
        }
        L1OpIndex(value, args) => {
            if wat_expr_is_string_array(value) != 0 {
                match args {
                    CirExprCons(index, CirExprEnd) =>
                        match wat_unwrap_pass_expr(index) {
                            L1OpBinary(op, start, end) =>
                                if streq(op, mk_str("..", 2)) != 0 {
                                    let _ = wat_emit_expr(out, depth, value)
                                    let _ = wat_emit_expr(out, depth, start)
                                    let _ = wat_emit_expr(out, depth, end)
                                    wat_line(out, depth, "call $__chiba_string_slice")
                                } else { wat_line(out, depth, "unreachable ;; string index unsupported") }
                            _ => {
                                let _ = wat_emit_expr(out, depth, value)
                                let _ = wat_emit_expr(out, depth, index)
                                wat_line(out, depth, "call $__chiba_string_byte_at")
                            }
                        }
                    _ => wat_line(out, depth, "unreachable ;; string index arity unsupported")
                }
            } else {
                let owner = wat_expr_method_owner(value)
                if wat_expr_is_scalar_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
                    match args {
                        CirExprCons(index, CirExprEnd) => {
                            let _ = wat_emit_expr(out, depth, value)
                            let _ = wat_emit_expr(out, depth, index)
                            wat_line(out, depth, "call $Array.i64.get")
                        }
                        _ => wat_line(out, depth, "unreachable ;; array index arity unsupported")
                    }
                } else if wat_expr_is_ref_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
                    match args {
                        CirExprCons(index, CirExprEnd) => {
                            let _ = wat_emit_expr(out, depth, value)
                            let _ = wat_emit_expr(out, depth, index)
                            wat_line(out, depth, "call $Array.get")
                        }
                        _ => wat_line(out, depth, "unreachable ;; array index arity unsupported")
                    }
                } else {
                    wat_line(out, depth, "unreachable ;; typed index pending")
                }
            }
        }
        L1OpTypeApply(_, _) => 0
        L1OpPrefix(op, value) => {
            if streq(op, mk_str("-", 1)) != 0 {
                let _ = wat_line(out, depth, "i64.const 0")
                let _ = wat_emit_expr(out, depth, value)
                wat_line(out, depth, "i64.sub")
            } else {
                let _ = wat_emit_expr(out, depth, value)
                let _ = wat_line(out, depth, "i64.eqz")
                wat_line(out, depth, "i64.extend_i32_u")
            }
        }
        L1OpBinary(op, lhs, rhs) => {
            let _ = wat_emit_expr(out, depth, lhs)
            let _ = wat_emit_expr(out, depth, rhs)
            let _ = wat_line(out, depth, wat_binary_instr(op))
            if wat_binary_is_compare(op) != 0 { wat_line(out, depth, "i64.extend_i32_u") } else { 0 }
        }
        L1OpAssign(lhs, rhs) => {
            wat_emit_assign_expr(out, depth, lhs, rhs)
        }
        L1OpRef(L1RefLocal(id, _)) => {
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.get ")
            let _ = wat_local_name(out, id)
            str_push(out, 10)
        }
        L1OpRef(L1RefGlobal(name)) => {
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "call ")
            let _ = wat_func_name(out, name)
            str_push(out, 10)
        }
        L1OpRef(L1RefUnresolved(name)) => {
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "call ")
            let _ = wat_func_name(out, name)
            str_push(out, 10)
        }
        L1OpInt(n) => wat_line_str(out, depth, "i64.const ", n)
        L1OpBool(v) => {
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "i64.const ")
            let _ = str_append_i64(out, v)
            str_push(out, 10)
        }
        L1OpString => wat_line(out, depth, "unreachable ;; legacy payloadless string unsupported")
        L1OpStringBytes(bytes) => wat_emit_string_array(out, depth, bytes)
        L1OpStringInterp(parts) => wat_emit_string_interp(out, depth, parts)
        L1OpUnit => wat_line(out, depth, "i64.const 0")
        L1OpReset(_, body) => wat_emit_expr(out, depth, body)
        L1OpShift(_, _, _) => wat_line(out, depth, "unreachable ;; shift requires cps lowering")
        L1OpUnsupported(_, _) => wat_line(out, depth, "unreachable ;; expr unsupported")
        _ => wat_line(out, depth, "unreachable ;; wat expr unsupported")
    }

def wat_emit_func(out: Str, items: AST, item: CirItem, export_main: i64): i64 =
    match item {
        L1ItemDef(binder, params, ret, body) => {
            let _ = wat_debug_emit_name(binder.name)
            let _ = str_push_cstr(out, "  (func ")
            let _ = wat_func_name(out, binder.name)
            let _ = wat_emit_params_for_func(out, items, binder.name, params, 0)
            let _ = str_push_cstr(out, " (result ")
            let _ = str_push_cstr(out, wat_result_valtype(items, ret, body))
            let _ = str_push(out, 41)
            let _ = str_push(out, 10)
            let _ = wat_collect_expr_locals(out, body)
            let _ = wat_emit_expr(out, 2, body)
            let _ = str_push_cstr(out, "  )")
            let _ = str_push(out, 10)
            let _ = if wat_params_empty(params) != 0 && streq(binder.name, mk_str("main", 4)) == 0 {
                let _ = str_push_cstr(out, "  (export \"")
                let _ = str_append(out, binder.name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_func_name(out, binder.name)
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            } else { 0 }
            if export_main != 0 {
                let _ = str_push_cstr(out, "  (export \"main\" (func ")
                let _ = wat_func_name(out, binder.name)
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            } else { 0 }
        }
        L8ValidatedCoreItemDef(binder, params, ret, body) => {
            let _ = wat_debug_emit_name(binder.name)
            let _ = str_push_cstr(out, "  (func ")
            let _ = wat_func_name(out, binder.name)
            let _ = wat_emit_params_for_func(out, items, binder.name, params, 0)
            let _ = str_push_cstr(out, " (result ")
            let _ = str_push_cstr(out, wat_result_valtype(items, ret, body))
            let _ = str_push(out, 41)
            let _ = str_push(out, 10)
            let _ = wat_collect_expr_locals(out, body)
            let _ = wat_emit_expr(out, 2, body)
            let _ = str_push_cstr(out, "  )")
            let _ = str_push(out, 10)
            let _ = if wat_params_empty(params) != 0 && streq(binder.name, mk_str("main", 4)) == 0 {
                let _ = str_push_cstr(out, "  (export \"")
                let _ = str_append(out, binder.name)
                let _ = str_push_cstr(out, "\" (func ")
                let _ = wat_func_name(out, binder.name)
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            } else { 0 }
            if export_main != 0 {
                let _ = str_push_cstr(out, "  (export \"main\" (func ")
                let _ = wat_func_name(out, binder.name)
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            } else { 0 }
        }
        _ => 0
    }

def wat_emit_items(out: Str, ast_items: AST, items: CirItemList, exported: i64): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let export_now = match item {
                L1ItemDef(binder, _, _, _) => if exported == 0 { streq(binder.name, mk_str("main", 4)) } else { 0 }
                L8ValidatedCoreItemDef(binder, _, _, _) => if exported == 0 { streq(binder.name, mk_str("main", 4)) } else { 0 }
                _ => 0
            }
            let _ = wat_emit_func(out, ast_items, item, export_now)
            wat_emit_items(out, ast_items, rest, if export_now != 0 { 1 } else { exported })
        }
    }

def wat_validation_ok(result: CirCoreValidation): i64 =
    match result {
        L8ValidatedCoreOk => 1
        L8ValidatedCoreErr(_) => 0
    }

def wat_expr_validated(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, result) =>
            if wat_validation_ok(result) == 0 { 0 } else { wat_expr_validated(value) }
        L7CoreOp(value, _) => wat_expr_validated(value)
        L6OpClosureEnv(value, _) => wat_expr_validated(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_validated(value)
        L5OpCps(value, _) => wat_expr_validated(value)
        L4OpUsage(value, _) => wat_expr_validated(value)
        L3OpAnswerControl(value, _, _) => wat_expr_validated(value)
        L2OpTyped(value, _) => wat_expr_validated(value)
        L1OpBlock(stmts, tail) =>
            if wat_stmt_list_validated(stmts) == 0 { 0 } else { wat_expr_validated(tail) }
        L1OpIf(cond, then_expr, else_expr) =>
            if wat_expr_validated(cond) == 0 { 0 }
            else if wat_expr_validated(then_expr) == 0 { 0 }
            else { wat_expr_validated(else_expr) }
        L1OpCall(callee, args) =>
            if wat_expr_validated(callee) == 0 { 0 } else { wat_expr_list_validated(args) }
        L1OpField(value, _) => wat_expr_validated(value)
        L1OpIndex(value, args) =>
            if wat_expr_validated(value) == 0 { 0 } else { wat_expr_list_validated(args) }
        L1OpTypeApply(_, _) => 1
        L1OpAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1OpPrefix(_, value) => wat_expr_validated(value)
        L1OpBinary(_, lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1OpReset(_, body) => wat_expr_validated(body)
        L1OpShift(_, _, body) => wat_expr_validated(body)
        _ => 1
    }

def wat_expr_list_validated(args: CirExprList): i64 =
    match args {
        CirExprEnd => 1
        CirExprCons(head, tail) =>
            if wat_expr_validated(head) == 0 { 0 } else { wat_expr_list_validated(tail) }
    }

def wat_stmt_validated(stmt: CirStmt): i64 =
    match stmt {
        L2StmtLet(_, _, value) => wat_expr_validated(value)
        L2StmtLetPattern(_, value) => wat_expr_validated(value)
        L2StmtAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L2StmtExpr(value) => wat_expr_validated(value)
        L2StmtReturn(value) => wat_expr_validated(value)
        L2StmtFor(_, cond, body) =>
            if wat_expr_validated(cond) == 0 { 0 } else { wat_expr_validated(body) }
        L1StmtLet(_, value) => wat_expr_validated(value)
        L1StmtLetPattern(_, value) => wat_expr_validated(value)
        L1StmtAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1StmtExpr(value) => wat_expr_validated(value)
        L1StmtReturn(value) => wat_expr_validated(value)
        L1StmtFor(_, cond, body) =>
            if wat_expr_validated(cond) == 0 { 0 } else { wat_expr_validated(body) }
        _ => 1
    }

def wat_stmt_list_validated(stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 1
        CirStmtCons(stmt, rest) =>
            if wat_stmt_validated(stmt) == 0 { 0 } else { wat_stmt_list_validated(rest) }
    }

def wat_items_validated(items: CirItemList): i64 =
    match items {
        CirItemEnd => 1
        CirItemCons(item, rest) => {
            let item_ok = match item {
                L8ValidatedCoreItemDef(_, _, _, body) => wat_expr_validated(body)
                L8ValidatedCoreItemExtern(_, _, _, _) => 1
                _ => 0
            }
            if item_ok == 0 { 0 } else { wat_items_validated(rest) }
        }
    }

def wat_module_validated(module: CirModule): i64 =
    match module {
        L8ValidatedCoreModule(_, items) => wat_items_validated(items)
        _ => 0
    }

def wat_emit_module(module: CirModule): Str = {
    let out = str_new()
    let ast_items = match module {
        L1Module(source, _) => wat_source_items(source)
        L8ValidatedCoreModule(source, _) => wat_source_items(source)
        _ => Item_End
    }
    let _ = wat_debug_mark("module-start")
    let _ = str_push_cstr(out, "(module\n")
    let _ = str_push_cstr(out, "  (rec\n")
    let _ = str_push_cstr(out, "  (type $tuple2_i64 (struct (field i64) (field i64)))\n")
    let _ = str_push_cstr(out, "  (type $array_u8 (array (mut i8)))\n")
    let _ = str_push_cstr(out, "  (type $slice_u8 (struct (field (ref $array_u8)) (field i32) (field i32)))\n")
    let _ = str_push_cstr(out, "  (type $array_eqref (array (mut eqref)))\n")
    let _ = str_push_cstr(out, "  (type $vec_ref (struct (field (mut i64)) (field (ref $array_eqref))))\n")
    let _ = str_push_cstr(out, "  (type $array_i64 (array (mut i64)))\n")
    let _ = str_push_cstr(out, "  (type $vec_i64 (struct (field (mut i64)) (field (ref $array_i64))))\n")
    let _ = wat_emit_declared_type_defs(out, ast_items)
    let _ = str_push_cstr(out, "  )\n")
    let _ = match module {
        L1Module(_, items) => {
            let _ = wat_debug_mark("emit-imports-l1")
            let _ = wat_emit_imports(out, ast_items, items)
            wat_emit_env_hole_imports(out, items)
        }
        L8ValidatedCoreModule(_, items) => {
            let _ = wat_debug_mark("emit-imports-l8")
            let _ = wat_emit_imports(out, ast_items, items)
            wat_emit_env_hole_imports(out, items)
        }
        _ => 0
    }
    let _ = wat_debug_mark("emit-runtime-helpers")
    let _ = str_push_cstr(out, "  (func $__chiba_string_utf8_width (param $b i32) (result i32)\n")
    let _ = str_push_cstr(out, "    local.get $b\n")
    let _ = str_push_cstr(out, "    i32.const 128\n")
    let _ = str_push_cstr(out, "    i32.lt_u\n")
    let _ = str_push_cstr(out, "    if (result i32)\n")
    let _ = str_push_cstr(out, "      i32.const 1\n")
    let _ = str_push_cstr(out, "    else\n")
    let _ = str_push_cstr(out, "      local.get $b\n")
    let _ = str_push_cstr(out, "      i32.const 224\n")
    let _ = str_push_cstr(out, "      i32.lt_u\n")
    let _ = str_push_cstr(out, "      if (result i32)\n")
    let _ = str_push_cstr(out, "        i32.const 2\n")
    let _ = str_push_cstr(out, "      else\n")
    let _ = str_push_cstr(out, "        local.get $b\n")
    let _ = str_push_cstr(out, "        i32.const 240\n")
    let _ = str_push_cstr(out, "        i32.lt_u\n")
    let _ = str_push_cstr(out, "        if (result i32)\n")
    let _ = str_push_cstr(out, "          i32.const 3\n")
    let _ = str_push_cstr(out, "        else\n")
    let _ = str_push_cstr(out, "          i32.const 4\n")
    let _ = str_push_cstr(out, "        end\n")
    let _ = str_push_cstr(out, "      end\n")
    let _ = str_push_cstr(out, "    end)\n")
    let _ = str_push_cstr(out, "  (func $__chiba_string_codepoint_at (param $a (ref $array_u8)) (param $idx i64) (result i64)\n")
    let _ = str_push_cstr(out, "    (local $off i32) (local $i i64) (local $b0 i32) (local $b1 i32) (local $b2 i32) (local $b3 i32)\n")
    let _ = str_push_cstr(out, "    local.get $idx\n")
    let _ = str_push_cstr(out, "    i64.const 0\n")
    let _ = str_push_cstr(out, "    i64.lt_s\n")
    let _ = str_push_cstr(out, "    if\n")
    let _ = str_push_cstr(out, "      unreachable\n")
    let _ = str_push_cstr(out, "    end\n")
    let _ = str_push_cstr(out, "    block $done\n")
    let _ = str_push_cstr(out, "      loop $scan\n")
    let _ = str_push_cstr(out, "        local.get $off\n")
