def wat_known_call_result_valtype(name: Str): Str = {
    let exact = wat_known_call_result_valtype_local(name)
    if wat_text_nonempty(exact) != 0 { exact }
    else { wat_known_call_result_valtype_local(wat_symbol_name_last_part(name)) }
}

def wat_ctor_call_result_valtype(items: AST, name: Str, arity: i64): Str =
    if wat_ctor_layout_name_for_call(items, name, arity).len != 0 { mk_str("eqref", 5) }
    else if wat_runtime_heap_type_defined(name) != 0 { mk_str("eqref", 5) }
    else if wat_runtime_heap_type_defined(wat_symbol_name_last_part(name)) != 0 { mk_str("eqref", 5) }
    else { mk_str("", 0) }

def wat_ctor_call_result_valtype_for_args(items: AST, name: Str, args: CirExprList): Str = {
    let arity = wat_expr_list_len(args)
    let first_ty = match args {
        CirExprCons(head, _) => wat_valtype_from_expr_in(items, head)
        _ => mk_str("", 0)
    }
    let builtin_layout0 = wat_builtin_compat_ctor_layout_for_first_type(name, arity, first_ty)
    let builtin_layout = if wat_text_nonempty(builtin_layout0) != 0 { builtin_layout0 }
        else { wat_builtin_compat_ctor_layout_for_first_type(wat_symbol_name_last_part(name), arity, first_ty) }
    if wat_text_nonempty(builtin_layout) != 0 { mk_str("eqref", 5) }
    else { wat_ctor_call_result_valtype(items, name, arity) }
}

def wat_ctor_call_result_valtype_for_args_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, name: Str, args: CirExprList): Str = {
    let arity = wat_expr_list_len(args)
    let first_ty = wat_expr_list_first_valtype_with_body(items, func_name, params, body, args)
    let builtin_layout0 = wat_builtin_compat_ctor_layout_for_first_type(name, arity, first_ty)
    let builtin_layout = if wat_text_nonempty(builtin_layout0) != 0 { builtin_layout0 }
        else { wat_builtin_compat_ctor_layout_for_first_type(wat_symbol_name_last_part(name), arity, first_ty) }
    if wat_text_nonempty(builtin_layout) != 0 { mk_str("eqref", 5) }
    else { wat_ctor_call_result_valtype(items, name, arity) }
}

def wat_known_call_param_option_some_layout(func_name: Str, index: i64): Str =
    if index == 3 && streq(func_name, mk_str("control_resume_shape_finish", 27)) != 0 { mk_str("Option__SomeI64__a1", 19) }
    else if index == 7 && streq(func_name, mk_str("control_resume_shape_loop_for_item", 34)) != 0 { mk_str("Option__SomeI64__a1", 19) }
    else { mk_str("", 0) }

def wat_known_local_option_some_layout_with_body(func_name: Str, params: CirParamList, expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L7CoreOp(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L6OpClosureEnv(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L5OpContinuationPackage(_, _, value) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L5OpCps(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L4OpUsage(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L3OpAnswerControl(value, _, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L2OpTyped(value, _) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L1OpUnsafe(value) => wat_known_local_option_some_layout_with_body(func_name, params, value)
        L1OpRef(L1RefLocal(id, _)) => wat_known_param_option_some_layout_by_id(func_name, params, id, 0)
        _ => mk_str("", 0)
    }

def wat_known_param_option_some_layout_by_id(func_name: Str, params: CirParamList, id: i64, index: i64): Str =
    match params {
        CirParamEnd => mk_str("", 0)
        CirParamCons(param, rest) => {
            let hit = match param {
                L1Param(binder, _) =>
                    if binder.id == id { wat_known_call_param_option_some_layout(func_name, index) }
                    else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
            if hit.len != 0 { hit } else { wat_known_param_option_some_layout_by_id(func_name, rest, id, index + 1) }
        }
    }

def wat_method_name_has_prefix(name: Str, prefix: Str): i64 =
    if name.len < prefix.len { 0 }
    else if streq(mk_str(name.ptr, prefix.len), prefix) != 0 { 1 }
    else { 0 }

def wat_name_has_suffix(name: Str, suffix: Str): i64 =
    if name.len < suffix.len { 0 }
    else if streq(mk_str(name.ptr + name.len - suffix.len, suffix.len), suffix) != 0 { 1 }
    else { 0 }

def wat_local_name_is_bool(name: Str): i64 =
    if wat_method_name_has_prefix(name, mk_str("has_", 4)) != 0 { 1 }
    else if wat_method_name_has_prefix(name, mk_str("is_", 3)) != 0 { 1 }
    else if wat_method_name_has_prefix(name, mk_str("needs_", 6)) != 0 { 1 }
    else if wat_method_name_has_prefix(name, mk_str("allows_", 7)) != 0 { 1 }
    else if wat_method_name_has_prefix(name, mk_str("requires_", 9)) != 0 { 1 }
    else if wat_name_has_suffix(name, mk_str("_ok", 3)) != 0 { 1 }
    else if streq(name, mk_str("grouped", 7)) != 0 { 1 }
    else if streq(name, mk_str("glob", 4)) != 0 { 1 }
    else if streq(name, mk_str("multi", 5)) != 0 { 1 }
    else if streq(name, mk_str("saw_item", 8)) != 0 { 1 }
    else if streq(name, mk_str("escaping", 8)) != 0 { 1 }
    else if streq(name, mk_str("sendable", 8)) != 0 { 1 }
    else if streq(name, mk_str("repeatable", 10)) != 0 { 1 }
    else if streq(name, mk_str("is_metal", 8)) != 0 { 1 }
    else if streq(name, mk_str("no_prelude_import", 17)) != 0 { 1 }
    else if streq(name, mk_str("prev_tail", 9)) != 0 { 1 }
    else if streq(name, mk_str("needs_sep", 9)) != 0 { 1 }
    else { 0 }

def wat_known_predicate_method_result(name: Str): i64 = {
    let local = wat_symbol_name_last_part(name)
    if wat_method_name_has_prefix(local, mk_str("is_", 3)) != 0 { 1 }
    else if wat_method_name_has_prefix(local, mk_str("has_", 4)) != 0 { 1 }
    else if wat_method_name_has_prefix(local, mk_str("allows_", 7)) != 0 { 1 }
    else if wat_method_name_has_prefix(local, mk_str("requires_", 9)) != 0 { 1 }
    else if wat_method_name_has_prefix(local, mk_str("excludes_", 9)) != 0 { 1 }
    else if streq(local, mk_str("eq", 2)) != 0 { 1 }
    else if streq(local, mk_str("before", 6)) != 0 { 1 }
    else if streq(local, mk_str("occurs_in", 9)) != 0 { 1 }
    else if streq(local, mk_str("occurs_in_array", 15)) != 0 { 1 }
    else if wat_name_has_suffix(local, mk_str("_before", 7)) != 0 { 1 }
    else { 0 }
}

def wat_expr_is_local_ref(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_is_local_ref(value)
        L7CoreOp(value, _) => wat_expr_is_local_ref(value)
        L6OpClosureEnv(value, _) => wat_expr_is_local_ref(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_is_local_ref(value)
        L5OpCps(value, _) => wat_expr_is_local_ref(value)
        L4OpUsage(value, _) => wat_expr_is_local_ref(value)
        L3OpAnswerControl(value, _, _) => wat_expr_is_local_ref(value)
        L2OpTyped(value, _) => wat_expr_is_local_ref(value)
        L1OpUnsafe(value) => wat_expr_is_local_ref(value)
        L1OpCast(value, _) => wat_expr_is_local_ref(value)
        L1OpTypeApply(value, _) => wat_expr_is_local_ref(value)
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, _) => 1
                _ => 0
            }
        _ => 0
    }

def wat_valtype_from_expr(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_valtype_from_expr(value)
        L7CoreOp(value, _) => wat_valtype_from_expr(value)
        L6OpClosureEnv(value, _) => wat_valtype_from_expr(value)
        L5OpContinuationPackage(_, _, value) => wat_valtype_from_expr(value)
        L5OpCps(value, _) => wat_valtype_from_expr(value)
        L4OpUsage(value, _) => wat_valtype_from_expr(value)
        L3OpAnswerControl(value, ty, _) =>
            match ty {
                CirTyUnknown => wat_valtype_from_expr(value)
                _ => wat_valtype_from_cir(ty)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_valtype_from_expr(value)
                _ => wat_valtype_from_cir(ty)
            }
        L1OpBlock(_, tail) => wat_valtype_from_expr(tail)
        L1OpIf(_, then_expr, else_expr) => {
            let then_ty = wat_valtype_from_expr(then_expr)
            let else_ty = wat_valtype_from_expr(else_expr)
            wat_merge_valtype(then_ty, else_ty)
        }
        L1OpMatch(_, arms) => wat_match_result_type_from_arms(arms)
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("", 0)) != 0 { wat_valtype_from_expr(value) }
                    else { wat_valtype_from_ast(ty) }
                _ => wat_valtype_from_ast(ty)
            }
        L1OpPrefix(_, _) => "i64"
        L1OpBinary(op, _, _) =>
            if wat_binary_is_compare(op) != 0 { "i64" }
            else if streq(op, mk_str("&&", 2)) != 0 { "i64" }
            else if streq(op, mk_str("||", 2)) != 0 { "i64" }
            else { "i64" }
        L1OpNominalCtor(_, _) => "eqref"
        L1OpField(value, field) => wat_field_valtype_from_expr(value, field)
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, name) =>
                    if wat_local_name_is_bool(name) != 0 { "i64" } else { "eqref" }
                _ => ""
            }
        L1OpCall(callee, args) => {
            let call_name = wat_expr_call_name(callee)
            let known_ty = wat_known_call_result_valtype(call_name)
            if wat_text_nonempty(known_ty) != 0 { known_ty }
            else if wat_text_nonempty(wat_ctor_call_result_valtype(Item_End, call_name, wat_expr_list_len(args))) != 0 { "eqref" }
            else if wat_runtime_heap_type_defined(call_name) != 0 { "eqref" }
            else if wat_runtime_heap_type_defined(wat_symbol_name_last_part(call_name)) != 0 { "eqref" }
            else if wat_known_predicate_method_result(call_name) != 0 { "i64" }
            else if streq(call_name, mk_str("mk_str", 6)) != 0 { "(ref $array_u8)" }
            else {
                let owner = wat_known_call_result_owner(call_name)
                if streq(owner, mk_str("String", 6)) != 0 { "(ref $array_u8)" }
                else if streq(owner, mk_str("", 0)) == 0 { "eqref" }
                else { "eqref" }
            }
        }
        L1OpTypeApply(_, _) => "eqref"
        L1OpStringBytes(_) => "(ref $array_u8)"
        L1OpStringInterp(_) => "(ref $array_u8)"
        _ => "i64"
    }

def wat_result_valtype(items: AST, ret: AST, body: CirExpr): i64 =
    match ret {
        Type_Path(name, _) =>
            if name.len != 0 { wat_valtype_from_ast_in(items, ret) }
            else { wat_valtype_from_expr(body) }
        _ => wat_valtype_from_ast_in(items, ret)
    }

def wat_emit_local_decl_with_type(out: Str, id: i64, value_type: i64): i64 = {
    let safe_value_type = wat_nonempty_valtype(value_type, "i64")
    let _ = str_push_cstr(out, "    (local ")
    let _ = wat_local_name(out, id)
    let _ = str_push(out, 32)
    let _ = str_push_cstr(out, safe_value_type)
    let _ = str_push(out, 41)
    str_push(out, 10)
}

def wat_emit_local_decl(out: Str, id: i64): i64 =
    wat_emit_local_decl_with_type(out, id, "i64")

def wat_merge_valtype(primary: i64, fallback: i64): i64 =
    if wat_text_nonempty(primary) == 0 { fallback }
    else if wat_text_nonempty(fallback) == 0 { primary }
    else if wat_valtype_is_eqref(primary) != 0 || wat_valtype_is_eqref(fallback) != 0 { "eqref" }
    else if wat_valtype_is_i64(primary) != 0 {
        if wat_valtype_is_i64(fallback) != 0 { primary }
        else { primary }
    }
    else { primary }

def wat_merge_let_valtype(declared: i64, value: i64): i64 =
    if wat_text_nonempty(value) == 0 { declared }
    else if wat_valtype_is_ref_storage(value) != 0 { value }
    else { wat_merge_valtype(declared, value) }

def wat_let_value_valtype(ty: i64): i64 =
    wat_merge_let_valtype(mk_str("", 0), ty)

def wat_let_local_decl_valtype(items: AST, value: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype(items, value)
    let inferred_ty = wat_let_value_valtype(wat_valtype_from_expr_in(items, value))
    let merged = wat_merge_let_valtype(heap_ty, inferred_ty)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_expr_valtype_or_fallback(merged, "i64") }
}

def wat_let_local_decl_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, value: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
    let inferred_ty = wat_let_value_valtype(wat_valtype_from_expr_with_body(items, func_name, params, body, value))
    let merged = wat_merge_let_valtype(heap_ty, inferred_ty)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_expr_valtype_or_fallback(merged, "i64") }
}

def wat_typed_let_local_decl_valtype(items: AST, declared: CirType, value: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype(items, value)
    let inferred_ty = wat_merge_let_valtype(wat_valtype_from_cir(declared), wat_valtype_from_expr_in(items, value))
    let merged = wat_merge_let_valtype(heap_ty, inferred_ty)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_expr_valtype_or_fallback(merged, "i64") }
}

def wat_typed_let_local_decl_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, declared: CirType, value: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
    let inferred_ty = wat_merge_let_valtype(wat_valtype_from_cir(declared), wat_valtype_from_expr_with_body(items, func_name, params, body, value))
    let merged = wat_merge_let_valtype(heap_ty, inferred_ty)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_expr_valtype_or_fallback(merged, "i64") }
}

def wat_heap_ctor_value_valtype(items: AST, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_heap_ctor_value_valtype(items, value)
        L7CoreOp(value, _) => wat_heap_ctor_value_valtype(items, value)
        L6OpClosureEnv(value, _) => wat_heap_ctor_value_valtype(items, value)
        L5OpContinuationPackage(_, _, value) => wat_heap_ctor_value_valtype(items, value)
        L5OpCps(value, _) => wat_heap_ctor_value_valtype(items, value)
        L4OpUsage(value, _) => wat_heap_ctor_value_valtype(items, value)
        L3OpAnswerControl(value, _, _) => wat_heap_ctor_value_valtype(items, value)
        L2OpTyped(value, _) => wat_heap_ctor_value_valtype(items, value)
        L1OpUnsafe(value) => wat_heap_ctor_value_valtype(items, value)
        L0OpBlock(_, tail) => wat_heap_ctor_value_valtype(items, tail)
        L1OpBlock(_, tail) => wat_heap_ctor_value_valtype(items, tail)
        L0OpIf(cond, then_expr, else_expr) => wat_heap_ctor_value_valtype(items, L1OpIf(cond, then_expr, else_expr))
        L1OpIf(_, then_expr, else_expr) => wat_merge_let_valtype(wat_heap_ctor_value_valtype(items, then_expr), wat_heap_ctor_value_valtype(items, else_expr))
        L0OpMatch(value, arms) => wat_heap_ctor_value_valtype(items, L1OpMatch(value, arms))
        L1OpMatch(_, arms) => wat_match_result_type_from_arms(arms)
        L1OpCast(value, _) => wat_heap_ctor_value_valtype(items, value)
        L1OpTypeApply(value, _) => wat_heap_ctor_value_valtype(items, value)
        L0OpTypeApply(value, _) => wat_heap_ctor_value_valtype(items, value)
        L0OpName(name) =>
            if wat_text_nonempty(wat_ref_name_declared_zero_ctor(L0RefName(name), items, CirExprEnd)) != 0 { "eqref" }
            else { mk_str("", 0) }
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, local_name) =>
                    if wat_text_nonempty(wat_ref_name_declared_zero_ctor(L1RefUnresolved(mk_str("", 0), local_name), items, CirExprEnd)) != 0 { "eqref" }
                    else { mk_str("", 0) }
                _ =>
                    if wat_text_nonempty(wat_ref_name_declared_zero_ctor(ref, items, CirExprEnd)) != 0 { "eqref" }
                    else { mk_str("", 0) }
            }
        L0OpNominalCtor(name, fields) =>
            if wat_text_nonempty(wat_nominal_ctor_layout_for_fields(items, name, fields)) != 0 { "eqref" } else { "eqref" }
        L1OpNominalCtor(_, _) => "eqref"
        L0OpCall(callee, args) => wat_heap_ctor_value_valtype(items, L1OpCall(callee, args))
        L1OpCall(callee, args) => {
            let call_name = wat_call_name_from_expr(callee)
            if wat_text_nonempty(wat_ctor_call_result_valtype_for_args(items, call_name, args)) != 0 { "eqref" }
            else { mk_str("", 0) }
        }
        _ => mk_str("", 0)
    }

def wat_heap_ctor_value_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L2OpTyped(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L1OpUnsafe(value) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L0OpBlock(_, tail) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, tail)
        L1OpBlock(_, tail) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, tail)
        L0OpIf(cond, then_expr, else_expr) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, L1OpIf(cond, then_expr, else_expr))
        L1OpIf(_, then_expr, else_expr) => wat_merge_let_valtype(wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, then_expr), wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, else_expr))
        L0OpMatch(value, arms) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, L1OpMatch(value, arms))
        L1OpMatch(_, arms) => wat_match_result_type_from_arms_with_body(items, func_name, params, body, arms)
        L1OpCast(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L1OpTypeApply(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L0OpTypeApply(value, _) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, value)
        L0OpName(name) =>
            if wat_text_nonempty(wat_ref_name_declared_zero_ctor(L0RefName(name), items, CirExprEnd)) != 0 { "eqref" }
            else { mk_str("", 0) }
        L1OpRef(ref) =>
            match ref {
                L1RefLocal(_, local_name) =>
                    if wat_text_nonempty(wat_ref_name_declared_zero_ctor(L1RefUnresolved(mk_str("", 0), local_name), items, CirExprEnd)) != 0 { "eqref" }
                    else { mk_str("", 0) }
                _ =>
                    if wat_text_nonempty(wat_ref_name_declared_zero_ctor(ref, items, CirExprEnd)) != 0 { "eqref" }
                    else { mk_str("", 0) }
            }
        L0OpNominalCtor(name, fields) =>
            if wat_text_nonempty(wat_nominal_ctor_layout_for_fields_with_body(items, func_name, params, body, name, fields)) != 0 { "eqref" } else { "eqref" }
        L1OpNominalCtor(_, _) => "eqref"
        L0OpCall(callee, args) => wat_heap_ctor_value_valtype_with_body(items, func_name, params, body, L1OpCall(callee, args))
        L1OpCall(callee, args) => {
            let call_name = wat_call_name_from_expr(callee)
            if wat_text_nonempty(wat_ctor_call_result_valtype_for_args_with_body(items, func_name, params, body, call_name, args)) != 0 { "eqref" }
            else { mk_str("", 0) }
        }
        _ => mk_str("", 0)
    }

def wat_nonempty_valtype(ty: i64, fallback: i64): i64 =
    if strlen(ty) != 0 { ty }
    else if strlen(fallback) != 0 { fallback }
    else { "i64" }

def wat_expr_valtype_or_fallback(ty: i64, fallback: i64): i64 =
    if wat_text_nonempty(ty) != 0 { ty } else { fallback }

def wat_emit_params(out: Str, items: AST, params: CirParamList): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(binder, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = wat_local_name(out, binder.id)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                L0Param(name, ty) => {
                    let _ = str_push_cstr(out, " (param $")
                    let _ = str_push_cstr(out, name)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_params(out, items, rest)
        }
    }

