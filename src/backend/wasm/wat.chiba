def wat_emit_struct_type_line_start(out: Str, name: Str): i64 = {
    let _ = str_push_cstr(out, "  (type $")
    let _ = str_append(out, name)
    str_push_cstr(out, " (struct")
}

def wat_nominal_field_count(fields: AST): i64 =
    match fields {
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(_, _) => 1 + wat_nominal_field_count(tail)
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, _) => 1 + wat_nominal_field_count(tail)
                        _ => wat_nominal_field_count(tail)
                    }
                _ => wat_nominal_field_count(tail)
            }
        _ => 0
    }

def wat_variant_field_count(fields: AST): i64 =
    match fields {
        AdtVariantField_Cons(_, _, tail) => 1 + wat_variant_field_count(tail)
        _ => 0
    }

def wat_typearg_field_count(args: AST): i64 =
    match args {
        TypeArg_Cons(_, tail) => 1 + wat_typearg_field_count(tail)
        _ => 0
    }

def wat_variant_arg_field_count(args: AST): i64 =
    match args {
        AdtVariantArg_Ident(_, AdtVariantArg_Type(_, rest)) => 1 + wat_typearg_field_count(rest)
        AdtVariantArg_Field(_, fields) => wat_variant_field_count(fields)
        _ => 0
    }

def wat_emit_struct_type_line_start_with_arity(out: Str, name: Str, arity: i64): i64 = {
    let _ = str_push_cstr(out, "  (type $")
    let _ = str_append(out, name)
    let _ = str_push_cstr(out, "__a")
    let _ = str_append_i64(out, arity)
    str_push_cstr(out, " (struct")
}

def wat_emit_struct_type_line_start_layout(out: Str, layout: Str): i64 = {
    let _ = str_push_cstr(out, "  (type $")
    let _ = str_append(out, layout)
    str_push_cstr(out, " (struct")
}

def wat_emit_nominal_field_type_defs(out: Str, fields: AST, items: AST): i64 =
    match fields {
        NominalField_Cons(head, tail) => {
            let _ = match head {
                NominalField(_, ty) => {
                    let _ = str_push_cstr(out, " (field ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, ty) => {
                            let _ = str_push_cstr(out, " (field ")
                            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                            str_push(out, 41)
                        }
                        _ => 0
                    }
                _ => 0
            }
            wat_emit_nominal_field_type_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_variant_field_type_defs(out: Str, fields: AST, items: AST): i64 =
    match fields {
        AdtVariantField_Cons(_, ty, tail) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
            let _ = str_push(out, 41)
            wat_emit_variant_field_type_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_typearg_field_defs(out: Str, args: AST, items: AST): i64 =
    match args {
        TypeArg_Cons(head, tail) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, head))
            let _ = str_push(out, 41)
            wat_emit_typearg_field_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_variant_arg_type_defs(out: Str, args: AST, items: AST): i64 =
    match args {
        AdtVariantArg_Ident(name, AdtVariantArg_Type(tail, rest)) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, Type_Path(name, tail)))
            let _ = str_push(out, 41)
            wat_emit_typearg_field_defs(out, rest, items)
        }
        AdtVariantArg_Field(_, fields) => wat_emit_variant_field_type_defs(out, fields, items)
        _ => 0
    }

def wat_variant_declares_layout(owner: Str, variant: AST, layout: Str): i64 =
    match variant {
        AdtVariant(name, args) => {
            let got = str_new()
            let _ = wat_layout_name_with_owner(got, owner, name, wat_variant_arg_field_count(args))
            streq(got, layout)
        }
        _ => 0
    }

def wat_variants_declare_layout(owner: Str, variants: AST, layout: Str): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            if wat_variant_declares_layout(owner, head, layout) != 0 { 1 }
            else { wat_variants_declare_layout(owner, tail, layout) }
        _ => 0
    }

def wat_item_declares_layout(item: AST, layout: Str): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_item_declares_layout(inner, layout)
        Item_Type(ty) =>
            match ty {
                TypeItem(name, _, fields) => {
                    let got = str_new()
                    let _ = wat_layout_name_with_owner(got, name, name, wat_nominal_field_count(fields))
                    streq(got, layout)
                }
                TypeDecl(name, _, TypeDecl_Record(fields)) => {
                    let got = str_new()
                    let _ = wat_layout_name_with_owner(got, name, name, wat_nominal_field_count(fields))
                    streq(got, layout)
                }
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) => {
                    let got = str_new()
                    let _ = wat_layout_name_with_owner(got, name, name, wat_nominal_field_count(fields))
                    streq(got, layout)
                }
                AdtItem(owner, _, variants) => wat_variants_declare_layout(owner, variants, layout)
                _ => 0
            }
        _ => 0
    }

def wat_items_declare_layout(items: AST, layout: Str): i64 =
    match items {
        Item_Cons(head, tail) =>
            if wat_item_declares_layout(head, layout) != 0 { 1 }
            else { wat_items_declare_layout(tail, layout) }
        _ => 0
    }

def wat_emit_record_type_def(out: Str, name: Str, fields: AST, items: AST, rest_items: AST): i64 = {
    let layout = str_new()
    let _ = wat_layout_name_with_owner(layout, name, name, wat_nominal_field_count(fields))
    if wat_items_declare_layout(rest_items, layout) != 0 { 0 }
    else {
        let _ = wat_emit_struct_type_line_start_layout(out, layout)
        let _ = wat_emit_nominal_field_type_defs(out, fields, items)
        let _ = str_push_cstr(out, "))")
        str_push(out, 10)
    }
}

def wat_emit_variant_type_def(out: Str, owner: Str, variant: AST, items: AST, rest_items: AST): i64 =
    match variant {
        AdtVariant(name, args) => {
            let layout = str_new()
            let _ = wat_layout_name_with_owner(layout, owner, name, wat_variant_arg_field_count(args))
            if wat_items_declare_layout(rest_items, layout) != 0 { 0 }
            else {
                let _ = wat_emit_struct_type_line_start_layout(out, layout)
                let _ = wat_emit_variant_arg_type_defs(out, args, items)
                let _ = str_push_cstr(out, "))")
                str_push(out, 10)
            }
        }
        _ => 0
    }

def wat_emit_variant_type_defs(out: Str, owner: Str, variants: AST, items: AST, rest_items: AST): i64 =
    match variants {
        AdtVariant_Cons(head, tail) => {
            let _ = wat_emit_variant_type_def(out, owner, head, items, rest_items)
            wat_emit_variant_type_defs(out, owner, tail, items, rest_items)
        }
        _ => 0
    }

def wat_emit_declared_type_from_item(out: Str, item: AST, items: AST, rest_items: AST): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_emit_declared_type_from_item(out, inner, items, rest_items)
        Item_Type(ty) =>
            match ty {
                TypeItem(name, _, fields) => wat_emit_record_type_def(out, name, fields, items, rest_items)
                TypeDecl(name, _, TypeDecl_Record(fields)) => wat_emit_record_type_def(out, name, fields, items, rest_items)
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) => wat_emit_record_type_def(out, name, fields, items, rest_items)
                AdtItem(owner, _, variants) => wat_emit_variant_type_defs(out, owner, variants, items, rest_items)
                _ => 0
            }
        _ => 0
    }

def wat_emit_declared_type_defs(out: Str, items: AST): i64 =
    match items {
        Item_Cons(head, tail) => {
            let _ = wat_emit_declared_type_from_item(out, head, items, tail)
            wat_emit_declared_type_defs(out, tail)
        }
        _ => 0
    }

def wat_builtin_runtime_defined(name: Str): i64 =
    if streq(name, mk_str("String.len", 10)) != 0 { 1 }
    else if streq(name, mk_str("String.byte_at", 14)) != 0 { 1 }
    else if streq(name, mk_str("String.slice", 12)) != 0 { 1 }
    else if streq(name, mk_str("String.char_at", 14)) != 0 { 1 }
    else if streq(name, mk_str("String.concat", 13)) != 0 { 1 }
    else if streq(name, mk_str("str.len", 7)) != 0 { 1 }
    else if streq(name, mk_str("str.byte_at", 11)) != 0 { 1 }
    else if streq(name, mk_str("str.slice", 9)) != 0 { 1 }
    else if streq(name, mk_str("str.char_at", 11)) != 0 { 1 }
    else if streq(name, mk_str("Vec.new", 7)) != 0 { 1 }
    else if streq(name, mk_str("Vec.len", 7)) != 0 { 1 }
    else if streq(name, mk_str("Vec.push", 8)) != 0 { 1 }
    else if streq(name, mk_str("Vec.freeze", 10)) != 0 { 1 }
    else if streq(name, mk_str("Array.len", 9)) != 0 { 1 }
    else if streq(name, mk_str("Array.get", 9)) != 0 { 1 }
    else if streq(name, mk_str("Array.slice", 11)) != 0 { 1 }
    else if streq(name, mk_str("Array.to_slice", 14)) != 0 { 1 }
    else if streq(name, mk_str("Vec.i64.new", 11)) != 0 { 1 }
    else if streq(name, mk_str("Vec.i64.len", 11)) != 0 { 1 }
    else if streq(name, mk_str("Vec.i64.push", 12)) != 0 { 1 }
    else if streq(name, mk_str("Vec.i64.freeze", 14)) != 0 { 1 }
