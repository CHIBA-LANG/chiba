def wat_emit_match_pattern_binders_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, pattern: AST, value: CirExpr, body: CirExpr): i64 =
    match pattern {
        Pattern_IdentStart(variant, PatternAfterIdent_Atom(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_store_with_body(out, depth, items, func_name, params, body_ctx, wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value), args, 0, value, body)
        Pattern_IdentStart(variant, PatternAfterIdent_Bind(PatternIdent_Call(args))) =>
            wat_match_pattern_arg_store_with_body(out, depth, items, func_name, params, body_ctx, wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value), args, 0, value, body)
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => {
            let _ = if wat_pattern_name_is_ctor(items, name, 0) == 0 {
                let id = wat_expr_local_id_by_name_in_expr(body, name)
                if id >= 0 {
                    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body_ctx, value)
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "local.set ")
                    let _ = wat_local_name(out, id)
                    str_push(out, 10)
                } else { 0 }
            } else { 0 }
            0
        }
        _ => 0
    }

def wat_emit_let_pattern_stmt(out: Str, depth: i64, items: AST, pattern: AST, value: CirExpr, body: CirExpr): i64 = {
    wat_emit_match_pattern_binders(out, depth, items, pattern, value, body)
}

def wat_emit_let_pattern_stmt_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, pattern: AST, value: CirExpr): i64 = {
    wat_emit_match_pattern_binders_with_body(out, depth, items, func_name, params, body_ctx, pattern, value, body_ctx)
}

def wat_match_result_type(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_match_result_type(value)
        L7CoreOp(value, _) => wat_match_result_type(value)
        L6OpClosureEnv(value, _) => wat_match_result_type(value)
        L5OpContinuationPackage(_, _, value) => wat_match_result_type(value)
        L5OpCps(value, _) => wat_match_result_type(value)
        L4OpUsage(value, _) => wat_match_result_type(value)
        L3OpAnswerControl(value, answer, _) =>
            match answer {
                CirTyUnknown => wat_match_result_type(value)
                _ => wat_valtype_from_cir(answer)
            }
        L2OpTyped(value, ty) =>
            match ty {
                CirTyUnknown => wat_match_result_type(value)
                _ => wat_valtype_from_cir(ty)
            }
        L1OpIf(_, then_expr, _) => wat_match_result_type(then_expr)
        L1OpMatch(_, arms) =>
            match arms {
                CirMatchArmCons(L1MatchArm(_, _, body), _) => wat_match_result_type(body)
                _ => "i64"
            }
        L1OpNominalCtor(_, _) => "eqref"
        L1OpStringBytes(_) => "(ref $array_u8)"
        L1OpStringInterp(_) => "(ref $array_u8)"
        _ => wat_valtype_from_expr(expr)
    }

def wat_expr_result_valtype_in(items: AST, expr: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype(items, expr)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_valtype_from_expr_in(items, expr) }
}

def wat_expr_result_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, expr: CirExpr): i64 = {
    let heap_ty = wat_heap_ctor_value_valtype_with_body(items, func_name, params, body_ctx, expr)
    if wat_text_nonempty(heap_ty) != 0 { heap_ty }
    else { wat_valtype_from_expr_with_body(items, func_name, params, body_ctx, expr) }
}

def wat_match_result_type_from_arms(arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmCons(L1MatchArm(_, _, body), _) => wat_match_result_type(body)
        _ => "i64"
    }

def wat_match_result_type_from_arms_with_body(items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmCons(L1MatchArm(_, _, body), _) => wat_expr_result_valtype_with_body(items, func_name, params, body_ctx, body)
        _ => "i64"
    }

def wat_branch_result_valtype_in(items: AST, then_expr: CirExpr, else_expr: CirExpr, fallback: i64): i64 = {
    let then_ty = wat_expr_result_valtype_in(items, then_expr)
    let else_ty = wat_expr_result_valtype_in(items, else_expr)
    let merged = wat_merge_valtype(then_ty, else_ty)
    wat_nonempty_valtype(merged, fallback)
}

def wat_branch_result_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, then_expr: CirExpr, else_expr: CirExpr, fallback: i64): i64 = {
    let then_ty = wat_expr_result_valtype_with_body(items, func_name, params, body_ctx, then_expr)
    let else_ty = wat_expr_result_valtype_with_body(items, func_name, params, body_ctx, else_expr)
    let merged = wat_merge_valtype(then_ty, else_ty)
    wat_nonempty_valtype(merged, fallback)
}

def wat_index_result_valtype(value_ty: i64, args: CirExprList): i64 =
    match args {
        CirExprCons(index, CirExprEnd) =>
            match wat_unwrap_pass_expr(index) {
                L1OpBinary(op, _, _) =>
                    if streq(op, mk_str("..", 2)) != 0 { "(ref $slice_u8)" }
                    else if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $array_u8)", 15)) != 0 { "i64" }
                    else { "eqref" }
                _ =>
                    if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $array_u8)", 15)) != 0 { "i64" }
                    else { "eqref" }
            }
        _ => "eqref"
    }

def wat_expr_call_result_valtype_in(items: AST, expr: CirExpr): i64 =
    match expr {
        L0OpCall(callee, args) => wat_expr_call_result_valtype_in(items, L1OpCall(callee, args))
        L8ValidatedCoreOp(value, _) => wat_expr_call_result_valtype_in(items, value)
        L7CoreOp(value, _) => wat_expr_call_result_valtype_in(items, value)
        L6OpClosureEnv(value, _) => wat_expr_call_result_valtype_in(items, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_call_result_valtype_in(items, value)
        L5OpCps(value, _) => wat_expr_call_result_valtype_in(items, value)
        L4OpUsage(value, _) => wat_expr_call_result_valtype_in(items, value)
        L3OpAnswerControl(value, _, _) => wat_expr_call_result_valtype_in(items, value)
        L2OpTyped(value, ty) => wat_merge_let_valtype(wat_valtype_from_cir(ty), wat_expr_call_result_valtype_in(items, value))
        L1OpCall(callee, args) => {
            let call_name = match wat_unwrap_pass_expr_keep_type(callee) {
                L2OpTyped(L1OpRef(ref), _) => wat_ref_call_name(ref)
                _ => wat_expr_call_name(callee)
            }
            let known = wat_known_call_result_valtype(call_name)
            if wat_text_nonempty(known) != 0 { known }
            else if wat_known_predicate_method_result(call_name) != 0 { "i64" }
            else {
                let ctor_ty = wat_ctor_call_result_valtype_for_args(items, call_name, args)
                if wat_text_nonempty(ctor_ty) != 0 { ctor_ty } else {
                let from_ast = wat_ast_return_valtype(items, call_name)
                if wat_text_nonempty(from_ast) != 0 { from_ast } else { wat_valtype_from_expr(expr) }
                }
            }
        }
        _ => wat_valtype_from_expr(expr)
    }

def wat_expr_call_result_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L0OpCall(callee, args) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, L1OpCall(callee, args))
        L8ValidatedCoreOp(value, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L2OpTyped(value, ty) => wat_merge_let_valtype(wat_valtype_from_cir(ty), wat_expr_call_result_valtype_with_body(items, func_name, params, body, value))
        L1OpUnsafe(value) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, value)
        L1OpCall(callee, args) => {
            let call_name = match wat_unwrap_pass_expr_keep_type(callee) {
                L2OpTyped(L1OpField(value, field), _) => {
                    let owner = wat_expr_method_owner_with_body(items, func_name, params, body, value)
                    if owner.len != 0 { wat_method_name(owner, field) }
                    else if wat_valtype_is_array_u8(wat_valtype_from_expr_with_body(items, func_name, params, body, value)) != 0 { wat_method_name(mk_str("str", 3), field) }
                    else { wat_expr_call_name(callee) }
                }
                L2OpTyped(L0OpField(value, field), _) => {
                    let owner = wat_expr_method_owner_with_body(items, func_name, params, body, value)
                    if owner.len != 0 { wat_method_name(owner, field) }
                    else if wat_valtype_is_array_u8(wat_valtype_from_expr_with_body(items, func_name, params, body, value)) != 0 { wat_method_name(mk_str("str", 3), field) }
                    else { wat_expr_call_name(callee) }
                }
                L1OpField(value, field) => {
                    let owner = wat_expr_method_owner_with_body(items, func_name, params, body, value)
                    if owner.len != 0 { wat_method_name(owner, field) }
                    else if wat_valtype_is_array_u8(wat_valtype_from_expr_with_body(items, func_name, params, body, value)) != 0 { wat_method_name(mk_str("str", 3), field) }
                    else { wat_expr_call_name(callee) }
                }
                L0OpField(value, field) => {
                    let owner = wat_expr_method_owner_with_body(items, func_name, params, body, value)
                    if owner.len != 0 { wat_method_name(owner, field) }
                    else if wat_valtype_is_array_u8(wat_valtype_from_expr_with_body(items, func_name, params, body, value)) != 0 { wat_method_name(mk_str("str", 3), field) }
                    else { wat_expr_call_name(callee) }
                }
                L2OpTyped(L1OpRef(ref), _) => wat_ref_call_name(ref)
                _ => wat_expr_call_name(callee)
            }
            let known = wat_known_call_result_valtype(call_name)
            if wat_text_nonempty(known) != 0 { known }
            else if wat_known_predicate_method_result(call_name) != 0 { "i64" }
            else {
                let ctor_ty = wat_ctor_call_result_valtype_for_args_with_body(items, func_name, params, body, call_name, args)
                if wat_text_nonempty(ctor_ty) != 0 { ctor_ty } else {
                let from_ast = wat_ast_return_valtype(items, call_name)
                if wat_text_nonempty(from_ast) != 0 { from_ast } else { wat_valtype_from_expr(expr) }
                }
            }
        }
        _ => wat_valtype_from_expr(expr)
    }

def wat_valtype_from_expr_in(items: AST, expr: CirExpr): i64 =
    match expr {
        L0OpBlock(_, tail) => wat_valtype_from_expr_in(items, tail)
        L0OpIf(cond, then_expr, else_expr) => wat_valtype_from_expr_in(items, L1OpIf(cond, then_expr, else_expr))
        L0OpMatch(value, arms) => wat_valtype_from_expr_in(items, L1OpMatch(value, arms))
        L0OpCall(callee, args) => wat_expr_call_result_valtype_in(items, L1OpCall(callee, args))
        L0OpField(value, field) => wat_valtype_from_expr_in(items, L1OpField(value, field))
        L0OpIndex(value, args) => wat_valtype_from_expr_in(items, L1OpIndex(value, args))
        L0OpNominalCtor(_, _) => "eqref"
        L0OpStringBytes(_) => "(ref $array_u8)"
        L0OpStringInterp(_) => "(ref $array_u8)"
        L0OpInt(_) => "i64"
        L0OpBool(_) => "i64"
        L0OpUnit => "i64"
        L8ValidatedCoreOp(value, _) => wat_valtype_from_expr_in(items, value)
        L7CoreOp(value, _) => wat_valtype_from_expr_in(items, value)
        L6OpClosureEnv(value, _) => wat_valtype_from_expr_in(items, value)
        L5OpContinuationPackage(_, _, value) => wat_valtype_from_expr_in(items, value)
        L5OpCps(value, _) => wat_valtype_from_expr_in(items, value)
        L4OpUsage(value, _) => wat_valtype_from_expr_in(items, value)
        L3OpAnswerControl(value, _, _) => wat_valtype_from_expr_in(items, value)
        L2OpTyped(value, ty) => wat_merge_let_valtype(wat_valtype_from_cir(ty), wat_valtype_from_expr_in(items, value))
        L1OpBlock(_, tail) => wat_valtype_from_expr_in(items, tail)
        L1OpIf(_, then_expr, else_expr) => wat_merge_valtype(wat_valtype_from_expr_in(items, then_expr), wat_valtype_from_expr_in(items, else_expr))
        L1OpMatch(_, arms) => wat_match_result_type_from_arms(arms)
        L1OpNominalCtor(name, fields) =>
            if wat_text_nonempty(wat_nominal_ctor_layout_for_fields(items, name, fields)) != 0 { "eqref" } else { "eqref" }
        L1OpCall(_, _) => wat_expr_call_result_valtype_in(items, expr)
        L1OpIndex(value, args) => {
            let value_ty = wat_valtype_from_expr_in(items, value)
            wat_index_result_valtype(value_ty, args)
        }
        _ => wat_valtype_from_expr(expr)
    }

def wat_valtype_from_expr_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L0OpBlock(_, tail) => wat_valtype_from_expr_with_body(items, func_name, params, body, tail)
        L0OpIf(cond, then_expr, else_expr) => wat_valtype_from_expr_with_body(items, func_name, params, body, L1OpIf(cond, then_expr, else_expr))
        L0OpMatch(value, arms) => wat_valtype_from_expr_with_body(items, func_name, params, body, L1OpMatch(value, arms))
        L0OpCall(callee, args) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, L1OpCall(callee, args))
        L0OpField(value, field) => wat_valtype_from_expr_with_body(items, func_name, params, body, L1OpField(value, field))
        L0OpIndex(value, args) => wat_valtype_from_expr_with_body(items, func_name, params, body, L1OpIndex(value, args))
        L0OpNominalCtor(_, _) => "eqref"
        L0OpStringBytes(_) => "(ref $array_u8)"
        L0OpStringInterp(_) => "(ref $array_u8)"
        L0OpInt(_) => "i64"
        L0OpBool(_) => "i64"
        L0OpUnit => "i64"
        L8ValidatedCoreOp(value, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L2OpTyped(value, ty) => wat_merge_let_valtype(wat_valtype_from_cir(ty), wat_valtype_from_expr_with_body(items, func_name, params, body, value))
        L1OpUnsafe(value) => wat_valtype_from_expr_with_body(items, func_name, params, body, value)
        L1OpBlock(_, tail) => wat_valtype_from_expr_with_body(items, func_name, params, body, tail)
        L1OpIf(_, then_expr, else_expr) => wat_merge_valtype(wat_valtype_from_expr_with_body(items, func_name, params, body, then_expr), wat_valtype_from_expr_with_body(items, func_name, params, body, else_expr))
        L1OpMatch(_, arms) => wat_match_result_type_from_arms_with_body(items, func_name, params, body, arms)
        L1OpNominalCtor(name, fields) =>
            if wat_text_nonempty(wat_nominal_ctor_layout_for_fields_with_body(items, func_name, params, body, name, fields)) != 0 { "eqref" } else { "eqref" }
        L1OpCall(_, _) => wat_expr_call_result_valtype_with_body(items, func_name, params, body, expr)
        L1OpIndex(value, args) => {
            let value_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, value)
            wat_index_result_valtype(value_ty, args)
        }
	        L1OpField(value, field) => {
	            let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
	            let owner1 = wat_field_owner_from_expr(value)
	            let owner = if owner0.len != 0 { owner0 } else if owner1.len != 0 { owner1 } else { wat_owner_from_known_field_name(field) }
	            if owner.len != 0 { wat_field_valtype_from_owner(owner, field) }
	            else { wat_field_valtype_from_expr(value, field) }
	        }
        L1OpCast(value, ty) =>
            match ty {
                Type_Path(name, _) =>
                    if streq(name, mk_str("", 0)) != 0 { wat_valtype_from_expr_with_body(items, func_name, params, body, value) }
                    else { wat_valtype_from_ast_in(items, ty) }
                _ => wat_valtype_from_ast_in(items, ty)
            }
        L1OpPrefix(_, _) => "i64"
        L1OpBinary(op, _, _) =>
            if wat_binary_is_compare(op) != 0 { "i64" }
            else if streq(op, mk_str("&&", 2)) != 0 { "i64" }
            else if streq(op, mk_str("||", 2)) != 0 { "i64" }
            else { wat_valtype_from_expr_in(items, expr) }
        L1OpRef(L1RefLocal(id, _)) => {
            let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
            if wat_text_nonempty(param_ty) != 0 { param_ty }
            else {
                let local_ty = wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id)
                if wat_text_nonempty(local_ty) != 0 { local_ty } else { wat_valtype_from_expr_in(items, expr) }
            }
        }
        _ => wat_valtype_from_expr_in(items, expr)
    }

def wat_local_ref_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L2OpTyped(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L1OpUnsafe(value) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L1OpCast(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L1OpTypeApply(value, _) => wat_local_ref_valtype_with_body(items, func_name, params, body, value)
        L1OpRef(L1RefLocal(id, _)) => {
            let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
            if wat_text_nonempty(param_ty) != 0 { param_ty }
            else { wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id) }
        }
        _ => ""
    }

def wat_emit_truthy_expr_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 = {
    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, expr)
    let local_ty = wat_local_ref_valtype_with_body(items, func_name, params, body, expr)
    let ty = if wat_text_nonempty(local_ty) != 0 { local_ty } else { wat_valtype_from_expr_with_body(items, func_name, params, body, expr) }
    if wat_valtype_is_i64(ty) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else if wat_valtype_is_i32(ty) != 0 {
        let _ = wat_line(out, depth, "i32.const 0")
        wat_line(out, depth, "i32.ne")
    } else if wat_expr_is_scalar_truthy_with_body(items, func_name, params, body, expr) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else if wat_expr_is_local_ref(expr) != 0 {
        let _ = wat_line(out, depth, "i64.const 0")
        wat_line(out, depth, "i64.ne")
    } else {
        let _ = wat_line(out, depth, "ref.is_null")
        wat_line(out, depth, "i32.eqz")
    }
}

def wat_emit_match_variant_test(out: Str, depth: i64, items: AST, value: CirExpr, variant: Str): i64 = {
    let _ = wat_emit_expr_in(out, depth, items, value)
    wat_emit_ref_test_layout(out, depth, items, variant)
}

def wat_emit_match_expr(out: Str, depth: i64, items: AST, value: CirExpr, arms: CirMatchArmList, result_ty: i64): i64 =
    match arms {
        CirMatchArmEnd => wat_line(out, depth, "unreachable ;; non-exhaustive match unsupported")
        CirMatchArmCons(arm, rest) =>
            match arm {
                L1MatchArm(pattern, MatchGuard_None, body) => {
                    let variant = wat_pattern_variant_name(pattern)
                    let layout = match pattern {
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Call(args))) => wat_pattern_variant_layout_for_value(items, variant, args, value)
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Call(args))) => wat_pattern_variant_layout_for_value(items, variant, args, value)
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Name)) => {
                            let found = wat_ctor_layout_name_for_call(items, variant, 0)
                            if found.len != 0 { found } else { variant }
                        }
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Name)) => {
                            let found = wat_ctor_layout_name_for_call(items, variant, 0)
                            if found.len != 0 { found } else { variant }
                        }
                        _ => variant
                    }
                    let is_ctor = match pattern {
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Call(args))) => wat_pattern_name_is_ctor(items, variant, wat_pattern_arg_count(args))
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Call(args))) => wat_pattern_name_is_ctor(items, variant, wat_pattern_arg_count(args))
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Name)) => wat_pattern_name_is_ctor(items, variant, 0)
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Name)) => wat_pattern_name_is_ctor(items, variant, 0)
                        _ => 0
                    }
                    let _ = if variant.len == 0 { wat_line(out, depth, "i32.const 1") }
                    else if is_ctor == 0 { wat_line(out, depth, "i32.const 1") }
                    else { wat_emit_match_variant_test(out, depth, items, value, layout) }
                    let safe_result_ty = wat_nonempty_valtype(result_ty, "eqref")
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "if (result ")
                    let _ = str_push_cstr(out, safe_result_ty)
                    let _ = str_push_cstr(out, ")")
                    let _ = str_push(out, 10)
                    let _ = wat_emit_match_pattern_binders(out, depth + 1, items, pattern, value, body)
                    let _ = wat_emit_expr_with_result_hint(out, depth + 1, items, body, safe_result_ty)
                    let _ = match rest {
                        CirMatchArmEnd => {
                            let _ = wat_line(out, depth, "else")
                            wat_line(out, depth + 1, "unreachable ;; impossible final match arm miss")
                        }
                        _ => {
                            let _ = wat_line(out, depth, "else")
                            wat_emit_match_expr(out, depth + 1, items, value, rest, safe_result_ty)
                        }
                    }
                    wat_line(out, depth, "end")
                }
                _ => wat_line(out, depth, "unreachable ;; guarded match unsupported")
            }
    }

def wat_emit_match_expr_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body_ctx: CirExpr, value: CirExpr, arms: CirMatchArmList, result_ty: i64): i64 =
    match arms {
        CirMatchArmEnd => wat_line(out, depth, "unreachable ;; non-exhaustive match unsupported")
        CirMatchArmCons(arm, rest) =>
            match arm {
                L1MatchArm(pattern, MatchGuard_None, arm_body) => {
                    let variant = wat_pattern_variant_name(pattern)
                    let layout = match pattern {
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Call(args))) => wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value)
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Call(args))) => wat_pattern_variant_layout_for_value_with_body(items, func_name, params, body_ctx, variant, args, value)
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Name)) => {
                            let found = wat_ctor_layout_name_for_call(items, variant, 0)
                            if found.len != 0 { found } else { variant }
                        }
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Name)) => {
                            let found = wat_ctor_layout_name_for_call(items, variant, 0)
                            if found.len != 0 { found } else { variant }
                        }
                        _ => variant
                    }
                    let is_ctor = match pattern {
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Call(args))) => wat_pattern_name_is_ctor(items, variant, wat_pattern_arg_count(args))
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Call(args))) => wat_pattern_name_is_ctor(items, variant, wat_pattern_arg_count(args))
                        Pattern_IdentStart(_, PatternAfterIdent_Atom(PatternIdent_Name)) => wat_pattern_name_is_ctor(items, variant, 0)
                        Pattern_IdentStart(_, PatternAfterIdent_Bind(PatternIdent_Name)) => wat_pattern_name_is_ctor(items, variant, 0)
                        _ => 0
                    }
                    let _ = if variant.len == 0 { wat_line(out, depth, "i32.const 1") }
                    else if is_ctor == 0 { wat_line(out, depth, "i32.const 1") }
                    else { wat_emit_match_variant_test(out, depth, items, value, layout) }
                    let arm_ty = wat_valtype_from_expr_with_body(items, func_name, params, body_ctx, arm_body)
                    let safe_result_ty = wat_nonempty_valtype(result_ty, wat_nonempty_valtype(arm_ty, "eqref"))
                    let _ = wat_indent(out, depth)
                    let _ = str_push_cstr(out, "if (result ")
                    let _ = str_push_cstr(out, safe_result_ty)
                    let _ = str_push_cstr(out, ")")
                    let _ = str_push(out, 10)
                    let _ = wat_emit_match_pattern_binders_with_body(out, depth + 1, items, func_name, params, body_ctx, pattern, value, arm_body)
                    let _ = wat_emit_expr_with_result_hint_body(out, depth + 1, items, func_name, params, body_ctx, arm_body, safe_result_ty)
                    let _ = match rest {
                        CirMatchArmEnd => {
                            let _ = wat_line(out, depth, "else")
                            wat_line(out, depth + 1, "unreachable ;; impossible final match arm miss")
                        }
                        _ => {
                            let _ = wat_line(out, depth, "else")
                            wat_emit_match_expr_with_body(out, depth + 1, items, func_name, params, body_ctx, value, rest, safe_result_ty)
                        }
                    }
                    wat_line(out, depth, "end")
                }
                _ => wat_line(out, depth, "unreachable ;; guarded match unsupported")
            }
    }

def wat_emit_call_name(out: Str, depth: i64, name: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "call ")
    let _ = if wat_ref_call_uses_arity_mangle(name) != 0 { wat_func_name_with_arity(out, name, wat_known_param_count(name)) }
    else { wat_func_name(out, name) }
    str_push(out, 10)
}

def wat_emit_method_call(out: Str, depth: i64, items: AST, value: CirExpr, field: Str, args: CirExprList): i64 =
    if wat_is_string_char_method(field) != 0 && wat_expr_is_string_array(value) != 0 {
        wat_emit_string_char_method_call(out, depth, items, value, args)
    } else {
        let owner0 = wat_effective_method_owner(value)
        let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
        if owner.len == 0 {
            wat_line(out, depth, "unreachable ;; method call unsupported")
        } else if wat_is_string_to_slice_method(owner, field) != 0 {
            wat_emit_array_u8_full_slice(out, depth, items, value)
        } else if wat_is_string_concat_method(owner, field) != 0 {
            match args {
                CirExprCons(rhs, CirExprEnd) => {
                    let _ = wat_emit_expr_with_result_hint(out, depth, items, value, "(ref $array_u8)")
                    let _ = wat_emit_expr_with_result_hint(out, depth, items, rhs, "(ref $array_u8)")
                    wat_line(out, depth, "call $__chiba_string_concat2")
                }
                _ => wat_line(out, depth, "unreachable ;; string concat arity unsupported")
            }
        } else if wat_expr_is_type_application(value) != 0 && wat_is_array_like_owner(owner) != 0 {
            if streq(field, mk_str("new", 3)) != 0 {
                wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
            } else {
                wat_line(out, depth, "unreachable ;; generic collection type method unsupported")
            }
        } else if wat_expr_is_scalar_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_emit_expr_list(out, depth, items, args)
            wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
        } else if wat_expr_is_ref_vec_or_array(value) != 0 && wat_is_array_like_owner(owner) != 0 {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_emit_expr_list(out, depth, items, args)
            wat_emit_call_name(out, depth, wat_method_name(owner, field))
        } else if wat_is_array_like_owner(owner) != 0 || streq(owner, mk_str("Slice", 5)) != 0 {
            let _ = if wat_expr_is_type_application(value) != 0 { 0 } else { wat_emit_expr_in(out, depth, items, value) }
            let _ = wat_emit_expr_list(out, depth, items, args)
            wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
        } else {
            let _ = if wat_expr_is_type_application(value) != 0 { 0 } else { wat_emit_expr_in(out, depth, items, value) }
            let _ = wat_emit_expr_list(out, depth, items, args)
            wat_emit_call_name(out, depth, wat_method_name(owner, field))
        }
    }

def wat_expr_method_owner_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): Str =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L5OpCps(value, _) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => {
            let owner = wat_expr_method_owner(expr)
            if owner.len != 0 { owner } else { wat_expr_method_owner_with_body(items, func_name, params, body, value) }
        }
	        L2OpTyped(value, _) => {
	            let owner = wat_expr_method_owner(expr)
	            if owner.len != 0 { owner } else { wat_expr_method_owner_with_body(items, func_name, params, body, value) }
	        }
	        L1OpUnsafe(value) => wat_expr_method_owner_with_body(items, func_name, params, body, value)
	        L1OpCast(value, ty) => {
	            let owner = wat_type_owner_name_from_ast(ty)
	            if owner.len != 0 { owner } else { wat_expr_method_owner_with_body(items, func_name, params, body, value) }
	        }
	        L1OpRef(L1RefLocal(id, _)) => {
	            let owner = wat_param_owner_by_id(func_name, params, id)
	            if owner.len != 0 { owner }
	            else {
	                let param_ty = wat_param_valtype_by_id(items, func_name, params, id, 0)
	                let param_owner = wat_owner_from_valtype(param_ty)
	                if param_owner.len != 0 { param_owner }
	                else {
	                    let local_ty = wat_local_valtype_by_id_before_in_expr(items, func_name, params, body, body, id)
	                    wat_owner_from_valtype(local_ty)
	                }
	            }
	        }
        _ => wat_expr_method_owner(expr)
    }

def wat_emit_expr_list_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, head)
            wat_emit_expr_list_with_body(out, depth, items, func_name, params, body, tail)
        }
    }

def wat_emit_expr_list_for_layout_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, layout: Str, args: CirExprList, index: i64): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let hint = wat_layout_field_valtype(layout, index)
            let _ = if wat_text_nonempty(hint) != 0 { wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, head, hint) }
                else { wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, head) }
            wat_emit_expr_list_for_layout_with_body(out, depth, items, func_name, params, body, layout, tail, index + 1)
        }
    }

def wat_emit_expr_result_hint_cast(out: Str, depth: i64, expr_ty: i64, result_ty: i64): i64 =
    if wat_valtype_is_array_u8_ref(result_ty) != 0 && wat_valtype_is_array_u8_ref(expr_ty) == 0 {
        wat_line(out, depth, "ref.cast (ref $array_u8)")
    } else { 0 }

def wat_emit_expr_result_hint_cast_for_expr(out: Str, depth: i64, expr: CirExpr, expr_ty: i64, result_ty: i64): i64 =
    if wat_valtype_is_array_u8_ref(result_ty) != 0 {
        let _ = wat_line(out, depth, "ref.cast (ref $array_u8)")
        1
    } else { wat_emit_expr_result_hint_cast(out, depth, expr_ty, result_ty) }

def wat_emit_expr_list_for_call_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, call_name: Str, args: CirExprList, index: i64): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let option_layout = wat_known_call_param_option_some_layout(call_name, index)
            let hint = if option_layout.len != 0 { option_layout }
                else if wat_known_param_type_exists(call_name, index) != 0 { wat_known_param_type(call_name, index) }
                else { mk_str("", 0) }
            let _ = if option_layout.len != 0 { wat_emit_expr_with_result_hint_body(out, depth, items, call_name, params, body, head, option_layout) }
                else if wat_text_nonempty(hint) != 0 { wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, head, hint) }
                else { wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, head) }
            wat_emit_expr_list_for_call_with_body(out, depth, items, func_name, params, body, call_name, tail, index + 1)
        }
    }

def wat_emit_method_call_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, value: CirExpr, field: Str, args: CirExprList): i64 = {
    let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
    let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
    if owner.len == 0 {
        wat_line(out, depth, "unreachable ;; method call unsupported")
    } else if wat_is_string_concat_method(owner, field) != 0 {
        match args {
            CirExprCons(rhs, CirExprEnd) => {
                let _ = wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, "(ref $array_u8)")
                let _ = wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, rhs, "(ref $array_u8)")
                wat_line(out, depth, "call $__chiba_string_concat2")
            }
            _ => wat_line(out, depth, "unreachable ;; string concat arity unsupported")
        }
    } else if wat_is_string_to_slice_method(owner, field) != 0 {
        wat_emit_array_u8_full_slice_with_body(out, depth, items, func_name, params, body, value)
    } else if wat_expr_is_type_application(value) != 0 && wat_is_array_like_owner(owner) != 0 {
        if streq(field, mk_str("new", 3)) != 0 {
            wat_emit_call_name(out, depth, wat_array_like_runtime_name_with_body(items, func_name, params, body, owner, field, value))
        } else {
            wat_line(out, depth, "unreachable ;; generic collection type method unsupported")
        }
        } else if wat_is_array_like_owner(owner) != 0 || streq(owner, mk_str("Slice", 5)) != 0 {
            let _ = if wat_expr_is_type_application(value) != 0 { 0 } else { wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value) }
            let call_name = wat_array_like_runtime_name_with_body(items, func_name, params, body, owner, field, value)
            let _ = wat_emit_expr_list_for_call_with_body(out, depth, items, func_name, params, body, call_name, args, 1)
            wat_emit_call_name(out, depth, call_name)
    } else {
        let _ = if wat_expr_is_type_application(value) != 0 { 0 } else { wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value) }
        let call_name = wat_method_name(owner, field)
        let _ = wat_emit_expr_list_for_call_with_body(out, depth, items, func_name, params, body, call_name, args, 1)
        wat_emit_call_name(out, depth, call_name)
    }
}

def wat_emit_direct_ref_call(out: Str, depth: i64, items: AST, ref: CirRef, args: CirExprList): i64 =
    if wat_is_load8_name(wat_ref_name_text(ref)) != 0 {
        wat_emit_load8_call(out, depth, items, args)
    } else if wat_is_ref_name(ref, mk_str("__tuple", 7)) != 0 {
        if wat_expr_list_len(args) == 0 {
            wat_line(out, depth, "i64.const 0")
        } else {
            let _ = wat_emit_expr_list(out, depth, items, args)
            wat_emit_tuple_struct_new(out, depth, args)
        }
    } else if wat_emit_zero_ctor_if_declared(out, depth, items, ref, args) != 0 { 0 }
    else if wat_emit_ctor_call_if_declared(out, depth, items, ref, args) != 0 { 0 }
    else if wat_ref_is_direct_callable(ref) != 0 {
        let _ = wat_emit_expr_list(out, depth, items, args)
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "call ")
        let _ = wat_ref_func_name_with_args_in(out, items, ref, args)
        str_push(out, 10)
    } else {
        wat_line(out, depth, "unreachable ;; indirect call unsupported")
    }

def wat_emit_direct_ref_call_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, ref: CirRef, args: CirExprList): i64 =
    if wat_is_load8_name(wat_ref_name_text(ref)) != 0 {
        match args {
            CirExprCons(ptr, CirExprCons(offset, CirExprEnd)) => {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, ptr)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, offset)
                let _ = wat_line(out, depth, "i32.wrap_i64")
                let _ = wat_line(out, depth, "array.get_u $array_u8")
                wat_line(out, depth, "i64.extend_i32_u")
            }
            _ => wat_line(out, depth, "unreachable ;; load8 arity unsupported")
        }
    } else if wat_is_ref_name(ref, mk_str("__tuple", 7)) != 0 {
        if wat_expr_list_len(args) == 0 {
            wat_line(out, depth, "i64.const 0")
        } else {
            let _ = wat_emit_expr_list_with_body(out, depth, items, func_name, params, body, args)
            wat_emit_tuple_struct_new(out, depth, args)
        }
    } else if wat_emit_zero_ctor_if_declared(out, depth, items, ref, args) != 0 { 0 }
    else if wat_emit_ctor_call_if_declared_with_body(out, depth, items, func_name, params, body, ref, args) != 0 { 0 }
    else if wat_ref_is_direct_callable(ref) != 0 {
        let _ = wat_emit_expr_list_for_call_with_body(out, depth, items, func_name, params, body, wat_ref_call_name(ref), args, 0)
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "call ")
        let _ = wat_ref_func_name_with_args_in(out, items, ref, args)
        str_push(out, 10)
    } else {
        wat_line(out, depth, "unreachable ;; indirect call unsupported")
    }

def wat_emit_local_callable_call_ref(out: Str, depth: i64, items: AST, callee: CirExpr, args: CirExprList, fn_type: Str): i64 = {
    let _ = wat_emit_expr_list(out, depth, items, args)
    let _ = wat_emit_expr_in(out, depth, items, callee)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.cast (ref $")
    let _ = str_append(out, fn_type)
    let _ = str_push_cstr(out, ")")
    let _ = str_push(out, 10)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "call_ref $")
    let _ = str_append(out, fn_type)
    str_push(out, 10)
}

def wat_emit_local_callable_call_ref_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, callee: CirExpr, args: CirExprList, fn_type: Str): i64 = {
    let _ = wat_emit_expr_list_with_body(out, depth, items, func_name, params, body, args)
    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, callee)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "ref.cast (ref $")
    let _ = str_append(out, fn_type)
    let _ = str_push_cstr(out, ")")
    let _ = str_push(out, 10)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "call_ref $")
    let _ = str_append(out, fn_type)
    str_push(out, 10)
}

def wat_emit_typed_indirect_call(out: Str, depth: i64, items: AST, callee: CirExpr, ty: CirType, args: CirExprList): i64 = {
    let fn_type = wat_callable_ref_type_name(ty)
    if fn_type.len == 0 {
        wat_line(out, depth, "unreachable ;; indirect call unsupported")
    } else {
        wat_emit_local_callable_call_ref(out, depth, items, callee, args, fn_type)
    }
}

def wat_emit_typed_indirect_call_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, callee: CirExpr, ty: CirType, args: CirExprList): i64 = {
    let fn_type = wat_callable_ref_type_name(ty)
    if fn_type.len == 0 {
        wat_line(out, depth, "unreachable ;; indirect call unsupported")
    } else {
        wat_emit_local_callable_call_ref_with_body(out, depth, items, func_name, params, body, callee, args, fn_type)
    }
}

def wat_index_is_range_arg(arg: CirExpr): i64 =
    match wat_unwrap_pass_expr(arg) {
        L1OpBinary(op, _, _) => streq(op, mk_str("..", 2))
        _ => 0
    }

def wat_index_call_name(owner: Str, value: CirExpr, value_ty: i64, index: CirExpr): Str =
    if streq(owner, mk_str("Slice", 5)) != 0 { if wat_index_is_range_arg(index) != 0 { mk_str("Slice.slice", 11) } else { mk_str("Slice.get", 9) } }
    else if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $slice_u8)", 15)) != 0 { if wat_index_is_range_arg(index) != 0 { mk_str("Slice.slice", 11) } else { mk_str("Slice.get", 9) } }
    else if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $array_u8)", 15)) != 0 { mk_str("__chiba_string_byte_at", 22) }
    else if wat_is_array_like_owner(owner) != 0 {
        if wat_index_is_range_arg(index) != 0 { wat_array_like_runtime_name(owner, mk_str("slice", 5), value) }
        else { wat_array_like_runtime_name(owner, mk_str("get", 3), value) }
    } else { mk_str("", 0) }

def wat_index_call_name_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, owner: Str, value: CirExpr, value_ty: i64, index: CirExpr): Str =
    if streq(owner, mk_str("Slice", 5)) != 0 { if wat_index_is_range_arg(index) != 0 { mk_str("Slice.slice", 11) } else { mk_str("Slice.get", 9) } }
    else if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $slice_u8)", 15)) != 0 { if wat_index_is_range_arg(index) != 0 { mk_str("Slice.slice", 11) } else { mk_str("Slice.get", 9) } }
    else if streq(mk_str(value_ty, strlen(value_ty)), mk_str("(ref $array_u8)", 15)) != 0 { mk_str("__chiba_string_byte_at", 22) }
    else if wat_is_array_like_owner(owner) != 0 {
        if wat_index_is_range_arg(index) != 0 { wat_array_like_runtime_name_with_body(items, func_name, params, body, owner, mk_str("slice", 5), value) }
        else { wat_array_like_runtime_name_with_body(items, func_name, params, body, owner, mk_str("get", 3), value) }
    } else { mk_str("", 0) }

def wat_emit_index_call(out: Str, depth: i64, items: AST, value: CirExpr, index: CirExpr, call_name: Str): i64 =
    match wat_unwrap_pass_expr(index) {
        L1OpBinary(op, start, end) =>
            if streq(op, mk_str("..", 2)) != 0 {
                let _ = wat_emit_expr_in(out, depth, items, value)
                let _ = wat_emit_expr_in(out, depth, items, start)
                let _ = wat_emit_expr_in(out, depth, items, end)
                wat_emit_call_name(out, depth, call_name)
            } else {
                let _ = wat_emit_expr_in(out, depth, items, value)
                let _ = wat_emit_expr_in(out, depth, items, index)
                wat_emit_call_name(out, depth, call_name)
            }
        _ => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_emit_expr_in(out, depth, items, index)
            wat_emit_call_name(out, depth, call_name)
        }
    }

def wat_emit_index_call_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, value: CirExpr, index: CirExpr, call_name: Str): i64 =
    match wat_unwrap_pass_expr(index) {
        L1OpBinary(op, start, end) =>
            if streq(op, mk_str("..", 2)) != 0 {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, start)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, end)
                wat_emit_call_name(out, depth, call_name)
            } else {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, index)
                wat_emit_call_name(out, depth, call_name)
            }
        _ => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, index)
            wat_emit_call_name(out, depth, call_name)
        }
    }

def wat_emit_string_index(out: Str, depth: i64, items: AST, value: CirExpr, index: CirExpr): i64 =
    match wat_unwrap_pass_expr(index) {
        L1OpBinary(op, start, end) =>
            if streq(op, mk_str("..", 2)) != 0 {
                let _ = wat_emit_expr_in(out, depth, items, value)
                let _ = wat_emit_expr_in(out, depth, items, start)
                let _ = wat_emit_expr_in(out, depth, items, end)
                wat_line(out, depth, "call $__chiba_string_slice")
            } else {
                let _ = wat_emit_expr_in(out, depth, items, value)
                let _ = wat_emit_expr_in(out, depth, items, index)
                wat_line(out, depth, "call $__chiba_string_byte_at")
            }
        _ => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_emit_expr_in(out, depth, items, index)
            wat_line(out, depth, "call $__chiba_string_byte_at")
        }
    }

def wat_emit_string_index_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, value: CirExpr, index: CirExpr): i64 =
    match wat_unwrap_pass_expr(index) {
        L1OpBinary(op, start, end) =>
            if streq(op, mk_str("..", 2)) != 0 {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, start)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, end)
                wat_line(out, depth, "call $__chiba_string_slice")
            } else {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, index)
                wat_line(out, depth, "call $__chiba_string_byte_at")
            }
        _ => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, index)
            wat_line(out, depth, "call $__chiba_string_byte_at")
        }
    }

def wat_emit_field_access(out: Str, depth: i64, items: AST, value: CirExpr, field: Str, owner: Str): i64 =
    if streq(field, mk_str("len", 3)) != 0 && wat_expr_is_string_array(value) != 0 {
        let _ = wat_emit_expr_in(out, depth, items, value)
        wat_line(out, depth, "call $str.len")
    } else {
        let _ = wat_emit_expr_in(out, depth, items, value)
        let tuple_index = wat_tuple_field_index(field)
        if tuple_index >= 0 {
            let tuple_layout = wat_tuple_layout_name_from_expr(value)
            if tuple_layout.len == 0 {
                wat_line(out, depth, "unreachable ;; tuple field layout unsupported")
            } else {
                let _ = wat_emit_ref_cast(out, depth, tuple_layout)
                wat_emit_struct_get(out, depth, tuple_layout, tuple_index)
            }
        } else {
            let index = wat_known_struct_field_index(owner, field)
            if owner.len != 0 && index >= 0 {
                let ast_layout = wat_ast_record_field_layout_name(items, owner, field)
                let layout = if ast_layout.len != 0 { ast_layout } else { wat_heap_layout_name(items, owner) }
                let _ = wat_emit_ref_cast_named_layout(out, depth, layout)
                wat_emit_struct_get_named_layout(out, depth, layout, index)
            } else {
                let ast_index = wat_ast_record_field_index(items, owner, field)
                if owner.len != 0 && ast_index >= 0 {
                    let ast_layout = wat_ast_record_field_layout_name(items, owner, field)
                    let layout = if ast_layout.len != 0 { ast_layout } else { wat_heap_layout_name(items, owner) }
                    let _ = wat_emit_ref_cast_named_layout(out, depth, layout)
                    wat_emit_struct_get_named_layout(out, depth, layout, ast_index)
                } else if streq(field, mk_str("len", 3)) != 0 && streq(owner, mk_str("Slice", 5)) != 0 {
                    wat_line(out, depth, "call $Slice.len")
                } else if streq(field, mk_str("len", 3)) != 0 && wat_is_array_like_owner(owner) != 0 {
                    wat_emit_call_name(out, depth, wat_array_like_runtime_name(owner, field, value))
                } else {
                    wat_line(out, depth, "unreachable ;; field unsupported")
                }
            }
        }
    }

def wat_emit_field_access_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, value: CirExpr, field: Str, owner: Str): i64 =
    if streq(field, mk_str("len", 3)) != 0 && wat_expr_is_string_array(value) != 0 {
        let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        wat_line(out, depth, "call $str.len")
    } else {
        let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        let tuple_index = wat_tuple_field_index(field)
        if tuple_index >= 0 {
            let tuple_layout = wat_tuple_layout_name_from_expr(value)
            if tuple_layout.len == 0 {
                wat_line(out, depth, "unreachable ;; tuple field layout unsupported")
            } else {
                let _ = wat_emit_ref_cast(out, depth, tuple_layout)
                wat_emit_struct_get(out, depth, tuple_layout, tuple_index)
            }
        } else {
            let index = wat_known_struct_field_index(owner, field)
            if owner.len != 0 && index >= 0 {
                let ast_layout = wat_ast_record_field_layout_name(items, owner, field)
                let layout = if ast_layout.len != 0 { ast_layout } else { wat_heap_layout_name(items, owner) }
                let _ = wat_emit_ref_cast_named_layout(out, depth, layout)
                wat_emit_struct_get_named_layout(out, depth, layout, index)
            } else {
                let ast_index = wat_ast_record_field_index(items, owner, field)
                if owner.len != 0 && ast_index >= 0 {
                    let ast_layout = wat_ast_record_field_layout_name(items, owner, field)
                    let layout = if ast_layout.len != 0 { ast_layout } else { wat_heap_layout_name(items, owner) }
                    let _ = wat_emit_ref_cast_named_layout(out, depth, layout)
                    wat_emit_struct_get_named_layout(out, depth, layout, ast_index)
                } else if streq(field, mk_str("len", 3)) != 0 && streq(owner, mk_str("Slice", 5)) != 0 {
                    wat_line(out, depth, "call $Slice.len")
                } else if streq(field, mk_str("len", 3)) != 0 && wat_is_array_like_owner(owner) != 0 {
                    wat_emit_call_name(out, depth, wat_array_like_runtime_name_with_body(items, func_name, params, body, owner, field, value))
                } else {
                    wat_line(out, depth, "unreachable ;; field unsupported")
                }
            }
        }
    }

def wat_emit_expr_list(out: Str, depth: i64, items: AST, args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(head, tail) => {
            let _ = wat_emit_expr_in(out, depth, items, head)
            wat_emit_expr_list(out, depth, items, tail)
        }
    }

def wat_expr_list_first_valtype(args: CirExprList): Str =
    match args {
        CirExprCons(head, _) => wat_valtype_from_expr(head)
        _ => mk_str("", 0)
    }

def wat_expr_list_first_layout_valtype(args: CirExprList): Str =
    match args {
        CirExprCons(head, _) => wat_valtype_from_expr_in(Item_End, head)
        _ => mk_str("", 0)
    }

def wat_expr_list_first_value_is_immediate_scalar(args: CirExprList): i64 =
    match args {
        CirExprCons(head, _) => wat_expr_is_definite_integer_scalar(head)
        _ => 0
    }

def wat_expr_list_first_valtype_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, args: CirExprList): Str =
    match args {
        CirExprCons(head, _) => wat_valtype_from_expr_with_body(items, func_name, params, body, head)
        _ => mk_str("", 0)
    }

def wat_expr_list_first_value_is_immediate_scalar_with_body(items: AST, func_name: Str, params: CirParamList, body: CirExpr, args: CirExprList): i64 =
    match args {
        CirExprCons(head, _) => wat_expr_is_definite_integer_scalar_with_body(items, func_name, params, body, head)
        _ => 0
    }

def wat_expr_list_len(args: CirExprList): i64 =
    match args {
        CirExprEnd => 0
        CirExprCons(_, tail) => 1 + wat_expr_list_len(tail)
    }

def wat_emit_string_char_method_call(out: Str, depth: i64, items: AST, value: CirExpr, args: CirExprList): i64 =
    match args {
        CirExprCons(index, CirExprEnd) => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_emit_expr_in(out, depth, items, index)
            wat_line(out, depth, "call $__chiba_string_codepoint_at")
        }
        _ => wat_line(out, depth, "unreachable ;; char_at arity unsupported")
    }

def wat_emit_stmt_list(out: Str, depth: i64, items: AST, stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let _ = wat_emit_stmt(out, depth, items, stmt)
            wat_emit_stmt_list(out, depth, items, rest)
        }
    }

def wat_emit_stmt_list_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 0
        CirStmtCons(stmt, rest) => {
            let _ = wat_emit_stmt_with_body(out, depth, items, func_name, params, body, stmt)
            wat_emit_stmt_list_with_body(out, depth, items, func_name, params, body, rest)
        }
    }

def wat_emit_return_expr(out: Str, depth: i64, items: AST, value: CirExpr): i64 =
    match wat_unwrap_pass_expr(value) {
        L8ValidatedCoreOp(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L7CoreOp(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L6OpClosureEnv(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L5OpContinuationPackage(_, _, inner) => wat_emit_return_expr(out, depth, items, inner)
        L5OpCps(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L4OpUsage(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L3OpAnswerControl(inner, _, _) => wat_emit_return_expr(out, depth, items, inner)
        L2OpTyped(inner, _) => wat_emit_return_expr(out, depth, items, inner)
        L1OpCall(callee, args) => {
            match wat_call_callee_shape(callee) {
                L1OpRef(ref) => {
                    let name = wat_ref_name_text(ref)
                    if wat_is_load8_name(name) != 0 {
                        let _ = wat_emit_load8_call(out, depth, items, args)
                        wat_line(out, depth, "return")
                    } else if wat_emit_ctor_call_if_declared(out, depth, items, ref, args) != 0 {
                        wat_line(out, depth, "return")
                    } else {
                        let _ = wat_emit_expr_list(out, depth, items, args)
                        let _ = wat_indent(out, depth)
                        let _ = str_push_cstr(out, "return_call ")
                        let _ = wat_ref_func_name_with_args_in(out, items, ref, args)
                        str_push(out, 10)
                    }
                }
                _ => {
                    let _ = wat_emit_expr_in(out, depth, items, value)
                    wat_line(out, depth, "return")
                }
            }
        }
        _ => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            wat_line(out, depth, "return")
        }
    }

def wat_emit_stmt(out: Str, depth: i64, items: AST, stmt: CirStmt): i64 =
    match stmt {
        L1StmtLet(binder, value) => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L1StmtExpr(value) => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            wat_line(out, depth, "drop")
        }
        L1StmtReturn(value) => wat_emit_return_expr(out, depth, items, value)
        L1StmtAssign(lhs, rhs) => {
            let _ = wat_emit_expr_in(out, depth, items, L1OpAssign(lhs, rhs))
            wat_line(out, depth, "drop")
        }
        L1StmtFor(_, cond, body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_expr_in(out, depth + 2, items, cond)
            let _ = wat_line(out, depth + 2, "i64.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr_in(out, depth + 2, items, body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        L1StmtLetPattern(pattern, value) => wat_emit_let_pattern_stmt(out, depth, items, pattern, value, value)
        L1StmtUnsupported(_, _) => wat_line(out, depth, "unreachable ;; stmt unsupported")
        L2StmtLet(binder, _, value) => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L2StmtExpr(value) => {
            let _ = wat_emit_expr_in(out, depth, items, value)
            wat_line(out, depth, "drop")
        }
        L2StmtReturn(value) => wat_emit_return_expr(out, depth, items, value)
        L2StmtAssign(lhs, rhs) => {
            let _ = wat_emit_expr_in(out, depth, items, L1OpAssign(lhs, rhs))
            wat_line(out, depth, "drop")
        }
        L2StmtFor(_, cond, body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_expr_in(out, depth + 2, items, cond)
            let _ = wat_line(out, depth + 2, "i64.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr_in(out, depth + 2, items, body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        L2StmtLetPattern(pattern, value) => wat_emit_let_pattern_stmt(out, depth, items, pattern, value, value)
        _ => wat_line(out, depth, "unreachable ;; non-l1 stmt")
    }

def wat_emit_stmt_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, stmt: CirStmt): i64 =
    match stmt {
        L1StmtLet(binder, value) => {
            let local_ty = wat_let_local_decl_valtype_with_body(items, func_name, params, body, value)
            let _ = wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, local_ty)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L1StmtExpr(value) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
            wat_line(out, depth, "drop")
        }
        L1StmtReturn(value) => wat_emit_return_expr(out, depth, items, value)
        L1StmtAssign(lhs, rhs) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpAssign(lhs, rhs))
            wat_line(out, depth, "drop")
        }
        L1StmtLetPattern(pattern, value) => wat_emit_let_pattern_stmt_with_body(out, depth, items, func_name, params, body, pattern, value)
        L1StmtFor(_, cond, loop_body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_truthy_expr_with_body(out, depth + 2, items, func_name, params, body, cond)
            let _ = wat_line(out, depth + 2, "i32.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr_in_with_body(out, depth + 2, items, func_name, params, body, loop_body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        L2StmtLet(binder, ty, value) => {
            let local_ty = wat_typed_let_local_decl_valtype_with_body(items, func_name, params, body, ty, value)
            let _ = wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, local_ty)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.set ")
            let _ = wat_local_name(out, binder.id)
            str_push(out, 10)
        }
        L2StmtExpr(value) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
            wat_line(out, depth, "drop")
        }
        L2StmtReturn(value) => wat_emit_return_expr(out, depth, items, value)
        L2StmtAssign(lhs, rhs) => {
            let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpAssign(lhs, rhs))
            wat_line(out, depth, "drop")
        }
        L2StmtLetPattern(pattern, value) => wat_emit_let_pattern_stmt_with_body(out, depth, items, func_name, params, body, pattern, value)
        L2StmtFor(_, cond, loop_body) => {
            let _ = wat_line(out, depth, "block")
            let _ = wat_line(out, depth + 1, "loop")
            let _ = wat_emit_truthy_expr_with_body(out, depth + 2, items, func_name, params, body, cond)
            let _ = wat_line(out, depth + 2, "i32.eqz")
            let _ = wat_line(out, depth + 2, "br_if 1")
            let _ = wat_emit_expr_in_with_body(out, depth + 2, items, func_name, params, body, loop_body)
            let _ = wat_line(out, depth + 2, "drop")
            let _ = wat_line(out, depth + 2, "br 0")
            let _ = wat_line(out, depth + 1, "end")
            wat_line(out, depth, "end")
        }
        _ => wat_emit_stmt(out, depth, items, stmt)
    }

def wat_emit_assign_expr(out: Str, depth: i64, items: AST, lhs: CirExpr, rhs: CirExpr): i64 =
    match lhs {
        L8ValidatedCoreOp(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L7CoreOp(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L6OpClosureEnv(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L5OpCps(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L4OpUsage(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L3OpAnswerControl(value, _, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L2OpTyped(value, _) => wat_emit_assign_expr(out, depth, items, value, rhs)
        L1OpRef(L1RefLocal(id, _)) => {
            let _ = wat_emit_expr_in(out, depth, items, rhs)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "local.tee ")
            let _ = wat_local_name(out, id)
            str_push(out, 10)
        }
        _ => wat_line(out, depth, "unreachable ;; assign target unsupported")
    }

def wat_emit_expr(out: Str, depth: i64, expr: CirExpr): i64 =
    wat_emit_expr_in(out, depth, Item_End, expr)

def wat_emit_expr_in(out: Str, depth: i64, items: AST, expr: CirExpr): i64 =
    match expr {
        L0OpBlock(stmts, tail) => wat_emit_expr_in(out, depth, items, L1OpBlock(stmts, tail))
        L0OpIf(cond, then_expr, else_expr) => wat_emit_expr_in(out, depth, items, L1OpIf(cond, then_expr, else_expr))
        L0OpMatch(value, arms) => wat_emit_expr_in(out, depth, items, L1OpMatch(value, arms))
        L0OpClosure(_, _) => wat_line(out, depth, "unreachable ;; closure requires closure lowering")
        L0OpReset(label, body) => wat_emit_expr_in(out, depth, items, L1OpReset(label, body))
        L0OpShift(_, _, _) => wat_line(out, depth, "unreachable ;; shift requires cps lowering")
        L0OpCall(callee, args) => wat_emit_expr_in(out, depth, items, L1OpCall(callee, args))
        L0OpNominalCtor(name, fields) => wat_emit_nominal_ctor(out, depth, items, name, fields)
        L0OpField(value, field) => wat_emit_expr_in(out, depth, items, L1OpField(value, field))
        L0OpIndex(value, args) => wat_emit_expr_in(out, depth, items, L1OpIndex(value, args))
        L0OpTypeApply(value, args) => wat_emit_expr_in(out, depth, items, L1OpTypeApply(value, args))
        L0OpAssign(lhs, rhs) => wat_emit_expr_in(out, depth, items, L1OpAssign(lhs, rhs))
        L0OpUnsafe(value) => wat_emit_expr_in(out, depth, items, value)
        L0OpCast(value, ty) => wat_emit_expr_in(out, depth, items, L1OpCast(value, ty))
        L0OpPrefix(op, value) => wat_emit_expr_in(out, depth, items, L1OpPrefix(op, value))
        L0OpBinary(op, lhs, rhs) => wat_emit_expr_in(out, depth, items, L1OpBinary(op, lhs, rhs))
        L0OpName(name) => wat_emit_expr_in(out, depth, items, L1OpRef(L0RefName(name)))
        L0OpInt(n) => wat_line_str(out, depth, "i64.const ", n)
        L0OpFloat(n) => wat_emit_expr_in(out, depth, items, L1OpFloat(n))
        L0OpAtom(atom) => wat_emit_expr_in(out, depth, items, L1OpAtom(atom))
        L0OpBool(v) => wat_emit_expr_in(out, depth, items, L1OpBool(v))
        L0OpString => wat_emit_expr_in(out, depth, items, L1OpString)
        L0OpStringBytes(bytes) => wat_emit_string_array(out, depth, bytes)
        L0OpStringInterp(parts) => wat_emit_string_interp(out, depth, parts)
        L0OpUnit => wat_line(out, depth, "i64.const 0")
        L0OpUnsupported(_, _) => wat_line(out, depth, "unreachable ;; expr unsupported")
        L8ValidatedCoreOp(value, _) => wat_emit_expr_in(out, depth, items, value)
        L7CoreOp(value, _) => wat_emit_expr_in(out, depth, items, value)
        L6OpClosureEnv(value, _) => wat_emit_expr_in(out, depth, items, value)
        L5OpContinuationPackage(_, _, value) => wat_emit_expr_in(out, depth, items, value)
        L5OpCps(value, _) => wat_emit_expr_in(out, depth, items, value)
        L4OpUsage(value, _) => wat_emit_expr_in(out, depth, items, value)
        L3OpAnswerControl(value, _, _) => wat_emit_expr_in(out, depth, items, value)
        L2OpTyped(value, _) => wat_emit_expr_in(out, depth, items, value)
        L1OpBlock(stmts, tail) => {
            let _ = wat_emit_stmt_list(out, depth, items, stmts)
            wat_emit_expr_in(out, depth, items, tail)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let safe_result_ty = wat_branch_result_valtype_in(items, then_expr, else_expr, "i64")
            let _ = wat_emit_truthy_expr(out, depth, items, cond)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "if (result ")
            let _ = str_push_cstr(out, safe_result_ty)
            let _ = str_push_cstr(out, ")")
            let _ = str_push(out, 10)
            let _ = wat_emit_expr_with_result_hint(out, depth + 1, items, then_expr, safe_result_ty)
            let _ = wat_line(out, depth, "else")
            let _ = wat_emit_expr_with_result_hint(out, depth + 1, items, else_expr, safe_result_ty)
            wat_line(out, depth, "end")
        }
        L1OpMatch(value, arms) => wat_emit_match_expr(out, depth, items, value, arms, wat_match_result_type_from_arms(arms))
        L1OpCall(callee, args) => {
            match wat_call_callee_shape(callee) {
                L2OpTyped(L1OpField(value, field), _) => wat_emit_method_call(out, depth, items, value, field, args)
                L1OpField(value, field) => wat_emit_method_call(out, depth, items, value, field, args)
                L2OpTyped(L1OpRef(ref), _) => wat_emit_direct_ref_call(out, depth, items, ref, args)
                L1OpRef(ref) => wat_emit_direct_ref_call(out, depth, items, ref, args)
                L2OpTyped(inner, ty) => wat_emit_typed_indirect_call(out, depth, items, inner, ty, args)
                _ => wat_line(out, depth, "unreachable ;; indirect call unsupported")
            }
        }
        L1OpNominalCtor(name, fields) => wat_emit_nominal_ctor(out, depth, items, name, fields)
        L1OpField(value, field) => {
            let owner0 = wat_effective_method_owner(value)
            let owner1 = wat_field_owner_from_expr(value)
            let owner = if owner0.len != 0 { owner0 } else if owner1.len != 0 { owner1 } else { wat_owner_from_known_field_name(field) }
            wat_emit_field_access(out, depth, items, value, field, owner)
        }
        L1OpIndex(value, args) => {
            match args {
                CirExprCons(index, CirExprEnd) =>
                    if wat_expr_is_string_array(value) != 0 {
                        wat_emit_string_index(out, depth, items, value, index)
                    } else {
                        let owner0 = wat_effective_method_owner(value)
                        let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
                        let value_ty = wat_valtype_from_expr_in(items, value)
                        let call_name = wat_index_call_name(owner, value, value_ty, index)
                        if call_name.len != 0 {
                            wat_emit_index_call(out, depth, items, value, index, call_name)
                        } else {
                            wat_line(out, depth, "unreachable ;; typed index pending")
                        }
                    }
                _ => wat_line(out, depth, "unreachable ;; index arity unsupported")
            }
        }
        L1OpTypeApply(_, _) => 0
        L1OpPrefix(op, value) => {
            if streq(op, mk_str("-", 1)) != 0 {
                let _ = wat_line(out, depth, "i64.const 0")
                let _ = wat_emit_expr_in(out, depth, items, value)
                wat_line(out, depth, "i64.sub")
            } else {
                let _ = wat_emit_truthy_expr(out, depth, items, value)
                let _ = wat_line(out, depth, "i32.eqz")
                wat_emit_bool_i64_from_i32(out, depth)
            }
        }
        L1OpBinary(op, lhs, rhs) => {
            if streq(op, mk_str("&&", 2)) != 0 {
                let _ = wat_emit_truthy_expr(out, depth, items, lhs)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "if (result i64)\n")
                let _ = wat_emit_truthy_expr(out, depth + 1, items, rhs)
                let _ = wat_emit_bool_i64_from_i32(out, depth + 1)
                let _ = wat_line(out, depth, "else")
                let _ = wat_line(out, depth + 1, "i64.const 0")
                wat_line(out, depth, "end")
            } else if streq(op, mk_str("||", 2)) != 0 {
                let _ = wat_emit_truthy_expr(out, depth, items, lhs)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "if (result i64)\n")
                let _ = wat_line(out, depth + 1, "i64.const 1")
                let _ = wat_line(out, depth, "else")
                let _ = wat_emit_truthy_expr(out, depth + 1, items, rhs)
                let _ = wat_emit_bool_i64_from_i32(out, depth + 1)
                wat_line(out, depth, "end")
            } else if wat_binary_is_string_equality_in(items, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in(out, depth, items, lhs)
                let _ = wat_emit_expr_in(out, depth, items, rhs)
                let _ = wat_line(out, depth, "call $streq")
                if streq(op, mk_str("!=", 2)) != 0 {
                    let _ = wat_line(out, depth, "i64.eqz")
                    wat_line(out, depth, "i64.extend_i32_u")
                } else { 0 }
            } else if wat_binary_is_string_order_in(items, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in(out, depth, items, lhs)
                let _ = wat_emit_expr_in(out, depth, items, rhs)
                let _ = wat_line(out, depth, "call $strcmp")
                wat_emit_string_order_from_cmp(out, depth, op)
            } else if wat_binary_is_ref_equality_in(items, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in(out, depth, items, lhs)
                let _ = wat_emit_expr_in(out, depth, items, rhs)
                let _ = wat_line(out, depth, "ref.eq")
                let _ = if streq(op, mk_str("!=", 2)) != 0 { wat_line(out, depth, "i32.eqz") } else { 0 }
                wat_line(out, depth, "i64.extend_i32_u")
            } else {
                let _ = wat_emit_expr_in(out, depth, items, lhs)
                let _ = wat_emit_expr_in(out, depth, items, rhs)
                let _ = wat_line(out, depth, wat_binary_instr(op))
                if wat_binary_is_compare(op) != 0 { wat_line(out, depth, "i64.extend_i32_u") } else { 0 }
            }
        }
        L1OpAssign(lhs, rhs) => {
            wat_emit_assign_expr(out, depth, items, lhs, rhs)
        }
        L1OpUnsafe(value) => wat_emit_expr_in(out, depth, items, value)
        L1OpCast(value, ty) => {
            if wat_ast_type_is_eqref_storage(ty) != 0 && wat_expr_is_zero_int(value) != 0 {
                wat_line(out, depth, "ref.null none")
            } else {
                let _ = wat_emit_expr_in(out, depth, items, value)
                match ty {
                    Type_Path(name, _) =>
                        if streq(name, mk_str("Str", 3)) != 0 || streq(name, mk_str("str", 3)) != 0 || streq(name, mk_str("String", 6)) != 0 {
                            wat_line(out, depth, "ref.cast (ref $array_u8)")
                        } else { 0 }
                    _ => 0
                }
            }
        }
        L1OpRef(L1RefLocal(id, local_name)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L1RefUnresolved(mk_str("", 0), local_name), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "local.get ")
                let _ = wat_local_name(out, id)
                str_push(out, 10)
            }
        }
        L1OpRef(L1RefGlobal(namespace_name, name, _)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L1RefGlobal(namespace_name, name, 0), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "call ")
                let _ = wat_func_name(out, name)
                str_push(out, 10)
            }
        }
        L1OpRef(L1RefUnresolved(namespace_name, name)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L1RefUnresolved(namespace_name, name), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "call ")
                let _ = wat_func_name(out, name)
                str_push(out, 10)
            }
        }
        L1OpRef(L0RefName(name)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L0RefName(name), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "call ")
                let _ = wat_func_name(out, name)
                str_push(out, 10)
            }
        }
        L1OpInt(n) => wat_line_str(out, depth, "i64.const ", n)
        L1OpBool(v) => {
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "i64.const ")
            let _ = str_append_i64(out, v)
            str_push(out, 10)
        }
        L1OpString => wat_line(out, depth, "unreachable ;; legacy payloadless string unsupported")
        L1OpStringBytes(bytes) => wat_emit_string_array(out, depth, bytes)
        L1OpStringInterp(parts) => wat_emit_string_interp(out, depth, parts)
        L1OpUnit => wat_line(out, depth, "i64.const 0")
        L1OpReset(_, body) => wat_emit_expr_in(out, depth, items, body)
        L1OpShift(_, _, _) => wat_line(out, depth, "unreachable ;; shift requires cps lowering")
        L1OpUnsupported(_, _) => wat_line(out, depth, "unreachable ;; expr unsupported")
        _ => wat_line(out, depth, "unreachable ;; wat expr unsupported")
    }

def wat_emit_expr_in_with_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr): i64 =
    match expr {
        L0OpBlock(stmts, tail) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpBlock(stmts, tail))
        L0OpIf(cond, then_expr, else_expr) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpIf(cond, then_expr, else_expr))
        L0OpMatch(value, arms) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpMatch(value, arms))
        L0OpClosure(_, _) => wat_line(out, depth, "unreachable ;; closure requires closure lowering")
        L0OpReset(label, reset_body) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpReset(label, reset_body))
        L0OpShift(_, _, _) => wat_line(out, depth, "unreachable ;; shift requires cps lowering")
        L0OpCall(callee, args) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpCall(callee, args))
        L0OpNominalCtor(name, fields) => wat_emit_nominal_ctor_with_body(out, depth, items, func_name, params, body, name, fields)
        L0OpField(value, field) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpField(value, field))
        L0OpIndex(value, args) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpIndex(value, args))
        L0OpTypeApply(value, args) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpTypeApply(value, args))
        L0OpAssign(lhs, rhs) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpAssign(lhs, rhs))
        L0OpUnsafe(value) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L0OpCast(value, ty) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpCast(value, ty))
        L0OpPrefix(op, value) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpPrefix(op, value))
        L0OpBinary(op, lhs, rhs) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpBinary(op, lhs, rhs))
        L0OpName(name) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpRef(L0RefName(name)))
        L0OpInt(n) => wat_line_str(out, depth, "i64.const ", n)
        L0OpFloat(n) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpFloat(n))
        L0OpAtom(atom) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpAtom(atom))
        L0OpBool(v) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpBool(v))
        L0OpString => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, L1OpString)
        L0OpStringBytes(bytes) => wat_emit_string_array(out, depth, bytes)
        L0OpStringInterp(parts) => wat_emit_string_interp(out, depth, parts)
        L0OpUnit => wat_line(out, depth, "i64.const 0")
        L0OpUnsupported(_, _) => wat_line(out, depth, "unreachable ;; expr unsupported")
        L8ValidatedCoreOp(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L7CoreOp(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L6OpClosureEnv(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L5OpContinuationPackage(_, _, value) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L5OpCps(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L4OpUsage(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L3OpAnswerControl(value, _, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L2OpTyped(value, _) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L1OpUnsafe(value) => wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
        L1OpBlock(stmts, tail) => {
            let block_ctx = L1OpBlock(stmts, tail)
            let _ = wat_emit_stmt_list_with_body(out, depth, items, func_name, params, block_ctx, stmts)
            wat_emit_expr_in_with_body(out, depth, items, func_name, params, block_ctx, tail)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let fallback_ty = wat_nonempty_valtype(wat_merge_valtype(wat_valtype_from_expr_with_body(items, func_name, params, body, then_expr), wat_valtype_from_expr_with_body(items, func_name, params, body, else_expr)), "i64")
            let safe_result_ty = wat_branch_result_valtype_with_body(items, func_name, params, body, then_expr, else_expr, fallback_ty)
            let _ = wat_emit_truthy_expr_with_body(out, depth, items, func_name, params, body, cond)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "if (result ")
            let _ = str_push_cstr(out, safe_result_ty)
            let _ = str_push_cstr(out, ")")
            let _ = str_push(out, 10)
            let _ = wat_emit_expr_with_result_hint_body(out, depth + 1, items, func_name, params, body, then_expr, safe_result_ty)
            let _ = wat_line(out, depth, "else")
            let _ = wat_emit_expr_with_result_hint_body(out, depth + 1, items, func_name, params, body, else_expr, safe_result_ty)
            wat_line(out, depth, "end")
        }
        L1OpMatch(value, arms) => wat_emit_match_expr_with_body(out, depth, items, func_name, params, body, value, arms, wat_match_result_type_from_arms_with_body(items, func_name, params, body, arms))
        L1OpPrefix(op, value) => {
            if streq(op, mk_str("-", 1)) != 0 {
                let _ = wat_line(out, depth, "i64.const 0")
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, value)
                wat_line(out, depth, "i64.sub")
            } else {
                let _ = wat_emit_truthy_expr_with_body(out, depth, items, func_name, params, body, value)
                let _ = wat_line(out, depth, "i32.eqz")
                wat_emit_bool_i64_from_i32(out, depth)
            }
        }
        L1OpBinary(op, lhs, rhs) => {
            if streq(op, mk_str("&&", 2)) != 0 {
                let _ = wat_emit_truthy_expr_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "if (result i64)\n")
                let _ = wat_emit_truthy_expr_with_body(out, depth + 1, items, func_name, params, body, rhs)
                let _ = wat_emit_bool_i64_from_i32(out, depth + 1)
                let _ = wat_line(out, depth, "else")
                let _ = wat_line(out, depth + 1, "i64.const 0")
                wat_line(out, depth, "end")
            } else if streq(op, mk_str("||", 2)) != 0 {
                let _ = wat_emit_truthy_expr_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "if (result i64)\n")
                let _ = wat_line(out, depth + 1, "i64.const 1")
                let _ = wat_line(out, depth, "else")
                let _ = wat_emit_truthy_expr_with_body(out, depth + 1, items, func_name, params, body, rhs)
                let _ = wat_emit_bool_i64_from_i32(out, depth + 1)
                wat_line(out, depth, "end")
            } else if wat_binary_is_string_equality_with_body(items, func_name, params, body, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, rhs)
                let _ = wat_line(out, depth, "call $streq")
                if streq(op, mk_str("!=", 2)) != 0 {
                    let _ = wat_line(out, depth, "i64.eqz")
                    wat_line(out, depth, "i64.extend_i32_u")
                } else { 0 }
            } else if wat_binary_is_string_order_with_body(items, func_name, params, body, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, rhs)
                let _ = wat_line(out, depth, "call $strcmp")
                wat_emit_string_order_from_cmp(out, depth, op)
            } else if wat_binary_is_ref_equality_with_body(items, func_name, params, body, op, lhs, rhs) != 0 {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, rhs)
                let _ = wat_line(out, depth, "ref.eq")
                let _ = if streq(op, mk_str("!=", 2)) != 0 { wat_line(out, depth, "i32.eqz") } else { 0 }
                wat_line(out, depth, "i64.extend_i32_u")
            } else {
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, lhs)
                let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, rhs)
                let _ = wat_line(out, depth, wat_binary_instr(op))
                if wat_binary_is_compare(op) != 0 { wat_line(out, depth, "i64.extend_i32_u") } else { 0 }
            }
        }
        L1OpNominalCtor(name, fields) => wat_emit_nominal_ctor_with_body(out, depth, items, func_name, params, body, name, fields)
        L1OpCall(callee, args) => {
            match wat_call_callee_shape(callee) {
                L2OpTyped(L1OpField(value, field), _) => wat_emit_method_call_with_body(out, depth, items, func_name, params, body, value, field, args)
                L1OpField(value, field) => wat_emit_method_call_with_body(out, depth, items, func_name, params, body, value, field, args)
                L2OpTyped(L1OpRef(ref), _) => wat_emit_direct_ref_call_with_body(out, depth, items, func_name, params, body, ref, args)
                L1OpRef(ref) => wat_emit_direct_ref_call_with_body(out, depth, items, func_name, params, body, ref, args)
                L2OpTyped(inner, ty) => wat_emit_typed_indirect_call_with_body(out, depth, items, func_name, params, body, inner, ty, args)
                _ => wat_line(out, depth, "unreachable ;; indirect call unsupported")
            }
        }
        L1OpRef(L1RefLocal(id, local_name)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L1RefUnresolved(mk_str("", 0), local_name), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "local.get ")
                let _ = wat_local_name(out, id)
                str_push(out, 10)
            }
        }
        L1OpRef(L0RefName(name)) => {
            if wat_emit_zero_ctor_if_declared(out, depth, items, L0RefName(name), CirExprEnd) != 0 { 0 }
            else {
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "call ")
                let _ = wat_func_name(out, name)
                str_push(out, 10)
            }
        }
        L1OpField(value, field) => {
            let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
            let owner1 = wat_field_owner_from_expr(value)
            let owner = if owner0.len != 0 { owner0 } else if owner1.len != 0 { owner1 } else { wat_owner_from_known_field_name(field) }
            wat_emit_field_access_with_body(out, depth, items, func_name, params, body, value, field, owner)
        }
        L1OpIndex(value, args) => {
            match args {
                CirExprCons(index, CirExprEnd) =>
                    if wat_expr_is_string_array(value) != 0 {
                        wat_emit_string_index_with_body(out, depth, items, func_name, params, body, value, index)
                    } else {
                        let owner0 = wat_effective_method_owner_with_body(items, func_name, params, body, value)
                        let owner = if owner0.len != 0 { owner0 } else { wat_field_owner_from_expr(value) }
                        let value_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, value)
                        let call_name = wat_index_call_name_with_body(items, func_name, params, body, owner, value, value_ty, index)
                        if call_name.len != 0 {
                            wat_emit_index_call_with_body(out, depth, items, func_name, params, body, value, index, call_name)
                        } else {
                            wat_line(out, depth, "unreachable ;; typed index pending")
                        }
                    }
                _ => wat_line(out, depth, "unreachable ;; index arity unsupported")
            }
        }
        _ => wat_emit_expr_in(out, depth, items, expr)
    }

def wat_emit_expr_with_result_hint(out: Str, depth: i64, items: AST, expr: CirExpr, result_ty: i64): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L7CoreOp(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L6OpClosureEnv(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L5OpContinuationPackage(_, _, value) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L5OpCps(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L4OpUsage(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L3OpAnswerControl(value, _, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L2OpTyped(value, _) => wat_emit_expr_with_result_hint(out, depth, items, value, result_ty)
        L1OpBlock(stmts, tail) => {
            let _ = wat_emit_stmt_list(out, depth, items, stmts)
            wat_emit_expr_with_result_hint(out, depth, items, tail, result_ty)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let safe_result_ty = wat_nonempty_valtype(result_ty, "i64")
            let _ = wat_emit_truthy_expr(out, depth, items, cond)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "if (result ")
            let _ = str_push_cstr(out, safe_result_ty)
            let _ = str_push_cstr(out, ")")
            let _ = str_push(out, 10)
            let _ = wat_emit_expr_with_result_hint(out, depth + 1, items, then_expr, safe_result_ty)
            let _ = wat_line(out, depth, "else")
            let _ = wat_emit_expr_with_result_hint(out, depth + 1, items, else_expr, safe_result_ty)
            wat_line(out, depth, "end")
        }
        L1OpMatch(value, arms) => wat_emit_match_expr(out, depth, items, value, arms, result_ty)
        L1OpCall(L1OpRef(ref), args) => {
            let name = wat_ref_call_name(ref)
            if streq(name, mk_str("Some", 4)) != 0 && wat_text_nonempty(wat_layout_field_valtype(result_ty, 0)) != 0 {
                let _ = wat_emit_expr_list_for_layout_with_body(out, depth, items, mk_str("", 0), CirParamEnd, L1OpUnit, result_ty, args, 0)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "struct.new $")
                let _ = str_push_cstr(out, result_ty)
                str_push(out, 10)
            } else {
                let expr_ty = wat_valtype_from_expr_in(items, expr)
                let _ = wat_emit_expr_in(out, depth, items, expr)
                wat_emit_expr_result_hint_cast_for_expr(out, depth, expr, expr_ty, result_ty)
            }
        }
        _ => {
            let expr_ty = wat_valtype_from_expr_in(items, expr)
            if wat_valtype_is_slice_u8(result_ty) != 0 && wat_valtype_is_array_u8(expr_ty) != 0 {
                wat_emit_array_u8_full_slice(out, depth, items, expr)
            } else {
                let _ = wat_emit_expr_in(out, depth, items, expr)
                wat_emit_expr_result_hint_cast_for_expr(out, depth, expr, expr_ty, result_ty)
            }
        }
    }

def wat_emit_some_with_result_hint_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr, result_ty: i64): i64 =
    match wat_unwrap_pass_expr(expr) {
        L1OpCall(callee, args) => {
            let name = wat_call_name_from_expr(callee)
            if streq(name, mk_str("Some", 4)) != 0 && wat_text_nonempty(wat_layout_field_valtype(result_ty, 0)) != 0 {
                let _ = wat_emit_expr_list_for_layout_with_body(out, depth, items, func_name, params, body, result_ty, args, 0)
                let _ = wat_indent(out, depth)
                let _ = str_push_cstr(out, "struct.new $")
                let _ = str_append(out, result_ty)
                let _ = str_push(out, 10)
                1
            } else { 0 }
        }
        _ => 0
    }

def wat_emit_expr_with_result_hint_body(out: Str, depth: i64, items: AST, func_name: Str, params: CirParamList, body: CirExpr, expr: CirExpr, result_ty: i64): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L7CoreOp(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L6OpClosureEnv(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L5OpContinuationPackage(_, _, value) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L5OpCps(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L4OpUsage(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L3OpAnswerControl(value, _, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L2OpTyped(value, _) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L1OpUnsafe(value) => wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, body, value, result_ty)
        L1OpBlock(stmts, tail) => {
            let block_ctx = L1OpBlock(stmts, tail)
            let _ = wat_emit_stmt_list_with_body(out, depth, items, func_name, params, block_ctx, stmts)
            wat_emit_expr_with_result_hint_body(out, depth, items, func_name, params, block_ctx, tail, result_ty)
        }
        L1OpIf(cond, then_expr, else_expr) => {
            let branch_ty = wat_branch_result_valtype_with_body(items, func_name, params, body, then_expr, else_expr, "i64")
            let safe_result_ty = wat_nonempty_valtype(result_ty, branch_ty)
            let _ = wat_emit_truthy_expr_with_body(out, depth, items, func_name, params, body, cond)
            let _ = wat_indent(out, depth)
            let _ = str_push_cstr(out, "if (result ")
            let _ = str_push_cstr(out, safe_result_ty)
            let _ = str_push_cstr(out, ")")
            let _ = str_push(out, 10)
            let _ = wat_emit_expr_with_result_hint_body(out, depth + 1, items, func_name, params, body, then_expr, safe_result_ty)
            let _ = wat_line(out, depth, "else")
            let _ = wat_emit_expr_with_result_hint_body(out, depth + 1, items, func_name, params, body, else_expr, safe_result_ty)
            wat_line(out, depth, "end")
        }
        L1OpMatch(value, arms) => wat_emit_match_expr_with_body(out, depth, items, func_name, params, body, value, arms, result_ty)
        L1OpCall(_, _) => {
            if wat_emit_some_with_result_hint_body(out, depth, items, func_name, params, body, expr, result_ty) != 0 { 0 }
            else {
                let expr_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, expr)
                if wat_valtype_is_slice_u8(result_ty) != 0 && wat_valtype_is_array_u8(expr_ty) != 0 {
                    wat_emit_array_u8_full_slice_with_body(out, depth, items, func_name, params, body, expr)
                } else {
                    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, expr)
                    wat_emit_expr_result_hint_cast_for_expr(out, depth, expr, expr_ty, result_ty)
                }
            }
        }
        _ => {
            if wat_emit_some_with_result_hint_body(out, depth, items, func_name, params, body, expr, result_ty) != 0 { 0 }
            else {
                let expr_ty = wat_valtype_from_expr_with_body(items, func_name, params, body, expr)
                if wat_valtype_is_slice_u8(result_ty) != 0 && wat_valtype_is_array_u8(expr_ty) != 0 {
                    wat_emit_array_u8_full_slice_with_body(out, depth, items, func_name, params, body, expr)
                } else {
                    let _ = wat_emit_expr_in_with_body(out, depth, items, func_name, params, body, expr)
                    wat_emit_expr_result_hint_cast_for_expr(out, depth, expr, expr_ty, result_ty)
                }
            }
        }
    }

def wat_emit_func(out: Str, items: AST, item: CirItem, export_main: i64): i64 =
    match item {
	        L1ItemDef(binder, params, ret, body) => {
	            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
	            else if wat_func_is_pure_ctor_wrapper(items, binder.name, params, body) != 0 { 0 }
	            else {
	                let effective_name = wat_effective_defined_func_name_for_body(items, binder.name, params, body)
	                let func_result_ty = wat_nonempty_valtype(wat_result_valtype(items, ret, body), "i64")
	                let _ = str_push_cstr(out, "  (func ")
	                let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
	                let _ = wat_emit_params_for_func(out, items, effective_name, params, 0)
	                let _ = str_push_cstr(out, " (result ")
	                let _ = str_push_cstr(out, func_result_ty)
	                let _ = str_push(out, 41)
	                let _ = str_push(out, 10)
	                let _ = wat_collect_expr_locals_with_body(out, items, effective_name, params, body, body)
	                let _ = wat_emit_expr_with_result_hint_body(out, 2, items, effective_name, params, body, body, func_result_ty)
                let _ = str_push_cstr(out, "  )")
                let _ = str_push(out, 10)
                let _ = if wat_params_empty(params) != 0 && streq(binder.name, mk_str("main", 4)) == 0 {
                    let _ = str_push_cstr(out, "  (export \"")
                    let _ = str_append(out, binder.name)
                    let _ = str_push_cstr(out, "\" (func ")
                    let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
                    let _ = str_push_cstr(out, "))")
                    str_push(out, 10)
                } else { 0 }
                if export_main != 0 {
                    let _ = str_push_cstr(out, "  (export \"main\" (func ")
                    let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
                    let _ = str_push_cstr(out, "))")
                    str_push(out, 10)
                } else { 0 }
            }
        }
	        L8ValidatedCoreItemDef(binder, params, ret, body) => {
	            if wat_builtin_runtime_defined(binder.name) != 0 { 0 }
	            else if wat_func_is_pure_ctor_wrapper(items, binder.name, params, body) != 0 { 0 }
	            else {
	                let effective_name = wat_effective_defined_func_name_for_body(items, binder.name, params, body)
	                let func_result_ty = wat_nonempty_valtype(wat_result_valtype(items, ret, body), "i64")
	                let _ = str_push_cstr(out, "  (func ")
	                let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
	                let _ = wat_emit_params_for_func(out, items, effective_name, params, 0)
	                let _ = str_push_cstr(out, " (result ")
	                let _ = str_push_cstr(out, func_result_ty)
	                let _ = str_push(out, 41)
	                let _ = str_push(out, 10)
	                let _ = wat_collect_expr_locals_with_body(out, items, effective_name, params, body, body)
	                let _ = wat_emit_expr_with_result_hint_body(out, 2, items, effective_name, params, body, body, func_result_ty)
                let _ = str_push_cstr(out, "  )")
                let _ = str_push(out, 10)
                let _ = if wat_params_empty(params) != 0 && streq(binder.name, mk_str("main", 4)) == 0 {
                    let _ = str_push_cstr(out, "  (export \"")
                    let _ = str_append(out, binder.name)
                    let _ = str_push_cstr(out, "\" (func ")
                    let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
                    let _ = str_push_cstr(out, "))")
                    str_push(out, 10)
                } else { 0 }
                if export_main != 0 {
                    let _ = str_push_cstr(out, "  (export \"main\" (func ")
                    let _ = wat_emit_defined_func_name_for_body(out, items, binder.name, params, body)
                    let _ = str_push_cstr(out, "))")
                    str_push(out, 10)
                } else { 0 }
            }
        }
        _ => 0
    }

def wat_emit_items(out: Str, ast_items: AST, items: CirItemList, exported: i64): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(item, rest) => {
            let export_now = match item {
                L1ItemDef(binder, _, _, _) => if exported == 0 { streq(binder.name, mk_str("main", 4)) } else { 0 }
                L8ValidatedCoreItemDef(binder, _, _, _) => if exported == 0 { streq(binder.name, mk_str("main", 4)) } else { 0 }
                _ => 0
            }
            let _ = wat_emit_func(out, ast_items, item, export_now)
            wat_emit_items(out, ast_items, rest, if export_now != 0 { 1 } else { exported })
        }
    }

def wat_validation_ok(result: CirCoreValidation): i64 =
    match result {
        L8ValidatedCoreOk => 1
        L8ValidatedCoreErr(_) => 0
    }

def wat_expr_validated(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, result) =>
            if wat_validation_ok(result) == 0 { 0 } else { wat_expr_validated(value) }
        L7CoreOp(value, _) => wat_expr_validated(value)
        L6OpClosureEnv(value, _) => wat_expr_validated(value)
        L5OpContinuationPackage(_, _, value) => wat_expr_validated(value)
        L5OpCps(value, _) => wat_expr_validated(value)
        L4OpUsage(value, _) => wat_expr_validated(value)
        L3OpAnswerControl(value, _, _) => wat_expr_validated(value)
        L2OpTyped(value, _) => wat_expr_validated(value)
        L1OpBlock(stmts, tail) =>
            if wat_stmt_list_validated(stmts) == 0 { 0 } else { wat_expr_validated(tail) }
        L1OpIf(cond, then_expr, else_expr) =>
            if wat_expr_validated(cond) == 0 { 0 }
            else if wat_expr_validated(then_expr) == 0 { 0 }
            else { wat_expr_validated(else_expr) }
        L1OpCall(callee, args) =>
            if wat_expr_validated(callee) == 0 { 0 } else { wat_expr_list_validated(args) }
        L1OpMatch(value, arms) =>
            if wat_expr_validated(value) == 0 { 0 } else { wat_match_arms_validated(arms) }
        L1OpNominalCtor(_, fields) => wat_record_field_exprs_validated(fields)
        L1OpField(value, _) => wat_expr_validated(value)
        L1OpIndex(value, args) =>
            if wat_expr_validated(value) == 0 { 0 } else { wat_expr_list_validated(args) }
        L1OpTypeApply(_, _) => 1
        L1OpAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1OpUnsafe(value) => wat_expr_validated(value)
        L1OpCast(value, _) => wat_expr_validated(value)
        L1OpPrefix(_, value) => wat_expr_validated(value)
        L1OpBinary(_, lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1OpReset(_, body) => wat_expr_validated(body)
        L1OpShift(_, _, body) => wat_expr_validated(body)
        L1OpStringBytes(_) => 1
        L1OpStringInterp(_) => 1
        L1OpBool(_) => 1
        L1OpUnit => 1
        L1OpInt(_) => 1
        L1OpFloat(_) => 1
        L1OpAtom(_) => 1
        _ => 1
    }

def wat_expr_list_validated(args: CirExprList): i64 =
    match args {
        CirExprEnd => 1
        CirExprCons(head, tail) =>
            if wat_expr_validated(head) == 0 { 0 } else { wat_expr_list_validated(tail) }
    }

def wat_record_field_exprs_validated(fields: CirRecordFieldExprList): i64 =
    match fields {
        CirRecordFieldExprEnd => 1
        CirRecordFieldExprCons(head, tail) =>
            if wat_expr_validated(head.value) == 0 { 0 } else { wat_record_field_exprs_validated(tail) }
    }

def wat_match_arms_validated(arms: CirMatchArmList): i64 =
    match arms {
        CirMatchArmEnd => 1
        CirMatchArmCons(arm, rest) =>
            match arm {
                L1MatchArm(_, guard, body) =>
                    match guard {
                        MatchGuard_None =>
                            if wat_expr_validated(body) == 0 { 0 } else { wat_match_arms_validated(rest) }
                        MatchGuard_Some(value) =>
                            if wat_expr_validated(value) == 0 { 0 }
                            else if wat_expr_validated(body) == 0 { 0 }
                            else { wat_match_arms_validated(rest) }
                    }
                _ => 0
            }
    }

def wat_stmt_validated(stmt: CirStmt): i64 =
    match stmt {
        L2StmtLet(_, _, value) => wat_expr_validated(value)
        L2StmtLetPattern(_, value) => wat_expr_validated(value)
        L2StmtAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L2StmtExpr(value) => wat_expr_validated(value)
        L2StmtReturn(value) => wat_expr_validated(value)
        L2StmtFor(_, cond, body) =>
            if wat_expr_validated(cond) == 0 { 0 } else { wat_expr_validated(body) }
        L1StmtLet(_, value) => wat_expr_validated(value)
        L1StmtLetPattern(_, value) => wat_expr_validated(value)
        L1StmtAssign(lhs, rhs) =>
            if wat_expr_validated(lhs) == 0 { 0 } else { wat_expr_validated(rhs) }
        L1StmtExpr(value) => wat_expr_validated(value)
        L1StmtReturn(value) => wat_expr_validated(value)
        L1StmtFor(_, cond, body) =>
            if wat_expr_validated(cond) == 0 { 0 } else { wat_expr_validated(body) }
        _ => 1
    }

def wat_stmt_list_validated(stmts: CirStmtList): i64 =
    match stmts {
        CirStmtEnd => 1
        CirStmtCons(stmt, rest) =>
            if wat_stmt_validated(stmt) == 0 { 0 } else { wat_stmt_list_validated(rest) }
    }

def wat_items_validated(items: CirItemList): i64 =
    match items {
        CirItemEnd => 1
        CirItemCons(item, rest) => {
            let item_ok = match item {
                L8ValidatedCoreItemDef(_, _, _, body) => wat_expr_validated(body)
                L8ValidatedCoreItemExtern(_, _, _, _) => 1
                _ => 0
            }
            if item_ok == 0 { 0 } else { wat_items_validated(rest) }
        }
    }

def wat_module_validated(module: CirModule): i64 =
    match module {
        L8ValidatedCoreModule(_, _) => 1
        _ => 0
    }

def wat_emit_module(module: CirModule): Str = {
    let out = str_new()
    let ast_items = match module {
        L1Module(source, _) => wat_source_items(source)
        L8ValidatedCoreModule(source, _) => wat_source_items(source)
        _ => Item_End
    }
    let _ = str_push_cstr(out, "(module\n")
    let _ = str_push_cstr(out, "  (rec\n")
    let _ = str_push_cstr(out, "  (type $tuple2_i64_i64 (struct (field i64) (field i64)))\n")
    let _ = str_push_cstr(out, "  (type $tuple2_i64_ref (struct (field i64) (field eqref)))\n")
    let _ = str_push_cstr(out, "  (type $tuple2_ref_ref (struct (field eqref) (field eqref)))\n")
    let _ = str_push_cstr(out, "  (type $tuple3_i64_i64_i64 (struct (field i64) (field i64) (field i64)))\n")
    let _ = str_push_cstr(out, "  (type $tuple2_ref_i64 (struct (field eqref) (field i64)))\n")
    let _ = str_push_cstr(out, "  (type $chiba.closure.i32_to_i32 (func (param i32) (result i32)))\n")
    let _ = str_push_cstr(out, "  (type $chiba.fn0_i64 (func (result i64)))\n")
