namespace backend.wasm.wat
use metalstd.file.*
use metalstd.mem.*
use metalstd.str.*
use parser.chiba_level1.*
use backend.cir.ir.*

def wat_debug_emit_name(name: Str): i64 = {
    let _ = write_fd(2, "[wat emit] ", 11)
    let _ = str_write_to(name, 2)
    write_fd(2, "\n", 1)
}

def wat_debug_mark(text: i64): i64 = {
    let _ = write_fd(2, "[wat] ", 6)
    let _ = write_fd(2, text, strlen(text))
    write_fd(2, "\n", 1)
}

def wat_indent_loop(out: Str, i: i64, depth: i64): i64 =
    if i >= depth { 0 }
    else {
        let _ = str_push_cstr(out, "  ")
        wat_indent_loop(out, i + 1, depth)
    }

def wat_indent(out: Str, depth: i64): i64 =
    wat_indent_loop(out, 0, depth)

def wat_line(out: Str, depth: i64, text: i64): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, text)
    str_push(out, 10)
}

def wat_line_str(out: Str, depth: i64, prefix: i64, value: Str): i64 = {
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, prefix)
    let _ = str_append(out, value)
    str_push(out, 10)
}

def wat_emit_string_byte_consts(out: Str, depth: i64, bytes: Str, i: i64): i64 =
    if i >= bytes.len { 0 }
    else {
        let _ = wat_indent(out, depth)
        let _ = str_push_cstr(out, "i32.const ")
        let _ = str_append_i64(out, load8(bytes.ptr, i))
        let _ = str_push(out, 10)
        wat_emit_string_byte_consts(out, depth, bytes, i + 1)
    }

def wat_emit_string_array(out: Str, depth: i64, bytes: Str): i64 = {
    let _ = wat_emit_string_byte_consts(out, depth, bytes, 0)
    let _ = wat_indent(out, depth)
    let _ = str_push_cstr(out, "array.new_fixed $array_u8 ")
    let _ = str_append_i64(out, bytes.len)
    str_push(out, 10)
}

def wat_emit_string_interp_expr(out: Str, depth: i64, value: CirExpr): i64 = {
    let _ = wat_emit_expr(out, depth, value)
    0
}

def wat_emit_string_interp(out: Str, depth: i64, parts: CirStringPartList): i64 =
    match parts {
        CirStringPartEnd => wat_emit_string_array(out, depth, mk_str("", 0))
        CirStringPartChunk(chunk, CirStringPartEnd) => wat_emit_string_array(out, depth, chunk)
        CirStringPartExpr(value, CirStringPartEnd) => wat_emit_string_interp_expr(out, depth, value)
        CirStringPartChunk(chunk, rest) => {
            let _ = wat_emit_string_array(out, depth, chunk)
            let _ = wat_emit_string_interp(out, depth, rest)
            wat_line(out, depth, "call $__chiba_string_concat2")
        }
        CirStringPartExpr(value, rest) => {
            let _ = wat_emit_string_interp_expr(out, depth, value)
            let _ = wat_emit_string_interp(out, depth, rest)
            wat_line(out, depth, "call $__chiba_string_concat2")
        }
    }

def wat_local_name(out: Str, id: i64): i64 = {
    let _ = str_push_cstr(out, "$v")
    str_append_i64(out, id)
}

def wat_func_name(out: Str, name: Str): i64 = {
    let _ = str_push(out, 36)
    str_append(out, name)
}

def wat_text_nonempty(text: Str): i64 =
    if streq(text, mk_str("", 0)) != 0 { 0 }
    else { 1 }

def wat_source_items(ast: AST): AST =
    match ast {
        SourceFile(_, _, items) => items
        _ => Item_End
    }

def wat_is_gc_builtin_ref_name(name: Str): i64 =
    if streq(name, mk_str("Array", 5)) != 0 { 1 }
    else if streq(name, mk_str("Vec", 3)) != 0 { 1 }
    else if streq(name, mk_str("Option", 6)) != 0 { 1 }
    else if streq(name, mk_str("DiagnosticBuilder", 17)) != 0 { 1 }
    else { 0 }

def wat_ast_variant_declares_name(variant: AST, name: Str): i64 =
    match variant {
        AdtVariant(variant_name, _) => streq(variant_name, name)
        _ => 0
    }

def wat_ast_variants_declare_name(variants: AST, name: Str): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            if wat_ast_variant_declares_name(head, name) != 0 { 1 }
            else { wat_ast_variants_declare_name(tail, name) }
        _ => 0
    }

def wat_ast_item_declares_heap_ref_name(item: AST, name: Str): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_declares_heap_ref_name(inner, name)
        Item_Type(ty) =>
            match ty {
                TypeItem(type_name, _, _) => streq(type_name, name)
                TypeDecl(type_name, _, TypeDecl_Record(_)) => streq(type_name, name)
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(type_name, _, _) => streq(type_name, name)
                AdtItem(data_name, _, variants) =>
                    if streq(data_name, name) != 0 { 1 }
                    else { wat_ast_variants_declare_name(variants, name) }
                _ => 0
            }
        _ => 0
    }

def wat_ast_declares_heap_ref_name(items: AST, name: Str): i64 =
    if wat_is_gc_builtin_ref_name(name) != 0 { 1 }
    else {
        match items {
            Item_Cons(head, tail) =>
                if wat_ast_item_declares_heap_ref_name(head, name) != 0 { 1 }
                else { wat_ast_declares_heap_ref_name(tail, name) }
            _ => 0
        }
    }

def wat_is_scalar_type_name(name: Str): i64 =
    if streq(name, mk_str("i64", 3)) != 0 { 1 }
    else if streq(name, mk_str("i32", 3)) != 0 { 1 }
    else if streq(name, mk_str("usize", 5)) != 0 { 1 }
    else if streq(name, mk_str("u8", 2)) != 0 { 1 }
    else if streq(name, mk_str("bool", 4)) != 0 { 1 }
    else { 0 }

def wat_valtype_from_ast_in(items: AST, ty: AST): i64 =
    match ty {
        Type_Path(name, _) =>
            if name.len == 0 { "i64" }
            else if wat_is_scalar_type_name(name) != 0 { "i64" }
            else if streq(name, mk_str("String", 6)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("str", 3)) != 0 { "(ref $array_u8)" }
            else if streq(name, mk_str("Slice", 5)) != 0 { "(ref $slice_u8)" }
            else if wat_ast_declares_heap_ref_name(items, name) != 0 { "eqref" }
            else { "eqref" }
        _ => "i64"
    }

def wat_valtype_from_cir(ty: CirType): i64 =
    match ty {
        CirTyString => "(ref $array_u8)"
        CirTyStr => "(ref $array_u8)"
        CirTySliceU8 => "(ref $slice_u8)"
        CirTyApp(_, _) => "eqref"
        CirTyConst(_) => "eqref"
        CirTyNominal(_, _) => "eqref"
        CirTyData(_, _) => "eqref"
        CirTyUnion(_, _) => "eqref"
        _ => "i64"
    }

def wat_type_is_i64_storage(ty: CirType): i64 =
    match ty {
        CirTyI64 => 1
        CirTyI32 => 1
        CirTyUsize => 1
        CirTyBool => 1
        CirTyConst(name) =>
            if streq(name, mk_str("u8", 2)) != 0 { 1 }
            else if wat_is_scalar_type_name(name) != 0 { 1 }
            else { 0 }
        _ => 0
    }

def wat_valtype_from_ast(ty: AST): i64 =
    wat_valtype_from_ast_in(Item_End, ty)

def wat_ast_def_params(rest: AST): AST =
    match rest {
        DefFun(_, params, _, _) => params
        _ => Param_End
    }

def wat_ast_params_has_index(params: AST, index: i64): i64 =
    match params {
        Param_Cons(_, tail) =>
            if index == 0 { 1 }
            else { wat_ast_params_has_index(tail, index - 1) }
        _ => 0
    }

def wat_ast_nominal_fields_has_index(fields: AST, index: i64): i64 =
    match fields {
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(_, _) =>
                    if index == 0 { 1 }
                    else { wat_ast_nominal_fields_has_index(tail, index - 1) }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, _) =>
                            if index == 0 { 1 }
                            else { wat_ast_nominal_fields_has_index(tail, index - 1) }
                        _ => wat_ast_nominal_fields_has_index(tail, index)
                    }
                _ => wat_ast_nominal_fields_has_index(tail, index)
            }
        _ => 0
    }

def wat_ast_variant_fields_has_index(fields: AST, index: i64): i64 =
    match fields {
        AdtVariantField_Cons(_, _, tail) =>
            if index == 0 { 1 }
            else { wat_ast_variant_fields_has_index(tail, index - 1) }
        _ => 0
    }

def wat_ast_type_args_has_index(args: AST, index: i64): i64 =
    match args {
        TypeArg_Cons(_, tail) =>
            if index == 0 { 1 }
            else { wat_ast_type_args_has_index(tail, index - 1) }
        _ => 0
    }

def wat_ast_variant_args_has_index(args: AST, index: i64): i64 =
    match args {
        AdtVariantArg_Ident(_, AdtVariantArg_Type(_, rest)) =>
            if index == 0 { 1 }
            else { wat_ast_type_args_has_index(rest, index - 1) }
        AdtVariantArg_Field(_, fields) => wat_ast_variant_fields_has_index(fields, index)
        _ => 0
    }

def wat_ast_variants_has_param(variants: AST, func_name: Str, index: i64): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            match head {
                AdtVariant(name, args) =>
                    if streq(name, func_name) != 0 { wat_ast_variant_args_has_index(args, index) }
                    else { wat_ast_variants_has_param(tail, func_name, index) }
                _ => wat_ast_variants_has_param(tail, func_name, index)
            }
        _ => 0
    }

def wat_ast_item_has_param(item: AST, func_name: Str, index: i64): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_has_param(inner, func_name, index)
        Item_Def(defn) =>
            match defn {
                DefItem(name, _, params, _, _) =>
                    if streq(name, func_name) != 0 { wat_ast_params_has_index(params, index) }
                    else { 0 }
                DefItem2(name_ast, rest) =>
                    match name_ast {
                        DefName(name, _, _) =>
                            if streq(name, func_name) != 0 { wat_ast_params_has_index(wat_ast_def_params(rest), index) }
                            else { 0 }
                        _ => 0
                    }
                _ => 0
            }
        Item_Type(ty) =>
            match ty {
                TypeDecl(name, _, TypeDecl_Record(fields)) =>
                    if streq(name, func_name) != 0 { wat_ast_nominal_fields_has_index(fields, index) }
                    else { 0 }
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) =>
                    if streq(name, func_name) != 0 { wat_ast_nominal_fields_has_index(fields, index) }
                    else { 0 }
                AdtItem(_, _, variants) => wat_ast_variants_has_param(variants, func_name, index)
                _ => 0
            }
        _ => 0
    }

def wat_ast_has_param(items: AST, func_name: Str, index: i64): i64 =
    match items {
        Item_Cons(head, tail) =>
            if wat_ast_item_has_param(head, func_name, index) != 0 { 1 }
            else { wat_ast_has_param(tail, func_name, index) }
        _ => 0
    }

def wat_ast_param_valtype_from_params(items: AST, params: AST, index: i64): i64 =
    match params {
        Param_Cons(head, tail) =>
            if index == 0 {
                match head {
                    Param(_, ty) => wat_valtype_from_ast_in(items, ty)
                    ParamDiscard(ty) => wat_valtype_from_ast_in(items, ty)
                    ParamPattern(_, ty) => wat_valtype_from_ast_in(items, ty)
                    _ => mk_str("", 0)
                }
            } else {
                wat_ast_param_valtype_from_params(items, tail, index - 1)
            }
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype_from_nominal_fields(items: AST, fields: AST, index: i64): i64 =
    match fields {
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(_, ty) =>
                    if index == 0 { wat_valtype_from_ast_in(items, ty) }
                    else { wat_ast_param_valtype_from_nominal_fields(items, tail, index - 1) }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, ty) =>
                            if index == 0 { wat_valtype_from_ast_in(items, ty) }
                            else { wat_ast_param_valtype_from_nominal_fields(items, tail, index - 1) }
                        _ => wat_ast_param_valtype_from_nominal_fields(items, tail, index)
                    }
                _ => wat_ast_param_valtype_from_nominal_fields(items, tail, index)
            }
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype_from_variant_fields(items: AST, fields: AST, index: i64): i64 =
    match fields {
        AdtVariantField_Cons(_, ty, tail) =>
            if index == 0 { wat_valtype_from_ast_in(items, ty) }
            else { wat_ast_param_valtype_from_variant_fields(items, tail, index - 1) }
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype_from_type_args(items: AST, args: AST, index: i64): i64 =
    match args {
        TypeArg_Cons(head, tail) =>
            if index == 0 { wat_valtype_from_ast_in(items, head) }
            else { wat_ast_param_valtype_from_type_args(items, tail, index - 1) }
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype_from_variant_args(items: AST, args: AST, index: i64): i64 =
    match args {
        AdtVariantArg_Ident(name, AdtVariantArg_Type(tail, rest)) =>
            if index == 0 { wat_valtype_from_ast_in(items, Type_Path(name, tail)) }
            else { wat_ast_param_valtype_from_type_args(items, rest, index - 1) }
        AdtVariantArg_Field(_, fields) => wat_ast_param_valtype_from_variant_fields(items, fields, index)
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype_from_variants(items: AST, variants: AST, func_name: Str, index: i64): i64 =
    match variants {
        AdtVariant_Cons(head, tail) =>
            match head {
                AdtVariant(name, args) =>
                    if streq(name, func_name) != 0 { wat_ast_param_valtype_from_variant_args(items, args, index) }
                    else { wat_ast_param_valtype_from_variants(items, tail, func_name, index) }
                _ => wat_ast_param_valtype_from_variants(items, tail, func_name, index)
            }
        _ => mk_str("", 0)
    }

def wat_ast_item_param_valtype(items: AST, item: AST, func_name: Str, index: i64): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_ast_item_param_valtype(items, inner, func_name, index)
        Item_Def(defn) =>
            match defn {
                DefItem(name, _, params, _, _) =>
                    if streq(name, func_name) != 0 { wat_ast_param_valtype_from_params(items, params, index) }
                    else { mk_str("", 0) }
                DefItem2(name_ast, rest) =>
                    match name_ast {
                        DefName(name, _, _) =>
                            if streq(name, func_name) != 0 { wat_ast_param_valtype_from_params(items, wat_ast_def_params(rest), index) }
                            else { mk_str("", 0) }
                        _ => mk_str("", 0)
                    }
                _ => mk_str("", 0)
            }
        Item_Type(ty) =>
            match ty {
                TypeDecl(name, _, TypeDecl_Record(fields)) =>
                    if streq(name, func_name) != 0 { wat_ast_param_valtype_from_nominal_fields(items, fields, index) }
                    else { mk_str("", 0) }
                _ => mk_str("", 0)
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) =>
                    if streq(name, func_name) != 0 { wat_ast_param_valtype_from_nominal_fields(items, fields, index) }
                    else { mk_str("", 0) }
                AdtItem(_, _, variants) => wat_ast_param_valtype_from_variants(items, variants, func_name, index)
                _ => mk_str("", 0)
            }
        _ => mk_str("", 0)
    }

def wat_ast_param_valtype(items: AST, func_name: Str, index: i64): i64 =
    match items {
        Item_Cons(head, tail) => {
            let found = wat_ast_item_param_valtype(items, head, func_name, index)
            if wat_text_nonempty(found) != 0 { found } else { wat_ast_param_valtype(tail, func_name, index) }
        }
        _ => mk_str("", 0)
    }

def wat_emit_struct_type_line_start(out: Str, name: Str): i64 = {
    let _ = str_push_cstr(out, "  (type $")
    let _ = str_append(out, name)
    str_push_cstr(out, " (struct")
}

def wat_emit_nominal_field_type_defs(out: Str, fields: AST, items: AST): i64 =
    match fields {
        NominalField_Cons(head, tail) => {
            let _ = match head {
                NominalField(_, ty) => {
                    let _ = str_push_cstr(out, " (field ")
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(_, ty) => {
                            let _ = str_push_cstr(out, " (field ")
                            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                            str_push(out, 41)
                        }
                        _ => 0
                    }
                _ => 0
            }
            wat_emit_nominal_field_type_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_variant_field_type_defs(out: Str, fields: AST, items: AST): i64 =
    match fields {
        AdtVariantField_Cons(_, ty, tail) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
            let _ = str_push(out, 41)
            wat_emit_variant_field_type_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_typearg_field_defs(out: Str, args: AST, items: AST): i64 =
    match args {
        TypeArg_Cons(head, tail) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, head))
            let _ = str_push(out, 41)
            wat_emit_typearg_field_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_variant_arg_type_defs(out: Str, args: AST, items: AST): i64 =
    match args {
        AdtVariantArg_Ident(name, AdtVariantArg_Type(tail, rest)) => {
            let _ = str_push_cstr(out, " (field ")
            let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, Type_Path(name, tail)))
            let _ = str_push(out, 41)
            wat_emit_typearg_field_defs(out, rest, items)
        }
        AdtVariantArg_Field(_, fields) => wat_emit_variant_field_type_defs(out, fields, items)
        _ => 0
    }

def wat_emit_record_type_def(out: Str, name: Str, fields: AST, items: AST): i64 = {
    let _ = wat_emit_struct_type_line_start(out, name)
    let _ = wat_emit_nominal_field_type_defs(out, fields, items)
    let _ = str_push_cstr(out, "))")
    str_push(out, 10)
}

def wat_emit_variant_type_def(out: Str, variant: AST, items: AST): i64 =
    match variant {
        AdtVariant(name, args) => {
            let _ = wat_emit_struct_type_line_start(out, name)
            let _ = wat_emit_variant_arg_type_defs(out, args, items)
            let _ = str_push_cstr(out, "))")
            str_push(out, 10)
        }
        _ => 0
    }

def wat_emit_variant_type_defs(out: Str, variants: AST, items: AST): i64 =
    match variants {
        AdtVariant_Cons(head, tail) => {
            let _ = wat_emit_variant_type_def(out, head, items)
            wat_emit_variant_type_defs(out, tail, items)
        }
        _ => 0
    }

def wat_emit_declared_type_from_item(out: Str, item: AST, items: AST): i64 =
    match item {
        Item_WithAttrs(_, inner) => wat_emit_declared_type_from_item(out, inner, items)
        Item_Type(ty) =>
            match ty {
                TypeItem(name, _, fields) => wat_emit_record_type_def(out, name, fields, items)
                TypeDecl(name, _, TypeDecl_Record(fields)) => wat_emit_record_type_def(out, name, fields, items)
                _ => 0
            }
        Item_Adt(dat) =>
            match dat {
                AdtRecordItem(name, _, fields) => wat_emit_record_type_def(out, name, fields, items)
                AdtItem(_, _, variants) => wat_emit_variant_type_defs(out, variants, items)
                _ => 0
            }
        _ => 0
    }

def wat_emit_declared_type_defs(out: Str, items: AST): i64 =
    match items {
        Item_Cons(head, tail) => {
            let _ = wat_emit_declared_type_from_item(out, head, items)
            wat_emit_declared_type_defs(out, tail)
        }
        _ => 0
    }

def wat_builtin_runtime_defined(name: Str): i64 =
    if streq(name, mk_str("String.len", 10)) != 0 { 1 }
    else if streq(name, mk_str("String.byte_at", 14)) != 0 { 1 }
    else if streq(name, mk_str("String.slice", 12)) != 0 { 1 }
    else if streq(name, mk_str("String.char_at", 14)) != 0 { 1 }
    else if streq(name, mk_str("String.concat", 13)) != 0 { 1 }
    else if streq(name, mk_str("str.len", 7)) != 0 { 1 }
    else if streq(name, mk_str("str.byte_at", 11)) != 0 { 1 }
    else if streq(name, mk_str("str.slice", 9)) != 0 { 1 }
    else if streq(name, mk_str("str.char_at", 11)) != 0 { 1 }
    else if streq(name, mk_str("Vec.new", 7)) != 0 { 1 }
    else if streq(name, mk_str("Vec.len", 7)) != 0 { 1 }
    else if streq(name, mk_str("Vec.push", 8)) != 0 { 1 }
    else if streq(name, mk_str("Vec.freeze", 10)) != 0 { 1 }
    else if streq(name, mk_str("Array.len", 9)) != 0 { 1 }
    else if streq(name, mk_str("Array.get", 9)) != 0 { 1 }
    else if streq(name, mk_str("Array.slice", 11)) != 0 { 1 }
    else { 0 }

def wat_valtype_from_expr(expr: CirExpr): i64 =
    match expr {
        L8ValidatedCoreOp(value, _) => wat_valtype_from_expr(value)
        L7CoreOp(value, _) => wat_valtype_from_expr(value)
        L6OpClosureEnv(value, _) => wat_valtype_from_expr(value)
        L5OpContinuationPackage(_, _, value) => wat_valtype_from_expr(value)
        L5OpCps(value, _) => wat_valtype_from_expr(value)
        L4OpUsage(value, _) => wat_valtype_from_expr(value)
        L3OpAnswerControl(_, ty, _) => wat_valtype_from_cir(ty)
        L2OpTyped(_, ty) => wat_valtype_from_cir(ty)
        _ => "i64"
    }

def wat_result_valtype(items: AST, ret: AST, body: CirExpr): i64 =
    match ret {
        Type_Path(name, _) =>
            if name.len != 0 { wat_valtype_from_ast_in(items, ret) }
            else { wat_valtype_from_expr(body) }
        _ => wat_valtype_from_ast_in(items, ret)
    }

def wat_emit_local_decl_with_type(out: Str, id: i64, value_type: i64): i64 = {
    let _ = str_push_cstr(out, "    (local ")
    let _ = wat_local_name(out, id)
    let _ = str_push(out, 32)
    let _ = str_push_cstr(out, value_type)
    let _ = str_push(out, 41)
    str_push(out, 10)
}

def wat_emit_local_decl(out: Str, id: i64): i64 =
    wat_emit_local_decl_with_type(out, id, "i64")

def wat_emit_params(out: Str, items: AST, params: CirParamList): i64 =
    match params {
        CirParamEnd => 0
        CirParamCons(param, rest) => {
            let _ = match param {
                L1Param(binder, ty) => {
                    let _ = str_push_cstr(out, " (param ")
                    let _ = wat_local_name(out, binder.id)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
                L0Param(name, ty) => {
                    let _ = str_push_cstr(out, " (param $")
                    let _ = str_push_cstr(out, name)
                    let _ = str_push(out, 32)
                    let _ = str_push_cstr(out, wat_valtype_from_ast_in(items, ty))
                    str_push(out, 41)
                }
            }
            wat_emit_params(out, items, rest)
        }
    }

