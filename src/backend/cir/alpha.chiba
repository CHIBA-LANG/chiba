namespace backend.cir.alpha
use metalstd.mem.*
use metalstd.str.*
use parser.chiba_level1.*
use backend.cir.ir.*

data AlphaBinding {
    AlphaBinding(Str, Str, i64, i64)
}

data AlphaEnv {
    AlphaEnvCons(AlphaBinding, AlphaEnv),
    AlphaEnvEnd
}

type AlphaCtx {
    next_binder: i64
    env: i64
    namespace_name: Str
}

def alpha_ctx_new(): AlphaCtx =
    AlphaCtx { next_binder: heap_alloc(8), env: heap_alloc(8), namespace_name: mk_str("", 0) }

def alpha_ctx_init(ctx: AlphaCtx): AlphaCtx = {
    let _ = store64(ctx.next_binder, 0, 0)
    let _ = store64(ctx.env, 0, AlphaEnvEnd as i64)
    ctx
}

def alpha_ctx_with_namespace(ctx: AlphaCtx, namespace_name: Str): AlphaCtx =
    AlphaCtx { next_binder: ctx.next_binder, env: ctx.env, namespace_name: namespace_name }

def alpha_fresh(ctx: AlphaCtx): i64 = {
    let id = load64(ctx.next_binder, 0)
    let _ = store64(ctx.next_binder, 0, id + 1)
    id
}

def alpha_env_push(env: AlphaEnv, namespace_name: Str, name: Str, id: i64, is_global: i64): AlphaEnv =
    AlphaEnvCons(AlphaBinding(namespace_name, name, id, is_global), env)

def alpha_env_get(ctx: AlphaCtx): AlphaEnv =
    load64(ctx.env, 0) as AlphaEnv

def alpha_env_set(ctx: AlphaCtx, env: AlphaEnv): i64 =
    store64(ctx.env, 0, env as i64)

def alpha_namespace_get(ctx: AlphaCtx): Str =
    ctx.namespace_name

def alpha_env_push_ctx(ctx: AlphaCtx, name: Str, id: i64, is_global: i64): i64 =
    alpha_env_set(ctx, alpha_env_push(alpha_env_get(ctx), alpha_namespace_get(ctx), name, id, is_global))

def alpha_env_lookup(env: AlphaEnv, name: Str): CirRef =
    match env {
        AlphaEnvEnd => L1RefUnresolved(mk_str("", 0), name)
        AlphaEnvCons(binding, rest) =>
            match binding {
                AlphaBinding(namespace_name, bound_name, id, is_global) =>
                    if streq(bound_name, name) != 0 {
                        if is_global != 0 { L1RefGlobal(namespace_name, name, id) }
                        else { L1RefLocal(id, name) }
                    }
                    else { alpha_env_lookup(rest, name) }
            }
    }

def alpha_env_lookup_id(env: AlphaEnv, name: Str): i64 =
    match env {
        AlphaEnvEnd => -1
        AlphaEnvCons(binding, rest) =>
            match binding {
                AlphaBinding(_, bound_name, id, _) =>
                    if streq(bound_name, name) != 0 { id }
                    else { alpha_env_lookup_id(rest, name) }
            }
    }

data AlphaStmtResult {
    AlphaStmtResult(CirStmtList, CirExpr)
}

def alpha_param_list(params: CirParamList, ctx: AlphaCtx): CirParamList =
    match params {
        CirParamEnd => CirParamEnd
        CirParamCons(param, rest) =>
            match param {
                L0Param(name, ty) => {
                    let id = alpha_fresh(ctx)
                    let binder = cir_binder_in(mk_str("", 0), id, name)
                    let _ = alpha_env_push_ctx(ctx, name, id, 0)
                    CirParamCons(L1Param(binder, ty), alpha_param_list(rest, ctx))
                }
                L1Param(_, _) => {
                    CirParamCons(param, alpha_param_list(rest, ctx))
                }
            }
    }

def alpha_expr_list(xs: CirExprList, ctx: AlphaCtx): CirExprList =
    match xs {
        CirExprEnd => CirExprEnd
        CirExprCons(head, tail) =>
            CirExprCons(alpha_expr(head, ctx), alpha_expr_list(tail, ctx))
    }

def alpha_record_field_exprs(xs: CirRecordFieldExprList, ctx: AlphaCtx): CirRecordFieldExprList =
    match xs {
        CirRecordFieldExprEnd => CirRecordFieldExprEnd
        CirRecordFieldExprCons(head, tail) =>
            CirRecordFieldExprCons(
                CirRecordFieldExpr { field_name: head.field_name, value: alpha_expr(head.value, ctx) },
                alpha_record_field_exprs(tail, ctx)
            )
    }

def alpha_string_parts(parts: CirStringPartList, ctx: AlphaCtx): CirStringPartList =
    match parts {
        CirStringPartEnd => CirStringPartEnd
        CirStringPartChunk(chunk, rest) => CirStringPartChunk(chunk, alpha_string_parts(rest, ctx))
        CirStringPartExpr(value, rest) => CirStringPartExpr(alpha_expr(value, ctx), alpha_string_parts(rest, ctx))
    }

def alpha_stmt_list(stmts: CirStmtList, tail: CirExpr, ctx: AlphaCtx): AlphaStmtResult =
    match stmts {
        CirStmtEnd => AlphaStmtResult(CirStmtEnd, alpha_expr(tail, ctx))
        CirStmtCons(stmt, rest) =>
            match stmt {
                L0StmtLet(name, value) => {
                    let value2 = alpha_expr(value, ctx)
                    let id = alpha_fresh(ctx)
                    let binder = cir_binder_in(mk_str("", 0), id, name)
                    let _ = alpha_env_push_ctx(ctx, name, id, 0)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtLet(binder, value2), rest2), tail2)
                    }
                }
                L0StmtExpr(value) => {
                    let value2 = alpha_expr(value, ctx)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtExpr(value2), rest2), tail2)
                    }
                }
                L0StmtReturn(value) => {
                    let value2 = alpha_expr(value, ctx)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtReturn(value2), rest2), tail2)
                    }
                }
                L0StmtAssign(lhs, rhs) => {
                    let lhs2 = alpha_expr(lhs, ctx)
                    let rhs2 = alpha_expr(rhs, ctx)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtAssign(lhs2, rhs2), rest2), tail2)
                    }
                }
                L0StmtLetPattern(pat, value) => {
                    let value2 = alpha_expr(value, ctx)
                    let _ = alpha_bind_pattern_ctx(ctx, pat)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtLetPattern(pat, value2), rest2), tail2)
                    }
                }
                L0StmtFor(label, cond, body) => {
                    let cond2 = alpha_expr(cond, ctx)
                    let body2 = alpha_expr(body, ctx)
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtFor(label, cond2, body2), rest2), tail2)
                    }
                }
                L0StmtUnsupported(ast, reason) => {
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtUnsupported(ast, reason), rest2), tail2)
                    }
                }
                _ => {
                    match alpha_stmt_list(rest, tail, ctx) {
                        AlphaStmtResult(rest2, tail2) => AlphaStmtResult(CirStmtCons(L1StmtUnsupported(Expr_String, CirUnsupportedPass(mk_str("alpha stmt unsupported", 22))), rest2), tail2)
                    }
                }
            }
    }

def alpha_match_arms(arms: CirMatchArmList, ctx: AlphaCtx): CirMatchArmList =
    match arms {
        CirMatchArmEnd => CirMatchArmEnd
        CirMatchArmCons(arm, rest) =>
            match arm {
                L0MatchArm(pat, guard, value) => {
                    let old_env = alpha_env_get(ctx)
                    let _ = alpha_bind_pattern_ctx(ctx, pat)
                    let value2 = alpha_expr(value, ctx)
                    let _ = alpha_env_set(ctx, old_env)
                    CirMatchArmCons(L1MatchArm(pat, guard, value2), alpha_match_arms(rest, ctx))
                }
                _ => CirMatchArmCons(arm, alpha_match_arms(rest, ctx))
            }
    }

def alpha_bind_pattern_list_ctx(ctx: AlphaCtx, xs: AST): i64 =
    match xs {
        PatternList_Cons(head, tail) => {
            let _ = alpha_bind_pattern_ctx(ctx, head)
            alpha_bind_pattern_list_ctx(ctx, tail)
        }
        _ => 0
    }

def alpha_bind_pattern_ctx(ctx: AlphaCtx, pat: AST): i64 =
    match pat {
        Pattern_IdentStart(name, rest) =>
            match rest {
                PatternAfterIdent_Bind(inner) => {
                    let id = alpha_fresh(ctx)
                    let _ = alpha_env_push_ctx(ctx, name, id, 0)
                    alpha_bind_pattern_ctx(ctx, inner)
                }
                PatternAfterIdent_Atom(tail) =>
                    match tail {
                        PatternIdent_Name =>
                            if name.len == 0 { 0 }
                            else {
                                let id = alpha_fresh(ctx)
                                alpha_env_push_ctx(ctx, name, id, 0)
                            }
                        PatternIdent_Call(args) => alpha_bind_pattern_list_ctx(ctx, args)
                        _ => 0
                    }
                _ => 0
            }
        Pattern_Paren(first, tail) => {
            let _ = alpha_bind_pattern_ctx(ctx, first)
            alpha_bind_pattern_list_ctx(ctx, tail)
        }
        _ => 0
    }

def alpha_expr(expr: CirExpr, ctx: AlphaCtx): CirExpr =
    match expr {
        L0OpBlock(stmts, tail) => {
            let old_env = alpha_env_get(ctx)
            let result = alpha_stmt_list(stmts, tail, ctx)
            let _ = alpha_env_set(ctx, old_env)
            match result {
                AlphaStmtResult(stmts2, tail2) => L1OpBlock(stmts2, tail2)
            }
        }
        L0OpIf(cond, then_expr, else_expr) =>
            L1OpIf(alpha_expr(cond, ctx), alpha_expr(then_expr, ctx), alpha_expr(else_expr, ctx))
        L0OpMatch(value, arms) =>
            L1OpMatch(alpha_expr(value, ctx), alpha_match_arms(arms, ctx))
        L0OpClosure(params, body) => {
            let old_env = alpha_env_get(ctx)
            let params2 = alpha_param_list(params, ctx)
            let body2 = alpha_expr(body, ctx)
            let _ = alpha_env_set(ctx, old_env)
            L1OpClosure(params2, body2)
        }
        L0OpReset(label, body) =>
            L1OpReset(label, alpha_expr(body, ctx))
        L0OpShift(label, name, body) => {
            let id = alpha_fresh(ctx)
            let binder = cir_binder_in(alpha_namespace_get(ctx), id, name)
            let old_env = alpha_env_get(ctx)
            let _ = alpha_env_push_ctx(ctx, name, id, 0)
            let body2 = alpha_expr(body, ctx)
            let _ = alpha_env_set(ctx, old_env)
            L1OpShift(label, binder, body2)
        }
        L0OpCall(callee, args) =>
            L1OpCall(alpha_expr(callee, ctx), alpha_expr_list(args, ctx))
        L0OpNominalCtor(name, fields) =>
            L1OpNominalCtor(name, alpha_record_field_exprs(fields, ctx))
        L0OpField(value, field) =>
            L1OpField(alpha_expr(value, ctx), field)
        L0OpIndex(value, args) =>
            L1OpIndex(alpha_expr(value, ctx), alpha_expr_list(args, ctx))
        L0OpTypeApply(value, args) =>
            L1OpTypeApply(alpha_expr(value, ctx), alpha_expr_list(args, ctx))
        L0OpAssign(lhs, rhs) =>
            L1OpAssign(alpha_expr(lhs, ctx), alpha_expr(rhs, ctx))
        L0OpUnsafe(body) =>
            L1OpUnsafe(alpha_expr(body, ctx))
        L0OpCast(value, ty) =>
            L1OpCast(alpha_expr(value, ctx), ty)
        L0OpPrefix(op, value) =>
            L1OpPrefix(op, alpha_expr(value, ctx))
        L0OpBinary(op, lhs, rhs) =>
            L1OpBinary(op, alpha_expr(lhs, ctx), alpha_expr(rhs, ctx))
        L0OpName(name) =>
            L1OpRef(alpha_env_lookup(alpha_env_get(ctx), name))
        L0OpInt(n) => L1OpInt(n)
        L0OpFloat(n) => L1OpFloat(n)
        L0OpAtom(atom) => L1OpAtom(atom)
        L0OpBool(v) => L1OpBool(v)
        L0OpString => L1OpString
        L0OpStringBytes(bytes) => L1OpStringBytes(bytes)
        L0OpStringInterp(parts) => L1OpStringInterp(alpha_string_parts(parts, ctx))
        L0OpUnit => L1OpUnit
        L0OpUnsupported(ast, reason) => L1OpUnsupported(ast, reason)
        _ => expr
    }

def alpha_item(item: CirItem, ctx: AlphaCtx): CirItem =
    match item {
        L0ItemDef(name, params, ret, body) => {
            let old_env = alpha_env_get(ctx)
            let id = alpha_env_lookup_id(old_env, name)
            let binder = cir_binder_in(alpha_namespace_get(ctx), id, name)
            let params2 = alpha_param_list(params, ctx)
            let body2 = alpha_expr(body, ctx)
            let _ = alpha_env_set(ctx, old_env)
            L1ItemDef(binder, params2, ret, body2)
        }
        L0ItemExtern(name, params, ret, import) => {
            let id = alpha_env_lookup_id(alpha_env_get(ctx), name)
            let binder = cir_binder_in(alpha_namespace_get(ctx), id, name)
            let params2 = alpha_param_list(params, ctx)
            L1ItemExtern(binder, params2, ret, import)
        }
        L0ItemUnsupported(ast, reason) => L1ItemUnsupported(ast, reason)
        _ => item
    }

def alpha_prebind_item(item: CirItem, ctx: AlphaCtx): i64 =
    match item {
        L0ItemDef(name, _, _, _) => {
            let id = alpha_fresh(ctx)
            alpha_env_push_ctx(ctx, name, id, 1)
        }
        L0ItemExtern(name, _, _, _) => {
            let id = alpha_fresh(ctx)
            alpha_env_push_ctx(ctx, name, id, 1)
        }
        _ => 0
    }

def alpha_prebind_items(items: CirItemList, ctx: AlphaCtx): i64 =
    match items {
        CirItemEnd => 0
        CirItemCons(head, tail) => {
            let _ = alpha_prebind_item(head, ctx)
            alpha_prebind_items(tail, ctx)
        }
    }

def alpha_items(items: CirItemList, ctx: AlphaCtx): CirItemList =
    match items {
        CirItemEnd => CirItemEnd
        CirItemCons(head, tail) => CirItemCons(alpha_item(head, ctx), alpha_items(tail, ctx))
    }

def alpha_module(module: CirModule): CirModule =
    match module {
        L0Module(header, items) => {
            let base_ctx = alpha_ctx_init(alpha_ctx_new())
            let ctx = match header {
                SourceFile(_, ns, _) =>
                    match ns {
                        Namespace(name) => alpha_ctx_with_namespace(base_ctx, name)
                        _ => base_ctx
                    }
                _ => base_ctx
            }
            let _ = alpha_prebind_items(items, ctx)
            L1Module(header, alpha_items(items, ctx))
        }
        _ => module
    }
