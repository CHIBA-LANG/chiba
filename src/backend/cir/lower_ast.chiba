namespace backend.cir.lower_ast
use metalstd.str.*
use parser.chiba_level1.*
use backend.cir.ir.*

data CirTypeNameList {
    CirTypeNameNil,
    CirTypeNameCons(Str, CirTypeNameList)
}

data CirLowerBlockResult {
    CirLowerBlockResult(CirStmtList, CirExpr)
}

data CirLowerStringResult {
    CirLowerStringBytes(Str),
    CirLowerStringInterp(CirStringPartList)
}

data CirPipeArgsResult {
    CirPipeArgsResult(CirExprList, i64)
}

def cir_type_names_contains(names: CirTypeNameList, want: Str): i64 =
    match names {
        CirTypeNameNil => 0
        CirTypeNameCons(head, tail) =>
            if streq(head, want) != 0 { 1 } else { cir_type_names_contains(tail, want) }
    }

def cir_builtin_type_name(name: Str): i64 =
    if streq(name, mk_str("Vec", 3)) != 0 { 1 }
    else if streq(name, mk_str("Array", 5)) != 0 { 1 }
    else if streq(name, mk_str("Option", 6)) != 0 { 1 }
    else if streq(name, mk_str("Result", 6)) != 0 { 1 }
    else if streq(name, mk_str("String", 6)) != 0 { 1 }
    else if streq(name, mk_str("str", 3)) != 0 { 1 }
    else if streq(name, mk_str("i64", 3)) != 0 { 1 }
    else if streq(name, mk_str("i32", 3)) != 0 { 1 }
    else if streq(name, mk_str("usize", 5)) != 0 { 1 }
    else if streq(name, mk_str("u8", 2)) != 0 { 1 }
    else if streq(name, mk_str("bool", 4)) != 0 { 1 }
    else { 0 }

def cir_type_constructor_name(type_names: CirTypeNameList, name: Str): i64 =
    if cir_builtin_type_name(name) != 0 { 1 } else { cir_type_names_contains(type_names, name) }

def cir_ast_type_constructor(type_names: CirTypeNameList, ast: AST): i64 =
    match ast {
        Expr_Name(name) => cir_type_constructor_name(type_names, name)
        Expr_IdentTail(name, IdentTail_None) => cir_type_constructor_name(type_names, name)
        _ => 0
    }

def cir_collect_type_names_from_item(ast: AST): CirTypeNameList =
    match ast {
        Item_WithAttrs(_, item) => cir_collect_type_names_from_item(item)
        Item_Type(TypeDecl(name, _, _)) => CirTypeNameCons(name, CirTypeNameNil)
        Item_Adt(AdtItem(name, _, _)) => CirTypeNameCons(name, CirTypeNameNil)
        AdtItem(name, _, _) => CirTypeNameCons(name, CirTypeNameNil)
        _ => CirTypeNameNil
    }

def cir_collect_type_names(ast: AST): CirTypeNameList =
    match ast {
        Item_End => CirTypeNameNil
        Item_Cons(head, tail) =>
            match cir_collect_type_names_from_item(head) {
                CirTypeNameNil => cir_collect_type_names(tail)
                CirTypeNameCons(name, rest) => CirTypeNameCons(name, cir_collect_type_names_append(rest, cir_collect_type_names(tail)))
            }
        _ => CirTypeNameNil
    }

def cir_collect_type_names_append(xs: CirTypeNameList, ys: CirTypeNameList): CirTypeNameList =
    match xs {
        CirTypeNameNil => ys
        CirTypeNameCons(head, tail) => CirTypeNameCons(head, cir_collect_type_names_append(tail, ys))
    }

def cir_lower_control_label(ast: AST): CirControlLabel =
    match ast {
        ControlLabel_Some(name) => CirLabelNamed(name)
        ControlLabel_None => CirLabelImplicit
        _ => CirLabelImplicit
    }

def cir_lower_expr_list(type_names: CirTypeNameList, ast: AST): CirExprList =
    match ast {
        ExprList_End => CirExprEnd
        ExprList_Cons(head, tail) => CirExprCons(cir_lower_expr(type_names, head), cir_lower_expr_list(type_names, tail))
        Arg_End => CirExprEnd
        Arg_Cons(head, tail) => CirExprCons(cir_lower_expr(type_names, head), cir_lower_expr_list(type_names, tail))
        _ => CirExprCons(cir_l0_unsupported(ast, mk_str("expr list unsupported", 21)), CirExprEnd)
    }

def cir_ast_is_pipe_hole(ast: AST): i64 =
    match ast {
        Expr_PipeHole => 1
        _ => 0
    }

def cir_ast_pipe_holes(ast: AST): i64 =
    match ast {
        Expr_PipeHole => 1
        Expr_Binary(_, lhs, rhs) => cir_ast_pipe_holes(lhs) + cir_ast_pipe_holes(rhs)
        Expr_Call(callee, args) => cir_ast_pipe_holes(callee) + cir_ast_pipe_holes(args)
        Expr_Field(value, _) => cir_ast_pipe_holes(value)
        Expr_Index(value, args) => cir_ast_pipe_holes(value) + cir_ast_pipe_holes(args)
        Expr_Assign(lhs, rhs) => cir_ast_pipe_holes(lhs) + cir_ast_pipe_holes(rhs)
        Expr_Prefix(_, value) => cir_ast_pipe_holes(value)
        Expr_IdentTail(_, tail) => cir_ast_pipe_holes(tail)
        IdentTail_Call(args, _) => cir_ast_pipe_holes(args)
        IdentTail_GenericCall(_, args) => cir_ast_pipe_holes(args)
        ExprList_Cons(head, tail) => cir_ast_pipe_holes(head) + cir_ast_pipe_holes(tail)
        Arg_Cons(head, tail) => cir_ast_pipe_holes(head) + cir_ast_pipe_holes(tail)
        _ => 0
    }

def cir_lower_pipe_args(type_names: CirTypeNameList, lhs: AST, args: AST): CirPipeArgsResult =
    match args {
        Arg_End => CirPipeArgsResult(CirExprEnd, 0)
        Arg_Cons(head, tail) =>
            match cir_lower_pipe_args(type_names, lhs, tail) {
                CirPipeArgsResult(rest, holes) =>
                    if cir_ast_is_pipe_hole(head) != 0 {
                        CirPipeArgsResult(CirExprCons(cir_lower_expr(type_names, lhs), rest), holes + 1)
                    } else {
                        CirPipeArgsResult(CirExprCons(cir_lower_expr(type_names, head), rest), holes + cir_ast_pipe_holes(head))
                    }
            }
        ExprList_End => CirPipeArgsResult(CirExprEnd, 0)
        ExprList_Cons(head, tail) =>
            match cir_lower_pipe_args(type_names, lhs, tail) {
                CirPipeArgsResult(rest, holes) =>
                    if cir_ast_is_pipe_hole(head) != 0 {
                        CirPipeArgsResult(CirExprCons(cir_lower_expr(type_names, lhs), rest), holes + 1)
                    } else {
                        CirPipeArgsResult(CirExprCons(cir_lower_expr(type_names, head), rest), holes + cir_ast_pipe_holes(head))
                    }
            }
        _ => CirPipeArgsResult(CirExprCons(cir_l0_unsupported(args, mk_str("pipe args unsupported", 21)), CirExprEnd), 0)
    }

def cir_pipe_call_args(type_names: CirTypeNameList, lhs: AST, rhs: AST, args: AST): CirExprList =
    match cir_lower_pipe_args(type_names, lhs, args) {
        CirPipeArgsResult(args2, holes) =>
            if holes == 0 { CirExprCons(cir_lower_expr(type_names, lhs), args2) }
            else { args2 }
    }

def cir_lower_string_parts_to_cir(type_names: CirTypeNameList, ast: AST): CirStringPartList =
    match ast {
        StringPart_Chunk(chunk, rest) => CirStringPartChunk(chunk, cir_lower_string_parts_to_cir(type_names, rest))
        StringPart_Expr(value, rest) => CirStringPartExpr(cir_lower_expr(type_names, value), cir_lower_string_parts_to_cir(type_names, rest))
        StringPart_End => CirStringPartEnd
        _ => CirStringPartEnd
    }

def cir_string_parts_has_expr(ast: AST): i64 =
    match ast {
        StringPart_Chunk(_, rest) => cir_string_parts_has_expr(rest)
        StringPart_Expr(_, _) => 1
        _ => 0
    }

def cir_string_parts_append_chunks(out: Str, ast: AST): i64 =
    match ast {
        StringPart_Chunk(chunk, rest) => {
            let _ = str_append(out, chunk)
            cir_string_parts_append_chunks(out, rest)
        }
        _ => 0
    }

def cir_lower_string_lit(type_names: CirTypeNameList, parts: AST): CirLowerStringResult =
    if cir_string_parts_has_expr(parts) != 0 {
        CirLowerStringInterp(cir_lower_string_parts_to_cir(type_names, parts))
    } else {
        let out = str_new()
        let _ = cir_string_parts_append_chunks(out, parts)
        CirLowerStringBytes(out)
    }

def cir_param_pattern_name(pat: AST): Str =
    match pat {
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) => name
        Pattern_Wildcard => mk_str("_", 1)
        _ => mk_str("_pattern", 8)
    }

def cir_lower_params(ast: AST): CirParamList =
    match ast {
        Param_End => CirParamEnd
        Param_Cons(head, tail) =>
            match head {
                Param(name, ty) => CirParamCons(L0Param(name, ty), cir_lower_params(tail))
                ParamDiscard(ty) => CirParamCons(L0Param(mk_str("_", 1), ty), cir_lower_params(tail))
                ParamPattern(pat, ty) => CirParamCons(L0Param(cir_param_pattern_name(pat), ty), cir_lower_params(tail))
                _ => CirParamCons(L0Param(mk_str("_unsupported", 12), head), cir_lower_params(tail))
            }
        _ => CirParamEnd
    }

def cir_lower_stmts(type_names: CirTypeNameList, ast: AST): CirStmtList =
    match ast {
        Stmt_End => CirStmtEnd
        Stmt_Cons(head, tail) => CirStmtCons(cir_lower_stmt(type_names, head), cir_lower_stmts(type_names, tail))
        _ => CirStmtCons(L0StmtUnsupported(ast, CirUnsupportedAst(mk_str("stmt list unsupported", 21))), CirStmtEnd)
    }

def cir_lower_tail(type_names: CirTypeNameList, ast: AST): CirExpr =
    match ast {
        TailExpr_Some(value) => cir_lower_expr(type_names, value)
        TailExpr_None => L0OpUnit
        _ => cir_l0_unsupported(ast, mk_str("tail unsupported", 16))
    }

def cir_lower_block_parts(type_names: CirTypeNameList, stmts: AST, tail: AST): CirLowerBlockResult =
    match tail {
        TailExpr_Some(value) => CirLowerBlockResult(cir_lower_stmts(type_names, stmts), cir_lower_expr(type_names, value))
        TailExpr_None => cir_lower_block_parts_no_tail(type_names, stmts)
        _ => CirLowerBlockResult(cir_lower_stmts(type_names, stmts), cir_lower_tail(type_names, tail))
    }

def cir_lower_block_parts_no_tail(type_names: CirTypeNameList, stmts: AST): CirLowerBlockResult =
    match stmts {
        Stmt_End => CirLowerBlockResult(CirStmtEnd, L0OpUnit)
        Stmt_Cons(head, Stmt_End) =>
            match head {
                Stmt_Expr(value) => CirLowerBlockResult(CirStmtEnd, cir_lower_expr(type_names, value))
                _ => CirLowerBlockResult(CirStmtCons(cir_lower_stmt(type_names, head), CirStmtEnd), L0OpUnit)
            }
        Stmt_Cons(head, rest) => {
            let lowered_head = cir_lower_stmt(type_names, head)
            match cir_lower_block_parts_no_tail(type_names, rest) {
                CirLowerBlockResult(rest2, tail2) => CirLowerBlockResult(CirStmtCons(lowered_head, rest2), tail2)
            }
        }
        _ => CirLowerBlockResult(cir_lower_stmts(type_names, stmts), L0OpUnit)
    }

def cir_lower_pattern_let(pat: AST, value: CirExpr): CirStmt =
    match pat {
        Pattern_Wildcard => L0StmtExpr(value)
        Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) =>
            L0StmtLet(name, value)
        Pattern_IdentStart(name, PatternAfterIdent_Bind(PatternIdent_Name)) =>
            L0StmtLet(name, value)
        _ => L0StmtLetPattern(pat, value)
    }

def cir_lower_pattern_let_typed(pat: AST, ty: AST, value: CirExpr): CirStmt =
    match ty {
        Type_Path(name, _) =>
            if name.len == 0 { cir_lower_pattern_let(pat, value) }
            else {
                match pat {
                    Pattern_Wildcard => L0StmtExpr(value)
                    Pattern_IdentStart(name2, PatternAfterIdent_Atom(PatternIdent_Name)) =>
                        L0StmtLet(name2, L0OpCast(value, ty))
                    Pattern_IdentStart(name2, PatternAfterIdent_Bind(PatternIdent_Name)) =>
                        L0StmtLet(name2, L0OpCast(value, ty))
                    _ => L0StmtLetPattern(pat, L0OpCast(value, ty))
                }
            }
        _ =>
            match pat {
                Pattern_Wildcard => L0StmtExpr(value)
                Pattern_IdentStart(name, PatternAfterIdent_Atom(PatternIdent_Name)) =>
                    L0StmtLet(name, L0OpCast(value, ty))
                Pattern_IdentStart(name, PatternAfterIdent_Bind(PatternIdent_Name)) =>
                    L0StmtLet(name, L0OpCast(value, ty))
                _ => L0StmtLetPattern(pat, L0OpCast(value, ty))
            }
    }

def cir_lower_stmt(type_names: CirTypeNameList, ast: AST): CirStmt =
    match ast {
        Stmt_Let(name, value) => L0StmtLet(name, cir_lower_expr(type_names, value))
        Stmt_LetPattern(pat, value) => cir_lower_pattern_let(pat, cir_lower_expr(type_names, value))
        Stmt_LetPatternTyped(pat, ty, value) => cir_lower_pattern_let_typed(pat, ty, cir_lower_expr(type_names, value))
        Stmt_Assign(lhs, rhs) => L0StmtAssign(cir_lower_expr(type_names, lhs), cir_lower_expr(type_names, rhs))
        Stmt_Return(value) => L0StmtReturn(cir_lower_expr(type_names, value))
        Stmt_Expr(value) => L0StmtExpr(cir_lower_expr(type_names, value))
        Stmt_For(label, cond, body) => L0StmtFor(label, cir_lower_expr(type_names, cond), cir_lower_expr(type_names, body))
        Stmt_WithAttrs(_, stmt) => cir_lower_stmt(type_names, stmt)
        Stmt_Empty => L0StmtExpr(L0OpUnit)
        _ => L0StmtUnsupported(ast, CirUnsupportedAst(mk_str("stmt unsupported", 16)))
    }

def cir_lower_match_arms(type_names: CirTypeNameList, ast: AST): CirMatchArmList =
    match ast {
        MatchArm_End => CirMatchArmEnd
        MatchArm_Cons(head, tail) =>
            match head {
                MatchArm(pat, guard, value) =>
                    CirMatchArmCons(L0MatchArm(pat, guard, cir_lower_expr(type_names, value)), cir_lower_match_arms(type_names, tail))
                _ => CirMatchArmCons(L0MatchArm(head, MatchGuard_None, cir_l0_unsupported(head, mk_str("match arm unsupported", 21))), cir_lower_match_arms(type_names, tail))
            }
        _ => CirMatchArmEnd
    }

def cir_lower_extern_import(abi: Str, symbol: Str): CirExternImport =
    if streq(abi, mk_str("wasi", 4)) != 0 { cir_extern_import(CirExternAbiWasi, mk_str("wasi_snapshot_preview1", 22), symbol) }
    else if streq(abi, mk_str("C", 1)) != 0 { cir_extern_import(CirExternAbiEnv, mk_str("env", 3), symbol) }
    else if streq(abi, mk_str("c", 1)) != 0 { cir_extern_import(CirExternAbiEnv, mk_str("env", 3), symbol) }
    else if streq(abi, mk_str("env", 3)) != 0 { cir_extern_import(CirExternAbiEnv, mk_str("env", 3), symbol) }
    else { cir_extern_import(CirExternAbiUnsupported(abi), mk_str("unsupported", 11), symbol) }

def cir_plain_string_lit(ast: AST): Str =
    match ast {
        Expr_StringLit(StringPart_Chunk(text, StringPart_End)) => text
        _ => mk_str("", 0)
    }

def cir_compiler_builtin_symbol(args: AST): Str =
    match args {
        Arg_Cons(head, Arg_End) => cir_plain_string_lit(head)
        ExprList_Cons(head, ExprList_End) => cir_plain_string_lit(head)
        _ => mk_str("", 0)
    }

def cir_lower_compiler_builtin(body: AST): CirExternImport =
    match body {
        Expr_IdentTail(name, IdentTail_Call(args, IdentCallClosure_None)) =>
            if streq(name, mk_str("__compiler_builtin", 18)) != 0 {
                let symbol = cir_compiler_builtin_symbol(args)
                if symbol.len == 0 { cir_extern_import(CirExternAbiUnsupported(mk_str("compiler_builtin", 16)), mk_str("unsupported", 11), mk_str("", 0)) }
                else { cir_extern_env(symbol) }
            } else {
                cir_extern_import(CirExternAbiUnsupported(mk_str("compiler_builtin", 16)), mk_str("unsupported", 11), mk_str("", 0))
            }
        _ => cir_extern_import(CirExternAbiUnsupported(mk_str("compiler_builtin", 16)), mk_str("unsupported", 11), mk_str("", 0))
    }

def cir_expr_is_compiler_builtin(body: AST): i64 =
    match body {
        Expr_IdentTail(name, IdentTail_Call(args, IdentCallClosure_None)) =>
            if streq(name, mk_str("__compiler_builtin", 18)) == 0 { 0 }
            else {
                let symbol = cir_compiler_builtin_symbol(args)
                symbol.len != 0
            }
        _ => 0
    }

def cir_synth_index_name(prefix: i64, index: i64): Str = {
    let out = str_new()
    let _ = str_push_cstr(out, prefix)
    let _ = str_append_i64(out, index)
    out
}

def cir_synth_qualified_name(left: Str, right: Str): Str = {
    let out = str_new()
    let _ = str_append(out, left)
    let _ = str_push(out, 46)
    let _ = str_append(out, right)
    out
}

def cir_lower_record_fields(type_names: CirTypeNameList, ast: AST): CirRecordFieldExprList =
    match ast {
        NominalField_End => CirRecordFieldExprEnd
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(name, value) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: cir_lower_expr(type_names, value) }, cir_lower_record_fields(type_names, tail))
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(name, value) =>
                            CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: cir_lower_expr(type_names, value) }, cir_lower_record_fields(type_names, tail))
                        _ => cir_lower_record_fields(type_names, tail)
                    }
                _ => cir_lower_record_fields(type_names, tail)
            }
        Record_First(name, tail) =>
            match tail {
                RecordTail_Field(value, rest) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: cir_lower_expr(type_names, value) }, cir_lower_record_fields(type_names, rest))
                RecordTail_Shorthand(rest) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: L0OpName(name) }, cir_lower_record_fields(type_names, rest))
                _ => CirRecordFieldExprEnd
            }
        RecordField_End => CirRecordFieldExprEnd
        RecordField_Cons(head, tail) =>
            match head {
                RecordField(name, value) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: cir_lower_expr(type_names, value) }, cir_lower_record_fields(type_names, tail))
                _ => cir_lower_record_fields(type_names, tail)
            }
        Record_Fields(fields) => cir_lower_record_fields(type_names, fields)
        _ => CirRecordFieldExprEnd
    }

def cir_lower_record_ctor_params(ast: AST): CirParamList =
    match ast {
        NominalField_End => CirParamEnd
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(name, ty) => CirParamCons(L0Param(name, ty), cir_lower_record_ctor_params(tail))
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(name, ty) => CirParamCons(L0Param(name, ty), cir_lower_record_ctor_params(tail))
                        _ => cir_lower_record_ctor_params(tail)
                    }
                _ => cir_lower_record_ctor_params(tail)
            }
        _ => CirParamEnd
    }

def cir_lower_record_ctor_field_exprs(ast: AST): CirRecordFieldExprList =
    match ast {
        NominalField_End => CirRecordFieldExprEnd
        NominalField_Cons(head, tail) =>
            match head {
                NominalField(name, _) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: L0OpName(name) }, cir_lower_record_ctor_field_exprs(tail))
                NominalFieldAttrs(_, inner) =>
                    match inner {
                        NominalField(name, _) =>
                            CirRecordFieldExprCons(CirRecordFieldExpr { field_name: name, value: L0OpName(name) }, cir_lower_record_ctor_field_exprs(tail))
                        _ => cir_lower_record_ctor_field_exprs(tail)
                    }
                _ => cir_lower_record_ctor_field_exprs(tail)
            }
        _ => CirRecordFieldExprEnd
    }

def cir_lower_type_ctor_item(name: Str, body: AST): CirItem =
    match body {
        TypeDecl_Record(fields) =>
            L0ItemDef(name, cir_lower_record_ctor_params(fields), Type_Path(name, Type_Tail_End), L0OpNominalCtor(name, cir_lower_record_ctor_field_exprs(fields)))
        _ => L0ItemUnsupported(body, CirUnsupportedAst(mk_str("type ctor unsupported", 21)))
    }

def cir_lower_adt_ctor_params_from_type_args(args: AST, index: i64): CirParamList =
    match args {
        TypeArg_End => CirParamEnd
        TypeArg_Cons(head, tail) =>
            CirParamCons(L0Param(cir_synth_index_name("arg", index), head), cir_lower_adt_ctor_params_from_type_args(tail, index + 1))
        _ => CirParamEnd
    }

def cir_lower_adt_ctor_params(args: AST, index: i64): CirParamList =
    match args {
        TypeArg_End => CirParamEnd
        AdtVariantArg_Ident(name, AdtVariantArg_Type(tail, rest)) =>
            CirParamCons(L0Param(cir_synth_index_name("arg", index), Type_Path(name, tail)), cir_lower_adt_ctor_params_from_type_args(rest, index + 1))
        _ => CirParamEnd
    }

def cir_ctor_field_exprs_from_params(params: CirParamList, index: i64): CirRecordFieldExprList =
    match params {
        CirParamEnd => CirRecordFieldExprEnd
        CirParamCons(head, tail) =>
            match head {
                L0Param(name, _) =>
                    CirRecordFieldExprCons(CirRecordFieldExpr { field_name: cir_synth_index_name("_", index), value: L0OpName(name) }, cir_ctor_field_exprs_from_params(tail, index + 1))
                _ => cir_ctor_field_exprs_from_params(tail, index + 1)
            }
    }

def cir_lower_variant_ctor_item(data_name: Str, variant_name: Str, args: AST): CirItem = {
    let params = cir_lower_adt_ctor_params(args, 1)
    L0ItemDef(variant_name, params, Type_Path(data_name, Type_Tail_End), L0OpNominalCtor(variant_name, cir_ctor_field_exprs_from_params(params, 1)))
}

def cir_lower_match_ident_rest(type_names: CirTypeNameList, base: CirExpr, rest: AST): CirExpr =
    match rest {
        MatchIdent_Call(args, tail) => cir_lower_match_ident_rest(type_names, L0OpCall(base, cir_lower_expr_list(type_names, args)), tail)
        MatchIdent_Field(field, tail) => cir_lower_match_ident_rest(type_names, L0OpField(base, field), tail)
        MatchIdent_Index(args, tail) => cir_lower_match_ident_rest(type_names, L0OpIndex(base, cir_lower_expr_list(type_names, args)), tail)
        MatchIdent_Name => base
        _ => cir_l0_unsupported(rest, mk_str("match ident unsupported", 23))
    }

def cir_lower_match_ident(type_names: CirTypeNameList, name: Str, rest: AST): CirExpr =
    cir_lower_match_ident_rest(type_names, L0OpName(name), rest)

def cir_lower_ident_tail(type_names: CirTypeNameList, name: Str, tail: AST): CirExpr =
    match tail {
        IdentTail_None => L0OpName(name)
        IdentTail_Call(args, IdentCallClosure_None) => L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args))
        IdentTail_Call(args, IdentCallClosure_Some(_, closure)) =>
            L0OpCall(L0OpName(name), CirExprCons(cir_lower_expr(type_names, closure), cir_lower_expr_list(type_names, args)))
        IdentTail_GenericCall(_, args) => L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args))
        IdentTail_RecordCtor(body) => L0OpNominalCtor(name, cir_lower_record_fields(type_names, body))
        _ => cir_l0_unsupported(tail, mk_str("ident tail unsupported", 22))
    }

def cir_lower_if_cond_ident(type_names: CirTypeNameList, name: Str, rest: AST): CirExpr =
    match rest {
        IfCondIdent_Call(args) => L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args))
        IfCondIdent_CallBinary(args, op, rhs) =>
            L0OpBinary(cir_lower_binary_op(op), L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args)), cir_lower_expr(type_names, rhs))
        IfCondIdent_Postfix(tail) => cir_lower_if_cond_postfix(type_names, L0OpName(name), tail)
        IfCondIdent_PostfixBinary(tail, op, rhs) =>
            L0OpBinary(cir_lower_binary_op(op), cir_lower_if_cond_postfix(type_names, L0OpName(name), tail), cir_lower_expr(type_names, rhs))
        IfCondIdent_ArithBinary(arith, op, rhs) =>
            L0OpBinary(cir_lower_binary_op(op), cir_lower_if_cond_arith_tail(type_names, name, arith), cir_lower_expr(type_names, rhs))
        IfCondIdent_Binary(op, rhs) => L0OpBinary(cir_lower_binary_op(op), L0OpName(name), cir_lower_expr(type_names, rhs))
        IfCondIdent_Name => L0OpName(name)
        _ => cir_l0_unsupported(rest, mk_str("if cond ident unsupported", 25))
    }

def cir_lower_if_cond_postfix(type_names: CirTypeNameList, base: CirExpr, tail: AST): CirExpr =
    match tail {
        IfCondPostfix_Call(args, rest) => cir_lower_if_cond_postfix(type_names, L0OpCall(base, cir_lower_expr_list(type_names, args)), rest)
        IfCondPostfix_Field(field, rest) => cir_lower_if_cond_postfix(type_names, L0OpField(base, field), rest)
        IfCondPostfix_Index(args, rest) => cir_lower_if_cond_postfix(type_names, L0OpIndex(base, cir_lower_expr_list(type_names, args)), rest)
        IfCondPostfix_End => base
        _ => base
    }

def cir_lower_if_cond_arith_tail(type_names: CirTypeNameList, name: Str, arith: AST): CirExpr =
    match arith {
        IfCondArithTail(op, rhs) => L0OpBinary(cir_lower_binary_op(op), L0OpName(name), cir_lower_expr(type_names, rhs))
        _ => L0OpName(name)
    }

def cir_lower_prefix_op(op: AST): Str =
    match op {
        Prefix_Neg => mk_str("-", 1)
        Prefix_Not => mk_str("!", 1)
        _ => mk_str("?", 1)
    }

def cir_lower_binary_op(op: AST): Str =
    match op {
        OpMul => mk_str("*", 1)
        OpDiv => mk_str("/", 1)
        OpMod => mk_str("%", 1)
        OpShl => mk_str("<<", 2)
        OpShr => mk_str(">>", 2)
        OpAdd => mk_str("+", 1)
        OpSub => mk_str("-", 1)
        OpEqEq => mk_str("==", 2)
        OpBangEq => mk_str("!=", 2)
        OpLt => mk_str("<", 1)
        OpGt => mk_str(">", 1)
        OpLtEq => mk_str("<=", 2)
        OpGtEq => mk_str(">=", 2)
        OpRange => mk_str("..", 2)
        OpBitAnd => mk_str("&", 1)
        OpBitXor => mk_str("^", 1)
        OpBitOr => mk_str("|", 1)
        OpAnd => mk_str("&&", 2)
        OpOr => mk_str("||", 2)
        OpPipeGt => mk_str("|>", 2)
        _ => mk_str("?", 1)
    }

def cir_lower_pipe_expr(type_names: CirTypeNameList, lhs: AST, rhs: AST): CirExpr =
    match rhs {
        Expr_IdentTail(name, IdentTail_None) =>
            L0OpCall(L0OpName(name), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
        Expr_Name(name) =>
            L0OpCall(L0OpName(name), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
        Expr_IdentTail(name, IdentTail_Call(args, IdentCallClosure_None)) =>
            L0OpCall(L0OpName(name), cir_pipe_call_args(type_names, lhs, rhs, args))
        Expr_IdentTail(name, IdentTail_GenericCall(_, args)) =>
            L0OpCall(L0OpName(name), cir_pipe_call_args(type_names, lhs, rhs, args))
        Expr_Index(Expr_IdentTail(name, IdentTail_None), _) =>
            L0OpCall(L0OpName(name), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
        Expr_Index(Expr_Name(name), _) =>
            L0OpCall(L0OpName(name), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
        Expr_Call(Expr_Index(Expr_IdentTail(name, IdentTail_None), _), args) =>
            L0OpCall(L0OpName(name), cir_pipe_call_args(type_names, lhs, rhs, args))
        Expr_Call(Expr_Index(Expr_Name(name), _), args) =>
            L0OpCall(L0OpName(name), cir_pipe_call_args(type_names, lhs, rhs, args))
        Expr_Call(callee, args) =>
            if cir_ast_pipe_holes(callee) != 0 {
                cir_l0_unsupported(rhs, mk_str("pipe callee hole unsupported", 28))
            } else {
                L0OpCall(cir_lower_expr(type_names, callee), cir_pipe_call_args(type_names, lhs, rhs, args))
            }
        Expr_Field(_, _) =>
            if cir_ast_pipe_holes(rhs) != 0 {
                cir_l0_unsupported(rhs, mk_str("pipe field hole unsupported", 27))
            } else {
                L0OpCall(cir_lower_expr(type_names, rhs), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
            }
        _ =>
            if cir_ast_pipe_holes(rhs) != 0 {
                cir_l0_unsupported(rhs, mk_str("pipe hole unsupported here", 26))
            } else {
                L0OpCall(cir_lower_expr(type_names, rhs), CirExprCons(cir_lower_expr(type_names, lhs), CirExprEnd))
            }
    }

def cir_lower_expr(type_names: CirTypeNameList, ast: AST): CirExpr =
    match ast {
        Expr_Block(stmts, tail) =>
            match cir_lower_block_parts(type_names, stmts, tail) {
                CirLowerBlockResult(stmts2, tail2) => L0OpBlock(stmts2, tail2)
            }
        Expr_Closure(params, body) => L0OpClosure(cir_lower_params(params), cir_lower_expr(type_names, body))
        Expr_If(cond, then_block, else_branch) => L0OpIf(cir_lower_expr(type_names, cond), cir_lower_expr(type_names, then_block), cir_lower_expr(type_names, else_branch))
        IfCond_Expr(value) => cir_lower_expr(type_names, value)
        Expr_IfCondIdent(name, rest) => cir_lower_if_cond_ident(type_names, name, rest)
        Expr_MatchIdent(name, rest) => cir_lower_match_ident(type_names, name, rest)
        Expr_Match(value, arms) => L0OpMatch(cir_lower_expr(type_names, value), cir_lower_match_arms(type_names, arms))
        Expr_Reset(label, body) => L0OpReset(cir_lower_control_label(label), cir_lower_expr(type_names, body))
        Expr_Shift(label, name, body) => L0OpShift(cir_lower_control_label(label), name, cir_lower_expr(type_names, body))
        Expr_Call(Expr_Field(Expr_IdentTail(name, IdentTail_None), field), args) =>
            if cir_type_names_contains(type_names, name) != 0 {
                L0OpCall(L0OpName(cir_synth_qualified_name(name, field)), cir_lower_expr_list(type_names, args))
            } else {
                L0OpCall(L0OpField(L0OpName(name), field), cir_lower_expr_list(type_names, args))
            }
        Expr_Call(Expr_Field(Expr_Name(name), field), args) =>
            if cir_type_names_contains(type_names, name) != 0 {
                L0OpCall(L0OpName(cir_synth_qualified_name(name, field)), cir_lower_expr_list(type_names, args))
            } else {
                L0OpCall(L0OpField(L0OpName(name), field), cir_lower_expr_list(type_names, args))
            }
        Expr_Call(Expr_Index(Expr_IdentTail(name, IdentTail_None), type_args), args) =>
            if cir_type_constructor_name(type_names, name) != 0 {
                L0OpCall(L0OpTypeApply(L0OpName(name), cir_lower_expr_list(type_names, type_args)), cir_lower_expr_list(type_names, args))
            } else {
                L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args))
            }
        Expr_Call(Expr_Index(Expr_Name(name), type_args), args) =>
            if cir_type_constructor_name(type_names, name) != 0 {
                L0OpCall(L0OpTypeApply(L0OpName(name), cir_lower_expr_list(type_names, type_args)), cir_lower_expr_list(type_names, args))
            } else {
                L0OpCall(L0OpName(name), cir_lower_expr_list(type_names, args))
            }
        Expr_Call(callee, args) => L0OpCall(cir_lower_expr(type_names, callee), cir_lower_expr_list(type_names, args))
        Expr_Field(value, field) => L0OpField(cir_lower_expr(type_names, value), field)
        Expr_Index(value, args) =>
            if cir_ast_type_constructor(type_names, value) != 0 {
                L0OpTypeApply(cir_lower_expr(type_names, value), cir_lower_expr_list(type_names, args))
            } else {
                L0OpIndex(cir_lower_expr(type_names, value), cir_lower_expr_list(type_names, args))
            }
        Expr_Assign(lhs, rhs) => L0OpAssign(cir_lower_expr(type_names, lhs), cir_lower_expr(type_names, rhs))
        Expr_Unsafe(body) => L0OpUnsafe(cir_lower_expr(type_names, body))
        Expr_Cast(value, ty) => L0OpCast(cir_lower_expr(type_names, value), ty)
        Expr_Prefix(op, value) => L0OpPrefix(cir_lower_prefix_op(op), cir_lower_expr(type_names, value))
        Expr_Binary(OpPipeGt, lhs, rhs) => cir_lower_pipe_expr(type_names, lhs, rhs)
        Expr_Binary(op, lhs, rhs) => L0OpBinary(cir_lower_binary_op(op), cir_lower_expr(type_names, lhs), cir_lower_expr(type_names, rhs))
        Expr_Int(n) => L0OpInt(n)
        Expr_Float(n) => L0OpFloat(n)
        Expr_Atom(atom) => L0OpAtom(atom)
        Expr_Bool(v) => L0OpBool(v)
        Expr_String => L0OpString
        Expr_StringLit(parts) =>
            match cir_lower_string_lit(type_names, parts) {
                CirLowerStringBytes(bytes) => L0OpStringBytes(bytes)
                CirLowerStringInterp(parts2) => L0OpStringInterp(parts2)
            }
        Expr_Name(name) => L0OpName(name)
        Expr_IdentTail(name, tail) => cir_lower_ident_tail(type_names, name, tail)
        Expr_PipeHole => cir_l0_unsupported(ast, mk_str("pipe placeholder outside pipe", 29))
        Expr_Paren(values) => L0OpCall(L0OpName(mk_str("__tuple", 7)), cir_lower_expr_list(type_names, values))
        Expr_List(values) => L0OpCall(L0OpName(mk_str("__list", 6)), cir_lower_expr_list(type_names, values))
        _ => cir_l0_unsupported(ast, mk_str("expr unsupported", 16))
    }

def cir_def_name_text(ast: AST): Str =
    match ast {
        DefName(name, _, DefNamePlain) => name
        DefName(name, _, DefNameMethod(method)) => {
            let out = str_new()
            let _ = str_append(out, name)
            let _ = str_push(out, 46)
            let _ = str_append(out, method)
            out
        }
        _ => mk_str("_unsupported_def_name", 21)
    }

def cir_lower_def_item(type_names: CirTypeNameList, name_ast: AST, rest: AST, source_ast: AST): CirItem =
    match rest {
        DefFun(_, params, ret, body) => {
            let name = cir_def_name_text(name_ast)
            match body {
                Expr_ExternImport(abi, symbol) => L0ItemExtern(name, cir_lower_params(params), ret, cir_lower_extern_import(abi, symbol))
                Expr_Extern(_) => L0ItemExtern(name, cir_lower_params(params), ret, cir_extern_wasi(name))
                _ =>
                    if cir_expr_is_compiler_builtin(body) != 0 {
                        L0ItemExtern(name, cir_lower_params(params), ret, cir_lower_compiler_builtin(body))
                    } else {
                        L0ItemDef(name, cir_lower_params(params), ret, cir_lower_expr(type_names, body))
                    }
            }
        }
        DefConst(ret, value) => {
            let name = cir_def_name_text(name_ast)
            match value {
                Expr_ExternImport(abi, symbol) => L0ItemExtern(name, CirParamEnd, ret, cir_lower_extern_import(abi, symbol))
                Expr_Extern(_) => L0ItemExtern(name, CirParamEnd, ret, cir_extern_wasi(name))
                _ =>
                    if cir_expr_is_compiler_builtin(value) != 0 {
                        L0ItemExtern(name, CirParamEnd, ret, cir_lower_compiler_builtin(value))
                    } else {
                        L0ItemDef(name, CirParamEnd, ret, cir_lower_expr(type_names, value))
                    }
            }
        }
        _ => L0ItemUnsupported(source_ast, CirUnsupportedAst(mk_str("def rest unsupported", 20)))
    }

def cir_item_list_append(xs: CirItemList, ys: CirItemList): CirItemList =
    match xs {
        CirItemEnd => ys
        CirItemCons(head, tail) => CirItemCons(head, cir_item_list_append(tail, ys))
    }

def cir_lower_variant_ctor_stub(data_name: Str, variant_name: Str): CirItem =
    L0ItemDef(
        variant_name,
        CirParamEnd,
        Type_Path(data_name, Type_Tail_End),
        L0OpUnsupported(Expr_String, CirUnsupportedAst(mk_str("data ctor stub", 14)))
    )

def cir_lower_variant_ctor_items(data_name: Str, variants: AST): CirItemList =
    match variants {
        AdtVariant_End => CirItemEnd
        AdtVariant_Cons(head, tail) =>
            match head {
                AdtVariant(name, args) => CirItemCons(cir_lower_variant_ctor_item(data_name, name, args), cir_lower_variant_ctor_items(data_name, tail))
                _ => cir_lower_variant_ctor_items(data_name, tail)
            }
        _ => CirItemEnd
    }

def cir_lower_item_list(type_names: CirTypeNameList, ast: AST): CirItemList =
    match ast {
        Item_Def(_) => CirItemCons(cir_lower_item(type_names, ast), CirItemEnd)
        Item_WithAttrs(_, item) => cir_lower_item_list(type_names, item)
        Item_Type(TypeDecl(name, _, body)) => CirItemCons(cir_lower_type_ctor_item(name, body), CirItemEnd)
        Item_Adt(AdtItem(name, _, variants)) => cir_lower_variant_ctor_items(name, variants)
        AdtRecordItem(_, _, _) => CirItemEnd
        AdtItem(name, _, variants) => cir_lower_variant_ctor_items(name, variants)
        _ => CirItemCons(cir_lower_item(type_names, ast), CirItemEnd)
    }

def cir_lower_item(type_names: CirTypeNameList, ast: AST): CirItem =
    match ast {
        Item_Def(defn) =>
            match defn {
                DefItem(name, _, params, ret, body) =>
                    match body {
                        Expr_ExternImport(abi, symbol) => L0ItemExtern(name, cir_lower_params(params), ret, cir_lower_extern_import(abi, symbol))
                        Expr_Extern(_) => L0ItemExtern(name, cir_lower_params(params), ret, cir_extern_wasi(name))
                        _ =>
                            if cir_expr_is_compiler_builtin(body) != 0 {
                                L0ItemExtern(name, cir_lower_params(params), ret, cir_lower_compiler_builtin(body))
                            } else {
                                L0ItemDef(name, cir_lower_params(params), ret, cir_lower_expr(type_names, body))
                            }
                    }
                DefItem2(name_ast, rest) => cir_lower_def_item(type_names, name_ast, rest, ast)
                _ => L0ItemUnsupported(ast, CirUnsupportedAst(mk_str("def unsupported", 15)))
            }
        Item_WithAttrs(_, item) => cir_lower_item(type_names, item)
        Item_Type(TypeDecl(name, _, body)) => cir_lower_type_ctor_item(name, body)
        Item_Adt(AdtItem(name, _, variants)) =>
            match cir_lower_variant_ctor_items(name, variants) {
                CirItemCons(head, _) => head
                CirItemEnd => L0ItemUnsupported(ast, CirUnsupportedAst(mk_str("adt unsupported", 15)))
            }
        _ => L0ItemUnsupported(ast, CirUnsupportedAst(mk_str("item unsupported", 16)))
    }

def cir_lower_items(type_names: CirTypeNameList, ast: AST): CirItemList =
    match ast {
        Item_End => CirItemEnd
        Item_Cons(head, tail) => cir_item_list_append(cir_lower_item_list(type_names, head), cir_lower_items(type_names, tail))
        _ => CirItemCons(L0ItemUnsupported(ast, CirUnsupportedAst(mk_str("item list unsupported", 21))), CirItemEnd)
    }

def cir_lower_module(ast: AST): CirModule =
    match ast {
        SourceFile(_, _, items) => {
            let type_names = cir_collect_type_names(items)
            L0Module(ast, cir_lower_items(type_names, items))
        }
        _ => L0Module(ast, CirItemEnd)
    }
